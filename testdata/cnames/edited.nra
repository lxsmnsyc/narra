struct Box<T> {
  item: T
}

function unrelated(x: Box<int>, _y: Array<string>): Box<int> {
  return x
}

export function run(args: Array<string>): int {
  const b: Box<#[int, Array<int>]> = Box { item: #[1, [2]] }
  const f = (x: int) => x + 1
  const #[n, xs] = b.item
  return f(n) - 2 + xs[0] - 2
}
