// The effect variable of a lazy operator takes the effects of the source and
// the callback: map over a source with `uses io` is a generator with `uses io`,
// and a pure source with a pure callback gives a pure generator.
import * as Iterators from "std/iterator"
import * as Int from "std/int"

function* noisy(): Generator<int> uses io {
  print("noisy starts")
  yield 1
  yield 2
}

function* quiet(): Generator<int> {
  yield 3
  yield 4
}

function double(value: int): int {
  return value * 2
}

// A pure generator fits where no effect is declared.
function sumPure(values: Generator<int>): int {
  let total = 0
  for (const value of values) {
    total = total + value
  }
  return total
}

export function run(args: Array<string>): int uses io, alloc {
  const loud: Generator<int> uses io = Iterators.map(noisy(), double)
  for (const value of loud) {
    print(Int.toString(value))
  }
  const pure: Generator<int> = Iterators.map(quiet(), double)
  print(Int.toString(sumPure(pure)))
  const filtered: Generator<int> = Iterators.filter(quiet(), (value: int): bool => value > 3)
  print(Int.toString(sumPure(filtered)))
  return 0
}
