import * as Process from "std/process"

function stop(code: int): int uses io {
  Process.exit(code)
}

export function run(args: Array<string>): int {
  const names = ["held", "by", "the", "program"]
  const counts: Map<string, int> = Map<string, int> {}
  counts["held"] = 1
  print("before exit")
  print(`live values: ${names[0]} ${names[3]}`)
  if (names[0] == "held") {
    return stop(7)
  }
  print("after exit")
  return 0
}
