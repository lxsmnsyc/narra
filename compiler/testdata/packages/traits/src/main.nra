import { Area, Mood } from "tp/shape"
import { Circle } from "tp/geo"
import * as Geo from "tp/geo"
import { describe, largest, count } from "tp/report"
import * as Int from "std/int"

// Same name as tp/geo's Square, with its own Show: the C names must differ.
struct Square implements Area, Show {
  side: int
}

implement Area for Square {
  function area(shape: Square): f64 {
    return 0.5
  }

  function name(shape: Square): string {
    return "main square"
  }
}

implement Show for Square {
  function show(value: Square): string {
    return `main square ${Int.toString(value.side)}`
  }
}

export function run(args: Array<string>): int {
  print(describe(Geo.unitSquare()))
  print(describe(Circle { radius: 2.0 }))
  print(describe(Square { side: 4 }))
  print(Show.show(Geo.unitSquare()))
  print(Show.show(Square { side: 4 }))
  const circles: Array<Circle> = [Circle { radius: 1.0 }, Circle { radius: 3.0 }, Circle { radius: 2.0 }]
  print(largest(circles, Circle { radius: 0.0 }))
  print(Int.toString(count(circles, Circle { radius: 3.0 })))
  if (Circle { radius: 1.0 } == Circle { radius: 1.0 }) {
    print("circles equal")
  }
  // tp/shape's Mood is imported, so bare `Less` is Mood.Less, not Ordering.Less.
  const m = Mood.Less
  const label = match (m) {
    Mood.Less => "mood less"
    Mood.More => "mood more"
  }
  print(label)
  const o: Ordering = Ordering.Less
  print(Show.show(o))
  return 0
}
