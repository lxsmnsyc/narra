// error: p.line = ... may change p, which node.pos still uses at line 17
struct Pos {
  line: int
  column: int
}

struct Node {
  name: string
  pos: Pos
}

export function run(_args: Array<string>): int {
  const node = Node { name: "a", pos: Pos { line: 1, column: 2 } }
  // A write through the name that took the value, while its source is used later.
  let p = node.pos
  p.line = 5
  return p.line + node.pos.line
}
