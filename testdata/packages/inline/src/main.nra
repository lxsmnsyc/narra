import * as Int from "std/int"
import * as Str from "std/string"
import * as Helpers from "inl/helpers"
import { orElse } from "inl/helpers"

export function run(_args: Array<string>): int uses io, alloc {
  const limit = 2
  print(Int.toString(Helpers.countWhere([1, 2, 3, 4], (item) => item > limit)))
  print(Int.toString(Helpers.countWhere(["a", "bb", "ccc"], (item) => Str.length(item) >= limit)))
  print(Int.toString(orElse(None, () => limit * 10)))
  print(Int.toString(orElse(Some(7), () => limit)))
  return 0
}

test "inline across modules" {
  assert(orElse(None, () => 3) == 3)
}
