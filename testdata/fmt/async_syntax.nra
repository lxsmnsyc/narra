export   async   function load(id: int): int {
  return id
}

async function   pair(a: int, b: int): int {
  return (await load(a)) + await   load(b)
}

export async function run(_args: Array<string>): int {
  const twice = async   (value: int): int =>   value * 2
  const block = async   {
    return await   twice(await pair(1, 2))
  }
  const handles = [async {return 1}, async (x: int) => x]
  return await block
}
