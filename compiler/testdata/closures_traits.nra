// A trait function with an escaping parameter, implemented with the same
// marker and called from a constrained generic function. The closure
// passed in gets a heap environment, so the implementation may keep it.
import * as Int from "std/int"

trait Reg {
  function reg(v: Self, escaping f: () => int): (n: int) => int
  function use(v: Self, f: (x: int) => int): int
}

struct A implements Reg {
  x: int
}

implement Reg for A {
  function reg(v: A, escaping f: () => int): (n: int) => int {
    return (n) => f() + n + v.x
  }

  function use(v: A, f: (x: int) => int): int {
    return f(v.x)
  }
}

function go<T: Reg>(v: T, n: int): (n: int) => int {
  return Reg.reg(v, () => n + 1)
}

function twice<T: Reg>(v: T, k: int): int {
  return Reg.use(v, (x) => x * k)
}

export function run(args: Array<string>): int {
  const label = "kept"
  const f = go(A { x: 1 }, 40)
  print(`${label} ${Int.toString(f(1))}`)
  print(Int.toString(twice(A { x: 4 }, 2)))
  return 0
}
