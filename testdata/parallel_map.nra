// Parallel.map keeps the order of the items, splits more items than cores
// into parts, and gives an empty array for an empty one.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Parallel from "std/parallel"

function square(number: int): int {
  return number * number
}

export function run(_args: Array<string>): int {
  let numbers: Array<int> = []
  for (let number = 0; number < 1000; number++) {
    Arrays.push(mutable numbers, number)
  }
  const squares = Parallel.map(numbers, square)
  let inOrder = true
  for (let index = 0; index < Arrays.length(squares); index++) {
    if (squares[index] != index * index) {
      inOrder = false
    }
  }
  print(`${Int.toString(Arrays.length(squares))} squares, in order: ${inOrder ? "yes" : "no"}`)

  const offset = 7
  const labels = Parallel.map(["a", "b", "c"], (letter) => `${letter}${Int.toString(offset)}`)
  for (const label of labels) {
    print(label)
  }

  const empty: Array<int> = []
  const none = Parallel.map(empty, (number) => number + 1)
  print(`empty: ${Int.toString(Arrays.length(none))}`)
  return 0
}
