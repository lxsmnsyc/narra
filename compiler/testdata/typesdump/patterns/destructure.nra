struct Point {
  x: int
  y: int
}

struct Wrapper {
  inner: Point
  label: string
}

enum Only {
  One(value: int)
}

function sum(point: Point, pair: #[int, string], only: Only): int {
  const { x, y } = point
  const #[count, name] = pair
  let { x: a, y: b } = point
  a = a + b
  const { inner: { x: px }, label } = Wrapper { inner: point, label: name }
  const Only.One(value) = only
  return x + y + count + a + px + value
}

function typed(point: Point): int {
  const { x, y }: Point = point
  return x + y
}
