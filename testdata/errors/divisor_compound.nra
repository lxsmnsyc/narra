// error: divisor_compound.nra:4:13: the divisor must be a non-zero constant or a name checked against zero first; check the name first, as in `if (d != 0) { ... }`
function shrink(total: int, count: int): int {
  let result = total
  result /= count
  return result
}

export function run(args: Array<string>): int {
  return shrink(10, 2)
}
