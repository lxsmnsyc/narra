import * as Int from "std/int"
import * as Test from "std/test"

struct Point derives Show {
  x: int
  y: int
}

enum Shape derives Show {
  Circle(radius: f64)
  Square(side: f64)
}

function divide(a: int, b: int): int {
  return a / b
}

function label(n: int): string {
  if (n < 0) {
    panic(`negative: ${Int.toString(n)}`)
  }
  return `n=${Int.toString(n)}`
}

function printThenPanic() {
  print("from the child")
  panic("done")
}

test "eq on primitives" {
  Test.eq(1 + 1, 2)
  Test.eq(`a${"b"}`, "ab")
  Test.eq('c', 'c')
  Test.eq(true, 1 < 2)
  Test.eq(1.5, 3.0 / 2.0)
}

test "eq on structs, enums and arrays" {
  Test.eq(Point { x: 1, y: 2 }, Point { x: 1, y: 2 })
  Test.eq(Shape.Circle(1.0), Circle(1.0))
  Test.eq([1, 2, 3], [1, 2, 3])
  Test.eq(Some("x"), Some("x"))
}

test "ne" {
  Test.ne(1, 2)
  Test.ne("a", "b")
  Test.ne(Point { x: 1, y: 2 }, Point { x: 2, y: 1 })
  Test.ne([1], [1, 2])
}

test "panics" {
  Test.panics(() => divide(1, 0))
  Test.panics(() => { panic("boom") })
  const items = [1, 2]
  Test.panics(() => { const x = items[5] })
}

test "panicsWith" {
  Test.panicsWith(() => divide(1, 0), "division by zero")
  const n = -3
  Test.panicsWith(() => { const s = label(n) }, "negative: -3")
  Test.panicsWith(() => Test.eq(1, 2), "expected 2, got 1")
  Test.panicsWith(() => Test.eq("a", "b"), "expected \"b\", got \"a\"")
  Test.panicsWith(() => Test.ne(Point { x: 1, y: 2 }, Point { x: 1, y: 2 }), "other than Point { x: 1, y: 2 }")
  Test.panicsWith(() => Test.panics(() => {}), "expected a panic, but the function returned")
}

test "print in a child process" {
  Test.panics(() => printThenPanic())
  print("after the child")
}
