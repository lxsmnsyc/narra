distinct type Bit = u8
  // A shift count of a byte.
  requires < 8
distinct type Level = int requires >= 0 && <= 9 // levels
distinct type Small = int derives   Show   requires   1|2   &&   != 0
export distinct type Word = string requires /* verbs */ "go" | "stop"
distinct type Wide = int requires >= -5 &&
  <= 5
const LIMIT = 9
distinct type Bounded = int implements Show derives Shape requires >= -LIMIT && <= LIMIT
