// error: function share has a requires condition, so it cannot be used as a value; call it directly
function share(total: int, divisor: int): int
  requires divisor != 0
{
  return total / divisor
}

function apply(operation: (int, int) => int): int {
  return operation(6, 3)
}

function describe(_operation: typeof share): int {
  return 0
}

export function run(_args: Array<string>): int {
  return apply(share)
}
