import * as Env from "std/env"
import * as Process from "std/process"

test "spins until killed" {
  // The shell's parent is this test's process, so $PPID is the pid to report.
  const marker = Env.get("NARRA_SIGNAL_MARKER")
  if (marker is Some(path)) {
    const written = Process.run("sh", ["-c", "echo $PPID > \"$1\"", "sh", path])
    if (written is Err(_message)) {
      panic("cannot write the marker")
    }
  }
  let count = 0
  while (true) {
    count = count + 1
    if (count < 0) {
      print("never")
    }
  }
}
