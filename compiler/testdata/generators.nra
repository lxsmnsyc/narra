// The generator example of SPEC section 8: yield, for-of over a generator
// inside a generator, and yield*.
import * as Int from "std/int"
import * as Ranges from "std/range"

function* counter(limit: int): Generator<int> {
  for (const i of Ranges.upTo(limit)) {
    yield i
  }
}

function* evens(limit: int): Generator<int> {
  for (const n of counter(limit)) {
    if (n % 2 == 0) {
      yield n
    }
  }
}

function* both(): Generator<int> {
  yield* counter(3)
  yield* evens(10)
}

// A generator that never yields finishes on the first resume.
function* empty(): Generator<int> {
  return
}

export function run(args: Array<string>): int {
  for (const n of both()) {
    print(Int.toString(n))
  }
  for (const n of empty()) {
    print(Int.toString(n))
  }
  print("done")
  return 0
}
