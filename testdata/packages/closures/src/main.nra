import * as Int from "std/int"
import * as F from "cl/fn"
import { Handler, double } from "cl/fn"

function inc(x: int): int {
  return x + 100
}

function show(h: Handler, x: int): string {
  return `${h.name}: ${Int.toString(h.run(x))}`
}

export function run(args: Array<string>): int {
  const base = 3
  const label = "n"
  print(Int.toString(F.apply(double, 4)))
  print(Int.toString(F.apply(F.double, 5)))
  print(Int.toString(F.apply((x) => x + base, 1)))
  const names = F.map([1, 2], (x) => `${label}${Int.toString(x * base)}`)
  print(names[1])
  const quad = F.twice(double)
  print(Int.toString(quad(3)))
  const h = F.handler("plus", (x) => x + base)
  print(show(h, 10))
  print(Int.toString(F.incValue()(1)))
  print(Int.toString(F.apply(inc, 1)))
  return 0
}

test "closures across modules" {
  const k = 5
  assert(F.apply((x) => x * k, 2) == 10)
  const g = F.twice((x) => x + k)
  assert(g(0) == 10)
}

test "a second test with a closure" {
  const k = 2
  assert(F.apply((x) => x - k, 2) == 0)
}
