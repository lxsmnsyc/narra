// The checks of the generic std functions, ported from compiler/internal/narra:
// std_array.go (checkArrayLength, checkArrayPush, checkArrayFilled),
// std_map.go (mapArg, checkMapSize, checkMapRemove, checkMapIter),
// std_box.go (checkBoxNew), std_range.go (checkRangeUpTo, checkRangeBetween),
// std_option.go (preludeEnumArg, preludeArg, checkCallback, callbackReturns
// and the Option checks), std_result.go, std_testing.go (testOnly,
// checkTestCompare, checkTestPanics, checkTestGolden) and argCount
// (std_prelude.go).
//
// The registry names the Go check function of a builtin in StdFunc.check.
// checkStdCall dispatches on that name; a name without a case panics, so a
// std function added in Go fails a test until it is ported here.
//
// This module sits above narrac/closures (the callbacks of the Option and
// Result helpers go through checkArrowArgument) and narrac/exprs, which
// reaches it through Walker.checkStdCall.
import { Pos, Expr, Arg } from "narrac/ast"
import { Type } from "narrac/types"
import { Checker, Walker, errorf, typeString, lookupTrait, getExpressionPos } from "narrac/check"
import { instantiate, findTupleType } from "narrac/resolve"
import { typeImplements } from "narrac/traits"
import { checkExpression, expectType, checkExclusive, checkArgumentsLoosely, checkMutableArgument, checkFixedCall } from "narrac/exprs"
import { checkArrowArgument } from "narrac/closures"
import * as Int from "std/int"
import * as Arrays from "std/array"

// checkStdCall checks a call of a std function whose registry entry names a
// check function. name is the builtin's name (Go's CallExpr.Builtin) and
// kind the check function.
export function checkStdCall<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, kind: string, want: Option<Type>): Type uses alloc {
  if (kind == "checkArrayLength") {
    return checkArrayLength(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkArrayPush") {
    return checkArrayPush(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkArrayFilled") {
    return checkArrayFilled(mutable checker, walker, pos, args, name, want)
  }
  if (kind == "checkBoxNew") {
    return checkBoxNew(mutable checker, walker, pos, args, name, want)
  }
  if (kind == "checkRangeUpTo") {
    return checkRangeUpTo(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkRangeBetween") {
    return checkRangeBetween(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkMapSize") {
    return checkMapSize(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkMapRemove") {
    return checkMapRemove(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkMapIter") {
    return checkMapIter(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkOptionMap") {
    return checkOptionMap(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkOptionAndThen") {
    return checkOptionAndThen(mutable checker, walker, pos, args, name, want)
  }
  if (kind == "checkOptionWithDefault") {
    return checkWithDefault(mutable checker, walker, pos, args, name, "Option")
  }
  if (kind == "checkOptionOrElse") {
    return checkOptionOrElse(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkOptionIs") {
    return checkOptionIs(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkOptionOkOr") {
    return checkOptionOkOr(mutable checker, walker, pos, args, name, want)
  }
  if (kind == "checkResultMap") {
    return checkResultMap(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkResultAndThen") {
    return checkResultAndThen(mutable checker, walker, pos, args, name, want)
  }
  if (kind == "checkResultWithDefault") {
    return checkWithDefault(mutable checker, walker, pos, args, name, "Result")
  }
  if (kind == "checkResultToOption") {
    return checkResultToOption(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkTestCompare") {
    return checkTestCompare(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkTestPanics") {
    return checkTestPanics(mutable checker, walker, pos, args, name)
  }
  if (kind == "checkTestGolden") {
    return checkTestGolden(mutable checker, walker, pos, args, name)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
  return Type.TVoid
}

// checkArgumentCount reports a wrong argument count for a builtin that
// checks its own arguments, and checks the arguments loosely so their errors
// still show (Go's argCount).
function checkArgumentCount<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, count: int): bool uses alloc {
  if (Arrays.length(args) != count) {
    errorf(mutable checker, pos, `${name} takes ${Int.toString(count)} arguments, found ${Int.toString(Arrays.length(args))}`)
    checkArgumentsLoosely(mutable checker, walker, args)
    return false
  }
  return true
}

// checkArgumentAgainst checks an argument with an expected type and reports
// a mismatch at the argument.
function checkArgumentAgainst<W: Walker>(mutable checker: Checker, walker: W, argument: Expr, expected: Type) uses alloc {
  const found = checkExpression(mutable checker, walker, argument, Some(expected))
  expectType(mutable checker, getExpressionPos(argument), Some(expected), found)
}

// ---- std/array ----

// checkArrayLength checks Array.length and Array.values.
function checkArrayLength<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    return Type.TVoid
  }
  const found = checkExpression(mutable checker, walker, args[0].value, None)
  if (found is Type.TArray(_)) {
    if (name == "Array.length") {
      return Type.TInt
    }
    return found
  }
  const message = `${name} needs an array, found ${typeString(checker, found)}`
  errorf(mutable checker, pos, message)
  return Type.TVoid
}

function checkArrayPush<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (!args[0].isMutable) {
    errorf(mutable checker, pos, "Array.push changes the array; write Array.push(mutable items, value)")
  }
  const found = checkExpression(mutable checker, walker, args[0].value, None)
  if (found is Type.TArray(element)) {
    // The argument is checked before checkMutableArgument reads its local.
    checkMutableArgument(mutable checker, args[0].value)
    checkArgumentAgainst(mutable checker, walker, args[1].value, element)
    checkExclusive(mutable checker, args, [0])
    return Type.TVoid
  }
  const message = `Array.push needs an array, found ${typeString(checker, found)}`
  errorf(mutable checker, pos, message)
  return Type.TVoid
}

function checkArrayFilled<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, want: Option<Type>): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  // The expected array type gives the element a hint.
  let hint: Option<Type> = None
  if (want is Some(wantType)) {
    if (wantType is Type.TArray(wantElement)) {
      hint = Some(wantElement)
    }
  }
  const element = checkExpression(mutable checker, walker, args[0].value, hint)
  checkArgumentAgainst(mutable checker, walker, args[1].value, Type.TInt)
  return Type.TArray(element)
}

// ---- std/box ----

function checkBoxNew<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, want: Option<Type>): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    return Type.TVoid
  }
  let hint: Option<Type> = None
  if (want is Some(wantType)) {
    if (wantType is Type.TBox(wantElement)) {
      hint = Some(wantElement)
    }
  }
  const element = checkExpression(mutable checker, walker, args[0].value, hint)
  return Type.TBox(element)
}

// ---- std/range ----

function checkRangeUpTo<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    checkArgumentAgainst(mutable checker, walker, args[0].value, Type.TInt)
  }
  return Type.TRange
}

function checkRangeBetween<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    checkArgumentAgainst(mutable checker, walker, args[0].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, args[1].value, Type.TInt)
  }
  return Type.TRange
}

// ---- std/map ----

// checkMapArgument checks argument index and returns it when it is a map
// (Go's mapArg).
function checkMapArgument<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, index: int): Option<Type> uses alloc {
  const found = checkExpression(mutable checker, walker, args[index].value, None)
  if (found is Type.TMap(_, _)) {
    return Some(found)
  }
  const message = `${name} needs a map, found ${typeString(checker, found)}`
  errorf(mutable checker, pos, message)
  return None
}

function checkMapSize<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    return Type.TVoid
  }
  const _ = checkMapArgument(mutable checker, walker, pos, args, name, 0)
  return Type.TInt
}

function checkMapRemove<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (!args[0].isMutable) {
    errorf(mutable checker, pos, "Map.remove changes the map; write Map.remove(mutable m, key)")
  }
  const mapType = checkMapArgument(mutable checker, walker, pos, args, name, 0)
  checkMutableArgument(mutable checker, args[0].value)
  if (mapType is Some(foundMap)) {
    if (foundMap is Type.TMap(keyType, _)) {
      checkArgumentAgainst(mutable checker, walker, args[1].value, keyType)
      checkExclusive(mutable checker, args, [0])
      return Type.TBool
    }
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

// checkMapIter checks Map.keys and Map.entries.
function checkMapIter<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    return Type.TVoid
  }
  const mapType = checkMapArgument(mutable checker, walker, pos, args, name, 0)
  if (mapType is Some(foundMap)) {
    if (foundMap is Type.TMap(keyType, valueType)) {
      if (name == "Map.keys") {
        return Type.TArray(keyType)
      }
      return Type.TArray(findTupleType(mutable checker, [keyType, valueType]))
    }
  }
  return Type.TVoid
}

// ---- std/option and std/result ----

// makePreludeEnum instantiates a generic enum of the prelude, such as Result
// (Go's preludeEnum).
function makePreludeEnum(mutable checker: Checker, name: string, typeArgs: Array<Type>): Type uses alloc {
  if (checker.scopes[0].generics[name] is Some(generic)) {
    return instantiate(mutable checker, generic, typeArgs)
  }
  return Type.TVoid
}

// findPreludeEnum returns the type when it is an instance of the prelude
// enum name (Option or Result), as Go's preludeEnumArg does: a user enum
// of the same name is not accepted.
function findPreludeEnum(checker: Checker, found: Type, name: string): Option<Type> {
  if (found is Type.TEnum(index)) {
    const info = checker.enums[index]
    if (info.name != name || Arrays.length(info.args) == 0) {
      return None
    }
    if (checker.scopes[0].generics[name] is Some(generic)) {
      if (info.generic == generic) {
        return Some(found)
      }
    }
  }
  return None
}

// listEnumArguments lists the type arguments of an enum instance.
function listEnumArguments(checker: Checker, enumType: Type): Array<Type> {
  if (enumType is Type.TEnum(index)) {
    return checker.enums[index].args
  }
  return []
}

// checkPreludeArgument checks argument index and returns it as an instance of
// the prelude enum name, or None after reporting the mismatch (Go's
// preludeArg).
function checkPreludeArgument<W: Walker>(mutable checker: Checker, walker: W, args: Array<Arg>, name: string, index: int, enumName: string): Option<Type> uses alloc {
  const found = checkExpression(mutable checker, walker, args[index].value, None)
  if (findPreludeEnum(checker, found, enumName) is Some(enumType)) {
    return Some(enumType)
  }
  if (found == Type.TVoid) {
    return None
  }
  const argumentPos = getExpressionPos(args[index].value)
  if (enumName == "Option") {
    const message = `${name} needs an Option<T>, found ${typeString(checker, found)}`
    errorf(mutable checker, argumentPos, message)
  } else {
    const message = `${name} needs a Result<T, E>, found ${typeString(checker, found)}`
    errorf(mutable checker, argumentPos, message)
  }
  return None
}

// checkCallback checks argument index, a function the builtin calls with
// params. An arrow function gets the parameter types as its hint and a stack
// environment, because the builtin never keeps the function. result is the
// required result type, or None when the callback decides it. It returns the
// callback's result type, or None after an error (Go's checkCallback).
function checkCallback<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, index: int, params: Array<Type>, result: Option<Type>): Option<Type> uses alloc {
  const argument = args[index].value
  if (args[index].isMutable) {
    errorf(mutable checker, pos, `${name} does not change its arguments; remove \`mutable\``)
  }
  const errorsBefore = Arrays.length(checker.errs)
  const found = checkArrowArgument(mutable checker, walker, argument, params, result)
  const argumentPos = getExpressionPos(argument)
  if (found is Type.TFunc(_, foundResult)) {
    if (foundResult == Type.TVoid) {
      // An arrow whose body failed to check also ends up void; its error is
      // already reported.
      if (Arrays.length(checker.errs) == errorsBefore) {
        errorf(mutable checker, argumentPos, `${name} needs a function that returns a value`)
      }
      return None
    }
    if (result is Some(requiredResult)) {
      expectType(mutable checker, argumentPos, Some(Type.TFunc(params, requiredResult)), found)
      return Some(requiredResult)
    }
    expectType(mutable checker, argumentPos, Some(Type.TFunc(params, foundResult)), found)
    return Some(foundResult)
  }
  if (found != Type.TVoid) {
    const message = `${name} needs a function as argument ${Int.toString(index + 1)}, found ${typeString(checker, found)}`
    errorf(mutable checker, argumentPos, message)
  }
  return None
}

// checkCallbackReturns checks that a callback result is an instance of the
// prelude enum name. It returns the instance, or None after an error (Go's
// callbackReturns).
function checkCallbackReturns(mutable checker: Checker, args: Array<Arg>, name: string, callbackResult: Option<Type>, enumName: string): Option<Type> uses alloc {
  if (callbackResult is Some(resultType)) {
    if (findPreludeEnum(checker, resultType, enumName) is Some(enumType)) {
      return Some(enumType)
    }
    const message = `${name} needs a function that returns ${enumName}, found one that returns ${typeString(checker, resultType)}`
    errorf(mutable checker, getExpressionPos(args[1].value), message)
  }
  return None
}

function checkOptionMap<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, "Option") is Some(optionType)) {
    const element = listEnumArguments(checker, optionType)[0]
    if (checkCallback(mutable checker, walker, pos, args, name, 1, [element], None) is Some(mapped)) {
      return makePreludeEnum(mutable checker, "Option", [mapped])
    }
    return Type.TVoid
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

function checkOptionAndThen<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, want: Option<Type>): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, "Option") is Some(optionType)) {
    // The expected Option type of the call gives the callback its result, so
    // `None` needs no annotation there.
    let wantResult: Option<Type> = None
    if (want is Some(wantType)) {
      wantResult = findPreludeEnum(checker, wantType, "Option")
    }
    const element = listEnumArguments(checker, optionType)[0]
    const callbackResult = checkCallback(mutable checker, walker, pos, args, name, 1, [element], wantResult)
    if (checkCallbackReturns(mutable checker, args, name, callbackResult, "Option") is Some(resultType)) {
      return resultType
    }
    return Type.TVoid
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

// checkWithDefault checks Option.withDefault and Result.withDefault.
function checkWithDefault<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, enumName: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, enumName) is Some(enumType)) {
    const element = listEnumArguments(checker, enumType)[0]
    checkArgumentAgainst(mutable checker, walker, args[1].value, element)
    return element
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

function checkOptionOrElse<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, "Option") is Some(optionType)) {
    const _ = checkCallback(mutable checker, walker, pos, args, name, 1, [], Some(optionType))
    return optionType
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

// checkOptionIs checks Option.isSome and Option.isNone.
function checkOptionIs<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    const _ = checkPreludeArgument(mutable checker, walker, args, name, 0, "Option")
  }
  return Type.TBool
}

function checkOptionOkOr<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, want: Option<Type>): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  const optionType = checkPreludeArgument(mutable checker, walker, args, name, 0, "Option")

  // The expected Result type gives the error value its hint.
  let hint: Option<Type> = None
  if (want is Some(wantType)) {
    if (wantType is Type.TEnum(wantIndex)) {
      const wantInfo = checker.enums[wantIndex]
      if (wantInfo.name == "Result" && Arrays.length(wantInfo.args) == 2) {
        hint = Some(wantInfo.args[1])
      }
    }
  }
  const errorType = checkExpression(mutable checker, walker, args[1].value, hint)
  if (optionType is Some(foundOption)) {
    const element = listEnumArguments(checker, foundOption)[0]
    return makePreludeEnum(mutable checker, "Result", [element, errorType])
  }
  return Type.TVoid
}

// checkResultMap checks Result.map (the callback takes the Ok value) and
// Result.mapErr (it takes the Err value).
function checkResultMap<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, "Result") is Some(resultType)) {
    const resultArgs = listEnumArguments(checker, resultType)
    if (name == "Result.mapErr") {
      if (checkCallback(mutable checker, walker, pos, args, name, 1, [resultArgs[1]], None) is Some(mappedError)) {
        return makePreludeEnum(mutable checker, "Result", [resultArgs[0], mappedError])
      }
      return Type.TVoid
    }
    if (checkCallback(mutable checker, walker, pos, args, name, 1, [resultArgs[0]], None) is Some(mappedValue)) {
      return makePreludeEnum(mutable checker, "Result", [mappedValue, resultArgs[1]])
    }
    return Type.TVoid
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

function checkResultAndThen<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string, want: Option<Type>): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, "Result") is Some(resultType)) {
    const resultArgs = listEnumArguments(checker, resultType)

    // The expected type of the call, when its error type is the argument's,
    // gives the callback its result, so `Err("e")` needs no annotation there.
    let wantResult: Option<Type> = None
    if (want is Some(wantType)) {
      if (findPreludeEnum(checker, wantType, "Result") is Some(wantEnum)) {
        if (listEnumArguments(checker, wantEnum)[1] == resultArgs[1]) {
          wantResult = Some(wantEnum)
        }
      }
    }
    const callbackResult = checkCallback(mutable checker, walker, pos, args, name, 1, [resultArgs[0]], wantResult)
    if (checkCallbackReturns(mutable checker, args, name, callbackResult, "Result") is Some(returned)) {
      // The callback keeps the error type: an Err passes through unchanged.
      const returnedError = listEnumArguments(checker, returned)[1]
      if (returnedError != resultArgs[1]) {
        const message = `expected ${typeString(checker, resultArgs[1])}, found ${typeString(checker, returnedError)}`
        errorf(mutable checker, getExpressionPos(args[1].value), message)
      }
      return returned
    }
    return Type.TVoid
  }
  checkExpression(mutable checker, walker, args[1].value, None)
  return Type.TVoid
}

// checkResultToOption checks Result.ok and Result.err.
function checkResultToOption<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 1)) {
    return Type.TVoid
  }
  if (checkPreludeArgument(mutable checker, walker, args, name, 0, "Result") is Some(resultType)) {
    const resultArgs = listEnumArguments(checker, resultType)
    if (name == "Result.err") {
      return makePreludeEnum(mutable checker, "Option", [resultArgs[1]])
    }
    return makePreludeEnum(mutable checker, "Option", [resultArgs[0]])
  }
  return Type.TVoid
}

// ---- std/test ----

// checkTestOnly reports a std/test call outside a test block (Go's
// testOnly).
function checkTestOnly(mutable checker: Checker, pos: Pos, name: string) uses alloc {
  if (!checker.inTest) {
    errorf(mutable checker, pos, `${name} can only be called inside a \`test\` block`)
  }
}

// checkTestCompare checks Test.eq and Test.ne: two values of one type that
// implements Equatable and Show.
function checkTestCompare<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  checkTestOnly(mutable checker, pos, name)
  if (!checkArgumentCount(mutable checker, walker, pos, args, name, 2)) {
    return Type.TVoid
  }
  for (const arg of Arrays.values(args)) {
    if (arg.isMutable) {
      errorf(mutable checker, pos, `${name} does not change its arguments; remove \`mutable\``)
    }
  }
  const first = checkExpression(mutable checker, walker, args[0].value, None)
  checkArgumentAgainst(mutable checker, walker, args[1].value, first)
  if (first == Type.TVoid) {
    return Type.TVoid
  }
  for (const traitName of Arrays.values(["Equatable", "Show"])) {
    const traitIndex = lookupTrait(checker, traitName)
    if (!typeImplements(mutable checker, first, traitIndex)) {
      const message = `${typeString(checker, first)} does not implement ${traitName}`
      errorf(mutable checker, pos, message)
    }
  }
  return Type.TVoid
}

// checkTestPanics checks Test.panics(f) and Test.panicsWith(f, message).
function checkTestPanics<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  checkTestOnly(mutable checker, pos, name)
  let params = [Type.TFunc([], Type.TVoid)]
  if (name == "Test.panicsWith") {
    Arrays.push(mutable params, Type.TStr)
  }
  return checkFixedCall(mutable checker, walker, pos, args, name, params, Type.TVoid)
}

function checkTestGolden<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, args: Array<Arg>, name: string): Type uses alloc {
  checkTestOnly(mutable checker, pos, name)
  return checkFixedCall(mutable checker, walker, pos, args, name, [Type.TStr, Type.TStr], Type.TVoid)
}
