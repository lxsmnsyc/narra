import { Area } from "tp/shape"
import * as Float from "std/float"
import * as Array from "std/array"

export function describe<T: Area>(shape: T): string uses alloc {
  return `${Area.name(shape)} with area ${Float.toString(Area.area(shape))}`
}

export function largest<T: Ordered & Show>(items: Array<T>, first: T): string {
  let best = first
  for (const item of Array.values(items)) {
    if (Ordered.compare(item, best) is Greater) {
      best = item
    }
  }
  return Show.show(best)
}

export function count<T: Equatable>(items: Array<T>, wanted: T): int {
  let n = 0
  for (const item of Array.values(items)) {
    if (item == wanted) {
      n = n + 1
    }
  }
  return n
}
