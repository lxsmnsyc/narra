// Self tail calls that pass a counted parameter back unchanged, next to ones
// that replace it: the unchanged one is borrowed from the caller and must
// survive the loop, also when the function returns or stores it.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

function joinAll(separator: string, items: Array<string>, index: int, text: string): string {
  if (index == Arrays.length(items)) {
    return text
  }
  // separator and items pass through; text is rebuilt.
  return joinAll(separator, items, index + 1, `${text}${separator}${items[index]}`)
}

function swapOnly(first: string, second: string, steps: int): string {
  if (steps == 0) {
    return `${first}/${second}`
  }
  return swapOnly(second, first, steps - 1)
}

function returnKept(kept: Array<string>, steps: int): Array<string> {
  if (steps == 0) {
    return kept
  }
  return returnKept(kept, steps - 1)
}

function collect(kept: string, steps: int, found: Array<string>): Array<string> {
  if (steps == 0) {
    return found
  }
  let next = found
  Arrays.push(mutable next, kept)
  return collect(kept, steps - 1, next)
}

function countDown(label: string, steps: int) {
  if (steps == 0) {
    print(label)
    return
  }
  countDown(label, steps - 1)
}

export function run(args: Array<string>): int {
  const items = ["a", "b", "c"]
  const separator = Str.repeat("-", 2)
  print(joinAll(separator, items, 0, "start"))
  print(`${separator} ${Int.toString(Arrays.length(items))}`)
  print(swapOnly("x", "y", 3))
  const kept = ["k1", "k2"]
  const again = returnKept(kept, 4)
  print(`${kept[0]} ${again[1]} ${Int.toString(Arrays.length(again))}`)
  const label = Str.repeat("L", 3)
  const found = collect(label, 3, [])
  print(`${found[0]} ${found[2]} ${label}`)
  countDown(label, 5)
  print(Int.toString(Arrays.length(found)))
  return 0
}
