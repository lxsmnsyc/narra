// A keyword map built in a loop by an @const function, in insertion order.
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Int from "std/int"
import * as Str from "std/string"

const WORDS = ["const", "let", "function", "return", "if", "else"]

@const
function buildKeywords(words: Array<string>): Map<string, int> uses alloc {
  let keywords: Map<string, int> = Map {}
  for (const #[index, word] of Arrays.entries(words)) {
    keywords[word] = index + 1
  }
  // A later write keeps the key's place; a removed key leaves the others in order.
  keywords["let"] = 20
  const _ = Maps.remove(mutable keywords, "if")
  return keywords
}

const KEYWORDS = buildKeywords(WORDS)

function describe(keywords: Map<string, int>): string uses alloc {
  let parts: Array<string> = []
  for (const #[word, number] of Maps.entries(keywords)) {
    Arrays.push(mutable parts, `${word}=${Int.toString(number)}`)
  }
  return Str.join(parts, " ")
}

export function run(args: Array<string>): int uses io, alloc {
  const words = WORDS
  print(describe(KEYWORDS))
  print(describe(buildKeywords(words)))
  if (KEYWORDS["return"] is Some(found)) {
    print(Int.toString(found))
  }
  print(Int.toString(Maps.size(KEYWORDS)))
  return 0
}
