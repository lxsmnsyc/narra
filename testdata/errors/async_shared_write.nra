// error: items[0] = ... may change items, which handle still uses at line 16; take a copy where it is shared, with copy(...)
import * as Arrays from "std/array"

async function total(items: Array<int>): int {
  let sum = 0
  for (const item of Arrays.values(items)) {
    sum += item
  }
  return sum
}

export async function run(_args: Array<string>): int {
  let items = [1, 2, 3]
  const handle = total(items)
  items[0] = 10
  return await handle
}
