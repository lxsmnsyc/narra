// Ptr.cast changes the element type of a pointer; Ptr.element is the address of one item of a FixedArray.
import * as Ptr from "std/ptr"
import * as Int from "std/int"
import * as U8 from "std/u8"
import * as U32 from "std/u32"

struct Pair {
  low: u32
  high: u32
}

@trusted
function castWord(): string uses alloc {
  let report = ""
  unsafe {
    const word: Ptr<u32> = Ptr.alloc(1)
    Ptr.write(word, 4294967295)
    const bytes: Ptr<u8> = Ptr.cast(word)
    let total = 0
    for (let index = 0; index < 4; index++) {
      total += Int.from(Ptr.read(Ptr.offset(bytes, index)))
    }
    const back: Ptr<u32> = Ptr.cast(bytes)
    report = `${Int.toString(total)} ${U32.toString(Ptr.read(back))}`
    Ptr.free(word)
  }
  return report
}

@trusted
function castPair(): string uses alloc {
  let report = ""
  unsafe {
    const pair: Ptr<Pair> = Ptr.alloc(1)
    Ptr.write(pair, Pair { low: 7, high: 9 })
    const words: Ptr<u32> = Ptr.cast(pair)
    const second = Ptr.read(Ptr.offset(words, 1))
    report = U32.toString(second)
    Ptr.free(pair)
  }
  return report
}

@trusted
function elementAddresses(): string uses alloc {
  let report = ""
  unsafe {
    const buffer: Ptr<FixedArray<u8, 4>> = Ptr.alloc(1)
    Ptr.write(buffer, [10, 20, 30, 40])
    const third = Ptr.element(buffer, 2)
    Ptr.write(third, 33)
    const last = Ptr.offset(Ptr.element(buffer, 0), 3)
    Ptr.write(last, 44)
    let sum = 0
    for (let index = 0; index < 4; index++) {
      sum += Int.from(Ptr.read(Ptr.element(buffer, index)))
    }
    const stored = Ptr.read(buffer)
    report = `${Int.toString(sum)} ${U8.toString(stored[2])} ${U8.toString(stored[3])}`
    Ptr.free(buffer)
  }
  return report
}

export function run(_args: Array<string>): int {
  print(castWord())
  print(castPair())
  print(elementAddresses())
  return 0
}
