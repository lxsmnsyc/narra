// error: Arrays.entries gives #[index, item] tuples; write `for (const #[index, mutable player] of Arrays.entries(items))`
import * as Arrays from "std/array"

struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  for (mutable player of Arrays.entries(players)) {
    print("x")
  }
  return 0
}
