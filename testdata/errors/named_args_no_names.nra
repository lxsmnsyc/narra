// error: named_args_no_names.nra:10:24: step has no parameter names; pass its arguments by position
import * as Str from "std/string"

enum Shape {
  Circle(radius: int)
}

export function run(args: Array<string>): int {
  const step = (value: int): int => value + 1
  const stepped = step(value: 1)
  const text = Str.slice(text: "abc", 0, 1)
  const shape = Shape.Circle(radius: 2)
  return stepped + Str.length(Show.show(text))
}
