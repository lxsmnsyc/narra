// error: "player" is a copy of an element of players, so changing it would not change players; write `for (mutable player of players)`
struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  for (const player of players) {
    player.hp = 0
  }
  return players[0].hp
}
