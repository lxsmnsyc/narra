// A panic in a copied @inline body, with values the copy holds, names the
// callee's line.
import * as Str from "std/string"

@inline
function pickWith(items: Array<string>, choose: (count: int) => int): string uses alloc {
  const label = `item ${items[0]}`
  const index = choose(Str.length(label))
  return items[index]
}

export function run(_args: Array<string>): int uses alloc {
  const offset = 2
  const picked = pickWith(["a", "b"], (count) => count + offset)
  return Str.length(picked)
}
