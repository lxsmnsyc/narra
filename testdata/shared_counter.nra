// Eight threads each add one to a Shared counter 10000 times; the lock makes
// the total exact.
import * as Thread from "std/thread"
import * as Shared from "std/shared"
import * as Int from "std/int"

function count(hits: Shared.Shared<int>) {
  for (let index = 0; index < 10000; index++) {
    Shared.update(hits, (value) => value + 1)
  }
}

export function run(_args: Array<string>): int {
  const hits = Shared.create(0)
  const started = Thread.scope((scope) => {
    for (let index = 0; index < 8; index++) {
      Thread.start(scope, () => count(hits))
    }
    return 8
  })
  print(`${Int.toString(started)} threads, total ${Int.toString(Shared.get(hits))}`)
  return 0
}
