// Call arguments are evaluated in the order they are written: a later
// argument that assigns a `let` does not change an earlier argument.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Str from "std/string"

function show(items: Array<string>, extra: int): int {
  return Arrays.length(items) + extra
}

function pair(left: int, right: int): int {
  return left * 10 + right
}

function say(label: string, number: int): int {
  print(label)
  return number
}

// a self tail call: the arguments are hoisted in written order
function tailOrder(count: int, current: int, seen: int): int {
  if (count == 0) {
    return seen * 1000 + current
  }
  let next = current
  return tailOrder(
    count - 1,
    next,
    {
      next = next + 100
      return next
    },
  )
}

function applyTwice(base: int, step: (n: int) => int): int {
  return step(step(base))
}

function addUp(mutable total: Array<int>, extra: int): int {
  Arrays.push(mutable total, extra)
  return Arrays.length(total)
}

export function run(args: Array<string>): int {
  // a block argument that assigns a `let` read by an earlier argument
  let items = ["a", "b", "c"]
  print(
    Int.toString(
      show(
        items,
        {
          items = ["z"]
          return 0
        },
      ),
    ),
  )

  // a call with a side effect after a read of the same `let`
  let value = 1
  print(
    Int.toString(
      pair(
        value,
        {
          value = 5
          return value
        },
      ),
    ),
  )

  // calls with side effects run left to right
  print(Int.toString(pair(say("first", 1), say("second", 2))))

  // a self tail call
  print(Int.toString(tailOrder(1, 1, 0)))

  // a std builtin call
  let text = "abcd"
  print(
    Str.slice(
      text,
      0,
      {
        text = "wx"
        return 2
      },
    ),
  )

  // a closure held in a local is only read while the arguments are evaluated
  let offset = 1
  const addOne = (n: int): int => n + 1
  print(Int.toString(pair(offset, applyTwice(offset, addOne))))

  // a mutable argument next to a block argument
  let totals: Array<int> = []
  print(
    Int.toString(
      addUp(
        mutable totals,
        {
          offset = 9
          return offset
        },
      ),
    ),
  )
  return 0
}
