// error: "players" cannot be used inside the loop that changes players in place; reach its elements through player, or write an index loop
import * as Arrays from "std/array"

struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  for (mutable player of players) {
    player.hp = Arrays.length(players)
  }
  return 0
}
