// error: "game" cannot be used inside the loop that changes game.players in place; reach its elements through player, or write an index loop
struct Player {
  hp: int
}

struct Game {
  players: Array<Player>
  round: int
}

export function run(args: Array<string>): int {
  let game = Game { players: [Player { hp: 3 }], round: 1 }
  for (mutable player of game.players) {
    player.hp = 1
    game = Game { players: [], round: 2 }
  }
  return game.round
}
