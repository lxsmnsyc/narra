struct Empty {}
struct   Point { x: int, y: int = 0 }
export struct Box<T> implements Show, Ordered derives Eq {
  value: T
  label: string = "box"

  next: Option<int>
}
export opaque struct Hidden { secret: int }
enum Color { Red, Green,
  Blue }
export enum Shape<T> implements Show {
  Circle(radius: f64)
  Rect(width: f64, height: f64)
  Labeled(aVeryLongFieldNameNumberOne: string, aVeryLongFieldNameNumberTwo: string, aVeryLongFieldNameNumberThree: int)

  Unit
}
enum NoVariants {}
distinct type UserId = int
export opaque distinct type Token = Array<int>
