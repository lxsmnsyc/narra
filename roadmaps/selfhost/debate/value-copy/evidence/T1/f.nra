import * as Arrays from "std/array"
import * as Int from "std/int"

struct Bag {
  items: Array<int>
}

function reset(mutable bag: Bag) {
  bag.items = [9]
}

export function run(args: Array<string>): int uses io, alloc {
  let bag = Bag { items: [100, 200] }
  const items = copy(bag.items)
  reset(mutable bag)
  print(Int.toString(Arrays.length(items)))
  print(Int.toString(items[0]))
  return 0
}
