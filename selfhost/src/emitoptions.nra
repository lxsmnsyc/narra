// Option, Result and test calls, and the C main of a test build
// (std_option.go, std_result.go, std_testing.go, test_runner.go). Stub from
// selfhost-emit-core; the owner is selfhost-emit-options.
import { Expr } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported, hasWork } from "narrac/emitstate"

const NODE = "selfhost-emit-options"

// reportOptionsWork is called by the driver while the program facts are
// missing, so an input that needs this node is listed. selfhost-emit-options
// removes it.
export function reportOptionsWork(mutable emitter: Emitter): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `${reportUnsupported(mutable emitter, "option and result calls", NODE)}\n`
  }
  return ""
}

export function emitOptionCall<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "option call", NODE), owned: false }
}

// emitTestMain writes the test runner and the C main of a test build.
export function emitTestMain(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "test main", NODE)}\n`
}
