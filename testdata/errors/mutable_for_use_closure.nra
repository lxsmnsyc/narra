// error: "players" cannot be used inside the loop that changes players in place; reach its elements through player, or write an index loop
import * as Arrays from "std/array"

struct Player {
  hp: int
}

function twice(action: () => void) {
  action()
  action()
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  for (mutable player of players) {
    twice(() => {
      Arrays.push(mutable players, Player { hp: 1 })
    })
    player.hp = 0
  }
  return 0
}
