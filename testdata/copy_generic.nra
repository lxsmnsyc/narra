// copy in a generic function: the instance with int copies nothing and is
// not an error, the instance with an array copies, and the copy check
// finds no hidden copy.
import * as Int from "std/int"

function duplicate<T>(value: T): T {
  return copy(value)
}

export function run(_args: Array<string>): int {
  const count = duplicate(4)
  const values = [1, 2]
  let copied = duplicate(values)
  copied[0] = 10
  print(`${Int.toString(count)} ${Int.toString(values[0])} ${Int.toString(copied[0])}`)
  return 0
}
