// std/set: a collection of distinct values, kept in the order they were added.
//
// A Set is a value like an Array or a Map: a copy is independent of the original.
// The type is opaque, so code outside the module cannot reach the map inside it.
// The items need the same trait as map keys: Hashable.

import * as Maps from "std/map"

export opaque struct Set<T: Hashable> {
  members: Map<T, bool>
}

export function create<T: Hashable>(): Set<T> uses alloc {
  return Set<T> { members: Map<T, bool> {} }
}

export function add<T: Hashable>(mutable set: Set<T>, item: T): bool uses alloc {
  if (has(set, item)) {
    return false
  }
  set.members[item] = true
  return true
}

export function has<T: Hashable>(set: Set<T>, item: T): bool {
  return set.members[item] is Some(_)
}

export function remove<T: Hashable>(mutable set: Set<T>, item: T): bool uses alloc {
  return Maps.remove(mutable set.members, item)
}

export function size<T: Hashable>(set: Set<T>): int {
  return Maps.size(set.members)
}

export function values<T: Hashable>(set: Set<T>): Array<T> uses alloc {
  return Maps.keys(set.members)
}

export function union<T: Hashable>(first: Set<T>, second: Set<T>): Set<T> uses alloc {
  let result: Set<T> = create()
  for (const item of values(first)) {
    add(mutable result, item)
  }
  for (const item of values(second)) {
    add(mutable result, item)
  }
  return result
}

export function intersection<T: Hashable>(first: Set<T>, second: Set<T>): Set<T> uses alloc {
  let result: Set<T> = create()
  for (const item of values(first)) {
    if (has(second, item)) {
      add(mutable result, item)
    }
  }
  return result
}

export function difference<T: Hashable>(first: Set<T>, second: Set<T>): Set<T> uses alloc {
  let result: Set<T> = create()
  for (const item of values(first)) {
    if (!has(second, item)) {
      add(mutable result, item)
    }
  }
  return result
}
