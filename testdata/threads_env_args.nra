// Four threads read the program arguments at once. On Linux the runtime reads
// them from /proc/self/cmdline on first use, once, under pthread_once.
import * as Thread from "std/thread"
import * as Arrays from "std/array"
import * as Env from "std/env"
import * as Int from "std/int"
import * as Ranges from "std/range"

function countArguments(round: int): int uses io, alloc {
  return Arrays.length(Env.args()) + round - round
}

export function run(args: Array<string>): int {
  const counts = Thread.scope((scope) => {
    let threads: Array<Thread.Thread<int>> = []
    for (const round of Ranges.between(0, 4)) {
      Arrays.push(mutable threads, Thread.start(scope, () => countArguments(round)))
    }
    let same = 0
    for (const thread of Arrays.values(threads)) {
      if (Thread.join(thread) == Arrays.length(args)) {
        same++
      }
    }
    return same
  })
  print(`${Int.toString(counts)} of 4 threads saw every argument`)
  return 0
}
