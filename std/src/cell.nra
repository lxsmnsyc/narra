// std/cell: Cell<T>, one mutable slot that every copy of the handle shares.
//
// A Cell is an identity type: copying it, capturing it in a closure or storing it in a
// struct copies the handle, and Cell.set through any copy changes what all of them read.

import * as Boxes from "std/box"
import * as Slot from "std/internal/cell"

export opaque struct Cell<T> {
  slot: Box<T>
}

export function create<T>(value: T): Cell<T> uses alloc {
  return Cell { slot: Boxes.new(value) }
}

export function get<T>(cell: Cell<T>): T from cell {
  return cell.slot.value
}

export function set<T>(cell: Cell<T>, value: T) {
  Slot.store(cell.slot, value)
}

export function update<T, effect E>(cell: Cell<T>, change: (value: T) => T uses E) uses E {
  // Hold the old value, so a set inside change cannot free it.
  const old = get(cell)
  Slot.store(cell.slot, change(old))
}
