// The lexer, ported line by line from compiler/internal/narra/lexer.go.
// It reads the source bytes and slices token text out of the source. Columns
// count characters, not bytes: a continuation byte of a multi-byte character
// does not move the column.
import { repeatString, substring } from "narrac/textops"
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import { Pos } from "narrac/ast"
import { Fix, buildQuoteFix, buildRemoveSemicolonFix } from "narrac/fixes"
import { Comment, CommentKind } from "narrac/trivia"

// The kinds carry a Tok prefix, as in Go, so they do not clash with the
// expression variants of narrac/ast (IntLit, Ident, ...).
export enum TokenKind {
  TokEof
  TokNewline
  TokIdent
  TokInt
  TokFloat
  TokString
  TokChar
  TokTemplate
  TokKeyword
  TokPunct
}

// A token. endLine:endColumn is the position after its last character (Go:
// Token.End); the parser reads it for StringLit.end.
export struct Token {
  kind: TokenKind
  text: string
  line: int
  column: int
  endLine: int
  endColumn: int
  symbol: int // the SYMBOL_ constant of a keyword or punctuation token the parser tests, else 0
}

struct Lexer {
  source: string
  index: int // a byte offset into source
  line: int
  column: int
  depth: int // nesting of ( and [, where line breaks never end a statement
  savedDepths: Array<int> // depth outside each open {, where line breaks end statements again
  savedCount: int // how many entries of savedDepths are in use
  tokens: Array<Token>
  keepComments: bool // lexWithComments: collect the comments the tokens skip
  comments: Array<Comment>
}

const KEYWORDS = Map {
  "function": true,
  "export": true,
  "import": true,
  "from": true,
  "as": true,
  "const": true,
  "let": true,
  "if": true,
  "else": true,
  "while": true,
  "for": true,
  "of": true,
  "return": true,
  "break": true,
  "continue": true,
  "struct": true,
  "enum": true,
  "match": true,
  "true": true,
  "false": true,
  "mutable": true,
  "uses": true,
  "test": true,
  "is": true,
  "trait": true,
  "implement": true,
  "implements": true,
  "derives": true,
  "yield": true,
}

// Ids of the keywords and punctuation the parser tests, so it compares ints, not text.
export const SYMBOL_BANG = 1
export const SYMBOL_NOT_EQUAL = 2
export const SYMBOL_NOT_DOUBLE_EQUAL = 3
export const SYMBOL_HASH_BRACKET = 4
export const SYMBOL_PERCENT = 5
export const SYMBOL_AMPERSAND = 6
export const SYMBOL_AND = 7
export const SYMBOL_LEFT_PAREN = 8
export const SYMBOL_RIGHT_PAREN = 9
export const SYMBOL_STAR = 10
export const SYMBOL_PLUS = 11
export const SYMBOL_COMMA = 12
export const SYMBOL_MINUS = 13
export const SYMBOL_DOT = 14
export const SYMBOL_ELLIPSIS = 15
export const SYMBOL_SLASH = 16
export const SYMBOL_COLON = 17
export const SYMBOL_SEMICOLON = 18
export const SYMBOL_LESS = 19
export const SYMBOL_SHIFT_LEFT = 20
export const SYMBOL_LESS_EQUAL = 21
export const SYMBOL_EQUALS = 22
export const SYMBOL_EQUAL_EQUAL = 23
export const SYMBOL_TRIPLE_EQUAL = 24
export const SYMBOL_ARROW = 25
export const SYMBOL_GREATER = 26
export const SYMBOL_GREATER_EQUAL = 27
export const SYMBOL_SHIFT_RIGHT = 28
export const SYMBOL_QUESTION = 29
export const SYMBOL_LEFT_BRACKET = 30
export const SYMBOL_RIGHT_BRACKET = 31
export const SYMBOL_CARET = 32
export const SYMBOL_KEYWORD_AS = 33
export const SYMBOL_KEYWORD_BREAK = 34
export const SYMBOL_KEYWORD_CONST = 35
export const SYMBOL_KEYWORD_CONTINUE = 36
export const SYMBOL_KEYWORD_DERIVES = 37
export const SYMBOL_KEYWORD_ELSE = 38
export const SYMBOL_KEYWORD_ENUM = 39
export const SYMBOL_KEYWORD_EXPORT = 40
export const SYMBOL_KEYWORD_FALSE = 41
export const SYMBOL_KEYWORD_FOR = 42
export const SYMBOL_KEYWORD_FROM = 43
export const SYMBOL_KEYWORD_FUNCTION = 44
export const SYMBOL_KEYWORD_IF = 45
export const SYMBOL_KEYWORD_IMPLEMENT = 46
export const SYMBOL_KEYWORD_IMPLEMENTS = 47
export const SYMBOL_KEYWORD_IMPORT = 48
export const SYMBOL_AT = 49
export const SYMBOL_KEYWORD_IS = 50
export const SYMBOL_KEYWORD_LET = 51
export const SYMBOL_KEYWORD_MATCH = 52
export const SYMBOL_KEYWORD_MUTABLE = 53
export const SYMBOL_KEYWORD_OF = 54
export const SYMBOL_KEYWORD_RETURN = 55
export const SYMBOL_KEYWORD_STRUCT = 56
export const SYMBOL_KEYWORD_TEST = 57
export const SYMBOL_KEYWORD_TRAIT = 58
export const SYMBOL_KEYWORD_TRUE = 59
export const SYMBOL_KEYWORD_USES = 60
export const SYMBOL_KEYWORD_WHILE = 61
export const SYMBOL_KEYWORD_YIELD = 62
export const SYMBOL_LEFT_BRACE = 63
export const SYMBOL_PIPE = 64
export const SYMBOL_OR = 65
export const SYMBOL_RIGHT_BRACE = 66
export const SYMBOL_TILDE = 67

export const SYMBOLS_BY_TEXT = Map {
  "!": SYMBOL_BANG,
  "!=": SYMBOL_NOT_EQUAL,
  "!==": SYMBOL_NOT_DOUBLE_EQUAL,
  "#[": SYMBOL_HASH_BRACKET,
  "%": SYMBOL_PERCENT,
  "&": SYMBOL_AMPERSAND,
  "&&": SYMBOL_AND,
  "(": SYMBOL_LEFT_PAREN,
  ")": SYMBOL_RIGHT_PAREN,
  "*": SYMBOL_STAR,
  "+": SYMBOL_PLUS,
  ",": SYMBOL_COMMA,
  "-": SYMBOL_MINUS,
  ".": SYMBOL_DOT,
  "...": SYMBOL_ELLIPSIS,
  "/": SYMBOL_SLASH,
  ":": SYMBOL_COLON,
  ";": SYMBOL_SEMICOLON,
  "<": SYMBOL_LESS,
  "<<": SYMBOL_SHIFT_LEFT,
  "<=": SYMBOL_LESS_EQUAL,
  "=": SYMBOL_EQUALS,
  "==": SYMBOL_EQUAL_EQUAL,
  "===": SYMBOL_TRIPLE_EQUAL,
  "=>": SYMBOL_ARROW,
  ">": SYMBOL_GREATER,
  ">=": SYMBOL_GREATER_EQUAL,
  ">>": SYMBOL_SHIFT_RIGHT,
  "?": SYMBOL_QUESTION,
  "@": SYMBOL_AT,
  "[": SYMBOL_LEFT_BRACKET,
  "]": SYMBOL_RIGHT_BRACKET,
  "^": SYMBOL_CARET,
  "as": SYMBOL_KEYWORD_AS,
  "break": SYMBOL_KEYWORD_BREAK,
  "const": SYMBOL_KEYWORD_CONST,
  "continue": SYMBOL_KEYWORD_CONTINUE,
  "derives": SYMBOL_KEYWORD_DERIVES,
  "else": SYMBOL_KEYWORD_ELSE,
  "enum": SYMBOL_KEYWORD_ENUM,
  "export": SYMBOL_KEYWORD_EXPORT,
  "false": SYMBOL_KEYWORD_FALSE,
  "for": SYMBOL_KEYWORD_FOR,
  "from": SYMBOL_KEYWORD_FROM,
  "function": SYMBOL_KEYWORD_FUNCTION,
  "if": SYMBOL_KEYWORD_IF,
  "implement": SYMBOL_KEYWORD_IMPLEMENT,
  "implements": SYMBOL_KEYWORD_IMPLEMENTS,
  "import": SYMBOL_KEYWORD_IMPORT,
  "is": SYMBOL_KEYWORD_IS,
  "let": SYMBOL_KEYWORD_LET,
  "match": SYMBOL_KEYWORD_MATCH,
  "mutable": SYMBOL_KEYWORD_MUTABLE,
  "of": SYMBOL_KEYWORD_OF,
  "return": SYMBOL_KEYWORD_RETURN,
  "struct": SYMBOL_KEYWORD_STRUCT,
  "test": SYMBOL_KEYWORD_TEST,
  "trait": SYMBOL_KEYWORD_TRAIT,
  "true": SYMBOL_KEYWORD_TRUE,
  "uses": SYMBOL_KEYWORD_USES,
  "while": SYMBOL_KEYWORD_WHILE,
  "yield": SYMBOL_KEYWORD_YIELD,
  "{": SYMBOL_LEFT_BRACE,
  "|": SYMBOL_PIPE,
  "||": SYMBOL_OR,
  "}": SYMBOL_RIGHT_BRACE,
  "~": SYMBOL_TILDE,
}

// Punctuation by first byte, longest first, so "==" is matched before "=".
const PUNCTS_BY_FIRST_BYTE = Map {
  61: ["===", "=>", "==", "="],
  33: ["!==", "!=", "!"],
  46: ["...", "."],
  35: ["#["],
  60: ["<=", "<<", "<"],
  62: [">=", ">>", ">"],
  38: ["&&", "&"],
  124: ["||", "|"],
  43: ["+"],
  45: ["-"],
  42: ["*"],
  47: ["/"],
  37: ["%"],
  94: ["^"],
  126: ["~"],
  40: ["("],
  41: [")"],
  123: ["{"],
  125: ["}"],
  91: ["["],
  93: ["]"],
  44: [","],
  58: [":"],
  59: [";"],
  63: ["?"],
  64: ["@"],
}

// Byte values of the ASCII characters the lexer tests.
const TAB = 9
const NEWLINE = 10
const CARRIAGE_RETURN = 13
const SPACE = 32
const DOUBLE_QUOTE = 34
const DOLLAR = 36
const SINGLE_QUOTE = 39
const STAR = 42
const PLUS = 43
const MINUS = 45
const DOT = 46
const SLASH = 47
const ZERO = 48
const NINE = 57
const UPPER_A = 65
const UPPER_E = 69
const UPPER_F = 70
const UPPER_Z = 90
const BACKSLASH = 92
const UNDERSCORE = 95
const BACKTICK = 96
const LOWER_A = 97
const LOWER_B = 98
const LOWER_E = 101
const LOWER_F = 102
const LOWER_O = 111
const LOWER_U = 117
const LOWER_X = 120
const LOWER_Z = 122
const OPEN_BRACE = 123
const CLOSE_BRACE = 125

function createLexer(source: string, keepComments: bool): Lexer {
  return Lexer {
    source: source,
    index: 0,
    line: 1,
    column: 1,
    depth: 0,
    savedDepths: [],
    savedCount: 0,
    tokens: [],
    keepComments: keepComments,
    comments: [],
  }
}

// A lexical error. code is the diagnostic code (see diagnostics.nra).
export struct LexError {
  code: string
  line: int
  column: int
  message: string
  fixes: Array<Fix> = []
}

export function formatLexError(error: LexError): string uses alloc {
  return `${Int.toString(error.line)}:${Int.toString(error.column)}: ${error.message}`
}

export function lex(source: string): Result<Array<Token>, LexError> uses alloc {
  let lexer = createLexer(source, false)
  const failed = runLexer(mutable lexer)
  if (failed is Some(message)) {
    return Err(message)
  }
  return Ok(lexer.tokens)
}

export function lexFrom(
  source: string,
  line: int,
  column: int,
): Result<Array<Token>, LexError> uses alloc {
  let lexer = createLexer(source, false)
  // Tokens report positions as if the source started at line:column.
  lexer.line = line
  lexer.column = column
  const failed = runLexer(mutable lexer)
  if (failed is Some(message)) {
    return Err(message)
  }
  return Ok(lexer.tokens)
}

export function lexWithComments(source: string): Result<#[
  Array<Token>,
  Array<Comment>,
], LexError> uses alloc {
  let lexer = createLexer(source, true)
  const failed = runLexer(mutable lexer)
  if (failed is Some(message)) {
    return Err(message)
  }
  return Ok(#[lexer.tokens, lexer.comments])
}

function recordComment(mutable lexer: Lexer, first: int, line: int, column: int) {
  const text = readText(lexer, first, lexer.index)
  let kind = CommentKind.Block
  if (Str.startsWith(text, "///")) {
    kind = CommentKind.Doc
  } else if (Str.startsWith(text, "//")) {
    kind = CommentKind.Line
  }
  // only whitespace before it on its line?
  let ownLine = true
  let back = first
  while (back > 0 && Str.byteAt(lexer.source, back - 1) != NEWLINE) {
    back--
    const before = Str.byteAt(lexer.source, back)
    if (before != SPACE && before != TAB && before != CARRIAGE_RETURN) {
      ownLine = false
    }
  }
  const comment = Comment {
    kind: kind,
    text: text,
    pos: Pos { line: line, column: column },
    end: Pos { line: lexer.line, column: lexer.column },
    ownLine: ownLine,
  }
  Arrays.push(mutable lexer.comments, comment)
}

function errorAt(line: int, column: int, code: string, message: string): Option<LexError> {
  return Some(LexError { code: code, line: line, column: column, message: message })
}

function errorWithFixesAt(
  line: int,
  column: int,
  code: string,
  fixes: Array<Fix>,
  message: string,
): Option<LexError> from fixes {
  return Some(LexError { code: code, line: line, column: column, message: message, fixes: fixes })
}

function getSize(lexer: Lexer): int {
  return Str.length(lexer.source)
}

function peek(lexer: Lexer, offset: int): int {
  if (lexer.index + offset < Str.length(lexer.source)) {
    return Str.byteAt(lexer.source, lexer.index + offset)
  }
  return 0
}

function advance(mutable lexer: Lexer): int {
  const byte = Str.byteAt(lexer.source, lexer.index)
  lexer.index++
  if (byte == NEWLINE) {
    lexer.line++
    lexer.column = 1
  } else if ((byte & 0xC0) != 0x80) {
    // A continuation byte belongs to the character before it.
    lexer.column++
  }
  return byte
}

function emit(mutable lexer: Lexer, kind: TokenKind, text: string, line: int, column: int) {
  // Only keywords and punctuation have a symbol.
  let symbol = 0
  if (kind == TokenKind.TokKeyword || kind == TokenKind.TokPunct) {
    if (SYMBOLS_BY_TEXT[text] is Some(found)) {
      symbol = found
    }
  }
  // The token's characters are consumed, so the current position is its end.
  const token = Token {
    kind: kind,
    text: text,
    line: line,
    column: column,
    endLine: lexer.line,
    endColumn: lexer.column,
    symbol: symbol,
  }
  Arrays.push(mutable lexer.tokens, token)
}

function lastEndsStatement(lexer: Lexer): bool {
  // A line break ends a statement only after a token that can end one.
  const count = Arrays.length(lexer.tokens)
  if (count == 0) {
    return false
  }
  const last = lexer.tokens[count - 1]
  return match (last.kind) {
    TokenKind.TokIdent
      | TokenKind.TokInt
      | TokenKind.TokFloat
      | TokenKind.TokString
      | TokenKind.TokChar
      | TokenKind.TokTemplate => true
    TokenKind.TokKeyword =>
      last.text == "return" ||
      last.text == "break" ||
      last.text == "continue" ||
      last.text == "true" ||
      last.text == "false"
    TokenKind.TokPunct =>
      last.text == ")" || last.text == "]" || last.text == "}" || endsIncrement(lexer)
    _ => false
  }
}

function endsIncrement(lexer: Lexer): bool {
  const count = Arrays.length(lexer.tokens)
  if (count < 3) {
    return false
  }
  const last = lexer.tokens[count - 1]
  const before = lexer.tokens[count - 2]
  const operand = lexer.tokens[count - 3]
  if (last.kind != TokenKind.TokPunct || (last.text != "+" && last.text != "-")) {
    return false
  }
  if (before.kind != TokenKind.TokPunct || before.text != last.text) {
    return false
  }
  if (before.line != last.line || before.column + 1 != last.column) {
    return false
  }
  // `x++` and `x--` end a statement; `a - -b` does not, since it is not adjacent.
  return operand.kind == TokenKind.TokIdent || operand.text == ")" || operand.text == "]"
}

function readText(lexer: Lexer, first: int, end: int): string {
  return substring(lexer.source, first, end)
}

function runLexer(mutable lexer: Lexer): Option<LexError> {
  while (lexer.index < getSize(lexer)) {
    const character = peek(lexer, 0)
    const line = lexer.line
    const column = lexer.column
    if (character == NEWLINE) {
      advance(mutable lexer)
      if (lexer.depth == 0 && lastEndsStatement(lexer)) {
        emit(mutable lexer, TokenKind.TokNewline, "\n", line, column)
      }
    } else if (character == SPACE || character == TAB || character == CARRIAGE_RETURN) {
      advance(mutable lexer)
    } else if (character == SLASH && peek(lexer, 1) == SLASH) {
      const commentStart = lexer.index
      while (lexer.index < getSize(lexer) && peek(lexer, 0) != NEWLINE) {
        advance(mutable lexer)
      }
      if (lexer.keepComments) {
        recordComment(mutable lexer, commentStart, line, column)
      }
    } else if (character == SLASH && peek(lexer, 1) == STAR) {
      const commentStart = lexer.index
      advance(mutable lexer)
      advance(mutable lexer)
      while (lexer.index < getSize(lexer) && !(peek(lexer, 0) == STAR && peek(lexer, 1) == SLASH)) {
        advance(mutable lexer)
      }
      if (lexer.index >= getSize(lexer)) {
        return errorAt(line, column, "E0001", "unterminated block comment")
      }
      advance(mutable lexer)
      advance(mutable lexer)
      if (lexer.keepComments) {
        recordComment(mutable lexer, commentStart, line, column)
      }
    } else if (isLetter(character)) {
      const start = lexer.index
      while (
        lexer.index < getSize(lexer) && (isLetter(peek(lexer, 0)) || isDigit(peek(lexer, 0)))
      ) {
        advance(mutable lexer)
      }
      const word = readText(lexer, start, lexer.index)
      if (KEYWORDS[word] is Some(_)) {
        emit(mutable lexer, TokenKind.TokKeyword, word, line, column)
      } else {
        emit(mutable lexer, TokenKind.TokIdent, word, line, column)
      }
    } else if (isDigit(character)) {
      lexNumber(mutable lexer, line, column)
    } else if (character == DOUBLE_QUOTE) {
      const literal = lexQuoted(mutable lexer, DOUBLE_QUOTE, line, column)
      if (literal is Err(error)) {
        return Some(error)
      }
      emit(mutable lexer, TokenKind.TokString, literal.value, line, column)
    } else if (character == SINGLE_QUOTE) {
      const quoteStart = lexer.index
      const literal = lexQuoted(mutable lexer, SINGLE_QUOTE, line, column)
      if (literal is Err(error)) {
        return Some(error)
      }
      if (Str.charCount(literal.value) != 1) {
        const closeQuote = Pos { line: lexer.line, column: lexer.column - 1 }
        return errorWithFixesAt(
          line,
          column,
          "E0002",
          buildQuoteFix(
            Pos { line: line, column: column },
            closeQuote,
            readText(lexer, quoteStart, lexer.index),
          ),
          "a character literal holds exactly one character; use double quotes for strings",
        )
      }
      emit(mutable lexer, TokenKind.TokChar, literal.value, line, column)
    } else if (character == BACKTICK) {
      const literal = lexTemplate(mutable lexer, line, column)
      if (literal is Err(error)) {
        return Some(error)
      }
      emit(mutable lexer, TokenKind.TokTemplate, literal.value, line, column)
    } else {
      const failed = lexPunctuation(mutable lexer, line, column)
      if (failed is Some(_)) {
        return failed
      }
    }
  }
  const line = lexer.line
  const column = lexer.column
  if (lastEndsStatement(lexer)) {
    emit(mutable lexer, TokenKind.TokNewline, "\n", line, column)
  }
  emit(mutable lexer, TokenKind.TokEof, "", line, column)
  return None
}

function lexPunctuation(mutable lexer: Lexer, line: int, column: int): Option<LexError> {
  const candidates = PUNCTS_BY_FIRST_BYTE[peek(lexer, 0)]
  if (candidates is Some(punctuationList)) {
    for (const punctuation of Arrays.values(punctuationList)) {
      if (hasPrefix(lexer, punctuation)) {
        // Punctuation is ASCII, so each byte is one column.
        const length = Str.length(punctuation)
        lexer.index += length
        lexer.column += length
        if (punctuation == ";" && lexer.depth == 0) {
          return errorWithFixesAt(
            line,
            column,
            "E0003",
            buildRemoveSemicolonFix(Pos { line: line, column: column }),
            "semicolons are not used; end the statement with a line break",
          )
        }
        if (punctuation == "(" || punctuation == "[" || punctuation == "#[") {
          lexer.depth++
        } else if (punctuation == "{") {
          const outerDepth = lexer.depth
          if (lexer.savedCount < Arrays.length(lexer.savedDepths)) {
            lexer.savedDepths[lexer.savedCount] = outerDepth
          } else {
            Arrays.push(mutable lexer.savedDepths, outerDepth)
          }
          lexer.savedCount++
          lexer.depth = 0
        } else if (punctuation == "}") {
          if (lexer.savedCount > 0) {
            lexer.savedCount--
            lexer.depth = lexer.savedDepths[lexer.savedCount]
          }
        } else if (punctuation == ")" || punctuation == "]") {
          if (lexer.depth > 0) {
            lexer.depth--
          }
        }
        emit(mutable lexer, TokenKind.TokPunct, punctuation, line, column)
        return None
      }
    }
  }
  const unexpected = Str.charAt(lexer.source, lexer.index)
  return errorAt(line, column, "E0004", `unexpected character ${quoteChar(unexpected)}`)
}

function hasPrefix(lexer: Lexer, prefix: string): bool {
  for (const index of Ranges.upTo(Str.length(prefix))) {
    if (peek(lexer, index) != Str.byteAt(prefix, index)) {
      return false
    }
  }
  return true
}

function lexNumber(mutable lexer: Lexer, line: int, column: int) {
  // A 0x, 0b or 0o prefix takes hex digits; otherwise read a decimal with an
  // optional fraction and exponent.
  const start = lexer.index
  let isFloat = false
  if (
    peek(lexer, 0) == ZERO &&
      (peek(lexer, 1) == LOWER_X || peek(lexer, 1) == LOWER_B || peek(lexer, 1) == LOWER_O)
  ) {
    advance(mutable lexer)
    advance(mutable lexer)
    while (isHexDigit(peek(lexer, 0)) || peek(lexer, 0) == UNDERSCORE) {
      advance(mutable lexer)
    }
  } else {
    while (isDigit(peek(lexer, 0)) || peek(lexer, 0) == UNDERSCORE) {
      advance(mutable lexer)
    }
    if (peek(lexer, 0) == DOT && isDigit(peek(lexer, 1))) {
      isFloat = true
      advance(mutable lexer)
      while (isDigit(peek(lexer, 0)) || peek(lexer, 0) == UNDERSCORE) {
        advance(mutable lexer)
      }
    }
    if (peek(lexer, 0) == LOWER_E || peek(lexer, 0) == UPPER_E) {
      isFloat = true
      advance(mutable lexer)
      if (peek(lexer, 0) == PLUS || peek(lexer, 0) == MINUS) {
        advance(mutable lexer)
      }
      while (isDigit(peek(lexer, 0))) {
        advance(mutable lexer)
      }
    }
  }

  // The text without the `_` separators.
  let text = readText(lexer, start, lexer.index)
  if (Str.contains(text, "_")) {
    text = Str.replace(text, "_", "")
  }
  if (isFloat) {
    emit(mutable lexer, TokenKind.TokFloat, text, line, column)
  } else {
    emit(mutable lexer, TokenKind.TokInt, text, line, column)
  }
}

function fail(line: int, column: int, code: string, message: string): Result<string, LexError> {
  return Err(LexError { code: code, line: line, column: column, message: message })
}

function failEscape(
  line: int,
  column: int,
  code: string,
  message: string,
): Result<Escape, LexError> {
  return Err(LexError { code: code, line: line, column: column, message: message })
}

function lexEscape(mutable lexer: Lexer, line: int, column: int): Result<string, LexError> {
  advance(mutable lexer) // the backslash
  if (lexer.index >= getSize(lexer)) {
    return fail(line, column, "E0005", "unterminated escape")
  }
  if (peek(lexer, 0) == LOWER_U) {
    advance(mutable lexer)
    return lexUnicodeEscape(mutable lexer, line, column)
  }
  // The escape letter may start a multi-byte character; read it whole for the message.
  const character = Str.charAt(lexer.source, lexer.index)
  advance(mutable lexer)
  if (decodeSimpleEscape(character) is Some(text)) {
    return Ok(text)
  }
  return fail(line, column, "E0008", `unknown escape \\${Str.fromChar(character)}`)
}

function decodeSimpleEscape(character: char): Option<string> {
  return match (character) {
    'n' => Some("\n")
    't' => Some("\t")
    'r' => Some("\r")
    '0' => Some("\0")
    '\\' => Some("\\")
    '"' => Some("\"")
    '\'' => Some("'")
    '`' => Some("`")
    '$' => Some("$")
    _ => None
  }
}

// A decoded escape from decodeEscape: its text and the index after it.
export struct Escape {
  text: string
  end: int
}

export function decodeEscape(
  source: Array<char>,
  index: int,
  line: int,
  column: int,
): Result<Escape, LexError> uses alloc {
  // Decodes like a string literal, so template strings take the same escapes and report the same errors, at line:column.
  const size = Arrays.length(source)
  if (index + 1 >= size) {
    return failEscape(line, column, "E0005", "unterminated escape")
  }
  const character = source[index + 1]
  if (character != 'u') {
    if (decodeSimpleEscape(character) is Some(text)) {
      return Ok(Escape { text: text, end: index + 2 })
    }
    return failEscape(line, column, "E0008", `unknown escape \\${Str.fromChar(character)}`)
  }
  // A \u{...} escape.
  let cursor = index + 2
  if (cursor >= size || source[cursor] != '{') {
    return failEscape(line, column, "E0006", "expected { after \\u")
  }
  cursor++
  let value = 0
  while (cursor >= size || source[cursor] != '}') {
    if (cursor >= size || !isHexDigit(Char.code(source[cursor]))) {
      return failEscape(line, column, "E0007", "invalid \\u escape")
    }
    value = (value * 16) + hexValue(Char.code(source[cursor]))
    cursor++
  }
  return Ok(Escape { text: Str.fromChar(convertRune(value)), end: cursor + 1 })
}

function lexUnicodeEscape(mutable lexer: Lexer, line: int, column: int): Result<string, LexError> {
  if (peek(lexer, 0) != OPEN_BRACE) {
    return fail(line, column, "E0006", "expected { after \\u")
  }
  advance(mutable lexer)
  let value = 0
  while (peek(lexer, 0) != CLOSE_BRACE) {
    if (lexer.index >= getSize(lexer) || !isHexDigit(peek(lexer, 0))) {
      return fail(line, column, "E0007", "invalid \\u escape")
    }
    value = (value * 16) + hexValue(advance(mutable lexer))
  }
  advance(mutable lexer)
  return Ok(Str.fromChar(convertRune(value)))
}

function convertRune(value: int): char {
  // The value is cut to 32 bits; a negative value, a surrogate or a value above 0x10FFFF becomes U+FFFD.
  const code = value & 0xFFFFFFFF
  if (code < 0x80000000) {
    if (Char.fromCode(code) is Some(character)) {
      return character
    }
  }
  return '\u{FFFD}'
}

function lexQuoted(
  mutable lexer: Lexer,
  quote: int,
  line: int,
  column: int,
): Result<string, LexError> {
  advance(mutable lexer)
  // Text between escapes is sliced from the source; the builder is only used once an escape appears.
  let builder = Str.builder()
  let runStart = lexer.index
  let hasEscape = false
  while (true) {
    if (lexer.index >= getSize(lexer) || peek(lexer, 0) == NEWLINE) {
      return fail(line, column, "E0009", "unterminated literal")
    }
    const character = peek(lexer, 0)
    if (character == quote) {
      const run = readText(lexer, runStart, lexer.index)
      advance(mutable lexer)
      if (!hasEscape) {
        return Ok(run)
      }
      Str.append(mutable builder, run)
      return Ok(Str.build(builder))
    }
    if (character == BACKSLASH) {
      Str.append(mutable builder, readText(lexer, runStart, lexer.index))
      hasEscape = true
      const escaped = lexEscape(mutable lexer, line, column)
      if (escaped is Err(error)) {
        return Err(error)
      }
      Str.append(mutable builder, escaped.value)
      runStart = lexer.index
    } else {
      advance(mutable lexer)
    }
  }
  return fail(line, column, "E0009", "unreachable")
}

function lexTemplate(mutable lexer: Lexer, line: int, column: int): Result<string, LexError> {
  advance(mutable lexer)
  const start = lexer.index
  const failure = skipTemplateBody(mutable lexer, line, column)
  if (failure is Some(error)) {
    return Err(error)
  }
  // Templates keep their raw source. The parser splits out each ${...} part and parses it on its own.
  return Ok(readText(lexer, start, lexer.index - 1))
}

function skipTemplateBody(mutable lexer: Lexer, line: int, column: int): Option<LexError> {
  while (true) {
    if (lexer.index >= getSize(lexer)) {
      return errorAt(line, column, "E0010", "unterminated template string")
    }
    const character = peek(lexer, 0)
    if (character == BACKSLASH) {
      advance(mutable lexer)
      if (lexer.index < getSize(lexer)) {
        advance(mutable lexer)
      }
    } else if (character == BACKTICK) {
      advance(mutable lexer)
      return None
    } else if (character == DOLLAR && peek(lexer, 1) == OPEN_BRACE) {
      advance(mutable lexer)
      advance(mutable lexer)
      const failure = skipInterpolation(mutable lexer, line, column)
      if (failure is Some(_)) {
        return failure
      }
    } else {
      advance(mutable lexer)
    }
  }
  return errorAt(line, column, "E0010", "unreachable")
}

function skipInterpolation(mutable lexer: Lexer, line: int, column: int): Option<LexError> {
  let depth = 1
  while (depth > 0) {
    if (lexer.index >= getSize(lexer)) {
      return errorAt(line, column, "E0010", "unterminated template string")
    }
    const character = peek(lexer, 0)
    const innerLine = lexer.line
    const innerColumn = lexer.column
    advance(mutable lexer)
    if (character == OPEN_BRACE) {
      depth++
    } else if (character == CLOSE_BRACE) {
      depth--
    } else if (character == DOUBLE_QUOTE || character == SINGLE_QUOTE) {
      const failure = skipQuoted(mutable lexer, character, innerLine, innerColumn)
      if (failure is Some(_)) {
        return failure
      }
    } else if (character == BACKTICK) {
      const failure = skipTemplateBody(mutable lexer, innerLine, innerColumn)
      if (failure is Some(_)) {
        return failure
      }
    }
  }
  return None
}

function skipQuoted(mutable lexer: Lexer, quote: int, line: int, column: int): Option<LexError> {
  while (true) {
    if (lexer.index >= getSize(lexer) || peek(lexer, 0) == NEWLINE) {
      return errorAt(line, column, "E0009", "unterminated literal")
    }
    const character = advance(mutable lexer)
    if (character == quote) {
      return None
    }
    if (character == BACKSLASH && lexer.index < getSize(lexer) && peek(lexer, 0) != NEWLINE) {
      advance(mutable lexer)
    }
  }
  return errorAt(line, column, "E0009", "unreachable")
}

export function hex(value: int, width: int): string uses alloc {
  // value must not be negative.
  const digits = Int.toHex(value)
  const padding = width - Str.length(digits)
  if (padding > 0) {
    return `${repeatString("0", padding)}${digits}`
  }
  return digits
}

function quoteChar(character: char): string {
  // Non-ASCII characters are written as they are (Go escapes the ones that are not printable; that needs Unicode tables).
  return match (character) {
    '\'' => "'\\''"
    '\\' => "'\\\\'"
    '\u{7}' => "'\\a'"
    '\u{8}' => "'\\b'"
    '\u{c}' => "'\\f'"
    '\n' => "'\\n'"
    '\r' => "'\\r'"
    '\t' => "'\\t'"
    '\u{b}' => "'\\v'"
    _ => quoteOther(character)
  }
}

function quoteOther(character: char): string {
  if (character < ' ' || character == '\u{7f}') {
    return `'\\x${hex(Char.code(character), 2)}'`
  }
  return `'${Str.fromChar(character)}'`
}

function isLetter(byte: int): bool {
  return byte == UNDERSCORE ||
    (byte >= LOWER_A && byte <= LOWER_Z) ||
    (byte >= UPPER_A && byte <= UPPER_Z)
}

function isDigit(byte: int): bool {
  return byte >= ZERO && byte <= NINE
}

function isHexDigit(byte: int): bool {
  return isDigit(byte) ||
    (byte >= LOWER_A && byte <= LOWER_F) ||
    (byte >= UPPER_A && byte <= UPPER_F)
}

function hexValue(byte: int): int {
  if (isDigit(byte)) {
    return byte - ZERO
  }
  if (byte >= LOWER_A && byte <= LOWER_F) {
    return byte - LOWER_A + 10
  }
  return byte - UPPER_A + 10
}

export function getKindName(kind: TokenKind): string {
  return match (kind) {
    TokenKind.TokEof => "eof"
    TokenKind.TokNewline => "newline"
    TokenKind.TokIdent => "ident"
    TokenKind.TokInt => "int"
    TokenKind.TokFloat => "float"
    TokenKind.TokString => "string"
    TokenKind.TokChar => "char"
    TokenKind.TokTemplate => "template"
    TokenKind.TokKeyword => "keyword"
    TokenKind.TokPunct => "punct"
  }
}

export function escapeText(text: string): string uses alloc {
  let builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (character == '\n') {
      Str.append(mutable builder, "\\n")
    } else if (character == '\t') {
      Str.append(mutable builder, "\\t")
    } else if (character == '\r') {
      Str.append(mutable builder, "\\r")
    } else if (character < ' ' || character == '\u{7f}') {
      Str.append(mutable builder, `\\u{${Int.toHex(Char.code(character))}}`)
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  return Str.build(builder)
}
