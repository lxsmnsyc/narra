// error: divisor_reassigned.nra:6:20: the divisor must be a non-zero constant or a name checked against zero first; check the name first, as in `if (d != 0) { ... }`
function share(total: int, count: int): int {
  let divisor = count
  if (divisor != 0) {
    divisor = divisor - 1
    return total / divisor
  }
  return 0
}

export function run(args: Array<string>): int {
  return share(10, 2)
}
