import * as Str from "std/string"

export enum Align {
  Left
  Right
}

export function pad(
  value: string,
  width: int = 4,
  fill: string = ".",
  align: Align = Align.Right,
): string uses alloc {
  let padding = ""
  let count = width - Str.length(value)
  while (count > 0) {
    padding = `${padding}${fill}`
    count--
  }
  return match (align) { Align.Left => `${value}${padding}`, Align.Right => `${padding}${value}` }
}
