// A readable difference between expected and actual text.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"
import * as Str from "std/string"

// The most lines shown on each side, and the longest line shown.
const MAX_LINES = 8
const MAX_CHARACTERS = 200

export function describeDifference(want: string, got: string): string uses alloc {
  const wantLines = Str.split(want, "\n")
  const gotLines = Str.split(got, "\n")
  // Find the first line that differs, or where one text ends.
  let first = 0
  while (
    first < Arrays.length(wantLines) &&
      first < Arrays.length(gotLines) &&
      wantLines[first] == gotLines[first]
  ) {
    first = first + 1
  }
  let builder = Str.builder()
  Str.append(mutable builder, `first difference at line ${Int.toString(first + 1)}\n`)
  // Context: the lines just before the difference.
  let start = 0
  if (first > 2) {
    start = first - 2
  }
  for (const index of Ranges.between(start, first)) {
    Str.append(mutable builder, `  ${clipLine(wantLines[index])}\n`)
  }
  appendSide(mutable builder, "- ", wantLines, first)
  appendSide(mutable builder, "+ ", gotLines, first)
  return Str.build(builder)
}

function appendSide(
  mutable builder: StringBuilder,
  marker: string,
  lines: Array<string>,
  first: int,
) uses alloc {
  if (first >= Arrays.length(lines)) {
    Str.append(mutable builder, `${marker}(end of text)\n`)
    return
  }
  const end = first + MAX_LINES
  let shown = Arrays.length(lines)
  if (shown > end) {
    shown = end
  }
  for (const index of Ranges.between(first, shown)) {
    Str.append(mutable builder, `${marker}${clipLine(lines[index])}\n`)
  }
  if (Arrays.length(lines) > end) {
    Str.append(
      mutable builder,
      `${marker}... ${Int.toString(Arrays.length(lines) - end)} more lines\n`,
    )
  }
}

function clipLine(line: string): string uses alloc {
  // An empty line shows as a word, so it can be told from a missing one.
  if (line == "") {
    return "(empty line)"
  }
  if (Str.charCount(line) <= MAX_CHARACTERS) {
    return line
  }
  let builder = Str.builder()
  let count = 0
  for (const character of Str.chars(line)) {
    if (count < MAX_CHARACTERS) {
      Str.appendChar(mutable builder, character)
    }
    count = count + 1
  }
  return `${Str.build(builder)}...`
}
