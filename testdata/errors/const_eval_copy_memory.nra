// error: E1055, copy(...) of a large array counts toward the memory budget
import * as Arrays from "std/array"
import * as Int from "std/int"

@const
function table(count: int): int uses alloc {
  let rows: Array<Array<int>> = []
  if (Arrays.filled(0, 1000000) is Some(row)) {
    for (let index = 0; index < count; index++) {
      let fresh = copy(row)
      fresh[0] = index
      Arrays.push(mutable rows, fresh)
    }
  }
  return Arrays.length(rows)
}

const ROWS = table(400)

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(ROWS))
  return 0
}
