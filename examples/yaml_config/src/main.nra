import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Yaml from "yaml"
import { Shape } from "std/shape"

struct Server derives Shape {
  host: string
  port: int
}

struct Limits derives Shape {
  timeout: int
  retries: int
  players: int
}

struct Config derives Shape {
  name: string
  debug: bool
  tags: Array<string>
  server: Server
  limits: Limits
  motd: string
}

export function run(args: Array<string>): int uses io, alloc {
  let path = "examples/yaml_config/config.yaml"
  if (Arrays.length(args) > 1) {
    path = args[1]
  }
  const text = Fs.readText(path)
  if (text is Err(message)) {
    print(`cannot read ${path}: ${message}`)
    return 1
  }
  const config = Yaml.decode<Config>(text.value)
  if (config is Err(message)) {
    print(`${path}: ${message}`)
    return 1
  }
  print(
    `${config.value.name} listens on ${config.value.server.host}:${Int.toString(config.value.server.port)}`,
  )
  print(Yaml.encode(config.value))
  return 0
}
