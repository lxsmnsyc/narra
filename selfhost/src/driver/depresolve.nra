// Minimal version selection. The walk starts at the root manifests and reads the narra.toml of
// each dependency at each version some manifest names. Every package ends at the highest version
// that any manifest in the graph requires as its minimum, so no solver is needed. [overrides] of
// the root of the build replace the URL and the version of every requirement on their names.
// A version is compatible only with versions on its line, so a requirement on another line than
// the selected version is an error.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Ranges from "std/range"
import {
  Dependency,
  LoadError,
  Manifest,
  findUpstream,
  isVersion,
  parseManifest,
} from "narrac/driver/manifest"
import { Member, Workspace, listMembers } from "narrac/driver/workspace"
import { LockEntry, formatLock, parseLock } from "narrac/driver/lockfile"
import {
  Fetched,
  checkoutPath,
  fetchVersion,
  isVersionBefore,
  listVersions,
} from "narrac/driver/depcache"
import * as Sets from "std/set"
import { Set } from "std/set"
import { splitString } from "narrac/driver/textops"

struct Requirement {
  name: string
  git: string
  version: string
  isSibling: bool // from `workspace = true` in a fetched checkout
  requiredBy: string // the package whose manifest asks
  requiredByVersion: string // its version; empty for a root manifest
  isFromRoot: bool
}

function createResolveError(code: string, message: string): LoadError {
  return LoadError { code, file: "", line: 0, column: 1, message }
}

struct FoundTag {
  fetched: Fetched
  tag: string
}

function findCachedTag(
  git: string,
  name: string,
  version: string,
  locked: Array<LockEntry>,
): string uses io, alloc {
  // The lock names the tag it was made from, so the version is never read from another tag.
  // The package name is checked after the fetch, when the manifest is read.
  for (const entry of Arrays.values(locked)) {
    if (
      entry.name == name &&
        entry.git == git &&
        entry.version == version &&
        Fs.isDir(checkoutPath(git, entry.tag))
    ) {
      return entry.tag
    }
  }
  const memberTag = `${name}/v${version}`
  if (Fs.isDir(checkoutPath(git, memberTag))) {
    return memberTag
  }
  // A cached plain tag is taken only when the lock shows that this repository tags the package
  // plainly. Without that entry, only the tag list tells whether a member tag exists, and a clean
  // machine picks the member tag when the repository has one.
  const plainTag = `v${version}`
  for (const entry of Arrays.values(locked)) {
    if (
      entry.name == name &&
        entry.git == git &&
        entry.tag == `v${entry.version}` &&
        Fs.isDir(checkoutPath(git, plainTag))
    ) {
      return plainTag
    }
  }
  return ""
}

function fetchTag(git: string, tag: string): Result<FoundTag, LoadError> uses io, alloc {
  const fetched = fetchVersion(git, tag)
  if (fetched is Err(error)) {
    return Err(error)
  }
  return Ok(FoundTag { fetched: copy(fetched.value), tag })
}

function findTag(
  git: string,
  name: string,
  version: string,
  isOverride: bool,
  locked: Array<LockEntry>,
): Result<FoundTag, LoadError> uses io, alloc {
  const memberTag = `${name}/v${version}`
  const plainTag = `v${version}`
  // A version already in the cache needs no git command.
  const cachedTag = findCachedTag(git, name, version, locked)
  if (cachedTag != "") {
    return fetchTag(git, cachedTag)
  }
  const listed = listVersions(git, name)
  if (listed is Err(error)) {
    return Err(error)
  }
  let found = false
  for (const candidate of Arrays.values(listed.value)) {
    if (candidate == version) {
      found = true
    }
  }
  if (!found && isOverride) {
    return Err(
      createResolveError(
        "E0456",
        `the override for ${name} names version ${version}, which has no tag in ${git}`,
      ),
    )
  }
  if (!found) {
    return Err(
      createResolveError(
        "E0451",
        `the repository ${git} has no tag for version ${version} of ${name}`,
      ),
    )
  }
  // The version is listed, so one of the two tags exists. Member tags win, as in listVersions.
  const member = fetchTag(git, memberTag)
  if (member is Err(error)) {
    if (error.code == "E0442") {
      return fetchTag(git, plainTag)
    }
    return Err(error)
  }
  return member
}

export struct CheckoutPackage {
  directory: string // the folder of the package: the checkout, or a member inside it
  manifest: Manifest
  members: Array<Member> // the members of the checkout's workspace; empty without [workspace]
}

function readCheckoutManifest(
  directory: string,
  name: string,
  version: string,
): Result<Manifest, LoadError> uses io, alloc {
  const text = Fs.readText(`${directory}/narra.toml`)
  if (text is Err(_)) {
    return Err(createResolveError("E0457", `${name} ${version} has no narra.toml`))
  }
  const parsed = parseManifest(text.value)
  if (parsed is Err(error)) {
    return Err(LoadError {
      code: error.code,
      file: `${name} ${version}/narra.toml`,
      line: error.line,
      column: error.column,
      message: error.message,
    })
  }
  return parsed
}

export function findCheckoutPackage(
  checkout: string,
  name: string,
  version: string,
): Result<CheckoutPackage, LoadError> uses io, alloc {
  // The root package wins; otherwise the member of the root's [workspace] with that name.
  const root = readCheckoutManifest(checkout, name, version)
  if (root is Err(error)) {
    return Err(error)
  }
  if (!root.value.isWorkspace) {
    if (root.value.name != name) {
      return Err(
        createResolveError(
          "E0453",
          `the manifest of ${name} ${version} names the package "${root.value.name}"`,
        ),
      )
    }
    return Ok(CheckoutPackage { directory: checkout, manifest: copy(root.value), members: [] })
  }

  // The root is a workspace: list its members, the root package included when it has one.
  const listed = listMembers(Workspace { root: checkout, manifest: copy(root.value) })
  if (listed is Err(errors)) {
    return Err(copy(errors[0]))
  }
  if (root.value.name == name) {
    return Ok(CheckoutPackage {
      directory: checkout,
      manifest: copy(root.value),
      members: copy(listed.value),
    })
  }
  for (const member of Arrays.values(listed.value)) {
    if (member.name == name) {
      const manifest = readCheckoutManifest(member.directory, name, version)
      if (manifest is Err(error)) {
        return Err(error)
      }
      return Ok(CheckoutPackage {
        directory: member.directory,
        manifest: copy(manifest.value),
        members: copy(listed.value),
      })
    }
  }
  return Err(
    createResolveError("E0486", `the checkout of ${name} ${version} has no package named ${name}`),
  )
}

function readPackage(
  fetched: Fetched,
  name: string,
  version: string,
): Result<CheckoutPackage, LoadError> uses io, alloc {
  const found = findCheckoutPackage(fetched.path, name, version)
  if (found is Err(error)) {
    return Err(error)
  }
  if (Arrays.length(found.value.manifest.overrides) > 0) {
    return Err(
      createResolveError(
        "E0454",
        `[overrides] is allowed in the root manifest of a build only, not in ${name} ${version}`,
      ),
    )
  }
  return found
}

function pushRequirements(mutable queue: Array<Requirement>, manifest: Manifest) uses alloc {
  for (const dependency of Arrays.values(manifest.dependencies)) {
    // Only `pkg --resolve` reads raw manifests: a member dependency of a workspace is not fetched.
    if (dependency.workspace) {
      continue
    }
    Arrays.push(mutable queue, Requirement {
      name: dependency.name,
      git: dependency.git,
      version: dependency.version,
      isSibling: false,
      requiredBy: manifest.name,
      requiredByVersion: "",
      isFromRoot: true,
    })
  }
}

function pushFetchedRequirements(
  mutable queue: Array<Requirement>,
  found: CheckoutPackage,
  git: string,
  name: string,
  version: string,
): Result<bool, LoadError> uses io, alloc {
  for (const dependency of Arrays.values(found.manifest.dependencies)) {
    if (!dependency.workspace) {
      Arrays.push(mutable queue, Requirement {
        name: dependency.name,
        git: dependency.git,
        version: dependency.version,
        isSibling: false,
        requiredBy: name,
        requiredByVersion: version,
        isFromRoot: false,
      })
      continue
    }

    // A sibling becomes a requirement on the same URL, at the version its manifest has here.
    let siblingDirectory = ""
    for (const member of Arrays.values(found.members)) {
      if (member.name == dependency.name) {
        siblingDirectory = member.directory
        break
      }
    }
    if (siblingDirectory == "") {
      return Err(
        createResolveError(
          "E0486",
          `the checkout of ${name} ${version} has no package named ${dependency.name}`,
        ),
      )
    }
    const sibling = readCheckoutManifest(siblingDirectory, dependency.name, version)
    if (sibling is Err(error)) {
      return Err(error)
    }
    if (sibling.value.version == "") {
      return Err(
        createResolveError(
          "E0487",
          `${name} needs its sibling ${dependency.name}, which has no version`,
        ),
      )
    }
    Arrays.push(mutable queue, Requirement {
      name: dependency.name,
      git,
      version: sibling.value.version,
      isSibling: true,
      requiredBy: name,
      requiredByVersion: version,
      isFromRoot: false,
    })
  }
  return Ok(true)
}

function findCompatibilityLine(version: string): string uses alloc {
  // The line is the major version from 1.0.0 up, 0.MINOR below it, and 0.0.PATCH for 0.0.x.
  if (!isVersion(version)) {
    return version
  }
  const parts = splitString(version, ".")
  if (parts[0] != "0") {
    return parts[0]
  }
  if (parts[1] != "0") {
    return `0.${parts[1]}`
  }
  return version
}

function describeRequester(requirement: Requirement): string uses alloc {
  if (requirement.isFromRoot && requirement.requiredBy == "") {
    return "the root manifest"
  }
  if (requirement.isFromRoot) {
    return requirement.requiredBy
  }
  return `${requirement.requiredBy} ${requirement.requiredByVersion}`
}

function isRequesterSelected(requirement: Requirement, selected: Map<string, LockEntry>): bool {
  if (requirement.isFromRoot) {
    return true
  }
  if (selected[requirement.requiredBy] is Some(entry)) {
    return entry.version == requirement.requiredByVersion
  }
  return false
}

function checkCompatibilityLines(
  requirements: Array<Requirement>,
  selected: Map<string, LockEntry>,
  overrideByName: Map<string, Dependency>,
): Result<bool, LoadError> uses alloc {
  // Only the roots and the selected versions count: a version that lost the selection does not
  // end up in the build, so its requirements do not either. An override forces one version.
  for (const requirement of Arrays.values(requirements)) {
    if (overrideByName[requirement.name] is Some(_)) {
      continue
    }
    if (!isRequesterSelected(requirement, selected)) {
      continue
    }
    const entry = selected[requirement.name]
    if (entry is None) {
      continue
    }
    const selectedLine = findCompatibilityLine(entry.value.version)
    const requiredLine = findCompatibilityLine(requirement.version)
    if (selectedLine == requiredLine) {
      continue
    }
    // Name a package that asks for the selected version, one in the build when there is one.
    let selectedBy = ""
    for (const other of Arrays.values(requirements)) {
      if (other.name != requirement.name || other.version != entry.value.version) {
        continue
      }
      if (isRequesterSelected(other, selected)) {
        selectedBy = describeRequester(other)
        break
      }
      if (selectedBy == "") {
        selectedBy = describeRequester(other)
      }
    }
    return Err(
      createResolveError(
        "E0459",
        `${requirement.name} ${entry.value.version} is selected because ${selectedBy} requires it, but ${describeRequester(requirement)} requires ${requirement.version}, which is on line ${requiredLine}, not ${selectedLine}`,
      ),
    )
  }
  return Ok(true)
}

export function resolveDependencies(
  roots: Array<Manifest>,
  overrides: Array<Dependency>,
  locked: Array<LockEntry>,
): Result<Array<LockEntry>, LoadError> uses io, alloc {
  let overrideByName: Map<string, Dependency> = Map {}
  for (const override of Arrays.values(overrides)) {
    overrideByName[override.name] = override
  }
  let overrideUsed: Set<string> = Sets.create()
  let queue: Array<Requirement> = []
  for (const root of Arrays.values(roots)) {
    pushRequirements(mutable queue, root)
  }
  let firstGit: Map<string, string> = Map {}
  let selected: Map<string, LockEntry> = Map {}
  let names: Array<string> = []
  let visited: Set<string> = Sets.create()
  let position = 0
  while (position < Arrays.length(queue)) {
    const requirement = copy(queue[position])
    position++
    let git = requirement.git
    let version = requirement.version
    let isOverride = false
    if (overrideByName[requirement.name] is Some(override)) {
      git = override.git
      version = override.version
      isOverride = true
      Sets.add(mutable overrideUsed, requirement.name)
    }
    if (firstGit[requirement.name] is Some(knownGit)) {
      if (knownGit != git) {
        return Err(
          createResolveError(
            "E0450",
            `package ${requirement.name} is required from two repositories, ${knownGit} and ${git}, and [overrides] has no entry for it`,
          ),
        )
      }
    } else {
      firstGit[requirement.name] = git
      Arrays.push(mutable names, requirement.name)
    }
    const key = `${requirement.name} ${version}`
    if (!Sets.add(mutable visited, key)) {
      continue
    }
    const found = findTag(git, requirement.name, version, isOverride, locked)
    if (found is Err(error)) {
      if (requirement.isSibling && error.code == "E0451") {
        return Err(
          createResolveError(
            "E0487",
            `${requirement.requiredBy} needs ${requirement.name} ${version}, but the repository ${git} has no tag for it`,
          ),
        )
      }
      return Err(error)
    }
    const read = readPackage(found.value.fetched, requirement.name, version)
    if (read is Err(error)) {
      return Err(error)
    }
    const pushed = pushFetchedRequirements(
      mutable queue,
      read.value,
      git,
      requirement.name,
      version,
    )
    if (pushed is Err(error)) {
      return Err(error)
    }
    // A C package also fetches its upstream checkout, which the lock records beside the package.
    let entry = LockEntry {
      name: requirement.name,
      git,
      version,
      tag: found.value.tag,
      commit: found.value.fetched.commit,
      content: found.value.fetched.tree,
    }
    const upstream = findUpstream(read.value.manifest.cTables)
    if (upstream.git != "") {
      const upstreamFetched = fetchVersion(upstream.git, upstream.tag)
      if (upstreamFetched is Err(error)) {
        return Err(
          createResolveError(
            error.code,
            `the C source of ${requirement.name} ${version}: ${error.message}`,
          ),
        )
      }
      entry.cGit = upstream.git
      entry.cTag = upstream.tag
      entry.cCommit = upstreamFetched.value.commit
      entry.cContent = upstreamFetched.value.tree
    }
    if (selected[requirement.name] is Some(current)) {
      if (isVersionBefore(current.version, version)) {
        selected[requirement.name] = entry
      }
    } else {
      selected[requirement.name] = entry
    }
  }
  const checked = checkCompatibilityLines(queue, selected, overrideByName)
  if (checked is Err(error)) {
    return Err(error)
  }
  for (const override of Arrays.values(overrides)) {
    if (!Sets.has(overrideUsed, override.name)) {
      return Err(
        createResolveError(
          "E0455",
          `[overrides] has an entry for ${override.name}, but no package requires it`,
        ),
      )
    }
  }
  let entries: Array<LockEntry> = []
  for (const name of Arrays.values(names)) {
    if (selected[name] is Some(entry)) {
      Arrays.push(mutable entries, entry)
    }
  }
  return Ok(entries)
}

export function checkAgainstLock(
  resolved: Array<LockEntry>,
  locked: Array<LockEntry>,
): Result<bool, LoadError> uses io, alloc {
  for (const entry of Arrays.values(resolved)) {
    for (const old of Arrays.values(locked)) {
      if (old.name == entry.name && old.git != entry.git) {
        const _ = Fs.writeText(
          "/dev/stderr",
          `notice: ${entry.name} was locked from ${old.git} and now resolves from ${entry.git}; narra.lock is rewritten\n`,
        )
      }
      if (old.name != entry.name || old.git != entry.git || old.version != entry.version) {
        continue
      }
      if (old.commit != entry.commit || old.content != entry.content) {
        return Err(
          createResolveError(
            "E0452",
            `narra.lock records commit ${old.commit} and tree ${old.content} for ${entry.name} ${entry.version}, but the repository has commit ${entry.commit} and tree ${entry.content}`,
          ),
        )
      }
      // The upstream is the same checkout when the manifest still names the same repository and tag.
      if (
        old.cGit != "" &&
          old.cGit == entry.cGit &&
          old.cTag == entry.cTag &&
          (old.cCommit != entry.cCommit || old.cContent != entry.cContent)
      ) {
        return Err(
          createResolveError(
            "E0452",
            `narra.lock records commit ${old.cCommit} and tree ${old.cContent} for the C source of ${entry.name} ${entry.version} (tag ${entry.cTag} of ${entry.cGit}), but the repository has commit ${entry.cCommit} and tree ${entry.cContent}`,
          ),
        )
      }
    }
  }
  return Ok(true)
}

function printFailure(error: LoadError): int uses io, alloc {
  const _ = Fs.writeText("/dev/stderr", `error ${error.code}: ${error.message}\n`)
  return 1
}

function readRootManifest(directory: string): Result<Manifest, LoadError> uses io, alloc {
  const text = Fs.readText(`${directory}/narra.toml`)
  if (text is Err(message)) {
    return Err(
      createResolveError("E0458", `cannot read or write ${directory}/narra.toml: ${message}`),
    )
  }
  const parsed = parseManifest(text.value)
  if (parsed is Err(error)) {
    return Err(LoadError {
      code: error.code,
      file: `${directory}/narra.toml`,
      line: error.line,
      column: error.column,
      message: error.message,
    })
  }
  return parsed
}

export function runResolveCommand(arguments: Array<string>): int uses io, alloc {
  let roots: Array<Manifest> = []
  for (const index of Ranges.between(3, Arrays.length(arguments))) {
    const manifest = readRootManifest(arguments[index])
    if (manifest is Err(error)) {
      return printFailure(error)
    }
    Arrays.push(mutable roots, manifest.value)
  }
  // The first directory is the root of the build; the others may not have [overrides].
  for (const index of Ranges.between(1, Arrays.length(roots))) {
    if (Arrays.length(roots[index].overrides) > 0) {
      return printFailure(
        createResolveError(
          "E0454",
          `[overrides] is allowed in the root manifest of a build only, not in ${arguments[index + 3]}`,
        ),
      )
    }
  }
  const lockPath = `${arguments[3]}/narra.lock`
  let locked: Array<LockEntry> = []
  let oldText = ""
  if (Fs.exists(lockPath)) {
    const lockText = Fs.readText(lockPath)
    if (lockText is Err(message)) {
      return printFailure(
        createResolveError("E0458", `cannot read or write ${lockPath}: ${message}`),
      )
    }
    const parsed = parseLock(lockText.value)
    if (parsed is Err(error)) {
      return printFailure(error)
    }
    locked = parsed.value
    oldText = lockText.value
  }
  const resolved = resolveDependencies(roots, roots[0].overrides, locked)
  if (resolved is Err(error)) {
    return printFailure(error)
  }
  const checked = checkAgainstLock(resolved.value, locked)
  if (checked is Err(error)) {
    return printFailure(error)
  }
  const text = formatLock(resolved.value)
  if (text != oldText) {
    const written = Fs.writeText(lockPath, text)
    if (written is Err(message)) {
      return printFailure(
        createResolveError("E0458", `cannot read or write ${lockPath}: ${message}`),
      )
    }
  }
  const printed = Fs.writeText("/dev/stdout", text)
  if (printed is Err(_)) {
    return 1
  }
  return 0
}
