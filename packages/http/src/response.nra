// http/response: the response type that the server sends and the client reads.

import * as Bodies from "http/body"
import * as Fields from "http/headers"
import { Body } from "http/body"
import { Headers } from "http/headers"
import { Connection } from "std/net"

/// What a server does with the connection once the 101 head of a response is written: run gets
/// the connection and the bytes that the client sent after its request. The connection closes
/// when run finishes and every copy of it is gone.
export struct Upgrade {
  run: (connection: Connection, leftover: bytes) => Async<void> uses (io, alloc)
}

/// The connection of a client request that was answered with 101, and the bytes the server sent
/// after the head of its response.
export struct Upgraded {
  connection: Connection
  leftover: bytes
}

/// A response. upgrade is for a server: a handler sets it on a 101 response. upgraded is for a
/// client: send fills it when the status is 101, and the body is empty then.
export struct Response {
  status: int
  headers: Headers
  body: Body
  upgrade: Option<Upgrade>
  upgraded: Option<Upgraded>
}

/// A response with the status, no headers and no body.
export function create(status: int): Response uses alloc {
  return Response {
    status,
    headers: Fields.empty(),
    body: Bodies.empty(),
    upgrade: None,
    upgraded: None,
  }
}

/// A response of plain text, with a Content-Type of text/plain in UTF-8.
export function text(status: int, content: string): Response uses alloc {
  let headers = Fields.empty()
  Fields.add(mutable headers, "Content-Type", "text/plain; charset=utf-8")
  return Response {
    status,
    headers,
    body: Bodies.fromText(content),
    upgrade: None,
    upgraded: None,
  }
}

/// The standard reason phrase of a status, or an empty text for a status with none.
export function reasonPhrase(status: int): string {
  if (status == 100) {
    return "Continue"
  }
  if (status == 101) {
    return "Switching Protocols"
  }
  if (status == 200) {
    return "OK"
  }
  if (status == 201) {
    return "Created"
  }
  if (status == 202) {
    return "Accepted"
  }
  if (status == 204) {
    return "No Content"
  }
  if (status == 206) {
    return "Partial Content"
  }
  if (status == 301) {
    return "Moved Permanently"
  }
  if (status == 302) {
    return "Found"
  }
  if (status == 303) {
    return "See Other"
  }
  if (status == 304) {
    return "Not Modified"
  }
  if (status == 307) {
    return "Temporary Redirect"
  }
  if (status == 308) {
    return "Permanent Redirect"
  }
  if (status == 400) {
    return "Bad Request"
  }
  if (status == 401) {
    return "Unauthorized"
  }
  if (status == 403) {
    return "Forbidden"
  }
  if (status == 404) {
    return "Not Found"
  }
  if (status == 405) {
    return "Method Not Allowed"
  }
  if (status == 408) {
    return "Request Timeout"
  }
  if (status == 409) {
    return "Conflict"
  }
  if (status == 411) {
    return "Length Required"
  }
  if (status == 413) {
    return "Content Too Large"
  }
  if (status == 414) {
    return "URI Too Long"
  }
  if (status == 415) {
    return "Unsupported Media Type"
  }
  if (status == 422) {
    return "Unprocessable Content"
  }
  if (status == 429) {
    return "Too Many Requests"
  }
  if (status == 431) {
    return "Request Header Fields Too Large"
  }
  if (status == 500) {
    return "Internal Server Error"
  }
  if (status == 501) {
    return "Not Implemented"
  }
  if (status == 502) {
    return "Bad Gateway"
  }
  if (status == 503) {
    return "Service Unavailable"
  }
  if (status == 504) {
    return "Gateway Timeout"
  }
  if (status == 505) {
    return "HTTP Version Not Supported"
  }
  return ""
}
