// What the pattern checks share, ported from compiler/internal/narra:
// check_match.go (isIrrefutable, argsIrrefutable, isWild, ctorCount,
// ctorArgTypes, specialize, missingCases, ctorText) and the narrowing
// helpers of check.go and check_stmt.go (narrowed, setNarrow, narrowable,
// otherVariant).
//
// This module sits below narrac/exprs, which reads the narrowing when it
// checks a field, so it imports narrac/check only. Resolving a pattern
// needs expectType from exprs and lives in narrac/match.
//
// A resolved pattern keeps no field of its own. The variant a
// PatName or PatCtor names is the Ref.Constructor of its node id in the current
// body, and the locals it binds are the locals that its PatName nodes
// declare (collectPatternLocals).
//
// Narrowing is not a field of the local. It is a key in the block scope
// stack of the body, `narrow|<local index>`, whose value is the variant
// index: it is saved and restored with pushScope and popScope like a name.
import { filledArray } from "narrac/textops"
import * as Int from "std/int"
import * as Str from "std/string"
import { Pos, Expr, Pattern, FieldPattern } from "narrac/ast"
import { Type } from "narrac/types"
import { Checker, Ref, getRef, getLocal, findBodySlot, bindName } from "narrac/check"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export function getPatternId(pattern: Pattern): int {
  return match (pattern) {
    Pattern.PatWildcard(nodeId, _)
      | Pattern.PatName(nodeId, _, _)
      | Pattern.PatCtor(nodeId, _, _, _, _, _)
      | Pattern.PatStruct(nodeId, _, _)
      | Pattern.PatTuple(nodeId, _, _)
      | Pattern.PatLit(nodeId, _, _)
      | Pattern.PatOr(nodeId, _, _) => nodeId
  }
}

export function getPatternPos(pattern: Pattern): Pos {
  return match (pattern) {
    Pattern.PatWildcard(_, pos)
      | Pattern.PatName(_, pos, _)
      | Pattern.PatCtor(_, pos, _, _, _, _)
      | Pattern.PatStruct(_, pos, _)
      | Pattern.PatTuple(_, pos, _)
      | Pattern.PatLit(_, pos, _)
      | Pattern.PatOr(_, pos, _) => copy(pos)
  }
}

export function collectPatternLocals(
  checker: Checker,
  pattern: Pattern,
  mutable locals: Array<int>,
) uses alloc {
  match (pattern) {
    Pattern.PatName(nodeId, _, _) => {
      const body = checker.bodies[checker.body]
      const slot = findBodySlot(body, nodeId)
      if (slot >= 0 && body.declared[slot] >= 0) {
        Arrays.push(mutable locals, body.declared[slot])
      }
    }
    Pattern.PatCtor(_, _, _, _, arguments, _) => {
      for (const argument of Arrays.values(arguments)) {
        collectPatternLocals(checker, argument, mutable locals)
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        collectPatternLocals(checker, field.pattern, mutable locals)
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const argument of Arrays.values(arguments)) {
        collectPatternLocals(checker, argument, mutable locals)
      }
    }
    // Every alternative binds the same locals; the first one stands for all.
    Pattern.PatOr(_, _, alternatives) => collectPatternLocals(
      checker,
      alternatives[0],
      mutable locals,
    )
    _ => {}
  }
}

export function bindPatternLocals(mutable checker: Checker, locals: Array<int>) uses alloc {
  const depth = checker.scopeDepth - 1
  for (const index of Arrays.values(locals)) {
    const name = getLocal(checker, index).name
    bindName(mutable checker, name, index)
    checker.bodies[checker.body].locals[index].depth = depth
  }
}

// ---- narrowing ----

function narrowKey(local: int): string uses alloc {
  return `narrow|${Int.toString(local)}`
}

export function findNarrowed(checker: Checker, local: int): int uses alloc {
  const key = narrowKey(local)
  if (checker.localNames[key] is Some(variantIndex)) {
    return variantIndex
  }
  return -1
}

export function setNarrowed(mutable checker: Checker, local: int, variantIndex: int) uses alloc {
  bindName(mutable checker, narrowKey(local), variantIndex)
}

export function endNarrowing(mutable checker: Checker, local: int) uses alloc {
  // A `let` or `mutable` local is narrowed only until it is assigned, passed as `mutable` to a call, or reached again by a loop that assigns it. A -1 hides the variant, also once the scopes that narrowed it close.
  if (local < 0 || !getLocal(checker, local).isMutable) {
    return
  }
  endKey(mutable checker, narrowKey(local))
  endKey(mutable checker, factKey(local))
}

export function factKey(local: int): string uses alloc {
  return `fact|${Int.toString(local)}`
}

function endKey(mutable checker: Checker, key: string) uses alloc {
  if (checker.localNames[key] is Some(current)) {
    if (current == -1) {
      return
    }
    checker.localNames[key] = -1
    for (const index of Ranges.upTo(checker.scopeUndoCount)) {
      if (checker.scopeUndo[index].name == key) {
        checker.scopeUndo[index].previous = -1
      }
    }
  }
}

export function findNarrowable(checker: Checker, expression: Expr): int {
  if (expression is Expr.Ident(nodeId, _, _)) {
    if (getRef(checker, nodeId) is Ref.Local(index)) {
      return index
    }
  }
  return -1
}

export function findOtherVariant(checker: Checker, enumIndex: int, variantIndex: int): int {
  // Defined only for enums with exactly two variants.
  if (variantIndex < 0 || Arrays.length(checker.enums[enumIndex].variants) != 2) {
    return -1
  }
  return 1 - variantIndex
}

// ---- isIrrefutable patterns ----

export function isIrrefutable(checker: Checker, pattern: Pattern): bool {
  return match (pattern) {
    Pattern.PatWildcard(_, _) => true
    Pattern.PatName(nodeId, _, _) => isSingleVariantOrBinding(checker, nodeId)
    Pattern.PatCtor(nodeId, _, _, _, arguments, _) =>
      isSingleVariant(checker, nodeId) && allIrrefutable(checker, arguments)
    Pattern.PatStruct(_, _, fields) => structFieldsIrrefutable(checker, fields)
    Pattern.PatTuple(_, _, arguments) => allIrrefutable(checker, arguments)
    Pattern.PatLit(_, _, _) => false
    Pattern.PatOr(_, _, alternatives) => isAnyIrrefutable(checker, alternatives)
  }
}

function isAnyIrrefutable(checker: Checker, patterns: Array<Pattern>): bool {
  for (const pattern of Arrays.values(patterns)) {
    if (isIrrefutable(checker, pattern)) {
      return true
    }
  }
  return false
}

function isSingleVariantOrBinding(checker: Checker, nodeId: int): bool {
  if (getRef(checker, nodeId) is Ref.Constructor(enumIndex, _)) {
    return Arrays.length(checker.enums[enumIndex].variants) == 1
  }
  return true
}

function isSingleVariant(checker: Checker, nodeId: int): bool {
  if (getRef(checker, nodeId) is Ref.Constructor(enumIndex, _)) {
    return Arrays.length(checker.enums[enumIndex].variants) == 1
  }
  return false
}

function allIrrefutable(checker: Checker, patterns: Array<Pattern>): bool {
  for (const pattern of Arrays.values(patterns)) {
    if (!isIrrefutable(checker, pattern)) {
      return false
    }
  }
  return true
}

function structFieldsIrrefutable(checker: Checker, fields: Array<FieldPattern>): bool {
  for (const field of Arrays.values(fields)) {
    if (!isIrrefutable(checker, field.pattern)) {
      return false
    }
  }
  return true
}

export function areArgumentsIrrefutable(checker: Checker, pattern: Pattern): bool {
  // So `x is Some(_)` failing means x is None.
  return match (pattern) {
    Pattern.PatCtor(_, _, _, _, arguments, _) | Pattern.PatTuple(_, _, arguments) => allIrrefutable(
      checker,
      arguments,
    )
    _ => true
  }
}

// ---- exhaustiveness ----
//
// The usefulness algorithm: a match is exhaustive when no value vector
// escapes the rows. findMissingCases returns example values that no row
// matches, one string per column, at most `budget.remaining` of them (the order and
// the limit are Go's, since the message prints them).
//
// Enums, bools, structs and tuples have a finite set of constructors. Other
// types (int, string, arrays, type parameters) have infinitely many values,
// so only wildcards and bindings cover them.

function createWildcard(): Pattern {
  return Pattern.PatWildcard(-1, Pos { line: 0, column: 0 })
}

function createWildcards(count: int): Array<Pattern> uses alloc {
  let wildcards: Array<Pattern> = []
  for (const _position of Ranges.between(0, count)) {
    Arrays.push(mutable wildcards, createWildcard())
  }
  return wildcards
}

export function isWild(checker: Checker, pattern: Pattern): bool {
  if (pattern is Pattern.PatWildcard(_, _)) {
    return true
  }
  if (pattern is Pattern.PatName(nodeId, _, _)) {
    return getRef(checker, nodeId) is Ref.Unresolved
  }
  return false
}

function countConstructors(checker: Checker, type: Type): int {
  return match (type) {
    Type.TEnum(index) => Arrays.length(checker.enums[index].variants)
    Type.TStruct(_) => 1
    Type.TBool => 2
    _ => -1
  }
}

function listConstructorTypes(
  checker: Checker,
  type: Type,
  constructorIndex: int,
): Array<Type> from checker uses alloc {
  let types: Array<Type> = []
  if (type is Type.TEnum(index)) {
    for (const field of Arrays.values(checker.enums[index].variants[constructorIndex].fields)) {
      Arrays.push(mutable types, field.fieldType)
    }
  } else if (type is Type.TStruct(index)) {
    for (const field of Arrays.values(checker.structs[index].fields)) {
      Arrays.push(mutable types, field.fieldType)
    }
  }
  return types
}

function specialize(
  checker: Checker,
  pattern: Pattern,
  type: Type,
  constructorIndex: int,
  count: int,
): Option<Array<Pattern>> from pattern uses alloc {
  if (isWild(checker, pattern)) {
    return Some(createWildcards(count))
  }
  if (pattern is Pattern.PatName(nodeId, _, _)) {
    if (getRef(checker, nodeId) is Ref.Constructor(_, variantIndex)) {
      if (variantIndex != constructorIndex) {
        return None
      }
    }
    return Some(createWildcards(count))
  }
  if (pattern is Pattern.PatCtor(nodeId, _, _, _, arguments, bare)) {
    if (getRef(checker, nodeId) is Ref.Constructor(_, variantIndex)) {
      if (variantIndex != constructorIndex) {
        return None
      }
      if (bare || Arrays.length(arguments) != count) {
        return Some(createWildcards(count))
      }
      return Some(arguments)
    }
    return Some(createWildcards(count))
  }
  if (pattern is Pattern.PatTuple(_, _, arguments)) {
    if (Arrays.length(arguments) != count) {
      return Some(createWildcards(count))
    }
    return Some(arguments)
  }
  if (pattern is Pattern.PatStruct(_, _, fields)) {
    let out = createWildcards(count)
    if (type is Type.TStruct(structIndex)) {
      const structFields = checker.structs[structIndex].fields
      for (const fieldPattern of Arrays.values(fields)) {
        for (const index of Ranges.between(0, Arrays.length(structFields))) {
          if (structFields[index].name == fieldPattern.name) {
            out[index] = fieldPattern.pattern
          }
        }
      }
    }
    return Some(out)
  }
  if (pattern is Pattern.PatLit(_, _, literal)) {
    if (literal is Expr.BoolLit(_, _, value)) {
      if ((constructorIndex == 1) != value) {
        return None
      }
      return Some([])
    }
  }
  return Some(createWildcards(count))
}

function hasAlternativeHead(rows: Array<Array<Pattern>>): bool {
  for (const row of Arrays.values(rows)) {
    if (row[0] is Pattern.PatOr(_, _, _)) {
      return true
    }
  }
  return false
}

function expandAlternativeHeads(
  rows: Array<Array<Pattern>>,
): Array<Array<Pattern>> from rows uses alloc {
  let expanded: Array<Array<Pattern>> = []
  for (const row of Arrays.values(rows)) {
    if (row[0] is Pattern.PatOr(_, _, alternatives)) {
      const rest = sliceItems(row, 1, Arrays.length(row))
      for (const alternative of Arrays.values(alternatives)) {
        Arrays.push(mutable expanded, joinItems([alternative], rest))
      }
    } else {
      Arrays.push(mutable expanded, row)
    }
  }
  return expanded
}

function sliceItems<T>(items: Array<T>, start: int, end: int): Array<T> from items uses alloc {
  let out: Array<T> = []
  for (const index of Ranges.between(start, end)) {
    Arrays.push(mutable out, items[index])
  }
  return out
}

function joinItems<T>(first: Array<T>, second: Array<T>): Array<T> from first uses alloc {
  let out: Array<T> = []
  for (const item of Arrays.values(first)) {
    Arrays.push(mutable out, item)
  }
  for (const item of Arrays.values(second)) {
    Arrays.push(mutable out, item)
  }
  return copy(out)
}

// How many more missing cases findMissingCases may report, shared down its
// recursion.
export struct CaseBudget {
  remaining: int
}

export function findMissingCases(
  checker: Checker,
  rows: Array<Array<Pattern>>,
  types: Array<Type>,
  mutable budget: CaseBudget,
): Array<Array<string>> uses alloc {
  if (budget.remaining <= 0) {
    return []
  }
  if (Arrays.length(rows) == 0) {
    budget.remaining--
    return [filledArray("_", Arrays.length(types))]
  }
  if (Arrays.length(types) == 0) {
    return []
  }
  if (hasAlternativeHead(rows)) {
    return findMissingCases(checker, expandAlternativeHeads(rows), types, mutable budget)
  }
  const type = types[0]
  const count = countConstructors(checker, type)
  const restTypes = sliceItems(types, 1, Arrays.length(types))
  let allWild = true
  for (const row of Arrays.values(rows)) {
    if (!isWild(checker, row[0])) {
      allWild = false
    }
  }

  // Only wildcards cover an infinite type, and a column of wildcards covers
  // any constructor: look at the other columns.
  if (count < 0 || allWild) {
    let defaults: Array<Array<Pattern>> = []
    for (const row of Arrays.values(rows)) {
      if (isWild(checker, row[0])) {
        Arrays.push(mutable defaults, sliceItems(row, 1, Arrays.length(row)))
      }
    }
    let out: Array<Array<string>> = []
    for (const example of Arrays.values(
      findMissingCases(checker, defaults, restTypes, mutable budget),
    )) {
      Arrays.push(mutable out, joinItems(["_"], example))
    }
    return out
  }

  // Otherwise try each constructor with the rows that can match it.
  let out: Array<Array<string>> = []
  for (const constructorIndex of Ranges.between(0, count)) {
    const argumentTypes = listConstructorTypes(checker, type, constructorIndex)
    const argumentCount = Arrays.length(argumentTypes)
    let specialized: Array<Array<Pattern>> = []
    for (const row of Arrays.values(rows)) {
      if (specialize(checker, row[0], type, constructorIndex, argumentCount) is Some(patterns)) {
        Arrays.push(
          mutable specialized,
          joinItems(patterns, sliceItems(row, 1, Arrays.length(row))),
        )
      }
    }
    const subTypes = joinItems(argumentTypes, restTypes)
    for (const example of Arrays.values(
      findMissingCases(checker, specialized, subTypes, mutable budget),
    )) {
      const head = describeConstructor(
        checker,
        type,
        constructorIndex,
        sliceItems(example, 0, argumentCount),
      )
      Arrays.push(
        mutable out,
        joinItems([head], sliceItems(example, argumentCount, Arrays.length(example))),
      )
    }
  }
  return out
}

// ---- unreachable alternatives ----

function findPatternConstructor(checker: Checker, pattern: Pattern): int {
  if (isWild(checker, pattern)) {
    return -1
  }
  if (pattern is Pattern.PatName(nodeId, _, _)) {
    if (getRef(checker, nodeId) is Ref.Constructor(_, variantIndex)) {
      return variantIndex
    }
    return -1
  }
  if (pattern is Pattern.PatCtor(nodeId, _, _, _, _, _)) {
    if (getRef(checker, nodeId) is Ref.Constructor(_, variantIndex)) {
      return variantIndex
    }
    return -1
  }
  if (pattern is Pattern.PatStruct(_, _, _)) {
    return 0
  }
  if (pattern is Pattern.PatTuple(_, _, _)) {
    return 0
  }
  if (pattern is Pattern.PatLit(_, _, literal)) {
    if (literal is Expr.BoolLit(_, _, value)) {
      if (value) {
        return 1
      }
      return 0
    }
  }
  return -1
}

function coversEveryConstructor(
  checker: Checker,
  rows: Array<Array<Pattern>>,
  count: int,
): bool uses alloc {
  let seen: Array<bool> = filledArray(false, count)
  for (const row of Arrays.values(rows)) {
    const index = findPatternConstructor(checker, row[0])
    if (index >= 0) {
      seen[index] = true
    }
  }
  for (const found of Arrays.values(seen)) {
    if (!found) {
      return false
    }
  }
  return true
}

function isLiteral(pattern: Pattern): bool {
  return pattern is Pattern.PatLit(_, _, _)
}

function getPatternLiteral(pattern: Pattern): Expr from pattern {
  if (pattern is Pattern.PatLit(_, _, literal)) {
    return literal
  }
  return Expr.BoolLit(0, Pos { line: 0, column: 0 }, false)
}

function describeLiteral(literal: Expr): string uses alloc {
  if (literal is Expr.IntLit(_, _, text)) {
    return `i${text}`
  }
  if (literal is Expr.FloatLit(_, _, text)) {
    return `f${text}`
  }
  if (literal is Expr.StringLit(_, _, value, _)) {
    return `s${value}`
  }
  if (literal is Expr.CharLit(_, _, value)) {
    return `c${value}`
  }
  if (literal is Expr.UnaryExpr(_, _, _, operand)) {
    return `-${describeLiteral(operand)}`
  }
  return ""
}

export function isUseful(
  checker: Checker,
  rows: Array<Array<Pattern>>,
  vector: Array<Pattern>,
  types: Array<Type>,
): bool uses alloc {
  if (Arrays.length(types) == 0) {
    return Arrays.length(rows) == 0
  }
  if (vector[0] is Pattern.PatOr(_, _, alternatives)) {
    const rest = sliceItems(vector, 1, Arrays.length(vector))
    for (const alternative of Arrays.values(alternatives)) {
      if (isUseful(checker, rows, joinItems([alternative], rest), types)) {
        return true
      }
    }
    return false
  }
  const expandedRows = expandAlternativeHeads(rows)
  const type = types[0]
  const count = countConstructors(checker, type)
  const restVector = sliceItems(vector, 1, Arrays.length(vector))
  const restTypes = sliceItems(types, 1, Arrays.length(types))
  if (count < 0 && isLiteral(vector[0])) {
    // A literal of an infinite type is covered by a wildcard or by the same literal.
    const key = describeLiteral(getPatternLiteral(vector[0]))
    let matching: Array<Array<Pattern>> = []
    for (const row of Arrays.values(expandedRows)) {
      if (isWild(checker, row[0])) {
        Arrays.push(mutable matching, sliceItems(row, 1, Arrays.length(row)))
      } else if (isLiteral(row[0])) {
        if (key != "" && describeLiteral(getPatternLiteral(row[0])) == key) {
          Arrays.push(mutable matching, sliceItems(row, 1, Arrays.length(row)))
        }
      }
    }
    return isUseful(checker, matching, restVector, restTypes)
  }
  const selected = findPatternConstructor(checker, vector[0])
  const wildVector = selected < 0 && isWild(checker, vector[0])
  if (
    count < 0 ||
      (selected < 0 && !wildVector) ||
      (wildVector && !coversEveryConstructor(checker, expandedRows, count))
  ) {
    // Only rows that start with a wildcard are known to cover this column.
    // A wildcard vector is also checked against the wildcard rows alone while
    // some constructor has no row, which stops the walk down a recursive type.
    let defaults: Array<Array<Pattern>> = []
    for (const row of Arrays.values(expandedRows)) {
      if (isWild(checker, row[0])) {
        Arrays.push(mutable defaults, sliceItems(row, 1, Arrays.length(row)))
      }
    }
    return isUseful(checker, defaults, restVector, restTypes)
  }
  for (const constructorIndex of Ranges.between(0, count)) {
    if (selected >= 0 && selected != constructorIndex) {
      continue
    }
    const argumentTypes = listConstructorTypes(checker, type, constructorIndex)
    const argumentCount = Arrays.length(argumentTypes)
    let specializedRows: Array<Array<Pattern>> = []
    for (const row of Arrays.values(expandedRows)) {
      if (specialize(checker, row[0], type, constructorIndex, argumentCount) is Some(patterns)) {
        Arrays.push(
          mutable specializedRows,
          joinItems(patterns, sliceItems(row, 1, Arrays.length(row))),
        )
      }
    }
    let head = createWildcards(argumentCount)
    if (selected >= 0) {
      if (specialize(checker, vector[0], type, constructorIndex, argumentCount) is Some(patterns)) {
        head = patterns
      }
    }
    if (
      isUseful(
        checker,
        specializedRows,
        joinItems(head, restVector),
        joinItems(argumentTypes, restTypes),
      )
    ) {
      return true
    }
  }
  return false
}

function describeConstructor(
  checker: Checker,
  type: Type,
  constructorIndex: int,
  arguments: Array<string>,
): string uses alloc {
  let allWild = true
  for (const argument of Arrays.values(arguments)) {
    if (argument != "_") {
      allWild = false
    }
  }
  if (type is Type.TEnum(index)) {
    const variant = checker.enums[index].variants[constructorIndex]
    if (Arrays.length(variant.fields) == 0) {
      return variant.name
    }
    return `${variant.name}(${Str.join(arguments, ", ")})`
  }
  if (type is Type.TStruct(index)) {
    if (allWild) {
      return "_"
    }
    if (checker.structs[index].tuple) {
      return `#[${Str.join(arguments, ", ")}]`
    }
    let parts: Array<string> = []
    for (const position of Ranges.between(0, Arrays.length(arguments))) {
      if (arguments[position] != "_") {
        Arrays.push(
          mutable parts,
          `${checker.structs[index].fields[position].name}: ${arguments[position]}`,
        )
      }
    }
    return `{ ${Str.join(parts, ", ")} }`
  }
  if (type == Type.TBool) {
    if (constructorIndex == 1) {
      return "true"
    }
    return "false"
  }
  return "_"
}
