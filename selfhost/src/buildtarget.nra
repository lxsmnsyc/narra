// The target a program is built for: the values of Build.os, Build.arch and
// Build.debug (std/build). TARGETS is the one table of supported targets;
// cross-targets adds rows and columns to it.
import * as Arrays from "std/array"
import * as Build from "std/build"
import { Os, Arch } from "std/build"
import * as Env from "std/env"
import * as Str from "std/string"
import { Pos } from "narrac/ast"

// os and arch are variant names of the Os and Arch enums of std/build. An
// empty os means no target was chosen: the package does not import std/build,
// NARRA_HOST_TARGET names no row in TARGETS (unsupportedHost then names it), or
// the C compiler that built narrac targets no row (hostError then says so).
export struct BuildTarget {
  os: string
  arch: string
  debug: bool
  unsupportedHost: string
  hostError: string = ""
  libc: string = ""
}

// One supported target.
export struct TargetRow {
  os: string
  arch: string
  hostOs: Option<Os>
  hostArch: Option<Arch>
  triple: string
  libc: string
}

export const TARGETS: Array<TargetRow> = [
  TargetRow {
    os: "MacOS",
    arch: "Arm64",
    hostOs: Some(Os.MacOS),
    hostArch: Some(Arch.Arm64),
    triple: "aarch64-macos",
    libc: "",
  },
  TargetRow {
    os: "MacOS",
    arch: "X86_64",
    hostOs: Some(Os.MacOS),
    hostArch: Some(Arch.X86_64),
    triple: "x86_64-macos",
    libc: "",
  },
  TargetRow {
    os: "Linux",
    arch: "X86_64",
    hostOs: Some(Os.Linux),
    hostArch: Some(Arch.X86_64),
    triple: "x86_64-linux-gnu",
    libc: "",
  },
  TargetRow {
    os: "Linux",
    arch: "Arm64",
    hostOs: Some(Os.Linux),
    hostArch: Some(Arch.Arm64),
    triple: "aarch64-linux-gnu",
    libc: "",
  },
  TargetRow {
    os: "Linux",
    arch: "X86_64",
    hostOs: Some(Os.Linux),
    hostArch: Some(Arch.X86_64),
    triple: "x86_64-linux-musl",
    libc: "musl",
  },
  TargetRow {
    os: "Linux",
    arch: "Arm64",
    hostOs: Some(Os.Linux),
    hostArch: Some(Arch.Arm64),
    triple: "aarch64-linux-musl",
    libc: "musl",
  },
  TargetRow {
    os: "Windows",
    arch: "X86_64",
    hostOs: None,
    hostArch: None,
    triple: "x86_64-windows-gnu",
    libc: "",
  },
  TargetRow {
    os: "Wasi",
    arch: "Wasm32",
    hostOs: None,
    hostArch: None,
    triple: "wasm32-wasi",
    libc: "",
  },
]

// What a `@target` function needs: the variant names its attribute gives,
// "" for os or arch when it does not name one.
export struct TargetRequirement {
  os: string
  arch: string
}

// The source of a branch the target drops, in the module of scope (Checker.scopes),
// from start to end inclusive.
export struct DroppedRange {
  scope: int
  start: Pos
  end: Pos
}

// The environment variable that names the host target as `<os>-<arch>`
// (`Linux-X86_64`), in place of the target narrac itself was built for.
const HOST_OVERRIDE = "NARRA_HOST_TARGET"

export function createUnknownTarget(debug: bool): BuildTarget {
  return BuildTarget { os: "", arch: "", debug, unsupportedHost: "" }
}

export function detectHostTarget(debug: bool): BuildTarget uses io, alloc {
  // An override names a row by its os and arch.
  if (Env.get(HOST_OVERRIDE) is Some(named)) {
    if (findTargetRow(named) is Some(row)) {
      return createTarget(row, debug)
    }
    return BuildTarget { os: "", arch: "", debug, unsupportedHost: named }
  }
  // The host is the target the C compiler built narrac for.
  const host = Build.hostTarget()
  if (host is Some(target)) {
    for (const row of Arrays.values(TARGETS)) {
      if (row.hostOs == Some(target.os) && row.hostArch == Some(target.arch)) {
        return createTarget(row, debug)
      }
    }
  }
  return createFailedTarget(debug, "no supported target for this C compiler")
}

export function describeRow(row: TargetRow): string uses alloc {
  return joinTargetName(row.os, row.arch, row.libc)
}

export function findTargetRow(name: string): Option<TargetRow> uses alloc {
  for (const row of Arrays.values(TARGETS)) {
    if (describeRow(row) == name) {
      return Some(row)
    }
  }
  return None
}

export function describeUnknownTarget(name: string): string uses alloc {
  return `E1600: unknown target ${name}; the targets are ${describeTargets()}`
}

export function describeSanitizeError(row: TargetRow): string uses alloc {
  return `E1601: -sanitize cannot build for ${describeRow(row)}: sanitizer runtimes do not cross-link; build without -sanitize`
}

export function targetCompilerArguments(_row: TargetRow): Array<string> uses alloc {
  // Per-target flags of the C compiler; none yet.
  return []
}

export function describeTargets(): string uses alloc {
  let names: Array<string> = []
  for (const row of Arrays.values(TARGETS)) {
    Arrays.push(mutable names, describeRow(row))
  }
  return Str.join(names, ", ")
}

export function listTargets(debug: bool): Array<BuildTarget> uses alloc {
  let targets: Array<BuildTarget> = []
  for (const row of Arrays.values(TARGETS)) {
    Arrays.push(mutable targets, createTarget(row, debug))
  }
  return targets
}

export function describeTarget(target: BuildTarget): string uses alloc {
  return joinTargetName(target.os, target.arch, target.libc)
}

function joinTargetName(os: string, arch: string, libc: string): string uses alloc {
  if (libc == "") {
    return `${os}-${arch}`
  }
  return `${os}-${arch}-${libc}`
}

export function isTargetMet(requirement: TargetRequirement, target: BuildTarget): bool {
  return (requirement.os == "" || requirement.os == target.os) &&
    (requirement.arch == "" || requirement.arch == target.arch)
}

export function describeRequirement(requirement: TargetRequirement): string uses alloc {
  let parts: Array<string> = []
  if (requirement.os != "") {
    Arrays.push(mutable parts, `os = Os.${requirement.os}`)
  }
  if (requirement.arch != "") {
    Arrays.push(mutable parts, `arch = Arch.${requirement.arch}`)
  }
  return Str.join(parts, ", ")
}

export function createTarget(row: TargetRow, debug: bool): BuildTarget uses alloc {
  return BuildTarget {
    os: row.os,
    arch: row.arch,
    debug,
    unsupportedHost: "",
    libc: row.libc,
  }
}

function createFailedTarget(debug: bool, reason: string): BuildTarget {
  return BuildTarget {
    os: "",
    arch: "",
    debug,
    unsupportedHost: "",
    hostError: reason,
  }
}
