import * as Str from "std/string"

struct Size {
  count: int
}

function root(x: f64): f64
  requires x >= 0.0
{
  return x
}

function area(size: Size): int
  requires size.count > 0
{
  return size.count
}

function either(count: int, limit: int): int
  requires count < 0 && limit > 0 || count > 10
{
  return count
}

function ordered(low: int, high: int): int
  requires low < high - 1
{
  return high - low
}

function measured(text: string): int
  requires Str.length(text) > 0
{
  return 0
}

export function run(_args: Array<string>): int {
  return 0
