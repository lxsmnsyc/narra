struct Pair<A, B> {
  first: A
  second: B
}
enum List<T> {
  Cons(head: T, tail: List<T>)
  Nil
}
struct Tree<T> {
  value: T
  kids: Array<Tree<T>>
}
struct Holder {
  p: Pair<Option<Pair<int, string>>, Array<Box<Map<string, #[int, bool]>>>>
  l: List<Pair<int, int>>
  t: Tree<List<string>>
  f: (Pair<int, int>, Result<string, int>) => Option<#[int, string]>
  g: () => void
}
function swap<A, B>(p: Pair<A, B>): Pair<B, A> {
  return Pair { first: p.second, second: p.first }
}
function nest<T>(x: T): Pair<T, Pair<T, List<T>>> {
  return Pair { first: x, second: Pair { first: x, second: Nil } }
}
