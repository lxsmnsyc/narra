import * as Int from "std/int"

struct Block {
  a: int
  b: int
  c: int
  d: int
  e: int
  f: int
  g: int
  h: int
}

async function total(block: Block): int {
  const probe = async (shift: int): int => block.a + block.h + shift
  return await probe(5)
}

export async function run(_args: Array<string>): int {
  const origin = Block { a: 10, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 20 }
  print(Int.toString(await total(origin)))
  return 0
}
