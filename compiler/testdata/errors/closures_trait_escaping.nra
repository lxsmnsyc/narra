// error: Reg.reg for A must be `function reg(v: A, f: () => int): (int) => int`
trait Reg {
  function reg(v: Self, f: () => int): (n: int) => int
}

struct A implements Reg {
  x: int
}

implement Reg for A {
  function reg(v: A, escaping f: () => int): (n: int) => int {
    return (n) => f() + n
  }
}

function go<T: Reg>(v: T, n: int): (n: int) => int {
  return Reg.reg(v, () => n + 1)
}

export function run(args: Array<string>): int {
  return go(A { x: 1 }, 40)(1)
}
