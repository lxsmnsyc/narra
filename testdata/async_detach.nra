// Async.detach lets a task run with nobody waiting. One task finishes inside
// the call that starts it, another after the entry lets the loop run.
import * as Int from "std/int"
import * as Async from "std/async"

async function report(name: string, value: int): int uses io, alloc {
  print(`${name} ${Int.toString(value)}`)
  return value
}

async function slow(name: string): int uses io, alloc {
  print(`${name} waits`)
  await Async.idle()
  print(`${name} done`)
  return 0
}

export async function run(_args: Array<string>): int {
  Async.detach(report("quick", 1))
  Async.detach(slow("slow"))
  print("entry waits")
  await Async.idle()
  print("entry done")
  return 0
}
