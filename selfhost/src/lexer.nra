// The lexer, ported line by line from compiler/internal/narra/lexer.go.
// It works on an array of characters, like the Go lexer works on []rune, so
// columns count characters, not bytes.
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// The kinds carry a Tok prefix, as in Go, so they do not clash with the
// expression variants of narrac/ast (IntLit, Ident, ...).
export enum TokenKind {
  TokEof
  TokNewline
  TokIdent
  TokInt
  TokFloat
  TokString
  TokChar
  TokTemplate
  TokKeyword
  TokPunct
}

// A token. endLine:endCol is the position after its last character (Go:
// Token.End); the parser reads it for StringLit.end.
export struct Token {
  kind: TokenKind
  text: string
  line: int
  col: int
  endLine: int
  endCol: int
}

struct Lexer {
  source: Array<char>
  index: int
  line: int
  col: int
  depth: int // nesting of ( and [, where line breaks never end a statement
  tokens: Array<Token>
  punctuationChars: Array<Array<char>>
}

const KEYWORDS = Map {
  "function": true, "export": true, "import": true, "from": true, "as": true,
  "const": true, "let": true, "if": true, "else": true, "while": true,
  "for": true, "of": true, "return": true, "break": true, "continue": true,
  "struct": true, "enum": true, "match": true, "true": true, "false": true,
  "mutable": true, "uses": true, "test": true, "is": true,
  "trait": true, "implement": true, "implements": true, "derives": true,
}

// Longest punctuation first, so "==" is matched before "=".
const PUNCTS = [
  "===", "!==", "...", "#[", "=>", "==", "!=", "<=", ">=", "&&", "||", "+%", "-%", "*%", "<<", ">>",
  "+", "-", "*", "/", "%", "<", ">", "=", "!", "&", "|", "^", "~",
  "(", ")", "{", "}", "[", "]", ",", ":", ".", ";",
]

function createLexer(source: string): Lexer {
  let punctuationChars: Array<Array<char>> = []
  for (const punctuation of Arrays.values(PUNCTS)) {
    Arrays.push(mutable punctuationChars, Str.chars(punctuation))
  }
  return Lexer {
    source: Str.chars(source),
    index: 0,
    line: 1,
    col: 1,
    depth: 0,
    tokens: [],
    punctuationChars: punctuationChars,
  }
}

// lex returns the tokens of source, or the first error as "line:col: message".
export function lex(source: string): Result<Array<Token>, string> uses alloc {
  let lexer = createLexer(source)
  const failed = runLexer(mutable lexer)
  if (failed is Some(message)) {
    return Err(message)
  }
  return Ok(lexer.tokens)
}

function errorAt(line: int, col: int, message: string): Option<string> {
  return Some(`${Int.toString(line)}:${Int.toString(col)}: ${message}`)
}

function getSize(lexer: Lexer): int {
  return Arrays.length(lexer.source)
}

function peek(lexer: Lexer, offset: int): char {
  if (lexer.index + offset < Arrays.length(lexer.source)) {
    return lexer.source[lexer.index + offset]
  }
  return '\0'
}

function advance(mutable lexer: Lexer): char {
  const character = lexer.source[lexer.index]
  lexer.index = lexer.index + 1
  if (character == '\n') {
    lexer.line = lexer.line + 1
    lexer.col = 1
  } else {
    lexer.col = lexer.col + 1
  }
  return character
}

// emit runs after the token's characters are consumed, so the current
// position is the token's end.
function emit(mutable lexer: Lexer, kind: TokenKind, text: string, line: int, col: int) {
  const token = Token { kind: kind, text: text, line: line, col: col, endLine: lexer.line, endCol: lexer.col }
  Arrays.push(mutable lexer.tokens, token)
}

// A line break ends a statement only after a token that can end one.
function lastEndsStatement(lexer: Lexer): bool {
  const count = Arrays.length(lexer.tokens)
  if (count == 0) {
    return false
  }
  const last = lexer.tokens[count - 1]
  return match (last.kind) {
    TokenKind.TokIdent => true
    TokenKind.TokInt => true
    TokenKind.TokFloat => true
    TokenKind.TokString => true
    TokenKind.TokChar => true
    TokenKind.TokTemplate => true
    TokenKind.TokKeyword => last.text == "return" || last.text == "break" || last.text == "continue" || last.text == "true" || last.text == "false"
    TokenKind.TokPunct => last.text == ")" || last.text == "]" || last.text == "}"
    _ => false
  }
}

// readText returns the characters first..end of the source as a string.
// (`from` is a keyword, so it cannot name a parameter.)
function readText(lexer: Lexer, first: int, end: int): string {
  let builder = Str.builder()
  for (const index of Ranges.between(first, end)) {
    Str.appendChar(mutable builder, lexer.source[index])
  }
  return Str.build(builder)
}

function runLexer(mutable lexer: Lexer): Option<string> {
  while (lexer.index < getSize(lexer)) {
    const character = peek(lexer, 0)
    const line = lexer.line
    const col = lexer.col
    if (character == '\n') {
      advance(mutable lexer)
      if (lexer.depth == 0 && lastEndsStatement(lexer)) {
        emit(mutable lexer, TokenKind.TokNewline, "\n", line, col)
      }
    } else if (character == ' ' || character == '\t' || character == '\r') {
      advance(mutable lexer)
    } else if (character == '/' && peek(lexer, 1) == '/') {
      while (lexer.index < getSize(lexer) && peek(lexer, 0) != '\n') {
        advance(mutable lexer)
      }
    } else if (character == '/' && peek(lexer, 1) == '*') {
      advance(mutable lexer)
      advance(mutable lexer)
      while (lexer.index < getSize(lexer) && !(peek(lexer, 0) == '*' && peek(lexer, 1) == '/')) {
        advance(mutable lexer)
      }
      if (lexer.index >= getSize(lexer)) {
        return errorAt(line, col, "unterminated block comment")
      }
      advance(mutable lexer)
      advance(mutable lexer)
    } else if (isLetter(character)) {
      const start = lexer.index
      while (lexer.index < getSize(lexer) && (isLetter(peek(lexer, 0)) || isDigit(peek(lexer, 0)))) {
        advance(mutable lexer)
      }
      const word = readText(lexer, start, lexer.index)
      if (KEYWORDS[word] is Some(_)) {
        emit(mutable lexer, TokenKind.TokKeyword, word, line, col)
      } else {
        emit(mutable lexer, TokenKind.TokIdent, word, line, col)
      }
    } else if (isDigit(character)) {
      lexNumber(mutable lexer, line, col)
    } else if (character == '"') {
      const literal = lexQuoted(mutable lexer, '"', line, col)
      if (literal is Err(error)) {
        return Some(error)
      }
      emit(mutable lexer, TokenKind.TokString, literal.value, line, col)
    } else if (character == '\'') {
      const literal = lexQuoted(mutable lexer, '\'', line, col)
      if (literal is Err(error)) {
        return Some(error)
      }
      if (Str.charCount(literal.value) != 1) {
        return errorAt(line, col, "a character literal holds exactly one character; use double quotes for strings")
      }
      emit(mutable lexer, TokenKind.TokChar, literal.value, line, col)
    } else if (character == '`') {
      const literal = lexTemplate(mutable lexer, line, col)
      if (literal is Err(error)) {
        return Some(error)
      }
      emit(mutable lexer, TokenKind.TokTemplate, literal.value, line, col)
    } else {
      const failed = lexPunctuation(mutable lexer, character, line, col)
      if (failed is Some(_)) {
        return failed
      }
    }
  }
  const line = lexer.line
  const col = lexer.col
  if (lastEndsStatement(lexer)) {
    emit(mutable lexer, TokenKind.TokNewline, "\n", line, col)
  }
  emit(mutable lexer, TokenKind.TokEof, "", line, col)
  return None
}

function lexPunctuation(mutable lexer: Lexer, character: char, line: int, col: int): Option<string> {
  for (const index of Ranges.upTo(Arrays.length(PUNCTS))) {
    if (hasPrefix(lexer, lexer.punctuationChars[index])) {
      const punctuation = PUNCTS[index]
      for (const _character of Arrays.values(lexer.punctuationChars[index])) {
        advance(mutable lexer)
      }
      if (punctuation == ";") {
        return errorAt(line, col, "semicolons are not used; end the statement with a line break")
      }
      if (punctuation == "(" || punctuation == "[" || punctuation == "#[") {
        lexer.depth = lexer.depth + 1
      } else if (punctuation == ")" || punctuation == "]") {
        if (lexer.depth > 0) {
          lexer.depth = lexer.depth - 1
        }
      }
      emit(mutable lexer, TokenKind.TokPunct, punctuation, line, col)
      return None
    }
  }
  return errorAt(line, col, `unexpected character ${quoteChar(character)}`)
}

function hasPrefix(lexer: Lexer, prefix: Array<char>): bool {
  for (const index of Ranges.upTo(Arrays.length(prefix))) {
    if (peek(lexer, index) != prefix[index]) {
      return false
    }
  }
  return true
}

function lexNumber(mutable lexer: Lexer, line: int, col: int) {
  // A 0x, 0b or 0o prefix takes hex digits; otherwise read a decimal with an
  // optional fraction and exponent.
  const start = lexer.index
  let isFloat = false
  if (peek(lexer, 0) == '0' && (peek(lexer, 1) == 'x' || peek(lexer, 1) == 'b' || peek(lexer, 1) == 'o')) {
    advance(mutable lexer)
    advance(mutable lexer)
    while (isHexDigit(peek(lexer, 0)) || peek(lexer, 0) == '_') {
      advance(mutable lexer)
    }
  } else {
    while (isDigit(peek(lexer, 0)) || peek(lexer, 0) == '_') {
      advance(mutable lexer)
    }
    if (peek(lexer, 0) == '.' && isDigit(peek(lexer, 1))) {
      isFloat = true
      advance(mutable lexer)
      while (isDigit(peek(lexer, 0)) || peek(lexer, 0) == '_') {
        advance(mutable lexer)
      }
    }
    if (peek(lexer, 0) == 'e' || peek(lexer, 0) == 'E') {
      isFloat = true
      advance(mutable lexer)
      if (peek(lexer, 0) == '+' || peek(lexer, 0) == '-') {
        advance(mutable lexer)
      }
      while (isDigit(peek(lexer, 0))) {
        advance(mutable lexer)
      }
    }
  }

  // The text without the `_` separators.
  let builder = Str.builder()
  for (const index of Ranges.between(start, lexer.index)) {
    if (lexer.source[index] != '_') {
      Str.appendChar(mutable builder, lexer.source[index])
    }
  }
  if (isFloat) {
    emit(mutable lexer, TokenKind.TokFloat, Str.build(builder), line, col)
  } else {
    emit(mutable lexer, TokenKind.TokInt, Str.build(builder), line, col)
  }
}

function fail(line: int, col: int, message: string): Result<string, string> {
  return Err(`${Int.toString(line)}:${Int.toString(col)}: ${message}`)
}

function lexEscape(mutable lexer: Lexer, line: int, col: int): Result<string, string> {
  advance(mutable lexer) // the backslash
  if (lexer.index >= getSize(lexer)) {
    return fail(line, col, "unterminated escape")
  }
  const character = advance(mutable lexer)
  return match (character) {
    'n' => Ok("\n")
    't' => Ok("\t")
    'r' => Ok("\r")
    '0' => Ok("\0")
    '\\' => Ok("\\")
    '"' => Ok("\"")
    '\'' => Ok("'")
    '`' => Ok("`")
    '$' => Ok("$")
    'u' => lexUnicodeEscape(mutable lexer, line, col)
    _ => fail(line, col, `unknown escape \\${Str.fromChar(character)}`)
  }
}

function lexUnicodeEscape(mutable lexer: Lexer, line: int, col: int): Result<string, string> {
  if (peek(lexer, 0) != '{') {
    return fail(line, col, "expected { after \\u")
  }
  advance(mutable lexer)
  let value = 0
  while (peek(lexer, 0) != '}') {
    if (lexer.index >= getSize(lexer) || !isHexDigit(peek(lexer, 0))) {
      return fail(line, col, "invalid \\u escape")
    }
    value = (value *% 16) +% hexValue(advance(mutable lexer))
  }
  advance(mutable lexer)
  return Ok(Str.fromChar(convertRune(value)))
}

// convertRune copies Go's string(rune(value)): value is cut to 32 bits, and a
// negative value, a surrogate or a value above 0x10FFFF becomes U+FFFD.
function convertRune(value: int): char {
  const code = value & 0xFFFFFFFF
  if (code < 0x80000000) {
    if (Char.fromCode(code) is Some(character)) {
      return character
    }
  }
  return '\u{FFFD}'
}

function lexQuoted(mutable lexer: Lexer, quote: char, line: int, col: int): Result<string, string> {
  advance(mutable lexer)
  let builder = Str.builder()
  while (true) {
    if (lexer.index >= getSize(lexer) || peek(lexer, 0) == '\n') {
      return fail(line, col, "unterminated literal")
    }
    const character = peek(lexer, 0)
    if (character == quote) {
      advance(mutable lexer)
      return Ok(Str.build(builder))
    }
    if (character == '\\') {
      const escaped = lexEscape(mutable lexer, line, col)
      if (escaped is Err(error)) {
        return Err(error)
      }
      Str.append(mutable builder, escaped.value)
    } else {
      Str.appendChar(mutable builder, advance(mutable lexer))
    }
  }
  return fail(line, col, "unreachable")
}

// Templates keep their raw source. The parser splits out each ${...} part
// and parses it on its own.
function lexTemplate(mutable lexer: Lexer, line: int, col: int): Result<string, string> {
  advance(mutable lexer)
  const start = lexer.index
  while (true) {
    if (lexer.index >= getSize(lexer)) {
      return fail(line, col, "unterminated template string")
    }
    const character = peek(lexer, 0)
    if (character == '\\') {
      advance(mutable lexer)
      if (lexer.index < getSize(lexer)) {
        advance(mutable lexer)
      }
    } else if (character == '`') {
      const raw = readText(lexer, start, lexer.index)
      advance(mutable lexer)
      return Ok(raw)
    } else {
      advance(mutable lexer)
    }
  }
  return fail(line, col, "unreachable")
}

// hex writes value (not negative) in lowercase hexadecimal with at least
// `width` digits.
export function hex(value: int, width: int): string uses alloc {
  const digits = Int.toHex(value)
  const padding = width - Str.length(digits)
  if (padding > 0) {
    return `${Str.repeat("0", padding)}${digits}`
  }
  return digits
}

// quoteChar copies Go's %q for a rune, for the "unexpected character" error.
// Non-ASCII characters are written as they are (Go escapes the ones that
// are not printable; this needs Unicode tables).
function quoteChar(character: char): string {
  return match (character) {
    '\'' => "'\\''"
    '\\' => "'\\\\'"
    '\u{7}' => "'\\a'"
    '\u{8}' => "'\\b'"
    '\u{c}' => "'\\f'"
    '\n' => "'\\n'"
    '\r' => "'\\r'"
    '\t' => "'\\t'"
    '\u{b}' => "'\\v'"
    _ => quoteOther(character)
  }
}

function quoteOther(character: char): string {
  if (character < ' ' || character == '\u{7f}') {
    return `'\\x${hex(Char.code(character), 2)}'`
  }
  return `'${Str.fromChar(character)}'`
}

function isLetter(character: char): bool {
  return character == '_' || (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
}

function isDigit(character: char): bool {
  return character >= '0' && character <= '9'
}

function isHexDigit(character: char): bool {
  return isDigit(character) || (character >= 'a' && character <= 'f') || (character >= 'A' && character <= 'F')
}

function hexValue(character: char): int {
  if (isDigit(character)) {
    return Char.code(character) - Char.code('0')
  }
  if (character >= 'a' && character <= 'f') {
    return Char.code(character) - Char.code('a') + 10
  }
  return Char.code(character) - Char.code('A') + 10
}

export function kindName(kind: TokenKind): string {
  return match (kind) {
    TokenKind.TokEof => "eof"
    TokenKind.TokNewline => "newline"
    TokenKind.TokIdent => "ident"
    TokenKind.TokInt => "int"
    TokenKind.TokFloat => "float"
    TokenKind.TokString => "string"
    TokenKind.TokChar => "char"
    TokenKind.TokTemplate => "template"
    TokenKind.TokKeyword => "keyword"
    TokenKind.TokPunct => "punct"
  }
}

// escapeText writes `\` as `\\`, newline, tab and carriage return as `\n`,
// `\t` and `\r`, and other control characters as `\u{<hex>}`, the same as
// escapeTokenText in compiler/internal/narra/lexdump.go.
export function escapeText(text: string): string uses alloc {
  let builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (character == '\n') {
      Str.append(mutable builder, "\\n")
    } else if (character == '\t') {
      Str.append(mutable builder, "\\t")
    } else if (character == '\r') {
      Str.append(mutable builder, "\\r")
    } else if (character < ' ' || character == '\u{7f}') {
      Str.append(mutable builder, `\\u{${Int.toHex(Char.code(character))}}`)
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  return Str.build(builder)
}
