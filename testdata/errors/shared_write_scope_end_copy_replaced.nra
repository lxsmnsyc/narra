// error: Arrays.push(mutable list, ...) may change list, which snapshot still holds until its block ends
// Once bag.items is replaced, the copy's credit ends with the old array, so
// a write through a second name of the snapshot is a hidden copy again.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Bag {
  items: Array<int>
}

function make(): Bag uses alloc {
  return Bag { items: [1, 2] }
}

export function run(_args: Array<string>): int uses io, alloc {
  let bag = make()
  const snapshot = copy(bag.items)
  bag.items = []
  let list = snapshot
  Arrays.push(mutable list, 3)
  print(Int.toString(Arrays.length(list) + Arrays.length(bag.items)))
  return 0
}
