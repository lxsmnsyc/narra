import * as Arrays from "std/array"
import * as Int from "std/int"

export function run(args: Array<string>): int uses io, alloc {
  let prices = [100, 200]
  let saved = copy(prices)
  prices = [7]
  Arrays.push(mutable saved, 5)
  print(Int.toString(Arrays.length(prices)))
  print(Int.toString(prices[0]))
  print(Int.toString(Arrays.length(saved)))
  print(Int.toString(saved[2]))
  return 0
}
