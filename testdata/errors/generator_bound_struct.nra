// error: generator_bound_struct.nra:26:31: Function `quiet` uses `io` (through `Generator<int> uses (alloc, io)`) but its signature does not declare it; write `uses io`
export function* noisy(): Generator<int> uses io {
  print("hi")
  yield 1
}

export function* mapG<effect E>(g: Generator<int> uses E): Generator<int> uses (E, alloc) {
  yield* g
}

function id<T>(value: T): T from value {
  return value
}

function _count(_numbers: Generator<int> uses alloc): int {
  return 0
}

struct Wrap<T> {
  value: T
}

export function quiet(): int uses alloc {
  const wrapped = Wrap { value: mapG(noisy()) }
  let total = 0
  for (const n of id(wrapped).value) {
    total = total + n
  }
  return total
}

export function run(args: Array<string>): int {
  return quiet()
}
