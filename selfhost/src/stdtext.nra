et multiline = parser.multiline\n  let dotAll = parser.dotAll\n  while (true) {\n    const byte = peekByte(parser, parser.position)\n    if (byte == 105) {\n      ignoreCase = turnOn\n    } else if (byte == 109) {\n      multiline = turnOn\n    } else if (byte == 115) {\n      dotAll = turnOn\n    } else if (byte == 45 && turnOn) {\n      turnOn = false\n      seen = false\n    } else {\n      break\n    }\n    if (byte != 45) {\n      seen = true\n    }\n    parser.position += 1\n  }\n  const end = peekByte(parser, parser.position)\n  if (!seen || (end != 41 && end != 58)) {\n    if (peekByte(parser, open + 2) == 80 || peekByte(parser, open + 2) == 39) {\n      fail(mutable parser, open, \"bad group\")\n    } else {\n      fail(mutable parser, open, \"bad group: expected a flag (i, m or s), `:`, `<name>`\")\n    }\n    return addEmpty(mutable parser)\n  }\n  parser.position += 1\n  if (end == 41) {\n    parser.ignoreCase = ignoreCase\n    parser.multiline = multiline\n    parser.dotAll = dotAll\n    return -1\n  }\n  const outerIgnoreCase = parser.ignoreCase\n  const outerMultiline = parser.multiline\n  const outerDotAll = parser.dotAll\n  parser.ignoreCase = ignoreCase\n  parser.multiline = multiline\n  parser.dotAll = dotAll\n  const body = parseGroupBody(mutable parser, open, 0)\n  parser.ignoreCase = outerIgnoreCase\n  parser.multiline = outerMultiline\n  parser.dotAll = outerDotAll\n  return body\n}\n\n// An escape outside a class.\nfunction parseEscape(mutable parser: Parser): int uses alloc {\n  const start = parser.position\n  const byte = peekByte(parser, start + 1)\n  if (byte == 98 || byte == 66) {\n    parser.position += 2\n    if (byte == 98) {\n      return addNode(mutable parser, Kind.Assertion, WORD_BOUNDARY, 0, [], [])\n    }\n    return addNode(mutable parser, Kind.Assertion, NOT_WORD_BOUNDARY, 0, [], [])\n  }\n  const set = readSetEscape(byte)\n  if (Arrays.length(set) > 0) {\n    parser.position += 2\n    return addSet(mutable parser, set, false)\n  }\n  const code = readEscapeCode(mutable parser, false)\n  if (parser.failed) {\n    return addEmpty(mutable parser)\n  }\n  return addLiteral(mutable parser, code)\n}\n\n// The ranges of `\\d`, `\\D`, `\\w`, `\\W`, `\\s` or `\\S` for the letter after the\n// backslash, or [] for any other.\nfunction readSetEscape(byte: int): Array<int> uses alloc {\n  if (byte == 100) {\n    return [48, 57]\n  }\n  if (byte == 68) {\n    return complement([48, 57])\n  }\n  if (byte == 119) {\n    return wordRanges()\n  }\n  if (byte == 87) {\n    return complement(wordRanges())\n  }\n  if (byte == 115) {\n    return spaceRanges()\n  }\n  if (byte == 83) {\n    return complement(spaceRanges())\n  }\n  return []\n}\n\nfunction wordRanges(): Array<int> uses alloc {\n  return [48, 57, 65, 90, 95, 95, 97, 122]\n}\n\n// White space and line terminators, as JavaScript's `\\s`.\nfunction spaceRanges(): Array<int> uses alloc {\n  return [\n    9,\n    13,\n    32,\n    32,\n    160,\n    160,\n    5760,\n    5760,\n    8192,\n    8202,\n    8232,\n    8233,\n    8239,\n    8239,\n    8287,\n    8287,\n    12288,\n    12288,\n    65279,\n    65279,\n  ]\n}\n\n// Reads one escape that stands for a code point, at the backslash, and moves\n// past it. inClass makes `\\b` a backspace and `\\-` a hyphen.\nfunction readEscapeCode(mutable parser: Parser, inClass: bool): int uses alloc {\n  const start = parser.position\n  const byte = peekByte(parser, start + 1)\n  if (byte < 0) {\n    fail(mutable parser, start, \"the pattern ends with a backslash\")\n    return 0\n  }\n  parser.position += 2\n  if (byte >= 49 && byte <= 57) {\n    fail(mutable parser, start, \"back references are not supported: the engine is linear-time\")\n    return 0\n  }\n  if (byte == 107) {\n    fail(mutable parser, start, \"back references are not supported: the engine is linear-time\")\n    return 0\n  }\n  if (byte == 48) {\n    return 0\n  }\n  if (byte == 110) {\n    return 10\n  }\n  if (byte == 114) {\n    return 13\n  }\n  if (byte == 116) {\n    return 9\n  }\n  if (byte == 118) {\n    return 11\n  }\n  if (byte == 102) {\n    return 12\n  }\n  if (byte == 98 && inClass) {\n    return 8\n  }\n  if (byte == 99) {\n    const letter = peekByte(parser, parser.position)\n    if ((letter >= 65 && letter <= 90) || (letter >= 97 && letter <= 122)) {\n      parser.position += 1\n      return letter % 32\n    }\n    fail(mutable parser, start, \"\\\\c must be followed by a letter\")\n    return 0\n  }\n  if (byte == 120) {\n    const value = readHex(parser, parser.position, 2)\n    if (value < 0) {\n      fail(mutable parser, start, \"\\\\x must be followed by two hex digits\")\n      return 0\n    }\n    parser.position += 2\n    return value\n  }\n  if (byte == 117) {\n    return readUnicodeEscape(mutable parser, start)\n  }\n  if (byte == 112 || byte == 80) {\n    fail(mutable parser, start, \"Unicode property escapes are not supported\")\n    return 0\n  }\n  // Any other ASCII letter or digit is an unknown escape; punctuation and\n  // non-ASCII characters stand for themselves.\n  if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)) {\n    const letter = cut(parser.pattern, start + 1, start + 2)\n    fail(mutable parser, start, `unknown escape \\\\\${letter}`)\n    return 0\n  }\n  parser.position = start + 1\n  const code = readCode(parser.pattern, parser.position)\n  parser.position += readWidth(parser.pattern, parser.position)\n  return code\n}\n\n// `\\uHHHH` or `\\u{H...}`, with parser.position just past the `u`.\nfunction readUnicodeEscape(mutable parser: Parser, start: int): int {\n  if (peekByte(parser, parser.position) == 123) {\n    let index = parser.position + 1\n    let value = 0\n    while (index < parser.length && peekByte(parser, index) != 125) {\n      const digit = readHex(parser, index, 1)\n      if (digit < 0) {\n        fail(mutable parser, start, \"bad \\\\u{...} escape\")\n        return 0\n      }\n      value = value * 16 + digit\n      if (value > MAX_CODE) {\n        fail(mutable parser, start, \"\\\\u{...} escape above 10FFFF\")\n        return 0\n      }\n      index += 1\n    }\n    if (index >= parser.length || index == parser.position + 1) {\n      fail(mutable parser, start, \"bad \\\\u{...} escape\")\n      return 0\n    }\n    parser.position = index + 1\n    return value\n  }\n  const value = readHex(parser, parser.position, 4)\n  if (value < 0) {\n    fail(mutable parser, start, \"\\\\u must be followed by four hex digits or {...}\")\n    return 0\n  }\n  parser.position += 4\n  // A high surrogate escape followed by a low one is one code point, as the\n  // pair would be in a JavaScript string.\n  if (value >= 55296 && value <= 56319 && peekByte(parser, parser.position) == 92) {\n    if (peekByte(parser, parser.position + 1) == 117) {\n      const low = readHex(parser, parser.position + 2, 4)\n      if (low >= 56320 && low <= 57343) {\n        parser.position += 6\n        return 65536 + (value - 55296) * 1024 + (low - 56320)\n      }\n    }\n  }\n  return value\n}\n\n// The value of count hex digits at position, or -1.\nfunction readHex(parser: Parser, position: int, count: int): int {\n  let value = 0\n  for (let i = 0; i < count; i += 1) {\n    const byte = peekByte(parser, position + i)\n    let digit = -1\n    if (byte >= 48 && byte <= 57) {\n      digit = byte - 48\n    } else if (byte >= 97 && byte <= 102) {\n      digit = byte - 87\n    } else if (byte >= 65 && byte <= 70) {\n      digit = byte - 55\n    }\n    if (digit < 0) {\n      return -1\n    }\n    value = value * 16 + digit\n  }\n  return value\n}\n\n// A class `[...]` or `[^...]`.\nfunction parseClass(mutable parser: Parser): int uses alloc {\n  const open = parser.position\n  parser.position += 1\n  let negated = false\n  if (peekByte(parser, parser.position) == 94) {\n    negated = true\n    parser.position += 1\n  }\n  let ranges: Array<int> = []\n  while (!parser.failed) {\n    const byte = peekByte(parser, parser.position)\n    if (byte < 0) {\n      fail(mutable parser, open, \"unclosed class\")\n      return addEmpty(mutable parser)\n    }\n    if (byte == 93) {\n      parser.position += 1\n      break\n    }\n    const itemStart = parser.position\n    // A set escape adds its ranges and cannot start a range.\n    if (byte == 92) {\n      const set = readSetEscape(peekByte(parser, parser.position + 1))\n      if (Arrays.length(set) > 0) {\n        parser.position += 2\n        for (const bound of set) {\n          Arrays.push(mutable ranges, bound)\n        }\n        if (isRangeDash(parser)) {\n          fail(mutable parser, itemStart, \"bad class range\")\n        }\n        continue\n      }\n    }\n    const low = readClassCode(mutable parser)\n    if (!isRangeDash(parser)) {\n      Arrays.push(mutable ranges, low)\n      Arrays.push(mutable ranges, low)\n      continue\n    }\n    parser.position += 1\n    if (\n      peekByte(parser, parser.position) == 92 &&\n        Arrays.length(readSetEscape(peekByte(parser, parser.position + 1))) > 0\n    ) {\n      fail(mutable parser, itemStart, \"bad class range\")\n      continue\n    }\n    const high = readClassCode(mutable parser)\n    if (high < low) {\n      fail(mutable parser, itemStart, \"bad class range\")\n      continue\n    }\n    Arrays.push(mutable ranges, low)\n    Arrays.push(mutable ranges, high)\n  }\n  if (parser.failed) {\n    return addEmpty(mutable parser)\n  }\n  return addSet(mutable parser, ranges, negated)\n}\n\n// A `-` that makes a range: not the last character of the class.\nfunction isRangeDash(parser: Parser): bool {\n  const after = peekByte(parser, parser.position + 1)\n  return peekByte(parser, parser.position) == 45 && after != 93 && after >= 0\n}\n\nfunction readClassCode(mutable parser: Parser): int uses alloc {\n  if (peekByte(parser, parser.position) == 92) {\n    return readEscapeCode(mutable parser, true)\n  }\n  const code = readCode(parser.pattern, parser.position)\n  parser.position += readWidth(parser.pattern, parser.position)\n  return code\n}\n\n// Adds a Set node: the ranges sorted and merged, with the other case of each\n// ASCII letter under (?i), then complemented when negated.\nfunction addSet(mutable parser: Parser, ranges: Array<int>, negated: bool): int uses alloc {\n  let all = normalize(ranges)\n  if (parser.ignoreCase) {\n    all = normalize(addOtherCases(all))\n  }\n  if (negated) {\n    all = complement(all)\n  }\n  return addNode(mutable parser, Kind.Set, 0, 0, [], all)\n}\n\n// Adds the other case of the ASCII letters in sorted, merged ranges.\nfunction addOtherCases(ranges: Array<int>): Array<int> uses alloc {\n  let result = copy(ranges)\n  for (let index = 0; index < Arrays.length(ranges); index += 2) {\n    const low = ranges[index]\n    const high = ranges[index + 1]\n    // The upper case letters in the range, then the lower case ones.\n    const upperLow = larger(low, 65)\n    const upperHigh = smaller(high, 90)\n    if (upperLow <= upperHigh) {\n      Arrays.push(mutable result, upperLow + 32)\n      Arrays.push(mutable result, upperHigh + 32)\n    }\n    const lowerLow = larger(low, 97)\n    const lowerHigh = smaller(high, 122)\n    if (lowerLow <= lowerHigh) {\n      Arrays.push(mutable result, lowerLow - 32)\n      Arrays.push(mutable result, lowerHigh - 32)\n    }\n  }\n  return result\n}\n\nfunction larger(first: int, second: int): int {\n  if (first > second) {\n    return first\n  }\n  return second\n}\n\nfunction smaller(first: int, second: int): int {\n  if (first < second) {\n    return first\n  }\n  return second\n}\n\n// Sorts pairs of low and high by low and merges the ones that touch.\nfunction normalize(ranges: Array<int>): Array<int> uses alloc {\n  let sorted = copy(ranges)\n  const count = Arrays.length(sorted) / 2\n  // Insertion sort: classes are short.\n  for (let i = 1; i < count; i += 1) {\n    const low = sorted[i * 2]\n    const high = sorted[i * 2 + 1]\n    let j = i - 1\n    while (j >= 0 && sorted[j * 2] > low) {\n      sorted[j * 2 + 2] = sorted[j * 2]\n      sorted[j * 2 + 3] = sorted[j * 2 + 1]\n      j -= 1\n    }\n    sorted[j * 2 + 2] = low\n    sorted[j * 2 + 3] = high\n  }\n  let merged: Array<int> = []\n  for (let i = 0; i < count; i += 1) {\n    const low = sorted[i * 2]\n    const high = sorted[i * 2 + 1]\n    const last = Arrays.length(merged) - 1\n    if (last > 0 && low <= merged[last] + 1) {\n      if (high > merged[last]) {\n        merged[last] = high\n      }\n    } else {\n      Arrays.push(mutable merged, low)\n      Arrays.push(mutable merged, high)\n    }\n  }\n  return merged\n}\n\n// The code points not in sorted, merged ranges.\nfunction complement(ranges: Array<int>): Array<int> uses alloc {\n  let result: Array<int> = []\n  let next = 0\n  for (let index = 0; index < Arrays.length(ranges); index += 2) {\n    if (ranges[index] > next) {\n      Arrays.push(mutable result, next)\n      Arrays.push(mutable result, ranges[index] - 1)\n    }\n    next = ranges[index + 1] + 1\n  }\n  if (next <= MAX_CODE) {\n    Arrays.push(mutable result, next)\n    Arrays.push(mutable result, MAX_CODE)\n  }\n  return result\n}\n\n// The literal text every match starts with: the leading literals of the\n// pattern that do not fold case.\nfunction findPrefix(nodes: Array<Node>, root: int): string uses alloc {\n  let builder = Str.builder()\n  let items = [root]\n  if (nodes[root].kind == Kind.Concat) {\n    items = nodes[root].children\n  }\n  for (const item of items) {\n    const node = nodes[item]\n    if (node.kind != Kind.Literal || node.limit >= 0) {\n      break\n    }\n    if (Char.fromCode(node.value) is Some(character)) {\n      Str.appendChar(mutable builder, character)\n    } else {\n      break\n    }\n  }\n  return Str.build(builder)\n}\n\nfunction startsAnchored(nodes: Array<Node>, root: int): bool {\n  let first = root\n  if (nodes[root].kind == Kind.Concat) {\n    first = nodes[root].children[0]\n  }\n  return nodes[first].kind == Kind.Assertion && nodes[first].value == TEXT_START\n}\n\n// The program compiler.\n\nfunction emit(mutable program: Program, op: Op, first: int, second: int): int uses alloc {\n  const index = Arrays.length(program.ops)\n  if (index >= MAX_PROGRAM) {\n    program.tooLarge = true\n    return index\n  }\n  Arrays.push(mutable program.ops, op)\n  Arrays.push(mutable program.firsts, first)\n  Arrays.push(mutable program.seconds, second)\n  return index\n}\n\nfunction patchFirst(mutable program: Program, index: int, target: int) {\n  if (index < Arrays.length(program.firsts)) {\n    program.firsts[index] = target\n  }\n}\n\nfunction patchSecond(mutable program: Program, index: int, target: int) {\n  if (index < Arrays.length(program.seconds)) {\n    program.seconds[index] = target\n  }\n}\n\nfunction compileNode(mutable program: Program, nodes: Array<Node>, index: int) uses alloc {\n  if (program.tooLarge) {\n    return\n  }\n  const node = nodes[index]\n  match (node.kind) {\n    Kind.Empty => {}\n    Kind.Literal => {\n      emit(mutable program, Op.Char, node.value, node.limit)\n    }\n    Kind.AnyChar => {\n      emit(mutable program, Op.Any, node.value, 0)\n    }\n    Kind.Set => {\n      const start = Arrays.length(program.ranges)\n      for (const bound of node.ranges) {\n        Arrays.push(mutable program.ranges, bound)\n      }\n      const end = Arrays.length(program.ranges)\n      emit(mutable program, Op.Class, start, end)\n    }\n    Kind.Assertion => {\n      emit(mutable program, Op.Assert, node.value, 0)\n    }\n    Kind.Group => {\n      emit(mutable program, Op.Save, node.value * 2, 0)\n      compileNode(mutable program, nodes, node.children[0])\n      emit(mutable program, Op.Save, node.value * 2 + 1, 0)\n    }\n    Kind.Concat => {\n      for (const child of node.children) {\n        compileNode(mutable program, nodes, child)\n      }\n    }\n    Kind.Alternate => {\n      compileAlternate(mutable program, nodes, node.children)\n    }\n    Kind.Repeat => {\n      compileRepeat(mutable program, nodes, index, node)\n    }\n  }\n}\n\n// a|b|c: split to each choice in order, each ending in a jump past the rest.\nfunction compileAlternate(\n  mutable program: Program,\n  nodes: Array<Node>,\n  children: Array<int>,\n) uses alloc {\n  let jumps: Array<int> = []\n  const last = Arrays.length(children) - 1\n  for (let i = 0; i < last; i += 1) {\n    const choice = Arrays.length(program.ops) + 1\n    const split = emit(mutable program, Op.Split, choice, 0)\n    compileNode(mutable program, nodes, children[i])\n    const jump = emit(mutable program, Op.Jump, 0, 0)\n    Arrays.push(mutable jumps, jump)\n    const following = Arrays.length(program.ops)\n    patchSecond(mutable program, split, following)\n  }\n  compileNode(mutable program, nodes, children[last])\n  const end = Arrays.length(program.ops)\n  for (const jump of jumps) {\n    patchFirst(mutable program, jump, end)\n  }\n}\n\n// A repeat writes one pass of its body per required count, then a loop for\n// no upper count, or one optional pass per count above the lower one. Each\n// pass clears the groups inside it, and a pass beyond the lower count fails\n// when it matches empty, as in JavaScript.\nfunction compileRepeat(\n  mutable program: Program,\n  nodes: Array<Node>,\n  index: int,\n  node: Node,\n) uses alloc {\n  for (let i = 0; i < node.value && !program.tooLarge; i += 1) {\n    compilePass(mutable program, nodes, node)\n  }\n  if (node.value == node.limit) {\n    return\n  }\n  if (program.loopSlots[index] < 0) {\n    program.loopSlots[index] = program.slotCount\n    program.slotCount += 1\n  }\n  const slot = program.loopSlots[index]\n  if (node.limit < 0) {\n    const split = emit(mutable program, Op.Split, 0, 0)\n    compileCheckedPass(mutable program, nodes, node, slot)\n    emit(mutable program, Op.Jump, split, 0)\n    patchSplit(mutable program, split, node.greedy)\n    return\n  }\n  let splits: Array<int> = []\n  for (let i = node.value; i < node.limit && !program.tooLarge; i += 1) {\n    const split = emit(mutable program, Op.Split, 0, 0)\n    Arrays.push(mutable splits, split)\n    compileCheckedPass(mutable program, nodes, node, slot)\n  }\n  for (const split of splits) {\n    patchSplit(mutable program, split, node.greedy)\n  }\n}\n\n// Points a split at the next instruction and at the end of the program so\n// far, the next one first when greedy.\nfunction patchSplit(mutable program: Program, split: int, greedy: bool) {\n  const end = Arrays.length(program.ops)\n  if (greedy) {\n    patchFirst(mutable program, split, split + 1)\n    patchSecond(mutable program, split, end)\n  } else {\n    patchFirst(mutable program, split, end)\n    patchSecond(mutable program, split, split + 1)\n  }\n}\n\nfunction compilePass(mutable program: Program, nodes: Array<Node>, node: Node) uses alloc {\n  if (node.groupEnd > node.groupStart) {\n    emit(mutable program, Op.Reset, (node.groupStart + 1) * 2, (node.groupEnd + 1) * 2)\n  }\n  compileNode(mutable program, nodes, node.children[0])\n}\n\nfunction compileCheckedPass(\n  mutable program: Program,\n  nodes: Array<Node>,\n  node: Node,\n  slot: int,\n) uses alloc {\n  emit(mutable program, Op.Save, slot, 0)\n  compilePass(mutable program, nodes, node)\n  emit(mutable program, Op.Progress, slot, 0)\n}\n\n// Text decoding. The text is valid UTF-8, so the first byte gives the width.\n\nfunction readWidth(text: string, position: int): int {\n  const byte = Str.byteAt(text, position)\n  if (byte < 128) {\n    return 1\n  }\n  if (byte < 224) {\n    return 2\n  }\n  if (byte < 240) {\n    return 3\n  }\n  return 4\n}\n\nfunction readCode(text: string, position: int): int {\n  const byte = Str.byteAt(text, position)\n  if (byte < 128) {\n    return byte\n  }\n  if (byte < 224) {\n    return (byte % 32) * 64 + Str.byteAt(text, position + 1) % 64\n  }\n  if (byte < 240) {\n    return ((byte % 16) * 64 + Str.byteAt(text, position + 1) % 64) * 64 +\n      Str.byteAt(text, position + 2) % 64\n  }\n  const high = (byte % 8) * 64 + Str.byteAt(text, position + 1) % 64\n  return (high * 64 + Str.byteAt(text, position + 2) % 64) * 64 +\n    Str.byteAt(text, position + 3) % 64\n}\n\n// The code point at position, or -1 at the end of the text.\nfunction codeAt(text: string, position: int): int {\n  if (position >= Str.length(text)) {\n    return -1\n  }\n  return readCode(text, position)\n}\n\n// The code point that ends just before position, or -1 at the start.\nfunction codeBefore(text: string, position: int): int {\n  if (position <= 0) {\n    return -1\n  }\n  let start = position - 1\n  while (start > 0 && Str.byteAt(text, start) >= 128 && Str.byteAt(text, start) < 192) {\n    start -= 1\n  }\n  return readCode(text, start)\n}\n\nfunction isLineTerminator(code: int): bool {\n  return code == 10 || code == 13 || code == 8232 || code == 8233\n}\n\nfunction isWordCode(code: int): bool {\n  return (code >= 48 && code <= 57) ||\n    (code >= 65 && code <= 90) ||\n    code == 95 ||\n    (code >= 97 && code <= 122)\n}\n\n// The Pike VM.\n\nfunction createMachine(regex: Regex): Machine uses alloc {\n  const size = Arrays.length(regex.ops)\n  const slots = regex.slotCount\n  return Machine {\n    size: size,\n    slots: slots,\n    pcs: filledInts(0, size * 2),\n    captures: filledInts(-1, size * slots * 2),\n    counts: [0, 0],\n    marks: filledInts(0, size * 2),\n    generations: [0, 0],\n    generation: 0,\n    side: 0,\n    stackPcs: [],\n    stackSlots: [],\n    stackValues: [],\n    stackTop: 0,\n    working: filledInts(-1, slots),\n    best: filledInts(-1, slots),\n  }\n}\n\nfunction filledInts(value: int, count: int): Array<int> uses alloc {\n  if (Arrays.filled(value, count) is Some(items)) {\n    return items\n  }\n  return []\n}\n\n// Empties a thread list for the next step.\nfunction resetList(mutable machine: Machine, list: int) {\n  machine.generation += 1\n  machine.generations[list] = machine.generation\n  machine.counts[list] = 0\n}\n\n// Pushes a job on the stack of addThread: a program counter to follow, or\n// with a slot of 0 or more, a value to put back in that slot.\nfunction pushJob(mutable machine: Machine, pc: int, slot: int, value: int) uses alloc {\n  const top = machine.stackTop\n  if (top < Arrays.length(machine.stackPcs)) {\n    machine.stackPcs[top] = pc\n    machine.stackSlots[top] = slot\n    machine.stackValues[top] = value\n  } else {\n    Arrays.push(mutable machine.stackPcs, pc)\n    Arrays.push(mutable machine.stackSlots, slot)\n    Arrays.push(mutable machine.stackValues, value)\n  }\n  machine.stackTop = top + 1\n}\n\n// Follows the program from pc through splits, jumps, saves and assertions,\n// and adds a thread to the list at each instruction that reads a character\n// or matches, in priority order. The captures come from machine.working.\n// before and after are the code points around position (-1 at an edge).\nfunction addThread(\n  regex: Regex,\n  mutable machine: Machine,\n  list: int,\n  startPc: int,\n  position: int,\n  length: int,\n  before: int,\n  after: int,\n) {\n  const markBase = list * machine.size\n  const generation = machine.generations[list]\n  pushJob(mutable machine, startPc, -1, 0)\n  while (machine.stackTop > 0) {\n    machine.stackTop -= 1\n    const top = machine.stackTop\n    const slot = machine.stackSlots[top]\n    if (slot >= 0) {\n      // Undo a save once the threads after it are added.\n      machine.working[slot] = machine.stackValues[top]\n      continue\n    }\n    let pc = machine.stackPcs[top]\n    while (machine.marks[markBase + pc] != generation) {\n      machine.marks[markBase + pc] = generation\n      const op = regex.ops[pc]\n      if (op == Op.Jump) {\n        pc = regex.firsts[pc]\n      } else if (op == Op.Split) {\n        pushJob(mutable machine, regex.seconds[pc], -1, 0)\n        pc = regex.firsts[pc]\n      } else if (op == Op.Save) {\n        const saved = regex.firsts[pc]\n        const previous = machine.working[saved]\n        pushJob(mutable machine, 0, saved, previous)\n        machine.working[saved] = position\n        pc += 1\n      } else if (op == Op.Reset) {\n        for (let cleared = regex.firsts[pc]; cleared < regex.seconds[pc]; cleared += 1) {\n          const previous = machine.working[cleared]\n          pushJob(mutable machine, 0, cleared, previous)\n          machine.working[cleared] = -1\n        }\n        pc += 1\n      } else if (op == Op.Progress) {\n        if (machine.working[regex.firsts[pc]] == position) {\n          break\n        }\n        pc += 1\n      } else if (op == Op.Assert) {\n        if (!assertionHolds(regex.firsts[pc], position, length, before, after)) {\n          break\n        }\n        pc += 1\n      } else {\n        const count = machine.counts[list]\n        machine.pcs[markBase + count] = pc\n        const captureBase = (markBase + count) * machine.slots\n        for (let i = 0; i < machine.slots; i += 1) {\n          machine.captures[captureBase + i] = machine.working[i]\n        }\n        machine.counts[list] = count + 1\n        break\n      }\n    }\n  }\n}\n\nfunction assertionHolds(kind: int, position: int, length: int, before: int, after: int): bool {\n  if (kind == TEXT_START) {\n    return position == 0\n  }\n  if (kind == TEXT_END) {\n    return position == length\n  }\n  if (kind == LINE_START) {\n    return before < 0 || isLineTerminator(before)\n  }\n  if (kind == LINE_END) {\n    return after < 0 || isLineTerminator(after)\n  }\n  const boundary = isWordCode(before) != isWordCode(after)\n  if (kind == WORD_BOUNDARY) {\n    return boundary\n  }\n  return !boundary\n}\n\nfunction classHolds(regex: Regex, start: int, end: int, code: int): bool {\n  // Binary search over the pairs of low and high.\n  let low = 0\n  let high = (end - start) / 2\n  while (low < high) {\n    const middle = (low + high) / 2\n    const pair = start + middle * 2\n    if (code < regex.ranges[pair]) {\n      high = middle\n    } else if (code > regex.ranges[pair + 1]) {\n      low = middle + 1\n    } else {\n      return true\n    }\n  }\n  return false\n}\n\nfunction stepHolds(regex: Regex, pc: int, code: int): bool {\n  if (code < 0) {\n    return false\n  }\n  const op = regex.ops[pc]\n  if (op == Op.Char) {\n    return code == regex.firsts[pc] || code == regex.seconds[pc]\n  }\n  if (op == Op.Any) {\n    return regex.firsts[pc] == 1 || !isLineTerminator(code)\n  }\n  if (op == Op.Class) {\n    return classHolds(regex, regex.firsts[pc], regex.seconds[pc], code)\n  }\n  return false\n}\n\n// The first offset at or after position where the prefix starts, or -1.\nfunction findText(text: string, prefix: string, position: int): int {\n  const length = Str.length(text)\n  const prefixLength = Str.length(prefix)\n  const first = Str.byteAt(prefix, 0)\n  let index = position\n  while (index + prefixLength <= length) {\n    if (Str.byteAt(text, index) == first) {\n      let same = true\n      for (let i = 1; i < prefixLength && same; i += 1) {\n        same = Str.byteAt(text, index + i) == Str.byteAt(prefix, i)\n      }\n      if (same) {\n        return index\n      }\n    }\n    index += 1\n  }\n  return -1\n}\n\n// Runs the machine from start, moved to a character boundary. On a match,\n// machine.best holds its capture slots.\nfunction search(regex: Regex, mutable machine: Machine, text: string, start: int): bool {\n  const length = Str.length(text)\n  let position = start\n  while (\n    position < length && Str.byteAt(text, position) >= 128 && Str.byteAt(text, position) < 192\n  ) {\n    position += 1\n  }\n  if (position > length) {\n    return false\n  }\n  const usePrefix = Str.length(regex.prefix) > 0\n  let matched = false\n  let before = codeBefore(text, position)\n  let code = codeAt(text, position)\n  machine.side = 0\n  resetList(mutable machine, 0)\n  while (true) {\n    const current = machine.side\n    const next = 1 - current\n    if (!matched) {\n      if (machine.counts[current] == 0) {\n        if (regex.anchored && position > 0) {\n          break\n        }\n        if (usePrefix) {\n          const found = findText(text, regex.prefix, position)\n          if (found < 0) {\n            break\n          }\n          if (found > position) {\n            position = found\n            before = codeBefore(text, position)\n            code = codeAt(text, position)\n          }\n        }\n      }\n      for (let i = 0; i < machine.slots; i += 1) {\n        machine.working[i] = -1\n      }\n      addThread(regex, mutable machine, current, 0, position, length, before, code)\n    }\n    // With no thread left, the search ends once a match is found; before\n    // that, the next position gets a new thread.\n    const count = machine.counts[current]\n    if (count == 0 && matched) {\n      break\n    }\n    let width = 0\n    if (code >= 0) {\n      width = readWidth(text, position)\n    }\n    const after = codeAt(text, position + width)\n    resetList(mutable machine, next)\n    const listBase = current * machine.size\n    for (let index = 0; index < count; index += 1) {\n      const pc = machine.pcs[listBase + index]\n      const captureBase = (listBase + index) * machine.slots\n      if (regex.ops[pc] == Op.Match) {\n        // Threads after this one have lower priority: drop them.\n        for (let i = 0; i < machine.slots; i += 1) {\n          machine.best[i] = machine.captures[captureBase + i]\n        }\n        matched = true\n        break\n      }\n      if (stepHolds(regex, pc, code)) {\n        for (let i = 0; i < machine.slots; i += 1) {\n          machine.working[i] = machine.captures[captureBase + i]\n        }\n        addThread(regex, mutable machine, next, pc + 1, position + width, length, code, after)\n      }\n    }\n    if (code < 0) {\n      break\n    }\n    machine.side = next\n    position += width\n    before = code\n    code = after\n  }\n  return matched\n}\n"

const STD_SHAPE = "// std/shape: Value, a dynamic tree for structured data, and the Shape trait.\n//\n// Formats such as std/json read and write Value. Int and Float are separate\n// because a 64-bit integer must survive a round trip, which an f64 cannot hold.\n// Record keeps its fields in insertion order.\n//\n// Shape converts a type to and from Value. The compiler provides it for bool,\n// int, f64, char, string, Array<T>, Map<string, V>, Option<T> and tuples of two\n// to four items, when their contents implement it: a call of Shape.toValue or\n// Shape.fromValue on such a type runs the matching private function\n// below. Value, a struct and an enum implement it with an `implement` block.\n//\n// A decode error reads `<path>: <reason>` with the path from the root\n// (`.users[2].age: expected int, found Text`); at the root it is the reason alone.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Float from \"std/float\"\nimport * as Arrays from \"std/array\"\nimport * as Maps from \"std/map\"\n\nexport enum Value implements Shape {\n  Null\n  Bool(value: bool)\n  Int(value: int)\n  Float(value: f64)\n  Text(value: string)\n  List(items: Array<Value>)\n  Record(fields: Map<string, Value>)\n}\n\nexport trait Shape {\n  function toValue(value: Self): Value from value uses alloc\n  function fromValue(value: Value): Result<Self, string> from value uses alloc\n}\n\nimplement Shape for Value {\n  function toValue(value: Value): Value from value uses alloc {\n    return value\n  }\n\n  function fromValue(value: Value): Result<Value, string> from value uses alloc {\n    return Ok(value)\n  }\n}\n\n// The name of a Value variant, for error messages.\nfunction kindName(value: Value): string {\n  return match (value) {\n    Value.Null => \"Null\"\n    Value.Bool(_) => \"Bool\"\n    Value.Int(_) => \"Int\"\n    Value.Float(_) => \"Float\"\n    Value.Text(_) => \"Text\"\n    Value.List(_) => \"List\"\n    Value.Record(_) => \"Record\"\n  }\n}\n\nfunction mismatch(expected: string, value: Value): string uses alloc {\n  return `expected \${expected}, found \${kindName(value)}`\n}\n\n// prefixPath puts a path segment (`.name` or `[2]`) in front of a child error.\n// A child error that already starts with a path keeps it after the segment.\nfunction prefixPath(segment: string, message: string): string uses alloc {\n  if (Str.startsWith(message, \".\") || Str.startsWith(message, \"[\")) {\n    return `\${segment}\${message}`\n  }\n  return `\${segment}: \${message}`\n}\n\nfunction boolToValue(value: bool): Value {\n  return Value.Bool(value)\n}\n\nfunction boolFromValue(value: Value): Result<bool, string> uses alloc {\n  if (value is Value.Bool(flag)) {\n    return Ok(flag)\n  }\n  return Err(mismatch(\"bool\", value))\n}\n\nfunction intToValue(value: int): Value {\n  return Value.Int(value)\n}\n\nfunction intFromValue(value: Value): Result<int, string> uses alloc {\n  if (value is Value.Int(number)) {\n    return Ok(number)\n  }\n  return Err(mismatch(\"int\", value))\n}\n\nfunction floatToValue(value: f64): Value {\n  return Value.Float(value)\n}\n\nfunction floatFromValue(value: Value): Result<f64, string> uses alloc {\n  if (value is Value.Float(number)) {\n    return Ok(number)\n  }\n  if (value is Value.Int(whole)) {\n    return Ok(Float.fromInt(whole))\n  }\n  return Err(mismatch(\"f64\", value))\n}\n\nfunction charToValue(value: char): Value uses alloc {\n  return Value.Text(Str.fromChar(value))\n}\n\nfunction charFromValue(value: Value): Result<char, string> uses alloc {\n  if (value is Value.Text(text)) {\n    if (Str.charCount(text) == 1) {\n      return Ok(Str.charAt(text, 0))\n    }\n    return Err(\"expected one character, found Text of a different length\")\n  }\n  return Err(mismatch(\"char\", value))\n}\n\nfunction stringToValue(value: string): Value {\n  return Value.Text(value)\n}\n\nfunction stringFromValue(value: Value): Result<string, string> uses alloc {\n  if (value is Value.Text(text)) {\n    return Ok(text)\n  }\n  return Err(mismatch(\"string\", value))\n}\n\nfunction arrayToValue<T: Shape>(value: Array<T>): Value from value uses alloc {\n  let items: Array<Value> = []\n  for (const item of Arrays.values(value)) {\n    Arrays.push(mutable items, Shape.toValue(item))\n  }\n  return Value.List(items)\n}\n\nfunction arrayFromValue<T: Shape>(value: Value): Result<Array<T>, string> uses alloc {\n  if (value is Value.List(items)) {\n    let out: Array<T> = []\n    for (const #[index, item] of Arrays.entries(items)) {\n      const decoded = Shape.fromValue<T>(item)\n      if (decoded is Err(message)) {\n        return Err(prefixPath(`[\${Int.toString(index)}]`, message))\n      }\n      Arrays.push(mutable out, decoded.value)\n    }\n    return Ok(out)\n  }\n  return Err(mismatch(\"List\", value))\n}\n\nfunction mapToValue<V: Shape>(value: Map<string, V>): Value from value uses alloc {\n  let fields: Map<string, Value> = Map {}\n  for (const entry of Maps.entries(value)) {\n    const #[key, field] = entry\n    fields[key] = Shape.toValue(field)\n  }\n  return Value.Record(fields)\n}\n\nfunction mapFromValue<V: Shape>(value: Value): Result<Map<string, V>, string> uses alloc {\n  if (value is Value.Record(fields)) {\n    let out: Map<string, V> = Map {}\n    for (const entry of Maps.entries(fields)) {\n      const #[key, field] = entry\n      const decoded = Shape.fromValue<V>(field)\n      if (decoded is Err(message)) {\n        return Err(prefixPath(`.\${key}`, message))\n      }\n      out[key] = decoded.value\n    }\n    return Ok(out)\n  }\n  return Err(mismatch(\"Record\", value))\n}\n\nfunction optionToValue<T: Shape>(value: Option<T>): Value from value uses alloc {\n  if (value is Some(inner)) {\n    return Shape.toValue(inner)\n  }\n  return Value.Null\n}\n\nfunction optionFromValue<T: Shape>(value: Value): Result<Option<T>, string> from value uses alloc {\n  if (value is Value.Null) {\n    return Ok(None)\n  }\n  const decoded = Shape.fromValue<T>(value)\n  if (decoded is Err(message)) {\n    return Err(message)\n  }\n  return Ok(Some(decoded.value))\n}\n\n// A tuple is a List of exactly count items.\nfunction tupleItems(value: Value, count: int): Result<Array<Value>, string> from value uses alloc {\n  if (value is Value.List(items)) {\n    if (Arrays.length(items) != count) {\n      const found = Int.toString(Arrays.length(items))\n      return Err(`expected a List of \${Int.toString(count)} items, found \${found}`)\n    }\n    return Ok(items)\n  }\n  return Err(mismatch(\"List\", value))\n}\n\nfunction tuple2ToValue<A: Shape, B: Shape>(value: #[A, B]): Value from value uses alloc {\n  const #[first, second] = value\n  return Value.List([Shape.toValue(first), Shape.toValue(second)])\n}\n\nfunction tuple2FromValue<A: Shape, B: Shape>(value: Value): Result<#[\n  A,\n  B,\n], string> from value uses alloc {\n  const items = tupleItems(value, 2)\n  if (items is Err(problem)) {\n    return Err(problem)\n  }\n  const first = Shape.fromValue<A>(items.value[0])\n  if (first is Err(message)) {\n    return Err(prefixPath(\"[0]\", message))\n  }\n  const second = Shape.fromValue<B>(items.value[1])\n  if (second is Err(message)) {\n    return Err(prefixPath(\"[1]\", message))\n  }\n  return Ok(#[first.value, second.value])\n}\n\nfunction tuple3ToValue<A: Shape, B: Shape, C: Shape>(\n  value: #[A, B, C],\n): Value from value uses alloc {\n  const #[first, second, third] = value\n  return Value.List([Shape.toValue(first), Shape.toValue(second), Shape.toValue(third)])\n}\n\nfunction tuple3FromValue<A: Shape, B: Shape, C: Shape>(value: Value): Result<#[\n  A,\n  B,\n  C,\n], string> from value uses alloc {\n  const items = tupleItems(value, 3)\n  if (items is Err(problem)) {\n    return Err(problem)\n  }\n  const first = Shape.fromValue<A>(items.value[0])\n  if (first is Err(message)) {\n    return Err(prefixPath(\"[0]\", message))\n  }\n  const second = Shape.fromValue<B>(items.value[1])\n  if (second is Err(message)) {\n    return Err(prefixPath(\"[1]\", message))\n  }\n  const third = Shape.fromValue<C>(items.value[2])\n  if (third is Err(message)) {\n    return Err(prefixPath(\"[2]\", message))\n  }\n  return Ok(#[first.value, second.value, third.value])\n}\n\nfunction tuple4ToValue<A: Shape, B: Shape, C: Shape, D: Shape>(\n  value: #[A, B, C, D],\n): Value from value uses alloc {\n  const #[first, second, third, fourth] = value\n  return Value.List([\n    Shape.toValue(first),\n    Shape.toValue(second),\n    Shape.toValue(third),\n    Shape.toValue(fourth),\n  ])\n}\n\nfunction tuple4FromValue<A: Shape, B: Shape, C: Shape, D: Shape>(value: Value): Result<#[\n  A,\n  B,\n  C,\n  D,\n], string> from value uses alloc {\n  const items = tupleItems(value, 4)\n  if (items is Err(problem)) {\n    return Err(problem)\n  }\n  const first = Shape.fromValue<A>(items.value[0])\n  if (first is Err(message)) {\n    return Err(prefixPath(\"[0]\", message))\n  }\n  const second = Shape.fromValue<B>(items.value[1])\n  if (second is Err(message)) {\n    return Err(prefixPath(\"[1]\", message))\n  }\n  const third = Shape.fromValue<C>(items.value[2])\n  if (third is Err(message)) {\n    return Err(prefixPath(\"[2]\", message))\n  }\n  const fourth = Shape.fromValue<D>(items.value[3])\n  if (fourth is Err(message)) {\n    return Err(prefixPath(\"[3]\", message))\n  }\n  return Ok(#[first.value, second.value, third.value, fourth.value])\n}\n"

const STD_TERMINAL = "// std/terminal: detecting a terminal and styling text for it (D118 item 7).\n//\n// The style functions always add the codes and have no effect beyond `alloc`, so\n// tests can compare styled output. The caller decides whether to style:\n// `const color = Terminal.useColor(Stream.Stderr)`. A style closes with its own\n// reset code and reopens itself after an inner close, so a styled part inside\n// another styled part does not end the outer one.\n\nimport * as Tty from \"std/internal/terminal\"\nimport * as Env from \"std/env\"\nimport * as Int from \"std/int\"\nimport * as Str from \"std/string\"\n\nexport enum Stream {\n  Stdin\n  Stdout\n  Stderr\n}\n\nexport enum Color {\n  Black\n  Red\n  Green\n  Yellow\n  Blue\n  Magenta\n  Cyan\n  White\n  BrightBlack\n  BrightRed\n  BrightGreen\n  BrightYellow\n  BrightBlue\n  BrightMagenta\n  BrightCyan\n  BrightWhite\n  Ansi256(index: u8)\n  Rgb(red: u8, green: u8, blue: u8)\n}\n\nexport struct Style {\n  foreground: Option<Color> = None\n  background: Option<Color> = None\n  bold: bool = false\n  dim: bool = false\n  italic: bool = false\n  underline: bool = false\n  inverse: bool = false\n  strikethrough: bool = false\n}\n\nfunction streamDescriptor(stream: Stream): int {\n  return match (stream) { Stream.Stdin => 0, Stream.Stdout => 1, Stream.Stderr => 2 }\n}\n\nexport function isTerminal(stream: Stream): bool uses io {\n  return Tty.isTerminal(streamDescriptor(stream))\n}\n\nexport function columns(stream: Stream): Option<int> uses io {\n  const width = Tty.columns(streamDescriptor(stream))\n  if (width > 0) {\n    return Some(width)\n  }\n  return None\n}\n\nexport function useColor(stream: Stream): bool uses io, alloc {\n  // NO_COLOR wins, then FORCE_COLOR, then a dumb terminal, then the stream itself.\n  if (Env.get(\"NO_COLOR\") is Some(noColor)) {\n    if (noColor != \"\") {\n      return false\n    }\n  }\n  if (Env.get(\"FORCE_COLOR\") is Some(forceColor)) {\n    if (forceColor != \"\" && forceColor != \"0\") {\n      return true\n    }\n  }\n  if (Env.get(\"TERM\") is Some(term)) {\n    if (term == \"dumb\") {\n      return false\n    }\n  }\n  return isTerminal(stream)\n}\n\nconst ESCAPE = \"\\u{1b}[\"\n\nfunction sequence(code: string): string uses alloc {\n  return `\${ESCAPE}\${code}m`\n}\n\n// Wraps the text in an open and a close code. A close inside the text is replaced\n// by `reopen`, which ends the inner style and starts this one again.\nfunction wrap(text: string, open: string, close: string, reopen: string): string uses alloc {\n  return `\${open}\${Str.replace(text, close, reopen)}\${close}`\n}\n\nfunction paint(text: string, openCode: string, closeCode: string): string uses alloc {\n  const open = sequence(openCode)\n  const close = sequence(closeCode)\n  return wrap(text, open, close, open)\n}\n\n// Bold and dim share the close code 22, so closing one also ends the other.\nfunction paintWeight(text: string, openCode: string): string uses alloc {\n  const open = sequence(openCode)\n  const close = sequence(\"22\")\n  return wrap(text, open, close, `\${close}\${open}`)\n}\n\nexport function bold(text: string): string uses alloc {\n  return paintWeight(text, \"1\")\n}\n\nexport function dim(text: string): string uses alloc {\n  return paintWeight(text, \"2\")\n}\n\nexport function italic(text: string): string uses alloc {\n  return paint(text, \"3\", \"23\")\n}\n\nexport function underline(text: string): string uses alloc {\n  return paint(text, \"4\", \"24\")\n}\n\nexport function inverse(text: string): string uses alloc {\n  return paint(text, \"7\", \"27\")\n}\n\nexport function strikethrough(text: string): string uses alloc {\n  return paint(text, \"9\", \"29\")\n}\n\nexport function black(text: string): string uses alloc {\n  return paint(text, \"30\", \"39\")\n}\n\nexport function red(text: string): string uses alloc {\n  return paint(text, \"31\", \"39\")\n}\n\nexport function green(text: string): string uses alloc {\n  return paint(text, \"32\", \"39\")\n}\n\nexport function yellow(text: string): string uses alloc {\n  return paint(text, \"33\", \"39\")\n}\n\nexport function blue(text: string): string uses alloc {\n  return paint(text, \"34\", \"39\")\n}\n\nexport function magenta(text: string): string uses alloc {\n  return paint(text, \"35\", \"39\")\n}\n\nexport function cyan(text: string): string uses alloc {\n  return paint(text, \"36\", \"39\")\n}\n\nexport function white(text: string): string uses alloc {\n  return paint(text, \"37\", \"39\")\n}\n\nexport function gray(text: string): string uses alloc {\n  return paint(text, \"90\", \"39\")\n}\n\nexport function bgBlack(text: string): string uses alloc {\n  return paint(text, \"40\", \"49\")\n}\n\nexport function bgRed(text: string): string uses alloc {\n  return paint(text, \"41\", \"49\")\n}\n\nexport function bgGreen(text: string): string uses alloc {\n  return paint(text, \"42\", \"49\")\n}\n\nexport function bgYellow(text: string): string uses alloc {\n  return paint(text, \"43\", \"49\")\n}\n\nexport function bgBlue(text: string): string uses alloc {\n  return paint(text, \"44\", \"49\")\n}\n\nexport function bgMagenta(text: string): string uses alloc {\n  return paint(text, \"45\", \"49\")\n}\n\nexport function bgCyan(text: string): string uses alloc {\n  return paint(text, \"46\", \"49\")\n}\n\nexport function bgWhite(text: string): string uses alloc {\n  return paint(text, \"47\", \"49\")\n}\n\n// The SGR parameters that select the color; `offset` is 0 for a foreground and 10 for a background.\nfunction colorCode(color: Color, offset: int): string uses alloc {\n  const base = 38 + offset\n  return match (color) {\n    Color.Black => Int.toString(30 + offset)\n    Color.Red => Int.toString(31 + offset)\n    Color.Green => Int.toString(32 + offset)\n    Color.Yellow => Int.toString(33 + offset)\n    Color.Blue => Int.toString(34 + offset)\n    Color.Magenta => Int.toString(35 + offset)\n    Color.Cyan => Int.toString(36 + offset)\n    Color.White => Int.toString(37 + offset)\n    Color.BrightBlack => Int.toString(90 + offset)\n    Color.BrightRed => Int.toString(91 + offset)\n    Color.BrightGreen => Int.toString(92 + offset)\n    Color.BrightYellow => Int.toString(93 + offset)\n    Color.BrightBlue => Int.toString(94 + offset)\n    Color.BrightMagenta => Int.toString(95 + offset)\n    Color.BrightCyan => Int.toString(96 + offset)\n    Color.BrightWhite => Int.toString(97 + offset)\n    Color.Ansi256(index) => `\${Int.toString(base)};5;\${Int.toString(Int.from(index))}`\n    Color.Rgb(\n      red,\n      green,\n      blue,\n    ) => `\${Int.toString(base)};2;\${Int.toString(Int.from(red))};\${Int.toString(Int.from(green))};\${Int.toString(Int.from(blue))}`\n  }\n}\n\n// A field left as `None` adds nothing. Applies every field of the style in turn, so the pieces nest like the plain functions.\nexport function style(text: string, look: Style): string uses alloc {\n  let result = text\n  if (look.bold) {\n    result = bold(result)\n  }\n  if (look.dim) {\n    result = dim(result)\n  }\n  if (look.italic) {\n    result = italic(result)\n  }\n  if (look.underline) {\n    result = underline(result)\n  }\n  if (look.inverse) {\n    result = inverse(result)\n  }\n  if (look.strikethrough) {\n    result = strikethrough(result)\n  }\n  if (look.foreground is Some(color)) {\n    result = paint(result, colorCode(color, 0), \"39\")\n  }\n  if (look.background is Some(fill)) {\n    result = paint(result, colorCode(fill, 10), \"49\")\n  }\n  return result\n}\n\n// Removes the SGR sequences (`ESC [ <digits and semicolons> m`) and keeps everything else.\nexport function stripStyles(text: string): string uses alloc {\n  const length = Str.length(text)\n  let builder = Str.builder()\n  let start = 0\n  let index = 0\n  while (index < length) {\n    if (Str.byteAt(text, index) == 27 && index + 1 < length && Str.byteAt(text, index + 1) == 91) {\n      // Scan the parameters; the sequence counts only when an `m` ends it.\n      let end = index + 2\n      while (end < length && isParameterByte(Str.byteAt(text, end))) {\n        end += 1\n      }\n      if (end < length && Str.byteAt(text, end) == 109) {\n        if (Str.slice(text, start, index) is Some(kept)) {\n          Str.append(mutable builder, kept)\n        }\n        start = end + 1\n        index = end + 1\n        continue\n      }\n    }\n    index += 1\n  }\n  Str.append(mutable builder, Str.sliceFrom(text, start))\n  return Str.build(builder)\n}\n\nfunction isParameterByte(byte: int): bool {\n  // Digits, the semicolon and the colon of the `38:5:1` form.\n  return (byte >= 48 && byte <= 57) || byte == 59 || byte == 58\n}\n"

const STD_TIME = "// std/time: a monotonic clock for measuring, the wall clock, and sleep. Reading a clock or sleeping is `io`.\n\nimport * as Clock from \"std/internal/clock\"\n\nexport struct Instant {\n  nanos: int\n}\n\nexport struct Duration {\n  nanos: int\n}\n\nexport function now(): Instant uses io {\n  return Instant { nanos: Clock.monotonicNanos() }\n}\n\nexport function elapsed(since: Instant): Duration uses io {\n  return Duration { nanos: Clock.monotonicNanos() - since.nanos }\n}\n\nexport function between(earlier: Instant, later: Instant): Duration {\n  return Duration { nanos: later.nanos - earlier.nanos }\n}\n\nexport function unixMillis(): int uses io {\n  return Clock.wallMillis()\n}\n\nexport function sleep(duration: Duration) uses io {\n  Clock.sleepNanos(duration.nanos)\n}\n\nexport function nanoseconds(count: int): Duration {\n  return Duration { nanos: count }\n}\n\nexport function milliseconds(count: int): Duration {\n  return Duration { nanos: count * 1000000 }\n}\n\nexport function seconds(count: int): Duration {\n  return Duration { nanos: count * 1000000000 }\n}\n\nexport function asNanoseconds(duration: Duration): int {\n  return duration.nanos\n}\n\nexport function asMilliseconds(duration: Duration): int {\n  return duration.nanos / 1000000\n}\n"

const STD_TOML = "// std/toml: parse and stringify TOML 1.0 text as a Value of std/shape (D118 item 5).\n//\n// A table is a Record in the order of the file, an array a List, an integer\n// an Int, a float a Float (inf and nan too), a string Text and a boolean Bool.\n// A date, time or date-time is Text holding its text as written. A parse error\n// is a TomlError at a line and column; formatError writes `<line>:<column>: <reason>`.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Char from \"std/char\"\nimport * as Float from \"std/float\"\nimport * as Arrays from \"std/array\"\nimport * as Maps from \"std/map\"\nimport * as FloatText from \"std/internal/float\"\nimport { Value, Shape } from \"std/shape\"\n\n// Tables and arrays nested deeper than this are an error, as in std/json.\nconst MAX_DEPTH = 512\n\nexport struct TomlError derives Show, Equatable {\n  line: int\n  column: int\n  reason: string\n}\n\n// What a node of the parse tree is. The first four are tables: one made as\n// the parent of a header (Implicit), one opened by its own header, one made by\n// dotted keys, and an inline table, which nothing can extend.\nenum Kind derives Equatable {\n  Implicit\n  Header\n  Dotted\n  Inline\n  TableArray\n  List\n  Leaf\n}\n\n// A node of the tree the parser builds before it becomes a Value. A table keeps\n// its children in keys, an array in items, and a leaf its value.\nstruct Node {\n  kind: Kind\n  keys: Map<string, int>\n  items: Array<int>\n  value: Value\n  depth: int\n}\n\nstruct KeyPart {\n  name: string\n  position: int\n}\n\nstruct Parser {\n  text: string\n  length: int\n  position: int\n  nodes: Array<Node>\n  // The table that key-value lines go into.\n  current: int\n}\n\n// parse reads a TOML document into a Record.\nexport function parse(text: string): Result<Value, TomlError> uses alloc {\n  let parser = Parser { text: text, length: Str.length(text), position: 0, nodes: [], current: 0 }\n  addNode(mutable parser, Kind.Header, Value.Null, 0)\n  const document = parseDocument(mutable parser)\n  if (document is Err(error)) {\n    return Err(error)\n  }\n  return Ok(buildValue(parser, 0))\n}\n\n// formatError writes an error as `<line>:<column>: <reason>`.\nexport function formatError(error: TomlError): string uses alloc {\n  return `\${Int.toString(error.line)}:\${Int.toString(error.column)}: \${error.reason}`\n}\n\n// decode reads TOML text as a T: `Toml.decode<Manifest>(text)`. A parse error\n// reads as formatError writes it; a shape error as `<path>: <reason>`.\nexport function decode<T: Shape>(text: string): Result<T, string> uses alloc {\n  const value = parse(text)\n  if (value is Err(error)) {\n    return Err(formatError(error))\n  }\n  return Shape.fromValue<T>(value.value)\n}\n\n// encode writes any value that implements Shape as a TOML document.\nexport function encode<T: Shape>(value: T): Result<string, string> uses alloc {\n  return stringify(Shape.toValue(value))\n}\n\n// fail builds the error for the byte at position.\nfunction fail<T>(parser: Parser, position: int, reason: string): Result<T, TomlError> uses alloc {\n  let line = 1\n  let column = 1\n  let index = 0\n  while (index < position && index < parser.length) {\n    const byte = Str.byteAt(parser.text, index)\n    if (byte == 10) {\n      line += 1\n      column = 1\n    } else if (byte < 128 || byte >= 192) {\n      column += 1\n    }\n    index += 1\n  }\n  return Err(TomlError { line: line, column: column, reason: reason })\n}\n\nfunction cutText(text: string, start: int, end: int): string uses alloc {\n  if (Str.slice(text, start, end) is Some(piece)) {\n    return piece\n  }\n  panic(\"cutText: the range is outside the text\")\n}\n\n// The byte at position, or -1 past the end.\nfunction byteAt(parser: Parser, position: int): int {\n  if (position >= parser.length) {\n    return -1\n  }\n  return Str.byteAt(parser.text, position)\n}\n\nfunction addNode(mutable parser: Parser, kind: Kind, value: Value, depth: int): int uses alloc {\n  const index = Arrays.length(parser.nodes)\n  Arrays.push(mutable parser.nodes, Node {\n    kind: kind,\n    keys: Map {},\n    items: [],\n    value: value,\n    depth: depth,\n  })\n  return index\n}\n\nfunction isTable(kind: Kind): bool {\n  return kind == Kind.Implicit || kind == Kind.Header || kind == Kind.Dotted || kind == Kind.Inline\n}\n\nfunction skipBlank(mutable parser: Parser) {\n  while (parser.position < parser.length) {\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte != 32 && byte != 9) {\n      return\n    }\n    parser.position += 1\n  }\n}\n\n// isControl says whether a byte may not appear in a string or a comment as is.\nfunction isControl(byte: int): bool {\n  return (byte < 32 && byte != 9) || byte == 127\n}\n\n// skipComment moves past a comment that starts at parser.position, up to the newline.\nfunction skipComment(mutable parser: Parser): Result<bool, TomlError> uses alloc {\n  if (byteAt(parser, parser.position) != 35) {\n    return Ok(false)\n  }\n  while (parser.position < parser.length) {\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte == 10 || (byte == 13 && byteAt(parser, parser.position + 1) == 10)) {\n      return Ok(true)\n    }\n    if (isControl(byte)) {\n      return fail(parser, parser.position, \"control character in a comment\")\n    }\n    parser.position += 1\n  }\n  return Ok(true)\n}\n\n// skipNewline consumes LF or CRLF and says whether it found one.\nfunction skipNewline(mutable parser: Parser): bool {\n  const byte = byteAt(parser, parser.position)\n  if (byte == 10) {\n    parser.position += 1\n    return true\n  }\n  if (byte == 13 && byteAt(parser, parser.position + 1) == 10) {\n    parser.position += 2\n    return true\n  }\n  return false\n}\n\n// skipLineEnd reads the rest of a line after a key-value pair or a header.\nfunction skipLineEnd(mutable parser: Parser): Result<bool, TomlError> uses alloc {\n  skipBlank(mutable parser)\n  const comment = skipComment(mutable parser)\n  if (comment is Err(error)) {\n    return Err(error)\n  }\n  if (parser.position >= parser.length || skipNewline(mutable parser)) {\n    return Ok(true)\n  }\n  return fail(parser, parser.position, \"expected a newline\")\n}\n\nfunction parseDocument(mutable parser: Parser): Result<bool, TomlError> uses alloc {\n  while (true) {\n    skipBlank(mutable parser)\n    if (parser.position >= parser.length) {\n      return Ok(true)\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte == 35) {\n      const comment = skipComment(mutable parser)\n      if (comment is Err(error)) {\n        return Err(error)\n      }\n      continue\n    }\n    if (skipNewline(mutable parser)) {\n      continue\n    }\n    if (byte == 91) {\n      const header = parseHeader(mutable parser)\n      if (header is Err(error)) {\n        return Err(error)\n      }\n    } else {\n      const current = parser.current\n      const pair = parsePair(mutable parser, current)\n      if (pair is Err(error)) {\n        return Err(error)\n      }\n    }\n    const end = skipLineEnd(mutable parser)\n    if (end is Err(error)) {\n      return Err(error)\n    }\n  }\n  return Ok(true)\n}\n\nfunction isBareKeyByte(byte: int): bool {\n  return ((byte >= 65 && byte <= 90) ||\n    (byte >= 97 && byte <= 122) ||\n    (byte >= 48 && byte <= 57) ||\n    byte == 95 ||\n    byte == 45)\n}\n\n// parseKey reads a bare, quoted or dotted key.\nfunction parseKey(mutable parser: Parser): Result<Array<KeyPart>, TomlError> uses alloc {\n  let parts: Array<KeyPart> = []\n  while (true) {\n    skipBlank(mutable parser)\n    const start = parser.position\n    const byte = byteAt(parser, start)\n    if (byte == 34) {\n      const name = parseBasicString(mutable parser)\n      if (name is Err(error)) {\n        return Err(error)\n      }\n      Arrays.push(mutable parts, KeyPart { name: name.value, position: start })\n    } else if (byte == 39) {\n      const name = parseLiteralString(mutable parser)\n      if (name is Err(error)) {\n        return Err(error)\n      }\n      Arrays.push(mutable parts, KeyPart { name: name.value, position: start })\n    } else {\n      while (\n        parser.position < parser.length && isBareKeyByte(Str.byteAt(parser.text, parser.position))\n      ) {\n        parser.position += 1\n      }\n      if (parser.position == start) {\n        return fail(parser, start, \"expected a key\")\n      }\n      Arrays.push(mutable parts, KeyPart {\n        name: cutText(parser.text, start, parser.position),\n        position: start,\n      })\n    }\n    skipBlank(mutable parser)\n    if (byteAt(parser, parser.position) != 46) {\n      return Ok(parts)\n    }\n    parser.position += 1\n  }\n  return Ok(parts)\n}\n\nfunction quoteKey(name: string): string uses alloc {\n  let builder = Str.builder()\n  writeKey(mutable builder, name)\n  return Str.build(builder)\n}\n\n// childTable makes a table under table for a header's or a dotted key's inner part.\nfunction childTable(\n  mutable parser: Parser,\n  table: int,\n  part: KeyPart,\n  kind: Kind,\n): Result<int, TomlError> uses alloc {\n  const depth = parser.nodes[table].depth + 1\n  if (depth > MAX_DEPTH) {\n    return fail(parser, part.position, \"nesting is deeper than 512\")\n  }\n  const child = addNode(mutable parser, kind, Value.Null, depth)\n  parser.nodes[table].keys[part.name] = child\n  return Ok(child)\n}\n\n// walkDotted follows the inner parts of a dotted key from table. Only tables\n// made by dotted keys can take more of them.\nfunction walkDotted(\n  mutable parser: Parser,\n  start: int,\n  parts: Array<KeyPart>,\n): Result<int, TomlError> uses alloc {\n  let table = start\n  let index = 0\n  while (index < Arrays.length(parts) - 1) {\n    const part = parts[index]\n    if (parser.nodes[table].keys[part.name] is Some(child)) {\n      const kind = parser.nodes[child].kind\n      if (kind != Kind.Dotted) {\n        if (kind == Kind.Inline) {\n          return fail(\n            parser,\n            part.position,\n            `inline table \${quoteKey(part.name)} cannot be extended`,\n          )\n        }\n        if (isTable(kind)) {\n          return fail(parser, part.position, `table \${quoteKey(part.name)} is already defined`)\n        }\n        return fail(parser, part.position, `key \${quoteKey(part.name)} is already defined`)\n      }\n      table = child\n    } else {\n      const made = childTable(mutable parser, table, part, Kind.Dotted)\n      if (made is Err(error)) {\n        return Err(error)\n      }\n      table = made.value\n    }\n    index += 1\n  }\n  return Ok(table)\n}\n\n// parsePair reads `key = value` into table.\nfunction parsePair(mutable parser: Parser, table: int): Result<bool, TomlError> uses alloc {\n  const parts = parseKey(mutable parser)\n  if (parts is Err(error)) {\n    return Err(error)\n  }\n  const parent = walkDotted(mutable parser, table, parts.value)\n  if (parent is Err(error)) {\n    return Err(error)\n  }\n  const last = parts.value[Arrays.length(parts.value) - 1]\n  if (parser.nodes[parent.value].keys[last.name] is Some(_)) {\n    return fail(parser, last.position, `key \${quoteKey(last.name)} is already defined`)\n  }\n  if (byteAt(parser, parser.position) != 61) {\n    return fail(parser, parser.position, \"expected =\")\n  }\n  parser.position += 1\n  skipBlank(mutable parser)\n  const depth = parser.nodes[parent.value].depth\n  const value = parseValue(mutable parser, depth)\n  if (value is Err(error)) {\n    return Err(error)\n  }\n  parser.nodes[parent.value].keys[last.name] = value.value\n  return Ok(true)\n}\n\n// parseHeader reads `[name]` or `[[name]]` and makes its table the current one.\nfunction parseHeader(mutable parser: Parser): Result<bool, TomlError> uses alloc {\n  const start = parser.position\n  parser.position += 1\n  const isArray = byteAt(parser, parser.position) == 91\n  if (isArray) {\n    parser.position += 1\n  }\n  const parts = parseKey(mutable parser)\n  if (parts is Err(error)) {\n    return Err(error)\n  }\n  if (byteAt(parser, parser.position) != 93) {\n    return fail(parser, parser.position, \"expected ]\")\n  }\n  parser.position += 1\n  if (isArray) {\n    if (byteAt(parser, parser.position) != 93) {\n      return fail(parser, parser.position, \"expected ]]\")\n    }\n    parser.position += 1\n  }\n  // Walk the inner parts; an array of tables leads into its last table.\n  let table = 0\n  let index = 0\n  while (index < Arrays.length(parts.value) - 1) {\n    const part = parts.value[index]\n    if (parser.nodes[table].keys[part.name] is Some(child)) {\n      const kind = parser.nodes[child].kind\n      if (kind == Kind.TableArray) {\n        table = parser.nodes[child].items[Arrays.length(parser.nodes[child].items) - 1]\n      } else if (kind == Kind.Inline) {\n        return fail(parser, part.position, `inline table \${quoteKey(part.name)} cannot be extended`)\n      } else if (isTable(kind)) {\n        table = child\n      } else {\n        return fail(parser, part.position, `key \${quoteKey(part.name)} is not a table`)\n      }\n    } else {\n      const made = childTable(mutable parser, table, part, Kind.Implicit)\n      if (made is Err(error)) {\n        return Err(error)\n      }\n      table = made.value\n    }\n    index += 1\n  }\n  const last = parts.value[Arrays.length(parts.value) - 1]\n  const name = quoteKey(last.name)\n  if (isArray) {\n    return openTableArray(mutable parser, table, last, name)\n  }\n  if (parser.nodes[table].keys[last.name] is Some(existing)) {\n    const kind = parser.nodes[existing].kind\n    if (kind == Kind.Implicit) {\n      parser.nodes[existing].kind = Kind.Header\n      parser.current = existing\n      return Ok(true)\n    }\n    if (kind == Kind.Header) {\n      return fail(parser, start, `table \${name} is defined twice`)\n    }\n    if (kind == Kind.Dotted) {\n      return fail(parser, start, `table \${name} is already defined by dotted keys`)\n    }\n    if (kind == Kind.Inline) {\n      return fail(parser, start, `inline table \${name} cannot be extended`)\n    }\n    if (kind == Kind.TableArray) {\n      return fail(parser, start, `\${name} is an array of tables`)\n    }\n    return fail(parser, start, `key \${name} is already defined`)\n  }\n  const made = childTable(mutable parser, table, last, Kind.Header)\n  if (made is Err(error)) {\n    return Err(error)\n  }\n  parser.current = made.value\n  return Ok(true)\n}\n\n// openTableArray adds a table to the array of tables named last under table.\nfunction openTableArray(\n  mutable parser: Parser,\n  table: int,\n  last: KeyPart,\n  name: string,\n): Result<bool, TomlError> uses alloc {\n  let array = 0\n  if (parser.nodes[table].keys[last.name] is Some(existing)) {\n    const kind = parser.nodes[existing].kind\n    if (kind == Kind.List) {\n      return fail(parser, last.position, `cannot append to the static array \${name}`)\n    }\n    if (kind != Kind.TableArray) {\n      return fail(parser, last.position, `key \${name} is already defined`)\n    }\n    array = existing\n  } else {\n    const made = childTable(mutable parser, table, last, Kind.TableArray)\n    if (made is Err(error)) {\n      return Err(error)\n    }\n    array = made.value\n  }\n  const depth = parser.nodes[array].depth + 1\n  if (depth > MAX_DEPTH) {\n    return fail(parser, last.position, \"nesting is deeper than 512\")\n  }\n  const item = addNode(mutable parser, Kind.Header, Value.Null, depth)\n  Arrays.push(mutable parser.nodes[array].items, item)\n  parser.current = item\n  return Ok(true)\n}\n\n// parseValue reads a value into a new node one level below depth.\nfunction parseValue(mutable parser: Parser, depth: int): Result<int, TomlError> uses alloc {\n  const start = parser.position\n  const byte = byteAt(parser, start)\n  if (byte == 34) {\n    const text = readBasic(mutable parser)\n    if (text is Err(error)) {\n      return Err(error)\n    }\n    return Ok(addNode(mutable parser, Kind.Leaf, Value.Text(text.value), depth + 1))\n  }\n  if (byte == 39) {\n    const text = readLiteral(mutable parser)\n    if (text is Err(error)) {\n      return Err(error)\n    }\n    return Ok(addNode(mutable parser, Kind.Leaf, Value.Text(text.value), depth + 1))\n  }\n  if (byte == 91 || byte == 123) {\n    if (depth + 1 > MAX_DEPTH) {\n      return fail(parser, start, \"nesting is deeper than 512\")\n    }\n    if (byte == 91) {\n      return parseArray(mutable parser, depth + 1)\n    }\n    return parseInlineTable(mutable parser, depth + 1)\n  }\n  const scalar = parseScalar(mutable parser)\n  if (scalar is Err(error)) {\n    return Err(error)\n  }\n  return Ok(addNode(mutable parser, Kind.Leaf, scalar.value, depth + 1))\n}\n\n// skipArraySpace moves past blanks, comments and newlines inside an array.\nfunction skipArraySpace(mutable parser: Parser): Result<bool, TomlError> uses alloc {\n  while (true) {\n    skipBlank(mutable parser)\n    const comment = skipComment(mutable parser)\n    if (comment is Err(error)) {\n      return Err(error)\n    }\n    if (!skipNewline(mutable parser)) {\n      return Ok(true)\n    }\n  }\n  return Ok(true)\n}\n\nfunction parseArray(mutable parser: Parser, depth: int): Result<int, TomlError> uses alloc {\n  const array = addNode(mutable parser, Kind.List, Value.Null, depth)\n  // Skip the [.\n  parser.position += 1\n  while (true) {\n    const space = skipArraySpace(mutable parser)\n    if (space is Err(error)) {\n      return Err(error)\n    }\n    if (byteAt(parser, parser.position) == 93) {\n      parser.position += 1\n      return Ok(array)\n    }\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"unterminated array\")\n    }\n    const item = parseValue(mutable parser, depth)\n    if (item is Err(error)) {\n      return Err(error)\n    }\n    Arrays.push(mutable parser.nodes[array].items, item.value)\n    const after = skipArraySpace(mutable parser)\n    if (after is Err(error)) {\n      return Err(error)\n    }\n    const byte = byteAt(parser, parser.position)\n    if (byte == 93) {\n      parser.position += 1\n      return Ok(array)\n    }\n    if (byte != 44) {\n      if (byte < 0) {\n        return fail(parser, parser.position, \"unterminated array\")\n      }\n      return fail(parser, parser.position, \"expected , or ]\")\n    }\n    parser.position += 1\n  }\n  return Ok(array)\n}\n\nfunction parseInlineTable(mutable parser: Parser, depth: int): Result<int, TomlError> uses alloc {\n  const table = addNode(mutable parser, Kind.Inline, Value.Null, depth)\n  // Skip the {.\n  parser.position += 1\n  skipBlank(mutable parser)\n  if (byteAt(parser, parser.position) == 125) {\n    parser.position += 1\n    return Ok(table)\n  }\n  while (true) {\n    skipBlank(mutable parser)\n    if (byteAt(parser, parser.position) == 125) {\n      return fail(parser, parser.position, \"trailing comma in an inline table\")\n    }\n    const pair = parsePair(mutable parser, table)\n    if (pair is Err(error)) {\n      return Err(error)\n    }\n    skipBlank(mutable parser)\n    const byte = byteAt(parser, parser.position)\n    if (byte == 125) {\n      parser.position += 1\n      return Ok(table)\n    }\n    if (byte != 44) {\n      if (byte == 10 || byte == 13) {\n        return fail(parser, parser.position, \"newline in an inline table\")\n      }\n      if (byte < 0) {\n        return fail(parser, parser.position, \"unterminated inline table\")\n      }\n      return fail(parser, parser.position, \"expected , or }\")\n    }\n    parser.position += 1\n  }\n  return Ok(table)\n}\n\n// readBasic reads a basic string, one line or three quotes.\nfunction readBasic(mutable parser: Parser): Result<string, TomlError> uses alloc {\n  if (readWord(mutable parser, \"\\\"\\\"\\\"\")) {\n    return parseMultiline(mutable parser, 34)\n  }\n  return parseBasicString(mutable parser)\n}\n\nfunction readLiteral(mutable parser: Parser): Result<string, TomlError> uses alloc {\n  if (readWord(mutable parser, \"'''\")) {\n    return parseMultiline(mutable parser, 39)\n  }\n  return parseLiteralString(mutable parser)\n}\n\n// readWord consumes word when the text continues with it.\nfunction readWord(mutable parser: Parser, word: string): bool {\n  const count = Str.length(word)\n  if (parser.position + count > parser.length) {\n    return false\n  }\n  let index = 0\n  while (index < count) {\n    if (Str.byteAt(parser.text, parser.position + index) != Str.byteAt(word, index)) {\n      return false\n    }\n    index += 1\n  }\n  parser.position += count\n  return true\n}\n\n// parseBasicString reads a one-line basic string whose quote is at parser.position.\nfunction parseBasicString(mutable parser: Parser): Result<string, TomlError> uses alloc {\n  const start = parser.position\n  parser.position += 1\n  let builder = Str.builder()\n  let runStart = parser.position\n  while (true) {\n    const byte = byteAt(parser, parser.position)\n    if (byte < 0 || byte == 10 || byte == 13) {\n      return fail(parser, start, \"unterminated string\")\n    }\n    if (byte == 34) {\n      Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n      parser.position += 1\n      return Ok(Str.build(builder))\n    }\n    if (isControl(byte)) {\n      return fail(parser, parser.position, \"control character in a string\")\n    }\n    if (byte != 92) {\n      parser.position += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n    const escape = readEscape(mutable parser, mutable builder)\n    if (escape is Err(error)) {\n      return Err(error)\n    }\n    runStart = parser.position\n  }\n  return fail(parser, start, \"unterminated string\")\n}\n\n// readEscape reads the escape whose backslash is at parser.position.\nfunction readEscape(\n  mutable parser: Parser,\n  mutable builder: StringBuilder,\n): Result<bool, TomlError> uses alloc {\n  const escapeAt = parser.position\n  parser.position += 1\n  const letter = byteAt(parser, parser.position)\n  parser.position += 1\n  if (letter == 117 || letter == 85) {\n    let count = 4\n    if (letter == 85) {\n      count = 8\n    }\n    let code = 0\n    let index = 0\n    while (index < count) {\n      const digit = hexValue(byteAt(parser, parser.position))\n      if (digit < 0) {\n        return fail(parser, escapeAt, \"invalid unicode escape\")\n      }\n      code = code * 16 + digit\n      parser.position += 1\n      index += 1\n    }\n    if (code > 1114111 || (code >= 55296 && code <= 57343)) {\n      return fail(parser, escapeAt, \"unicode escape is not a scalar value\")\n    }\n    if (Char.fromCode(code) is Some(character)) {\n      Str.appendChar(mutable builder, character)\n    }\n    return Ok(true)\n  }\n  const simple = simpleEscape(letter)\n  if (simple == \"\") {\n    return fail(parser, escapeAt, \"invalid escape\")\n  }\n  Str.append(mutable builder, simple)\n  return Ok(true)\n}\n\nfunction parseLiteralString(mutable parser: Parser): Result<string, TomlError> uses alloc {\n  const start = parser.position\n  parser.position += 1\n  while (true) {\n    const byte = byteAt(parser, parser.position)\n    if (byte < 0 || byte == 10 || byte == 13) {\n      return fail(parser, start, \"unterminated string\")\n    }\n    if (byte == 39) {\n      parser.position += 1\n      return Ok(cutText(parser.text, start + 1, parser.position - 1))\n    }\n    if (isControl(byte)) {\n      return fail(parser, parser.position, \"control character in a string\")\n    }\n    parser.position += 1\n  }\n  return fail(parser, start, \"unterminated string\")\n}\n\n// parseMultiline reads a multi-line string after its three quotes. quote is\n// 34 for a basic string (escapes and line-ending backslashes) or 39 for a literal one.\nfunction parseMultiline(mutable parser: Parser, quote: int): Result<string, TomlError> uses alloc {\n  const start = parser.position - 3\n  // A newline right after the opening quotes is not part of the string.\n  skipNewline(mutable parser)\n  let builder = Str.builder()\n  let runStart = parser.position\n  while (true) {\n    const byte = byteAt(parser, parser.position)\n    if (byte < 0) {\n      return fail(parser, start, \"unterminated string\")\n    }\n    if (byte == quote) {\n      // Count the run of quotes: three end the string, and up to two more belong to it.\n      const runEnd = parser.position\n      let count = 0\n      while (byteAt(parser, parser.position) == quote) {\n        parser.position += 1\n        count += 1\n      }\n      if (count < 3) {\n        continue\n      }\n      if (count > 5) {\n        return fail(parser, runEnd, \"too many quotes at the end of a string\")\n      }\n      Str.append(mutable builder, cutText(parser.text, runStart, runEnd + count - 3))\n      return Ok(Str.build(builder))\n    }\n    if (byte == 13 && byteAt(parser, parser.position + 1) == 10) {\n      parser.position += 2\n      continue\n    }\n    if (byte != 10 && isControl(byte)) {\n      return fail(parser, parser.position, \"control character in a string\")\n    }\n    if (byte != 92 || quote == 39) {\n      parser.position += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n    if (isLineEndBackslash(parser)) {\n      // Skip the backslash, the blanks and newlines after it.\n      parser.position += 1\n      while (true) {\n        skipBlank(mutable parser)\n        if (!skipNewline(mutable parser)) {\n          break\n        }\n      }\n    } else {\n      const escape = readEscape(mutable parser, mutable builder)\n      if (escape is Err(error)) {\n        return Err(error)\n      }\n    }\n    runStart = parser.position\n  }\n  return fail(parser, start, \"unterminated string\")\n}\n\n// isLineEndBackslash says whether the backslash at parser.position has only\n// blanks after it on its line.\nfunction isLineEndBackslash(parser: Parser): bool {\n  let index = parser.position + 1\n  while (byteAt(parser, index) == 32 || byteAt(parser, index) == 9) {\n    index += 1\n  }\n  const byte = byteAt(parser, index)\n  return byte == 10 || (byte == 13 && byteAt(parser, index + 1) == 10)\n}\n\nfunction hexValue(byte: int): int {\n  if (byte >= 48 && byte <= 57) {\n    return byte - 48\n  }\n  if (byte >= 97 && byte <= 102) {\n    return byte - 87\n  }\n  if (byte >= 65 && byte <= 70) {\n    return byte - 55\n  }\n  return -1\n}\n\n// The text for the escape letter after a backslash, or \"\".\nfunction simpleEscape(letter: int): string uses alloc {\n  if (letter == 34) {\n    return \"\\\"\"\n  }\n  if (letter == 92) {\n    return \"\\\\\"\n  }\n  if (letter == 98) {\n    return controlText(8)\n  }\n  if (letter == 102) {\n    return controlText(12)\n  }\n  if (letter == 110) {\n    return \"\\n\"\n  }\n  if (letter == 114) {\n    return \"\\r\"\n  }\n  if (letter == 116) {\n    return \"\\t\"\n  }\n  return \"\"\n}\n\nfunction controlText(code: int): string uses alloc {\n  if (Char.fromCode(code) is Some(character)) {\n    return Str.fromChar(character)\n  }\n  return \"\"\n}\n\nfunction isDigit(byte: int): bool {\n  return byte >= 48 && byte <= 57\n}\n\nfunction isScalarByte(byte: int): bool {\n  return isBareKeyByte(byte) || byte == 43 || byte == 46 || byte == 58\n}\n\n// parseScalar reads a boolean, a number, or a date or time.\nfunction parseScalar(mutable parser: Parser): Result<Value, TomlError> uses alloc {\n  const start = parser.position\n  while (\n    parser.position < parser.length && isScalarByte(Str.byteAt(parser.text, parser.position))\n  ) {\n    parser.position += 1\n  }\n  if (parser.position == start) {\n    return fail(parser, start, \"expected a value\")\n  }\n  // A local date followed by a space and a time is one date-time.\n  if (\n    parser.position - start == 10 &&\n      byteAt(parser, parser.position) == 32 &&\n      isDigit(byteAt(parser, parser.position + 1)) &&\n      isDigit(byteAt(parser, parser.position + 2)) &&\n      byteAt(parser, parser.position + 3) == 58\n  ) {\n    parser.position += 1\n    while (\n      parser.position < parser.length && isScalarByte(Str.byteAt(parser.text, parser.position))\n    ) {\n      parser.position += 1\n    }\n  }\n  const token = cutText(parser.text, start, parser.position)\n  if (token == \"true\") {\n    return Ok(Value.Bool(true))\n  }\n  if (token == \"false\") {\n    return Ok(Value.Bool(false))\n  }\n  const length = Str.length(token)\n  if (length >= 5 && digitRun(token, 0, 4) && Str.byteAt(token, 4) == 45) {\n    if (isDateTime(token)) {\n      return Ok(Value.Text(token))\n    }\n    return fail(parser, start, \"invalid date or time\")\n  }\n  if (length >= 3 && digitRun(token, 0, 2) && Str.byteAt(token, 2) == 58) {\n    if (readTime(token, 0) == length) {\n      return Ok(Value.Text(token))\n    }\n    return fail(parser, start, \"invalid date or time\")\n  }\n  return parseNumber(parser, token, start)\n}\n\n// digitRun says whether text has count digits from start.\nfunction digitRun(text: string, start: int, count: int): bool {\n  if (start + count > Str.length(text)) {\n    return false\n  }\n  let index = start\n  while (index < start + count) {\n    if (!isDigit(Str.byteAt(text, index))) {\n      return false\n    }\n    index += 1\n  }\n  return true\n}\n\n// The number written by count digits from start; the caller checked them.\nfunction digitsValue(text: string, start: int, count: int): int {\n  let value = 0\n  let index = start\n  while (index < start + count) {\n    value = value * 10 + Str.byteAt(text, index) - 48\n    index += 1\n  }\n  return value\n}\n\nfunction daysInMonth(year: int, month: int): int {\n  if (month == 2) {\n    if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) {\n      return 29\n    }\n    return 28\n  }\n  if (month == 4 || month == 6 || month == 9 || month == 11) {\n    return 30\n  }\n  return 31\n}\n\n// isDateTime checks a local date, a local date-time or an offset date-time.\nfunction isDateTime(text: string): bool {\n  const length = Str.length(text)\n  if (length < 10 || !digitRun(text, 5, 2) || Str.byteAt(text, 7) != 45 || !digitRun(text, 8, 2)) {\n    return false\n  }\n  const year = digitsValue(text, 0, 4)\n  const month = digitsValue(text, 5, 2)\n  const day = digitsValue(text, 8, 2)\n  if (month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month)) {\n    return false\n  }\n  if (length == 10) {\n    return true\n  }\n  const separator = Str.byteAt(text, 10)\n  if (separator != 84 && separator != 116 && separator != 32) {\n    return false\n  }\n  const timeEnd = readTime(text, 11)\n  if (timeEnd < 0) {\n    return false\n  }\n  if (timeEnd == length) {\n    return true\n  }\n  // The offset: Z, or a sign and hours and minutes.\n  const zone = Str.byteAt(text, timeEnd)\n  if (zone == 90 || zone == 122) {\n    return timeEnd + 1 == length\n  }\n  if (zone != 43 && zone != 45) {\n    return false\n  }\n  if (\n    timeEnd + 6 != length || !digitRun(text, timeEnd + 1, 2) || Str.byteAt(text, timeEnd + 3) != 58\n  ) {\n    return false\n  }\n  if (!digitRun(text, timeEnd + 4, 2)) {\n    return false\n  }\n  return digitsValue(text, timeEnd + 1, 2) <= 23 && digitsValue(text, timeEnd + 4, 2) <= 59\n}\n\n// readTime checks HH:MM:SS with an optional fraction from start and returns\n// where it ends, or -1.\nfunction readTime(text: string, start: int): int {\n  if (!digitRun(text, start, 2) || !digitRun(text, start + 3, 2) || !digitRun(text, start + 6, 2)) {\n    return -1\n  }\n  if (Str.byteAt(text, start + 2) != 58 || Str.byteAt(text, start + 5) != 58) {\n    return -1\n  }\n  const hour = digitsValue(text, start, 2)\n  const minute = digitsValue(text, start + 3, 2)\n  const second = digitsValue(text, start + 6, 2)\n  if (hour > 23 || minute > 59 || second > 60) {\n    return -1\n  }\n  let index = start + 8\n  const length = Str.length(text)\n  if (index < length && Str.byteAt(text, index) == 46) {\n    index += 1\n    const fraction = index\n    while (index < length && isDigit(Str.byteAt(text, index))) {\n      index += 1\n    }\n    if (index == fraction) {\n      return -1\n    }\n  }\n  return index\n}\n\n// stripUnderscores checks that each underscore of digits[start..] sits between\n// two digits of the base and returns the digits without them, or \"\".\nfunction stripUnderscores(text: string, start: int, base: int): string uses alloc {\n  const length = Str.length(text)\n  if (start >= length) {\n    return \"\"\n  }\n  let builder = Str.builder()\n  let previousDigit = false\n  let index = start\n  while (index < length) {\n    const byte = Str.byteAt(text, index)\n    if (byte == 95) {\n      if (!previousDigit) {\n        return \"\"\n      }\n      previousDigit = false\n    } else {\n      const digit = hexValue(byte)\n      if (digit < 0 || digit >= base) {\n        return \"\"\n      }\n      previousDigit = true\n      Str.append(mutable builder, cutText(text, index, index + 1))\n    }\n    index += 1\n  }\n  if (!previousDigit) {\n    return \"\"\n  }\n  return Str.build(builder)\n}\n\nfunction parseNumber(\n  parser: Parser,\n  token: string,\n  start: int,\n): Result<Value, TomlError> uses alloc {\n  const length = Str.length(token)\n  // Prefixed integers take no sign.\n  if (length > 2 && Str.byteAt(token, 0) == 48) {\n    const marker = Str.byteAt(token, 1)\n    let base = 0\n    if (marker == 120) {\n      base = 16\n    } else if (marker == 111) {\n      base = 8\n    } else if (marker == 98) {\n      base = 2\n    }\n    if (base != 0) {\n      const digits = stripUnderscores(token, 2, base)\n      if (digits == \"\") {\n        return fail(parser, start, \"invalid integer\")\n      }\n      if (Int.parse(digits, base) is Ok(number)) {\n        return Ok(Value.Int(number))\n      }\n      return fail(parser, start, \"integer out of range\")\n    }\n  }\n  let index = 0\n  let sign = \"\"\n  const first = Str.byteAt(token, 0)\n  if (first == 43 || first == 45) {\n    index = 1\n    if (first == 45) {\n      sign = \"-\"\n    }\n  }\n  const body = cutText(token, index, length)\n  if (body == \"inf\" || body == \"nan\") {\n    return Ok(Value.Float(FloatText.parse(`\${sign}\${body}`)))\n  }\n  // Split the token into its integer part, fraction and exponent.\n  let fractionAt = -1\n  let exponentAt = -1\n  let position = index\n  while (position < length) {\n    const byte = Str.byteAt(token, position)\n    if (byte == 46 && fractionAt < 0 && exponentAt < 0) {\n      fractionAt = position\n    } else if ((byte == 101 || byte == 69) && exponentAt < 0) {\n      exponentAt = position\n    }\n    position += 1\n  }\n  let integerEnd = length\n  if (fractionAt >= 0) {\n    integerEnd = fractionAt\n  } else if (exponentAt >= 0) {\n    integerEnd = exponentAt\n  }\n  const whole = stripUnderscores(cutText(token, index, integerEnd), 0, 10)\n  if (whole == \"\") {\n    return fail(parser, start, \"invalid number\")\n  }\n  if (Str.length(whole) > 1 && Str.byteAt(whole, 0) == 48) {\n    return fail(parser, start, \"leading zeros in a number\")\n  }\n  if (fractionAt < 0 && exponentAt < 0) {\n    if (Int.parse(`\${sign}\${whole}`, 10) is Ok(number)) {\n      return Ok(Value.Int(number))\n    }\n    return fail(parser, start, \"integer out of range\")\n  }\n  let text = `\${sign}\${whole}`\n  if (fractionAt >= 0) {\n    let fractionEnd = length\n    if (exponentAt >= 0) {\n      fractionEnd = exponentAt\n    }\n    const fraction = stripUnderscores(cutText(token, fractionAt + 1, fractionEnd), 0, 10)\n    if (fraction == \"\") {\n      return fail(parser, start, \"invalid number\")\n    }\n    text = `\${text}.\${fraction}`\n  }\n  if (exponentAt >= 0) {\n    let exponentStart = exponentAt + 1\n    let exponentSign = \"\"\n    const marker = byteAtText(token, exponentStart)\n    if (marker == 43 || marker == 45) {\n      exponentStart += 1\n      if (marker == 45) {\n        exponentSign = \"-\"\n      }\n    }\n    const exponent = stripUnderscores(cutText(token, exponentStart, length), 0, 10)\n    if (exponent == \"\") {\n      return fail(parser, start, \"invalid number\")\n    }\n    text = `\${text}e\${exponentSign}\${exponent}`\n  }\n  return Ok(Value.Float(FloatText.parse(text)))\n}\n\nfunction byteAtText(text: string, index: int): int {\n  if (index >= Str.length(text)) {\n    return -1\n  }\n  return Str.byteAt(text, index)\n}\n\n// buildValue turns the node at index into a Value. Depth is capped while parsing.\nfunction buildValue(parser: Parser, index: int): Value from parser uses alloc {\n  const node = parser.nodes[index]\n  if (node.kind == Kind.Leaf) {\n    return node.value\n  }\n  if (node.kind == Kind.List || node.kind == Kind.TableArray) {\n    let items: Array<Value> = []\n    for (const item of Arrays.values(node.items)) {\n      Arrays.push(mutable items, buildValue(parser, item))\n    }\n    return Value.List(items)\n  }\n  let fields: Map<string, Value> = Map {}\n  for (const entry of Maps.entries(node.keys)) {\n    const #[key, child] = entry\n    fields[key] = buildValue(parser, child)\n  }\n  return Value.Record(fields)\n}\n\n// stringify writes a Record as a TOML document: the plain keys of each table\n// before its sub-tables, and a List of Records as `[[name]]` tables. It fails\n// on Null, which TOML cannot write, and on a root that is not a Record.\nexport function stringify(value: Value): Result<string, string> uses alloc {\n  if (value is Value.Record(fields)) {\n    let builder = Str.builder()\n    const written = writeTable(mutable builder, \"\", \"\", fields, 0)\n    if (written is Err(message)) {\n      return Err(message)\n    }\n    // A document whose root has no plain keys starts with a header, not a blank line.\n    const text = Str.build(builder)\n    if (Str.startsWith(text, \"\\n\")) {\n      return Ok(cutText(text, 1, Str.length(text)))\n    }\n    return Ok(text)\n  }\n  return Err(\"the root must be a Record\")\n}\n\n// isTableList says whether a value is a non-empty List of Records only.\nfunction isTableList(value: Value): bool {\n  if (value is Value.List(items)) {\n    if (Arrays.length(items) == 0) {\n      return false\n    }\n    for (const item of Arrays.values(items)) {\n      if (!(item is Value.Record(_))) {\n        return false\n      }\n    }\n    return true\n  }\n  return false\n}\n\nfunction hasPlainKeys(fields: Map<string, Value>): bool {\n  for (const entry of Maps.entries(fields)) {\n    const #[_, field] = entry\n    if (!(field is Value.Record(_)) && !isTableList(field)) {\n      return true\n    }\n  }\n  return false\n}\n\n// writeTable writes the body of a table. header is its dotted name for the\n// headers of its sub-tables; path is the D84 path for errors; depth counts\n// the tables and arrays above it, as parse does.\nfunction writeTable(\n  mutable builder: StringBuilder,\n  header: string,\n  path: string,\n  fields: Map<string, Value>,\n  depth: int,\n): Result<bool, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return Err(`\${path}: nesting is deeper than 512`)\n  }\n  // The plain keys first.\n  for (const entry of Maps.entries(fields)) {\n    const #[key, field] = entry\n    if (field is Value.Record(_)) {\n      continue\n    }\n    if (isTableList(field)) {\n      continue\n    }\n    writeKey(mutable builder, key)\n    Str.append(mutable builder, \" = \")\n    const written = writeInline(mutable builder, `\${path}.\${key}`, field, depth + 1)\n    if (written is Err(message)) {\n      return Err(message)\n    }\n    Str.append(mutable builder, \"\\n\")\n  }\n  // Then the tables and arrays of tables.\n  for (const entry of Maps.entries(fields)) {\n    const #[key, field] = entry\n    let name = quoteKey(key)\n    if (header != \"\") {\n      name = `\${header}.\${name}`\n    }\n    if (field is Value.Record(inner)) {\n      // A table with only sub-tables needs no header of its own.\n      if (Maps.size(inner) == 0 || hasPlainKeys(inner)) {\n        Str.append(mutable builder, `\\n[\${name}]\\n`)\n      }\n      const written = writeTable(mutable builder, name, `\${path}.\${key}`, inner, depth + 1)\n      if (written is Err(message)) {\n        return Err(message)\n      }\n    } else if (isTableList(field)) {\n      if (field is Value.List(items)) {\n        let index = 0\n        for (const item of Arrays.values(items)) {\n          if (item is Value.Record(inner)) {\n            Str.append(mutable builder, `\\n[[\${name}]]\\n`)\n            const written = writeTable(\n              mutable builder,\n              name,\n              `\${path}.\${key}[\${Int.toString(index)}]`,\n              inner,\n              depth + 2,\n            )\n            if (written is Err(message)) {\n              return Err(message)\n            }\n          }\n          index += 1\n        }\n      }\n    }\n  }\n  return Ok(true)\n}\n\nfunction writeInline(\n  mutable builder: StringBuilder,\n  path: string,\n  value: Value,\n  depth: int,\n): Result<bool, string> uses alloc {\n  if (depth > MAX_DEPTH && (value is Value.List(_) || value is Value.Record(_))) {\n    return Err(`\${path}: nesting is deeper than 512`)\n  }\n  match (value) {\n    Value.Null => {\n      return Err(`\${path}: TOML has no null`)\n    }\n    Value.Bool(flag) => {\n      if (flag) {\n        Str.append(mutable builder, \"true\")\n      } else {\n        Str.append(mutable builder, \"false\")\n      }\n    }\n    Value.Int(number) => Str.append(mutable builder, Int.toString(number))\n    Value.Float(number) => Str.append(mutable builder, floatText(number))\n    Value.Text(text) => writeString(mutable builder, text)\n    Value.List(items) => {\n      Str.append(mutable builder, \"[\")\n      let index = 0\n      for (const item of Arrays.values(items)) {\n        if (index > 0) {\n          Str.append(mutable builder, \", \")\n        }\n        const written = writeInline(\n          mutable builder,\n          `\${path}[\${Int.toString(index)}]`,\n          item,\n          depth + 1,\n        )\n        if (written is Err(message)) {\n          return Err(message)\n        }\n        index += 1\n      }\n      Str.append(mutable builder, \"]\")\n    }\n    Value.Record(fields) => {\n      if (Maps.size(fields) == 0) {\n        Str.append(mutable builder, \"{}\")\n        return Ok(true)\n      }\n      Str.append(mutable builder, \"{ \")\n      let first = true\n      for (const entry of Maps.entries(fields)) {\n        const #[key, field] = entry\n        if (!first) {\n          Str.append(mutable builder, \", \")\n        }\n        first = false\n        writeKey(mutable builder, key)\n        Str.append(mutable builder, \" = \")\n        const written = writeInline(mutable builder, `\${path}.\${key}`, field, depth + 1)\n        if (written is Err(message)) {\n          return Err(message)\n        }\n      }\n      Str.append(mutable builder, \" }\")\n    }\n  }\n  return Ok(true)\n}\n\n// floatText writes a Float so that it reads back as a Float: inf and nan by\n// name, negative zero as -0.0, and a whole number below 1e15 with \".0\".\nfunction floatText(number: f64): string uses alloc {\n  if (number != number) {\n    return \"nan\"\n  }\n  if (number == 0.0 && Str.startsWith(Float.toString(number), \"-\")) {\n    return \"-0.0\"\n  }\n  if (number - number != 0.0) {\n    if (number > 0.0) {\n      return \"inf\"\n    }\n    return \"-inf\"\n  }\n  if (number > -1000000000000000.0 && number < 1000000000000000.0) {\n    if (Float.truncate(number) is Some(whole)) {\n      if (Float.fromInt(whole) == number) {\n        return `\${Int.toString(whole)}.0`\n      }\n    }\n  }\n  const text = Float.toString(number)\n  if (Str.contains(text, \".\") || Str.contains(text, \"e\")) {\n    return text\n  }\n  return `\${text}.0`\n}\n\n// writeKey writes a key bare when it can be, and quoted otherwise.\nfunction writeKey(mutable builder: StringBuilder, key: string) uses alloc {\n  const length = Str.length(key)\n  let bare = length > 0\n  let index = 0\n  while (bare && index < length) {\n    bare = isBareKeyByte(Str.byteAt(key, index))\n    index += 1\n  }\n  if (bare) {\n    Str.append(mutable builder, key)\n  } else {\n    writeString(mutable builder, key)\n  }\n}\n\nfunction writeString(mutable builder: StringBuilder, text: string) uses alloc {\n  Str.append(mutable builder, \"\\\"\")\n  const length = Str.length(text)\n  // The start of the bytes that need no escape and are not yet copied.\n  let runStart = 0\n  let index = 0\n  while (index < length) {\n    const byte = Str.byteAt(text, index)\n    if (!isControl(byte) && byte != 9 && byte != 34 && byte != 92) {\n      index += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(text, runStart, index))\n    Str.append(mutable builder, escapeByte(byte))\n    index += 1\n    runStart = index\n  }\n  Str.append(mutable builder, cutText(text, runStart, length))\n  Str.append(mutable builder, \"\\\"\")\n}\n\n// The TOML escape for a quote, a backslash or a control character.\nfunction escapeByte(byte: int): string uses alloc {\n  if (byte == 34) {\n    return \"\\\\\\\"\"\n  }\n  if (byte == 92) {\n    return \"\\\\\\\\\"\n  }\n  if (byte == 10) {\n    return \"\\\\n\"\n  }\n  if (byte == 13) {\n    return \"\\\\r\"\n  }\n  if (byte == 9) {\n    return \"\\\\t\"\n  }\n  if (byte == 8) {\n    return \"\\\\b\"\n  }\n  if (byte == 12) {\n    return \"\\\\f\"\n  }\n  const hex = Int.toHex(byte)\n  if (Str.repeat(\"0\", 4 - Str.length(hex)) is Some(padding)) {\n    return `\\\\u\${padding}\${hex}`\n  }\n  return `\\\\u\${hex}`\n}\n"

const STD_UNICODE = "// std/unicode: grapheme clusters, case mapping and display width, Unicode 17.0 (D118 item 3).\n//\n// graphemes splits text into extended grapheme clusters (UAX #29), each a slice\n// of the text. toUpperCase and toLowerCase use the full mappings, with the\n// unconditional rules of SpecialCasing and the final sigma rule, and no locale,\n// as JavaScript without a locale argument. foldCase is full case folding (status\n// C and F), for comparing text without case. displayWidth counts terminal\n// columns per cluster: East Asian Wide and Fullwidth are 2, marks, format and\n// other zero-width characters 0, emoji presentation 2, everything else 1.\n// normalize and isNormalized implement the four normalization forms of UAX #15;\n// Hangul syllables are composed and decomposed by arithmetic.\n//\n// The tables are string constants in std/internal/unicode, written by\n// scripts/unicode/generate.nra; each lookup is a binary search with Str.byteAt.\n// Every function takes the bytes of ASCII text without a lookup.\n\nimport * as Arrays from \"std/array\"\nimport * as Str from \"std/string\"\nimport * as Char from \"std/char\"\nimport * as Tables from \"std/internal/unicode\"\n\n// Grapheme_Cluster_Break values, as the generator writes them.\nconst OTHER = 0\nconst CR = 1\nconst LF = 2\nconst CONTROL = 3\nconst EXTEND = 4\nconst ZWJ = 5\nconst REGIONAL_INDICATOR = 6\nconst PREPEND = 7\nconst SPACING_MARK = 8\nconst HANGUL_L = 9\nconst HANGUL_V = 10\nconst HANGUL_T = 11\nconst HANGUL_LV = 12\nconst HANGUL_LVT = 13\n\n// Indic_Conjunct_Break values.\nconst CONJUNCT_CONSONANT = 1\nconst CONJUNCT_EXTEND = 2\nconst CONJUNCT_LINKER = 3\n\n// Record widths of the tables.\nconst RANGE_WIDTH = 13\nconst GRAPHEME_WIDTH = 14\nconst CASE_RANGE_WIDTH = 19\nconst FULL_MAPPING_WIDTH = 24\n\nconst CAPITAL_SIGMA = 0x3a3\nconst SMALL_SIGMA = 0x3c3\nconst FINAL_SIGMA = 0x3c2\nconst PRESENTATION_SELECTOR = 0xfe0f\n\n// Record widths of the normalization tables.\nconst NORMAL_PROPERTIES_WIDTH = 14\nconst CANONICAL_WIDTH = 15\nconst COMPOSITION_WIDTH = 3\nconst COMPATIBILITY_RANGE_WIDTH = 15\nconst COMPATIBILITY_WIDTH = 9\nconst COMPATIBILITY_DATA_WIDTH = 5\n\n// Quick check bits of the normalization properties, and the answers of quickCheck.\nconst NFD_NO = 1\nconst NFKD_NO = 2\nconst NFC_NO = 4\nconst NFC_MAYBE = 8\nconst NFKC_NO = 16\nconst NFKC_MAYBE = 32\nconst QUICK_YES = 0\nconst QUICK_MAYBE = 1\nconst QUICK_NO = 2\n\n// Hangul syllables and jamo (UAX #15, section 16).\nconst SYLLABLE_BASE = 0xac00\nconst SYLLABLE_COUNT = 11172\nconst LEADING_BASE = 0x1100\nconst LEADING_COUNT = 19\nconst VOWEL_BASE = 0x1161\nconst VOWEL_COUNT = 21\nconst TRAILING_BASE = 0x11a7\nconst TRAILING_COUNT = 28\nconst SYLLABLES_PER_LEADING = 588\n\n// Runs of marks up to this length are sorted by insertion, longer ones by merging.\nconst SHORT_RUN = 8\n\n// The normalization forms of UAX #15: canonical (NFD, NFC) or compatibility\n// (NFKD, NFKC) decomposition, with canonical composition after it in NFC and NFKC.\nexport enum NormalForm derives Show, Equatable {\n  NFC\n  NFD\n  NFKC\n  NFKD\n}\n\n// graphemes yields the extended grapheme clusters of text, in order.\nexport function* graphemes(text: string): Generator<string> uses alloc {\n  const length = Str.length(text)\n  let start = 0\n  // The properties of the code point at start, when the last cluster looked them up.\n  let known = -1\n  while (start < length) {\n    const found = clusterEnd(text, start, length, known)\n    if (Str.slice(text, start, found[0]) is Some(cluster)) {\n      yield cluster\n    }\n    start = found[0]\n    known = found[1]\n  }\n}\n\n// graphemeCount is the number of extended grapheme clusters in text.\nexport function graphemeCount(text: string): int {\n  const length = Str.length(text)\n  let count = 0\n  let start = 0\n  let known = -1\n  while (start < length) {\n    const found = clusterEnd(text, start, length, known)\n    start = found[0]\n    known = found[1]\n    count++\n  }\n  return count\n}\n\n// displayWidth is the number of terminal columns text takes, summed per cluster.\nexport function displayWidth(text: string): int {\n  const length = Str.length(text)\n  let total = 0\n  let start = 0\n  let known = -1\n  while (start < length) {\n    const found = clusterEnd(text, start, length, known)\n    const end = found[0]\n    known = found[1]\n    const first = Str.byteAt(text, start)\n    if (end == start + 1 && first < 128) {\n      // Printable ASCII is one column; control characters take none.\n      if (first >= 32 && first < 127) {\n        total++\n      }\n    } else {\n      total += clusterWidth(text, start, end)\n    }\n    start = end\n  }\n  return total\n}\n\n// toUpperCase maps text to upper case with the full mappings: sharp s (U+00DF) becomes \"SS\".\nexport function toUpperCase(text: string): string uses alloc {\n  return mapCase(text, Tables.UPPER_RANGES, Tables.UPPER_FULL, 97, -32, false)\n}\n\n// toLowerCase maps text to lower case; a capital sigma at the end of a word is final (U+03C2).\nexport function toLowerCase(text: string): string uses alloc {\n  return mapCase(text, Tables.LOWER_RANGES, Tables.LOWER_FULL, 65, 32, true)\n}\n\n// foldCase maps text to its case folding, so foldCase(a) == foldCase(b) compares without case.\nexport function foldCase(text: string): string uses alloc {\n  return mapCase(text, Tables.FOLD_RANGES, Tables.FOLD_FULL, 65, 32, false)\n}\n\n// normalize gives text in the normal form. Text that is already in it,\n// such as any ASCII text, comes back as the same string with no allocation.\nexport function normalize(text: string, form: NormalForm): string uses alloc {\n  const checked = quickCheck(text, form)\n  if (checked[0] == QUICK_YES) {\n    return text\n  }\n  return normalizeFrom(text, checked[1], form)\n}\n\n// isNormalized tells whether normalize would give text back unchanged. The\n// quick check answers most text; only a Maybe answer normalizes and compares.\nexport function isNormalized(text: string, form: NormalForm): bool uses alloc {\n  const checked = quickCheck(text, form)\n  if (checked[0] == QUICK_YES) {\n    return true\n  }\n  if (checked[0] == QUICK_NO) {\n    return false\n  }\n  return normalizeFrom(text, checked[1], form) == text\n}\n\nfunction codePointAt(text: string, position: int): int {\n  return Char.code(Str.charAt(text, position))\n}\n\nfunction hexDigit(byte: int): int {\n  // Digits are 0-9 and a-f.\n  if (byte <= 57) {\n    return byte - 48\n  }\n  return byte - 87\n}\n\nfunction readHex(table: string, offset: int, digits: int): int {\n  let value = 0\n  for (let index = 0; index < digits; index++) {\n    value = value * 16 + hexDigit(Str.byteAt(table, offset + index))\n  }\n  return value\n}\n\n// findRange gives the offset of the range record that holds codePoint, or -1.\nfunction findRange(table: string, width: int, codePoint: int): int\n  requires width > 0\n{\n  let low = 0\n  let high = Str.length(table) / width\n  while (low < high) {\n    const middle = (low + high) / 2\n    const offset = middle * width\n    if (codePoint < readHex(table, offset, 6)) {\n      high = middle\n    } else if (codePoint > readHex(table, offset + 6, 6)) {\n      low = middle + 1\n    } else {\n      return offset\n    }\n  }\n  return -1\n}\n\n// findFull gives the offset of the full mapping record of codePoint, or -1.\nfunction findFull(table: string, codePoint: int): int {\n  let low = 0\n  let high = Str.length(table) / FULL_MAPPING_WIDTH\n  while (low < high) {\n    const middle = (low + high) / 2\n    const offset = middle * FULL_MAPPING_WIDTH\n    const key = readHex(table, offset, 6)\n    if (codePoint < key) {\n      high = middle\n    } else if (codePoint > key) {\n      low = middle + 1\n    } else {\n      return offset\n    }\n  }\n  return -1\n}\n\n// graphemeProperties packs Grapheme_Cluster_Break, Indic_Conjunct_Break (times\n// 16) and Extended_Pictographic (times 64).\nfunction graphemeProperties(codePoint: int): int {\n  if (codePoint < 128) {\n    if (codePoint == 13) {\n      return CR\n    }\n    if (codePoint == 10) {\n      return LF\n    }\n    if (codePoint < 32 || codePoint == 127) {\n      return CONTROL\n    }\n    return OTHER\n  }\n  const offset = findRange(Tables.GRAPHEME, GRAPHEME_WIDTH, codePoint)\n  if (offset < 0) {\n    return OTHER\n  }\n  return readHex(Tables.GRAPHEME, offset + 12, 2)\n}\n\nfunction isControlBreak(value: int): bool {\n  return value == CR || value == LF || value == CONTROL\n}\n\n// clusterEnd gives the end of the cluster that starts at start (UAX #29 rules\n// GB3 to GB999), and the properties of the code point at the end, so the next\n// cluster does not look them up again (-1 when they were not looked up). known\n// holds the properties of the code point at start, or -1.\nfunction clusterEnd(text: string, start: int, length: int, known: int): #[int, int] {\n  const firstByte = Str.byteAt(text, start)\n  const after = start + 1\n  // Two ASCII characters always break, except CR LF.\n  if (firstByte < 128) {\n    if (after >= length) {\n      return #[after, -1]\n    }\n    const nextByte = Str.byteAt(text, after)\n    if (nextByte < 128) {\n      if (firstByte == 13 && nextByte == 10) {\n        return #[after + 1, -1]\n      }\n      return #[after, -1]\n    }\n  }\n  let properties = known\n  if (properties < 0) {\n    properties = graphemeProperties(codePointAt(text, start))\n  }\n  let regionalCount = 0\n  let pictographicRun = false\n  let pictographicJoiner = false\n  let conjunctConsonant = false\n  let conjunctLinker = false\n  let position = start\n  while (true) {\n    // The context the next code point is checked against.\n    const current = properties % 16\n    const conjunct = (properties / 16) % 4\n    if (current == REGIONAL_INDICATOR) {\n      regionalCount++\n    } else {\n      regionalCount = 0\n    }\n    pictographicJoiner = current == ZWJ && pictographicRun\n    pictographicRun = properties >= 64 || (pictographicRun && current == EXTEND)\n    if (conjunct == CONJUNCT_CONSONANT) {\n      conjunctConsonant = true\n      conjunctLinker = false\n    } else if (conjunctConsonant && conjunct == CONJUNCT_LINKER) {\n      conjunctLinker = true\n    } else if (!(conjunctConsonant && conjunct == CONJUNCT_EXTEND)) {\n      conjunctConsonant = false\n      conjunctLinker = false\n    }\n    position = Str.nextChar(text, position)\n    if (position >= length) {\n      return #[length, -1]\n    }\n    const next = graphemeProperties(codePointAt(text, position))\n    const nextBreak = next % 16\n    if (breaksBetween(current, nextBreak)) {\n      // GB9c: a consonant, extends and linkers with at least one linker, then a consonant.\n      const joinsConjunct = (next / 16) % 4 == CONJUNCT_CONSONANT && conjunctLinker\n      // GB11: an emoji, extends and a zero width joiner, then an emoji.\n      const joinsEmoji = next >= 64 && pictographicJoiner\n      // GB12 and GB13: regional indicators pair up.\n      const joinsFlag =\n        current == REGIONAL_INDICATOR && nextBreak == REGIONAL_INDICATOR && regionalCount % 2 == 1\n      if (!joinsConjunct && !joinsEmoji && !joinsFlag) {\n        return #[position, next]\n      }\n    }\n    properties = next\n  }\n  return #[length, -1]\n}\n\n// breaksBetween applies the rules that need only the two break values; the\n// rules with context (GB9c, GB11, GB12, GB13) are checked by the caller.\nfunction breaksBetween(previous: int, current: int): bool {\n  if (previous == CR && current == LF) {\n    return false\n  }\n  if (isControlBreak(previous) || isControlBreak(current)) {\n    return true\n  }\n  if (\n    previous == HANGUL_L &&\n      (current == HANGUL_L || current == HANGUL_V || current == HANGUL_LV || current == HANGUL_LVT)\n  ) {\n    return false\n  }\n  if (\n    (previous == HANGUL_LV || previous == HANGUL_V) && (current == HANGUL_V || current == HANGUL_T)\n  ) {\n    return false\n  }\n  if ((previous == HANGUL_LVT || previous == HANGUL_T) && current == HANGUL_T) {\n    return false\n  }\n  if (current == EXTEND || current == ZWJ || current == SPACING_MARK || previous == PREPEND) {\n    return false\n  }\n  return true\n}\n\n// widthClass is 0 for zero width, 1 for an emoji with text presentation, 2 for wide, 3 otherwise.\nfunction widthClass(codePoint: int): int {\n  const offset = findRange(Tables.WIDTH, RANGE_WIDTH, codePoint)\n  if (offset < 0) {\n    return 3\n  }\n  return readHex(Tables.WIDTH, offset + 12, 1)\n}\n\n// clusterWidth is the widest code point of the cluster; U+FE0F after an emoji makes it 2.\nfunction clusterWidth(text: string, start: int, end: int): int {\n  const firstClass = widthClass(codePointAt(text, start))\n  let width = columnsForClass(firstClass)\n  let position = Str.nextChar(text, start)\n  while (position < end) {\n    const codePoint = codePointAt(text, position)\n    if (codePoint == PRESENTATION_SELECTOR && firstClass == 1) {\n      return 2\n    }\n    const columns = columnsForClass(widthClass(codePoint))\n    if (columns > width) {\n      width = columns\n    }\n    position = Str.nextChar(text, position)\n  }\n  return width\n}\n\nfunction columnsForClass(kind: int): int {\n  if (kind == 0) {\n    return 0\n  }\n  if (kind == 2) {\n    return 2\n  }\n  return 1\n}\n\nfunction appendCodePoint(mutable builder: StringBuilder, codePoint: int) {\n  if (Char.fromCode(codePoint) is Some(character)) {\n    Str.appendChar(mutable builder, character)\n  }\n}\n\nfunction appendSlice(\n  mutable builder: StringBuilder,\n  text: string,\n  start: int,\n  end: int,\n) uses alloc {\n  if (end > start) {\n    if (Str.slice(text, start, end) is Some(piece)) {\n      Str.append(mutable builder, piece)\n    }\n  }\n}\n\n// findMapping gives the single target of codePoint, or -2 - offset for a\n// record of the full table, or -1 when it has no mapping.\nfunction findMapping(ranges: string, full: string, codePoint: int): int {\n  const offset = findRange(ranges, CASE_RANGE_WIDTH, codePoint)\n  if (offset >= 0) {\n    const distance = codePoint - readHex(ranges, offset, 6)\n    // A stride 2 record maps every other code point.\n    if (readHex(ranges, offset + 12, 1) == 1 || distance % 2 == 0) {\n      return readHex(ranges, offset + 13, 6) + distance\n    }\n  }\n  const fullOffset = findFull(full, codePoint)\n  if (fullOffset < 0) {\n    return -1\n  }\n  return -2 - fullOffset\n}\n\nfunction appendMapping(mutable builder: StringBuilder, full: string, mapping: int) {\n  if (mapping >= 0) {\n    appendCodePoint(mutable builder, mapping)\n    return\n  }\n  const fullOffset = -2 - mapping\n  for (let index = 0; index < 3; index++) {\n    const target = readHex(full, fullOffset + 6 + 6 * index, 6)\n    if (target != 0) {\n      appendCodePoint(mutable builder, target)\n    }\n  }\n}\n\n// mapCase copies text with each code point mapped. ASCII letters from\n// asciiFirst to asciiFirst + 25 move by asciiShift without a lookup.\nfunction mapCase(\n  text: string,\n  ranges: string,\n  full: string,\n  asciiFirst: int,\n  asciiShift: int,\n  finalSigma: bool,\n): string uses alloc {\n  const length = Str.length(text)\n  let builder = Str.builder()\n  let changed = false\n  // Bytes from copied up to position are unchanged and not written yet.\n  let copied = 0\n  let position = 0\n  while (position < length) {\n    const byte = Str.byteAt(text, position)\n    if (byte < 128) {\n      if (byte >= asciiFirst && byte < asciiFirst + 26) {\n        appendSlice(mutable builder, text, copied, position)\n        appendCodePoint(mutable builder, byte + asciiShift)\n        changed = true\n        copied = position + 1\n      }\n      position++\n      continue\n    }\n    const next = Str.nextChar(text, position)\n    const codePoint = codePointAt(text, position)\n    if (finalSigma && codePoint == CAPITAL_SIGMA) {\n      appendSlice(mutable builder, text, copied, position)\n      if (isFinalSigma(text, position, next, length)) {\n        appendCodePoint(mutable builder, FINAL_SIGMA)\n      } else {\n        appendCodePoint(mutable builder, SMALL_SIGMA)\n      }\n      changed = true\n      copied = next\n    } else {\n      const mapping = findMapping(ranges, full, codePoint)\n      if (mapping != -1) {\n        appendSlice(mutable builder, text, copied, position)\n        appendMapping(mutable builder, full, mapping)\n        changed = true\n        copied = next\n      }\n    }\n    position = next\n  }\n  if (!changed) {\n    return text\n  }\n  appendSlice(mutable builder, text, copied, length)\n  return Str.build(builder)\n}\n\n// caseContext is 1 for Cased, 2 for Case_Ignorable, 3 for both and 0 for neither.\nfunction caseContext(codePoint: int): int {\n  const offset = findRange(Tables.CASE_CONTEXT, RANGE_WIDTH, codePoint)\n  if (offset < 0) {\n    return 0\n  }\n  return readHex(Tables.CASE_CONTEXT, offset + 12, 1)\n}\n\n// isFinalSigma: a cased letter comes before the sigma and none after it, with\n// only case-ignorable code points between (the Final_Sigma condition).\nfunction isFinalSigma(text: string, position: int, next: int, length: int): bool {\n  let before = position\n  let casedBefore = false\n  while (before > 0) {\n    // Step back to the first byte of the previous code point.\n    before--\n    while (before > 0 && Str.byteAt(text, before) >= 128 && Str.byteAt(text, before) < 192) {\n      before--\n    }\n    // Case-ignorable code points are skipped first, as ICU and V8 do, even when they are also cased.\n    const context = caseContext(codePointAt(text, before))\n    if (context >= 2) {\n      continue\n    }\n    casedBefore = context == 1\n    break\n  }\n  if (!casedBefore) {\n    return false\n  }\n  let after = next\n  while (after < length) {\n    const context = caseContext(codePointAt(text, after))\n    if (context < 2) {\n      return context != 1\n    }\n    after = Str.nextChar(text, after)\n  }\n  return true\n}\n\n// findNormalRange gives the offset of the record of a normalization range\n// table (start and end of 5 digits) that holds codePoint, or -1.\nfunction findNormalRange(table: string, width: int, codePoint: int): int\n  requires width > 0\n{\n  let low = 0\n  let high = Str.length(table) / width\n  while (low < high) {\n    const middle = (low + high) / 2\n    const offset = middle * width\n    if (codePoint < readHex(table, offset, 5)) {\n      high = middle\n    } else if (codePoint > readHex(table, offset + 5, 5)) {\n      low = middle + 1\n    } else {\n      return offset\n    }\n  }\n  return -1\n}\n\n// findNormalKey gives the offset of the record whose first 5 digits are codePoint, or -1.\nfunction findNormalKey(table: string, width: int, codePoint: int): int\n  requires width > 0\n{\n  let low = 0\n  let high = Str.length(table) / width\n  while (low < high) {\n    const middle = (low + high) / 2\n    const offset = middle * width\n    const key = readHex(table, offset, 5)\n    if (codePoint < key) {\n      high = middle\n    } else if (codePoint > key) {\n      low = middle + 1\n    } else {\n      return offset\n    }\n  }\n  return -1\n}\n\n// normalProperties is the combining class plus 256 times the quick check bits.\nfunction normalProperties(codePoint: int): int {\n  const offset = findNormalRange(Tables.NORMAL_PROPERTIES, NORMAL_PROPERTIES_WIDTH, codePoint)\n  if (offset < 0) {\n    return 0\n  }\n  return readHex(Tables.NORMAL_PROPERTIES, offset + 10, 4)\n}\n\nfunction isCompatibilityForm(form: NormalForm): bool {\n  return match (form) {\n    NormalForm.NFC => false\n    NormalForm.NFD => false\n    NormalForm.NFKC => true\n    NormalForm.NFKD => true\n  }\n}\n\nfunction isComposedForm(form: NormalForm): bool {\n  return match (form) {\n    NormalForm.NFC => true\n    NormalForm.NFD => false\n    NormalForm.NFKC => true\n    NormalForm.NFKD => false\n  }\n}\n\n// quickCheckBits gives the No bit and the Maybe bit of the form's quick check.\nfunction quickCheckBits(form: NormalForm): #[int, int] {\n  return match (form) {\n    NormalForm.NFC => #[NFC_NO, NFC_MAYBE]\n    NormalForm.NFD => #[NFD_NO, 0]\n    NormalForm.NFKC => #[NFKC_NO, NFKC_MAYBE]\n    NormalForm.NFKD => #[NFKD_NO, 0]\n  }\n}\n\n// quickCheck runs the quick check of UAX #15 and gives QUICK_YES, QUICK_MAYBE\n// or QUICK_NO, with the byte offset normalizing can start from: the last\n// starter with a Yes answer before the first code point without one. Nothing\n// before that starter changes, and nothing after it composes with what is before.\nfunction quickCheck(text: string, form: NormalForm): #[int, int] {\n  const bits = quickCheckBits(form)\n  const length = Str.length(text)\n  let answer = QUICK_YES\n  let safe = 0\n  let lastClass = 0\n  let position = 0\n  while (position < length) {\n    const byte = Str.byteAt(text, position)\n    if (byte < 128) {\n      // ASCII is a starter with Yes in every form.\n      if (answer == QUICK_YES) {\n        safe = position\n      }\n      lastClass = 0\n      position++\n      continue\n    }\n    const properties = normalProperties(codePointAt(text, position))\n    const combining = properties % 256\n    const check = properties / 256\n    // Marks out of canonical order, or a code point the form never keeps.\n    if ((combining != 0 && lastClass > combining) || (check & bits[0]) != 0) {\n      return #[QUICK_NO, safe]\n    }\n    if ((check & bits[1]) != 0) {\n      answer = QUICK_MAYBE\n    } else if (answer == QUICK_YES && combining == 0) {\n      safe = position\n    }\n    lastClass = combining\n    position = Str.nextChar(text, position)\n  }\n  return #[answer, safe]\n}\n\n// normalizeFrom keeps the bytes of text before start and normalizes the rest.\nfunction normalizeFrom(text: string, start: int, form: NormalForm): string uses alloc {\n  const compatibility = isCompatibilityForm(form)\n  const length = Str.length(text)\n  let points: Array<int> = []\n  let classes: Array<int> = []\n  let position = start\n  while (position < length) {\n    decompose(mutable points, mutable classes, codePointAt(text, position), compatibility)\n    position = Str.nextChar(text, position)\n  }\n  orderMarks(mutable points, mutable classes)\n  let builder = Str.builder()\n  appendSlice(mutable builder, text, 0, start)\n  if (isComposedForm(form)) {\n    for (const point of compose(points, classes)) {\n      appendCodePoint(mutable builder, point)\n    }\n  } else {\n    for (const point of points) {\n      appendCodePoint(mutable builder, point)\n    }\n  }\n  return Str.build(builder)\n}\n\n// decompose appends the full decomposition of codePoint with the combining\n// class of each code point; orderMarks puts the marks in canonical order after.\nfunction decompose(\n  mutable points: Array<int>,\n  mutable classes: Array<int>,\n  codePoint: int,\n  compatibility: bool,\n) uses alloc {\n  if (codePoint < 128) {\n    pushPoint(mutable points, mutable classes, codePoint, 0)\n    return\n  }\n  const properties = normalProperties(codePoint)\n  // The No bit of NFD or NFKD marks every code point with a decomposition.\n  let noBit = NFD_NO\n  if (compatibility) {\n    noBit = NFKD_NO\n  }\n  if (((properties / 256) & noBit) == 0) {\n    pushPoint(mutable points, mutable classes, codePoint, properties % 256)\n    return\n  }\n  if (codePoint >= SYLLABLE_BASE && codePoint < SYLLABLE_BASE + SYLLABLE_COUNT) {\n    const index = codePoint - SYLLABLE_BASE\n    pushPoint(mutable points, mutable classes, LEADING_BASE + index / SYLLABLES_PER_LEADING, 0)\n    pushPoint(\n      mutable points,\n      mutable classes,\n      VOWEL_BASE + (index % SYLLABLES_PER_LEADING) / TRAILING_COUNT,\n      0,\n    )\n    if (index % TRAILING_COUNT != 0) {\n      pushPoint(mutable points, mutable classes, TRAILING_BASE + index % TRAILING_COUNT, 0)\n    }\n    return\n  }\n  const canonical = findNormalKey(Tables.CANONICAL, CANONICAL_WIDTH, codePoint)\n  if (canonical >= 0) {\n    const first = readHex(Tables.CANONICAL, canonical + 5, 5)\n    decompose(mutable points, mutable classes, first, compatibility)\n    const second = readHex(Tables.CANONICAL, canonical + 10, 5)\n    if (second != 0) {\n      decompose(mutable points, mutable classes, second, compatibility)\n    }\n    return\n  }\n  const range = findNormalRange(Tables.COMPATIBILITY_RANGES, COMPATIBILITY_RANGE_WIDTH, codePoint)\n  if (range >= 0) {\n    const distance = codePoint - readHex(Tables.COMPATIBILITY_RANGES, range, 5)\n    const target = readHex(Tables.COMPATIBILITY_RANGES, range + 10, 5) + distance\n    decompose(mutable points, mutable classes, target, compatibility)\n    return\n  }\n  const record = findNormalKey(Tables.COMPATIBILITY, COMPATIBILITY_WIDTH, codePoint)\n  if (record >= 0) {\n    // The next record's offset ends this one's code points.\n    let end = Str.length(Tables.COMPATIBILITY_DATA) / COMPATIBILITY_DATA_WIDTH\n    if (record + COMPATIBILITY_WIDTH < Str.length(Tables.COMPATIBILITY)) {\n      end = readHex(Tables.COMPATIBILITY, record + COMPATIBILITY_WIDTH + 5, 4)\n    }\n    for (let index = readHex(Tables.COMPATIBILITY, record + 5, 4); index < end; index++) {\n      const target = readHex(Tables.COMPATIBILITY_DATA, index * COMPATIBILITY_DATA_WIDTH, 5)\n      decompose(mutable points, mutable classes, target, compatibility)\n    }\n    return\n  }\n  pushPoint(mutable points, mutable classes, codePoint, properties % 256)\n}\n\nfunction pushPoint(\n  mutable points: Array<int>,\n  mutable classes: Array<int>,\n  codePoint: int,\n  combining: int,\n) uses alloc {\n  Arrays.push(mutable points, codePoint)\n  Arrays.push(mutable classes, combining)\n}\n\n// orderMarks puts each run of non-starters in canonical order: a stable sort\n// by combining class, so marks of equal class keep their order.\nfunction orderMarks(mutable points: Array<int>, mutable classes: Array<int>) uses alloc {\n  const total = Arrays.length(points)\n  let start = 0\n  while (start < total) {\n    if (classes[start] == 0) {\n      start++\n      continue\n    }\n    let end = start + 1\n    while (end < total && classes[end] != 0) {\n      end++\n    }\n    // Most runs are one or two marks; a long run takes a merge sort.\n    if (end - start <= SHORT_RUN) {\n      insertMarks(mutable points, mutable classes, start, end)\n    } else {\n      mergeMarks(mutable points, mutable classes, start, end)\n    }\n    start = end\n  }\n}\n\nfunction insertMarks(\n  mutable points: Array<int>,\n  mutable classes: Array<int>,\n  start: int,\n  end: int,\n) {\n  for (let index = start + 1; index < end; index++) {\n    const point = points[index]\n    const combining = classes[index]\n    let position = index\n    while (position > start && classes[position - 1] > combining) {\n      points[position] = points[position - 1]\n      classes[position] = classes[position - 1]\n      position--\n    }\n    points[position] = point\n    classes[position] = combining\n  }\n}\n\n// mergeMarks sorts points[start..end) by class bottom-up, merging runs of\n// width 1, 2, 4 and so on through a buffer; the left item wins a tie.\nfunction mergeMarks(\n  mutable points: Array<int>,\n  mutable classes: Array<int>,\n  start: int,\n  end: int,\n) uses alloc {\n  let bufferPoints: Array<int> = []\n  let bufferClasses: Array<int> = []\n  for (let index = start; index < end; index++) {\n    Arrays.push(mutable bufferPoints, 0)\n    Arrays.push(mutable bufferClasses, 0)\n  }\n  const size = end - start\n  let width = 1\n  while (width < size) {\n    let left = 0\n    while (left < size) {\n      let middle = left + width\n      if (middle > size) {\n        middle = size\n      }\n      let right = middle + width\n      if (right > size) {\n        right = size\n      }\n      // Merge [left, middle) and [middle, right) into the buffer.\n      let first = left\n      let second = middle\n      for (let out = left; out < right; out++) {\n        const takeFirst =\n          first < middle && (second >= right || classes[start + first] <= classes[start + second])\n        if (takeFirst) {\n          bufferPoints[out] = points[start + first]\n          bufferClasses[out] = classes[start + first]\n          first++\n        } else {\n          bufferPoints[out] = points[start + second]\n          bufferClasses[out] = classes[start + second]\n          second++\n        }\n      }\n      left = right\n    }\n    for (let index = 0; index < size; index++) {\n      points[start + index] = bufferPoints[index]\n      classes[start + index] = bufferClasses[index]\n    }\n    width *= 2\n  }\n}\n\n// compose applies canonical composition to decomposed code points: each one\n// joins the last starter when no code point between them blocks it.\nfunction compose(points: Array<int>, classes: Array<int>): Array<int> uses alloc {\n  let result: Array<int> = []\n  // The index in result of the last starter, and the class of the last code point kept.\n  let starter = -1\n  let lastClass = 0\n  for (let index = 0; index < Arrays.length(points); index++) {\n    const point = points[index]\n    const combining = classes[index]\n    if (starter >= 0 && (lastClass < combining || lastClass == 0)) {\n      const composite = composePair(result[starter], point)\n      if (composite >= 0) {\n        result[starter] = composite\n        continue\n      }\n    }\n    if (combining == 0) {\n      starter = Arrays.length(result)\n    }\n    lastClass = combining\n    Arrays.push(mutable result, point)\n  }\n  return result\n}\n\n// composePair gives the primary composite of two code points, or -1.\nfunction composePair(first: int, second: int): int {\n  // A leading and a vowel jamo make an LV syllable; an LV syllable and a trailing jamo an LVT one.\n  const leading = first - LEADING_BASE\n  const vowel = second - VOWEL_BASE\n  if (leading >= 0 && leading < LEADING_COUNT && vowel >= 0 && vowel < VOWEL_COUNT) {\n    return SYLLABLE_BASE + (leading * VOWEL_COUNT + vowel) * TRAILING_COUNT\n  }\n  const syllable = first - SYLLABLE_BASE\n  const trailing = second - TRAILING_BASE\n  if (\n    syllable >= 0 &&\n      syllable < SYLLABLE_COUNT &&\n      syllable % TRAILING_COUNT == 0 &&\n      trailing > 0 &&\n      trailing < TRAILING_COUNT\n  ) {\n    return first + trailing\n  }\n  let low = 0\n  let high = Str.length(Tables.COMPOSITION) / COMPOSITION_WIDTH\n  while (low < high) {\n    const middle = (low + high) / 2\n    const record = readHex(Tables.COMPOSITION, middle * COMPOSITION_WIDTH, 3) * CANONICAL_WIDTH\n    const recordFirst = readHex(Tables.CANONICAL, record + 5, 5)\n    const recordSecond = readHex(Tables.CANONICAL, record + 10, 5)\n    if (first < recordFirst || (first == recordFirst && second < recordSecond)) {\n      high = middle\n    } else if (first > recordFirst || second > recordSecond) {\n      low = middle + 1\n    } else {\n      return readHex(Tables.CANONICAL, record, 5)\n    }\n  }\n  return -1\n}\n"

export function stdSourceFor(path: string): string {
  if (path == "std/arena") {
    return STD_ARENA
  }
  if (path == "std/args") {
    return STD_ARGS
  }
  if (path == "std/async") {
    return STD_ASYNC
  }
  if (path == "std/async/file") {
    return STD_ASYNC__FILE
  }
  if (path == "std/async/net") {
    return STD_ASYNC__NET
  }
  if (path == "std/async/time") {
    return STD_ASYNC__TIME
  }
  if (path == "std/build") {
    return STD_BUILD
  }
  if (path == "std/cell") {
    return STD_CELL
  }
  if (path == "std/coroutine") {
    return STD_COROUTINE
  }
  if (path == "std/cstring") {
    return STD_CSTRING
  }
  if (path == "std/ext/array") {
    return STD_EXT__ARRAY
  }
  if (path == "std/ext/float") {
    return STD_EXT__FLOAT
  }
  if (path == "std/ext/int") {
    return STD_EXT__INT
  }
  if (path == "std/ext/string") {
    return STD_EXT__STRING
  }
  if (path == "std/fixedarray") {
    return STD_FIXEDARRAY
  }
  if (path == "std/hash") {
    return STD_HASH
  }
  if (path == "std/internal/unicode") {
    return STD_INTERNAL__UNICODE
  }
  if (path == "std/iterator") {
    return STD_ITERATOR
  }
  if (path == "std/json") {
    return STD_JSON
  }
  if (path == "std/math") {
    return STD_MATH
  }
  if (path == "std/option") {
    return STD_OPTION
  }
  if (path == "std/random") {
    return STD_RANDOM
  }
  if (path == "std/regex") {
    return STD_REGEX
  }
  if (path == "std/shape") {
    return STD_SHAPE
  }
  if (path == "std/terminal") {
    return STD_TERMINAL
  }
  if (path == "std/time") {
    return STD_TIME
  }
  if (path == "std/toml") {
    return STD_TOML
  }
  if (path == "std/unicode") {
    return STD_UNICODE
  }
  return ""
}
