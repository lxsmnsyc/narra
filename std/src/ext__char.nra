// std/char: code points and ASCII classes. The conversion functions are built into the compiler.
//
// The classes cover ASCII only: a character above U+007F is in none of them, and
// isWhitespace is true for the six ASCII white space characters that Str.trim removes.

import * as Char from "std/char"

// Tells whether the character is an ASCII digit, `0` to `9`.
export function isDigit(character: char): bool {
  const code = Char.code(character)
  return code >= 48 && code <= 57
}

// Tells whether the character is an ASCII capital letter, `A` to `Z`. Letters outside ASCII
// give false.
export function isUpper(character: char): bool {
  const code = Char.code(character)
  return code >= 65 && code <= 90
}

// Tells whether the character is an ASCII small letter, `a` to `z`. Letters outside ASCII give
// false.
export function isLower(character: char): bool {
  const code = Char.code(character)
  return code >= 97 && code <= 122
}

// Tells whether the character is an ASCII letter. Letters outside ASCII give false.
export function isLetter(character: char): bool {
  return isUpper(character) || isLower(character)
}

// Tells whether the character is an ASCII letter or digit.
export function isAlphanumeric(character: char): bool {
  return isLetter(character) || isDigit(character)
}

// Tells whether the character is ASCII white space: space, tab, line feed, vertical tab, form
// feed or carriage return.
export function isWhitespace(character: char): bool {
  const code = Char.code(character)
  return code == 32 || (code >= 9 && code <= 13)
}
