// Higher-order functions used from another module.

export struct Handler {
  name: string
  run: (x: int) => int
}

export function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

export function map<T, U>(items: Array<T>, f: (item: T) => U): Array<U> {
  let out: Array<U> = []
  for (const item of Array.values(items)) {
    Array.push(mutable out, f(item))
  }
  return out
}

export function twice(escaping f: (x: int) => int): (x: int) => int {
  return (x) => f(f(x))
}

export function handler(name: string, escaping f: (x: int) => int): Handler {
  return Handler { name: name, run: f }
}

export function double(x: int): int {
  return x * 2
}

// A private function with the same name as one in cl/main, so the thunks
// of both must get different C names.
function inc(x: int): int {
  return x + 1
}

export function incValue(): (x: int) => int {
  return inc
}
