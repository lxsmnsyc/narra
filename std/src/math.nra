// std/math: the usual number functions. The float functions are the ones of C's math.h.

import * as Float from "std/float"
import * as Libm from "std/internal/math"

/// The ratio of a circle's circumference to its diameter, to `f64` precision.
export const PI: f64 = 3.141592653589793
/// The base of the natural logarithm, to `f64` precision.
export const E: f64 = 2.718281828459045

/// Gives the absolute value of an `int`. The smallest `int` has no positive counterpart and comes back unchanged.
export function abs(value: int): int {
  if (value < 0) {
    return 0 - value
  }
  return value
}

/// Gives the absolute value of an `f64`.
export function absFloat(value: f64): f64 {
  if (value < 0.0) {
    return 0.0 - value
  }
  return value
}

/// Gives the smaller of two values, or `first` when they are equal.
export function min<T: Ordered>(first: T, second: T): T from first {
  return match (Ordered.compare(second, first)) { Ordering.Less => copy(second), _ => first }
}

/// Gives the larger of two values, or `first` when they are equal.
export function max<T: Ordered>(first: T, second: T): T from first {
  return match (Ordered.compare(second, first)) { Ordering.Greater => copy(second), _ => first }
}

/// Limits `value` to the range from `low` to `high`. Gives `None` when `low` is above `high`.
export function clamp<T: Ordered>(value: T, low: T, high: T): Option<T> from value {
  if (Ordered.compare(low, high) is Ordering.Greater) {
    return None
  }
  return Some(min(max(value, low), high))
}

/// Raises `base` to the power `exponent`.
export function pow(base: f64, exponent: f64): f64 {
  return Libm.pow(base, exponent)
}

/// Raises an `int` to a whole power. Gives `None` for a negative exponent, and the result wraps when it overflows.
export function powInt(base: int, exponent: int): Option<int> {
  if (exponent < 0) {
    return None
  }
  let result = 1
  let factor = base
  let remaining = exponent
  while (remaining > 0) {
    if (remaining % 2 == 1) {
      result *= factor
    }
    remaining /= 2
    if (remaining > 0) {
      factor *= factor
    }
  }
  return Some(result)
}

/// Gives the square root. A negative value gives NaN.
export function sqrt(value: f64): f64 {
  return Float.sqrt(value)
}

/// Rounds down to the nearest whole number.
export function floor(value: f64): f64 {
  return Libm.floor(value)
}

/// Rounds up to the nearest whole number.
export function ceil(value: f64): f64 {
  return Libm.ceil(value)
}

/// Rounds to the nearest whole number, with halves away from zero, so `round(-2.5)` is -3.
export function round(value: f64): f64 {
  return Libm.round(value)
}

/// Drops the fraction, rounding toward zero.
export function trunc(value: f64): f64 {
  return Libm.trunc(value)
}

/// Gives the sine of an angle in radians.
export function sin(value: f64): f64 {
  return Libm.sin(value)
}

/// Gives the cosine of an angle in radians.
export function cos(value: f64): f64 {
  return Libm.cos(value)
}

/// Gives the tangent of an angle in radians.
export function tan(value: f64): f64 {
  return Libm.tan(value)
}

/// Gives the angle in radians, from -pi to pi, of the point (`x`, `y`). It takes `y` first.
export function atan2(y: f64, x: f64): f64 {
  return Libm.atan2(y, x)
}

/// Raises `E` to the power `value`.
export function exp(value: f64): f64 {
  return Libm.exp(value)
}

/// Gives the natural logarithm. 0 gives `-inf` and a negative value gives NaN.
export function log(value: f64): f64 {
  return Libm.log(value)
}
