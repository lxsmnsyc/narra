import * as Int from "std/int"

function noisy() {
  print("hi")
}

export function load(): int {
  noisy()
  return 1
}

export function build(n: int): string {
  return `n=${Int.toString(n)}`
}

export function table(): int {
  const m = Map { "a": 1 }
  return 1
}

export function strict(f: (x: int) => int): int {
  return f(1)
}

export function run(args: Array<string>): int {
  const loud = (x: int): int => {
    print("hi")
    return x
  }
  return strict(loud)
}
