// The statement checker, ported from compiler/internal/narra/check_stmt.go
// (block, stmt, ifStmt, diverges, isResult; lvalueRoot is
// findAssignedLocal in exprs.nra). Locals go into the current body's
// tables (D70) through declareLocal; block scopes are pushScope and
// popScope (check.nra).
import { Pos, Expr, Stmt, Block, TypeExpr, Pattern, YieldBinding } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Fix, createFix, createEdit, insertAt, sliceCharacters } from "narrac/fixes"
import { Type } from "narrac/types"
import {
  isConditional,
  Checker,
  BlockContext,
  Ref,
  Walker,
  findLocal,
  reportError,
  reportErrorFix,
  typeString,
  declareLocal,
  pushScope,
  popScope,
  getLocal,
  getRef,
  getNodeType,
  setNodeType,
  unsupported,
  getExpressionId,
  getExpressionPos,
  BindingKind,
  setBinding,
  isContentsType,
} from "narrac/check"
import { resolveType, findTupleType } from "narrac/resolve"
import {
  checkExpression,
  expectType,
  checkConstWrite,
  checkNoMutableEscape,
  findAssignedLocal,
  findRootName,
  checkContentsChange,
  describePlace,
  collectAssignedInExpr,
  collectAssignedInBlock,
} from "narrac/exprs"
import { checkIs, checkMatch, checkDestructure } from "narrac/match"
import {
  getPatternId,
  collectPatternLocals,
  bindPatternLocals,
  findNarrowable,
  setNarrowed,
  endNarrowing,
  findOtherVariant,
  areArgumentsIrrefutable,
} from "narrac/patterns"
import * as Arrays from "std/array"
import * as Str from "std/string"
import * as Int from "std/int"
import * as Ranges from "std/range"

// checkBlock checks the statements of a block in a scope of their own.
export function checkBlock<W: Walker>(
  mutable checker: Checker,
  walker: W,
  block: Block,
) uses alloc {
  pushScope(mutable checker)
  for (const statement of Arrays.values(block.statements)) {
    checkStatement(mutable checker, walker, statement)
  }
  popScope(mutable checker)
}

export function checkStatement<W: Walker>(
  mutable checker: Checker,
  walker: W,
  statement: Stmt,
) uses alloc {
  // The emitter runs `mutable` calls before the rest of the statement, so a
  // read of the local anywhere in the statement may see the new value.
  match (statement) {
    Stmt.VarStmt(_, _, _, _, _, _, value) => endExpressionNarrowing(mutable checker, value)
    Stmt.AssignStmt(_, target, value) => {
      endExpressionNarrowing(mutable checker, target)
      endExpressionNarrowing(mutable checker, value)
    }
    Stmt.ExprStmt(_, expression) => endExpressionNarrowing(mutable checker, expression)
    Stmt.ReturnStmt(_, value) => {
      if (value is Some(returned)) {
        endExpressionNarrowing(mutable checker, returned)
      }
    }
    Stmt.IfStmt(_, condition, _, _) => endExpressionNarrowing(mutable checker, condition)
    Stmt.ForStmt(_, _, _, _, iterable, _) => endExpressionNarrowing(mutable checker, iterable)
    Stmt.YieldStmt(_, value, _, _) => endExpressionNarrowing(mutable checker, value)
    _ => {}
  }
  match (statement) {
    Stmt.BlockStmt(block) => checkBlock(mutable checker, walker, block)
    Stmt.VarStmt(nodeId, pos, isMutable, name, pattern, type, value) => checkVariable(
      mutable checker,
      walker,
      nodeId,
      pos,
      isMutable,
      name,
      pattern,
      type,
      value,
    )
    Stmt.AssignStmt(pos, target, value) => checkAssignment(
      mutable checker,
      walker,
      pos,
      target,
      value,
    )
    Stmt.ExprStmt(pos, expression) => checkExpressionStatement(
      mutable checker,
      walker,
      pos,
      expression,
    )
    Stmt.ReturnStmt(pos, value) => checkReturn(mutable checker, walker, pos, value)
    Stmt.IfStmt(_, condition, then, orElse) => checkIf(
      mutable checker,
      walker,
      condition,
      then,
      orElse,
    )
    Stmt.WhileStmt(pos, label, condition, body) => checkWhile(
      mutable checker,
      walker,
      pos,
      label,
      condition,
      body,
    )
    Stmt.ForStmt(nodeId, pos, label, name, iterable, body) => checkFor(
      mutable checker,
      walker,
      nodeId,
      pos,
      label,
      name,
      iterable,
      body,
    )
    Stmt.BreakStmt(pos, label) => checkLoopExit(
      mutable checker,
      pos,
      label,
      "break",
      "E0233",
      "break must be inside a loop",
    )
    Stmt.ContinueStmt(pos, label) => checkLoopExit(
      mutable checker,
      pos,
      label,
      "continue",
      "E0234",
      "continue must be inside a loop",
    )
    Stmt.YieldStmt(pos, value, delegate, binding) => checkYield(
      mutable checker,
      walker,
      pos,
      value,
      delegate,
      binding,
    )
  }
  checkMutableConflicts(mutable checker, statement)
}

// checkLoopExit checks a break or continue, with or without a label.
function checkLoopExit(
  mutable checker: Checker,
  pos: Pos,
  label: string,
  word: string,
  code: string,
  message: string,
) uses alloc {
  const blockCount = Arrays.length(checker.blocks)
  if (blockCount > 0) {
    // Inside a block expression only its own loops can be left. The loops
    // outside it, also outside an enclosing block expression, are out of reach.
    let reaches = checker.loops == 0 && hasOuterLoops(checker)
    if (label != "") {
      reaches = !hasLabel(checker.labels, label) && hasOuterLabel(checker, label)
    }
    if (reaches) {
      reportError(
        mutable checker,
        pos,
        "E0932",
        `${word} cannot leave a block expression; it can only leave a loop inside the block`,
      )
      return
    }
  }
  if (label == "") {
    if (checker.loops == 0) {
      reportError(mutable checker, pos, code, message)
    }
    return
  }
  for (const name of Arrays.values(checker.labels)) {
    if (name == label) {
      return
    }
  }
  reportError(mutable checker, pos, "E0916", `no enclosing loop is labeled "${label}"`)
}

// hasOuterLoops reports whether a loop encloses a block expression being checked.
function hasOuterLoops(checker: Checker): bool {
  for (const context of Arrays.values(checker.blocks)) {
    if (context.loops > 0) {
      return true
    }
  }
  return false
}

// hasOuterLabel reports whether a loop labeled label encloses a block
// expression being checked.
function hasOuterLabel(checker: Checker, label: string): bool {
  for (const context of Arrays.values(checker.blocks)) {
    if (hasLabel(context.labels, label)) {
      return true
    }
  }
  return false
}

function hasLabel(labels: Array<string>, label: string): bool {
  for (const name of Arrays.values(labels)) {
    if (name == label) {
      return true
    }
  }
  return false
}

// withoutLast copies a list of labels without its last one.
function withoutLast(labels: Array<string>): Array<string> uses alloc {
  let kept: Array<string> = []
  for (const i of Ranges.upTo(Arrays.length(labels) - 1)) {
    Arrays.push(mutable kept, labels[i])
  }
  return kept
}

// enterLoop opens a loop body; its label is in scope inside the body only.
function enterLoop(mutable checker: Checker, pos: Pos, label: string) uses alloc {
  checker.loops = checker.loops + 1
  if (label == "") {
    return
  }
  if (hasLabel(checker.labels, label) || hasOuterLabel(checker, label)) {
    reportError(
      mutable checker,
      pos,
      "E0917",
      `label "${label}" is already used by an enclosing loop`,
    )
  }
  Arrays.push(mutable checker.labels, label)
}

function leaveLoop(mutable checker: Checker, label: string) uses alloc {
  checker.loops = checker.loops - 1
  if (label != "") {
    checker.labels = withoutLast(checker.labels)
  }
}

function checkCondition<W: Walker>(
  mutable checker: Checker,
  walker: W,
  condition: Expr,
) uses alloc {
  const found = checkExpression(mutable checker, walker, condition, Some(Type.TBool))
  expectType(mutable checker, getExpressionPos(condition), Some(Type.TBool), found)
}

function checkVariable<W: Walker>(
  mutable checker: Checker,
  walker: W,
  nodeId: int,
  pos: Pos,
  isMutable: bool,
  name: string,
  pattern: Option<Pattern>,
  type: Option<TypeExpr>,
  value: Expr,
) uses alloc {
  if (pattern is Some(declaredPattern)) {
    checkDestructure(mutable checker, walker, isMutable, declaredPattern, type, value)
    return
  }

  // The annotation, when written, is the variable's type.
  let want: Option<Type> = None
  if (type is Some(typeExpression)) {
    want = Some(resolveType(mutable checker, typeExpression))
  }
  const errorCount = Arrays.length(checker.errors)
  let found = checkExpression(mutable checker, walker, value, want)
  if (want is Some(declared)) {
    expectType(mutable checker, getExpressionPos(value), want, found)
    found = declared
  }

  // A value whose check already failed is void; do not report it twice.
  if (found == Type.TVoid && Arrays.length(checker.errors) == errorCount) {
    reportError(mutable checker, pos, "E0225", "this expression has no value")
  }
  const local = declareLocal(mutable checker, nodeId, pos, name, found, isMutable, false)
  setBinding(mutable checker, local, value, BindingKind.Plain)
}

function checkAssignment<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  target: Expr,
  value: Expr,
) uses alloc {
  // A write through a constant is reported before the target is checked.
  if (checkConstWrite(mutable checker, pos, target)) {
    checkExpression(mutable checker, walker, value, None)
    return
  }

  // Writing a local does not read it. A mutable parameter is an output the
  // caller sees, so a write to it counts as a use.
  let writtenLocal = -1
  let wasUsed = false
  if (target is Expr.Ident(_, targetPos, targetName)) {
    const found = findLocal(checker, targetName)
    if (found >= 0 && !(getLocal(checker, found).param && getLocal(checker, found).isMutable)) {
      writtenLocal = found
      wasUsed = getLocal(checker, found).used
      // The fix of an unused local renames the assignments too.
      Arrays.push(mutable checker.bodies[checker.body].locals[found].writes, targetPos)
    }
  }
  checker.assigningId = getExpressionId(target)
  const targetType = checkExpression(mutable checker, walker, target, None)
  checker.assigningId = -1
  if (writtenLocal >= 0) {
    const body = checker.body
    checker.bodies[body].locals[writtenLocal].used = wasUsed
  }

  // The root of the target must be a `let` variable.
  const root = findAssignedLocal(checker, target)
  if (root < 0) {
    reportError(
      mutable checker,
      pos,
      "E0226",
      "only variables, fields and array elements can be assigned",
    )
  } else if (target is Expr.Ident(_, _, _)) {
    // A whole assignment changes the name: only a `let` can.
    const local = getLocal(checker, root)
    if (local.param && local.isMutable) {
      reportError(
        mutable checker,
        pos,
        "E0949",
        `mutable parameter ${quoteGo(local.name)} cannot be assigned whole; \`mutable\` reaches its fields and elements, so return the new value instead`,
      )
    } else if (!local.isMutable) {
      reportError(
        mutable checker,
        pos,
        "E0227",
        `${quoteGo(local.name)} is constant; declare it with \`let\` to change it`,
      )
    }
  } else {
    // A field or element write changes the contents (D81).
    checkContentsChange(mutable checker, pos, root, target, false)
  }
  // Storing a mutable parameter in a field or element is an escape.
  if (!(target is Expr.Ident(_, _, _))) {
    checkNoMutableEscape(mutable checker, value)
  }
  const valueType = checkExpression(mutable checker, walker, value, Some(targetType))
  // The effect pass tracks what a local holds, so a function assigned to a
  // local adds its effects to the local instead of having to fit its type.
  checker.looseFunctions = target is Expr.Ident(_, _, _)
  expectType(mutable checker, getExpressionPos(value), Some(targetType), valueType)
  checker.looseFunctions = false
  endNarrowing(mutable checker, root)
}

function checkExpressionStatement<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  expression: Expr,
) uses alloc {
  if (expression is Expr.MatchExpr(_, matchPos, subject, arms)) {
    checkMatch(mutable checker, walker, matchPos, subject, arms, None, false)
    return
  }
  if (isConditional(expression)) {
    reportError(
      mutable checker,
      getExpressionPos(expression),
      "E0934",
      "the value of a conditional expression must be used; write an `if` statement instead",
    )
    return
  }
  checkExpression(mutable checker, walker, expression, None)

  // Only a call can stand alone, and a Result it returns must be used.
  if (expression is Expr.CallExpr(nodeId, _, _, _, _)) {
    if (getNodeType(checker, nodeId) is Some(found)) {
      if (isResult(checker, found)) {
        reportError(
          mutable checker,
          pos,
          "E0229",
          "this call returns a Result that is not checked; handle it, or discard it with `const _ = ...`",
        )
      }
    }
  } else {
    reportError(mutable checker, pos, "E0228", "this expression does nothing")
  }
}

function checkReturn<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  value: Option<Expr>,
) uses alloc {
  // Inside a block expression a return ends the block and gives its value.
  if (Arrays.length(checker.blocks) > 0) {
    checkBlockReturn(mutable checker, walker, pos, value)
    return
  }
  // A return in a generator ends it and takes no value.
  if (checker.generator) {
    if (value is Some(_)) {
      reportError(
        mutable checker,
        pos,
        "E0292",
        "return in a generator takes no value; yield the value, then return",
      )
    }
    return
  }
  // An arrow function whose result is inferred takes any value; the
  // returns are compared once its block is checked (closures.nra).
  if (checker.inferring) {
    if (value is Some(inferred)) {
      checkNoMutableEscape(mutable checker, inferred)
      checkExpression(mutable checker, walker, inferred, None)
    }
    return
  }
  const want = checker.resultType
  if (value is Some(expression)) {
    checkNoMutableEscape(mutable checker, expression)
    const found = checkExpression(mutable checker, walker, expression, Some(want))
    if (want == Type.TVoid) {
      reportError(mutable checker, pos, "E0231", "this function returns nothing")
      return
    }
    expectType(mutable checker, getExpressionPos(expression), Some(want), found)
  } else if (want != Type.TVoid) {
    const text = typeString(checker, want)
    reportError(mutable checker, pos, "E0230", `this function must return a ${text}`)
  }
}

// checkBlockExpression checks a block in value position. Its value is the
// common type of its returns, and every path must end in a return (Go's
// blockExpr).
export function checkBlockExpression<W: Walker>(
  mutable checker: Checker,
  walker: W,
  expression: Expr,
  want: Option<Type>,
): Type uses alloc {
  if (expression is Expr.BlockExpr(_, pos, block)) {
    return checkBlockBody(mutable checker, walker, pos, block, want)
  }
  return Type.TVoid
}

// checkBlockBody checks a block as a block expression (Go's blockBody). A
// match arm written as a block in value position uses it too.
export function checkBlockBody<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  block: Block,
  want: Option<Type>,
): Type uses alloc {
  const context = BlockContext {
    result: want,
    returns: 0,
    loops: checker.loops,
    labels: checker.labels,
    cond: block.pos.line != pos.line || block.pos.column != pos.column,
    reported: false,
  }
  Arrays.push(mutable checker.blocks, context)
  checker.loops = 0
  checker.labels = []
  checkBlock(mutable checker, walker, block)
  const finished = checker.blocks[Arrays.length(checker.blocks) - 1]
  checker.loops = context.loops
  checker.labels = context.labels
  checker.blocks = withoutLastBlock(checker.blocks)
  if (finished.returns == 0) {
    reportError(
      mutable checker,
      pos,
      "E0933",
      "a block expression needs `return value`; Narra has no object literals, so write a struct literal such as `Point { x: 1 }`",
    )
    return Type.TVoid
  }
  if (!endsInReturn(block)) {
    reportError(
      mutable checker,
      pos,
      "E0931",
      "a block expression must end every path with `return value`",
    )
  }
  if (finished.result is Some(found)) {
    return found
  }
  return Type.TVoid
}

// withoutLastBlock copies a list of block contexts without its last one.
function withoutLastBlock(blocks: Array<BlockContext>): Array<BlockContext> uses alloc {
  let kept: Array<BlockContext> = []
  for (const i of Ranges.upTo(Arrays.length(blocks) - 1)) {
    Arrays.push(mutable kept, blocks[i])
  }
  return kept
}

// checkBlockReturn checks a return inside a block expression (Go's blockReturn).
function checkBlockReturn<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  value: Option<Expr>,
) uses alloc {
  const last = Arrays.length(checker.blocks) - 1
  checker.blocks[last].returns = checker.blocks[last].returns + 1
  if (value is Some(expression)) {
    checkNoMutableEscape(mutable checker, expression)
    const expected = checker.blocks[last].result
    const errorCount = Arrays.length(checker.errors)
    const found = checkExpression(mutable checker, walker, expression, expected)
    if (found == Type.TVoid) {
      // A value whose check already failed is void; do not report it twice.
      if (Arrays.length(checker.errors) == errorCount) {
        if (checker.blocks[last].cond) {
          if (!checker.blocks[last].reported) {
            checker.blocks[last].reported = true
            reportError(
              mutable checker,
              pos,
              "E0934",
              "both branches of a conditional expression must have a value",
            )
          }
        } else {
          reportError(
            mutable checker,
            pos,
            "E0931",
            "a block expression must end every path with `return value`",
          )
        }
      }
      return
    }
    if (expected is Some(_)) {
      expectType(mutable checker, getExpressionPos(expression), expected, found)
    } else {
      checker.blocks[last].result = Some(found)
    }
  } else {
    reportError(
      mutable checker,
      pos,
      "E0931",
      "a block expression must end every path with `return value`",
    )
  }
}

// endsInReturn reports whether every path through a block ends in a return
// or a panic.
function endsInReturn(block: Block): bool {
  const count = Arrays.length(block.statements)
  if (count == 0) {
    return false
  }
  return statementEndsInReturn(block.statements[count - 1])
}

function statementEndsInReturn(statement: Stmt): bool {
  return match (statement) {
    Stmt.ReturnStmt(_, _) => true
    Stmt.BlockStmt(block) => endsInReturn(block)
    Stmt.IfStmt(_, _, then, orElse) => ifEndsInReturn(then, orElse)
    Stmt.ExprStmt(_, expression) => isPanicCall(expression) || matchEndsInReturn(expression)
    _ => false
  }
}

function ifEndsInReturn(then: Block, orElse: Option<Stmt>): bool {
  if (orElse is Some(other)) {
    return endsInReturn(then) && statementEndsInReturn(other)
  }
  return false
}

// matchEndsInReturn is true for a match statement whose every arm ends in a
// return or a panic.
function matchEndsInReturn(expression: Expr): bool {
  if (expression is Expr.MatchExpr(_, _, _, arms)) {
    if (Arrays.length(arms) == 0) {
      return false
    }
    for (const arm of Arrays.values(arms)) {
      if (arm.block is Some(armBlock)) {
        if (!endsInReturn(armBlock)) {
          return false
        }
      } else if (arm.body is Some(armBody)) {
        if (!isPanicCall(armBody)) {
          return false
        }
      } else {
        return false
      }
    }
    return true
  }
  return false
}

// checkIf checks an if statement. A condition that is an `is` test may bind
// names for the then branch and narrows the subject, when it is a `const`
// local, in the branches (Go's ifStmt).
function checkIf<W: Walker>(
  mutable checker: Checker,
  walker: W,
  condition: Expr,
  then: Block,
  orElse: Option<Stmt>,
) uses alloc {
  // The whole condition may be an `is` test, the only place that binds.
  let testPattern: Option<Pattern> = None
  let subject = -1
  if (condition is Expr.IsExpr(testId, testPos, testSubject, pattern)) {
    const found = checkIs(mutable checker, walker, testPos, testSubject, pattern, true)
    setNodeType(mutable checker, testId, found)
    expectType(mutable checker, testPos, Some(Type.TBool), found)
    testPattern = Some(pattern)
    subject = findNarrowable(checker, testSubject)
  } else {
    checkCondition(mutable checker, walker, condition)
  }

  // The variant the test names, when its pattern is a constructor or name.
  let enumIndex = -1
  let variantIndex = -1
  if (testPattern is Some(testedPattern)) {
    if (getRef(checker, getPatternId(testedPattern)) is Ref.Constructor(testEnum, testVariant)) {
      enumIndex = testEnum
      variantIndex = testVariant
    }
  }
  if (subject < 0) {
    variantIndex = -1
  }

  // The then branch sees the bindings and the narrowed subject.
  pushScope(mutable checker)
  if (testPattern is Some(boundPattern)) {
    let locals: Array<int> = []
    collectPatternLocals(checker, boundPattern, mutable locals)
    bindPatternLocals(mutable checker, locals)
  }
  if (variantIndex >= 0) {
    setNarrowed(mutable checker, subject, variantIndex)
  }
  for (const statement of Arrays.values(then.statements)) {
    checkStatement(mutable checker, walker, statement)
  }
  popScope(mutable checker)

  // Where the test failed, a two-variant enum holds the other variant,
  // unless the pattern also tested the fields (`x is Some(1)`).
  let otherVariant = findOtherVariant(checker, enumIndex, variantIndex)
  if (testPattern is Some(fieldPattern)) {
    if (!areArgumentsIrrefutable(checker, fieldPattern)) {
      otherVariant = -1
    }
  }
  if (orElse is Some(other)) {
    pushScope(mutable checker)
    if (otherVariant >= 0) {
      setNarrowed(mutable checker, subject, otherVariant)
    }
    checkStatement(mutable checker, walker, other)
    popScope(mutable checker)
  } else if (otherVariant >= 0 && diverges(then)) {
    setNarrowed(mutable checker, subject, otherVariant)
  }
}

function checkWhile<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  label: string,
  condition: Expr,
  body: Block,
) uses alloc {
  endLoopNarrowing(mutable checker, Some(condition), body)
  checkCondition(mutable checker, walker, condition)
  enterLoop(mutable checker, pos, label)
  checkBlock(mutable checker, walker, body)
  leaveLoop(mutable checker, label)
}

function checkFor<W: Walker>(
  mutable checker: Checker,
  walker: W,
  nodeId: int,
  pos: Pos,
  label: string,
  name: string,
  iterable: Expr,
  body: Block,
) uses alloc {
  // The iterable is a call of a std function that gives the element type.
  const outerLine = checker.forSourceLine
  const outerColumn = checker.forSourceColumn
  const sourcePos = getExpressionPos(iterable)
  checker.forSourceLine = sourcePos.line
  checker.forSourceColumn = sourcePos.column
  const iterableType = checkExpression(mutable checker, walker, iterable, None)
  checker.forSourceLine = outerLine
  checker.forSourceColumn = outerColumn
  let builtin = ""
  let firstArgument = Type.TVoid
  if (iterable is Expr.CallExpr(callId, _, _, _, arguments)) {
    if (getRef(checker, callId) is Ref.Builtin(index)) {
      builtin = checker.registry.functions[index].name
    }
    if (Arrays.length(arguments) > 0) {
      if (getNodeType(checker, getExpressionId(arguments[0].value)) is Some(argumentType)) {
        firstArgument = argumentType
      }
    }
  }
  endLoopNarrowing(mutable checker, None, body)
  let element = Type.TVoid
  if (builtin == "Range.upTo" || builtin == "Range.between") {
    element = Type.TInt
  } else if (builtin == "Array.values" || builtin == "Array.entries") {
    element = Type.TVoid
    if (firstArgument is Type.TArray(arrayElement)) {
      element = arrayElement
      if (builtin == "Array.entries") {
        element = findTupleType(mutable checker, [Type.TInt, arrayElement])
      }
    }
  } else if (builtin == "Map.keys" || builtin == "Map.entries") {
    element = Type.TVoid
    if (iterableType is Type.TArray(arrayElement)) {
      element = arrayElement
    }
  } else if (iterableType is Type.TGenerator(generatorElement, _, _, _, generatorInput)) {
    element = generatorElement
    if (generatorInput != Type.TVoid) {
      reportError(
        mutable checker,
        getExpressionPos(iterable),
        "E0293",
        "for ... of cannot iterate a coroutine, which needs an input on each resume; call Co.resume(mutable g, input)",
      )
    }
  } else if (iterableType is Type.TRange) {
    // A Range value: its bounds are read once, before the loop.
    element = Type.TInt
  } else if (iterableType is Type.TArray(arrayElement)) {
    // An array value, as with Array.values.
    element = arrayElement
  } else {
    const text = typeString(checker, iterableType)
    reportError(
      mutable checker,
      getExpressionPos(iterable),
      "E0232",
      `for ... of needs a Range, an Array, a Generator, Str.chars, Array.entries, Map.keys or Map.entries, found ${text}`,
    )
  }

  // The loop variable lives in a scope around the body. It is a copy of an
  // element, so it is read-only; the hint of a write names the source.
  pushScope(mutable checker)
  const local = declareLocal(mutable checker, nodeId, pos, name, element, false, false)
  const bodyIndex = checker.body
  checker.bodies[bodyIndex].locals[local].binding = BindingKind.Loop
  let source = iterable
  if (builtin == "Array.values" || builtin == "Array.entries") {
    if (iterable is Expr.CallExpr(_, _, _, _, sourceArguments)) {
      if (Arrays.length(sourceArguments) > 0) {
        source = sourceArguments[0].value
      }
    }
  }
  // Only an array place can be written through by index.
  if (findAssignedLocal(checker, source) >= 0) {
    if (getNodeType(checker, getExpressionId(source)) is Some(Type.TArray(sourceElement))) {
      checker.bodies[bodyIndex].locals[local].loopSource = describePlace(source)
      checker.bodies[bodyIndex].locals[local].loopContents = isContentsType(checker, sourceElement)
    }
  }
  enterLoop(mutable checker, pos, label)
  checkBlock(mutable checker, walker, body)
  leaveLoop(mutable checker, label)
  popScope(mutable checker)
}

// checkYield checks `yield value` and `yield* other` (Go's yieldStmt). Both
// are valid only directly in a function* body or its nested statement
// blocks: not in an arrow function and not in a block expression.
function checkYield<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  value: Expr,
  delegate: bool,
  binding: Option<YieldBinding>,
) uses alloc {
  let word = "yield"
  if (delegate) {
    word = "yield*"
  }
  let place = ""
  if (checker.bodies[checker.body].arrowDepth > 0) {
    place = "inside an arrow function"
  } else if (!checker.generator) {
    place = "outside a generator"
  } else if (Arrays.length(checker.blocks) > 0) {
    place = "inside a block expression"
  }
  if (place != "") {
    reportError(
      mutable checker,
      pos,
      "E0291",
      `${word} cannot be used ${place}; it is valid only directly in a function* body`,
    )
    checkExpression(mutable checker, walker, value, None)
    declareYieldInput(mutable checker, binding, Type.TVoid)
    return
  }
  const result = checker.resultType
  if (result is Type.TGenerator(element, _, _, _, input)) {
    if (binding is Some(_) && input == Type.TVoid) {
      const functionName = checker.functions[checker.functionIndex].name
      reportError(
        mutable checker,
        pos,
        "E0293",
        `the value of yield is available only in a coroutine; declare ${functionName} as Coroutine<In, Out>, or write \`yield value\` without a name`,
      )
    }
    if (delegate && input != Type.TVoid) {
      reportError(
        mutable checker,
        pos,
        "E0293",
        "yield* is not valid in a coroutine; a delegated generator has no input to receive",
      )
      checkExpression(mutable checker, walker, value, None)
      return
    }
    if (!delegate) {
      const found = checkExpression(mutable checker, walker, value, Some(element))
      expectType(mutable checker, getExpressionPos(value), Some(element), found)
      declareYieldInput(mutable checker, binding, input)
      return
    }
    const found = checkExpression(mutable checker, walker, value, None)
    let matches = false
    if (found is Type.TGenerator(otherElement, _, _, _, _)) {
      matches = otherElement == element
    }
    if (!matches && found != Type.TVoid) {
      const wanted = typeString(checker, Type.TGenerator(element, [], -1, -1, Type.TVoid))
      const text = typeString(checker, found)
      reportError(
        mutable checker,
        getExpressionPos(value),
        "E0291",
        `yield* needs a ${wanted}, found ${text}`,
      )
    }
    return
  }
  // The return type was rejected already.
  checkExpression(mutable checker, walker, value, None)
  declareYieldInput(mutable checker, binding, Type.TVoid)
}

// declareYieldInput declares the local of `const input = yield value`.
function declareYieldInput(
  mutable checker: Checker,
  binding: Option<YieldBinding>,
  type: Type,
) uses alloc {
  if (binding is Some(bound)) {
    declareLocal(mutable checker, bound.id, bound.pos, bound.name, type, bound.isMutable, false)
  }
}

// isResult reports a Result value, which a statement may not drop.
export function isResult(checker: Checker, valueType: Type): bool {
  if (valueType is Type.TEnum(index)) {
    return checker.enums[index].name == "Result" &&
      Arrays.length(checker.enums[index].arguments) == 2
  }
  return false
}

// diverges reports whether a block always leaves by return, break,
// continue or panic.
export function diverges(block: Block): bool {
  const count = Arrays.length(block.statements)
  if (count == 0) {
    return false
  }
  return statementDiverges(block.statements[count - 1])
}

function statementDiverges(statement: Stmt): bool {
  return match (statement) {
    Stmt.ReturnStmt(_, _) => true
    Stmt.BreakStmt(_, _) => true
    Stmt.ContinueStmt(_, _) => true
    Stmt.ExprStmt(_, expression) => isPanicCall(expression)
    Stmt.IfStmt(_, _, then, orElse) => ifDiverges(then, orElse)
    Stmt.BlockStmt(block) => diverges(block)
    _ => false
  }
}

function isPanicCall(expression: Expr): bool {
  if (expression is Expr.CallExpr(_, _, callee, _, _)) {
    if (callee is Expr.Ident(_, _, name)) {
      return name == "panic"
    }
  }
  return false
}

function ifDiverges(then: Block, orElse: Option<Stmt>): bool {
  if (orElse is Some(other)) {
    return diverges(then) && statementDiverges(other)
  }
  return false
}

// endLoopNarrowing ends the narrowing of every local that the condition or
// the body of a loop assigns or passes as `mutable`: the next iteration sees
// the changed value. Names are matched without scopes, which can only end
// more narrowing than needed (Go's endLoopNarrowing).
function endLoopNarrowing(
  mutable checker: Checker,
  condition: Option<Expr>,
  body: Block,
) uses alloc {
  let names: Array<string> = []
  if (condition is Some(testExpression)) {
    collectAssignedInExpr(testExpression, mutable names)
  }
  collectAssignedInBlock(body, mutable names)
  for (const name of Arrays.values(names)) {
    const local = findLocal(checker, name)
    endNarrowing(mutable checker, local)
  }
}

// endExpressionNarrowing ends the narrowing of every local that an
// expression passes as `mutable` (Go's endExprNarrowing).
function endExpressionNarrowing(mutable checker: Checker, expression: Expr) uses alloc {
  let names: Array<string> = []
  collectAssignedInExpr(expression, mutable names)
  for (const name of Arrays.values(names)) {
    const local = findLocal(checker, name)
    endNarrowing(mutable checker, local)
  }
}

const USE_READ = 0
const USE_ASSIGN = 1
const USE_MUTABLE = 2

// One place in a match arm, on one side of && or ||, or at one statement of
// a block. Uses in different arms of one node never run together. A block
// has a negative node (-1, -2, ...) from UseCollector.blocks.
struct ArmStep {
  node: int
  arm: int
  isMatch: bool // an arm of a match or a block expression
  calls: int // how many calls enclosed the step when it began
}

// One use of a local in a statement's expressions (Go's localUse). For a
// mutable use, call is the id of the call it is an argument of; chain holds
// the ids of the calls whose arguments contain the use.
struct LocalUse {
  local: int
  pos: Pos
  kind: int
  call: int
  chain: Array<int>
  arms: Array<ArmStep>
  order: int
  calleeOf: int // the call whose callee holds the use, or -1
  hoist: bool // the call can move to its own statement (Go's hoist)
}

// found are the uses in evaluation order. calls keeps each call by id, for the
// fix that moves one. blocked counts the places the walk is in where a call
// cannot move to its own statement: the right side of && and ||, a match arm,
// and the statements of a block expression.
struct UseCollector {
  found: Array<LocalUse>
  blocks: int
  calls: Map<int, Expr>
  blocked: int
}

function extendCalls(chain: Array<int>, callId: int): Array<int> uses alloc {
  let inner: Array<int> = []
  for (const id of Arrays.values(chain)) {
    Arrays.push(mutable inner, id)
  }
  Arrays.push(mutable inner, callId)
  return inner
}

function extendArms(
  arms: Array<ArmStep>,
  node: int,
  arm: int,
  isMatch: bool,
  calls: int,
): Array<ArmStep> uses alloc {
  let extended: Array<ArmStep> = []
  for (const step of Arrays.values(arms)) {
    Arrays.push(mutable extended, step)
  }
  Arrays.push(mutable extended, ArmStep { node: node, arm: arm, isMatch: isMatch, calls: calls })
  return extended
}

function addUse(
  mutable collector: UseCollector,
  local: int,
  pos: Pos,
  kind: int,
  call: int,
  chain: Array<int>,
  arms: Array<ArmStep>,
) uses alloc {
  const order = Arrays.length(collector.found)
  const canHoist = collector.blocked == 0
  Arrays.push(mutable collector.found, LocalUse {
    local: local,
    pos: pos,
    kind: kind,
    call: call,
    chain: chain,
    arms: arms,
    order: order,
    calleeOf: -1,
    hoist: canHoist,
  })
}

// collectRootUse records the local at the root of an assignable expression
// and walks the index expressions on the way (Go's useCollector.root).
function collectRootUse(
  checker: Checker,
  mutable collector: UseCollector,
  expression: Expr,
  kind: int,
  call: int,
  chain: Array<int>,
  arms: Array<ArmStep>,
) uses alloc {
  match (expression) {
    Expr.Ident(nodeId, pos, _) => {
      if (getRef(checker, nodeId) is Ref.Local(local)) {
        addUse(mutable collector, local, pos, kind, call, chain, arms)
      }
    }
    Expr.FieldExpr(_, _, target, _) => {
      if (findAssignedLocal(checker, expression) >= 0) {
        collectRootUse(checker, mutable collector, target, kind, call, chain, arms)
      } else {
        collectUses(checker, mutable collector, target, chain, arms)
      }
    }
    Expr.IndexExpr(_, _, target, index) => {
      collectRootUse(checker, mutable collector, target, kind, call, chain, arms)
      collectUses(checker, mutable collector, index, chain, arms)
    }
    _ => collectUses(checker, mutable collector, expression, chain, arms)
  }
}

function collectUsesOf(
  checker: Checker,
  mutable collector: UseCollector,
  expressions: Array<Expr>,
  chain: Array<int>,
  arms: Array<ArmStep>,
) uses alloc {
  for (const expression of Arrays.values(expressions)) {
    collectUses(checker, mutable collector, expression, chain, arms)
  }
}

// collectUses walks an expression in evaluation order (Go's useCollector.walk).
function collectUses(
  checker: Checker,
  mutable collector: UseCollector,
  expression: Expr,
  chain: Array<int>,
  arms: Array<ArmStep>,
) uses alloc {
  match (expression) {
    Expr.Ident(nodeId, pos, _) => {
      if (getRef(checker, nodeId) is Ref.Local(local)) {
        addUse(mutable collector, local, pos, USE_READ, -1, chain, arms)
      }
    }
    Expr.FieldExpr(_, _, target, _) => collectUses(checker, mutable collector, target, chain, arms)
    Expr.IndexExpr(_, _, target, index) => {
      collectUses(checker, mutable collector, target, chain, arms)
      collectUses(checker, mutable collector, index, chain, arms)
    }
    Expr.IsExpr(_, _, subject, _) => collectUses(checker, mutable collector, subject, chain, arms)
    Expr.UnaryExpr(_, _, _, operand) => collectUses(
      checker,
      mutable collector,
      operand,
      chain,
      arms,
    )
    Expr.BinaryExpr(nodeId, _, operator, left, right) => {
      if (operator == "&&" || operator == "||") {
        // The left side is finished before the right side starts.
        collectUses(
          checker,
          mutable collector,
          left,
          chain,
          extendArms(arms, nodeId, 0, false, Arrays.length(chain)),
        )
        collector.blocked = collector.blocked + 1
        collectUses(
          checker,
          mutable collector,
          right,
          chain,
          extendArms(arms, nodeId, 1, false, Arrays.length(chain)),
        )
        collector.blocked = collector.blocked - 1
      } else {
        collectUses(checker, mutable collector, left, chain, arms)
        collectUses(checker, mutable collector, right, chain, arms)
      }
    }
    Expr.CallExpr(nodeId, _, callee, _, arguments) => {
      // A mutable argument that is also the function called is reported by
      // the closure check, so the callee's uses are marked.
      const inner = extendCalls(chain, nodeId)
      collector.calls[nodeId] = expression
      const first = Arrays.length(collector.found)
      collectUses(checker, mutable collector, callee, chain, arms)
      markCallee(mutable collector, first, nodeId)
      for (const argument of Arrays.values(arguments)) {
        if (argument.isMutable) {
          collectRootUse(
            checker,
            mutable collector,
            argument.value,
            USE_MUTABLE,
            nodeId,
            inner,
            arms,
          )
        } else {
          collectUses(checker, mutable collector, argument.value, inner, arms)
        }
      }
    }
    Expr.TemplateLit(_, _, parts) => collectUsesOf(checker, mutable collector, parts, chain, arms)
    Expr.StructLit(_, _, _, _, fields, spread) => {
      for (const field of Arrays.values(fields)) {
        collectUses(checker, mutable collector, field.value, chain, arms)
      }
      if (spread is Some(source)) {
        collectUses(checker, mutable collector, source, chain, arms)
      }
    }
    Expr.ArrayLit(_, _, elements, _) => collectUsesOf(
      checker,
      mutable collector,
      elements,
      chain,
      arms,
    )
    Expr.MapLit(_, _, _, keys, values) => {
      for (const i of Ranges.upTo(Arrays.length(keys))) {
        collectUses(checker, mutable collector, keys[i], chain, arms)
        collectUses(checker, mutable collector, values[i], chain, arms)
      }
    }
    Expr.BlockExpr(nodeId, _, block) => {
      // A block expression is one value. checkExclusive looks inside it too,
      // but its statements run one after the other.
      collectBlockUses(
        checker,
        mutable collector,
        block,
        chain,
        extendArms(arms, nodeId, 0, true, Arrays.length(chain)),
      )
    }
    Expr.MatchExpr(nodeId, _, subject, matchArms) => {
      // The subject is finished before the first arm starts.
      collectUses(
        checker,
        mutable collector,
        subject,
        chain,
        extendArms(arms, nodeId, -1, false, Arrays.length(chain)),
      )
      collector.blocked = collector.blocked + 1
      for (const i of Ranges.upTo(Arrays.length(matchArms))) {
        const armSteps = extendArms(arms, nodeId, i, true, Arrays.length(chain))
        if (matchArms[i].guard is Some(guard)) {
          collectUses(checker, mutable collector, guard, chain, armSteps)
        }
        if (matchArms[i].body is Some(armBody)) {
          collectUses(checker, mutable collector, armBody, chain, armSteps)
        }
        if (matchArms[i].block is Some(armBlock)) {
          collectBlockUses(checker, mutable collector, armBlock, chain, armSteps)
        }
      }
      collector.blocked = collector.blocked - 1
    }
    _ => {}
  }
}

// collectBlockUses walks the statements of a block inside an expression,
// such as a match arm. The statements run one after the other, so each has a
// step of its own (Go's useCollector.block).
function collectBlockUses(
  checker: Checker,
  mutable collector: UseCollector,
  block: Block,
  chain: Array<int>,
  arms: Array<ArmStep>,
) uses alloc {
  collector.blocks = collector.blocks + 1
  collector.blocked = collector.blocked + 1
  const blockNode = -collector.blocks
  for (const i of Ranges.upTo(Arrays.length(block.statements))) {
    const steps = extendArms(arms, blockNode, i, false, Arrays.length(chain))
    collectStatementUses(checker, mutable collector, block.statements[i], chain, steps)
  }
  collector.blocked = collector.blocked - 1
}

function collectStatementUses(
  checker: Checker,
  mutable collector: UseCollector,
  statement: Stmt,
  chain: Array<int>,
  arms: Array<ArmStep>,
) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => collectBlockUses(checker, mutable collector, block, chain, arms)
    Stmt.VarStmt(_, _, _, _, _, _, value) => collectUses(
      checker,
      mutable collector,
      value,
      chain,
      arms,
    )
    Stmt.AssignStmt(_, target, value) => {
      collectRootUse(checker, mutable collector, target, USE_ASSIGN, -1, chain, arms)
      collectUses(checker, mutable collector, value, chain, arms)
    }
    Stmt.ExprStmt(_, expression) => collectUses(checker, mutable collector, expression, chain, arms)
    Stmt.ReturnStmt(_, value) => {
      if (value is Some(returned)) {
        collectUses(checker, mutable collector, returned, chain, arms)
      }
    }
    Stmt.IfStmt(_, condition, then, orElse) => {
      // The condition is finished before the branches start.
      collector.blocks = collector.blocks + 1
      const stepNode = -collector.blocks
      collectUses(
        checker,
        mutable collector,
        condition,
        chain,
        extendArms(arms, stepNode, 0, false, Arrays.length(chain)),
      )
      collectBlockUses(
        checker,
        mutable collector,
        then,
        chain,
        extendArms(arms, stepNode, 1, false, Arrays.length(chain)),
      )
      // The two branches never run together.
      if (orElse is Some(other)) {
        collectStatementUses(
          checker,
          mutable collector,
          other,
          chain,
          extendArms(arms, stepNode, 2, false, Arrays.length(chain)),
        )
      }
    }
    Stmt.WhileStmt(_, _, condition, body) => {
      collector.blocks = collector.blocks + 1
      const stepNode = -collector.blocks
      collectUses(
        checker,
        mutable collector,
        condition,
        chain,
        extendArms(arms, stepNode, 0, false, Arrays.length(chain)),
      )
      collectBlockUses(
        checker,
        mutable collector,
        body,
        chain,
        extendArms(arms, stepNode, 1, false, Arrays.length(chain)),
      )
    }
    Stmt.ForStmt(_, _, _, _, iterable, body) => {
      collector.blocks = collector.blocks + 1
      const stepNode = -collector.blocks
      collectUses(
        checker,
        mutable collector,
        iterable,
        chain,
        extendArms(arms, stepNode, 0, false, Arrays.length(chain)),
      )
      collectBlockUses(
        checker,
        mutable collector,
        body,
        chain,
        extendArms(arms, stepNode, 1, false, Arrays.length(chain)),
      )
    }
    Stmt.YieldStmt(_, value, _, _) => collectUses(checker, mutable collector, value, chain, arms)
    _ => {}
  }
}

function markCallee(mutable collector: UseCollector, first: int, callId: int) uses alloc {
  for (const i of Ranges.between(first, Arrays.length(collector.found))) {
    if (collector.found[i].calleeOf < 0) {
      collector.found[i].calleeOf = callId
    }
  }
}

function chainHas(chain: Array<int>, callId: int): bool {
  for (const id of Arrays.values(chain)) {
    if (id == callId) {
      return true
    }
  }
  return false
}

// isInsideCall tells whether a use is in the arguments of a call and not in a
// match arm there: checkExclusive reports those (Go's insideCall).
function isInsideCall(use: LocalUse, callId: int): bool {
  for (const i of Ranges.upTo(Arrays.length(use.chain))) {
    if (use.chain[i] != callId) {
      continue
    }
    for (const step of Arrays.values(use.arms)) {
      if (step.isMatch && step.calls > i) {
        return false
      }
    }
    return true
  }
  return false
}

function inDifferentArms(first: Array<ArmStep>, second: Array<ArmStep>): bool {
  for (const left of Arrays.values(first)) {
    for (const right of Arrays.values(second)) {
      if (left.node == right.node && left.arm != right.arm) {
        return true
      }
    }
  }
  return false
}

// findCallStart is where a call's text begins: the start of its callee.
function findCallStart(expression: Expr): Pos {
  return match (expression) {
    Expr.FieldExpr(_, _, target, _) => findCallStart(target)
    Expr.IndexExpr(_, _, target, _) => findCallStart(target)
    Expr.CallExpr(_, _, callee, _, _) => findCallStart(callee)
    _ => getExpressionPos(expression)
  }
}

// findStatementPos is the position of a statement that can hold a call.
function findStatementPos(statement: Stmt): Pos {
  return match (statement) {
    Stmt.VarStmt(_, pos, _, _, _, _, _) => pos
    Stmt.AssignStmt(pos, _, _) => pos
    Stmt.ExprStmt(pos, _) => pos
    Stmt.ReturnStmt(pos, _) => pos
    _ => Pos { line: 0, column: 0 }
  }
}

// isBlankText is true for text of spaces and tabs only.
function isBlankText(characters: Array<char>, first: int, last: int): bool {
  for (const index of Ranges.between(first, last)) {
    const character = characters[index]
    if (character != ' ' && character != '\t' && character != '\r') {
      return false
    }
  }
  return true
}

// buildHoistFix binds a `mutable` call to a fresh const on the line before its
// statement and puts the name in its place (Go's hoistFix). It needs the
// source text, a statement that starts its line and a call that returns a
// value.
function buildHoistFix(
  checker: Checker,
  statement: Stmt,
  callId: int,
  call: Expr,
): Array<Fix> uses alloc {
  const scope = checker.scopes[checker.current]
  if (!scope.isSource || Str.length(scope.facts.source) == 0) {
    return []
  }
  let end = Pos { line: 0, column: 0 }
  if (scope.facts.callEnds[callId] is Some(callEnd)) {
    end = callEnd
  } else {
    return []
  }
  if (getNodeType(checker, callId) is Some(Type.TVoid)) {
    return []
  }
  const start = findCallStart(call)
  if (start.line != end.line || start.column == 1) {
    return []
  }
  const statementPos = findStatementPos(statement)
  const lines = Str.split(scope.facts.source, "\n")
  if (
    statementPos.line < 1 ||
      statementPos.line > Arrays.length(lines) ||
      start.line > Arrays.length(lines)
  ) {
    return []
  }
  const statementLine = Str.chars(lines[statementPos.line - 1])
  if (statementPos.column - 1 > Arrays.length(statementLine)) {
    return []
  }
  if (!isBlankText(statementLine, 0, statementPos.column - 1)) {
    return []
  }
  const indent = sliceCharacters(statementLine, 0, statementPos.column - 1)
  const callLine = Str.chars(lines[start.line - 1])
  if (end.column - 1 > Arrays.length(callLine)) {
    return []
  }
  const text = sliceCharacters(callLine, start.column - 1, end.column - 1)
  // The name comes from the function called, and gets a number while a local
  // already has it.
  let base = "result"
  if (call is Expr.CallExpr(_, _, callee, _, _)) {
    if (callee is Expr.Ident(_, _, calleeName)) {
      base = `${calleeName}Result`
    } else if (callee is Expr.FieldExpr(_, _, _, calleeName)) {
      base = `${calleeName}Result`
    }
  }
  let name = base
  let number = 2
  while (findLocal(checker, name) >= 0) {
    name = `${base}${Int.toString(number)}`
    number = number + 1
  }
  const lineStart = Pos { line: statementPos.line, column: 1 }
  return [
    createFix(
      "bind the call to a const before the statement",
      [insertAt(lineStart, `${indent}const ${name} = ${text}\n`), createEdit(start, end, name)],
    ),
  ]
}

// checkMutableConflicts rejects a statement whose expressions pass a local as
// `mutable` and also use it anywhere else, at any depth (Go's
// checkMutableConflicts, E0929). Uses inside the arguments of the call
// itself belong to checkExclusive. It runs after the statement is checked.
function checkMutableConflicts(mutable checker: Checker, statement: Stmt) uses alloc {
  let collector = UseCollector { found: [], blocks: 0, calls: Map {}, blocked: 0 }
  let isFixable = true
  const noCalls: Array<int> = []
  const noArms: Array<ArmStep> = []
  match (statement) {
    Stmt.VarStmt(_, _, _, _, _, _, value) => collectUses(
      checker,
      mutable collector,
      value,
      noCalls,
      noArms,
    )
    Stmt.AssignStmt(_, target, value) => {
      collectRootUse(checker, mutable collector, target, USE_ASSIGN, -1, noCalls, noArms)
      collectUses(checker, mutable collector, value, noCalls, noArms)
    }
    Stmt.ExprStmt(_, expression) => collectUses(
      checker,
      mutable collector,
      expression,
      noCalls,
      noArms,
    )
    Stmt.ReturnStmt(_, value) => {
      if (value is Some(returned)) {
        collectUses(checker, mutable collector, returned, noCalls, noArms)
      }
    }
    Stmt.IfStmt(_, condition, _, _) => {
      isFixable = false
      collectUses(checker, mutable collector, condition, noCalls, noArms)
    }
    Stmt.WhileStmt(_, _, condition, _) => {
      isFixable = false
      collectUses(checker, mutable collector, condition, noCalls, noArms)
    }
    Stmt.ForStmt(_, _, _, _, iterable, _) => {
      isFixable = false
      collectUses(checker, mutable collector, iterable, noCalls, noArms)
    }
    Stmt.YieldStmt(_, value, _, _) => {
      isFixable = false
      collectUses(checker, mutable collector, value, noCalls, noArms)
    }
    _ => {}
  }
  let reported: Array<int> = []
  for (const use of Arrays.values(collector.found)) {
    if (chainHas(reported, use.local)) {
      continue
    }
    for (const other of Arrays.values(collector.found)) {
      if (other.order == use.order || other.local != use.local || other.kind != USE_MUTABLE) {
        continue
      }
      if (use.kind == USE_MUTABLE && other.order > use.order) {
        continue
      }
      if (
        (use.calleeOf >= 0 && chainHas(other.chain, use.calleeOf)) ||
          inDifferentArms(use.arms, other.arms) ||
          isInsideCall(use, other.call)
      ) {
        continue
      }
      if (use.kind == USE_MUTABLE && isInsideCall(other, use.call)) {
        continue
      }
      Arrays.push(mutable reported, use.local)
      const localName = getLocal(checker, use.local).name
      let fixes: Array<Fix> = []
      if (isFixable && other.hoist) {
        if (collector.calls[other.call] is Some(call)) {
          fixes = buildHoistFix(checker, statement, other.call, call)
        }
      }
      reportErrorFix(
        mutable checker,
        use.pos,
        "E0929",
        fixes,
        `${quoteGo(localName)} is passed as mutable in one call, so the rest of the expression cannot use it`,
      )
      break
    }
  }
}
