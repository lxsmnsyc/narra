// error: Arrays.push(mutable items, ...) may change items, which ends[0][] still holds until its block ends at line 11; no fix is offered here: copy the value by hand where the sharing starts, or end the sharing before the write
import * as Arrays from "std/array"
import * as Channels from "std/channel"

export function run(_args: Array<string>): int uses io, alloc {
  const ends = Channels.create<Array<int>>(2)
  let items = [1, 2, 3]
  Channels.send(ends[0], items)
  Arrays.push(mutable items, 4)
  return Arrays.length(items)
}
