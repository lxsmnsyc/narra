// std/hash: hashing. `of` is the hash of a Hashable value and may change between builds.
// `fnv1a` is FNV-1a 64 over the UTF-8 bytes of a string and never changes.

import * as Str from "std/string"
import * as U64 from "std/u64"
import * as Ranges from "std/range"

const FNV_OFFSET: u64 = 14695981039346656037
const FNV_PRIME: u64 = 1099511628211

export function of<T: Hashable>(value: T): int {
  return Hashable.hash(value)
}

export function fnv1a(text: string): u64 {
  let state = FNV_OFFSET
  const length = Str.length(text)
  for (const index of Ranges.upTo(length)) {
    state = (state ^ U64.wrap(Str.byteAt(text, index))) * FNV_PRIME
  }
  return state
}
