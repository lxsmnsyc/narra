// A thread changes its copy of a captured array in place. The array is
// shared, so the write copies it first: the parent's array is unchanged.
import * as Thread from "std/thread"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

function changeFirst(words: Array<string>): string uses alloc {
  let mine = copy(words)
  mine[0] = "changed"
  Arrays.push(mutable mine, "added")
  return Str.join(mine, " ")
}

export function run(_args: Array<string>): int {
  const words = [`a${Int.toString(1)}`, "b", "c"]
  const changed = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => changeFirst(words))
    return Thread.join(worker)
  })
  print(`thread: ${changed}`)
  print(`parent: ${Str.join(words, " ")}`)
  return 0
}
