// Generated by TestStdSources from std/src. Do not edit:
// NARRA_UPDATE=1 go test -run TestStdSources rewrites it.

const STD_OPTION = "// std/option: helpers over the prelude Option.\n\nexport function map<T, U, effect E>(option: Option<T>, f: (value: T) => U uses E): Option<U> uses alloc, E {\n  return match (option) {\n    Some(value) => Some(f(value))\n    None => None\n  }\n}\n\nexport function andThen<T, U, effect E>(option: Option<T>, f: (value: T) => Option<U> uses E): Option<U> uses E {\n  return match (option) {\n    Some(value) => f(value)\n    None => None\n  }\n}\n\nexport function withDefault<T>(option: Option<T>, fallback: T): T {\n  return match (option) {\n    Some(value) => value\n    None => fallback\n  }\n}\n\nexport function orElse<T, effect E>(option: Option<T>, f: () => Option<T> uses E): Option<T> uses E {\n  return match (option) {\n    Some(_) => option\n    None => f()\n  }\n}\n\nexport function isSome<T>(option: Option<T>): bool {\n  return option is Some(_)\n}\n\nexport function isNone<T>(option: Option<T>): bool {\n  return option is None\n}\n\nexport function okOr<T, F>(option: Option<T>, error: F): Result<T, F> uses alloc {\n  return match (option) {\n    Some(value) => Ok(value)\n    None => Err(error)\n  }\n}\n"

// stdSourceFor is the Narra text of a std source module, or "" when the
// module is a builtin one.
export function stdSourceFor(path: string): string {
  if (path == "std/option") {
    return STD_OPTION
  }
  return ""
}
