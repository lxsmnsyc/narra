enum Shape {
  Circle(radius: int)
  Rect(width: int, height: int)
  Dot
}

struct Point {
  x: int
  y: int
}

enum Other {
  Circle(radius: int)
}

function unknownVariant(shape: Shape): int {
  return match (shape) {
    Shape.Triangle(side) => side
    _ => 0
  }
}

function unknownBare(shape: Shape): int {
  return match (shape) {
    Triangle => 1
    _ => 0
  }
}

function arity(shape: Shape): int {
  return match (shape) {
    Shape.Rect(width) => width
    _ => 0
  }
}

function wrongEnum(shape: Shape): int {
  return match (shape) {
    Other.Circle(radius) => radius
    _ => 0
  }
}

function notEnum(count: int): int {
  return match (count) {
    Shape.Circle(radius) => radius
    Big => 1
    _ => 0
  }
}

function duplicate(shape: Shape): int {
  return match (shape) {
    Shape.Rect(side, side) => side
    _ => 0
  }
}

function shadow(count: int, shape: Shape): int {
  return match (shape) {
    Shape.Circle(count) => count
    _ => 0
  }
}

function unqualified(shape: Shape): int {
  return match (shape) {
    Circle(radius) => radius
    _ => 0
  }
}

function structPatterns(point: Point, count: int): int {
  const a = match (point) {
    { z } => 1
    { x, x: again } => 2
    _ => 3
  }
  const b = match (count) {
    { x } => 1
    _ => 2
  }
  const c = match (count) {
    #[first, second] => 1
    _ => 2
  }
  const d = match (point) {
    #[first, second] => 1
    _ => 2
  }
  return a + b + c + d
}

function literalPatterns(point: Point, text: string): int {
  const a = match (point) {
    1 => 1
    _ => 2
  }
  const b = match (text) {
    1 => 1
    _ => 2
  }
  return a + b
}

function refutable(shape: Shape, point: Point): int {
  const Shape.Circle(radius) = shape
  const { x, y: 1 } = point
  return radius + x
}

function bindsInTest(shape: Shape): bool {
  const found = shape is Shape.Circle(radius)
  if (shape is Shape.Circle(radius) && radius > 1) {
    return true
  }
  return found
}

function voidSubject(): int {
  return match (print("x")) {
    _ => 1
  }
}
