// Tagged templates with raw parts: a Template.Raw tag of the program,
// Template.raw at run time and in a top-level constant computed while
// compiling, and a part that spans two lines.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Template from "std/template"
import { Raw } from "std/template"

const DIGITS = Template.raw`\d+\${x}`

function count(parts: Raw, values: Array<int>): string {
  const texts = Raw.toArray(parts)
  let lengths: Array<string> = []
  for (const text of Arrays.values(texts)) {
    Arrays.push(mutable lengths, Int.toString(Str.length(text)))
  }
  return `${Str.join(lengths, "+")} chars, ${Int.toString(Arrays.length(values))} values`
}

export function run(_args: Array<string>): int {
  const name = "x"
  print(DIGITS)
  print(Template.raw`\d+\${x}`)
  print(Template.raw`a\n${name}\t\u{41}`)
  print(Template.raw`first
second ${name}`)
  print(count`\n${1}\`${2}`)
  print(Template.raw``)
  return 0
}
