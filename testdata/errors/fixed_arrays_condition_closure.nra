// error: a closure in the rest of a condition assigns the index after its check
function holdsTrue(action: () => bool): bool {
  return action()
}

function inIf(values: FixedArray<int, 3>, start: int): int {
  let index = start
  if (
    index >= 0 &&
      index < 3 &&
      holdsTrue(() => {
        index = 5
        return true
      })
  ) {
    return values[index]
  }
  return 0
}

function afterExit(values: FixedArray<int, 3>, start: int): int {
  let index = start
  if (
    index < 0 ||
      index >= 3 ||
      holdsTrue(() => {
        index = 100000
        return false
      })
  ) {
    return 1
  }
  return values[index]
}

function pinned(values: FixedArray<int, 3>): int {
  const index = 3
  return values[index]
}

export function run(_args: Array<string>): int {
  const values: FixedArray<int, 3> = [1, 2, 3]
  return inIf(values, 0) + afterExit(values, 0) + pinned(values)
}
