// Long texts of `narrac explain`. A code without one prints its message format.
const EXPLANATIONS: Array<Explanation> = [
  Explanation {
    code: "E0003",
    text: "Narra has no semicolons. A line break ends a statement.\nFix: delete the `;`.\nExample: `return 0;` becomes `return 0`.",
  },
  Explanation {
    code: "E0014",
    text: "Imports name the module as a namespace or list the names. There is no default import.\nFix: `import X from \"std/int\"` becomes `import * as X from \"std/int\"`.",
  },
  Explanation {
    code: "E0020",
    text: "Arrays are written `Array<T>`, not `T[]`.\nFix: `xs: int[]` becomes `xs: Array<int>`.",
  },
  Explanation {
    code: "E0033",
    text: "There is no strict equality. `==` already compares without conversions.\nFix: `===` becomes `==`, and `!==` becomes `!=`.",
  },
  Explanation {
    code: "E0038",
    text: "There is no `null` or `undefined`. A value that may be missing has type `Option<T>`.\nFix: `null` becomes `None`.",
  },
  Explanation {
    code: "E0216",
    text: "Strings are joined with a template string.\nFix: `a + \"x\" + b` becomes `` `${a}x${b}` ``. The fix is offered when every operand is a string name or literal.",
  },
  Explanation {
    code: "E0309",
    text: "Narra has no method calls. Functions belong to modules.\nFix: `xs.push(v)` becomes `Arrays.push(mutable xs, v)`.",
  },
  Explanation {
    code: "E0323",
    text: "A constructor of a user enum is always written with its enum, in expressions and in patterns. Some, None, Ok and Err stay bare.\nFix: `Circle(1.0)` becomes `Shape.Circle(1.0)`.",
  },
  Explanation {
    code: "E0324",
    text: "Two enums visible here have this constructor, so the compiler cannot pick one.\nFix: write Enum.Name for the one you mean, for example `Level.Low`.",
  },
  Explanation {
    code: "E0325",
    text: "A generic function was called with an argument that cannot match its parameter, for example an int where Option<T> is expected.\nFix: pass a value of the shape the parameter asks for.",
  },
  Explanation {
    code: "E0326",
    text: "Explicit type arguments, as in f<int>(x), only go with a generic function or a trait function.\nFix: delete the type arguments, or call a generic function.",
  },
  Explanation {
    code: "E0327",
    text: "A generic function takes one type argument per type parameter, all or none. A trait call takes one, the type that Self stands for.\nFix: write every type argument, or none and let the arguments decide.",
  },
  Explanation {
    code: "E0425",
    text: "Importing a constructor by name is not allowed. Import the enum; its constructors come with it.\nFix: `import { Teacher }` becomes `import { SchoolPerson }`, and uses become `SchoolPerson.Teacher`.",
  },
  Explanation {
    code: "E0426",
    text: "Modules under std/internal/ hold the primitives behind the standard library. Only std modules import them.\nFix: use the public std module that wraps the primitive.",
  },
  Explanation {
    code: "E0529",
    text: "No parameter of this trait function mentions Self, so the call alone cannot tell which implementation to use.\nFix: name the type: `Shape.fromValue<User>(value)`.",
  },
  Explanation {
    code: "E0530",
    text: "Shape converts a type to and from a Value tree. The compiler provides it for bool, int, f64, char, string, Array<T>, Map<string, V>, Option<T> and tuples of two to four items whose contents implement it. A struct or enum needs an `implement Shape` block. A Map with keys other than string, a function and a sized integer have no Value form.\nFix: use a Map<string, V>, or wrap the type in a struct that implements Shape.",
  },
  Explanation {
    code: "E0531",
    text: "`derives Shape` writes toValue and fromValue from the fields, so every field type must implement Shape itself.\nFix: give the field a type that implements Shape, or write an `implement Shape` block for the type instead of deriving it.",
  },
  Explanation {
    code: "E0532",
    text: "A derived Shape writes an enum value as a Record whose \"type\" entry names the constructor, as a TypeScript discriminated union does. A constructor field named type would take the same key.\nFix: rename the field, or write an `implement Shape` block for the enum.",
  },
  Explanation {
    code: "E0533",
    text: "Other modules cannot build an opaque struct or read its fields, and a derived Shape does both, so only the struct's own module may use it.\nFix: convert the value in the declaring module, or write an `implement Shape` block that keeps the struct's rules.",
  },
  Explanation {
    code: "E0923",
    text: "Narra has no classes. Data goes in a struct and behavior in functions of the module.\nFix: `class A {}` becomes `struct A {}`.",
  },
  Explanation {
    code: "E0924",
    text: "Narra has no interfaces. Use a struct for a data shape and a trait for behavior.\nFix: `interface A {}` becomes `struct A {}`.",
  },
  Explanation {
    code: "E0925",
    text: "Narra has no `new`. A struct is built with a literal, other values with a function call.\nFix: `new A()` becomes `A {}` when A is a struct without fields.",
  },
  Explanation {
    code: "E0926",
    text: "Narra has no exceptions. A function that can fail returns `Result<T, E>`; the caller checks it with `is Err` or `match`.",
  },
  Explanation {
    code: "E0927",
    text: "Narra has no `throw`. Return `Err(value)` from a function that returns a Result.\nFix: `throw \"x\"` becomes `return Err(\"x\")`.",
  },
  Explanation {
    code: "E0928",
    text: "Narra has no `this`. A function gets the value as a parameter.",
  },
  Explanation {
    code: "E0930",
    text: "Narra has no function declarations inside a function. Declare the function at module level as a private function and pass the enclosing values as arguments.\nThere is no automatic fix: moving it changes the meaning when its body reads a name that a local shadows, and breaks helpers that use the enclosing type parameters.\nFor a helper that captures, bind an arrow function: `const helper = (x: int): int => x + offset`.\nExample: `function run() { function add(a: int): int { return a + 1 } }` becomes `function add(a: int): int { return a + 1 }` followed by `function run() { ... }`.",
  },
  Explanation {
    code: "E0991",
    text: "A `@target` function exists only on its target, so a use must sit where only that target compiles it: inside an `if` on `Build.os` or `Build.arch` that the other targets drop, or inside a `@target` function with the same or a narrower target. An ordinary `if`, a `match` and an early `return` do not count.\n`narrac check` checks the host only; `narrac check --all-targets` checks every supported target.\nExample: `print(linuxName())` becomes `if (Build.os == Os.Linux) { print(linuxName()) }`.",
  },
  Explanation {
    code: "E0992",
    text: "A constant type parameter is written `const N: int` in the type parameters of a function or a struct. Its kind is `int`; enums, type aliases and other integer kinds do not take one. A type argument is a type, an integer literal or a constant parameter in scope; it never computes.\nExample: `Vector<N + 1>` is rejected; pass the length as its own constant parameter, `function grow<const N: int, const M: int>(vector: Vector<N>): Vector<M>`.",
  },
  Explanation {
    code: "E0993",
    text: "A constant parameter takes an integer literal or a constant parameter in scope, and a type parameter takes a type; the two do not mix. A local, a type or a top-level constant cannot stand for a constant parameter, and a constant cannot stand for a type.\nExample: `Vector<count>` becomes `Vector<3>`, and `value: N` becomes `value: int` with `N` read in the body.",
  },
  Explanation {
    code: "E0994",
    text: "Indexing a FixedArray has no runtime check, so every index is proven at compile time. A constant index must be from 0 to N - 1. Any other index must be a plain name that a check puts in that range: an `if` or `while` condition such as `i >= 0 && i < 4`, the condition of `for (let i = 0; i < N; i++)`, or `for (const i of Ranges.upTo(N))`. An assignment to the name ends what the check proved. `FixedArrays.get(values, i)` returns an Option for any index.\nExample: `values[i]` becomes `if (i >= 0 && i < 4) { use(values[i]) }`.",
  },
  Explanation {
    code: "E0995",
    text: "`FixedArray<T, N>` takes an element type and a length. The length is an integer literal or a constant type parameter, and never negative. One FixedArray value takes at most 1048576 bytes (1 MiB); use an Array for more. A literal builds a FixedArray when the expected type is one, and gives every element.\nExample: `const point: FixedArray<f64, 3> = [1.0, 2.0, 3.0]`.",
  },
  Explanation {
    code: "E0996",
    text: "A call of a std/ptr function or of a function with the unsafe effect may break memory safety, so it is allowed only inside an `unsafe { ... }` block. The function that holds the block gets the unsafe effect, unless it is marked `@trusted`.\nExample: `const value = Ptr.read(items)` becomes `let value = 0` followed by `unsafe { value = Ptr.read(items) }`.",
  },
  Explanation {
    code: "E0997",
    text: "`@trusted` states that a function's `unsafe` blocks were checked by hand, and stops the unsafe effect there: callers need no `unsafe` block. A function without an `unsafe` block has nothing to trust, and a `@trusted` function does not declare `uses unsafe`.\nExample: remove `@trusted` from a function that has no `unsafe` block.",
  },
  Explanation {
    code: "E0998",
    text: "A `Ptr<T>` is a raw pointer with no reference count. It may point at numbers, `bool`, `char`, another `Ptr` and structs whose fields are all such values, because a pointer to a string, array, map, box, enum or closure would bypass reference counting. The std/ptr functions take a `Ptr`; `Ptr.alloc`, `Ptr.null` and `Ptr.cast` take the element type from where the result goes.\nExample: `Ptr<string>` is rejected; `const items: Ptr<int> = Ptr.alloc(4)` works.",
  },
  Explanation {
    code: "E1000",
    text: "C functions are declared in a block that names their library: `extern { function sqrt(value: f64): f64 } from \"m\"`. A member is a signature with no type parameters, no `uses` and no body; it has the unsafe effect. Only `@extern(\"name\")` may stand before a member. The libraries come from `from`, so `[link]` in narra.toml takes only `search`.\nExample: `[link] libraries = [\"m\"]` is removed; write `from \"m\"` after the extern block.",
  },
  Explanation {
    code: "E1001",
    text: "A C function is linked by its C name, the member's name or the one `@extern` gives. That name must be a C identifier and must not be one the compiler writes itself: `main`, names starting with `narra_` or `lstr_`, string literal names such as `L1`, and the generated names of the program's functions and types, alone or with a helper's operation before or a suffix after (`release_E_Option_e088c655`).\nExample: `@extern(\"narra_alloc\")` is rejected; call the C function by its own name.",
  },
  Explanation {
    code: "E1002",
    text: "A C function takes and returns values C can pass: the number types, `bool` and `Ptr<T>`, and may return nothing. Strings, arrays and other counted values have no C form; pass a `Ptr<u8>`, for a string `CStrings.pointer` of a CString.\nExample: `function strlen(text: string): u64` becomes `function strlen(text: Ptr<u8>): u64`.",
  },
  Explanation {
    code: "E1003",
    text: "`typeof` of a constant needs the constant's type, and a constant without a written type has its type only after its value is checked. In a declaration of the same module (a signature, a field, an alias) that type is not known yet, so write it.\nExample: `const limit = 3` becomes `const limit: int = 3`.",
  },
  Explanation {
    code: "E1004",
    text: "The compiler tracks a position as a line and a column below 1048576 each. A token past either limit is rejected, since it would share a record with another position. Split the file, or break the long line.",
  },
  Explanation {
    code: "E1010",
    text: "A tuple element is read with a constant index, `pair[0]`, so the read is a field read and cannot fail. An index that is a `let`, a parameter or any other computed value is rejected, because the element type would depend on it. A top-level `const` works. To read every element, destructure the tuple.\nExample: `pair[count]` becomes `const #[first, second] = pair`.",
  },
  Explanation {
    code: "E1011",
    text: "A tuple has a fixed number of elements, and a constant index must name one of them, counting from 0. Tuple elements are read-only, so `pair[0] = 2` is E0226.\nExample: for `#[int, string]`, the indexes are 0 and 1; `pair[2]` and `pair[-1]` are rejected.",
  },
  Explanation {
    code: "E1012",
    text: "A distinct type has the representation of its base type, so a derived trait is the base type's: `distinct type UserId = int derives Show` prints as an int. The derive needs the base type to implement the trait.\nExample: `distinct type Handle = Ptr<int> derives Show` is rejected, since a pointer has no Show; write an `implement Show for Handle` block and list `implements Show`.",
  },
  Explanation {
    code: "E1013",
    text: "A standard function is a value when its signature is fixed: `Int.toString`, `Str.length`, `Fs.readText`. A function whose types depend on the call (`Arrays.length`, `Maps.size`), one with a `mutable` parameter and one that takes a function argument have no single signature, so they are not values.\nExample: write the arrow function `(items) => Arrays.length(items)` instead of `Arrays.length`.",
  },
  Explanation {
    code: "E1014",
    text: "`==`, `!=` and map keys on a distinct type compare and hash the base value, so an `implement Equatable` or `implement Hashable` block for it would never run and is rejected. Write the comparison as a function of the declaring module, or wrap the value in a struct.\nExample: `implement Equatable for UserId` is rejected for `distinct type UserId = int`.",
  },
  Explanation {
    code: "E1020",
    text: "A struct or enum can require traits of its type parameters, as in `struct Labeled<T: Show>`. Every use of the type with arguments must meet them: a written type, a struct literal and an enum constructor. A type parameter of the enclosing function or type meets a constraint only when it declares the same trait; constraints are not implied.\nExample: `function first<T>(pair: Labeled<T>)` is rejected; write `function first<T: Show>(pair: Labeled<T>)`.",
  },
  Explanation {
    code: "E1021",
    text: "An implement block for a generic struct or enum names the type with the type parameters of its declaration, by the same names and in the same order. The block adds no constraints of its own: the members see the constraints the declaration gives, and the block holds for every instance.\nExample: for `struct Pair<T>`, `implement Show for Pair<int>` and `implement Show for Pair` are rejected; write `implement Show for Pair<T>`.",
  },
  Explanation {
    code: "E1022",
    text: "`Dynamic<Trait>` holds a value of any type that implements one trait, so its one type argument is a trait name. `Dynamic<int>`, `Dynamic` alone and `Dynamic<Show, Ordered>` are rejected.\nExample: write `Dynamic<Show>`.",
  },
  Explanation {
    code: "E1023",
    text: "A call through a `Dynamic<Trait>` passes the Dynamic where the trait writes `Self`, and the table of the stored type does the rest. That works only when every function of the trait takes `Self` as its first parameter, once and not inside another type, and mentions `Self` nowhere else, the result included. `Equatable` and `Ordered` take two values, and `Shape.fromValue` returns `Self`.\nExample: `trait Drawable { function draw(value: Self): string }` can be used as `Dynamic<Drawable>`.",
  },
  Explanation {
    code: "E1024",
    text: "`Dynamic.of(value)` takes the trait from the expected type: an annotation, a parameter type, a field type or a result type. It takes one value and is the only function of `Dynamic`.\nExample: `const item: Dynamic<Show> = Dynamic.of(42)`.",
  },
  Explanation {
    code: "E1025",
    text: "Every copy of a Dynamic shares one stored value, so a trait function that takes `mutable value: Self` cannot be called through a Dynamic: the change would reach the other copies.\nExample: call the function on the concrete value before wrapping it with `Dynamic.of`.",
  },
  Explanation {
    code: "E1030",
    text: "Every call to an @inline function is replaced by a copy of its body, so a body that calls itself, directly or through other @inline functions, would never stop copying. A call to a function without @inline ends the chain.\nFix: remove @inline from one function of the chain, or write the recursion as a loop.",
  },
  Explanation {
    code: "E1031",
    text: "@inline copies a function's body into each call. A function of an `extern { } from` block has no body, and a generator (`function*`) or an async function is a frame that resumes later, not a body that runs to its end inside the call.\nFix: remove @inline.",
  },
  Explanation {
    code: "E1050",
    text: "The compiler runs an @const function while it compiles and writes the result into the C, so its parameters and result hold only values the compiler can build and write: numbers, bool, char, string, bytes, Array, Map, FixedArray, Option, Result, tuples, and structs, enums and distinct types made of these. A function value, Cell, Ptr, Shared, a generator, a trait-constrained type parameter or an effect parameter has no compile-time value.\nFix: remove @const, or change the signature.",
  },
  Explanation {
    code: "E1051",
    text: "An @const function runs inside the compiler, where nothing outside it can observe what it does. It may allocate, and nothing else: no io and no unsafe code.\nFix: move the effect out of the function, or remove @const.",
  },
  Explanation {
    code: "E1052",
    text: "An @const function calls other @const functions, constructors and the std functions of std/string, std/array, std/map, std/int, std/float, std/range, std/char, std/option, std/result and std/regex that take no function. It cannot use an arrow function, call through a function value or run a user implement block (through ==, a map key or a direct call).\nFix: mark the called function @const, compute the value another way, or remove @const.",
  },
  Explanation {
    code: "E1053",
    text: "The compiler computes a constant that calls an @const function while it compiles. A panic, a failed assert, an index out of range or a std function that would panic stops the computation, and the error shows the chain of calls from the constant to where it stopped.\nFix: change the arguments or the function so it does not panic.",
  },
  Explanation {
    code: "E1054",
    text: "A constant may take 10 million evaluation steps (one per expression, statement and loop turn, plus one per 8 bytes or elements a std call goes through), so a mistake such as an endless loop cannot hang the compiler.\nFix: compute a table this large at run time in a function, or generate a source file; for Regexes.checked, compile the pattern at run time with Regexes.compile.",
  },
  Explanation {
    code: "E1055",
    text: "The values a constant builds while it is computed may take 64 MiB, counted as 8 bytes per number, element, field and entry, string lengths rounded up to 8, and 16 per array and map; `copy(...)` and storing a value read from a place count its outer level again. A std call whose result would pass the limit is stopped before it runs.\nFix: compute a table this large at run time in a function, or generate a source file; for Regexes.checked, compile the pattern at run time with Regexes.compile.",
  },
  Explanation {
    code: "E1056",
    text: "A constant may make 1000 nested calls while it is computed, nest calls, blocks, loops and expressions 5000 deep, and build values nested 1000 levels deep, which keeps the compiler stack safe. A function that calls itself as its last step (`return f(...)`) runs as a loop and does not count.\nFix: write the recursion as a loop or as a tail call.",
  },
  Explanation {
    code: "E1057",
    text: "An @const function may read top-level constants. A constant whose computation reads the constant itself has no value to start from.\nFix: break the cycle, for example by passing the value as an argument.",
  },
  Explanation {
    code: "E1100",
    text: "`await` waits for a task, so it can stand only where the body is itself a task: an async function, an async arrow or an async block. A `function*` body and an arrow that is not async are bodies of their own, also inside an async body.\nFix: make the function or arrow async, or pass the handle on and await it in an async body.",
  },
  Explanation {
    code: "E1102",
    text: "`await` takes the handle of a task, an Async<T>, and gives its value.\nFix: await the call that returns the handle, or use the value without await.",
  },
  Explanation {
    code: "E1103",
    text: "A call of an async function, an async arrow or an `async { ... }` block starts a task and gives its handle. A handle that nobody uses hides a task that keeps running; `const _ =` does not let it go.\nFix: await the handle, keep it in a name, pass it on, or call Async.detach(handle) to let the task run with nobody waiting.",
  },
  Explanation {
    code: "E1104",
    text: "A task outlives the call that starts it, so it cannot keep a pointer into the caller's variable.\nFix: take the value as a plain parameter and return the new value from the task.",
  },
  Explanation {
    code: "E1105",
    text: "A `for (mutable ...)` loop holds a pointer to the element it changes, which cannot be kept in a task frame across an await. `for await (mutable ...)` is rejected too: the values of a stream are not elements of a place.\nFix: change the elements through an index; read a stream with `for await (const x of stream)`.",
  },
  Explanation {
    code: "E1106",
    text: "A handle is an identity type: copies share one task, so == and a map key would compare tasks, not values.\nFix: await the handles and compare or key by the values.",
  },
  Explanation {
    code: "E1107",
    text: "retired: `async function*` declares an async generator now (D110), so this error is no longer reported.",
  },
  Explanation {
    code: "E1108",
    text: "`async` starts an async function, an async arrow or an async block.\nFix: write `async function`, `async (x) => ...` or `async { ... }`.",
  },
  Explanation {
    code: "E1109",
    text: "Async<T> takes the type of the task's value as its one type argument.\nFix: write Async<T>, with Async<void> for a task that gives no value.",
  },
  Explanation {
    code: "E1110",
    text: "An async arrow or block copies what it captures when its task starts, so a `let`, a `mutable` parameter or a captured value it changes would no longer be shared with the code around it.\nFix: keep state that changes in a Cell from std/cell, or pass the value in and return the new one.",
  },
  Explanation {
    code: "E1111",
    text: "An async function keeps its parameters in its task, which outlives the call, so a function parameter must be one that may be stored.\nFix: declare the parameter as `escaping`.",
  },
  Explanation {
    code: "E1112",
    text: "An `async function*` produces a stream of values that may wait between them, read with `Async.next` or `for await`. Its result names that stream, with the effects of the body on it.\nFix: write the result as `AsyncGenerator<T>`, as in `async function* lines(): AsyncGenerator<string> uses io`.",
  },
  Explanation {
    code: "E1113",
    text: "An AsyncGenerator<T> body may wait between its values, so only an async generator can return one from its own body. A plain or async function may still return a stream it got elsewhere.\nFix: write `async function*`, or return a Generator<T>.",
  },
  Explanation {
    code: "E1114",
    text: "AsyncGenerator<T> takes the type of the values the stream yields as its one type argument.\nFix: write AsyncGenerator<T>.",
  },
  Explanation {
    code: "E1115",
    text: "An async generator yields values to its readers and gets nothing back: there is no async coroutine.\nFix: write `yield value` as a statement, and pass input to the stream through its arguments or a Cell.",
  },
  Explanation {
    code: "E1116",
    text: "`yield*` in an async generator passes on every value of another AsyncGenerator<T> with the same T, one per step of the outer stream.\nFix: delegate to an AsyncGenerator<T>; for a Generator<T>, write `for (const x of g) { yield x }`.",
  },
  Explanation {
    code: "E1122",
    text: "`for await` waits for each value of a stream, so it can stand only where the body is itself a task: an async function, an async arrow, an async block or an async generator. A `function*` body and an arrow that is not async are bodies of their own, also inside an async body.\nFix: make the function or arrow async, or read the stream with Async.next in an async body.",
  },
  Explanation {
    code: "E1123",
    text: "`for await` reads an AsyncGenerator<T>, the stream an `async function*` gives, one step at a time.\nFix: for a Generator<T> or an array, write `for (const x of items)`, which works in an async body; for an Array<Async<T>>, loop over the handles and `await` each one.",
  },
  Explanation {
    code: "E1124",
    text: "The values of an AsyncGenerator<T> may wait, so a plain `for ... of` cannot read them.\nFix: write `for await (const x of stream)` in an async body, or read one step with `await Async.next(stream)`.",
  },
  Explanation {
    code: "E1150",
    text: "An Async<void> handle binds the type parameter of its Async<T> to void. A generic function whose signature also uses that parameter as a value, such as Async.peek (Option<T>), Async.all (Array<T>) or Async.race (Option<T>), would need a void value, which does not exist.\nFix: await the handles one by one, or give the task a value, such as a bool.",
  },
  Explanation {
    code: "E1240",
    text: "In a type, `uses` takes one effect, or a comma list in parentheses: `() => int uses io`, `Generator<int> uses (io, alloc)`. A `,` after the one effect ends the type, so the type can stand in a list of types or parameters. A function's own list, after its result type, is a bare comma list.\nFix: put the type's effects in parentheses, `Generator<string> uses (io, alloc)`. A function that makes a generator writes its own list after it: `(): Generator<string> uses (io, alloc) uses alloc`.",
  },
  Explanation {
    code: "E1241",
    text: "`io`, `alloc`, `unsafe` and effect variables name effects, which only a `uses` list holds; they are not types. In a list of types such as `Map<Generator<int> uses io, alloc>`, the `,` ends the generator's one effect, so `alloc` stands where a type belongs.\nFix: write the effects in parentheses, `Map<Generator<int> uses (io, alloc), int>`, or move the name into a `uses` list.",
  },
  Explanation {
    code: "E1242",
    text: "A `uses` list names each effect once, in a type and in a function's own list.\nFix: delete the repeated name: `uses (io, io)` in a type and `uses io, io` on a function both become `uses io`.",
  },
  Explanation {
    code: "E1190",
    text: "A value that crosses to another thread (a capture or the result of a thread function, the items of Parallel.map) must be Sendable. Sendable is automatic: a type is Sendable when nothing in it, at any depth, is a function, a Dynamic, a Ptr, a Cell, an Async, a generator or coroutine, a Scope, a Thread or a socket handle. These hold state that one thread changes in place without a lock.\nFix: share changing state through Shared from std/shared, send plain data, and declare a type parameter that crosses as <T: Sendable>.",
  },
  Explanation {
    code: "E1191",
    text: "A Scope joins its threads when its Thread.scope returns, so it must not outlive that call. It can be passed to functions, but not stored in a field, element, tuple or constructor, returned, captured by an escaping closure such as a thread function, or kept in the frame of a generator, coroutine, stream or task (a parameter or a capture), which can run after Thread.scope returns.\nFix: pass the Scope as a parameter to the function that starts threads, or open a new Thread.scope where it is needed.",
  },
  Explanation {
    code: "E1192",
    text: "A thread runs one plain function. An async function would give an Async handle, which belongs to the event loop of the thread that made it.\nFix: write a plain function; it may start tasks, which its thread finishes before it ends.",
  },
  Explanation {
    code: "E1193",
    text: "The checker must see what a thread function captures, and a function value does not show its captures in its type. So the function passed to Thread.start or Parallel.map is an arrow function written at the call or the name of a top-level function.\nFix: write the arrow at the call, as in `Thread.start(scope, () => work(input))`.",
  },
  Explanation {
    code: "E1194",
    text: "Sendable is only automatic: the compiler implements it for every type whose parts can cross a thread, so a type cannot list, derive or implement it.\nFix: remove the `implement Sendable`, `implements Sendable` or `derives Sendable`.",
  },
  Explanation {
    code: "E1195",
    text: "A Thread, a Scope, a Sender, a Receiver, a Shared or an Atomic is a handle shared by identity, so `==`, `!=` and map keys on it are errors, as for a Cell and an Async.\nFix: compare the values the handles give, for example the results of Thread.join or Shared.get.",
  },
  Explanation {
    code: "E1200",
    text: "A template right after a name is a tagged template: `tag`a${x}b`` calls `tag([\"a\", \"b\"], [x])`. Only a name or a dotted name can be the tag, so the function called is named where it is used.\nFix: put the tag in a constant first (`const tag = make()`, then `tag`...``), or write a space-free name before the template.",
  },
  Explanation {
    code: "E1201",
    text: "A tag is a function of two parameters: the parts, `Array<string>` (escapes decoded) or `Template.Raw` from std/template (the source text), and the values, `Array<T>`. Neither parameter can be `mutable`.\nFix: give the tag that signature, for example `function tag(parts: Array<string>, values: Array<string>): string`.",
  },
  Explanation {
    code: "E1202",
    text: "Every `${}` value of a tagged template has the tag's value type T, the element type of its second parameter. A generic tag takes T from the first value.\nFix: convert the value inside the `${}`, for example `${Int.toString(count)}`.",
  },
  Explanation {
    code: "E1203",
    text: "A line break ends the statement, so a template at the start of a line is not tagged by the name at the end of the line before, as it would be in TypeScript.\nFix: write the tag and the template on one line, `const x = tag`a``, or remove the template.",
  },
  Explanation {
    code: "E1410",
    text: "Shared.update and Shared.read hold the lock while their callback runs. An async callback would give an Async whose task runs later, after the lock is released, or suspend while other threads wait for the lock.\nFix: pass a plain function, and await the work before or after the call.",
  },
  Explanation {
    code: "E1411",
    text: "An Atomic<T> uses the processor's atomic operations, which work on bool and the integer types up to 64 bits (int, i8 to i32, u8 to u64). A type parameter is not allowed either, since no bound says \"an integer type\".\nFix: use an integer type, or keep the value in a Shared from std/shared.",
  },
  Explanation {
    code: "E1412",
    text: "Atomic.add adds to an integer. An Atomic<bool> has no sum.\nFix: use Atomic.store, Atomic.exchange or Atomic.compareExchange to change a flag.",
  },
  Explanation {
    code: "E1360",
    text: "Regexes.checked compiles its pattern while the compiler runs, so a bad pattern is a compile error (E1053) instead of a panic. That works only where the compiler computes the value: the value of a top-level const that is not lazy. Anywhere else, including a function body, a lazy value or a use as a function value, the call would run in the program and could panic.\nFix: move the call into a top-level const, or call Regexes.compile and handle its RegexError.",
  },
]

export function getCodeRows(): Array<CodeRow> {
  return CODE_ROWS
}

export function isKnownCode(code: string): bool {
  for (const row of Arrays.values(CODE_ROWS)) {
    if (row.code == code) {
      return true
    }
  }
  return false
}

function upperAscii(text: string): string uses alloc {
  let builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    const code = Char.code(character)
    let shown = character
    if (code >= 97 && code <= 122) {
      if (Char.fromCode(code - 32) is Some(upper)) {
        shown = upper
      }
    }
    Str.appendChar(mutable builder, shown)
  }
  return Str.build(builder)
}

export function explainCode(input: string): Result<string, string> uses alloc {
  // Codes are case-insensitive: `explain e0001` works like `explain E0001`.
  const code = upperAscii(input)
  let format = ""
  // A code with several formats prints the last one.
  for (const row of Arrays.values(CODE_ROWS)) {
    if (row.code == code) {
      format = row.format
    }
  }
  if (format == "") {
    return Err(`unknown diagnostic code ${quoteGo(code)}`)
  }
  let text = `${code}: ${format}\n`
  for (const explanation of Arrays.values(EXPLANATIONS)) {
    if (explanation.code == code) {
      text = `${text}\n${explanation.text}\n`
    }
  }
  return Ok(text)
}

function writePair(pos: Pos): string uses alloc {
  return `[${Int.toString(pos.line)},${Int.toString(pos.column)}]`
}

export function writeDiagnosticJson(
  file: string,
  pos: Pos,
  code: string,
  message: string,
  fixes: Array<Fix>,
): string uses alloc {
  // The range is empty (start equals end) because a diagnostic records a position, not an extent. Every edit names the file of the diagnostic.
  const pair = writePair(pos)
  let fixTexts: Array<string> = []
  for (const fix of Arrays.values(fixes)) {
    let editTexts: Array<string> = []
    for (const edit of Arrays.values(fix.edits)) {
      Arrays.push(
        mutable editTexts,
        `{"file":${quoteJson(file)},"range":{"start":${writePair(edit.start)},"end":${writePair(edit.end)}},"text":${quoteJson(edit.text)}}`,
      )
    }
    Arrays.push(
      mutable fixTexts,
      `{"title":${quoteJson(fix.title)},"edits":[${Str.join(editTexts, ",")}]}`,
    )
  }
  return `{"code":${quoteJson(code)},"severity":"error","message":${quoteJson(message)},"file":${quoteJson(file)},"range":{"start":${pair},"end":${pair}},"fixes":[${Str.join(fixTexts, ",")}]}`
}
