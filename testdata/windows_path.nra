import * as Path from "std/path"

function check(name: string, actual: string, windows: string, posix: string, onWindows: bool) uses io, alloc {
  const expected = onWindows ? windows : posix
  if (actual == expected) {
    print(`${name}: ok`)
  } else {
    print(`${name}: FAIL got ${actual}, want ${expected}`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  // On Windows "\" separates segments and a drive letter starts a path;
  // elsewhere "\" is an ordinary name character. Each line checks the rule of
  // the system the program runs on, so the output is the same everywhere.
  const onWindows = Path.basename("a\\b") == "b"
  check("join backslash", Path.join("a\\b", "c"), "a/b/c", "a\\b/c", onWindows)
  check("join dot dot", Path.join("a\\b", "..\\c"), "a/c", "a\\b/..\\c", onWindows)
  check("dirname backslash", Path.dirname("a\\b\\c"), "a\\b", ".", onWindows)
  check("basename backslash", Path.basename("a\\b\\c.txt"), "c.txt", "a\\b\\c.txt", onWindows)
  check("extname backslash", Path.extname("a.d\\b"), "", ".d\\b", onWindows)
  check("join drive", Path.join("C:\\", "x"), "C:/x", "C:\\/x", onWindows)
  check("join drive up", Path.join("C:/a/b", "../c"), "C:/a/c", "C:/a/c", onWindows)
  check("join drive up to root", Path.join("C:/a", ".."), "C:/", "C:", onWindows)
  check("join drive relative", Path.join("C:a", "b"), "C:a/b", "C:a/b", onWindows)
  check("dirname drive", Path.dirname("C:\\a\\b"), "C:\\a", ".", onWindows)
  check("dirname drive root", Path.dirname("C:/a"), "C:/", "C:", onWindows)
  check("basename drive", Path.basename("C:\\a\\b.txt"), "b.txt", "C:\\a\\b.txt", onWindows)
  check("basename drive only", Path.basename("C:"), "", "C:", onWindows)
  check("extname drive", Path.extname("C:\\dir.d\\file"), "", ".d\\file", onWindows)
  check("forward slash", Path.join("a/b", "c/../d"), "a/b/d", "a/b/d", onWindows)
  return 0
}
