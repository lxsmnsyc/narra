// error: cannot tell constant parameter N of repeat here; write it, as in repeat<3>(...)
function repeat<const N: int>(text: string): string uses alloc {
  let out = ""
  for (let i = 0; i < N; i++) {
    out = `${out}${text}`
  }
  return out
}

export function run(_args: Array<string>): int {
  print(repeat("a"))
  return 0
}
