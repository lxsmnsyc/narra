// error: labels_reused.nra:6:5: label "outer" is already used by an enclosing loop
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  outer: for (const i of Ranges.upTo(3)) {
    outer: for (const j of Ranges.upTo(3)) {
      continue outer
    }
  }
  return 0
}
