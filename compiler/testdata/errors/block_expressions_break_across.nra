// error: block_expressions_break_across.nra:7:7: break cannot leave a block expression; it can only leave a loop inside the block
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  outer: for (const i of Ranges.upTo(3)) {
    const value = {
      break outer
      return i
    }
    print(`${value}`)
  }
  return 0
}
