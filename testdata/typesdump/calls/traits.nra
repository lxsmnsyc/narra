trait Named {
  function name(value: Self): string
}

trait Sized {
  function size(value: Self): int
  function grow(value: Self, by: int): Self
}

struct Cat implements Named, Sized {
  lives: int
}

enum Color implements Named derives Show, Ordered {
  Red
  Blue
}

implement Named for Cat {
  function name(_value: Cat): string {
    return "cat"
  }
}

implement Sized for Cat {
  function size(value: Cat): int {
    return value.lives
  }

  function grow(value: Cat, by: int): Cat {
    return Cat { lives: Sized.size(value) + by }
  }
}

implement Named for Color {
  function name(_value: Color): string {
    return "color"
  }
}

function describe<T: Named>(value: T): string {
  return Named.name(value)
}

function measure<T: Sized>(value: T): int {
  const bigger = Sized.grow(value, 1)
  return Sized.size(bigger)
}

function same<T: Equatable>(left: T, right: T): bool {
  return Equatable.equals(left, right)
}

export function run(args: Array<string>): int {
  const cat = Cat { lives: 9 }
  const _catName = Named.name(cat)
  const _colorName = Named.name(Color.Red)
  const _shown = Show.show(Color.Blue)
  const _order = Ordered.compare(Color.Red, Color.Blue)
  const _described = describe(cat)
  const _colorText = describe(Color.Blue)
  const measured = measure(cat)
  const _equal = same(1, 2)
  const _optionText = Show.show(Some(1))
  return measured
}
