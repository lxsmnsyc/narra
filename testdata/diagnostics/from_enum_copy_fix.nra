// code: E0976
import * as Arrays from "std/array"

function pickSome(first: Array<int>, second: Option<Array<int>>): Option<Array<int>> from first {
  if (Arrays.length(first) > 0) {
    return Some(first)
  }
  return second
}

export function run(_args: Array<string>): int {
  if (pickSome([], Some([4])) is Some(items)) {
    return items[0]
  }
  return 0
}
