import * as Str from "std/string"

export const LIMIT = 3

export struct Point implements Named {
  x: int
  y: int
}

export enum Shape {
  Circle(radius: int)
  Empty
}

export trait Named {
  function name(value: Self): string uses alloc
}

export distinct type UserId = int

export function helper(text: string): int uses alloc {
  return Str.length(text) + LIMIT
}

implement Named for Point {
  function name(value: Point): string uses alloc {
    return Str.repeat("p", value.x)
  }
}
