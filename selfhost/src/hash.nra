// Hashing for C names (xxh32 and the module hash), ported from cnames.go by
// selfhost-emit-program. Stub from selfhost-emit-core: the frozen signatures
// return placeholders, and nothing calls them while Checker.programRecorded is
// false.

export function xxh32(text: string, seed: int): int {
  return 0
}

export function hex8(value: int): string {
  return "00000000"
}

export function relativeModule(path: string): string {
  return path
}

export function moduleHash(path: string): string {
  return hex8(xxh32(path, 0))
}
