// Field shorthand in struct literals: `Point { x, y }` means `Point { x: x, y: y }`.
// The parser gives a shorthand field a name value at the field's own position and
// sets `isShorthand`, so later passes see an ordinary field. This module adds the
// hint to an unknown name.
import { FieldInit } from "narrac/ast"
import { Checker } from "narrac/check"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export function countErrors(checker: Checker): int {
  return Arrays.length(checker.errors)
}

export function addShorthandHint(
  mutable checker: Checker,
  field: FieldInit,
  errorsBefore: int,
) uses alloc {
  if (!field.isShorthand) {
    return
  }
  // An unknown name at the field gets a hint that names the field.
  for (const index of Ranges.between(errorsBefore, Arrays.length(checker.errors))) {
    const error = checker.errors[index]
    const samePosition = error.pos.line == field.pos.line && error.pos.column == field.pos.column
    if (error.code == "E0203" && samePosition) {
      checker.errors[index].message = `${error.message}; the field shorthand \`${field.name}\` reads a variable named ${field.name}`
    }
  }
}
