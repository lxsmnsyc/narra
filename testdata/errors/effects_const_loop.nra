// error: Function `pure` uses `io` but its signature does not declare it
import * as Arrays from "std/array"

function loud(v: int): int uses io {
  print("loud")
  return v
}

const steps: Array<(v: int) => int uses io> = [loud, loud]
const copies = steps

export function pure(): int {
  let total = 0
  for (const step of Arrays.values(copies)) {
    total = total + step(1)
  }
  return total
}

export function run(args: Array<string>): int uses io {
  return pure()
}
