import * as Arrays from "std/array"

function loud(value: int): int {
  print("x")
  return value
}
function quiet(value: int): int {
  return value
}
export function wrapAll<effect E>(escaping f: (value: int) => int uses E): Array<(value: int) => int uses E> uses alloc {
  return [f]
}
export struct Holder<T> {
  value: T
  f: (value: int) => int uses io
}

export function pure<effect E>(g: (value: int) => int uses E): int uses alloc, E {
  return wrapAll(loud)[0](g(1))
}

export function run(args: Array<string>): int {
  return wrapAll(quiet)[0](1) + wrapAll(loud)[0](1) + Arrays.length(args) * 0
}
