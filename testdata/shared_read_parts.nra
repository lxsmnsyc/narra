// Shared.read gives a part of the value that stays alive after another
// thread's Shared.set has replaced and dropped the value it came from.
import * as Thread from "std/thread"
import * as Shared from "std/shared"
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Team {
  name: string
  scores: Array<int>
}

function total(scores: Array<int>): int {
  let sum = 0
  for (const score of Arrays.values(scores)) {
    sum += score
  }
  return sum
}

export function run(_args: Array<string>): int {
  const team = Shared.create(Team { name: `blue ${Int.toString(7)}`, scores: [1, 2, 3] })
  const scores = Shared.read(team, (current) => current.scores)
  const name = Shared.read(team, (current) => current.name)
  const old = Shared.get(team)
  const replaced = Thread.scope((scope) => {
    const writer = Thread.start(scope, () => {
      Shared.set(team, Team { name: "red", scores: [10, 20] })
      return "set"
    })
    return Thread.join(writer)
  })
  print(`writer ${replaced}`)
  print(
    `kept ${name}: ${Int.toString(total(scores))}, ${old.name}: ${Int.toString(total(old.scores))}`,
  )
  const now = Shared.read(team, (current) => current.name)
  const nowScores = Shared.read(team, (current) => total(current.scores))
  print(`now ${now}: ${Int.toString(nowScores)}`)
  return 0
}
