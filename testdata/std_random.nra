import * as Random from "std/random"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Options from "std/option"

export function run(args: Array<string>): int uses io, alloc {
  let first = Random.seeded(42)
  let second = Random.seeded(42)
  let same = true
  for (const _ of Ranges.upTo(100)) {
    if (Random.nextInt(mutable first, 0, 1000) != Random.nextInt(mutable second, 0, 1000)) {
      same = false
    }
  }
  print(`same seed repeats: ${Show.show(same)}`)

  let zero = Random.seeded(0)
  print(`bits: ${Show.show(Random.nextBits(mutable zero))}`)
  print(`bits: ${Show.show(Random.nextBits(mutable zero))}`)

  let ranged = Random.seeded(7)
  let inRange = true
  let seenLow = false
  let seenHigh = false
  for (const _ of Ranges.upTo(2000)) {
    const value = Options.withDefault(Random.nextInt(mutable ranged, -3, 4), -100)
    if (value < -3 || value >= 4) {
      inRange = false
    }
    if (value == -3) {
      seenLow = true
    }
    if (value == 3) {
      seenHigh = true
    }
  }
  print(`in range: ${Show.show(inRange)} ${Show.show(seenLow)} ${Show.show(seenHigh)}`)

  let floats = Random.seeded(1)
  let unit = true
  for (const _ of Ranges.upTo(1000)) {
    const value = Random.nextFloat(mutable floats)
    if (value < 0.0 || value >= 1.0) {
      unit = false
    }
  }
  print(`floats in [0, 1): ${Show.show(unit)}`)

  let items = [1, 2, 3, 4, 5, 6, 7, 8]
  let shuffler = Random.seeded(99)
  Random.shuffle(mutable shuffler, mutable items)
  let total = 0
  for (const item of Arrays.values(items)) {
    total = total + item
  }
  print(`shuffled sum: ${Show.show(total)} length ${Show.show(Arrays.length(items))}`)
  let again = [1, 2, 3, 4, 5, 6, 7, 8]
  let repeat = Random.seeded(99)
  Random.shuffle(mutable repeat, mutable again)
  print(`shuffle repeats: ${Show.show(items == again)}`)

  let words = ["a", "b", "c", "d"]
  Random.shuffle(mutable shuffler, mutable words)
  print(`words: ${Show.show(Arrays.length(words))}`)

  let system = Random.fromSystem()
  const roll = Options.withDefault(Random.nextInt(mutable system, 1, 7), -100)
  print(`system roll in range: ${Show.show(roll >= 1 && roll < 7)}`)
  return 0
}
