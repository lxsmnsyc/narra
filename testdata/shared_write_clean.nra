// Writes the shared-write check (E0978) accepts; the copy check reports nothing.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

struct Labels {
  names: Array<string>
  title: string
  count: int
}

export function run(_args: Array<string>): int uses alloc {
  // Assigning a whole place ends its sharing.
  let labels = Labels { names: ["a"], title: "t", count: 0 }
  const saved = labels.names
  labels.names = []
  // A copy(...) source is not shared.
  let names = copy(saved)
  names[0] = "b"
  // Scalars and strings are not tracked.
  const title = labels.title
  const count = labels.count
  labels.title = "u"
  labels.count = 1
  // A write after the sharing name's last use.
  const kept = labels
  const length = Arrays.length(kept.names)
  labels.count = 2
  // A loop over copy(...) does not hold the array it copied.
  let items = [1, 2]
  for (const item of copy(items)) {
    items[0] = item
  }
  const total =
    Arrays.length(names) + Arrays.length(saved) + length + count + Str.length(title) + items[0]
  print(Int.toString(total))
  return 0
}
