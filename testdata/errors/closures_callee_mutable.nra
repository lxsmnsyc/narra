// error: "f" is passed as mutable inside this call, so it cannot also hold the function being called
function adder(n: int): (x: int) => int {
  return (x) => x + n
}

function swap(mutable f: (x: int) => int): int {
  f = adder(1000)
  return 5
}

export function run(args: Array<string>): int {
  let f = adder(1)
  return f(swap(mutable f))
}
