// Map, tuple and spread literals and Map indexes, ported from
// compiler/internal/narra/std_map.go (mapLit, mapIndex) and
// check_patterns.go (spreadLit, tupleLit).
//
// exprs.nra reaches these through the Walker trait (check.nra): the
// arms of checkExpressionKind, checkIndex and checkStructLiteral call
// Walker.checkMapLiteral, checkTuple, checkSpread and checkMapIndex.
import { Pos, Expr, TypeExpr, FieldInit } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Type } from "narrac/types"
import { Checker, Walker, errorf, typeString, checkMapKey, lookupGeneric, getExpressionPos } from "narrac/check"
import { resolveType, instantiate, findTupleType } from "narrac/resolve"
import { checkExpression, expectType, describeType, findField, isHiddenStruct } from "narrac/exprs"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// checkMapLiteral checks `Map { k: v }` and `Map<K, V> { k: v }`.
export function checkMapLiteral<W: Walker>(mutable checker: Checker, walker: W, expression: Expr, want: Option<Type>): Type uses alloc {
  if (expression is Expr.MapLit(_, pos, typeArgs, keys, values)) {
    return checkMapEntries(mutable checker, walker, pos, typeArgs, keys, values, want)
  }
  return Type.TVoid
}

function checkMapEntries<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, typeArgs: Array<TypeExpr>, keys: Array<Expr>, values: Array<Expr>, want: Option<Type>): Type uses alloc {
  let keyType: Option<Type> = None
  let valueType: Option<Type> = None
  if (want is Some(Type.TMap(wantedKey, wantedValue))) {
    keyType = Some(wantedKey)
    valueType = Some(wantedValue)
  }
  if (Arrays.length(typeArgs) > 0) {
    // The written types decide the type of the literal, and resolveType
    // checks arity and the key.
    const written = TypeExpr { pos: pos, name: "Map", args: typeArgs, isFunc: false, result: None, effects: [], isTuple: false }
    const literalType = resolveType(mutable checker, written)
    if (literalType is Type.TMap(literalKey, literalValue)) {
      if (want is Some(Type.TMap(wantedKey, wantedValue))) {
        if (Type.TMap(wantedKey, wantedValue) != literalType) {
          const message = `the type arguments make ${typeString(checker, literalType)}, but the expected type is ${typeString(checker, Type.TMap(wantedKey, wantedValue))}`
          errorf(mutable checker, pos, message)
          return Type.TMap(wantedKey, wantedValue)
        }
      }
      keyType = Some(literalKey)
      valueType = Some(literalValue)
    } else {
      // resolveType reported it; give the expected type back so the
      // caller does not add "found void".
      if (want is Some(wantedType)) {
        return wantedType
      }
      return Type.TVoid
    }
  }

  // Each key and value is checked against what is known so far.
  for (const index of Ranges.between(0, Arrays.length(keys))) {
    const foundKey = checkExpression(mutable checker, walker, keys[index], keyType)
    if (keyType is None) {
      keyType = Some(foundKey)
    }
    expectType(mutable checker, getExpressionPos(keys[index]), keyType, foundKey)
    const foundValue = checkExpression(mutable checker, walker, values[index], valueType)
    if (valueType is None) {
      valueType = Some(foundValue)
    }
    expectType(mutable checker, getExpressionPos(values[index]), valueType, foundValue)
  }
  if (keyType is Some(finalKey)) {
    if (valueType is Some(finalValue)) {
      if (Arrays.length(typeArgs) == 0) {
        checkMapKey(mutable checker, pos, finalKey)
      }
      return Type.TMap(finalKey, finalValue)
    }
  }
  errorf(mutable checker, pos, "the type of Map {} is unknown; add a type annotation")
  return Type.TVoid
}

// checkMapIndex checks m[k]: Option<V>, or V when it is the target of an
// assignment.
export function checkMapIndex<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, index: Expr, mapKey: Type, mapValue: Type): Type uses alloc {
  const found = checkExpression(mutable checker, walker, index, Some(mapKey))
  expectType(mutable checker, getExpressionPos(index), Some(mapKey), found)
  if (nodeId == checker.assigningId) {
    return mapValue
  }
  if (lookupGeneric(checker, "Option") is Some(option)) {
    return instantiate(mutable checker, option, [mapValue])
  }
  return Type.TVoid
}

// checkTuple checks `#[a, b]`. An expected tuple type of the same length
// guides the elements; otherwise each element's type is inferred.
export function checkTuple<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, elements: Array<Expr>, want: Option<Type>): Type uses alloc {
  if (Arrays.length(elements) < 2) {
    errorf(mutable checker, pos, `a tuple needs at least two elements, found ${Int.toString(Arrays.length(elements))}`)
    for (const element of Arrays.values(elements)) {
      checkExpression(mutable checker, walker, element, None)
    }
    return Type.TVoid
  }

  // The expected type guides the elements when it is a tuple of this length.
  let wantedIndex = -1
  if (want is Some(Type.TStruct(index))) {
    if (checker.structs[index].tuple && Arrays.length(checker.structs[index].fields) == Arrays.length(elements)) {
      wantedIndex = index
    }
  }
  let elementTypes: Array<Type> = []
  for (const position of Ranges.between(0, Arrays.length(elements))) {
    let elementWant: Option<Type> = None
    if (wantedIndex >= 0) {
      elementWant = Some(checker.structs[wantedIndex].fields[position].fieldType)
    }
    let found = checkExpression(mutable checker, walker, elements[position], elementWant)
    if (elementWant is Some(expected)) {
      expectType(mutable checker, getExpressionPos(elements[position]), elementWant, found)
      found = expected
    }
    Arrays.push(mutable elementTypes, found)
  }
  return findTupleType(mutable checker, elementTypes)
}

// checkSpread checks `{ ...s, field: v }` and `Name { ...s, field: v }`.
// The result has the type of s.
export function checkSpread<W: Walker>(mutable checker: Checker, walker: W, pos: Pos, typeName: string, fields: Array<FieldInit>, spread: Expr, want: Option<Type>): Type uses alloc {
  // A written name is a struct, or a generic struct compared by name below.
  let named: Option<Type> = None
  let genericIndex = -1
  if (typeName != "") {
    const scope = checker.scopes[checker.cur]
    if (scope.generics[typeName] is Some(generic)) {
      if (checker.generics[generic].isStruct) {
        genericIndex = generic
      }
    }
    if (genericIndex < 0) {
      if (scope.types[typeName] is Some(Type.TStruct(structIndex))) {
        named = Some(Type.TStruct(structIndex))
      } else {
        errorf(mutable checker, pos, `${quoteGo(typeName)} is not a struct`)
        return Type.TVoid
      }
    }
  }
  let hint = want
  if (named is Some(_)) {
    hint = named
  }
  const spreadPos = getExpressionPos(spread)
  const spreadType = checkExpression(mutable checker, walker, spread, hint)
  let spreadIndex = -1
  if (spreadType is Type.TStruct(index)) {
    if (!checker.structs[index].tuple) {
      spreadIndex = index
    }
  }
  if (spreadIndex < 0) {
    const message = `a spread needs a struct value, found ${typeString(checker, spreadType)}`
    errorf(mutable checker, spreadPos, message)
    return Type.TVoid
  }
  if (isHiddenStruct(checker, spreadIndex)) {
    const message = `cannot spread ${typeString(checker, spreadType)}: it is an opaque struct of module ${quoteGo(checker.structs[spreadIndex].module)}`
    errorf(mutable checker, spreadPos, message)
  }

  // The spread must have the type of the literal.
  let target = hint
  if (genericIndex >= 0) {
    if (checker.structs[spreadIndex].name != checker.generics[genericIndex].name || checker.structs[spreadIndex].module != checker.generics[genericIndex].module) {
      const message = `cannot spread ${typeString(checker, spreadType)} into a ${typeName} literal; the spread must have the literal's type`
      errorf(mutable checker, spreadPos, message)
      return Type.TVoid
    }
    target = None
  }
  if (target is Some(Type.TStruct(targetIndex))) {
    const targetType = Type.TStruct(targetIndex)
    if (targetType != spreadType) {
      const message = `cannot spread ${describeType(checker, spreadType, targetType)} into a ${describeType(checker, targetType, spreadType)} literal; the spread must have the literal's type`
      errorf(mutable checker, spreadPos, message)
      return targetType
    }
  }

  // Then the fields that change.
  const structFields = checker.structs[spreadIndex].fields
  const structText = typeString(checker, spreadType)
  let seen: Map<string, bool> = Map {}
  for (const field of Arrays.values(fields)) {
    const fieldIndex = findField(structFields, field.name)
    if (fieldIndex < 0) {
      errorf(mutable checker, field.pos, `struct ${structText} has no field ${quoteGo(field.name)}`)
      checkExpression(mutable checker, walker, field.value, None)
      continue
    }
    if (seen[field.name] is Some(_)) {
      errorf(mutable checker, field.pos, `field ${quoteGo(field.name)} is given twice`)
    }
    seen[field.name] = true
    const fieldType = structFields[fieldIndex].fieldType
    const valueType = checkExpression(mutable checker, walker, field.value, Some(fieldType))
    expectType(mutable checker, getExpressionPos(field.value), Some(fieldType), valueType)
  }
  return spreadType
}
