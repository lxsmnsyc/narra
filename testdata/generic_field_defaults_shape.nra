import * as Json from "std/json"
import { Shape } from "std/shape"

struct Slot<T> derives Shape {
  name: string
  value: Option<T> = None
  tags: Array<T> = []
}

function decodeSlot<T: Shape>(text: string): string uses alloc {
  const result: Result<Slot<T>, string> = Json.decode(text)
  if (result is Err(message)) {
    return `error: ${message}`
  }
  return `ok: ${Json.encode(result.value)}`
}

export function run(_args: Array<string>): int uses io, alloc {
  print(decodeSlot<int>("{\"name\":\"a\"}"))
  print(decodeSlot<string>("{\"name\":\"b\",\"value\":\"x\"}"))
  print(decodeSlot<string>("{\"name\":\"c\",\"tags\":[\"p\",\"q\"]}"))
  return 0
}
