// An @const body calls the std functions of char, option, result, math, bytes,
// fixedarray and the sized number modules. Each constant is printed beside the
// same call made at run time.
import * as Arrays from "std/array"
import * as Bytes from "std/bytes"
import * as Char from "std/char"
import * as F32 from "std/f32"
import * as Float from "std/float"
import * as Fixed from "std/fixedarray"
import * as I8 from "std/i8"
import * as I16 from "std/i16"
import * as I32 from "std/i32"
import * as Int from "std/int"
import * as Math from "std/math"
import * as Options from "std/option"
import * as Results from "std/result"
import * as Str from "std/string"
import * as U8 from "std/u8"
import * as U16 from "std/u16"
import * as U32 from "std/u32"
import * as U64 from "std/u64"

@const
function charText(code: int): string uses alloc {
  const found = Char.fromCode(code)
  return match (found) {
    Some(character) => `${Str.fromChar(character)}${Int.toString(Char.code(character))}`
    None => "none"
  }
}

@const
function optionText(value: int): string uses alloc {
  const some: Option<int> = Some(value)
  const none: Option<int> = None
  const failed: Result<int, string> = Options.okOr(none, "missing")
  const passed: Result<int, string> = Options.okOr(some, "missing")
  return `${Options.isSome(some) ? "s" : "n"}${Options.isNone(none) ? "n" : "s"}${Int.toString(Options.withDefault(none, 7))}${Int.toString(Options.withDefault(some, 7))}${Int.toString(Results.withDefault(failed, 1))}${Int.toString(Results.withDefault(passed, 1))}`
}

@const
function resultText(text: string, base: int): string uses alloc {
  const parsed = Int.parse(text, base)
  const value = Results.withDefault(parsed, 0 - 1)
  const error = match (Results.err(parsed)) { Some(message) => message, None => "-" }
  return `${Int.toString(value)} ${error} ${Results.ok(parsed) is Some(_) ? "ok" : "err"}`
}

@const
function mathText(value: int, number: f64): string uses alloc {
  const power = Math.powInt(value, 5)
  const clamped = Math.clamp(value, 0 - 3, 3)
  return `${Int.toString(Math.abs(value))} ${Int.toString(Math.min(value, 4))} ${Int.toString(Math.max(value, 4))} ${Int.toString(Options.withDefault(power, 0))} ${Int.toString(Options.withDefault(clamped, 99))} ${Float.toString(Math.absFloat(number))} ${Float.toString(Math.sqrt(number * number))} ${Float.toString(Math.floor(number))} ${Float.toString(Math.ceil(number))} ${Float.toString(Math.round(number))} ${Float.toString(Math.trunc(number))} ${Float.toString(Math.PI)} ${Float.toString(Math.E)}`
}

@const
function bytesText(text: string, items: Array<u8>): string uses alloc {
  const data = Bytes.fromString(text)
  const joined = Bytes.concat(data, Bytes.fromArray(items))
  const middle = Bytes.slice(joined, 1, 4)
  const restored = Bytes.toArray(joined)
  const asText = Bytes.toString(Bytes.fromArray(items))
  let total = 0
  for (const item of restored) {
    total += Int.from(item)
  }
  const first = Options.withDefault(Bytes.at(joined, 0), U8.wrap(0))
  const missing = Options.withDefault(Bytes.at(joined, 99), U8.wrap(255))
  const sliceLength = match (middle) { Some(part) => Bytes.length(part), None => 0 - 1 }
  const outside = Bytes.slice(joined, 3, 99) is None
  return `${Int.toString(Bytes.length(joined))} ${Int.toString(total)} ${Int.toString(Int.from(first))} ${Int.toString(Int.from(missing))} ${Int.toString(sliceLength)} ${outside ? "none" : "some"} ${Results.withDefault(asText, "bad")}`
}

@const
function fixedText(values: FixedArray<int, 4>): string uses alloc {
  const inside = Options.withDefault(Fixed.get(values, 2), 0 - 1)
  const outside = Options.withDefault(Fixed.get(values, 9), 0 - 1)
  return `${Int.toString(Fixed.length(values))} ${Int.toString(inside)} ${Int.toString(outside)}`
}

@const
function sizedText(wide: int): string uses alloc {
  const a = I8.wrap(wide)
  const b = I16.wrap(wide * 300)
  const c = I32.wrap(wide * 3000000)
  const d = U8.wrap(wide)
  const e = U16.wrap(wide * 300)
  const f = U32.wrap(wide * 3000000)
  const g = U64.wrap(wide * 5)
  const h = U64.wrap(0 - wide)
  const checked = I8.addChecked(a, 100)
  const checkedHigh = U8.mulChecked(d, 3)
  const checkedLow = U32.subChecked(f, 4294967295)
  const widened = I16.from(a)
  const narrowed = I8.tryFrom(wide * 2)
  const unsigned = U8.tryFrom(0 - 1)
  const parsed = I8.parse("-128", 10)
  const tooBig = U8.parse("300", 10)
  return `${I8.toString(a)} ${I16.toString(b)} ${I32.toString(c)} ${U8.toString(d)} ${U16.toString(e)} ${U32.toString(f)} ${U64.toString(g)} ${U64.toString(h)} ${I8.toString(Options.withDefault(checked, 0))} ${U8.toString(Options.withDefault(checkedHigh, 0))} ${U32.toString(Options.withDefault(checkedLow, 0))} ${I16.toString(widened)} ${I8.toString(Options.withDefault(narrowed, 0))} ${unsigned is None ? "none" : "some"} ${I8.toString(Results.withDefault(parsed, 0))} ${tooBig is Ok(_) ? "ok" : "err"}`
}

@const
function floatText(value: f32): string uses alloc {
  const doubled = value * 3.0
  const whole = Options.withDefault(F32.truncate(doubled), 0 - 1)
  return `${F32.toString(doubled)} ${Int.toString(whole)} ${Float.toString(Float.from(doubled))} ${F32.toString(F32.from(Float.from(value) / 7.0))}`
}

@const
function orderText(
  left: string,
  right: string,
  small: f64,
  big: f64,
  wide: int,
): string uses alloc {
  const largest = U64.wrap(0 - wide)
  const product = U64.mulChecked(largest, U64.wrap(2))
  const fits = U64.mulChecked(U64.wrap(4294967296), U64.wrap(4294967295))
  const sum = U64.addChecked(largest, U64.wrap(wide))
  const difference = U64.subChecked(U64.wrap(wide), largest)
  const bigger = U64.toString(Math.max(largest, U64.wrap(5)))
  const smaller = Math.min(Bytes.fromString(left), Bytes.fromString(right))
  return `${Math.min(left, right)} ${Math.max(left, right)} ${Float.toString(Math.min(small, big))} ${Float.toString(Math.max(small, big))} ${Math.max('a', 'b') == 'b' ? "b" : "a"} ${bigger} ${product is None ? "over" : "fits"} ${U64.toString(Options.withDefault(fits, U64.wrap(0)))} ${sum is None ? "over" : "fits"} ${difference is None ? "under" : "fits"} ${Int.toString(Bytes.length(smaller))}`
}

@const
function buildBytes(text: string): bytes uses alloc {
  return Bytes.concat(Bytes.fromString(text), Bytes.fromArray([0, 255]))
}

function describeBytes(data: bytes): string uses alloc {
  let parts: Array<string> = []
  for (const item of Bytes.toArray(data)) {
    Arrays.push(mutable parts, Int.toString(Int.from(item)))
  }
  return `${Int.toString(Bytes.length(data))}:${Str.join(parts, ",")}`
}

const CHARS = charText(955)
const NONE_CHARS = charText(1114112)
const OPTIONS = optionText(5)
const RESULTS = resultText("ff", 16)
const BAD_RESULTS = resultText("zz", 10)
const MATH = mathText(0 - 9, 0.0 - 2.5)
const BYTES = bytesText("héllo", [1, 2, 255])
const FIXED = fixedText([10, 20, 30, 40])
const SIZED = sizedText(200)
const FLOATS = floatText(1.25)
const RAW = buildBytes("hi")
const EMPTY = buildBytes("")
const ORDER = orderText("pear", "apple", 0.5, 1.5, 1)

export function run(args: Array<string>): int uses io, alloc {
  const code = 955
  const missing = 1114112
  const five = 5
  const nine = 0 - 9
  const half: f64 = 0.0 - 2.5
  const quarter: f32 = 1.25
  const items: Array<u8> = [1, 2, 255]
  const fixed: FixedArray<int, 4> = [10, 20, 30, 40]
  const wide = 200
  const one = 1
  const apple = "apple"
  const pear = "pear"
  const low: f64 = 0.5
  const high: f64 = 1.5
  print(`${CHARS} ${charText(code)}`)
  print(`${NONE_CHARS} ${charText(missing)}`)
  print(`${OPTIONS} ${optionText(five)}`)
  print(`${RESULTS} ${resultText("ff", 16)}`)
  print(`${BAD_RESULTS} ${resultText("zz", 10)}`)
  print(`${MATH} ${mathText(nine, half)}`)
  print(`${BYTES} ${bytesText("héllo", items)}`)
  print(`${FIXED} ${fixedText(fixed)}`)
  print(`${SIZED} ${sizedText(wide)}`)
  print(`${FLOATS} ${floatText(quarter)}`)
  print(`${ORDER} ${orderText(pear, apple, low, high, one)}`)
  const text = "hi"
  print(`${describeBytes(RAW)} ${describeBytes(buildBytes(text))}`)
  print(describeBytes(EMPTY))
  return 0
}
