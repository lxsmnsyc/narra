// error: a closure cannot capture "offset" because it is declared with let
import * as Iterators from "std/iterator"
import * as Int from "std/int"

function* numbers(): Generator<int> {
  yield 1
  yield 2
}

export function run(args: Array<string>): int uses io, alloc {
  // map keeps its callback in the generator, so the callback is escaping.
  let offset = 10
  offset = offset + 1
  const shifted = Iterators.map(numbers(), (value: int): int => value + offset)
  for (const value of shifted) {
    print(Int.toString(value))
  }
  return 0
}
