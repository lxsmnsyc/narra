import * as Int from "std/int"
import * as Shapes from "app/shapes"
import { Point, Shape, area as measure } from "app/shapes"

function describe(shape: Shape): int {
  return match (shape) {
    Shape.Circle(radius) => 3 * radius * radius
    Shape.Square(side) => side * side
  }
}

function pick(value: Option<int>): int {
  if (value is Some(count)) {
    return count
  }
  return 0
}

export function run(arguments: Array<string>): int uses io, alloc {
  const #[left, right] = #[1, 2]
  const text = Int.toString(left + right)
  print(text)
  let total = 0
  for (const item of [left, right]) {
    total += item
  }
  const shape = Shape.Circle(2)
  return describe(shape) + pick(Some(total)) + measure(shape) + Shapes.area(shape)
}

export function show(count: int): string uses io, alloc {
  const lines = [Int.toString(count), `${Int.toString(count)}`]
  print(`${Int.toString(count)} ${lines[0]}`)
  return match (count) { 0 => Int.toString(0), _ => `${Int.toString(count)}` }
}

struct Player {
  name: string
  hp: int
}

export function spawn(base: Player): int {
  const hero = Player { name: "Ana", hp: 100 }
  const point = Point { x: 1, y: 2 }
  const healed = Player { ...base, hp: point.x }
  const circle = Shape.Circle(3)
  return hero.hp + healed.hp + measure(circle)
}
