// error: generator_bound_pass.nra:20:23: expected Generator<int> uses alloc, found Generator<int> uses alloc, io
export function* noisy(): Generator<int> uses io {
  print("hi")
  yield 1
}

export function* mapG<effect E>(g: Generator<int> uses E): Generator<int> uses E, alloc {
  yield* g
}

function id<T>(value: T): T from value {
  return value
}

function count(_numbers: Generator<int> uses alloc): int {
  return 0
}

export function quiet(): int uses alloc {
  return count(id(mapG(noisy())))
}

export function run(args: Array<string>): int {
  return quiet()
}
