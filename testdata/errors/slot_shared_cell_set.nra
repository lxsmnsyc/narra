// error: Arrays.push(mutable items, ...) may change items, which the cell cell[] still holds; no fix is offered here: copy the value by hand where the sharing starts, or end the sharing before the write
import * as Arrays from "std/array"
import * as Cells from "std/cell"

export function run(_args: Array<string>): int {
  const cell = Cells.create<Array<int>>([])
  let items = [1, 2, 3]
  Cells.set(cell, items)
  Arrays.push(mutable items, 4)
  return Arrays.length(Cells.get(cell))
}
