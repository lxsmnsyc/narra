// Thread.join waits once and keeps the result: a second join gives the same
// value, and the scope does not join the thread again. A thread that nobody
// joins is joined by its scope.
import * as Thread from "std/thread"
import * as Int from "std/int"

function describe(number: int): string uses alloc {
  return `thread result ${Int.toString(number)}`
}

export function run(_args: Array<string>): int {
  const both = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => describe(42))
    Thread.start(scope, () => describe(7))
    const first = Thread.join(worker)
    const second = Thread.join(worker)
    return `${first} / ${second}`
  })
  print(both)
  return 0
}
