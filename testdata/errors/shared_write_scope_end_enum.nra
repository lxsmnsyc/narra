// error: Arrays.push(mutable bag.items, ...) may change bag.items, which held still holds until its block ends at line 23
// An enum holds what its payload holds: held keeps the array of bag.items
// until its block ends, so the push would copy it.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Bag {
  items: Array<int>
}

function make(): Bag uses alloc {
  return Bag { items: [1, 2] }
}

export function run(_args: Array<string>): int uses io, alloc {
  let bag = make()
  const held = Some(bag.items)
  if (held is Some(items)) {
    print(Int.toString(items[0]))
  }
  Arrays.push(mutable bag.items, 4)
  return 0
}
