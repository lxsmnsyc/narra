import * as Ranges from "std/range"
import * as Int from "std/int"

function collect(range: Range): string uses alloc {
  let text = ""
  for (const value of range) {
    text = `${text}${Int.toString(value)} `
  }
  return text
}

export function run(args: Array<string>): int uses io, alloc {
  for (const value of Ranges.stepped(0, 10, 3)) {
    print(Int.toString(value))
  }
  print(collect(Ranges.stepped(10, 0, -4)))
  print(collect(Ranges.stepped(5, 5, 1)))
  print(collect(Ranges.stepped(5, 0, 1)))
  print(collect(Ranges.stepped(0, 5, -1)))
  print(collect(Ranges.upTo(4)))
  print(collect(Ranges.between(2, 5)))
  let range = Ranges.stepped(1, 20, 7)
  print(collect(range))
  for (const value of Ranges.stepped(9223372036854775800, 9223372036854775807, 5)) {
    print(Int.toString(value))
  }
  for (const value of Ranges.stepped(0, 100, 2)) {
    if (value == 4) {
      continue
    }
    if (value > 8) {
      break
    }
    print(Int.toString(value))
  }
  return 0
}
