import * as I8 from "std/i8"
import * as I16 from "std/i16"
import * as I32 from "std/i32"
import * as U8 from "std/u8"
import * as U16 from "std/u16"
import * as U32 from "std/u32"
import * as U64 from "std/u64"
import * as F32 from "std/f32"

export function run(args: Array<string>): int uses io, alloc {
  if (I8.parse("-128", 10) is Ok(value)) {
    print(I8.toString(value))
  }
  if (I16.parse("-7f", 16) is Ok(value)) {
    print(I16.toString(value))
  }
  if (I32.parse("2147483647", 10) is Ok(value)) {
    print(I32.toString(value))
  }
  if (U8.parse("255", 10) is Ok(value)) {
    print(U8.toString(value))
  }
  if (U16.parse("ffff", 16) is Ok(value)) {
    print(U16.toString(value))
  }
  if (U32.parse("4294967295", 10) is Ok(value)) {
    print(U32.toString(value))
  }
  if (U64.parse("18446744073709551615", 10) is Ok(value)) {
    print(U64.toString(value))
  }
  if (U8.parse("256", 10) is Err(message)) {
    print(message)
  }
  if (F32.truncate(F32.from(2.75)) is Some(_value)) {
    print("truncated")
  }
  print(F32.toString(F32.from(1.5)))
  return 0
}
