import * as Test from "std/test"

test "passes first" {
  Test.eq(1 + 1, 2)
}

test "fails on eq" {
  print("printed before the failure")
  Test.eq(1 + 1, 3)
}

test "fails on assert" {
  assert(1 > 2)
}

test "fails on bounds" {
  const xs = [1, 2]
  const i = 5
  Test.eq(xs[i], 0)
}

test "passes after failures" {
  Test.ne("a", "b")
}
