import * as Int from "std/int"
import * as Str from "std/string"

const LIMIT = 3 + 4
const NAME: string = "box"
const SCALE = -2.5
const FLAGS = [true, false]

struct Point {
  x: int
  y: int = 2
  label: string = "p"
}

struct Line {
  head: Point
  tail: Point
}

function add(a: int, b: int): int {
  const sum = a + b
  return sum
}

function shift(point: Point, by: int): Point {
  return Point { x: point.x + by, y: point.y }
}

function describe(line: Line): string {
  const width = line.tail.x - line.head.x
  return `${NAME} ${Int.toString(width)}`
}

function bits(n: int): int {
  let value = n << 2
  value = value | 1
  value = ~value & 0xff
  return value +% 1
}

export function run(args: Array<string>): int {
  let total = add(1, LIMIT)
  const start = Point { x: total }
  let line = Line { head: start, tail: shift(start, 3) }
  line.tail.x = 10
  total = line.tail.x * 2
  const values = [1, 2, total]
  const first = values[0]
  const ratio = 1.5 / SCALE
  const letter = 'n'
  let count = 0
  while (count < 3 && first >= 1) {
    count = count + 1
    if (count == 2) {
      break
    }
  }
  if (!(total > 10) || ratio < 0.0) {
    print("small")
  } else if (letter != 'm') {
    print(describe(line))
  } else {
    print(Str.repeat("x", bits(count)))
  }
  if (FLAGS[1]) {
    panic("unreachable")
  }
  return -first + 1
}

test "adds" {
  assert(add(1, 2) == 3)
  const words = ["a", "b"]
  assert(Str.join(words, ",") == "a,b")
}
