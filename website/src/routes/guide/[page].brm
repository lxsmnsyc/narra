<script>
  import { getEvent } from 'brumate/server';
  import { $props } from 'brumate/signals';
  import DocPage from '../../components/DocPage.brm';
  import { findChapter } from '../../pages.ts';

  const { params } = $props<{ params: { page: string } }>();
  const chapter = findChapter(params.page);
  if (!chapter) {
    getEvent().setStatus(404);
  }
</script>

#if (chapter) {
  <DocPage page=chapter.page path=(`guide/${chapter.slug}`) slug=(chapter.slug) />
} #else {
  <main class="not-found">
    <h1>Not found</h1>
    <p>There is no chapter at this address. <a href="/guide">Back to the guide</a>.</p>
  </main>
}
