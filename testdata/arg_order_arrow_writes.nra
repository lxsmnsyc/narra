// An argument before an arrow that assigns a captured `let` is held in a
// temporary, so the call reads it in the written order.
import * as Int from "std/int"

function pair(left: int, right: int): string {
  return `${Int.toString(left)},${Int.toString(right)}`
}

function runIt(start: int, step: (n: int) => int): int {
  return step(start)
}

export function run(args: Array<string>): int {
  // the arrow writes `counter`: the first argument keeps its old value
  let counter = 1
  print(
    pair(
      counter,
      runIt(5, (n) => {
        counter = counter + n
        return counter
      }),
    ),
  )
  // a block-bodied arrow that only reads: no temporary is needed
  let base = 2
  print(
    pair(
      base,
      runIt(5, (n) => {
        const doubled = base * n
        return doubled
      }),
    ),
  )
  return 0
}
