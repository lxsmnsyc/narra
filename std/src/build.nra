// std/build: the target a program is built for. The compiler sets os, arch and
// debug for each build; the values written here are replaced. An `if` that
// tests only these constants keeps one branch in the output.

import * as Host from "std/internal/host"

export enum Os derives Show, Equatable {
  MacOS
  Linux
  Windows
}

export enum Arch derives Show, Equatable {
  Arm64
  X86_64
}

export const os: Os = Os.Linux
export const arch: Arch = Arch.X86_64
export const debug: bool = true

export struct Target {
  os: Os
  arch: Arch
}

export function hostTarget(): Option<Target> {
  const hostOs = Host.os()
  const hostArch = Host.arch()
  // The C compiler's predefined macros give the codes; 0 is a machine with no variant here.
  if (hostOs == 0 || hostArch == 0) {
    return None
  }
  if (hostOs == 1 && hostArch == 1) {
    return Some(Target { os: Os.MacOS, arch: Arch.Arm64 })
  }
  if (hostOs == 1) {
    return Some(Target { os: Os.MacOS, arch: Arch.X86_64 })
  }
  if (hostArch == 1) {
    return Some(Target { os: Os.Linux, arch: Arch.Arm64 })
  }
  return Some(Target { os: Os.Linux, arch: Arch.X86_64 })
}
