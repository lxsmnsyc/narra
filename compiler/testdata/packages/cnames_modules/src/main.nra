import * as Int from "std/int"
import * as Opt from "cn__pkg/Option"
import * as AB from "cn__pkg/a__b"
import * as A from "cn__pkg/a"
import { Point_retain, Point } from "cn__pkg/a"

trait T_ {
  function _f(x: Self): int
}

struct X implements T_ {
  a: int
}

implement T_ for X {
  function _f(x: X): int {
    return x.a
  }
}

export function run(args: Array<string>): int {
  // a__b.b__c and a.b__c are different functions.
  print(Int.toString(AB.b__c() + A.b__c()))
  print(Int.toString(AB._b()))
  // The module Option and the prelude Option<int> live side by side.
  const some: Option<int> = Some(Opt.Some())
  print(Show.show(some))
  const boxed = Opt.wrap(3)
  print(Int.toString(boxed.item))
  // Types named like the C functions of another type.
  const p = Point_retain { n: 4 }
  const q = Point { n: 6 }
  print(Int.toString(p.n + q.n))
  print(Int.toString(T_._f(X { a: 8 })))
  // Tuples with the same flattened elements but different shapes.
  const t1: #[#[int, int], int] = #[#[1, 2], 3]
  const t2: #[int, #[int, int]] = #[1, #[2, 3]]
  const #[#[a, b], c] = t1
  const #[d, #[e, f]] = t2
  print(Int.toString(a + b + c + d + e + f))
  return 0
}
