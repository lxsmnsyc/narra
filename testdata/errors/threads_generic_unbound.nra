// error: declare the type parameter as <T: Sendable>
import * as Thread from "std/thread"

function sendBack<T>(value: T): T uses alloc {
  return Thread.scope((scope) => {
    const worker = Thread.start(scope, () => value)
    return Thread.join(worker)
  })
}

export function run(_args: Array<string>): int {
  return sendBack(0)
}
