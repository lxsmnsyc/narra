// error: the length of FixedArray<int, N> is a constant parameter, so only `[..._]` matches every value; use match or `is` to test the length
function sum<const N: int>(values: FixedArray<int, N>): int {
  const [a, b] = values
  return a + b
}

export function run(_args: Array<string>): int {
  const pair: FixedArray<int, 2> = [1, 2]
  return sum(pair)
}
