// error: grow(mutable bag) may change bag.items, which items still holds until its block ends at line 21
// A `mutable` argument may change everything inside it, and items holds
// bag.items until its block ends.
import * as Arrays from "std/array"

struct Bag {
  items: Array<int>
  count: int
}

function grow(mutable bag: Bag) uses alloc {
  Arrays.push(mutable bag.items, 3)
}

export function run(_args: Array<string>): int uses alloc {
  let bag = Bag { items: [1, 2], count: 0 }
  const items = bag.items
  bag.count = items[0]
  grow(mutable bag)
  return bag.count
}
