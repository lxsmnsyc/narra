// error: E1054, a std call costs steps for the bytes it scans
import * as Str from "std/string"
import * as Int from "std/int"

@const
function scan(count: int): int uses alloc {
  let found = 0
  if (Str.repeat("a", 8000000) is Some(text)) {
    for (let index = 0; index < count; index++) {
      if (Str.contains(text, "ab")) {
        found++
      }
      if (Str.indexOf(text, "b") is Some(_)) {
        found++
      }
    }
  }
  return found
}

const FOUND = scan(2000)

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(FOUND))
  return 0
}
