import * as Int from "std/int"
import * as Ranges from "std/range"
import * as Options from "std/option"

function halve(value: int): Option<int> {
  if (value % 2 == 0) {
    return Some(value / 2)
  }
  return None
}

export function run(args: Array<string>): int {
  let total = 0
  const offset = 3
  for (const round of Ranges.upTo(100000000)) {
    const start: Option<int> = Some(round)
    const shifted = Options.map(start, (value) => value + offset)
    const halved = Options.andThen(shifted, halve)
    const result = Options.orElse(halved, () => Some(round % 7))
    total = (total + Options.withDefault(result, 0)) % 1000003
  }
  print(Int.toString(total))
  return 0
}
