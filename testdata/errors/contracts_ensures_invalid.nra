// error: the comparison pattern `>=` needs an integer value, found string
// A comparison needs an integer, a pattern binds nothing, and a bound is a
// constant that fits the type; a parameter named like a constant is the parameter.
const low = 0

function name(): string
  ensures >= 0
{
  return "a"
}

function nothing(value: int)
  ensures > 0
{
  print(Show.show(value))
}

function binds(value: int): Option<int>
  ensures Some(result)
{
  return Some(value)
}

function small(value: u8): u8
  ensures < 256
{
  return value
}

function shadowed(low: int): int
  ensures >= low
{
  return low
}

function called(value: int): int
  ensures >= Show.show(value)
{
  return value
}

function ratio(value: f64): Option<f64>
  ensures Some(> 0) | None
{
  return Some(value)
}

function huge(): u64
  ensures 9223372036854775808
{
  return 9223372036854775808
}

function largest(): int
  ensures 9223372036854775807 | -9223372036854775807
{
  return 9223372036854775807
}

export function run(_args: Array<string>): int {
  nothing(1)
  return low
}
