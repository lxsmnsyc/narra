export trait Show {
  function show(value: Self): string
  function describe(value: Self, extra: int): string uses alloc
}
trait Empty {}
implement Show for Point {
  function show(value: Point): string {
    return "p"
  }

  function describe(value: Point, extra: int): string {
    return "d"
  }
}
implement Empty for Point {}
test "adds numbers" {
  assert(1 + 1 == 2)
}
test "empty" {}
