
function loud(value: int): int {
  print("x")
  return value
}

export struct Box {
  f: (value: int) => int uses io
}
export function apply(f: (value: int) => int, x: int): int {
  return f(x)
}
export function pure(b: Box): int uses io {
  return apply(b.f, 1)
}

export function run(args: Array<string>): int {
  return 0
}
