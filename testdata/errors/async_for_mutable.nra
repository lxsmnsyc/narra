// error: `for (mutable ...)` is not allowed in an async body; change the elements through an index, as in `items[index].field = value`
struct Counter {
  count: int
}

async function bump(values: Array<Counter>): int {
  let items = copy(values)
  for (mutable item of items) {
    item.count += 1
  }
  return items[0].count
}

export async function run(_args: Array<string>): int {
  return await bump([Counter { count: 1 }])
}
