// The [fmt] table of narra.toml for `narrac fmt`: printWidth, tabWidth,
// useTabs and trailingComma. Every other table and key of the file is not
// read here (the package loader skips [fmt]). An unknown key in [fmt] or a
// value of the wrong type is an error `narra.toml:<line>: <message>`.
import { splitString, substring } from "narrac/textops"
import * as Fs from "std/fs"
import * as Env from "std/env"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export struct FmtConfig {
  printWidth: int
  tabWidth: int
  useTabs: bool
  trailingComma: bool // true for "all", false for "none"
}

export function createDefaultConfig(): FmtConfig {
  return FmtConfig { printWidth: 100, tabWidth: 2, useTabs: false, trailingComma: true }
}

function stripComment(line: string): string uses alloc {
  let quote = 0
  let escaped = false
  for (const index of Ranges.upTo(Str.length(line))) {
    const byte = Str.byteAt(line, index)
    if (quote != 0) {
      // A backslash escapes the next byte of a basic string.
      if (escaped) {
        escaped = false
      } else if (byte == 92 && quote == 34) {
        escaped = true
      } else if (byte == quote) {
        quote = 0
      }
    } else if (byte == 34 || byte == 39) {
      quote = byte
    } else if (byte == 35) {
      return substring(line, 0, index)
    }
  }
  return line
}

function createError(line: int, message: string): string uses alloc {
  return `narra.toml:${Int.toString(line)}: ${message}`
}

function parsePositive(raw: string, key: string, line: int): Result<int, string> uses alloc {
  const parsed = Int.parse(raw, 10)
  if (parsed is Err(_)) {
    return Err(createError(line, `${key} must be a positive integer`))
  }
  if (parsed.value < 1) {
    return Err(createError(line, `${key} must be a positive integer`))
  }
  return Ok(parsed.value)
}

export function parseFmtConfig(text: string): Result<FmtConfig, string> uses alloc {
  let config = createDefaultConfig()
  let inFmt = false
  const lines = splitString(text, "\n")
  for (const index of Ranges.upTo(Arrays.length(lines))) {
    const lineNumber = index + 1
    const line = Str.trim(stripComment(lines[index]))
    if (Str.startsWith(line, "[") && Str.endsWith(line, "]")) {
      inFmt = Str.trim(substring(line, 1, Str.length(line) - 1)) == "fmt"
      continue
    }
    if (!inFmt || line == "") {
      continue
    }
    const equalsIndex = Str.indexOf(line, "=")
    if (equalsIndex is None) {
      return Err(createError(lineNumber, "expected `key = value`"))
    }
    const key = Str.trim(substring(line, 0, equalsIndex.value))
    const raw = Str.trim(Str.sliceFrom(line, equalsIndex.value + 1))
    if (key == "printWidth" || key == "tabWidth") {
      const number = parsePositive(raw, key, lineNumber)
      if (number is Err(message)) {
        return Err(message)
      }
      if (key == "printWidth") {
        config = FmtConfig { ...config, printWidth: number.value }
      } else {
        config = FmtConfig { ...config, tabWidth: number.value }
      }
    } else if (key == "useTabs") {
      if (raw != "true" && raw != "false") {
        return Err(createError(lineNumber, "useTabs must be true or false"))
      }
      config = FmtConfig { ...config, useTabs: raw == "true" }
    } else if (key == "trailingComma") {
      if (raw != "\"all\"" && raw != "\"none\"") {
        return Err(createError(lineNumber, "trailingComma must be \"all\" or \"none\""))
      }
      config = FmtConfig { ...config, trailingComma: raw == "\"all\"" }
    } else {
      return Err(createError(lineNumber, `unknown key ${key} in [fmt]`))
    }
  }
  return Ok(config)
}

function normalizePath(path: string): string uses alloc {
  let segments: Array<string> = []
  for (const segment of Arrays.values(splitString(path, "/"))) {
    if (segment == "" || segment == ".") {
      continue
    }
    if (segment == "..") {
      if (Arrays.length(segments) > 0) {
        let kept: Array<string> = []
        for (const index of Ranges.upTo(Arrays.length(segments) - 1)) {
          Arrays.push(mutable kept, segments[index])
        }
        segments = kept
      }
      continue
    }
    Arrays.push(mutable segments, segment)
  }
  return `/${Str.join(segments, "/")}`
}

function normalizeRelative(path: string): string uses alloc {
  let segments: Array<string> = []
  for (const segment of Arrays.values(splitString(path, "/"))) {
    if (segment == "" || segment == ".") {
      continue
    }
    // A `..` resolves against the segment before it; a path that climbs above its start keeps the
    // `..`.
    if (
      segment == ".." &&
        Arrays.length(segments) > 0 &&
        segments[Arrays.length(segments) - 1] != ".."
    ) {
      let kept: Array<string> = []
      for (const index of Ranges.upTo(Arrays.length(segments) - 1)) {
        Arrays.push(mutable kept, segments[index])
      }
      segments = kept
      continue
    }
    Arrays.push(mutable segments, segment)
  }
  if (Arrays.length(segments) == 0) {
    return "."
  }
  return Str.join(segments, "/")
}

function getParent(path: string): string uses alloc {
  // Parent of a normalized path: `a/b` gives `a`, `a` gives `.`, `.` gives `..` and `..` gives
  // `../..`.
  if (path == ".") {
    return ".."
  }
  const parts = splitString(path, "/")
  if (parts[Arrays.length(parts) - 1] == "..") {
    return `${path}/..`
  }
  if (Arrays.length(parts) == 1) {
    return "."
  }
  let kept: Array<string> = []
  for (const index of Ranges.upTo(Arrays.length(parts) - 1)) {
    Arrays.push(mutable kept, parts[index])
  }
  return Str.join(kept, "/")
}

export function getDirectory(path: string, isDirectory: bool): string uses io, alloc {
  // The result is absolute when the path is, or when PWD is set; otherwise it stays relative to the
  // current directory.
  let absolute = path
  if (!Str.startsWith(path, "/")) {
    if (Env.get("PWD") is Some(working)) {
      if (working != "") {
        absolute = `${working}/${path}`
      }
    }
  }
  if (!Str.startsWith(absolute, "/")) {
    const relative = normalizeRelative(absolute)
    if (isDirectory) {
      return relative
    }
    return getParent(relative)
  }
  const normalized = normalizePath(absolute)
  if (isDirectory) {
    return normalized
  }
  const parts = splitString(normalized, "/")
  if (Arrays.length(parts) <= 2) {
    return "/"
  }
  let kept: Array<string> = []
  for (const index of Ranges.upTo(Arrays.length(parts) - 1)) {
    Arrays.push(mutable kept, parts[index])
  }
  return Str.join(kept, "/")
}

export function findConfig(directory: string): Result<FmtConfig, string> uses io, alloc {
  let current = directory
  // A relative directory climbs with `..`, up to 64 levels.
  for (const _level of Ranges.upTo(64)) {
    let manifest = `${current}/narra.toml`
    if (current == "/") {
      manifest = "/narra.toml"
    }
    if (Fs.exists(manifest)) {
      const read = Fs.readText(manifest)
      if (read is Err(message)) {
        return Err(message)
      }
      return parseFmtConfig(read.value)
    }
    if (current == "/") {
      break
    }
    if (Str.startsWith(current, "/")) {
      const parts = splitString(current, "/")
      let kept: Array<string> = []
      for (const index of Ranges.upTo(Arrays.length(parts) - 1)) {
        Arrays.push(mutable kept, parts[index])
      }
      current = Str.join(kept, "/")
      if (current == "") {
        current = "/"
      }
    } else {
      current = getParent(current)
    }
  }
  // No narra.toml found: use the defaults.
  return Ok(createDefaultConfig())
}
