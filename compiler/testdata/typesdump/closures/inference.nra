import * as Int from "std/int"

function pair<T, U>(first: T, second: U, combine: (a: T, b: U) => string): string {
  return combine(first, second)
}

function twice<T>(value: T, step: (v: T) => T): T {
  return step(step(value))
}

function choose<T>(first: T, second: T, pick: (a: T, b: T) => bool): T {
  if (pick(first, second)) {
    return first
  }
  return second
}

function identity<T>(value: T): T {
  return value
}

function applyInt(f: (x: int) => int): int {
  return f(1)
}

function run(args: Array<string>): int {
  const offset = 3

  // Block arrows: inferred results, void results and bare returns.
  const sign = (x: int) => {
    if (x < 0) {
      return -1
    }
    if (x == 0) {
      return 0
    }
    return 1
  }

  const noop = (x: int) => {
    print(Int.toString(x))
  }

  const early = (x: int) => {
    if (x < 0) {
      return
    }
    print("positive")
  }

  // The hint comes from the arguments before the arrow.
  print(pair(1, "a", (a, b) => `${Int.toString(a)}${b}`))
  print(Int.toString(twice(2, (v) => v + offset)))
  print(Int.toString(choose(1, 2, (a, b) => a < b)))
  print(Int.toString(sign(-4)))
  noop(sign(2))
  early(1)

  // A generic function as a value takes its types from the context.
  print(Int.toString(applyInt(identity)))
  const direct: (x: int) => int = identity
  print(Int.toString(direct(5)))
  return 0
}
