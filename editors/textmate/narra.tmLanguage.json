{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Narra",
  "scopeName": "source.narra",
  "fileTypes": ["nra"],
  "patterns": [{ "include": "#statement" }],
  "repository": {
    "statement": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#annotation" },
        { "include": "#declaration" },
        { "include": "#expression" }
      ]
    },
    "expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#annotation" },
        { "include": "#tagged-template" },
        { "include": "#template" },
        { "include": "#unterminated" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        { "include": "#uses-clause" },
        { "include": "#keyword" },
        { "include": "#type-annotation" },
        { "include": "#function-call" },
        { "include": "#type-name" },
        { "include": "#constant-name" },
        { "include": "#operator" },
        { "include": "#punctuation" },
        { "include": "#identifier" }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.block.documentation.narra",
          "begin": "/\\*\\*(?!/)",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.narra" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.narra" } }
        },
        {
          "name": "comment.block.narra",
          "begin": "/\\*",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.narra" } },
          "end": "\\*/",
          "endCaptures": { "0": { "name": "punctuation.definition.comment.narra" } }
        },
        {
          "name": "comment.line.documentation.narra",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.narra",
          "match": "//.*$"
        }
      ]
    },
    "annotation": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "punctuation.definition.decorator.narra" },
        "2": { "name": "entity.name.function.decorator.narra meta.annotation.narra" }
      }
    },
    "declaration": {
      "patterns": [
        {
          "match": "\\b(function)(\\*)?(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "storage.type.function.narra" },
            "2": { "name": "keyword.generator.asterisk.narra" },
            "3": { "name": "entity.name.function.narra" }
          }
        },
        {
          "match": "\\b(struct|enum|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.narra" },
            "2": { "name": "entity.name.type.narra" }
          }
        },
        {
          "match": "\\b(?:(opaque|distinct)\\s+)?(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.narra" },
            "2": { "name": "storage.type.narra" },
            "3": { "name": "entity.name.type.alias.narra" }
          }
        },
        {
          "match": "\\b(implement)\\s+([A-Za-z_][A-Za-z0-9_.]*)\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
          "captures": {
            "1": { "name": "storage.type.narra" },
            "2": { "name": "entity.other.inherited-class.narra" },
            "3": { "name": "keyword.other.narra" },
            "4": { "name": "entity.name.type.narra" }
          }
        }
      ]
    },
    "uses-clause": {
      "begin": "\\b(uses)\\b",
      "beginCaptures": { "1": { "name": "keyword.other.uses.narra" } },
      "end": "(?=\\{|=>|;|\\)|$)",
      "patterns": [
        { "include": "#comment" },
        {
          "name": "support.type.effect.narra",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        { "name": "punctuation.separator.comma.narra", "match": "," }
      ]
    },
    "type-annotation": {
      "begin": "(:)(?!:)",
      "beginCaptures": { "1": { "name": "keyword.operator.type.annotation.narra" } },
      "end": "(?=,|\\)|\\]|=|\\{|\\}|;|\\buses\\b|\\brequires\\b|\\bensures\\b|$)",
      "patterns": [{ "include": "#type-expression" }]
    },
    "type-expression": {
      "patterns": [
        { "include": "#comment" },
        { "include": "#tagged-template" },
        { "include": "#template" },
        { "include": "#unterminated" },
        { "include": "#string" },
        { "include": "#char" },
        { "include": "#number" },
        {
          "begin": "<",
          "beginCaptures": { "0": { "name": "punctuation.definition.typeparameters.begin.narra" } },
          "end": ">|(?=[;{}])",
          "endCaptures": { "0": { "name": "punctuation.definition.typeparameters.end.narra" } },
          "patterns": [{ "include": "#type-expression" }]
        },
        {
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.parenthesis.open.narra" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.parenthesis.close.narra" } },
          "patterns": [{ "include": "#type-annotation" }, { "include": "#type-expression" }]
        },
        {
          "begin": "#?\\[",
          "beginCaptures": { "0": { "name": "punctuation.definition.tuple.begin.narra" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.definition.tuple.end.narra" } },
          "patterns": [{ "include": "#type-expression" }]
        },
        {
          "name": "support.type.primitive.narra",
          "match": "\\b(?:int|bool|char|string|void|never|f32|f64|i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)\\b"
        },
        {
          "name": "entity.name.type.narra",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.narra",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        { "name": "punctuation.accessor.narra", "match": "\\." },
        { "name": "keyword.operator.type.narra", "match": "\\?|\\||&|\\*|\\+|-|/|%|!|~|\\^" },
        { "name": "punctuation.separator.comma.narra", "match": "," }
      ]
    },
    "unterminated": {
      "patterns": [
        {
          "name": "invalid.illegal.unterminated-string.narra",
          "match": "\"(?:[^\"\\\\]|\\\\.)*(?:\\\\)?$"
        },
        {
          "name": "invalid.illegal.unterminated-char.narra",
          "match": "'(?:[^'\\\\]|\\\\.)*(?:\\\\)?$"
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.narra",
      "begin": "\"",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.narra" } },
      "end": "\"",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.narra" } },
      "patterns": [{ "include": "#escape" }]
    },
    "char": {
      "name": "string.quoted.single.narra",
      "begin": "'",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.narra" } },
      "end": "'",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.narra" } },
      "patterns": [{ "include": "#escape" }]
    },
    "escape": {
      "patterns": [
        {
          "name": "constant.character.escape.narra",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]+\\}|[ntr0\\\\\"'`$])"
        },
        {
          "name": "invalid.illegal.escape.narra",
          "match": "\\\\."
        }
      ]
    },
    "escape-raw": {
      "name": "constant.character.escape.narra",
      "match": "\\\\."
    },
    "template": {
      "name": "string.template.narra",
      "begin": "`",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.template.begin.narra" } },
      "end": "`",
      "endCaptures": { "0": { "name": "punctuation.definition.string.template.end.narra" } },
      "patterns": [{ "include": "#escape" }, { "include": "#template-substitution" }]
    },
    "tagged-template": {
      "begin": "([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(`)",
      "beginCaptures": {
        "1": { "name": "entity.name.function.tagged-template.narra" },
        "2": { "name": "punctuation.definition.string.template.begin.narra" }
      },
      "end": "`",
      "endCaptures": { "0": { "name": "punctuation.definition.string.template.end.narra" } },
      "contentName": "string.template.narra",
      "patterns": [{ "include": "#escape-raw" }, { "include": "#template-substitution" }]
    },
    "template-substitution": {
      "name": "meta.template.expression.narra",
      "begin": "\\$\\{",
      "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.narra" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.narra" } },
      "contentName": "meta.embedded.line.narra",
      "patterns": [{ "include": "#braces" }, { "include": "#expression" }]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [{ "include": "#braces" }, { "include": "#expression" }]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.hex.narra",
          "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.binary.narra",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.narra",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.narra",
          "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?(?:[eE][+-]?[0-9]+)?\\b"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "constant.language.boolean.narra",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "support.type.primitive.narra",
          "match": "\\b(?:int|bool|char|string|void|never|f32|f64|i8|i16|i32|i64|u8|u16|u32|u64|usize|isize)\\b"
        },
        {
          "name": "constant.language.none.narra",
          "match": "\\bNone\\b"
        },
        {
          "name": "keyword.control.flow.narra",
          "match": "\\b(?:if|else|while|for|of|return|break|continue|match|yield|await)\\b"
        },
        {
          "name": "keyword.control.import.narra",
          "match": "\\b(?:import|export|from|as)\\b"
        },
        {
          "name": "storage.modifier.async.narra",
          "match": "\\basync\\b"
        },
        {
          "name": "storage.modifier.narra",
          "match": "\\b(?:mutable|opaque|distinct|unsafe|extern)\\b"
        },
        {
          "name": "storage.type.narra",
          "match": "\\b(?:const|let|test|struct|enum|trait|implement|type|function)\\b"
        },
        {
          "name": "keyword.other.narra",
          "match": "\\b(?:implements|derives|is|in|requires|ensures|typeof)\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^<>()]*>\\s*)?\\()",
      "captures": { "1": { "name": "entity.name.function.narra" } }
    },
    "type-name": {
      "name": "entity.name.type.narra",
      "match": "\\b[A-Z][a-z0-9][A-Za-z0-9_]*\\b|\\b[A-Z]\\b"
    },
    "constant-name": {
      "name": "variable.other.constant.narra",
      "match": "\\b[A-Z][A-Z0-9_]+\\b"
    },
    "operator": {
      "patterns": [
        { "name": "keyword.operator.arrow.narra", "match": "=>" },
        { "name": "keyword.operator.spread.narra", "match": "\\.\\.\\." },
        { "name": "keyword.operator.range.narra", "match": "\\.\\." },
        { "name": "keyword.operator.comparison.narra", "match": "===|!==|==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.narra", "match": "&&|\\|\\||!" },
        {
          "name": "keyword.operator.assignment.compound.narra",
          "match": "(?:\\+|-|\\*|/|%|&|\\||\\^|<<|>>)="
        },
        { "name": "keyword.operator.assignment.narra", "match": "=" },
        { "name": "keyword.operator.increment.narra", "match": "\\+\\+|--" },
        { "name": "keyword.operator.arithmetic.narra", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.bitwise.narra", "match": "<<|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.optional.narra", "match": "\\?" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.accessor.narra", "match": "\\." },
        { "name": "punctuation.separator.comma.narra", "match": "," },
        { "name": "punctuation.terminator.statement.narra", "match": ";" },
        { "name": "punctuation.definition.tuple.narra", "match": "#(?=\\[)" },
        { "name": "punctuation.brackets.narra", "match": "[\\[\\]{}()]" }
      ]
    },
    "identifier": {
      "name": "variable.other.readwrite.narra",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
