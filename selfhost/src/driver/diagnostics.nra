// Diagnostic codes, as in Go's diagnostic_codes.go: the table of codes with
// their message formats, the long texts of `narrac explain`, and the JSON line
// of `narrac check --json` (contracts/diagnostic.md). The code of a diagnostic is
// passed at the place that reports it; the formats here only name and explain
// the codes, so the text of a message never decides its code.
//
// Ranges:
//   E0001-E0099  lexer and parser
//   E0100-E0199  declarations and types
//   E0200-E0299  expressions and statements
//   E0300-E0399  calls and constructors
//   E0400-E0499  modules, packages and narra.toml
//   E0500-E0599  traits
//   E0600-E0699  closures and function values
//   E0700-E0799  patterns and match
//   E0800-E0899  effects
//   E0900-E0999  standard library, including maps
//   E1000-E1099  C interop and unsafe code
//   E1100-E1199  concurrency: async, the event loop and async I/O
//     E1112-E1129  async generators and for await
//   E1190-E1199  threads: Sendable, scopes, thread functions, handle equality
//   E1200-E1209  tagged templates
//   E1210-E1219  parameter defaults
//   E1220-E1239  refinement types on distinct types
//   E1240-E1249  effect lists inside types (uses-list-syntax)
//   E1250-E1269  SIMD vector types (std/simd)
//   E1270-E1279  Ranges.stepped (range-step); the regions codes once here were retired
//   E1300-E1399  std modules for tools: iterator, arena, unicode, args, toml, regex, terminal
//   E1400-E1419  channels (E1400-E1409), Shared and Atomic (E1410-E1419)
//   E1500-E1509  unreachable statements (dead-code-check)
//   E1510-E1519  a `let` that is never reassigned (let-never-reassigned)
//   E1660-E1665  C sources of a package (package-c-sources), C packages (c-packages)
//
// Add a code by appending the next free number in the range, at the end of
// that range's rows. Never renumber or reuse a code. Rows and explanations
// are in increasing order of code, which the codes suite checks; a code with
// several formats has several rows, side by side.
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import { Pos } from "narrac/syntax/ast"
import { Fix } from "narrac/driver/fixes"
import { quoteGo } from "narrac/syntax/parser"
import { quoteJson } from "narrac/tools/queryjson"

export struct CodeRow {
  code: string
  format: string
}

export struct Explanation {
  code: string
  text: string
}

