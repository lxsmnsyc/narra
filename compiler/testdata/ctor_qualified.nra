// D71: constructors are always qualified. Two enums share constructor
// names, a user None sits next to the prelude one, and a struct shares a
// name with a constructor.
import * as Int from "std/int"

enum Level {
  Low(depth: int)
  High
}

enum Tone {
  Low
  Bright(name: string)
}

enum Maybe {
  None
  Just(value: int)
}

struct Circle {
  r: int
}

enum Shape {
  Circle(c: Circle)
  Dot
}

function level(l: Level): string {
  return match (l) {
    Level.Low(d) => `low ${Int.toString(d)}`
    Level.High => "high"
  }
}

function tone(t: Tone): string {
  return match (t) {
    Tone.Low => "tone low"
    Tone.Bright(n) => `bright ${n}`
  }
}

function maybe(m: Maybe): string {
  return match (m) {
    Maybe.None => "maybe none"
    Maybe.Just(v) => `just ${Int.toString(v)}`
  }
}

function pick(flag: bool): Option<int> {
  if (flag) {
    return Some(1)
  }
  return None
}

function radius(s: Shape): int {
  return match (s) {
    Shape.Circle(c) => c.r
    Shape.Dot => 0
  }
}

export function run(args: Array<string>): int {
  print(level(Level.Low(3)))
  print(level(Level.High))
  print(tone(Tone.Low))
  print(tone(Tone.Bright("red")))
  print(maybe(Maybe.None))
  print(maybe(Maybe.Just(4)))
  if (pick(false) is None) {
    print("prelude none")
  }
  if (pick(true) is Some(v)) {
    print(`prelude some ${Int.toString(v)}`)
  }
  const s = Shape.Circle(Circle { r: 5 })
  print(`radius ${Int.toString(radius(s))}`)
  if (s is Shape.Circle(c)) {
    print(`is circle ${Int.toString(c.r)}`)
  }
  return 0
}
