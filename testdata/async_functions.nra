// Async functions that await each other, a handle awaited twice and a handle
// awaited after it finished (no suspension).
import * as Int from "std/int"

async function double(value: int): int {
  return value * 2
}

async function describe(name: string, value: int): string {
  const doubled = await double(value)
  return `${name}=${Int.toString(doubled)}`
}

async function sum(values: Array<int>): int {
  let total = 0
  for (const value of values) {
    total += await double(value)
  }
  return total
}

async function shout() uses io {
  print("shout")
}

export async function run(_args: Array<string>): int {
  print(await describe("a", 3))
  // The task has finished when the call returns, so the awaits read its value at once.
  const twice = describe("b", 4)
  print(await twice)
  print(await twice)
  print(Int.toString(await sum([1, 2, 3])))
  await shout()
  return 0
}
