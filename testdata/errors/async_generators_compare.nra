// error: cannot use == on AsyncGenerator<int>: a stream is shared by identity; read the values and compare them
async function* numbers(): AsyncGenerator<int> {
  yield 1
}

export function main() {
  const first = numbers()
  const second = first
  if (first == second) {
    print("same")
  }
  let byStream: Map<AsyncGenerator<int>, int> = Map {}
  byStream[first] = 1
}
