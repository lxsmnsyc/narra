// compiler. Do not edit: NARRA_UPDATE=1 go test -run TestSelfhostRuntimeText rewrites it.

export const RUNTIME_H = "// Runtime for programs compiled by narra. Included at the top of every\n// generated C file.\n#include <inttypes.h>\n#include <math.h>\n#include <stdbool.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <unistd.h>\n\n// Test builds only (std/test): in a child process that runs a Test.panics\n// closure, a panic writes its message to this pipe and exits 101 at once.\nstatic int narra_panic_fd = -1;\n// Set by the test runner's child: the pipe then gets \"<where>\\n<message>\".\nstatic int narra_panic_pos = 0;\n// Where Test.golden reads and writes files; narra test sets it with --golden-dir.\nstatic const char* narra_golden_dir = \"testdata\";\n\nstatic void narra_panic(const char* where, const char* msg) {\n  fflush(stdout);\n  if (narra_panic_fd >= 0) {\n    if (narra_panic_pos) {\n      if (write(narra_panic_fd, where, strlen(where)) < 0 || write(narra_panic_fd, \"\\n\", 1) < 0) _exit(101);\n    }\n    size_t n = strlen(msg);\n    while (n > 0) {\n      ssize_t w = write(narra_panic_fd, msg, n);\n      if (w <= 0) break;\n      msg += w;\n      n -= (size_t)w;\n    }\n    _exit(101);\n  }\n  fprintf(stderr, \"panic at %s: %s\\n\", where, msg);\n  exit(101);\n}\n\n// Live allocation count. With NARRA_CHECK_LEAKS set, the program reports\n// allocations still live at exit, which shows reference counting bugs.\nstatic int64_t narra_live = 0;\n\nstatic void narra_report_leaks(void) {\n  if (getenv(\"NARRA_CHECK_LEAKS\") && narra_live != 0) {\n    fprintf(stderr, \"leak check: %\" PRId64 \" allocations still live\\n\", narra_live);\n    _exit(102);\n  }\n}\n\nstatic void* narra_alloc(size_t n) {\n  void* p = malloc(n ? n : 1);\n  if (!p) narra_panic(\"runtime\", \"out of memory\");\n  narra_live++;\n  return p;\n}\n\nstatic void narra_free(void* p) {\n  narra_live--;\n  free(p);\n}\n\n// Dropping a heap value queues the values it holds instead of recursing, so\n// a long list or a deep tree is freed with a worklist, not the C stack. The\n// worklist grows and is reused by later drops; it is never freed. It is not\n// counted by narra_live (plain realloc), and it stays reachable through a\n// global, so neither the leak check nor LeakSanitizer reports it.\ntypedef struct narra_pending { void* p; void (*drop)(void*); } narra_pending;\nstatic _Thread_local narra_pending* narra_pend = NULL;\nstatic _Thread_local size_t narra_pend_n = 0, narra_pend_cap = 0;\nstatic _Thread_local bool narra_draining = false;\n\nstatic void narra_drop(void* p, void (*drop)(void*)) {\n  if (narra_draining) {\n    if (narra_pend_n == narra_pend_cap) {\n      narra_pend_cap = narra_pend_cap ? narra_pend_cap * 2 : 64;\n      narra_pending* grown = realloc(narra_pend, narra_pend_cap * sizeof(narra_pending));\n      if (!grown) narra_panic(\"runtime\", \"out of memory\");\n      narra_pend = grown;\n    }\n    narra_pend[narra_pend_n].p = p;\n    narra_pend[narra_pend_n].drop = drop;\n    narra_pend_n++;\n    return;\n  }\n  narra_draining = true;\n  drop(p);\n  while (narra_pend_n > 0) {\n    narra_pending d = narra_pend[--narra_pend_n];\n    d.drop(d.p);\n  }\n  narra_draining = false;\n}\n\nstatic void* narra_realloc(void* p, size_t n) {\n  void* q = realloc(p, n ? n : 1);\n  if (!q) narra_panic(\"runtime\", \"out of memory\");\n  return q;\n}\n\n// Strings. A negative count marks a literal that is never freed.\ntypedef struct lstr {\n  int64_t rc;\n  int64_t len;\n  char* data;\n} lstr;\n\nstatic lstr* lstr_new(int64_t len) {\n  lstr* s = narra_alloc(sizeof(lstr));\n  s->rc = 1;\n  s->len = len;\n  s->data = narra_alloc((size_t)len + 1);\n  s->data[len] = 0;\n  return s;\n}\n\nstatic void lstr_retain(lstr* s) {\n  if (s->rc >= 0) s->rc++;\n}\n\nstatic void lstr_release(lstr* s) {\n  if (s->rc >= 0 && --s->rc == 0) {\n    narra_free(s->data);\n    narra_free(s);\n  }\n}\n\nstatic lstr* lstr_from_cstr(const char* c) {\n  int64_t n = (int64_t)strlen(c);\n  lstr* s = lstr_new(n);\n  memcpy(s->data, c, (size_t)n);\n  return s;\n}\n\nstatic lstr* lstr_concat(lstr* a, lstr* b) {\n  lstr* s = lstr_new(a->len + b->len);\n  memcpy(s->data, a->data, (size_t)a->len);\n  memcpy(s->data + a->len, b->data, (size_t)b->len);\n  return s;\n}\n\nstatic lstr* lstr_repeat(lstr* a, int64_t n, const char* where) {\n  if (n < 0) narra_panic(where, \"Str.repeat with a negative count\");\n  lstr* s = lstr_new(a->len * n);\n  for (int64_t i = 0; i < n; i++) memcpy(s->data + i * a->len, a->data, (size_t)a->len);\n  return s;\n}\n\nstatic lstr* lstr_from_int(int64_t v) {\n  char buf[32];\n  snprintf(buf, sizeof buf, \"%\" PRId64, v);\n  return lstr_from_cstr(buf);\n}\n\n// Shortest text that reads back as the same double.\nstatic lstr* lstr_from_f64(double v) {\n  char buf[40];\n  for (int prec = 1; prec <= 17; prec++) {\n    snprintf(buf, sizeof buf, \"%.*g\", prec, v);\n    if (strtod(buf, NULL) == v) break;\n  }\n  if (!strchr(buf, '.') && !strchr(buf, 'e') && !strchr(buf, 'n') && !strchr(buf, 'i')) {\n    strcat(buf, \".0\");\n  }\n  return lstr_from_cstr(buf);\n}\n\nstatic lstr* lstr_from_char(uint32_t c) {\n  char buf[5] = {0};\n  int64_t n;\n  if (c < 0x80) {\n    buf[0] = (char)c;\n    n = 1;\n  } else if (c < 0x800) {\n    buf[0] = (char)(0xC0 | (c >> 6));\n    buf[1] = (char)(0x80 | (c & 0x3F));\n    n = 2;\n  } else if (c < 0x10000) {\n    buf[0] = (char)(0xE0 | (c >> 12));\n    buf[1] = (char)(0x80 | ((c >> 6) & 0x3F));\n    buf[2] = (char)(0x80 | (c & 0x3F));\n    n = 3;\n  } else {\n    buf[0] = (char)(0xF0 | (c >> 18));\n    buf[1] = (char)(0x80 | ((c >> 12) & 0x3F));\n    buf[2] = (char)(0x80 | ((c >> 6) & 0x3F));\n    buf[3] = (char)(0x80 | (c & 0x3F));\n    n = 4;\n  }\n  // Use the encoded length: a NUL character has no strlen.\n  lstr* r = lstr_new(n);\n  memcpy(r->data, buf, (size_t)n);\n  return r;\n}\n\nstatic bool lstr_eq(lstr* a, lstr* b) {\n  return a->len == b->len && memcmp(a->data, b->data, (size_t)a->len) == 0;\n}\n\nstatic int lstr_cmp(lstr* a, lstr* b) {\n  int64_t n = a->len < b->len ? a->len : b->len;\n  int c = memcmp(a->data, b->data, (size_t)n);\n  if (c != 0) return c;\n  return a->len < b->len ? -1 : (a->len > b->len ? 1 : 0);\n}\n\n// Standard trait functions for primitive types (trait-model contract).\nstatic bool narra_eq_int(int64_t a, int64_t b) { return a == b; }\nstatic bool narra_eq_f64(double a, double b) { return a == b; }\nstatic bool narra_eq_bool(bool a, bool b) { return a == b; }\nstatic bool narra_eq_char(uint32_t a, uint32_t b) { return a == b; }\n\nstatic uint64_t narra_hash_mix(uint64_t h, uint64_t x) {\n  h ^= x;\n  h *= UINT64_C(1099511628211);\n  return h ^ (h >> 29);\n}\n\nstatic uint64_t narra_hash_int(int64_t v) {\n  uint64_t x = (uint64_t)v + UINT64_C(0x9E3779B97F4A7C15);\n  x = (x ^ (x >> 30)) * UINT64_C(0xBF58476D1CE4E5B9);\n  x = (x ^ (x >> 27)) * UINT64_C(0x94D049BB133111EB);\n  return x ^ (x >> 31);\n}\nstatic uint64_t narra_hash_bool(bool v) { return narra_hash_int(v ? 1 : 0); }\nstatic uint64_t narra_hash_char(uint32_t v) { return narra_hash_int((int64_t)v); }\n\nstatic uint64_t lstr_hash(lstr* s) {\n  uint64_t h = UINT64_C(14695981039346656037);\n  for (int64_t i = 0; i < s->len; i++) {\n    h ^= (unsigned char)s->data[i];\n    h *= UINT64_C(1099511628211);\n  }\n  return h;\n}\n\nstatic int narra_cmp_int(int64_t a, int64_t b) { return (a > b) - (a < b); }\nstatic int narra_cmp_f64(double a, double b) { return (a > b) - (a < b); }\nstatic int narra_cmp_bool(bool a, bool b) { return (a > b) - (a < b); }\nstatic int narra_cmp_char(uint32_t a, uint32_t b) { return (a > b) - (a < b); }\n\n// Ordering's tag for a comparison result: Less = 0, Equal = 1, Greater = 2.\nstatic int32_t narra_ordering(int c) { return c < 0 ? 0 : (c > 0 ? 2 : 1); }\n\n// Appends c to *acc, replacing *acc with the result.\nstatic void lstr_append_c(lstr** acc, const char* c) {\n  int64_t n = (int64_t)strlen(c);\n  lstr* s = lstr_new((*acc)->len + n);\n  memcpy(s->data, (*acc)->data, (size_t)(*acc)->len);\n  memcpy(s->data + (*acc)->len, c, (size_t)n);\n  lstr_release(*acc);\n  *acc = s;\n}\n\n// Appends piece to *acc and releases piece.\nstatic void lstr_append_owned(lstr** acc, lstr* piece) {\n  lstr* s = lstr_concat(*acc, piece);\n  lstr_release(*acc);\n  lstr_release(piece);\n  *acc = s;\n}\n\nstatic lstr* narra_show_bool(bool v) { return lstr_from_cstr(v ? \"true\" : \"false\"); }\n\n// The escape for byte c inside quotes q, or 0 when c stands for itself.\nstatic char narra_escape(char c, char q) {\n  switch (c) {\n  case '\\n': return 'n';\n  case '\\t': return 't';\n  case '\\r': return 'r';\n  case '\\\\': return '\\\\';\n  default: return c == q ? q : 0;\n  }\n}\n\n// Bytes in quotes q, with q, `\\`, newline, tab and carriage return escaped.\nstatic lstr* narra_quote(const char* data, int64_t len, char q) {\n  int64_t n = 2;\n  for (int64_t i = 0; i < len; i++) n += narra_escape(data[i], q) ? 2 : 1;\n  lstr* s = lstr_new(n);\n  int64_t j = 0;\n  s->data[j++] = q;\n  for (int64_t i = 0; i < len; i++) {\n    char e = narra_escape(data[i], q);\n    if (e) {\n      s->data[j++] = '\\\\';\n      s->data[j++] = e;\n    } else {\n      s->data[j++] = data[i];\n    }\n  }\n  s->data[j++] = q;\n  return s;\n}\n\nstatic lstr* narra_show_char(uint32_t c) {\n  lstr* u = lstr_from_char(c);\n  lstr* s = narra_quote(u->data, u->len, '\\'');\n  lstr_release(u);\n  return s;\n}\n\nstatic lstr* narra_show_string(lstr* v) { return narra_quote(v->data, v->len, '\"'); }\n\nstatic void narra_print(lstr* s) {\n  fwrite(s->data, 1, (size_t)s->len, stdout);\n  fputc('\\n', stdout);\n}\n\nstatic void narra_assert(bool ok, const char* where) {\n  if (!ok) narra_panic(where, \"assertion failed\");\n}\n\nstatic void narra_panic_str(lstr* msg, const char* where) {\n  narra_panic(where, msg->data);\n}\n\n// Integer arithmetic. Overflow panics in debug builds and wraps in release\n// builds. Division by zero panics in every build.\n#ifdef NARRA_RELEASE\n#define NARRA_CHECKED 0\n#else\n#define NARRA_CHECKED 1\n#endif\n\nstatic int64_t narra_add(int64_t a, int64_t b, const char* where) {\n  int64_t r;\n  if (__builtin_add_overflow(a, b, &r) && NARRA_CHECKED) narra_panic(where, \"integer overflow\");\n  return r;\n}\n\nstatic int64_t narra_sub(int64_t a, int64_t b, const char* where) {\n  int64_t r;\n  if (__builtin_sub_overflow(a, b, &r) && NARRA_CHECKED) narra_panic(where, \"integer overflow\");\n  return r;\n}\n\nstatic int64_t narra_mul(int64_t a, int64_t b, const char* where) {\n  int64_t r;\n  if (__builtin_mul_overflow(a, b, &r) && NARRA_CHECKED) narra_panic(where, \"integer overflow\");\n  return r;\n}\n\nstatic int64_t narra_neg(int64_t a, const char* where) {\n  if (a == INT64_MIN) {\n    if (NARRA_CHECKED) narra_panic(where, \"integer overflow\");\n    return a;\n  }\n  return -a;\n}\n\nstatic int64_t narra_div(int64_t a, int64_t b, const char* where) {\n  if (b == 0) narra_panic(where, \"division by zero\");\n  if (a == INT64_MIN && b == -1) {\n    if (NARRA_CHECKED) narra_panic(where, \"integer overflow\");\n    return a;\n  }\n  return a / b;\n}\n\nstatic int64_t narra_rem(int64_t a, int64_t b, const char* where) {\n  if (b == 0) narra_panic(where, \"division by zero\");\n  if (b == -1) return 0;\n  return a % b;\n}\n\nstatic int64_t narra_wrap_add(int64_t a, int64_t b) { return (int64_t)((uint64_t)a + (uint64_t)b); }\nstatic int64_t narra_wrap_sub(int64_t a, int64_t b) { return (int64_t)((uint64_t)a - (uint64_t)b); }\nstatic int64_t narra_wrap_mul(int64_t a, int64_t b) { return (int64_t)((uint64_t)a * (uint64_t)b); }\n\nstatic int64_t narra_shl(int64_t a, int64_t b, const char* where) {\n  if (b < 0 || b > 63) narra_panic(where, \"shift count out of range\");\n  return (int64_t)((uint64_t)a << b);\n}\n\nstatic int64_t narra_shr(int64_t a, int64_t b, const char* where) {\n  if (b < 0 || b > 63) narra_panic(where, \"shift count out of range\");\n  return a >> b;\n}\n\nstatic int64_t narra_abs(int64_t a, const char* where) { return a < 0 ? narra_neg(a, where) : a; }\n\nstatic int64_t narra_truncate(double v, const char* where) {\n  if (!(v >= -9223372036854775808.0 && v < 9223372036854775808.0)) {\n    narra_panic(where, \"Float.truncate: value out of range\");\n  }\n  return (int64_t)v;\n}\n\nstatic void narra_bounds(int64_t i, int64_t len, const char* where) {\n  if (i < 0 || i >= len) {\n    char msg[96];\n    snprintf(msg, sizeof msg, \"index %\" PRId64 \" out of range for length %\" PRId64, i, len);\n    narra_panic(where, msg);\n  }\n}\n"

export const RUNTIME_MAP_H = "// Map<K, V> with insertion order. std_map.go fills in the @...@ names for\n// each map type a program uses.\n//\n// Entries sit in insertion order in keys, vals, hashes and alive. idx is an\n// open-addressing table of entry numbers plus one (0 is an empty slot), twice\n// as long as the entries. Removing an entry clears alive and leaves its idx\n// slot, so a probe still runs past it. Inserting after a removal appends a new\n// entry, which moves the key to the end. When the entries are full they are\n// compacted, or doubled when more than half are live.\n\nstatic @M@* @M@_alloc(int64_t cap) {\n  @M@* m = narra_alloc(sizeof(@M@));\n  m->rc = 1; m->len = 0; m->used = 0; m->cap = cap; m->mask = cap * 2 - 1;\n  m->keys = narra_alloc(sizeof(@K@) * (size_t)cap);\n  m->vals = narra_alloc(sizeof(@V@) * (size_t)cap);\n  m->hashes = narra_alloc(sizeof(uint64_t) * (size_t)cap);\n  m->alive = narra_alloc((size_t)cap);\n  m->idx = narra_alloc(sizeof(int64_t) * (size_t)(cap * 2));\n  memset(m->idx, 0, sizeof(int64_t) * (size_t)(cap * 2));\n  return m;\n}\nstatic @M@* @M@_new(int64_t n) {\n  int64_t cap = 8;\n  while (cap < n) cap *= 2;\n  return @M@_alloc(cap);\n}\nstatic void @M@_retain(@M@* m) { m->rc++; }\nstatic void @M@_release(@M@* m) {\n  if (--m->rc == 0) {\n    for (int64_t i = 0; i < m->used; i++) {\n      if (m->alive[i]) { @REL_KEY_I@ @REL_VAL_I@ }\n    }\n    narra_free(m->keys); narra_free(m->vals); narra_free(m->hashes);\n    narra_free(m->alive); narra_free(m->idx);\n    narra_free(m);\n  }\n}\nstatic uint64_t @M@_hash(@K@ k) {\n  uint64_t h = @HASH@(k) * UINT64_C(0x9E3779B97F4A7C15);\n  return h ^ (h >> 32);\n}\n// Returns the entry number of k, or -1.\nstatic int64_t @M@_lookup(@M@* m, @K@ k) {\n  uint64_t h = @M@_hash(k);\n  int64_t i = (int64_t)(h & (uint64_t)m->mask);\n  for (;;) {\n    int64_t s = m->idx[i];\n    if (s == 0) return -1;\n    if (m->alive[s - 1] && m->hashes[s - 1] == h && @EQ@(m->keys[s - 1], k)) return s - 1;\n    i = (i + 1) & m->mask;\n  }\n}\n// Returns a map the caller owns alone, copying it when it is shared.\nstatic @M@* @M@_unique(@M@* m) {\n  if (m->rc == 1) return m;\n  @M@* c = @M@_alloc(m->cap);\n  memcpy(c->keys, m->keys, sizeof(@K@) * (size_t)m->used);\n  memcpy(c->vals, m->vals, sizeof(@V@) * (size_t)m->used);\n  memcpy(c->hashes, m->hashes, sizeof(uint64_t) * (size_t)m->used);\n  memcpy(c->alive, m->alive, (size_t)m->used);\n  memcpy(c->idx, m->idx, sizeof(int64_t) * (size_t)(m->cap * 2));\n  c->len = m->len; c->used = m->used;\n  for (int64_t i = 0; i < c->used; i++) {\n    if (c->alive[i]) { @RET_KEY_C@ @RET_VAL_C@ }\n  }\n  m->rc--;\n  return c;\n}\n// Moves the live entries to the front of arrays of capacity cap.\nstatic void @M@_rebuild(@M@* m, int64_t cap) {\n  @M@* n = @M@_alloc(cap);\n  int64_t j = 0;\n  for (int64_t i = 0; i < m->used; i++) {\n    if (!m->alive[i]) continue;\n    n->keys[j] = m->keys[i]; n->vals[j] = m->vals[i];\n    n->hashes[j] = m->hashes[i]; n->alive[j] = 1;\n    int64_t s = (int64_t)(n->hashes[j] & (uint64_t)n->mask);\n    while (n->idx[s]) s = (s + 1) & n->mask;\n    n->idx[s] = j + 1;\n    j++;\n  }\n  narra_free(m->keys); narra_free(m->vals); narra_free(m->hashes);\n  narra_free(m->alive); narra_free(m->idx);\n  m->keys = n->keys; m->vals = n->vals; m->hashes = n->hashes;\n  m->alive = n->alive; m->idx = n->idx;\n  m->cap = cap; m->mask = n->mask; m->used = j;\n  narra_free(n);\n}\n// Stores v under k. Takes over k and v.\nstatic void @M@_set(@M@** p, @K@ k, @V@ v) {\n  @M@* m = *p;\n  int64_t e = @M@_lookup(m, k);\n  if (e >= 0) {\n    m = @M@_unique(m); *p = m;\n    @REL_VAL_E@\n    m->vals[e] = v;\n    @REL_KEY_ARG@\n    return;\n  }\n  m = @M@_unique(m); *p = m;\n  if (m->used == m->cap) @M@_rebuild(m, m->len * 2 > m->cap ? m->cap * 2 : m->cap);\n  uint64_t h = @M@_hash(k);\n  int64_t i = m->used++;\n  m->keys[i] = k; m->vals[i] = v; m->hashes[i] = h; m->alive[i] = 1;\n  m->len++;\n  int64_t s = (int64_t)(h & (uint64_t)m->mask);\n  while (m->idx[s]) s = (s + 1) & m->mask;\n  m->idx[s] = i + 1;\n}\n// Removes k and reports whether it was there. Borrows k.\nstatic bool @M@_remove(@M@** p, @K@ k) {\n  int64_t e = @M@_lookup(*p, k);\n  if (e < 0) return false;\n  @M@* m = @M@_unique(*p); *p = m;\n  @REL_KEY_E@\n  @REL_VAL_E@\n  m->alive[e] = 0;\n  m->len--;\n  return true;\n}\n"

export const ENV_RUNTIME = "\n// Closure environments. A count below zero marks an environment on the\n// caller's stack, which is never counted or freed.\ntypedef struct narra_env { int64_t rc; void (*drop)(struct narra_env*); } narra_env;\nstatic void narra_env_retain(narra_env* e) {\n  if (e && e->rc >= 0) e->rc++;\n}\nstatic void narra_env_release(narra_env* e) {\n  if (e && e->rc >= 0 && --e->rc == 0) {\n    e->drop(e);\n    narra_free(e);\n  }\n}\n"

export const TEST_RUNNER_C = "\n// Test runner\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <time.h>\n#include <errno.h>\n#include <signal.h>\n\ntypedef struct narra_test_case {\n  const char* name;\n  void (*fn)(void);\n} narra_test_case;\n\nstatic int64_t narra_test_now_ms(void) {\n  struct timespec ts;\n  clock_gettime(CLOCK_MONOTONIC, &ts);\n  return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;\n}\n\n// The time limit of one test: NARRA_TEST_TIMEOUT seconds, default 10.\nstatic unsigned narra_test_limit(void) {\n  const char* s = getenv(\"NARRA_TEST_TIMEOUT\");\n  if (s && *s) {\n    char* end;\n    long v = strtol(s, &end, 10);\n    if (*end == 0 && v > 0 && v < 100000) return (unsigned)v;\n  }\n  return 10;\n}\n\n// narra_test_child runs one test in the child process.\nstatic void narra_test_child(const narra_test_case* c, int wfd) {\n  narra_panic_fd = wfd;\n  narra_panic_pos = 1;\n  // Line buffering keeps the output of a test that crashes.\n  setvbuf(stdout, NULL, _IOLBF, 0);\n  alarm(narra_test_limit());\n  c->fn();\n  narra_consts_release();\n  // A test-only hook, so the leak report can be tested.\n  if (getenv(\"NARRA_TEST_FORCE_LEAK\")) narra_live++;\n  if (getenv(\"NARRA_CHECK_LEAKS\") && narra_live != 0) {\n    char buf[64];\n    snprintf(buf, sizeof buf, \"leaked %lld allocations\", (long long)narra_live);\n    narra_panic(\"leak check\", buf);\n  }\n  fflush(stdout);\n  _exit(0);\n}\n\n// narra_test_arg returns the option name of an argument (\"--time\" and\n// \"-time\" both give \"time\"), or NULL for an argument that is not an option.\nstatic const char* narra_test_opt(const char* a) {\n  if (a[0] != '-') return NULL;\n  return a[1] == '-' ? a + 2 : a + 1;\n}\n\n// narra_test_run returns the exit code of the run.\nstatic int narra_test_run(const narra_test_case* cases, int argc, char** argv) {\n  const char* filter = NULL;\n  int timing = 0;\n  for (int i = 1; i < argc; i++) {\n    const char* o = narra_test_opt(argv[i]);\n    const char* eq = o ? strchr(o, '=') : NULL;\n    size_t n = o ? (eq ? (size_t)(eq - o) : strlen(o)) : 0;\n    if (o && n == 4 && strncmp(o, \"time\", 4) == 0 && !eq) {\n      timing = 1;\n    } else if (o && ((n == 6 && strncmp(o, \"filter\", 6) == 0) || (n == 10 && strncmp(o, \"golden-dir\", 10) == 0))) {\n      const char* v = eq ? eq + 1 : (i + 1 < argc ? argv[++i] : NULL);\n      if (!v) {\n        fprintf(stderr, \"%s needs a value\\n\", argv[i]);\n        return 2;\n      }\n      if (n == 6) filter = v; else narra_golden_dir = v;\n    } else {\n      fprintf(stderr, \"unknown argument %s; options: --filter <text>, --time, --golden-dir <dir>\\n\", argv[i]);\n      return 2;\n    }\n  }\n  int passed = 0, failed = 0;\n  unsigned limit = narra_test_limit();\n  for (const narra_test_case* c = cases; c->name; c++) {\n    if (filter && !strstr(c->name, filter)) continue;\n    int fds[2];\n    fflush(stdout);\n    fflush(stderr);\n    if (pipe(fds) != 0) { fprintf(stderr, \"cannot create a pipe\\n\"); return 1; }\n    int64_t start = narra_test_now_ms();\n    pid_t pid = fork();\n    if (pid < 0) { fprintf(stderr, \"cannot fork\\n\"); return 1; }\n    if (pid == 0) {\n      close(fds[0]);\n      narra_test_child(c, fds[1]);\n    }\n    close(fds[1]);\n    size_t cap = 256, len = 0;\n    char* msg = malloc(cap);\n    for (;;) {\n      if (len + 1 == cap) { cap *= 2; msg = realloc(msg, cap); }\n      ssize_t n = read(fds[0], msg + len, cap - 1 - len);\n      if (n < 0 && errno == EINTR) continue;\n      if (n <= 0) break;\n      len += (size_t)n;\n    }\n    msg[len] = 0;\n    close(fds[0]);\n    int status = 0;\n    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}\n    int64_t ms = narra_test_now_ms() - start;\n    char tbuf[48] = \"\";\n    if (timing) snprintf(tbuf, sizeof tbuf, \" (%lld ms)\", (long long)ms);\n    if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {\n      printf(\"ok - %s%s\\n\", c->name, tbuf);\n      passed++;\n    } else if (WIFEXITED(status) && WEXITSTATUS(status) == 101) {\n      char* nl = strchr(msg, '\\n');\n      const char* where = \"\";\n      const char* text = msg;\n      if (nl) { *nl = 0; where = msg; text = nl + 1; }\n      printf(\"FAIL - %s: %s (%s)%s\\n\", c->name, text, where, tbuf);\n      failed++;\n    } else if (WIFSIGNALED(status) && WTERMSIG(status) == SIGALRM) {\n      printf(\"FAIL - %s: timed out after %u s%s\\n\", c->name, limit, tbuf);\n      failed++;\n    } else if (WIFSIGNALED(status)) {\n      printf(\"FAIL - %s: killed by signal %d (%s)%s\\n\", c->name, WTERMSIG(status), strsignal(WTERMSIG(status)), tbuf);\n      failed++;\n    } else {\n      printf(\"FAIL - %s: exited with code %d%s\\n\", c->name, WEXITSTATUS(status), tbuf);\n      failed++;\n    }\n    free(msg);\n  }\n  if (filter && passed + failed == 0) {\n    printf(\"no tests match \\\"%s\\\"\\n\", filter);\n    fflush(stdout);\n    return 1;\n  }\n  printf(\"%d passed, %d failed\\n\", passed, failed);\n  fflush(stdout);\n  return failed ? 1 : 0;\n}\n"

const RUNTIME_STD_ENV = "#ifndef NARRA_IO_COMMON\n#define NARRA_IO_COMMON\n#include <errno.h>\n\n// True when p[0..n) is valid UTF-8: no overlong forms, no surrogates and\n// nothing above U+10FFFF.\nstatic bool narra_io_utf8(const unsigned char* p, int64_t n) {\n  int64_t i = 0;\n  while (i < n) {\n    unsigned char c = p[i];\n    int64_t k;\n    uint32_t cp;\n    if (c < 0x80) { i++; continue; }\n    if (c >= 0xC2 && c <= 0xDF) { k = 1; cp = c & 0x1F; }\n    else if (c >= 0xE0 && c <= 0xEF) { k = 2; cp = c & 0x0F; }\n    else if (c >= 0xF0 && c <= 0xF4) { k = 3; cp = c & 0x07; }\n    else return false;\n    if (i + k >= n) return false;\n    for (int64_t j = 1; j <= k; j++) {\n      if ((p[i + j] & 0xC0) != 0x80) return false;\n      cp = (cp << 6) | (p[i + j] & 0x3F);\n    }\n    if (k == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return false;\n    if (k == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return false;\n    i += k + 1;\n  }\n  return true;\n}\n\n// A string from bytes; each byte that is not valid UTF-8 becomes U+FFFD.\nstatic lstr* narra_io_lossy(const char* p, size_t n) {\n  if (narra_io_utf8((const unsigned char*)p, (int64_t)n)) {\n    lstr* s = lstr_new((int64_t)n);\n    memcpy(s->data, p, n);\n    return s;\n  }\n  lstr* s = lstr_new((int64_t)n * 3);\n  int64_t o = 0;\n  size_t i = 0;\n  while (i < n) {\n    size_t k = 1;\n    unsigned char c = (unsigned char)p[i];\n    if (c >= 0xC2 && c <= 0xDF) k = 2;\n    else if (c >= 0xE0 && c <= 0xEF) k = 3;\n    else if (c >= 0xF0 && c <= 0xF4) k = 4;\n    if (c < 0x80 || (k > 1 && i + k <= n && narra_io_utf8((const unsigned char*)p + i, (int64_t)k))) {\n      memcpy(s->data + o, p + i, k);\n      o += (int64_t)k;\n      i += k;\n    } else {\n      memcpy(s->data + o, \"\\xEF\\xBF\\xBD\", 3);\n      o += 3;\n      i++;\n    }\n  }\n  s->len = o;\n  s->data[o] = 0;\n  return s;\n}\n\n// \"<what>: <message>\"\nstatic lstr* narra_io_fail(const char* what, int64_t whatlen, const char* msg) {\n  size_t ml = strlen(msg);\n  lstr* s = lstr_new(whatlen + 2 + (int64_t)ml);\n  memcpy(s->data, what, (size_t)whatlen);\n  memcpy(s->data + whatlen, \": \", 2);\n  memcpy(s->data + whatlen + 2, msg, ml);\n  return s;\n}\n\n// C strings end at the first zero byte, so a string with one inside cannot\n// name a file, a command or a variable.\nstatic bool narra_io_no_nul(lstr* s, lstr** err) {\n  if (memchr(s->data, 0, (size_t)s->len)) {\n    *err = lstr_from_cstr(\"argument contains a NUL byte\");\n    return false;\n  }\n  return true;\n}\n#endif\n\n\n#ifdef __APPLE__\n#include <crt_externs.h>\n#endif\n\n// NULL when the variable is not set.\nstatic lstr* narra_env_get(lstr* name) {\n  if (memchr(name->data, 0, (size_t)name->len)) return NULL;\n  const char* v = getenv(name->data);\n  return v ? narra_io_lossy(v, strlen(v)) : NULL;\n}\n\n#ifdef __APPLE__\nstatic int64_t narra_env_argc(void) { return *_NSGetArgc(); }\nstatic lstr* narra_env_arg(int64_t i) {\n  const char* a = (*_NSGetArgv())[i];\n  return narra_io_lossy(a, strlen(a));\n}\n#else\n// Elsewhere the arguments are read once from /proc/self/cmdline.\nstatic char* narra_env_buf;\nstatic size_t narra_env_len;\nstatic int64_t narra_env_n = -1;\n\nstatic void narra_env_load(void) {\n  if (narra_env_n >= 0) return;\n  narra_env_n = 0;\n  FILE* f = fopen(\"/proc/self/cmdline\", \"rb\");\n  if (!f) return;\n  size_t cap = 4096;\n  narra_env_buf = malloc(cap);\n  while (narra_env_buf) {\n    if (narra_env_len == cap) {\n      char* bigger = realloc(narra_env_buf, cap * 2);\n      if (!bigger) break;\n      narra_env_buf = bigger;\n      cap *= 2;\n    }\n    size_t got = fread(narra_env_buf + narra_env_len, 1, cap - narra_env_len, f);\n    if (got == 0) break;\n    narra_env_len += got;\n  }\n  fclose(f);\n  for (size_t i = 0; i < narra_env_len; i++) {\n    if (narra_env_buf[i] == 0) narra_env_n++;\n  }\n}\nstatic int64_t narra_env_argc(void) { narra_env_load(); return narra_env_n; }\nstatic lstr* narra_env_arg(int64_t i) {\n  narra_env_load();\n  const char* p = narra_env_buf;\n  while (i-- > 0) p += strlen(p) + 1;\n  return narra_io_lossy(p, strlen(p));\n}\n#endif\n"

const RUNTIME_STD_FS = "#ifndef NARRA_IO_COMMON\n#define NARRA_IO_COMMON\n#include <errno.h>\n\n// True when p[0..n) is valid UTF-8: no overlong forms, no surrogates and\n// nothing above U+10FFFF.\nstatic bool narra_io_utf8(const unsigned char* p, int64_t n) {\n  int64_t i = 0;\n  while (i < n) {\n    unsigned char c = p[i];\n    int64_t k;\n    uint32_t cp;\n    if (c < 0x80) { i++; continue; }\n    if (c >= 0xC2 && c <= 0xDF) { k = 1; cp = c & 0x1F; }\n    else if (c >= 0xE0 && c <= 0xEF) { k = 2; cp = c & 0x0F; }\n    else if (c >= 0xF0 && c <= 0xF4) { k = 3; cp = c & 0x07; }\n    else return false;\n    if (i + k >= n) return false;\n    for (int64_t j = 1; j <= k; j++) {\n      if ((p[i + j] & 0xC0) != 0x80) return false;\n      cp = (cp << 6) | (p[i + j] & 0x3F);\n    }\n    if (k == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return false;\n    if (k == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return false;\n    i += k + 1;\n  }\n  return true;\n}\n\n// A string from bytes; each byte that is not valid UTF-8 becomes U+FFFD.\nstatic lstr* narra_io_lossy(const char* p, size_t n) {\n  if (narra_io_utf8((const unsigned char*)p, (int64_t)n)) {\n    lstr* s = lstr_new((int64_t)n);\n    memcpy(s->data, p, n);\n    return s;\n  }\n  lstr* s = lstr_new((int64_t)n * 3);\n  int64_t o = 0;\n  size_t i = 0;\n  while (i < n) {\n    size_t k = 1;\n    unsigned char c = (unsigned char)p[i];\n    if (c >= 0xC2 && c <= 0xDF) k = 2;\n    else if (c >= 0xE0 && c <= 0xEF) k = 3;\n    else if (c >= 0xF0 && c <= 0xF4) k = 4;\n    if (c < 0x80 || (k > 1 && i + k <= n && narra_io_utf8((const unsigned char*)p + i, (int64_t)k))) {\n      memcpy(s->data + o, p + i, k);\n      o += (int64_t)k;\n      i += k;\n    } else {\n      memcpy(s->data + o, \"\\xEF\\xBF\\xBD\", 3);\n      o += 3;\n      i++;\n    }\n  }\n  s->len = o;\n  s->data[o] = 0;\n  return s;\n}\n\n// \"<what>: <message>\"\nstatic lstr* narra_io_fail(const char* what, int64_t whatlen, const char* msg) {\n  size_t ml = strlen(msg);\n  lstr* s = lstr_new(whatlen + 2 + (int64_t)ml);\n  memcpy(s->data, what, (size_t)whatlen);\n  memcpy(s->data + whatlen, \": \", 2);\n  memcpy(s->data + whatlen + 2, msg, ml);\n  return s;\n}\n\n// C strings end at the first zero byte, so a string with one inside cannot\n// name a file, a command or a variable.\nstatic bool narra_io_no_nul(lstr* s, lstr** err) {\n  if (memchr(s->data, 0, (size_t)s->len)) {\n    *err = lstr_from_cstr(\"argument contains a NUL byte\");\n    return false;\n  }\n  return true;\n}\n#endif\n\n\n#include <dirent.h>\n#include <sys/stat.h>\n\ntypedef struct narra_fs_names {\n  lstr** items;\n  int64_t len;\n} narra_fs_names;\n\nstatic bool narra_fs_read(lstr* path, lstr** out, lstr** err) {\n  if (!narra_io_no_nul(path, err)) return false;\n  FILE* f = fopen(path->data, \"rb\");\n  if (!f) {\n    *err = narra_io_fail(path->data, path->len, strerror(errno));\n    return false;\n  }\n  size_t cap = 4096, len = 0;\n  char* buf = malloc(cap);\n  const char* fail = buf ? NULL : \"out of memory\";\n  while (!fail) {\n    if (len == cap) {\n      char* bigger = realloc(buf, cap * 2);\n      if (!bigger) { fail = \"out of memory\"; break; }\n      buf = bigger;\n      cap *= 2;\n    }\n    size_t got = fread(buf + len, 1, cap - len, f);\n    len += got;\n    if (got == 0) {\n      if (ferror(f)) fail = strerror(errno);\n      break;\n    }\n  }\n  fclose(f);\n  if (!fail && !narra_io_utf8((const unsigned char*)buf, (int64_t)len)) fail = \"file is not valid UTF-8\";\n  if (fail) {\n    free(buf);\n    *err = narra_io_fail(path->data, path->len, fail);\n    return false;\n  }\n  *out = lstr_new((int64_t)len);\n  memcpy((*out)->data, buf, len);\n  free(buf);\n  return true;\n}\n\nstatic bool narra_fs_write(lstr* path, lstr* text, int64_t* written, lstr** err) {\n  if (!narra_io_no_nul(path, err)) return false;\n  FILE* f = fopen(path->data, \"wb\");\n  if (!f) {\n    *err = narra_io_fail(path->data, path->len, strerror(errno));\n    return false;\n  }\n  errno = 0;\n  size_t put = fwrite(text->data, 1, (size_t)text->len, f);\n  bool ok = put == (size_t)text->len;\n  if (fclose(f) != 0) ok = false;\n  if (!ok) {\n    *err = narra_io_fail(path->data, path->len, strerror(errno ? errno : EIO));\n    return false;\n  }\n  *written = text->len;\n  return true;\n}\n\nstatic bool narra_fs_exists(lstr* path) {\n  if (memchr(path->data, 0, (size_t)path->len)) return false;\n  struct stat st;\n  return stat(path->data, &st) == 0;\n}\n\nstatic int narra_fs_name_cmp(const void* a, const void* b) {\n  return lstr_cmp(*(lstr* const*)a, *(lstr* const*)b);\n}\n\n// The names in a directory, sorted by bytes, without \".\" and \"..\".\nstatic bool narra_fs_list(lstr* path, narra_fs_names* out, lstr** err) {\n  out->items = NULL;\n  out->len = 0;\n  if (!narra_io_no_nul(path, err)) return false;\n  DIR* d = opendir(path->data);\n  if (!d) {\n    *err = narra_io_fail(path->data, path->len, strerror(errno));\n    return false;\n  }\n  int64_t cap = 0;\n  const char* fail = NULL;\n  struct dirent* ent;\n  while (!fail && (ent = readdir(d)) != NULL) {\n    if (strcmp(ent->d_name, \".\") == 0 || strcmp(ent->d_name, \"..\") == 0) continue;\n    size_t n = strlen(ent->d_name);\n    if (!narra_io_utf8((const unsigned char*)ent->d_name, (int64_t)n)) { fail = \"file name is not valid UTF-8\"; break; }\n    if (out->len == cap) {\n      cap = cap ? cap * 2 : 16;\n      lstr** bigger = realloc(out->items, sizeof(lstr*) * (size_t)cap);\n      if (!bigger) { fail = \"out of memory\"; break; }\n      out->items = bigger;\n    }\n    out->items[out->len++] = lstr_from_cstr(ent->d_name);\n  }\n  closedir(d);\n  if (fail) {\n    for (int64_t i = 0; i < out->len; i++) lstr_release(out->items[i]);\n    free(out->items);\n    out->items = NULL;\n    out->len = 0;\n    *err = narra_io_fail(path->data, path->len, fail);\n    return false;\n  }\n  if (out->len > 1) qsort(out->items, (size_t)out->len, sizeof(lstr*), narra_fs_name_cmp);\n  return true;\n}\n\n"

const RUNTIME_STD_INT = "\n// Parses s in the given base into *out. On failure sets *err and returns false.\nstatic bool narra_int_parse(lstr* s, int64_t base, int64_t* out, lstr** err) {\n  if (base < 2 || base > 36) { *err = lstr_from_cstr(\"base must be between 2 and 36\"); return false; }\n  int64_t i = 0;\n  bool neg = false;\n  if (s->len > 0 && s->data[0] == '-') { neg = true; i = 1; }\n  if (i >= s->len) { *err = lstr_from_cstr(s->len == 0 ? \"empty string\" : \"no digits after '-'\"); return false; }\n  uint64_t limit = neg ? (uint64_t)INT64_MAX + 1 : (uint64_t)INT64_MAX;\n  uint64_t acc = 0;\n  for (; i < s->len; i++) {\n    char ch = s->data[i];\n    int64_t d;\n    if (ch >= '0' && ch <= '9') d = ch - '0';\n    else if (ch >= 'a' && ch <= 'z') d = ch - 'a' + 10;\n    else if (ch >= 'A' && ch <= 'Z') d = ch - 'A' + 10;\n    else d = 99;\n    if (d >= base) { *err = lstr_from_cstr(\"invalid digit for the base\"); return false; }\n    if (acc > (limit - (uint64_t)d) / (uint64_t)base) { *err = lstr_from_cstr(\"number does not fit in 64 bits\"); return false; }\n    acc = acc * (uint64_t)base + (uint64_t)d;\n  }\n  *out = neg ? (int64_t)(0 - acc) : (int64_t)acc;\n  return true;\n}\n\nstatic lstr* narra_int_to_hex(int64_t n) {\n  char buf[24];\n  uint64_t m = n < 0 ? 0 - (uint64_t)n : (uint64_t)n;\n  int pos = (int)sizeof buf;\n  buf[--pos] = 0;\n  do { buf[--pos] = \"0123456789abcdef\"[m & 15]; m >>= 4; } while (m != 0);\n  if (n < 0) buf[--pos] = '-';\n  return lstr_from_cstr(buf + pos);\n}\n"

const RUNTIME_STD_PROCESS = "#ifndef NARRA_IO_COMMON\n#define NARRA_IO_COMMON\n#include <errno.h>\n\n// True when p[0..n) is valid UTF-8: no overlong forms, no surrogates and\n// nothing above U+10FFFF.\nstatic bool narra_io_utf8(const unsigned char* p, int64_t n) {\n  int64_t i = 0;\n  while (i < n) {\n    unsigned char c = p[i];\n    int64_t k;\n    uint32_t cp;\n    if (c < 0x80) { i++; continue; }\n    if (c >= 0xC2 && c <= 0xDF) { k = 1; cp = c & 0x1F; }\n    else if (c >= 0xE0 && c <= 0xEF) { k = 2; cp = c & 0x0F; }\n    else if (c >= 0xF0 && c <= 0xF4) { k = 3; cp = c & 0x07; }\n    else return false;\n    if (i + k >= n) return false;\n    for (int64_t j = 1; j <= k; j++) {\n      if ((p[i + j] & 0xC0) != 0x80) return false;\n      cp = (cp << 6) | (p[i + j] & 0x3F);\n    }\n    if (k == 2 && (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF))) return false;\n    if (k == 3 && (cp < 0x10000 || cp > 0x10FFFF)) return false;\n    i += k + 1;\n  }\n  return true;\n}\n\n// A string from bytes; each byte that is not valid UTF-8 becomes U+FFFD.\nstatic lstr* narra_io_lossy(const char* p, size_t n) {\n  if (narra_io_utf8((const unsigned char*)p, (int64_t)n)) {\n    lstr* s = lstr_new((int64_t)n);\n    memcpy(s->data, p, n);\n    return s;\n  }\n  lstr* s = lstr_new((int64_t)n * 3);\n  int64_t o = 0;\n  size_t i = 0;\n  while (i < n) {\n    size_t k = 1;\n    unsigned char c = (unsigned char)p[i];\n    if (c >= 0xC2 && c <= 0xDF) k = 2;\n    else if (c >= 0xE0 && c <= 0xEF) k = 3;\n    else if (c >= 0xF0 && c <= 0xF4) k = 4;\n    if (c < 0x80 || (k > 1 && i + k <= n && narra_io_utf8((const unsigned char*)p + i, (int64_t)k))) {\n      memcpy(s->data + o, p + i, k);\n      o += (int64_t)k;\n      i += k;\n    } else {\n      memcpy(s->data + o, \"\\xEF\\xBF\\xBD\", 3);\n      o += 3;\n      i++;\n    }\n  }\n  s->len = o;\n  s->data[o] = 0;\n  return s;\n}\n\n// \"<what>: <message>\"\nstatic lstr* narra_io_fail(const char* what, int64_t whatlen, const char* msg) {\n  size_t ml = strlen(msg);\n  lstr* s = lstr_new(whatlen + 2 + (int64_t)ml);\n  memcpy(s->data, what, (size_t)whatlen);\n  memcpy(s->data + whatlen, \": \", 2);\n  memcpy(s->data + whatlen + 2, msg, ml);\n  return s;\n}\n\n// C strings end at the first zero byte, so a string with one inside cannot\n// name a file, a command or a variable.\nstatic bool narra_io_no_nul(lstr* s, lstr** err) {\n  if (memchr(s->data, 0, (size_t)s->len)) {\n    *err = lstr_from_cstr(\"argument contains a NUL byte\");\n    return false;\n  }\n  return true;\n}\n#endif\n\n\n#include <fcntl.h>\n#include <poll.h>\n#include <signal.h>\n#include <sys/wait.h>\n\ntypedef struct narra_proc_buf {\n  char* p;\n  size_t len, cap;\n} narra_proc_buf;\n\n// Reads one chunk from fd. False at end of input or on a hard error.\nstatic bool narra_proc_take(narra_proc_buf* b, int fd) {\n  char chunk[4096];\n  ssize_t n = read(fd, chunk, sizeof chunk);\n  if (n < 0) return errno == EINTR || errno == EAGAIN;\n  if (n == 0) return false;\n  if (b->len + (size_t)n > b->cap) {\n    size_t cap = b->cap ? b->cap * 2 : 4096;\n    while (cap < b->len + (size_t)n) cap *= 2;\n    char* bigger = realloc(b->p, cap);\n    if (!bigger) return false;\n    b->p = bigger;\n    b->cap = cap;\n  }\n  memcpy(b->p + b->len, chunk, (size_t)n);\n  b->len += (size_t)n;\n  return true;\n}\n\nstatic void narra_proc_close(int* fds) {\n  if (fds[0] >= 0) close(fds[0]);\n  if (fds[1] >= 0) close(fds[1]);\n}\n\nstatic int narra_proc_pipe(int* fds) {\n  fds[0] = fds[1] = -1;\n  if (pipe(fds) != 0) return -1;\n  fcntl(fds[0], F_SETFD, FD_CLOEXEC);\n  fcntl(fds[1], F_SETFD, FD_CLOEXEC);\n  return 0;\n}\n\n// Runs cmd (found through PATH) with argv[0..argc) as its arguments and its\n// standard input closed. Returns false with *err set when the process cannot\n// start. The exit code of a process killed by a signal is 128 plus the signal.\nstatic bool narra_proc_run(lstr* cmd, lstr** argv, int64_t argc, int64_t* code, lstr** out, lstr** errout, lstr** err) {\n  if (!narra_io_no_nul(cmd, err)) return false;\n  for (int64_t i = 0; i < argc; i++) {\n    if (!narra_io_no_nul(argv[i], err)) return false;\n  }\n  char** vec = malloc(sizeof(char*) * (size_t)(argc + 2));\n  if (!vec) { *err = narra_io_fail(cmd->data, cmd->len, \"out of memory\"); return false; }\n  vec[0] = cmd->data;\n  for (int64_t i = 0; i < argc; i++) vec[i + 1] = argv[i]->data;\n  vec[argc + 1] = NULL;\n  int po[2], pe[2], px[2];\n  po[0] = po[1] = pe[0] = pe[1] = px[0] = px[1] = -1;\n  if (narra_proc_pipe(po) != 0 || narra_proc_pipe(pe) != 0 || narra_proc_pipe(px) != 0) {\n    *err = narra_io_fail(cmd->data, cmd->len, strerror(errno));\n    narra_proc_close(po); narra_proc_close(pe); narra_proc_close(px);\n    free(vec);\n    return false;\n  }\n  fflush(NULL);\n  pid_t pid = fork();\n  if (pid < 0) {\n    *err = narra_io_fail(cmd->data, cmd->len, strerror(errno));\n    narra_proc_close(po); narra_proc_close(pe); narra_proc_close(px);\n    free(vec);\n    return false;\n  }\n  if (pid == 0) {\n    int e;\n    int in = open(\"/dev/null\", O_RDONLY);\n    if (in < 0) goto child_fail;\n    if (in != 0) {\n      if (dup2(in, 0) < 0) goto child_fail;\n      close(in);\n    }\n    if (dup2(po[1], 1) < 0 || dup2(pe[1], 2) < 0) goto child_fail;\n    execvp(vec[0], vec);\n  child_fail:\n    e = errno;\n    ssize_t w = write(px[1], &e, sizeof e);\n    (void)w;\n    _exit(127);\n  }\n  free(vec);\n  close(po[1]); close(pe[1]); close(px[1]);\n  // The close-on-exec pipe is empty when the program started, and holds\n  // the child's errno when it did not.\n  int child_errno = 0;\n  ssize_t got;\n  do { got = read(px[0], &child_errno, sizeof child_errno); } while (got < 0 && errno == EINTR);\n  close(px[0]);\n  int status = 0;\n  if (got == (ssize_t)sizeof child_errno) {\n    close(po[0]); close(pe[0]);\n    while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}\n    *err = narra_io_fail(cmd->data, cmd->len, strerror(child_errno));\n    return false;\n  }\n  narra_proc_buf bo = {0}, be = {0};\n  struct pollfd fds[2] = {{po[0], POLLIN, 0}, {pe[0], POLLIN, 0}};\n  int open_fds = 2;\n  while (open_fds > 0) {\n    if (poll(fds, 2, -1) < 0) {\n      if (errno == EINTR) continue;\n      break;\n    }\n    for (int i = 0; i < 2; i++) {\n      if (fds[i].fd < 0 || !(fds[i].revents & (POLLIN | POLLHUP | POLLERR))) continue;\n      if (!narra_proc_take(i == 0 ? &bo : &be, fds[i].fd)) {\n        close(fds[i].fd);\n        fds[i].fd = -1;\n        open_fds--;\n      }\n    }\n  }\n  if (fds[0].fd >= 0) close(fds[0].fd);\n  if (fds[1].fd >= 0) close(fds[1].fd);\n  while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}\n  *code = WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);\n  *out = narra_io_lossy(bo.p ? bo.p : \"\", bo.len);\n  *errout = narra_io_lossy(be.p ? be.p : \"\", be.len);\n  free(bo.p);\n  free(be.p);\n  return true;\n}\n\n"

const RUNTIME_STD_STRING = "// C helpers of std/string. Emitted once when a program imports the module.\n// Positions are byte offsets. A string holds valid UTF-8, so a byte is the\n// start of a character unless it is a continuation byte (10xxxxxx).\n\nstatic bool narra_str_boundary(lstr* s, int64_t i) {\n  return i == 0 || i == s->len || (((unsigned char)s->data[i]) & 0xC0) != 0x80;\n}\n\n// Checks that i is a position inside s (0..len) on a character boundary.\nstatic void narra_str_check_pos(lstr* s, int64_t i, const char* what, const char* where) {\n  if (i < 0 || i > s->len) {\n    char buf[160];\n    snprintf(buf, sizeof buf, \"%s: position %\" PRId64 \" out of range for length %\" PRId64, what, i, s->len);\n    narra_panic(where, buf);\n  }\n  if (!narra_str_boundary(s, i)) {\n    char buf[160];\n    snprintf(buf, sizeof buf, \"%s: position %\" PRId64 \" is inside a character\", what, i);\n    narra_panic(where, buf);\n  }\n}\n\n// Checks that i is the start of a character (not the end of the string).\nstatic void narra_str_check_char(lstr* s, int64_t i, const char* what, const char* where) {\n  narra_str_check_pos(s, i, what, where);\n  if (i == s->len) {\n    char buf[160];\n    snprintf(buf, sizeof buf, \"%s: position %\" PRId64 \" is at the end of the string\", what, i);\n    narra_panic(where, buf);\n  }\n}\n\nstatic lstr* narra_str_copy(const char* p, int64_t n) {\n  lstr* r = lstr_new(n);\n  memcpy(r->data, p, (size_t)n);\n  return r;\n}\n\nstatic lstr* narra_str_slice(lstr* s, int64_t from, int64_t to, const char* where) {\n  narra_str_check_pos(s, from, \"Str.slice\", where);\n  narra_str_check_pos(s, to, \"Str.slice\", where);\n  if (from > to) {\n    char buf[160];\n    snprintf(buf, sizeof buf, \"Str.slice: start %\" PRId64 \" is after end %\" PRId64, from, to);\n    narra_panic(where, buf);\n  }\n  return narra_str_copy(s->data + from, to - from);\n}\n\nstatic lstr* narra_str_slice_from(lstr* s, int64_t from, const char* where) {\n  narra_str_check_pos(s, from, \"Str.sliceFrom\", where);\n  return narra_str_copy(s->data + from, s->len - from);\n}\n\nstatic int64_t narra_str_byte_at(lstr* s, int64_t i, const char* where) {\n  if (i < 0 || i >= s->len) {\n    char buf[160];\n    snprintf(buf, sizeof buf, \"Str.byteAt: position %\" PRId64 \" out of range for length %\" PRId64, i, s->len);\n    narra_panic(where, buf);\n  }\n  return (unsigned char)s->data[i];\n}\n\n// Length in bytes of the character starting at i (i is a character start).\nstatic int64_t narra_str_char_len(lstr* s, int64_t i) {\n  unsigned char b = (unsigned char)s->data[i];\n  int64_t n = b < 0x80 ? 1 : b < 0xE0 ? 2 : b < 0xF0 ? 3 : 4;\n  return i + n > s->len ? s->len - i : n;\n}\n\nstatic uint32_t narra_str_decode(lstr* s, int64_t i) {\n  unsigned char b = (unsigned char)s->data[i];\n  int64_t n = narra_str_char_len(s, i);\n  if (n == 1) return b;\n  uint32_t c = b & (n == 2 ? 0x1F : n == 3 ? 0x0F : 0x07);\n  for (int64_t k = 1; k < n; k++) c = (c << 6) | ((unsigned char)s->data[i + k] & 0x3F);\n  return c;\n}\n\nstatic uint32_t narra_str_char_at(lstr* s, int64_t i, const char* where) {\n  narra_str_check_char(s, i, \"Str.charAt\", where);\n  return narra_str_decode(s, i);\n}\n\n// The position after the character that starts at i.\nstatic int64_t narra_str_next_char(lstr* s, int64_t i, const char* where) {\n  narra_str_check_char(s, i, \"Str.nextChar\", where);\n  return i + narra_str_char_len(s, i);\n}\n\n// The first position of needle in s, or -1.\nstatic int64_t narra_str_index_of(lstr* s, lstr* needle) {\n  if (needle->len == 0) return 0;\n  for (int64_t i = 0; i + needle->len <= s->len; i++) {\n    if (s->data[i] == needle->data[0] && memcmp(s->data + i, needle->data, (size_t)needle->len) == 0) return i;\n  }\n  return -1;\n}\n\nstatic bool narra_str_starts_with(lstr* s, lstr* prefix) {\n  return prefix->len <= s->len && memcmp(s->data, prefix->data, (size_t)prefix->len) == 0;\n}\n\nstatic bool narra_str_space(char c) {\n  return c == ' ' || c == '\\t' || c == '\\n' || c == '\\r' || c == '\\v' || c == '\\f';\n}\n\nstatic lstr* narra_str_trim(lstr* s) {\n  int64_t a = 0, b = s->len;\n  while (a < b && narra_str_space(s->data[a])) a++;\n  while (b > a && narra_str_space(s->data[b - 1])) b--;\n  return narra_str_copy(s->data + a, b - a);\n}\n\nstatic int64_t narra_str_char_count(lstr* s) {\n  int64_t n = 0;\n  for (int64_t i = 0; i < s->len; i += narra_str_char_len(s, i)) n++;\n  return n;\n}\n\n// Splits s at every occurrence of sep. Returns *n owned strings in an array\n// that the caller frees with narra_free.\nstatic lstr** narra_str_split(lstr* s, lstr* sep, int64_t* n, const char* where) {\n  if (sep->len == 0) narra_panic(where, \"Str.split with an empty separator\");\n  int64_t count = 1;\n  for (int64_t i = 0; i + sep->len <= s->len;) {\n    if (memcmp(s->data + i, sep->data, (size_t)sep->len) == 0) { count++; i += sep->len; } else i++;\n  }\n  lstr** out = narra_alloc(sizeof(lstr*) * (size_t)count);\n  int64_t k = 0, start = 0;\n  for (int64_t i = 0; i + sep->len <= s->len;) {\n    if (memcmp(s->data + i, sep->data, (size_t)sep->len) == 0) {\n      out[k++] = narra_str_copy(s->data + start, i - start);\n      i += sep->len;\n      start = i;\n    } else i++;\n  }\n  out[k++] = narra_str_copy(s->data + start, s->len - start);\n  *n = k;\n  return out;\n}\n\n// StringBuilder: a growable buffer, shared by reference counting. Appending\n// to a builder that other values share copies it first, so builders behave\n// like values.\ntypedef struct narra_sb {\n  int64_t rc;\n  int64_t len;\n  int64_t cap;\n  char* data;\n} narra_sb;\n\nstatic narra_sb* narra_sb_new(void) {\n  narra_sb* b = narra_alloc(sizeof(narra_sb));\n  b->rc = 1;\n  b->len = 0;\n  b->cap = 16;\n  b->data = narra_alloc((size_t)b->cap);\n  return b;\n}\n\nstatic void narra_sb_retain(narra_sb* b) { b->rc++; }\n\nstatic void narra_sb_release(narra_sb* b) {\n  if (--b->rc == 0) {\n    narra_free(b->data);\n    narra_free(b);\n  }\n}\n\nstatic void narra_sb_push(narra_sb** p, const char* data, int64_t n) {\n  narra_sb* b = *p;\n  if (b->rc > 1) {\n    narra_sb* c = narra_alloc(sizeof(narra_sb));\n    c->rc = 1;\n    c->len = b->len;\n    c->cap = b->cap;\n    c->data = narra_alloc((size_t)c->cap);\n    memcpy(c->data, b->data, (size_t)b->len);\n    b->rc--;\n    *p = b = c;\n  }\n  if (b->len + n > b->cap) {\n    int64_t cap = b->cap;\n    while (b->len + n > cap) cap *= 2;\n    char* d = narra_alloc((size_t)cap);\n    memcpy(d, b->data, (size_t)b->len);\n    narra_free(b->data);\n    b->data = d;\n    b->cap = cap;\n  }\n  memcpy(b->data + b->len, data, (size_t)n);\n  b->len += n;\n}\n\nstatic void narra_sb_append(narra_sb** p, lstr* s) { narra_sb_push(p, s->data, s->len); }\n\nstatic void narra_sb_append_char(narra_sb** p, uint32_t c) {\n  lstr* s = lstr_from_char(c);\n  narra_sb_push(p, s->data, s->len);\n  lstr_release(s);\n}\n\nstatic lstr* narra_sb_build(narra_sb* b) { return narra_str_copy(b->data, b->len); }\n\nstatic bool narra_str_ends_with(lstr* s, lstr* suffix) {\n  return suffix->len <= s->len && memcmp(s->data + s->len - suffix->len, suffix->data, (size_t)suffix->len) == 0;\n}\n\nstatic bool narra_str_contains(lstr* s, lstr* part) { return narra_str_index_of(s, part) >= 0; }\n\n// Replaces every non-overlapping match of from, left to right. An empty from\n// returns a copy of s.\nstatic lstr* narra_str_replace(lstr* s, lstr* from, lstr* to) {\n  if (from->len == 0) return narra_str_copy(s->data, s->len);\n  int64_t count = 0;\n  for (int64_t i = 0; i + from->len <= s->len;) {\n    if (memcmp(s->data + i, from->data, (size_t)from->len) == 0) { count++; i += from->len; } else i++;\n  }\n  lstr* r = lstr_new(s->len + count * (to->len - from->len));\n  int64_t o = 0;\n  for (int64_t i = 0; i < s->len;) {\n    if (i + from->len <= s->len && memcmp(s->data + i, from->data, (size_t)from->len) == 0) {\n      memcpy(r->data + o, to->data, (size_t)to->len);\n      o += to->len;\n      i += from->len;\n    } else {\n      r->data[o++] = s->data[i++];\n    }\n  }\n  return r;\n}\n\nstatic lstr* narra_str_join(lstr** parts, int64_t n, lstr* sep) {\n  int64_t total = 0;\n  for (int64_t i = 0; i < n; i++) total += parts[i]->len + (i > 0 ? sep->len : 0);\n  lstr* r = lstr_new(total);\n  int64_t o = 0;\n  for (int64_t i = 0; i < n; i++) {\n    if (i > 0) { memcpy(r->data + o, sep->data, (size_t)sep->len); o += sep->len; }\n    memcpy(r->data + o, parts[i]->data, (size_t)parts[i]->len);\n    o += parts[i]->len;\n  }\n  return r;\n}\n"

const RUNTIME_STD_TEST = "// std/test runtime. Emitted only when a module imports std/test.\n//\n// Test.panics runs the closure in a child process (POSIX fork). The child\n// sets narra_panic_fd, so a panic writes its message to a pipe and exits\n// 101. The parent reads the pipe until it closes, waits for the child and\n// checks how it ended. The child's heap is a copy, so nothing it allocates\n// counts in the parent's leak check.\n//\n// The child gets a timeout (alarm), 10 seconds or NARRA_TEST_TIMEOUT, so a\n// closure that never returns fails instead of hanging the run. This also\n// bounds a nested child that would keep the pipe open.\n//\n// The failure paths free what they built, except the final message, which\n// narra_panic prints before the process ends.\n#include <errno.h>\n#include <signal.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n\ntypedef struct narra_test_proc {\n  pid_t pid;\n  int fd;\n  unsigned timeout;\n} narra_test_proc;\n\nstatic unsigned narra_test_timeout(void) {\n  unsigned limit = 10;\n  const char* s = getenv(\"NARRA_TEST_TIMEOUT\");\n  if (s && *s) {\n    char* end;\n    long v = strtol(s, &end, 10);\n    if (*end == 0 && v > 0 && v < 100000) limit = (unsigned)v;\n  }\n  // Inside a test that has a time limit (an alarm is pending), the closure\n  // gets what is left minus one second, at least one, so its own timeout\n  // message comes before the test's.\n  unsigned left = alarm(0);\n  if (left) {\n    alarm(left);\n    unsigned budget = left > 2 ? left - 1 : 1;\n    if (budget < limit) limit = budget;\n  }\n  return limit;\n}\n\n// narra_test_fork returns true in the child, which must call the closure\n// and then narra_test_returned. It returns false in the parent.\nstatic bool narra_test_fork(narra_test_proc* t, const char* where) {\n  int fds[2];\n  fflush(stdout);\n  fflush(stderr);\n  t->timeout = narra_test_timeout();\n  if (pipe(fds) != 0) narra_panic(where, \"Test.panics: cannot create a pipe\");\n  pid_t pid = fork();\n  if (pid < 0) narra_panic(where, \"Test.panics: cannot fork\");\n  if (pid == 0) {\n    close(fds[0]);\n    narra_panic_fd = fds[1];\n    narra_panic_pos = 0;\n    alarm(t->timeout);\n    return true;\n  }\n  close(fds[1]);\n  t->pid = pid;\n  t->fd = fds[0];\n  return false;\n}\n\n// narra_test_returned ends the child when the closure returned.\nstatic void narra_test_returned(void) {\n  fflush(stdout);\n  _exit(0);\n}\n\n// narra_test_expect waits for the child and panics unless it panicked with\n// a message that contains want (any message when want is NULL). An empty\n// want matches any message, and the match stops at a NUL byte in either.\nstatic void narra_test_expect(narra_test_proc* t, lstr* want, const char* where) {\n  size_t cap = 256, len = 0;\n  char* msg = malloc(cap);\n  if (!msg) narra_panic(\"runtime\", \"out of memory\");\n  for (;;) {\n    if (len + 1 == cap) {\n      cap *= 2;\n      char* grown = realloc(msg, cap);\n      if (!grown) narra_panic(\"runtime\", \"out of memory\");\n      msg = grown;\n    }\n    ssize_t n = read(t->fd, msg + len, cap - 1 - len);\n    if (n < 0 && errno == EINTR) continue;\n    if (n <= 0) break;\n    len += (size_t)n;\n  }\n  msg[len] = 0;\n  close(t->fd);\n  int status = 0;\n  while (waitpid(t->pid, &status, 0) < 0) {\n    if (errno != EINTR) narra_panic(where, \"Test.panics: cannot wait for the child process\");\n  }\n  char buf[160];\n  const char* fail = NULL;\n  if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {\n    fail = \"expected a panic, but the function returned\";\n  } else if (!WIFEXITED(status) || WEXITSTATUS(status) != 101) {\n    if (WIFSIGNALED(status) && WTERMSIG(status) == SIGALRM) {\n      snprintf(buf, sizeof buf, \"expected a panic, but the function ran past the %u s timeout\", t->timeout);\n    } else if (WIFSIGNALED(status)) {\n      snprintf(buf, sizeof buf, \"expected a panic, but the function was killed by signal %d\", WTERMSIG(status));\n    } else {\n      snprintf(buf, sizeof buf, \"expected a panic, but the function exited with code %d\", WEXITSTATUS(status));\n    }\n    fail = buf;\n  }\n  if (fail) {\n    free(msg);\n    narra_panic(where, fail);\n  }\n  if (want && !strstr(msg, want->data)) {\n    lstr* w = narra_show_string(want);\n    lstr* g = narra_quote(msg, (int64_t)len, '\"');\n    size_t n = (size_t)w->len + (size_t)g->len + 64;\n    char* out = malloc(n);\n    if (!out) narra_panic(\"runtime\", \"out of memory\");\n    snprintf(out, n, \"expected a panic containing %s, got %s\", w->data, g->data);\n    lstr_release(w);\n    lstr_release(g);\n    free(msg);\n    narra_panic(where, out);\n  }\n  free(msg);\n}\n\n// The failure of Test.eq. The shown values are owned and released here.\nstatic void narra_test_fail_eq(lstr* expected, lstr* actual, const char* where) {\n  size_t n = (size_t)expected->len + (size_t)actual->len + 32;\n  char* out = malloc(n);\n  if (!out) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(out, n, \"expected %s, got %s\", expected->data, actual->data);\n  lstr_release(expected);\n  lstr_release(actual);\n  narra_panic(where, out);\n}\n\nstatic void narra_test_fail_ne(lstr* value, const char* where) {\n  size_t n = (size_t)value->len + 48;\n  char* out = malloc(n);\n  if (!out) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(out, n, \"expected a value other than %s\", value->data);\n  lstr_release(value);\n  narra_panic(where, out);\n}\n\n// Test.golden: compare actual with <dir>/<name>.golden. With\n// NARRA_UPDATE_GOLDEN=1 the file is written instead.\n#include <sys/stat.h>\n\nstatic void narra_test_golden(lstr* name, lstr* actual, const char* where) {\n  const char* dir = narra_golden_dir;\n  const char* up = getenv(\"NARRA_UPDATE_GOLDEN\");\n  int update = up && strcmp(up, \"1\") == 0;\n  if (name->len == 0) narra_panic(where, \"Test.golden: the name is empty\");\n  int bad = memchr(name->data, 0, (size_t)name->len) != NULL || name->data[0] == '/';\n  // No path segment may be \"..\".\n  for (const char* s = name->data; !bad && *s;) {\n    const char* e = strchr(s, '/');\n    size_t k = e ? (size_t)(e - s) : strlen(s);\n    if (k == 2 && s[0] == '.' && s[1] == '.') bad = 1;\n    s += k + (e ? 1 : 0);\n    if (!e) break;\n  }\n  if (bad) narra_panic(where, \"Test.golden: the name must be a relative path without a `..` segment\");\n  size_t cap = strlen(dir) + (size_t)name->len + 160;\n  char* path = malloc(cap);\n  if (!path) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(path, cap, \"%s/%s.golden\", dir, name->data);\n  if (update) {\n    // Create the directories on the way.\n    mkdir(dir, 0777);\n    for (char* p = path + strlen(dir) + 1; *p; p++) {\n      if (*p == '/') {\n        *p = 0;\n        mkdir(path, 0777);\n        *p = '/';\n      }\n    }\n    FILE* f = fopen(path, \"wb\");\n    if (!f || fwrite(actual->data, 1, (size_t)actual->len, f) != (size_t)actual->len) {\n      char* out = malloc(cap + 48);\n      if (!out) narra_panic(\"runtime\", \"out of memory\");\n      snprintf(out, cap + 48, \"Test.golden: cannot write %s.golden\", name->data);\n      if (f) fclose(f);\n      free(path);\n      narra_panic(where, out);\n    }\n    fclose(f);\n    free(path);\n    return;\n  }\n  FILE* f = fopen(path, \"rb\");\n  if (!f) {\n    // The message names the golden file, not the directory, so test output\n    // does not depend on where the package is.\n    char* out = malloc(cap + 96);\n    if (!out) narra_panic(\"runtime\", \"out of memory\");\n    snprintf(out, cap + 96, \"golden file %s.golden does not exist; run with NARRA_UPDATE_GOLDEN=1 to create it\", name->data);\n    free(path);\n    narra_panic(where, out);\n  }\n  size_t wcap = 4096, wlen = 0;\n  char* want = malloc(wcap);\n  if (!want) narra_panic(\"runtime\", \"out of memory\");\n  for (;;) {\n    if (wlen == wcap) {\n      wcap *= 2;\n      want = realloc(want, wcap);\n      if (!want) narra_panic(\"runtime\", \"out of memory\");\n    }\n    size_t n = fread(want + wlen, 1, wcap - wlen, f);\n    if (n == 0) break;\n    wlen += n;\n  }\n  fclose(f);\n  const char* got = actual->data;\n  size_t glen = (size_t)actual->len;\n  size_t i = 0;\n  while (i < wlen && i < glen && want[i] == got[i]) i++;\n  if (i == wlen && i == glen) {\n    free(want);\n    free(path);\n    return;\n  }\n  // The first differing line: both lines start after the last newline before i.\n  size_t start = i;\n  int64_t line = 1;\n  for (size_t k = 0; k < i; k++) if (want[k] == '\\n') line++;\n  while (start > 0 && want[start - 1] != '\\n') start--;\n  size_t we = start, ge = start;\n  while (we < wlen && want[we] != '\\n') we++;\n  while (ge < glen && got[ge] != '\\n') ge++;\n  lstr* w = narra_quote(want + start, (int64_t)(we - start), '\"');\n  lstr* g = narra_quote(got + start, (int64_t)(ge - start), '\"');\n  size_t n = (size_t)w->len + (size_t)g->len + (size_t)name->len + 96;\n  char* out = malloc(n);\n  if (!out) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(out, n, \"golden %s differs at line %lld: expected %s, got %s\", name->data, (long long)line, w->data, g->data);\n  lstr_release(w);\n  lstr_release(g);\n  free(want);\n  free(path);\n  narra_panic(where, out);\n}\n"

// runtimeFor is the C runtime of a std module, or "" when it has none.
export function runtimeFor(path: string): string {
  if (path == "std/env") {
    return RUNTIME_STD_ENV
  }
  if (path == "std/fs") {
    return RUNTIME_STD_FS
  }
  if (path == "std/int") {
    return RUNTIME_STD_INT
  }
  if (path == "std/process") {
    return RUNTIME_STD_PROCESS
  }
  if (path == "std/string") {
    return RUNTIME_STD_STRING
  }
  if (path == "std/test") {
    return RUNTIME_STD_TEST
  }
  return ""
}
