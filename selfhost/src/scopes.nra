// Module scopes across modules, ported from compiler/internal/narra:
// the import loop of declareModule and useModule (check.go),
// importPackageModule, exported, entryFunc and checkEntry
// (modules_check.go), importTrait (check_traits.go), importConst and the
// imported-constant check of declareConsts (check_const.go), declareType
// (check_types.go), and checkImportNames and aliasTaken (import_names.go).
//
// Package modules are declared in load order, imports first, so every
// module an import names already has its scope and its table entries. An
// imported name points at the declaring module's entry: a type is the same
// Type value, a function, constant, generic or trait the same table index.
import { Pos, Decl, File, ImportDecl } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Package, entryModule } from "narrac/modules"
import { Type } from "narrac/types"
import { moduleList } from "narrac/builtins"
import { Checker, EntryInfo, errorf, enter, lookupType, lookupGeneric, lookupTrait, unsupported } from "narrac/check"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// declName is the name a top-level declaration declares, or "" (tests and
// implement blocks).
export function declName(decl: Decl): string {
  return match (decl) {
    Decl.Func(funcDecl) => funcDecl.name
    Decl.Const(declared) => declared.name
    Decl.Struct(declared) => declared.name
    Decl.Enum(declared) => declared.name
    Decl.Distinct(declared) => declared.name
    Decl.Trait(declared) => declared.name
    _ => ""
  }
}

function isExported(decl: Decl): bool {
  return match (decl) {
    Decl.Func(funcDecl) => funcDecl.exported
    Decl.Const(declared) => declared.exported
    Decl.Struct(declared) => declared.exported
    Decl.Enum(declared) => declared.exported
    Decl.Distinct(declared) => declared.exported
    Decl.Trait(declared) => declared.exported
    _ => false
  }
}

// collectExports maps each exported name to its declaration's index. A later
// declaration of the same name wins, as in Go's Exports map.
export function collectExports(decls: Array<Decl>): Map<string, int> uses alloc {
  let out: Map<string, int> = Map {}
  for (const index of Ranges.between(0, Arrays.length(decls))) {
    if (isExported(decls[index])) {
      out[declName(decls[index])] = index
    }
  }
  return out
}

// checkTypeName reports a type name already taken in the current scope.
export function checkTypeName(mutable checker: Checker, pos: Pos, name: string) uses alloc {
  if (lookupType(checker, name) is Some(_)) {
    errorf(mutable checker, pos, `type ${quoteGo(name)} is declared twice`)
  }
  if (lookupGeneric(checker, name) is Some(_)) {
    errorf(mutable checker, pos, `type ${quoteGo(name)} is declared twice`)
  }
}

export function declareType(mutable checker: Checker, pos: Pos, name: string, type: Type) uses alloc {
  checkTypeName(mutable checker, pos, name)
  const scope = checker.cur
  checker.scopes[scope].types[name] = type
}

// importModules runs the imports of a file in the current module: a package
// module, or else a std module of the registry.
export function importModules(mutable checker: Checker, file: File) uses alloc {
  let aliases: Map<string, bool> = Map {}
  for (const importDecl of Arrays.values(file.imports)) {
    if (importPackageModule(mutable checker, importDecl, mutable aliases)) {
      continue
    }
    if (checker.registry.modules[importDecl.path] is Some(stdModule)) {
      useModule(mutable checker, importDecl.path)
      const scope = checker.cur
      if (importDecl.path == "std/string") {
        // The type is visible only where its runtime C is emitted.
        checker.scopes[scope].types["StringBuilder"] = Type.TStringBuilder
      }
      bindAlias(mutable checker, importDecl, mutable aliases)
      for (const name of Arrays.values(importDecl.names)) {
        if (stdModule.funcs[name.name] is Some(index)) {
          if (checker.scopes[scope].imported[name.local] is Some(previous)) {
            if (previous != index) {
              errorf(mutable checker, importDecl.pos, `imported name ${quoteGo(name.local)} is already imported from another module; rename one with \`as\``)
              continue
            }
          }
          checker.scopes[scope].imported[name.local] = index
        } else {
          errorf(mutable checker, importDecl.pos, `module ${quoteGo(importDecl.path)} has no export ${quoteGo(name.name)}`)
        }
      }
    } else {
      const list = moduleList(checker.registry)
      errorf(mutable checker, importDecl.pos, `unknown module ${quoteGo(importDecl.path)} (this compiler supports ${list})`)
    }
  }
}

// useModule records a std module the program uses, once, in first-import
// order (Go's Program.Modules; the emitter writes their runtime C).
function useModule(mutable checker: Checker, path: string) uses alloc {
  for (const used of Arrays.values(checker.used)) {
    if (used == path) {
      return
    }
  }
  Arrays.push(mutable checker.used, path)
}

// sourceScope finds the scope of a package module by path, or -1.
export function sourceScope(checker: Checker, path: string): int {
  if (checker.scopeIndex[path] is Some(scope)) {
    if (checker.scopes[scope].isSource) {
      return scope
    }
  }
  return -1
}

// bindAlias makes the alias of a namespace import visible. aliases holds the
// aliases the current file has bound. Another file of the module may bind an
// alias again for the same path, never for another one.
function bindAlias(mutable checker: Checker, importDecl: ImportDecl, mutable aliases: Map<string, bool>) uses alloc {
  if (importDecl.alias == "") {
    return
  }
  const current = checker.cur
  if (checker.scopes[current].modules[importDecl.alias] is Some(previous)) {
    if (previous != importDecl.path || aliases[importDecl.alias] is Some(_)) {
      errorf(mutable checker, importDecl.pos, `two imports use the alias ${importDecl.alias}; give one of them another alias`)
    }
  }
  aliases[importDecl.alias] = true
  checker.scopes[current].modules[importDecl.alias] = importDecl.path
}

// importPackageModule handles an import of a module of this package. It
// returns false when the path is not one, so the caller tries std modules.
function importPackageModule(mutable checker: Checker, importDecl: ImportDecl, mutable aliases: Map<string, bool>): bool uses alloc {
  const scope = sourceScope(checker, importDecl.path)
  if (scope < 0) {
    const prefix = `${checker.pkgName}/`
    if (!checker.single && Str.startsWith(importDecl.path, prefix)) {
      const rest = Str.sliceFrom(importDecl.path, Str.length(prefix))
      const message = `unknown module ${quoteGo(importDecl.path)}; package ${checker.pkgName} has no file src/${rest}.nra`
      errorf(mutable checker, importDecl.pos, message)
      return true
    }
    return false
  }
  const current = checker.cur
  bindAlias(mutable checker, importDecl, mutable aliases)
  for (const name of Arrays.values(importDecl.names)) {
    if (checker.checkingBodies && isConstructorImport(checker, scope, name.name)) {
      // Go reports E0425 at the name, whose position the Narra AST lacks.
      unsupported(mutable checker, importDecl.pos, "an import of a constructor (selfhost-check-calls)")
      continue
    }
    const found = exported(mutable checker, importDecl.pos, scope, name.name)
    match (found) {
      Some(decl) => importDeclaration(mutable checker, importDecl.pos, scope, name.name, name.local, decl)
      None => {}
    }
  }
  return true
}

// importDeclaration makes an exported declaration of a scope visible in the
// current module.
function importDeclaration(mutable checker: Checker, pos: Pos, scope: int, name: string, local: string, decl: Decl) uses alloc {
  const current = checker.cur
  match (decl) {
    Decl.Func(_) => {
      if (checker.scopes[current].funcs[local] is Some(_)) {
        errorf(mutable checker, pos, `function ${quoteGo(local)} is declared twice`)
      }
      if (checker.scopes[scope].funcs[name] is Some(index)) {
        checker.scopes[current].funcs[local] = index
      }
    }
    Decl.Const(_) => {
      if (checker.scopes[scope].consts[name] is Some(index)) {
        importConst(mutable checker, pos, local, index)
      }
    }
    Decl.Trait(_) => {
      if (checker.scopes[scope].traits[name] is Some(traitIndex)) {
        if (checker.traits[traitIndex].module == checker.scopes[scope].path) {
          importTrait(mutable checker, pos, local, traitIndex)
        }
      }
    }
    Decl.Distinct(_) => importType(mutable checker, pos, scope, name, local)
    Decl.Struct(_) => importNamedType(mutable checker, pos, scope, name, local)
    Decl.Enum(_) => importNamedType(mutable checker, pos, scope, name, local)
    _ => {}
  }
}

function importType(mutable checker: Checker, pos: Pos, scope: int, name: string, local: string) uses alloc {
  if (checker.scopes[scope].types[name] is Some(type)) {
    declareType(mutable checker, pos, local, type)
  } else {
    checkTypeName(mutable checker, pos, local)
  }
}

// importNamedType imports a struct or enum: a generic template by its
// Checker.generics index, or a type.
function importNamedType(mutable checker: Checker, pos: Pos, scope: int, name: string, local: string) uses alloc {
  if (checker.scopes[scope].generics[name] is Some(generic)) {
    if (checker.scopes[scope].types[name] is None) {
      if (lookupType(checker, local) is Some(_) || lookupGeneric(checker, local) is Some(_)) {
        errorf(mutable checker, pos, `type ${quoteGo(local)} is declared twice`)
      }
      const current = checker.cur
      checker.scopes[current].generics[local] = generic
      return
    }
  }
  importType(mutable checker, pos, scope, name, local)
}

// exported returns the declaration a scope exports under a name, or reports why it
// cannot be used and returns None.
export function exported(mutable checker: Checker, pos: Pos, scope: int, name: string): Option<Decl> uses alloc {
  if (checker.scopes[scope].exports[name] is Some(index)) {
    return Some(checker.scopes[scope].decls[index])
  }
  const path = checker.scopes[scope].path
  for (const decl of Arrays.values(checker.scopes[scope].decls)) {
    if (declName(decl) == name) {
      errorf(mutable checker, pos, `${quoteGo(name)} is not exported by module ${quoteGo(path)}; add \`export\` to its declaration`)
      return None
    }
  }
  errorf(mutable checker, pos, `module ${quoteGo(path)} has no export ${quoteGo(name)}`)
  return None
}

// importTrait makes the exported trait visible by name.
function importTrait(mutable checker: Checker, pos: Pos, name: string, traitIndex: int) uses alloc {
  if (lookupTrait(checker, name) >= 0 || lookupType(checker, name) is Some(_) || lookupGeneric(checker, name) is Some(_)) {
    errorf(mutable checker, pos, `${quoteGo(name)} is declared twice`)
    return
  }
  const current = checker.cur
  checker.scopes[current].traits[name] = traitIndex
}

// importConst makes the exported constant visible by name.
function importConst(mutable checker: Checker, pos: Pos, name: string, index: int) uses alloc {
  const current = checker.cur
  if (checker.scopes[current].consts[name] is Some(_) || typeNamed(checker, name)) {
    errorf(mutable checker, pos, `constant ${quoteGo(name)} is declared twice`)
    return
  }
  checker.scopes[current].consts[name] = index
}

// typeNamed reports whether name is a type or trait of the current module.
export function typeNamed(checker: Checker, name: string): bool {
  return lookupType(checker, name) is Some(_) || lookupGeneric(checker, name) is Some(_) || lookupTrait(checker, name) >= 0
}

// checkImportedConsts reports an imported constant whose name the module
// later gave to a type: the import ran before the module's types existed.
export function checkImportedConsts(mutable checker: Checker, file: File) uses alloc {
  const current = checker.cur
  const path = checker.scopes[current].path
  for (const importDecl of Arrays.values(file.imports)) {
    for (const name of Arrays.values(importDecl.names)) {
      if (checker.scopes[current].consts[name.local] is Some(index)) {
        if (checker.consts[index].module != path && typeNamed(checker, name.local)) {
          errorf(mutable checker, importDecl.pos, `constant ${quoteGo(name.local)} is declared twice`)
        }
      }
    }
  }
}

// checkEntries finds the entry function of each binary and reports one
// with the wrong signature (Go's entryFunc and checkEntry in CheckPackage).
export function checkEntries(mutable checker: Checker, pkg: Package) uses alloc {
  for (const binary of Arrays.values(pkg.binaries)) {
    const index = entryFunc(checker, pkg, binary.entry)
    if (index >= 0) {
      const scope = checker.funcs[index].scope
      const saved = enter(mutable checker, scope)
      checkEntry(mutable checker, index)
      enter(mutable checker, saved)
    }
    const info = EntryInfo { binary: binary.name, func: index }
    Arrays.push(mutable checker.entries, info)
  }
}

// entryFunc finds the exported function an entry names, or -1.
function entryFunc(checker: Checker, pkg: Package, entry: string): int uses alloc {
  const target = entryModule(pkg, entry)
  const #[modulePath, functionName] = target
  const scope = sourceScope(checker, modulePath)
  if (scope < 0) {
    return -1
  }
  if (checker.scopes[scope].exports[functionName] is Some(index)) {
    if (checker.scopes[scope].decls[index] is Decl.Func(funcDecl)) {
      if (checker.scopes[scope].funcs[functionName] is Some(funcIndex)) {
        if (checker.funcs[funcIndex].decl.pos == funcDecl.pos && checker.funcs[funcIndex].scope == scope) {
          return funcIndex
        }
      }
    }
  }
  return -1
}

function checkEntry(mutable checker: Checker, index: int) uses alloc {
  const funcDecl = checker.funcs[index].decl
  let valid = Arrays.length(funcDecl.params) == 1 && checker.funcs[index].result == Type.TInt
  if (valid) {
    const param = funcDecl.params[0]
    valid = checker.paramTypes[param.id] == Type.TArray(Type.TStr) && !param.isMutable
  }
  if (!valid) {
    errorf(mutable checker, funcDecl.pos, `the entry function must be \`export function ${funcDecl.name}(args: Array<string>): int\``)
  }
}

// isConstructorImport reports `import { Teacher }` where Teacher is not an
// export of the module but a constructor of an exported enum (Go's
// ctorImport).
function isConstructorImport(checker: Checker, moduleScope: int, name: string): bool {
  if (checker.scopes[moduleScope].exports[name] is Some(_)) {
    return false
  }
  for (const decl of Arrays.values(checker.scopes[moduleScope].decls)) {
    if (decl is Decl.Enum(enumDecl)) {
      if (enumDecl.exported) {
        for (const variant of Arrays.values(enumDecl.variants)) {
          if (variant.name == name) {
            return true
          }
        }
      }
    }
  }
  return false
}

// The std modules whose functions are called as Name.f, by the prelude
// type name, with the plural alias the convention gives them (Go's
// namespaceModules and pluralAlias).
struct Namespace {
  name: string
  path: string
  plural: string
}

const NAMESPACES = [
  Namespace { name: "Array", path: "std/array", plural: "Arrays" },
  Namespace { name: "Box", path: "std/box", plural: "Boxes" },
  Namespace { name: "Map", path: "std/map", plural: "Maps" },
  Namespace { name: "Option", path: "std/option", plural: "Options" },
  Namespace { name: "Range", path: "std/range", plural: "Ranges" },
  Namespace { name: "Result", path: "std/result", plural: "Results" },
]

// isNamespaceName reports a prelude type whose functions live in a std
// module (Array, Box, Map, Option, Range, Result).
export function isNamespaceName(name: string): bool {
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == name) {
      return true
    }
  }
  return false
}

// aliasTaken reports whether name is a type, a trait or a prelude
// namespace type visible in the module.
function aliasTaken(checker: Checker, name: string): bool {
  return typeNamed(checker, name) || isNamespaceName(name)
}

// suggestAlias is the alias the alias-equals-type error suggests: the
// plural of a namespace type, or of the std module the import names, or the
// alias with an s.
function suggestAlias(alias: string, path: string): string uses alloc {
  let suggestion = ""
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == alias) {
      suggestion = namespace.plural
    }
  }
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.path == path) {
      suggestion = namespace.plural
    }
  }
  if (suggestion == "") {
    return `${alias}s`
  }
  return suggestion
}

// checkImportNames runs after the module's type names are declared. It
// reports an alias that equals a type name (E0421) and an imported name
// that clashes with a declaration, an alias or a type (E0423). Go's fixes
// are not ported.
export function checkImportNames(mutable checker: Checker, file: File) uses alloc {
  // An alias may not be a type name.
  for (const importDecl of Arrays.values(file.imports)) {
    if (importDecl.alias == "" || !aliasTaken(checker, importDecl.alias)) {
      continue
    }
    const suggestion = suggestAlias(importDecl.alias, importDecl.path)
    errorf(mutable checker, importDecl.pos, `the import alias ${importDecl.alias} is also a type name; rename it, for example \`import * as ${suggestion} from ${quoteGo(importDecl.path)}\``)
  }

  // An imported name may not clash with the module's functions, constants,
  // aliases or types.
  let declared: Map<string, bool> = Map {}
  for (const decl of Arrays.values(file.decls)) {
    if (decl is Decl.Func(funcDecl)) {
      declared[funcDecl.name] = true
    }
  }
  const scope = checker.cur
  for (const importDecl of Arrays.values(file.imports)) {
    const moduleScope = sourceScope(checker, importDecl.path)
    for (const name of Arrays.values(importDecl.names)) {
      const isAlias = checker.scopes[scope].modules[name.local] is Some(_)
      if (moduleScope >= 0) {
        // A type or trait import is itself in the type table, and the
        // import reports a function or constant that clashes with a
        // declaration. A function can still clash with a type declared
        // later or with an alias.
        if (!isExportedFunc(checker, moduleScope, name.name)) {
          continue
        }
        if (isAlias || aliasTaken(checker, name.local)) {
          errorf(mutable checker, importDecl.pos, `imported name ${quoteGo(name.local)} is already declared in this module; rename the import with \`as\``)
        }
        continue
      }
      const isConst = checker.scopes[scope].consts[name.local] is Some(_)
      if (declared[name.local] is Some(_) || isConst || isAlias || aliasTaken(checker, name.local)) {
        errorf(mutable checker, importDecl.pos, `imported name ${quoteGo(name.local)} is already declared in this module; rename the import with \`as\``)
      }
    }
  }
}

function isExportedFunc(checker: Checker, moduleScope: int, name: string): bool {
  if (checker.scopes[moduleScope].exports[name] is Some(index)) {
    return checker.scopes[moduleScope].decls[index] is Decl.Func(_)
  }
  return false
}
