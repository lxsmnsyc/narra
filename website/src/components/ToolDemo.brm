<script>
  import { $signal } from 'brumate/signals';
  import { prevent } from 'brumate/events';

  // What each command prints, copied from runs of narrac.
  const TOOLS = [
    {
      id: 'check',
      label: 'check --json',
      command: 'narrac check --json hello.nra',
      lines: [
        '{"code":"E0003","severity":"error",',
        ' "message":"semicolons are not used; end the statement with a line break",',
        ' "file":"hello.nra","range":{"start":[2,17],"end":[2,17]},',
        ' "fixes":[{"title":"remove the semicolon",',
        '   "edits":[{"file":"hello.nra","range":{"start":[2,17],"end":[2,18]},"text":""}]}]}',
      ],
      note: 'Every error as JSON, with the edits that fix it when the compiler knows one.',
    },
    {
      id: 'apply-fix',
      label: 'apply-fix',
      command: 'narrac apply-fix hello.nra',
      lines: ['export function run(args: Array<string>): int uses io {', '  print("hello")', '  return 0', '}'],
      note: 'Applies a fix and prints the file, so a tool never edits text by guesswork.',
    },
    {
      id: 'query',
      label: 'query',
      command: 'narrac query type-of src/main.nra:3:17',
      lines: ['(int) => string uses alloc'],
      note: 'Types, definitions, references and callers, from the checker itself.',
    },
    {
      id: 'explain',
      label: 'explain',
      command: 'narrac explain E0003',
      lines: [
        'E0003: semicolons are not used; end the statement with a line break',
        '',
        'Narra has no semicolons. A line break ends a statement.',
        'Fix: delete the `;`.',
        'Example: `return 0;` becomes `return 0`.',
      ],
      note: 'Prints what an error code means, and for many codes the fix.',
    },
  ];

  let current = $signal('check');

  function selectTab(id: string) {
    current = id;
    document.getElementById(`tools-tab-${id}`)?.focus();
  }

  function moveTab(event: KeyboardEvent) {
    let position = 0;
    for (const [index, tool] of TOOLS.entries()) {
      if (tool.id === current) {
        position = index;
      }
    }
    let next = position;
    if (event.key === 'ArrowRight') {
      next = (position + 1) % TOOLS.length;
    } else if (event.key === 'ArrowLeft') {
      next = (position - 1 + TOOLS.length) % TOOLS.length;
    } else if (event.key === 'Home') {
      next = 0;
    } else if (event.key === 'End') {
      next = TOOLS.length - 1;
    }
    selectTab(TOOLS[next]!.id);
  }
</script>

<div class="tools">
  <div class="tools-list" role="tablist" aria-label="narrac commands" onKeyDown=(prevent(moveTab, 'ArrowRight', 'ArrowLeft', 'Home', 'End'))>
    #for (tool of TOOLS by tool.id) {
      <button
        type="button"
        role="tab"
        id=(`tools-tab-${tool.id}`)
        tabindex=(current === tool.id ? '0' : '-1')
        class="tools-tab"
        aria-selected=(current === tool.id ? 'true' : 'false')
        aria-controls="tools-terminal"
        onClick=(() => (current = tool.id))
      >
        <span class="tools-name">narrac {tool.label}</span>
        <span class="tools-note">{tool.note}</span>
      </button>
    }
  </div>
  <div class="terminal" id="tools-terminal" role="tabpanel" aria-labelledby=(`tools-tab-${current}`)>
    <div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="terminal-stack">
      #for (tool of TOOLS by tool.id) {
        <pre class="terminal-screen" aria-hidden=(current === tool.id ? 'false' : 'true')><span class="terminal-line terminal-command" style="--line: 0"><span class="terminal-prompt">$</span> {tool.command}</span>
          #for (line, index of tool.lines by index) {
            <span class="terminal-line" style=(`--line: ${index + 1}`)>{line}</span>
          }
        </pre>
      }
    </div>
  </div>
</div>
