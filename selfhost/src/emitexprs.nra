// Expressions (emit_expr.go, emit_call.go). Stub from selfhost-emit-core; the
// owner is selfhost-emit-bodies. The real module has one arm per expression
// kind and calls the modules listed in contracts/emitter.md.
import { Expr } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported } from "narrac/emitstate"

const NODE = "selfhost-emit-bodies"

export function emitExpression<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "expression", NODE), owned: false }
}

// emitLvaluePointer is the C pointer to an assignable expression.
export function emitLvaluePointer<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): string uses alloc {
  return reportUnsupported(mutable emitter, "lvalue", NODE)
}

// argumentCode is the C text of the n-th argument of a call.
export function argumentCode<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr, number: int): string uses alloc {
  return reportUnsupported(mutable emitter, "argument", NODE)
}

// constRef is the C expression that reads a top-level constant.
export function constRef(mutable emitter: Emitter, constIndex: int): string uses alloc {
  return reportUnsupported(mutable emitter, "constant reference", NODE)
}
