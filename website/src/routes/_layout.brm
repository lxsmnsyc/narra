<script>
  import { $props, $route } from 'brumate/signals';
  import { raw } from 'brumate/html';
  import Icon from '../components/Icon.brm';
  import { switchTheme } from '../theme-switch.ts';
  import { STYLES, THEME_SCRIPT } from '../theme.ts';

  const { children } = $props();
  const route = $route();

  const LINKS = [
    { label: 'Guide', href: '/guide' },
    { label: 'Install', href: '/install' },
    { label: 'Spec', href: '/spec' },
  ];

  /** Whether the current page is in the section of a link, such as `/guide/02-values-and-types`. */
  function isCurrent(href: string, pathname: string): boolean {
    return pathname === href || pathname.startsWith(`${href}/`);
  }
</script>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/logo.svg">
    {raw(THEME_SCRIPT)}
    {raw(STYLES)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Narra">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="var(--accent)"/>
            <path d="M9 24V8h3.2l7.6 10.4V8H23v16h-3.2L12.2 13.6V24Z" fill="var(--bg)"/>
          </svg>
          <span>Narra</span>
        </a>
        <nav class="header-nav" aria-label="Main">
          #for (link of LINKS by link.href) {
            <a
              class="nav-link"
              href=(link.href)
              aria-current=(isCurrent(link.href, route.url.pathname) ? 'page' : undefined)
            >{link.label}</a>
          }
          <a class="icon-button" href="https://github.com/lxsmnsyc/narra" aria-label="Narra on GitHub">
            <Icon name="github" size=(18) />
          </a>
          <button class="icon-button theme-toggle" type="button" aria-label="Switch theme" onClick=(() => switchTheme())>
            <span class="sun"><Icon name="sun" size=(17) /></span>
            <span class="moon"><Icon name="moon" size=(17) /></span>
          </button>
        </nav>
      </div>
    </header>
    <div id="main" tabindex="-1">
      {children}
    </div>
    <footer class="footer">
      <div class="footer-inner">
        <p>The Narra programming language.</p>
        <p>
          <a href="https://github.com/lxsmnsyc/narra">Source</a>
          · <a href="https://github.com/lxsmnsyc/narra/issues">Issues</a>
        </p>
      </div>
    </footer>
  </body>
</html>
