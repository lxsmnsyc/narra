export trait Drawable {
  function draw(value: Self): string
}

struct Circle implements Drawable {
  radius: int
}

implement Drawable for Circle {
  function draw(_value: Circle): string {
    return "circle"
  }
}

export function render(item: Dynamic<Drawable>): string {
  return Drawable.draw(item)
}

export function run(_args: Array<string>): int {
  const item: Dynamic<Drawable> = Dynamic.of(Circle { radius: 1 })
  print(render(item))
  return 0
}
