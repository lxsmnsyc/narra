// `for await` reads an async generator that sleeps between its yields, in an
// async function, an async arrow, an async block and another async generator.
import * as Int from "std/int"
import * as Time from "std/time"
import { sleep } from "std/async/time"

async function* countdown(start: int, label: string): AsyncGenerator<string> uses (io, alloc) {
  for (let count = start; count > 0; count--) {
    const slept = await sleep(Time.milliseconds(1))
    if (slept is Err(_)) {
      return
    }
    yield `${label} ${Int.toString(count)}`
  }
}

async function* doubled(start: int): AsyncGenerator<int> uses (io, alloc) {
  for await (const line of countdown(start, "inner")) {
    print(`relay ${line}`)
    yield start * 2
  }
}

async function readAll(label: string): int uses io, alloc {
  let count = 0
  for await (const line of countdown(2, label)) {
    print(line)
    count += 1
  }
  return count
}

export async function run(_args: Array<string>): int {
  print(`function read ${Int.toString(await readAll("function"))}`)
  const reader = async (label: string): int => {
    let total = 0
    for await (const line of countdown(2, label)) {
      print(line)
      total += 1
    }
    return total
  }
  print(`arrow read ${Int.toString(await reader("arrow"))}`)
  const block = async {
    let lengths = 0
    for await (const line of countdown(2, "block")) {
      print(line)
      lengths += 1
    }
    return lengths
  }
  print(`block read ${Int.toString(await block)}`)
  let sum = 0
  for await (const value of doubled(2)) {
    sum += value
  }
  print(`doubled sum ${Int.toString(sum)}`)
  return 0
}
