import * as Arrays from "std/array"

const BASE = 3

// An exported @const function declares its effects, at most alloc.
@const
export function powers(count: int): Array<int> uses alloc {
  let table: Array<int> = []
  let value = 1
  for (let index = 0; index < count; index++) {
    Arrays.push(mutable table, value)
    value = value * BASE
  }
  return table
}

export const POWERS = powers(6)
