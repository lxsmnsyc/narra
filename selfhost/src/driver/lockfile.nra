// The narra.lock reader and writer. The file is TOML with one [[package]]
// table per dependency and the keys of LockEntry in order. The reader takes
// the same subset as the manifest reader. Nothing here touches the disk.
import { isHash, repeatString, splitString, substring } from "narrac/driver/textops"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import {
  LoadError,
  isValidPackageName,
  isVersion,
  parseString,
  stripComment,
} from "narrac/driver/manifest"
import * as Sets from "std/set"
import { Set } from "std/set"

export struct LockEntry {
  name: string
  git: string
  version: string // the selected version
  tag: string // the git tag the version was fetched from, `v<version>` or `<name>/v<version>`
  commit: string // the full commit hash of the tag
  content: string // the git tree hash of that commit
}

const LOCK_HEADER = "# narra.lock: written by narrac. Do not edit.\n"

function lockError(line: int, code: string, message: string): LoadError {
  return LoadError { code, file: "narra.lock", line, column: 1, message }
}

export function parseLock(text: string): Result<Array<LockEntry>, LoadError> uses alloc {
  let entries: Array<LockEntry> = []
  let open = false
  let entryLine = 0
  let name = ""
  let git = ""
  let version = ""
  let tag = ""
  let commit = ""
  let content = ""
  let seen: Set<string> = Sets.create()
  let seenKeys: Set<string> = Sets.create()
  const lines = splitString(text, "\n")
  // The pass one line past the last stands for the end of the file and closes the final entry.
  for (const index of Ranges.between(0, Arrays.length(lines) + 1)) {
    const lineNumber = index + 1
    let line = "[[package]]"
    if (index < Arrays.length(lines)) {
      line = Str.trim(stripComment(lines[index]))
    }
    if (line == "") {
      continue
    }
    if (line == "[[package]]") {
      if (open) {
        const missing = missingKey(name, git, version, tag, commit, content)
        if (missing != "") {
          return Err(
            lockError(entryLine, "E0438", `entry ${quoteToml(name)} is missing the key ${missing}`),
          )
        }
        if (tag != `v${version}` && tag != `${name}/v${version}`) {
          return Err(
            lockError(
              entryLine,
              "E0438",
              `entry ${quoteToml(name)} has the tag ${quoteToml(tag)}, which is not the tag of version ${version}`,
            ),
          )
        }
        if (!Sets.add(mutable seen, name)) {
          return Err(lockError(entryLine, "E0439", `two entries are named ${quoteToml(name)}`))
        }
        Arrays.push(mutable entries, LockEntry { name, git, version, tag, commit, content })
      }
      open = index < Arrays.length(lines)
      entryLine = lineNumber
      seenKeys = Sets.create()
      name = ""
      git = ""
      version = ""
      tag = ""
      commit = ""
      content = ""
      continue
    }
    if (!open) {
      return Err(lockError(lineNumber, "E0437", "bad line: expected `[[package]]`"))
    }
    const equalsIndex = Str.indexOf(line, "=")
    if (equalsIndex is None) {
      return Err(lockError(lineNumber, "E0437", "bad line: expected `key = \"value\"`"))
    }
    const key = Str.trim(substring(line, 0, equalsIndex.value))
    const raw = Str.trim(Str.sliceFrom(line, equalsIndex.value + 1))
    const parsed = parseString(raw)
    if (parsed is Err(message)) {
      return Err(lockError(lineNumber, "E0437", `bad line: ${key}: ${message}`))
    }
    const #[value, consumed] = parsed.value
    if (Str.trim(Str.sliceFrom(raw, consumed)) != "") {
      return Err(
        lockError(lineNumber, "E0437", `bad line: ${key}: unexpected text after the string`),
      )
    }
    if (!Sets.add(mutable seenKeys, key)) {
      return Err(lockError(lineNumber, "E0438", `entry ${quoteToml(name)} repeats the key ${key}`))
    }
    const problem = findValueProblem(key, value)
    if (problem != "") {
      return Err(lockError(lineNumber, "E0437", `bad line: ${key} ${problem}`))
    }
    if (key == "name") {
      name = value
    } else if (key == "git") {
      git = value
    } else if (key == "version") {
      version = value
    } else if (key == "tag") {
      tag = value
    } else if (key == "commit") {
      commit = value
    } else if (key == "content") {
      content = value
    } else {
      return Err(
        lockError(lineNumber, "E0438", `entry ${quoteToml(name)} has the unknown key ${key}`),
      )
    }
  }
  return Ok(entries)
}

export function formatLock(entries: Array<LockEntry>): string uses alloc {
  let order: Array<int> = []
  for (const index of Ranges.between(0, Arrays.length(entries))) {
    Arrays.push(mutable order, index)
  }
  // An insertion sort by name keeps entries with equal names in their given order.
  for (const start of Ranges.between(1, Arrays.length(order))) {
    for (
      let position = start;
      position > 0 && entries[order[position]].name < entries[order[position - 1]].name;
      position--
    ) {
      const swap = order[position]
      order[position] = order[position - 1]
      order[position - 1] = swap
    }
  }
  let builder = Str.builder()
  Str.append(mutable builder, LOCK_HEADER)
  for (const index of Arrays.values(order)) {
    const entry = entries[index]
    Str.append(mutable builder, "\n[[package]]\n")
    Str.append(mutable builder, `name = ${quoteToml(entry.name)}\n`)
    Str.append(mutable builder, `git = ${quoteToml(entry.git)}\n`)
    Str.append(mutable builder, `version = ${quoteToml(entry.version)}\n`)
    Str.append(mutable builder, `tag = ${quoteToml(entry.tag)}\n`)
    Str.append(mutable builder, `commit = ${quoteToml(entry.commit)}\n`)
    Str.append(mutable builder, `content = ${quoteToml(entry.content)}\n`)
  }
  return Str.build(builder)
}

function missingKey(
  name: string,
  git: string,
  version: string,
  tag: string,
  commit: string,
  content: string,
): string {
  if (name == "") {
    return "name"
  }
  if (git == "") {
    return "git"
  }
  if (version == "") {
    return "version"
  }
  if (tag == "") {
    return "tag"
  }
  if (commit == "") {
    return "commit"
  }
  if (content == "") {
    return "content"
  }
  return ""
}

function isControlByte(code: int): bool {
  return code < 32 || code == 127
}

function findValueProblem(key: string, value: string): string {
  if (key == "name" && !isValidPackageName(value)) {
    return "is not a package name"
  }
  if (key == "git" && value == "") {
    return "is not a repository URL"
  }
  if (key == "version" && !isVersion(value)) {
    return "is not MAJOR.MINOR.PATCH"
  }
  if (key == "tag" && value == "") {
    return "is not a tag"
  }
  if ((key == "commit" || key == "content") && !isHash(value)) {
    return "is not a hash"
  }
  return ""
}

function quoteToml(text: string): string uses alloc {
  let builder = Str.builder()
  Str.append(mutable builder, "\"")
  let index = 0
  while (index < Str.length(text)) {
    const code = Str.byteAt(text, index)
    if (code == 34) {
      Str.append(mutable builder, "\\\"")
    } else if (code == 92) {
      Str.append(mutable builder, "\\\\")
    } else if (code == 10) {
      Str.append(mutable builder, "\\n")
    } else if (code == 9) {
      Str.append(mutable builder, "\\t")
    } else if (code == 13) {
      Str.append(mutable builder, "\\r")
    } else if (isControlByte(code)) {
      const digits = Int.toHex(code)
      Str.append(mutable builder, `\\u${repeatString("0", 4 - Str.length(digits))}${digits}`)
    } else {
      Str.append(mutable builder, substring(text, index, Str.nextChar(text, index)))
    }
    index = Str.nextChar(text, index)
  }
  Str.append(mutable builder, "\"")
  return Str.build(builder)
}
