// The registry rows, checks and emitters of std/internal (cell, coroutine, float, probe, math, clock and entropy).
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Checker, Walker, getExpressionId } from "narrac/check"
import { Pos, Arg } from "narrac/ast"
import { checkExpression, checkExclusive, checkMutableArgument } from "narrac/exprs"
import { cType } from "narrac/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  writeLine,
  temp,
  ownedTemp,
  readNodeType,
  declareUnset,
  consume,
  releaseCode,
} from "narrac/emitstate"
import { checkArgumentCount, checkArgumentAgainst, makePreludeEnum } from "narrac/stdcheckhelp"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  argumentText,
  emitFixedCall,
  findVariant,
  ioEither,
} from "narrac/stdemithelp"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

export const INTERNAL_CELL_FUNCS: Array<StdFunc> = [
  // Writes the slot of a Cell in place, whatever the reference count of its box.
  StdFunc {
    name: "CellSlot.store",
    module: "std/internal/cell",
    key: "store",
    check: "checkCellStore",
  },
]

export const INTERNAL_COROUTINE_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Co.next",
    module: "std/internal/coroutine",
    key: "next",
    mutables: [true],
    effects: ["alloc"],
    check: "checkCoResume",
  },
  StdFunc {
    name: "Co.panicMessage",
    module: "std/internal/coroutine",
    key: "panicMessage",
    parameters: [],
    result: "string",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Co.panicked",
    module: "std/internal/coroutine",
    key: "panicked",
    parameters: [],
    result: "bool",
  },
  StdFunc {
    name: "Co.resume",
    module: "std/internal/coroutine",
    key: "resume",
    mutables: [true, false],
    effects: ["alloc"],
    check: "checkCoResume",
  },
]

export const INTERNAL_FLOAT_FUNCS: Array<StdFunc> = [
  // The text must already follow the JSON number grammar; strtod reads all of it.
  StdFunc {
    name: "FloatText.parse",
    module: "std/internal/float",
    key: "parse",
    parameters: ["string"],
    result: "f64",
  },
]

export const INTERNAL_PROBE_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Probe.code",
    module: "std/internal/probe",
    key: "code",
    parameters: ["char"],
    result: "int",
  },
]

const MATH_UNARY_NAMES: Array<string> = [
  "floor",
  "ceil",
  "round",
  "trunc",
  "sin",
  "cos",
  "tan",
  "exp",
  "log",
]

const MATH_BINARY_NAMES: Array<string> = ["atan2", "pow"]

export function internalMathFuncs(): Array<StdFunc> uses alloc {
  // Each calls the C function of its name.
  let rows: Array<StdFunc> = []
  for (const key of Arrays.values(MATH_UNARY_NAMES)) {
    Arrays.push(mutable rows, StdFunc {
      name: `Libm.${key}`,
      module: "std/internal/math",
      key: key,
      parameters: ["f64"],
      result: "f64",
    })
  }
  for (const key of Arrays.values(MATH_BINARY_NAMES)) {
    Arrays.push(mutable rows, StdFunc {
      name: `Libm.${key}`,
      module: "std/internal/math",
      key: key,
      parameters: ["f64", "f64"],
      result: "f64",
    })
  }
  return rows
}

