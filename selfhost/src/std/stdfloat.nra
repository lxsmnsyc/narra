// The registry rows and emitters of std/float.
import { StdFunc } from "narrac/std/builtins"
import { Pos, Arg } from "narrac/syntax/ast"
import { Type } from "narrac/check/types"
import { Emitter, Code, EmitWalker, reportUnsupported } from "narrac/emit/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  emitOptionOut,
} from "narrac/std/stdemithelp"
import * as Arrays from "std/array"

export const FLOAT_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Float.fromInt",
    module: "std/float",
    key: "fromInt",
    parameters: ["int"],
    parameterNames: ["value"],
    result: "f64",
    doc: "Converts an `int` to `f64`. An integer beyond 2 to the power 53 rounds to the nearest `f64`.",
  },
  StdFunc {
    name: "Float.sqrt",
    module: "std/float",
    key: "sqrt",
    parameters: ["f64"],
    parameterNames: ["value"],
    result: "f64",
    doc: "Gives the square root. A negative value gives NaN.",
  },
  StdFunc {
    name: "Float.toString",
    module: "std/float",
    key: "toString",
    parameters: ["f64"],
    parameterNames: ["value"],
    result: "string",
    effects: ["alloc"],
    doc: "Writes the shortest text that reads back as the same value, with at least one digit after the point. NaN and the infinities are `nan`, `inf` and `-inf`.",
  },
  StdFunc {
    name: "Float.toFixed",
    module: "std/float",
    key: "toFixed",
    parameters: ["f64", "int"],
    parameterNames: ["value", "digits"],
    result: "Option<string>",
    effects: ["alloc"],
    doc: "Writes the value with `digits` digits after the point, rounded. Gives `None` when `digits` is below 0 or above 20.",
  },
  StdFunc {
    name: "Float.truncate",
    module: "std/float",
    key: "truncate",
    parameters: ["f64"],
    parameterNames: ["value"],
    result: "Option<int>",
    doc: "Drops the fraction and gives the `int`. Gives `None` for NaN, the infinities and any value outside the `int` range.",
  },
]

const FLOAT_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Float.toString",
    call: "lstr_from_f64",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall { name: "Float.sqrt", call: "sqrt", withPos: false, owned: false, temporary: false },
]

export function emitFloatCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(FLOAT_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Float.truncate") {
    return emitOptionOut(
      walker,
      mutable emitter,
      nodeId,
      arguments,
      "narra_float_truncate",
      Type.TInt,
      "0",
    )
  }
  if (name == "Float.toFixed") {
    return emitOptionOut(
      walker,
      mutable emitter,
      nodeId,
      arguments,
      "narra_float_to_fixed",
      Type.TStr,
      "NULL",
    )
  }
  if (name == "Float.fromInt") {
    const number = argumentText(walker, mutable emitter, arguments, 0)
    return plain(`((double)${number})`)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
