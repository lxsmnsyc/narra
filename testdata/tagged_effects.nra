// A tag's effects count at the use site: an io tag called from a function
// that declares io. A tag can return any type, here a struct.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

struct Query {
  text: string
  parameters: Array<int>
}

export function log(parts: Array<string>, values: Array<string>): int uses io, alloc {
  print(`log: ${Str.join(parts, "_")} / ${Str.join(values, ",")}`)
  return Arrays.length(values)
}

function sql(parts: Array<string>, values: Array<int>): Query from values {
  return Query { text: Str.join(parts, "?"), parameters: values }
}

export function report(name: string): int uses io, alloc {
  return log`report ${name} done`
}

export function run(_args: Array<string>): int {
  print(Int.toString(report("daily")))
  const query = sql`select * from users where id = ${7} and age > ${21}`
  print(query.text)
  print(Int.toString(Arrays.length(query.parameters)))
  return 0
}
