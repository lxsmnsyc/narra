// The original holder of a recursive enum releases before two copies of it
// are used. Each copy(...) still explains one copy on write of an array in
// its payload, so the debug copy check finds nothing. With a third write that
// no copy(...) explains, the check still reports it
// (copy_enum_original_first_hidden.copies).
import * as Int from "std/int"
import * as Arrays from "std/array"

enum Tree {
  Leaf(cells: Array<int>)
  Node(left: Tree, right: Tree)
}

function makeCopies(): Array<Tree> {
  const tree = Tree.Node(Tree.Leaf([1, 2]), Tree.Leaf([3]))
  const first = copy(tree)
  const second = copy(tree)
  return [first, second]
}

// The static rule does not follow a mutable argument of a user function, so
// it does not see that lists now shares cells.
function keep(mutable lists: Array<Array<int>>, cells: Array<int>) {
  Arrays.push(mutable lists, cells)
}

export function run(args: Array<string>): int {
  const trees = makeCopies()
  let lists: Array<Array<int>> = []
  if (trees[0] is Tree.Node(Tree.Leaf(cells), _)) {
    keep(mutable lists, cells)
  }
  if (trees[1] is Tree.Node(Tree.Leaf(cells), _)) {
    keep(mutable lists, cells)
  }
  lists[0][0] = 9
  lists[1][0] = 8
  print(`list ${Int.toString(lists[0][0])} ${Int.toString(lists[1][0])}`)
  return 0
}
