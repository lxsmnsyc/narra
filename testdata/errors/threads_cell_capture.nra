// error: Cell<int> is not Sendable
import * as Cells from "std/cell"
import * as Int from "std/int"
import * as Thread from "std/thread"

export function run(_args: Array<string>): int {
  const counter = Cells.create(0)
  const total = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => {
      Cells.set(counter, Cells.get(counter) + 1)
      return Cells.get(counter)
    })
    return Thread.join(worker)
  })
  print(Int.toString(total))
  return 0
}
