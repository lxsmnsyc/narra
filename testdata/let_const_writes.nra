import * as Arrays from "std/array"
import * as Int from "std/int"

struct Point {
  x: int
  y: int
}

export function run(args: Array<string>): int {
  // Each `let` here is written after its declaration, in a different way.
  let assigned = 0
  assigned = 1
  let compound = 0
  compound += 2
  let stepped = 0
  stepped++
  let items: Array<int> = []
  Arrays.push(mutable items, 3)
  let point = Point { x: 1, y: 2 }
  point.x = 4
  let slots = [0, 0]
  slots[1] = 5
  Arrays.push(mutable items, assigned + compound + stepped + point.x + slots[1])
  print(Int.toString(items[1]))
  return 0
}
