// std/log. The parent runs this program again as a child and prints what the child wrote to
// standard error, so the output holds the exact lines of both formats.
import * as Log from "std/log"
import { Level, Format } from "std/log"
import { Value } from "std/shape"
import * as Process from "std/process"
import * as Env from "std/env"
import * as Str from "std/string"
import * as Arrays from "std/array"

function logAll(logger: Log.Logger) uses io, alloc {
  Log.debug(logger, "starting", [])
  Log.info(logger, "listening", [#["port", Value.Int(8080)], #["tls", Value.Bool(false)]])
  Log.warn(logger, "slow request", [#["path", Value.Text("/a b")], #["seconds", Value.Float(1.5)]])
  Log.error(logger, "failed \"hard\"", [
    #["reason", Value.Text("line\nbreak")],
    #["code", Value.Null],
  ])
}

function runChild(program: string, mode: string) uses io, alloc {
  const ran = Process.run(program, [mode])
  if (ran is Ok(#[code, _, errorOutput])) {
    print(`${mode}: exit ${Show.show(code)}`)
    print(Str.trim(errorOutput))
  } else {
    print("could not start the child")
  }
}

export function run(args: Array<string>): int uses io, alloc {
  const last = args[Arrays.length(args) - 1]
  if (last == "text-info") {
    logAll(Log.create(Level.Info, Format.Text))
    return 0
  }
  if (last == "json-debug") {
    logAll(Log.create(Level.Debug, Format.Json))
    return 0
  }
  if (last == "text-fields") {
    const base = Log.with(Log.create(Level.Warn, Format.Text), [#["service", Value.Text("api")]])
    const scoped = Log.with(base, [#["request", Value.Int(7)], #["note", Value.Text("")]])
    Log.info(scoped, "hidden", [])
    Log.warn(scoped, "kept", [#["list", Value.List([Value.Int(1), Value.Text("x")])]])
    Log.error(base, "no request field", [])
    return 0
  }
  if (last == "duplicates") {
    const text = Log.with(Log.create(Level.Info, Format.Text), [#["a", Value.Int(1)]])
    const json = Log.with(Log.create(Level.Info, Format.Json), [#["a", Value.Int(1)]])
    for (const logger of [text, json]) {
      Log.info(logger, "dup", [
        #["b", Value.Int(2)],
        #["a", Value.Int(3)],
        #["level", Value.Text("loud")],
        #["a bad=\"key", Value.Text("café\tx")],
        #["", Value.Text("é")],
      ])
    }
    return 0
  }
  const program = Env.args()[0]
  runChild(program, "text-info")
  runChild(program, "json-debug")
  runChild(program, "text-fields")
  runChild(program, "duplicates")
  const quiet = Log.create(Level.Error, Format.Json)
  print(`enabled warn at error: ${Show.show(Log.enabled(quiet, Level.Warn))}`)
  print(`enabled error at error: ${Show.show(Log.enabled(quiet, Level.Error))}`)
  print(
    Log.render(Log.withLevel(quiet, Level.Debug), Level.Debug, "render", [#["a", Value.Int(1)]]),
  )
  return 0
}
