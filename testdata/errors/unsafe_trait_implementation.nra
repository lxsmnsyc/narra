// error: the implementation of `Reader.read` uses `unsafe` (through `Ptr.read`), but the trait function does not declare it; an implementation may use only the effects its trait function declares
import * as Ptr from "std/ptr"

trait Reader {
  function read(self: Self): int
}

struct Cursor implements Reader {
  data: Ptr<int>
}

implement Reader for Cursor {
  function read(self: Cursor): int {
    let value = 0
    unsafe {
      value = Ptr.read(self.data)
    }
    return value
  }
}

function readAny<T: Reader>(reader: T): int {
  return Reader.read(reader)
}

export function run(_args: Array<string>): int {
  return readAny(Cursor { data: Ptr.null() })
}
