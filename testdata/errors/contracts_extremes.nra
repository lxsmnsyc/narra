// error: this argument is not proven to meet `requires value != SMALLEST` of notMin; pass a constant, or a name checked first with an `if`
// The ends of the int range are not facts: an unchecked name proves no bound.
import * as Int from "std/int"
const SMALLEST = -9223372036854775807 - 1

function notMin(value: int): int
  requires value != SMALLEST
{
  return value
}

function atLeast(value: int): int
  requires value >= -9223372036854775807
{
  return value
}

function lowHalf(value: u64): u64
  requires value <= 9223372036854775807
{
  return value
}

export function run(args: Array<string>): int uses io, alloc {
  let parsed = 0
  if (Int.parse("-9223372036854775808", 10) is Ok(number)) {
    parsed = number
  }
  print(Int.toString(notMin(parsed)))
  print(Int.toString(atLeast(parsed)))
  const big: u64 = 18446744073709551615
  const _x = lowHalf(big)
  return 0
}
