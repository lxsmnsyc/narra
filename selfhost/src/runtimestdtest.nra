// Generated by the generated suite of selfhost/tests from selfhost/runtime/std_test.c. Do not edit:
// sh scripts/test.sh --suite generated --update rewrites it.

export const RUNTIME_STD_TEST = "// std/test runtime. Emitted only when a module imports std/test.\n//\n// Test.panics runs the closure in a child process (POSIX fork). The child\n// sets narra_panic_fd, so a panic writes its message to a pipe and exits\n// 101. The parent reads the pipe until it closes, waits for the child and\n// checks how it ended. The child's heap is a copy, so nothing it allocates\n// counts in the parent's leak check.\n//\n// The child gets a timeout (alarm), 10 seconds or NARRA_TEST_TIMEOUT, so a\n// closure that never returns fails instead of hanging the run. This also\n// bounds a nested child that would keep the pipe open.\n//\n// The failure paths free what they built, except the final message, which\n// narra_panic prints before the process ends.\n#include <errno.h>\n#include <signal.h>\n#include <pthread.h>\n#include <sched.h>\n#include <stdatomic.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n\n// While a call runs, SIGTERM, SIGINT and SIGHUP are passed on to its child, so\n// killing this process does not orphan the child. Several threads may call at\n// once: a count of active calls (under a mutex) installs the handlers for the\n// first call and restores them after the last, and each call owns a slot in a\n// fixed array of child pids that the handler walks with plain atomic loads.\n// A slot holds -1 from the claim until the pid is stored; a signal that\n// arrives in between is remembered in the pending array and sent on attach.\n#define narra_panics_SLOTS 64\nstatic pthread_mutex_t narra_panics_lock = PTHREAD_MUTEX_INITIALIZER;\nstatic int narra_panics_active = 0;\nstatic struct sigaction narra_panics_saved[3];\nstatic _Atomic int narra_panics_pids[narra_panics_SLOTS];\nstatic _Atomic int narra_panics_pending[narra_panics_SLOTS];\nstatic volatile sig_atomic_t narra_panics_caught = 0;\nstatic const int narra_panics_signals[3] = {SIGTERM, SIGINT, SIGHUP};\n\ntypedef struct narra_panics_guard {\n  sigset_t mask;\n  int slot;\n} narra_panics_guard;\n\nstatic void narra_panics_forward(int signal_number) {\n  narra_panics_caught = signal_number;\n  for (int i = 0; i < narra_panics_SLOTS; i++) {\n    if (atomic_load(&narra_panics_pids[i]) == 0) continue;\n    atomic_store(&narra_panics_pending[i], signal_number);\n    int child = atomic_load(&narra_panics_pids[i]);\n    if (child > 0) kill((pid_t)child, signal_number);\n  }\n}\n\nstatic void narra_panics_begin(narra_panics_guard* guard) {\n  sigset_t set;\n  sigemptyset(&set);\n  for (int i = 0; i < 3; i++) sigaddset(&set, narra_panics_signals[i]);\n  pthread_sigmask(SIG_BLOCK, &set, &guard->mask);\n  // Claim a slot; wait for one when all are taken.\n  guard->slot = -1;\n  while (guard->slot < 0) {\n    for (int i = 0; i < narra_panics_SLOTS; i++) {\n      int expected = 0;\n      if (atomic_compare_exchange_strong(&narra_panics_pids[i], &expected, -1)) {\n        atomic_store(&narra_panics_pending[i], 0);\n        guard->slot = i;\n        break;\n      }\n    }\n    if (guard->slot < 0) sched_yield();\n  }\n  pthread_mutex_lock(&narra_panics_lock);\n  if (narra_panics_active++ == 0) {\n    struct sigaction action;\n    memset(&action, 0, sizeof action);\n    action.sa_handler = narra_panics_forward;\n    sigemptyset(&action.sa_mask);\n    for (int i = 0; i < 3; i++) {\n      // A signal that was ignored on entry (a background job, nohup) stays ignored.\n      sigaction(narra_panics_signals[i], NULL, &narra_panics_saved[i]);\n      if (narra_panics_saved[i].sa_handler != SIG_IGN) sigaction(narra_panics_signals[i], &action, NULL);\n    }\n  }\n  pthread_mutex_unlock(&narra_panics_lock);\n}\n\n// The child takes no lock: the saved handlers do not change while a call is active.\nstatic void narra_panics_restore_child(narra_panics_guard* guard) {\n  for (int i = 0; i < 3; i++) sigaction(narra_panics_signals[i], &narra_panics_saved[i], NULL);\n  pthread_sigmask(SIG_SETMASK, &guard->mask, NULL);\n}\n\nstatic void narra_panics_attach(narra_panics_guard* guard, pid_t pid) {\n  atomic_store(&narra_panics_pids[guard->slot], (int)pid);\n  int missed = atomic_load(&narra_panics_pending[guard->slot]);\n  pthread_sigmask(SIG_SETMASK, &guard->mask, NULL);\n  if (missed) kill(pid, missed);\n}\n\n// Frees the slot with the signals still blocked, restores the old handlers\n// after the last call, then restores the old mask, so no signal reaches a\n// reaped pid.\nstatic void narra_panics_detach(narra_panics_guard* guard) {\n  sigset_t set;\n  sigemptyset(&set);\n  for (int i = 0; i < 3; i++) sigaddset(&set, narra_panics_signals[i]);\n  pthread_sigmask(SIG_BLOCK, &set, NULL);\n  atomic_store(&narra_panics_pids[guard->slot], 0);\n  pthread_mutex_lock(&narra_panics_lock);\n  if (--narra_panics_active == 0) {\n    for (int i = 0; i < 3; i++) sigaction(narra_panics_signals[i], &narra_panics_saved[i], NULL);\n  }\n  pthread_mutex_unlock(&narra_panics_lock);\n  pthread_sigmask(SIG_SETMASK, &guard->mask, NULL);\n}\ntypedef struct narra_test_proc {\n  pid_t pid;\n  int fd;\n  unsigned timeout;\n  narra_panics_guard guard;\n} narra_test_proc;\n\nstatic unsigned narra_test_timeout(void) {\n  unsigned limit = 10;\n  const char* s = getenv(\"NARRA_TEST_TIMEOUT\");\n  if (s && *s) {\n    char* end;\n    long v = strtol(s, &end, 10);\n    if (*end == 0 && v > 0 && v < 100000) limit = (unsigned)v;\n  }\n  // Inside a test that has a time limit (an alarm is pending), the closure\n  // gets what is left minus one second, at least one, so its own timeout\n  // message comes before the test's.\n  unsigned left = alarm(0);\n  if (left) {\n    alarm(left);\n    unsigned budget = left > 2 ? left - 1 : 1;\n    if (budget < limit) limit = budget;\n  }\n  return limit;\n}\n\n// narra_test_fork returns true in the child, which must call the closure\n// and then narra_test_returned. It returns false in the parent.\nstatic bool narra_test_fork(narra_test_proc* t, const char* where) {\n  int fds[2];\n  fflush(stdout);\n  fflush(stderr);\n  t->timeout = narra_test_timeout();\n  if (pipe(fds) != 0) narra_panic(where, \"Test.panics: cannot create a pipe\");\n  narra_panics_begin(&t->guard);\n  pid_t pid = fork();\n  if (pid < 0) {\n    narra_panics_detach(&t->guard);\n    narra_panic(where, \"Test.panics: cannot fork\");\n  }\n  if (pid == 0) {\n    narra_panics_restore_child(&t->guard);\n    close(fds[0]);\n    narra_panic_fd = fds[1];\n    narra_panic_pos = 0;\n    alarm(t->timeout);\n    return true;\n  }\n  narra_panics_attach(&t->guard, pid);\n  close(fds[1]);\n  t->pid = pid;\n  t->fd = fds[0];\n  return false;\n}\n\n// narra_test_returned ends the child when the closure returned.\nstatic void narra_test_returned(void) {\n  fflush(stdout);\n  _exit(0);\n}\n\n// narra_test_expect waits for the child and panics unless it panicked with\n// a message that contains want (any message when want is NULL). An empty\n// want matches any message, and the match stops at a NUL byte in either.\nstatic void narra_test_expect(narra_test_proc* t, lstr* want, const char* where) {\n  size_t cap = 256, len = 0;\n  char* msg = malloc(cap);\n  if (!msg) narra_panic(\"runtime\", \"out of memory\");\n  for (;;) {\n    if (len + 1 == cap) {\n      cap *= 2;\n      char* grown = realloc(msg, cap);\n      if (!grown) narra_panic(\"runtime\", \"out of memory\");\n      msg = grown;\n    }\n    ssize_t n = read(t->fd, msg + len, cap - 1 - len);\n    if (n < 0 && errno == EINTR) continue;\n    if (n <= 0) break;\n    len += (size_t)n;\n  }\n  msg[len] = 0;\n  close(t->fd);\n  int status = 0;\n  while (waitpid(t->pid, &status, 0) < 0) {\n    if (errno != EINTR) narra_panic(where, \"Test.panics: cannot wait for the child process\");\n  }\n  narra_panics_detach(&t->guard);\n  if (narra_panics_caught) {\n    free(msg);\n    fflush(stdout);\n    _exit(128 + narra_panics_caught);\n  }\n  char buf[160];\n  const char* fail = NULL;\n  if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {\n    fail = \"expected a panic, but the function returned\";\n  } else if (!WIFEXITED(status) || WEXITSTATUS(status) != 101) {\n    if (WIFSIGNALED(status) && WTERMSIG(status) == SIGALRM) {\n      snprintf(buf, sizeof buf, \"expected a panic, but the function ran past the %u s timeout\", t->timeout);\n    } else if (WIFSIGNALED(status)) {\n      snprintf(buf, sizeof buf, \"expected a panic, but the function was killed by signal %d\", WTERMSIG(status));\n    } else {\n      snprintf(buf, sizeof buf, \"expected a panic, but the function exited with code %d\", WEXITSTATUS(status));\n    }\n    fail = buf;\n  }\n  if (fail) {\n    free(msg);\n    narra_panic(where, fail);\n  }\n  if (want && !strstr(msg, want->data)) {\n    lstr* w = narra_show_string(want);\n    lstr* g = narra_quote(msg, (int64_t)len, '\"');\n    size_t n = (size_t)w->len + (size_t)g->len + 64;\n    char* out = malloc(n);\n    if (!out) narra_panic(\"runtime\", \"out of memory\");\n    snprintf(out, n, \"expected a panic containing %s, got %s\", w->data, g->data);\n    lstr_release(w);\n    lstr_release(g);\n    free(msg);\n    narra_panic(where, out);\n  }\n  free(msg);\n}\n\n// The failure of Test.eq. The shown values are owned and released here.\nstatic void narra_test_fail_eq(lstr* expected, lstr* actual, const char* where) {\n  size_t n = (size_t)expected->len + (size_t)actual->len + 32;\n  char* out = malloc(n);\n  if (!out) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(out, n, \"expected %s, got %s\", expected->data, actual->data);\n  lstr_release(expected);\n  lstr_release(actual);\n  narra_panic(where, out);\n}\n\nstatic void narra_test_fail_ne(lstr* value, const char* where) {\n  size_t n = (size_t)value->len + 48;\n  char* out = malloc(n);\n  if (!out) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(out, n, \"expected a value other than %s\", value->data);\n  lstr_release(value);\n  narra_panic(where, out);\n}\n\n// Test.golden: compare actual with <dir>/<name>.golden. With\n// NARRA_UPDATE_GOLDEN=1 the file is written instead.\n#include <sys/stat.h>\n\nstatic void narra_test_golden(lstr* name, lstr* actual, const char* where) {\n  const char* dir = narra_golden_dir;\n  const char* up = getenv(\"NARRA_UPDATE_GOLDEN\");\n  int update = up && strcmp(up, \"1\") == 0;\n  if (name->len == 0) narra_panic(where, \"Test.golden: the name is empty\");\n  int bad = memchr(name->data, 0, (size_t)name->len) != NULL || name->data[0] == '/';\n  // No path segment may be \"..\".\n  for (const char* s = name->data; !bad && *s;) {\n    const char* e = strchr(s, '/');\n    size_t k = e ? (size_t)(e - s) : strlen(s);\n    if (k == 2 && s[0] == '.' && s[1] == '.') bad = 1;\n    s += k + (e ? 1 : 0);\n    if (!e) break;\n  }\n  if (bad) narra_panic(where, \"Test.golden: the name must be a relative path without a `..` segment\");\n  size_t cap = strlen(dir) + (size_t)name->len + 160;\n  char* path = malloc(cap);\n  if (!path) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(path, cap, \"%s/%s.golden\", dir, name->data);\n  if (update) {\n    // Create the directories on the way.\n    mkdir(dir, 0777);\n    for (char* p = path + strlen(dir) + 1; *p; p++) {\n      if (*p == '/') {\n        *p = 0;\n        mkdir(path, 0777);\n        *p = '/';\n      }\n    }\n    FILE* f = fopen(path, \"wb\");\n    if (!f || fwrite(actual->data, 1, (size_t)actual->len, f) != (size_t)actual->len) {\n      char* out = malloc(cap + 48);\n      if (!out) narra_panic(\"runtime\", \"out of memory\");\n      snprintf(out, cap + 48, \"Test.golden: cannot write %s.golden\", name->data);\n      if (f) fclose(f);\n      free(path);\n      narra_panic(where, out);\n    }\n    fclose(f);\n    free(path);\n    return;\n  }\n  FILE* f = fopen(path, \"rb\");\n  if (!f) {\n    // The message names the golden file, not the directory, so test output\n    // does not depend on where the package is.\n    char* out = malloc(cap + 96);\n    if (!out) narra_panic(\"runtime\", \"out of memory\");\n    snprintf(out, cap + 96, \"golden file %s.golden does not exist; run with NARRA_UPDATE_GOLDEN=1 to create it\", name->data);\n    free(path);\n    narra_panic(where, out);\n  }\n  size_t wcap = 4096, wlen = 0;\n  char* want = malloc(wcap);\n  if (!want) narra_panic(\"runtime\", \"out of memory\");\n  for (;;) {\n    if (wlen == wcap) {\n      wcap *= 2;\n      want = realloc(want, wcap);\n      if (!want) narra_panic(\"runtime\", \"out of memory\");\n    }\n    size_t n = fread(want + wlen, 1, wcap - wlen, f);\n    if (n == 0) break;\n    wlen += n;\n  }\n  fclose(f);\n  const char* got = actual->data;\n  size_t glen = (size_t)actual->len;\n  size_t i = 0;\n  while (i < wlen && i < glen && want[i] == got[i]) i++;\n  if (i == wlen && i == glen) {\n    free(want);\n    free(path);\n    return;\n  }\n  // The first differing line: both lines start after the last newline before i.\n  size_t start = i;\n  int64_t line = 1;\n  for (size_t k = 0; k < i; k++) if (want[k] == '\\n') line++;\n  while (start > 0 && want[start - 1] != '\\n') start--;\n  size_t we = start, ge = start;\n  while (we < wlen && want[we] != '\\n') we++;\n  while (ge < glen && got[ge] != '\\n') ge++;\n  lstr* w = narra_quote(want + start, (int64_t)(we - start), '\"');\n  lstr* g = narra_quote(got + start, (int64_t)(ge - start), '\"');\n  size_t n = (size_t)w->len + (size_t)g->len + (size_t)name->len + 96;\n  char* out = malloc(n);\n  if (!out) narra_panic(\"runtime\", \"out of memory\");\n  snprintf(out, n, \"golden %s differs at line %lld: expected %s, got %s\", name->data, (long long)line, w->data, g->data);\n  lstr_release(w);\n  lstr_release(g);\n  free(want);\n  free(path);\n  narra_panic(where, out);\n}\n"
