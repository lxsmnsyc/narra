// error: third.column = ... may change third, which first still uses at line 13
struct Pos {
  line: int
  column: int
}

export function run(_args: Array<string>): int {
  const first = Pos { line: 1, column: 2 }
  const second = first
  // third shares first through second.
  let third = second
  third.column = 9
  return first.column + third.column
}
