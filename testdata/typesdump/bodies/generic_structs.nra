struct Pair<A, B> {
  first: A
  second: B
}

struct Holder<T> {
  items: Array<T>
  count: int = 0
}

// A generic function is checked once with its type parameters left open.
function swap<A, B>(pair: Pair<A, B>): Pair<B, A> {
  return Pair { first: pair.second, second: pair.first }
}

function make(): Pair<int, string> {
  const inferred = Pair { first: 1, second: "one" }
  const written = Pair<int, string> { first: 2, second: "two" }
  let holder = Holder { items: [inferred.first, written.first] }
  holder.count = 2
  return Pair { first: holder.count, second: written.second }
}

export function run(args: Array<string>): int {
  const pair = make()
  return pair.first
}
