// copy(x) of an enum whose payload holds a tracked value: an Option of an
// array, kept inline, and a recursive enum with a struct payload, kept on the
// heap. A write to a part taken out of the copy copies only that part, and the
// original keeps its values. The debug copy check runs on this sample and must
// find nothing, because each copy on write comes from a copy(...).
import * as Int from "std/int"

struct Row {
  cells: Array<int>
}

enum Tree {
  Leaf(row: Row)
  Node(left: Tree, right: Tree)
}

function firstCell(tree: Tree): int {
  return match (tree) { Tree.Leaf(row) => row.cells[0], Tree.Node(left, _) => firstCell(left) }
}

export function run(_args: Array<string>): int {
  const original: Option<Array<int>> = Some([1, 2, 3])
  const copied = copy(original)
  if (copied is Some(items)) {
    let list = items
    list[0] = 7
    print(`changed ${Int.toString(list[0])}`)
  }
  if (original is Some(items)) {
    print(`original ${Int.toString(items[0])}`)
  }

  const tree = Tree.Node(Tree.Leaf(Row { cells: [1, 2] }), Tree.Leaf(Row { cells: [3] }))
  const other = copy(tree)
  if (other is Tree.Node(left, _)) {
    if (left is Tree.Leaf(row)) {
      let edited = row
      edited.cells[0] = 9
      print(`edited ${Int.toString(edited.cells[0])}`)
    }
  }
  print(`tree ${Int.toString(firstCell(tree))}`)
  return 0
}
