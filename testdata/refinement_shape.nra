// A derived Shape decodes the base, then calls check (D116): a value outside the
// refinement is a decode error with its path.
import * as Json from "std/json"
import { Shape } from "std/shape"

distinct type Port = int derives Show, Shape requires >= 1 && <= 65535
distinct type Method = string derives Show, Shape requires "GET" | "POST"

struct Route derives Show, Shape {
  port: Port
  method: Method
}

function decode(text: string) {
  match (Json.decode<Route>(text)) {
    Ok(route) => {
      print(Show.show(route))
      print(Json.encode(route))
    }
    Err(message) => print(message)
  }
}

export function run(_args: Array<string>): int {
  decode(`{"port": 8080, "method": "GET"}`)
  decode(`{"port": 70000, "method": "GET"}`)
  decode(`{"port": 443, "method": "PUT"}`)
  decode(`{"port": 0, "method": "POST"}`)
  print(Json.encode(Route { port: Port.from(22), method: Method.from("POST") }))
  if (Json.decode<Array<Port>>("[1, 2, 65536]") is Err(message)) {
    print(message)
  }
  return 0
}
