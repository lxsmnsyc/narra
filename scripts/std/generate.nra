// Writes the std reference: one page for each public std module and README.md, the index.
//
//   narrac run -release scripts/std/generate.nra <narrac> <repository> <folder>
//
// <narrac> lists its builtin modules (`narrac builtins`) and answers
// `narrac query --json interface` for each module. The source modules are the files of
// <repository>/std/src. The pages go to <folder> (docs/reference/std), std/<name> as
// <name>.md, and a Markdown file there that no module wrote is removed.
// Signatures stay in `narra fragment` fences, so no generic type can become markup.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Io from "std/io"
import * as Json from "std/json"
import * as Path from "std/path"
import * as Process from "std/process"
import * as Ranges from "std/range"
import * as Str from "std/string"

struct Declaration derives Shape {
  name: string
  kind: string
  signature: string
  doc: string = ""
  functions: Array<string> = []
}

struct Interface derives Shape {
  declarations: Array<Declaration>
}

struct ModuleInfo {
  path: string
  alias: string
  description: string
  chapter: string
}

struct Chapter {
  link: string
  title: string
}

function listModuleInfo(): Array<ModuleInfo> uses alloc {
  return [
    ModuleInfo {
      path: "std/arena",
      alias: "Arenas",
      description: "Values in slots, reached through handles that check the generation of the slot.",
      chapter: "13-standard-library",
    },
    ModuleInfo {
      path: "std/args",
      alias: "Args",
      description: "A command line as data: flags, positionals and subcommands, parsed in one call.",
      chapter: "13-standard-library",
    },
    ModuleInfo {
      path: "std/array",
      alias: "Arrays",
      description: "Arrays: length, push, slices and loops over values and entries.",
      chapter: "02-values-and-types",
    },
    ModuleInfo {
      path: "std/async",
