// Async.race gives the value of the first task to finish, and None for an
// empty array. The other tasks keep running. With a finished handle in the
// array, the first finished one in array order wins.
import * as Async from "std/async"
import * as Ranges from "std/range"

async function after(label: string, rounds: int): string uses io, alloc {
  for (const _ of Ranges.between(0, rounds)) {
    await Async.idle()
  }
  print(`${label} finishes`)
  return label
}

function show(result: Option<string>): string uses alloc {
  if (result is Some(value)) {
    return `Some(${value})`
  }
  return "None"
}

export async function run(_args: Array<string>): int {
  const slow = after("slow", 3)
  const first = await Async.race([slow, after("quick", 1), after("middle", 2)])
  print(`race gives ${show(first)}`)
  print(`slow still gives ${await slow}`)

  const none: Array<Async<string>> = []
  print(`empty gives ${show(await Async.race(none))}`)

  const done = after("done", 0)
  const alsoDone = after("also done", 0)
  print(`finished gives ${show(await Async.race([after("pending", 1), alsoDone, done]))}`)

  // Two races over the same handle, one of them left waiting at exit.
  const shared = after("shared", 1)
  // At exit this task is dropped at its next wait, so it never prints.
  Async.detach(Async.race([shared, after("never awaited", 5)]))
  print(`shared gives ${show(await Async.race([shared]))}`)
  return 0
}
