// The registry rows and checks of std/ptr. Every function that reads, writes,
// moves or frees a pointer has the unsafe effect, so a call needs an `unsafe { }`
// block (effects.nra); Ptr.null and Ptr.isNull touch no memory and are safe. The emitters are
// in emitpointers.nra and the Ptr<T> type rules in unsafecode.nra.
import * as Arrays from "std/array"
import { StdFunc, StdType } from "narrac/std/builtins"
import { Type } from "narrac/check/types"
import { checkFixedIndex } from "narrac/check/fixedarrays"
import {
  Checker,
  Walker,
  internComposite,
  reportError,
  typeString,
  getExpressionPos,
} from "narrac/check/check"
import { Pos, Arg } from "narrac/syntax/ast"
import { checkExpression, expectType } from "narrac/check/exprs"
import { checkArgumentCount, checkArgumentAgainst } from "narrac/std/stdcheckhelp"

export const POINTER_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Ptr.alloc",
    module: "std/ptr",
    key: "alloc",
    effects: ["alloc", "unsafe"],
    check: "checkPtrAlloc",
    signature: "<T>(count: int): Ptr<T>",
    doc: "Allocates zeroed memory for `count` values of `T` and gives a pointer to the first. It stays allocated until `Ptr.free`.",
  },
  StdFunc {
    name: "Ptr.cast",
    module: "std/ptr",
    key: "cast",
    effects: ["unsafe"],
    check: "checkPtrCast",
    signature: "<T, U>(pointer: Ptr<T>): Ptr<U>",
    doc: "Gives the same address as a pointer to `U`. Nothing checks that the memory holds a `U`.",
  },
  StdFunc {
    name: "Ptr.element",
    module: "std/ptr",
    key: "element",
    effects: ["unsafe"],
    check: "checkPtrElement",
    signature: "<T, const N: int>(pointer: Ptr<FixedArray<T, N>>, index: int): Ptr<T>",
    note: "index: a constant or a name proven to be 0 to N - 1",
    doc: "Gives a pointer to element `index` of the `FixedArray` the pointer points at.",
  },
  StdFunc {
    name: "Ptr.free",
    module: "std/ptr",
    key: "free",
    effects: ["unsafe"],
    check: "checkPtrFree",
    signature: "<T>(pointer: Ptr<T>)",
    doc: "Frees memory that `Ptr.alloc` gave. A null pointer does nothing, and any later use of the pointer is undefined.",
  },
  StdFunc {
    name: "Ptr.isNull",
    module: "std/ptr",
    key: "isNull",
    check: "checkPtrIsNull",
    signature: "<T>(pointer: Ptr<T>): bool",
    doc: "Tells whether the pointer is null. It reads no memory, so it needs no `unsafe` block.",
  },
  StdFunc {
    name: "Ptr.null",
    module: "std/ptr",
    key: "null",
    check: "checkPtrNull",
    signature: "<T>(): Ptr<T>",
    doc: "Gives a null pointer. It reads no memory, so it needs no `unsafe` block.",
  },
  StdFunc {
    name: "Ptr.offset",
    module: "std/ptr",
    key: "offset",
    effects: ["unsafe"],
    check: "checkPtrOffset",
    signature: "<T>(pointer: Ptr<T>, count: int): Ptr<T>",
    doc: "Gives the pointer moved by `count` values of `T`, which may be negative. Nothing checks that the result is inside the allocation.",
  },
  StdFunc {
    name: "Ptr.read",
    module: "std/ptr",
    key: "read",
    effects: ["unsafe"],
    check: "checkPtrRead",
    signature: "<T>(pointer: Ptr<T>): T",
    doc: "Reads the value the pointer points at. Nothing checks that the pointer is valid or not null.",
  },
  StdFunc {
    name: "Ptr.write",
    module: "std/ptr",
    key: "write",
    effects: ["unsafe"],
    check: "checkPtrWrite",
    signature: "<T>(pointer: Ptr<T>, value: T)",
    doc: "Writes `value` where the pointer points. Nothing checks that the pointer is valid or not null.",
  },
]

function checkPointerArgument<W: Walker>(
  mutable checker: Checker,
  walker: W,
  argument: Arg,
  name: string,
): Option<Type> uses alloc {
  // The element type of a pointer argument, or None after an error.
  const found = checkExpression(mutable checker, walker, argument.value, None)
  if (found is Type.TPtr(element)) {
    return Some(element)
  }
  if (found != Type.TVoid) {
    const foundName = typeString(checker, found)
    reportError(
      mutable checker,
      getExpressionPos(argument.value),
      "E0998",
      `${name} takes a Ptr, found ${foundName}`,
    )
  }
  return None
}

function reportMissingElement(
  mutable checker: Checker,
  pos: Pos,
  name: string,
  example: string,
) uses alloc {
  reportError(
    mutable checker,
    pos,
    "E0998",
    `${name} takes its element type from where the result goes, as in \`${example}\``,
  )
}

function checkPtrAlloc<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  want: Option<Type>,
): Type from want uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    return Type.TVoid
  }
  checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
  if (want is Some(Type.TPtr(element))) {
    return internComposite(mutable checker, Type.TPtr(element))
  }
  reportMissingElement(mutable checker, pos, name, "const items: Ptr<int> = Ptr.alloc(4)")
  return Type.TVoid
}

function checkPtrNull<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  want: Option<Type>,
): Type from want uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 0)) {
    return Type.TVoid
  }
  if (want is Some(Type.TPtr(element))) {
    return internComposite(mutable checker, Type.TPtr(element))
  }
  reportMissingElement(mutable checker, pos, name, "const none: Ptr<int> = Ptr.null()")
  return Type.TVoid
}

function checkPtrFree<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    checkPointerArgument(mutable checker, walker, arguments[0], name)
  }
  return Type.TVoid
}

function checkPtrIsNull<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    checkPointerArgument(mutable checker, walker, arguments[0], name)
  }
  return Type.TBool
}

function checkPtrRead<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    return Type.TVoid
  }
  if (checkPointerArgument(mutable checker, walker, arguments[0], name) is Some(element)) {
    return element
  }
  return Type.TVoid
}

function checkPtrWrite<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 2)) {
    return Type.TVoid
  }
  if (checkPointerArgument(mutable checker, walker, arguments[0], name) is Some(element)) {
    checkArgumentAgainst(mutable checker, walker, arguments[1].value, element)
    return Type.TVoid
  }
  checkExpression(mutable checker, walker, arguments[1].value, None)
  return Type.TVoid
}

function checkPtrOffset<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 2)) {
    return Type.TVoid
  }
  const found = checkPointerArgument(mutable checker, walker, arguments[0], name)
  checkArgumentAgainst(mutable checker, walker, arguments[1].value, Type.TInt)
  if (found is Some(element)) {
    return internComposite(mutable checker, Type.TPtr(element))
  }
  return Type.TVoid
}

function checkPtrCast<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  want: Option<Type>,
): Type from want uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    return Type.TVoid
  }
  const found = checkPointerArgument(mutable checker, walker, arguments[0], name)
  if (want is Some(Type.TPtr(target))) {
    return internComposite(mutable checker, Type.TPtr(target))
  }
  if (found is Some(_)) {
    reportMissingElement(mutable checker, pos, name, "const bytes: Ptr<u8> = Ptr.cast(pointer)")
  }
  return Type.TVoid
}

function checkPtrElement<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 2)) {
    return Type.TVoid
  }
  const found = checkPointerArgument(mutable checker, walker, arguments[0], name)
  const indexType = checkExpression(mutable checker, walker, arguments[1].value, Some(Type.TInt))
  expectType(mutable checker, getExpressionPos(arguments[1].value), Some(Type.TInt), indexType)
  if (found is Some(arrayType)) {
    if (arrayType is Type.TFixedArray(element, _)) {
      if (indexType == Type.TInt) {
        // The index is proven like the index of a FixedArray read.
        checkFixedIndex(mutable checker, arrayType, arguments[1].value)
      }
      return internComposite(mutable checker, Type.TPtr(element))
    }
    const arrayName = typeString(checker, arrayType)
    reportError(
      mutable checker,
      getExpressionPos(arguments[0].value),
      "E0998",
      `${name} takes a Ptr to a FixedArray, found Ptr<${arrayName}>`,
    )
  }
  return Type.TVoid
}

export function checkPointerCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
  want: Option<Type>,
): Type from want uses alloc {
  if (kind == "checkPtrAlloc") {
    return checkPtrAlloc(mutable checker, walker, pos, arguments, name, want)
  }
  if (kind == "checkPtrNull") {
    return checkPtrNull(mutable checker, walker, pos, arguments, name, want)
  }
  if (kind == "checkPtrCast") {
    return checkPtrCast(mutable checker, walker, pos, arguments, name, want)
  }
  if (kind == "checkPtrElement") {
    return checkPtrElement(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkPtrFree") {
    return checkPtrFree(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkPtrIsNull") {
    return checkPtrIsNull(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkPtrRead") {
    return checkPtrRead(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkPtrWrite") {
    return checkPtrWrite(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkPtrOffset") {
    return checkPtrOffset(mutable checker, walker, pos, arguments, name)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
}

export function listPointerTypes(): Array<StdType> uses alloc {
  // Every function of std/ptr works on Ptr<T>.
  let functions: Array<string> = []
  for (const builtin of Arrays.values(POINTER_FUNCS)) {
    Arrays.push(mutable functions, builtin.key)
  }
  return [
    StdType {
      module: "std/ptr",
      name: "Ptr",
      typeParameters: "<T>",
      functions,
      doc: "The address of a `T`, with no reference count. `T` must hold no counted value, such as a string or an array.",
    },
  ]
}
