// Module scopes across modules, ported from compiler/internal/narra:
// the import loop of declareModule and useModule (check.go),
// importPackageModule, exported, entryFunc and checkEntry
// (modules_check.go), importTrait (check_traits.go), importConst and the
// imported-constant check of declareConsts (check_const.go), declareType
// (check_types.go), and checkImportNames and aliasTaken (import_names.go).
//
// Package modules are declared in load order, imports first, so every
// module an import names already has its scope and its table entries. An
// imported name points at the declaring module's entry: a type is the same
// Type value, a function, constant, generic or trait the same table index.
import { Pos, Decl, File, ImportDecl, ImportName } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Package, entryModule, extensionPath } from "narrac/modules"
import { Type } from "narrac/types"
import { Fix, createFix, createEdit, moveColumn } from "narrac/fixes"
import { moduleList, StdModule } from "narrac/builtins"
import {
  Checker,
  EntryInfo,
  EntryTarget,
  reportError,
  reportErrorFix,
  enter,
  lookupType,
  lookupGeneric,
  lookupTrait,
} from "narrac/check"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export function getDeclarationName(declaration: Decl): string {
  return match (declaration) {
    Decl.Func(funcDecl) => funcDecl.name
    Decl.Const(declared) => declared.name
    Decl.Struct(declared) => declared.name
    Decl.Enum(declared) => declared.name
    Decl.Distinct(declared) => declared.name
    Decl.Alias(declared) => declared.name
    Decl.Trait(declared) => declared.name
    // Tests and implement blocks declare no name.
    _ => ""
  }
}

function isExported(declaration: Decl): bool {
  return match (declaration) {
    Decl.Func(funcDecl) => funcDecl.exported
    Decl.Const(declared) => declared.exported
    Decl.Struct(declared) => declared.exported
    Decl.Enum(declared) => declared.exported
    Decl.Distinct(declared) => declared.exported
    Decl.Alias(declared) => declared.exported
    Decl.Trait(declared) => declared.exported
    _ => false
  }
}

export function collectExports(declarations: Array<Decl>): Map<string, int> uses alloc {
  // A later declaration of the same name wins.
  let out: Map<string, int> = Map {}
  for (const index of Ranges.between(0, Arrays.length(declarations))) {
    if (isExported(declarations[index])) {
      out[getDeclarationName(declarations[index])] = index
    }
  }
  return out
}

export function checkTypeName(mutable checker: Checker, pos: Pos, name: string) uses alloc {
  if (lookupType(checker, name) is Some(_)) {
    reportError(mutable checker, pos, "E0104", `type ${quoteGo(name)} is declared twice`)
  }
  if (lookupGeneric(checker, name) is Some(_)) {
    reportError(mutable checker, pos, "E0104", `type ${quoteGo(name)} is declared twice`)
  }
  if (checker.scopes[checker.current].aliases[name] is Some(_)) {
    reportError(mutable checker, pos, "E0104", `type ${quoteGo(name)} is declared twice`)
  }
}

export function declareType(
  mutable checker: Checker,
  pos: Pos,
  name: string,
  type: Type,
) uses alloc {
  checkTypeName(mutable checker, pos, name)
  const scope = checker.current
  checker.scopes[scope].types[name] = type
}

export function importModules(mutable checker: Checker, file: File) uses alloc {
  let aliases: Map<string, bool> = Map {}
  for (const importDecl of Arrays.values(file.imports)) {
    // std/ext/... is the Narra part of a builtin std module, and std/internal/... holds
    // primitives and tables (a source module such as std/internal/unicode is loaded
    // before the registry check below); only std modules import them.
    if (
      (Str.startsWith(importDecl.path, "std/ext/") ||
        Str.startsWith(importDecl.path, "std/internal/")) &&
        !Str.startsWith(checker.scopes[checker.current].path, "std/")
    ) {
      reportError(
        mutable checker,
        importDecl.pos,
        "E0426",
        `${importDecl.path} is internal to the standard library`,
      )
      continue
    }
    if (importPackageModule(mutable checker, importDecl, mutable aliases)) {
      continue
    }
    if (checker.registry.modules[importDecl.path] is Some(stdModule)) {
      const moduleFunctions = copy(stdModule.functions)
      useModule(mutable checker, importDecl.path)
      const scope = checker.current
      if (importDecl.path == "std/string") {
        // The type is visible only where its runtime C is emitted.
        checker.scopes[scope].types["StringBuilder"] = Type.TStringBuilder
      }
      if (importDecl.path == "std/internal/asyncio") {
        checker.scopes[scope].types["Handle"] = Type.THandle
      }
      bindAlias(mutable checker, importDecl, mutable aliases)
      for (const name of Arrays.values(importDecl.names)) {
        if (moduleFunctions[name.name] is Some(index)) {
          if (checker.scopes[scope].imported[name.local] is Some(previous)) {
            if (previous != index) {
              reportError(
                mutable checker,
                importDecl.pos,
                "E0424",
                `imported name ${quoteGo(name.local)} is already imported from another module; rename one with \`as\``,
              )
              continue
            }
          }
          checker.scopes[scope].imported[name.local] = index
        } else if (importExtension(mutable checker, importDecl, name)) {
          continue
        } else {
          reportError(
            mutable checker,
            importDecl.pos,
            "E0101",
            `module ${quoteGo(importDecl.path)} has no export ${quoteGo(name.name)}`,
          )
        }
      }
    } else {
      const list = moduleList(checker.registry)
      reportError(
        mutable checker,
        importDecl.pos,
        "E0100",
        `unknown module ${quoteGo(importDecl.path)} (this compiler supports ${list})`,
      )
    }
  }
}

function importExtension(
  mutable checker: Checker,
  importDecl: ImportDecl,
  name: ImportName,
): bool uses alloc {
  // A name the builtin module lacks may come from its Narra part.
  const extension = extensionScope(checker, importDecl.path)
  if (extension < 0) {
    return false
  }
  if (checker.scopes[extension].exports[name.name] is Some(index)) {
    const declaration = checker.scopes[extension].declarations[index]
    importDeclaration(
      mutable checker,
      importDecl.pos,
      extension,
      name.name,
      name.local,
      declaration,
    )
    return true
  }
  return false
}

function useModule(mutable checker: Checker, path: string) uses alloc {
  // Std modules are recorded once, in first-import order; the emitter writes their
  // runtime C in that order.
  for (const used of Arrays.values(checker.used)) {
    if (used == path) {
      return
    }
  }
  Arrays.push(mutable checker.used, path)
}

export function sourceScope(checker: Checker, path: string): int {
  if (checker.scopeIndex[path] is Some(scope)) {
    if (checker.scopes[scope].isSource) {
      return scope
    }
  }
  return -1
}

export function extensionScope(checker: Checker, path: string): int uses alloc {
  // The Narra part of a builtin std module (std/ext/int for std/int), or -1.
  const extension = extensionPath(path)
  if (extension != "") {
    return sourceScope(checker, extension)
  }
  return -1
}

export function memberScope(checker: Checker, path: string): int uses alloc {
  const scope = sourceScope(checker, path)
  if (scope >= 0) {
    return scope
  }
  return extensionScope(checker, path)
}

function bindAlias(
  mutable checker: Checker,
  importDecl: ImportDecl,
  mutable aliases: Map<string, bool>,
) uses alloc {
  // aliases holds the aliases the current file has bound. Another file of the module
  // may bind an alias again for the same path, never for another one.
  if (importDecl.alias == "") {
    return
  }
  const current = checker.current
  if (checker.scopes[current].modules[importDecl.alias] is Some(previous)) {
    if (previous != importDecl.path || aliases[importDecl.alias] is Some(_)) {
      reportError(
        mutable checker,
        importDecl.pos,
        "E0422",
        `two imports use the alias ${importDecl.alias}; give one of them another alias`,
      )
    }
  }
  aliases[importDecl.alias] = true
  checker.scopes[current].modules[importDecl.alias] = importDecl.path
}

function importPackageModule(
  mutable checker: Checker,
  importDecl: ImportDecl,
  mutable aliases: Map<string, bool>,
): bool uses alloc {
  // Returns false when the path is not a package module, so the caller tries std
  // modules.
  const scope = sourceScope(checker, importDecl.path)
  if (scope < 0) {
    const prefix = `${checker.packageName}/`
    if (!checker.single && Str.startsWith(importDecl.path, prefix)) {
      const rest = Str.sliceFrom(importDecl.path, Str.length(prefix))
      const message = `unknown module ${quoteGo(importDecl.path)}; package ${checker.packageName} has no file src/${rest}.nra`
      reportError(mutable checker, importDecl.pos, "E0401", message)
      return true
    }
    return false
  }
  const _current = checker.current
  bindAlias(mutable checker, importDecl, mutable aliases)
  for (const name of Arrays.values(importDecl.names)) {
    if (checker.checkingBodies) {
      const owner = findConstructorOwner(checker, scope, name.name)
      if (owner != "") {
        let fixes: Array<Fix> = []
        if (name.pos.line > 0 && !importsName(importDecl, owner)) {
          fixes = [createFix(`import the enum ${owner}`, [createEdit(name.pos, name.end, owner)])]
        }
        reportErrorFix(
          mutable checker,
          name.pos,
          "E0425",
          fixes,
          `${quoteGo(name.name)} is a constructor of ${owner}; import the enum and write ${owner}.${name.name}`,
        )
        continue
      }
    }
    const found = exported(mutable checker, importDecl.pos, scope, name.name)
    match (found) {
      Some(declaration) => importDeclaration(
        mutable checker,
        importDecl.pos,
        scope,
        name.name,
        name.local,
        declaration,
      )
      None => {}
    }
  }
  return true
}

function importDeclaration(
  mutable checker: Checker,
  pos: Pos,
  scope: int,
  name: string,
  local: string,
  declaration: Decl,
) uses alloc {
  const current = checker.current
  match (declaration) {
    Decl.Func(_) => {
      if (checker.scopes[current].functions[local] is Some(_)) {
        reportError(mutable checker, pos, "E0102", `function ${quoteGo(local)} is declared twice`)
      }
      if (checker.scopes[scope].functions[name] is Some(index)) {
        checker.scopes[current].functions[local] = index
      }
    }
    Decl.Const(_) => {
      if (checker.scopes[scope].consts[name] is Some(index)) {
        importConst(mutable checker, pos, local, index)
      }
    }
    Decl.Trait(_) => {
      if (checker.scopes[scope].traits[name] is Some(traitIndex)) {
        if (checker.traits[traitIndex].module == checker.scopes[scope].path) {
          importTrait(mutable checker, pos, local, traitIndex)
        }
      }
    }
    Decl.Distinct(_) => importType(mutable checker, pos, scope, name, local)
    Decl.Alias(_) => importAlias(mutable checker, pos, scope, name, local)
    Decl.Struct(_) | Decl.Enum(_) => importNamedType(mutable checker, pos, scope, name, local)
    _ => {}
  }
}

function importType(
  mutable checker: Checker,
  pos: Pos,
  scope: int,
  name: string,
  local: string,
) uses alloc {
  if (checker.scopes[scope].types[name] is Some(type)) {
    declareType(mutable checker, pos, local, type)
  } else {
    checkTypeName(mutable checker, pos, local)
  }
}

function importAlias(
  mutable checker: Checker,
  pos: Pos,
  scope: int,
  name: string,
  local: string,
) uses alloc {
  // A generic alias is shared by index; any other alias is its resolved type.
  if (checker.scopes[scope].aliases[name] is Some(alias)) {
    if (Arrays.length(checker.aliases[alias].typeParameters) > 0) {
      checkTypeName(mutable checker, pos, local)
      const current = checker.current
      checker.scopes[current].aliases[local] = alias
      return
    }
  }
  importType(mutable checker, pos, scope, name, local)
}

function importNamedType(
  mutable checker: Checker,
  pos: Pos,
  scope: int,
  name: string,
  local: string,
) uses alloc {
  if (checker.scopes[scope].generics[name] is Some(generic)) {
    if (checker.scopes[scope].types[name] is None) {
      if (lookupType(checker, local) is Some(_) || lookupGeneric(checker, local) is Some(_)) {
        reportError(mutable checker, pos, "E0104", `type ${quoteGo(local)} is declared twice`)
      }
      const current = checker.current
      checker.scopes[current].generics[local] = generic
      return
    }
  }
  importType(mutable checker, pos, scope, name, local)
}

export function exported(
  mutable checker: Checker,
  pos: Pos,
  scope: int,
  name: string,
): Option<Decl> from checker uses alloc {
  if (checker.scopes[scope].exports[name] is Some(index)) {
    return Some(checker.scopes[scope].declarations[index])
  }
  const path = checker.scopes[scope].path
  for (const declaration of Arrays.values(copy(checker.scopes[scope].declarations))) {
    if (getDeclarationName(declaration) == name) {
      reportError(
        mutable checker,
        pos,
        "E0402",
        `${quoteGo(name)} is not exported by module ${quoteGo(path)}; add \`export\` to its declaration`,
      )
      return None
    }
  }
  if (path == "std/coroutine" && name == "resume") {
    reportError(
      mutable checker,
      pos,
      "E0197",
      "resume is not an export you can import by name; write `import * as Co from \"std/coroutine\"` and call Co.resume",
    )
    return None
  }
  reportError(
    mutable checker,
    pos,
    "E0101",
    `module ${quoteGo(path)} has no export ${quoteGo(name)}`,
  )
  return None
}

function importTrait(mutable checker: Checker, pos: Pos, name: string, traitIndex: int) uses alloc {
  if (
    lookupTrait(checker, name) >= 0 ||
      lookupType(checker, name) is Some(_) ||
      lookupGeneric(checker, name) is Some(_)
  ) {
    reportError(mutable checker, pos, "E0500", `${quoteGo(name)} is declared twice`)
    return
  }
  const current = checker.current
  checker.scopes[current].traits[name] = traitIndex
}

function importConst(mutable checker: Checker, pos: Pos, name: string, index: int) uses alloc {
  const current = checker.current
  if (checker.scopes[current].consts[name] is Some(_) || typeNamed(checker, name)) {
    reportError(mutable checker, pos, "E0190", `constant ${quoteGo(name)} is declared twice`)
    return
  }
  checker.scopes[current].consts[name] = index
}

export function typeNamed(checker: Checker, name: string): bool {
  return lookupType(checker, name) is Some(_) ||
    lookupGeneric(checker, name) is Some(_) ||
    checker.scopes[checker.current].aliases[name] is Some(_) ||
    lookupTrait(checker, name) >= 0
}

export function checkImportedConsts(mutable checker: Checker, file: File) uses alloc {
  // The import ran before the module's types existed, so a constant may share a name
  // with a type declared later.
  const current = checker.current
  const path = checker.scopes[current].path
  for (const importDecl of Arrays.values(file.imports)) {
    for (const name of Arrays.values(importDecl.names)) {
      if (checker.scopes[current].consts[name.local] is Some(index)) {
        if (checker.consts[index].module != path && typeNamed(checker, name.local)) {
          reportError(
            mutable checker,
            importDecl.pos,
            "E0190",
            `constant ${quoteGo(name.local)} is declared twice`,
          )
        }
      }
    }
  }
}

export function recordEntryTargets(mutable checker: Checker, package: Package) uses alloc {
  for (const binary of Arrays.values(package.binaries)) {
    const #[modulePath, functionName] = entryModule(package, binary.entry)
    Arrays.push(mutable checker.entryTargets, EntryTarget {
      module: modulePath,
      name: functionName,
    })
  }
}

export function checkEntries(mutable checker: Checker, package: Package) uses alloc {
  for (const binary of Arrays.values(package.binaries)) {
    const index = entryFunc(checker, package, binary.entry)
    if (index >= 0) {
      const scope = checker.functions[index].scope
      const saved = enter(mutable checker, scope)
      checkEntry(mutable checker, index)
      enter(mutable checker, saved)
    }
    const info = EntryInfo { binary: binary.name, funcIndex: index }
    Arrays.push(mutable checker.entries, info)
  }
}

function entryFunc(checker: Checker, package: Package, entry: string): int uses alloc {
  const target = entryModule(package, entry)
  const #[modulePath, functionName] = target
  const scope = sourceScope(checker, modulePath)
  if (scope < 0) {
    return -1
  }
  if (checker.scopes[scope].exports[functionName] is Some(index)) {
    if (checker.scopes[scope].declarations[index] is Decl.Func(funcDecl)) {
      if (checker.scopes[scope].functions[functionName] is Some(funcIndex)) {
        if (
          checker.functions[funcIndex].declaration.pos == funcDecl.pos &&
            checker.functions[funcIndex].scope == scope
        ) {
          return funcIndex
        }
      }
    }
  }
  return -1
}

function checkEntry(mutable checker: Checker, index: int) uses alloc {
  const funcDecl = copy(checker.functions[index].declaration)
  // An async entry gives its exit code through its Async<int> (D109 item 6).
  let result = checker.functions[index].result
  if (result is Type.TAsync(value)) {
    result = value
  }
  let valid = Arrays.length(funcDecl.parameters) == 1 && result == Type.TInt
  if (valid) {
    const param = funcDecl.parameters[0]
    valid = checker.paramTypes[param.id] == Type.TArray(Type.TStr) && !param.isMutable
  }
  if (!valid) {
    reportError(
      mutable checker,
      funcDecl.pos,
      "E0400",
      `the entry function must be \`export function ${funcDecl.name}(args: Array<string>): int\``,
    )
  }
}

function importsName(importDecl: ImportDecl, name: string): bool {
  for (const imported of Arrays.values(importDecl.names)) {
    if (imported.name == name || imported.local == name) {
      return true
    }
  }
  return false
}

function findConstructorOwner(checker: Checker, moduleScope: int, name: string): string {
  // For `import { Teacher }`, Teacher is not an export of the module but a
  // constructor of an exported enum.
  if (checker.scopes[moduleScope].exports[name] is Some(_)) {
    return ""
  }
  // The first such enum by name wins.
  let owner = ""
  for (const declaration of Arrays.values(checker.scopes[moduleScope].declarations)) {
    if (declaration is Decl.Enum(enumDecl)) {
      if (enumDecl.exported && (owner == "" || enumDecl.name < owner)) {
        for (const variant of Arrays.values(enumDecl.variants)) {
          if (variant.name == name) {
            owner = enumDecl.name
          }
        }
      }
    }
  }
  return owner
}

// The std modules whose functions are called as Name.f, by the prelude
// type name, with the plural alias the convention gives them (Go's
// namespaceModules and pluralAlias).
export struct Namespace {
  name: string
  path: string
  plural: string
}

const NAMESPACES = [
  Namespace { name: "Array", path: "std/array", plural: "Arrays" },
  Namespace { name: "Box", path: "std/box", plural: "Boxes" },
  Namespace { name: "Map", path: "std/map", plural: "Maps" },
  Namespace { name: "Option", path: "std/option", plural: "Options" },
  Namespace { name: "Range", path: "std/range", plural: "Ranges" },
  Namespace { name: "Result", path: "std/result", plural: "Results" },
]

export function isNamespaceName(name: string): bool {
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == name) {
      return true
    }
  }
  return false
}

export function findNamespace(name: string): Option<Namespace> uses alloc {
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == name) {
      return Some(namespace)
    }
  }
  return None
}

function aliasTaken(checker: Checker, name: string): bool {
  return typeNamed(checker, name) || isNamespaceName(name)
}

function suggestAlias(alias: string, path: string): string uses alloc {
  // Suggests the plural of a namespace type, or of the std module the import names, or
  // the alias with an s.
  let suggestion = ""
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == alias) {
      suggestion = namespace.plural
    }
  }
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.path == path) {
      suggestion = namespace.plural
    }
  }
  if (suggestion == "") {
    return `${alias}s`
  }
  return suggestion
}

function buildRenameAliasFix(
  checker: Checker,
  file: File,
  importDecl: ImportDecl,
  suggestion: string,
): Array<Fix> from importDecl uses alloc {
  // When the alias is also an enum, `Alias.Ctor(...)` is a constructor and stays: only
  // the uses of an export of a std module are renamed, and a package module gets no
  // fix.
  const scope = checker.current
  const alias = importDecl.alias
  const isEnum = isDeclaredEnum(checker, alias)
  let stdModule: Option<StdModule> = None
  if (checker.registry.modules[importDecl.path] is Some(found)) {
    stdModule = Some(found)
  }
  if (
    aliasTaken(checker, suggestion) ||
      checker.scopes[scope].modules[suggestion] is Some(_) ||
      file.facts.inTemplate[alias] is Some(_) ||
      (isEnum && stdModule is None)
  ) {
    return []
  }
  const length = Str.charCount(alias)
  let edits = [createEdit(importDecl.aliasPos, moveColumn(importDecl.aliasPos, length), suggestion)]
  if (file.facts.dotUses[alias] is Some(dotUses)) {
    for (const dotUse of Arrays.values(dotUses)) {
      // Only the std functions of an enum's module are renamed.
      let isConstructor = false
      if (isEnum) {
        isConstructor = true
        if (stdModule is Some(module)) {
          isConstructor = module.functions[dotUse.member] is None
        }
      }
      if (isConstructor) {
        continue
      }
      Arrays.push(mutable edits, createEdit(dotUse.pos, moveColumn(dotUse.pos, length), suggestion))
    }
  }
  return copy([createFix(`rename the alias to ${suggestion}`, edits)])
}

function isDeclaredEnum(checker: Checker, name: string): bool {
  const scope = checker.current
  if (checker.scopes[scope].types[name] is Some(Type.TEnum(_))) {
    return true
  }
  if (checker.scopes[scope].generics[name] is Some(generic)) {
    return !checker.generics[generic].isStruct
  }
  return false
}

export function checkImportNames(mutable checker: Checker, file: File) uses alloc {
  // Runs after the module's type names are declared.
  // An alias may not be a type name.
  for (const importDecl of Arrays.values(file.imports)) {
    if (importDecl.alias == "" || !aliasTaken(checker, importDecl.alias)) {
      continue
    }
    const suggestion = suggestAlias(importDecl.alias, importDecl.path)
    const renameFixes = buildRenameAliasFix(checker, file, importDecl, suggestion)
    reportErrorFix(
      mutable checker,
      importDecl.pos,
      "E0421",
      renameFixes,
      `the import alias ${importDecl.alias} is also a type name; rename it, for example \`import * as ${suggestion} from ${quoteGo(importDecl.path)}\``,
    )
  }

  // An imported name may not clash with the module's functions, constants,
  // aliases or types.
  let declared: Map<string, bool> = Map {}
  for (const declaration of Arrays.values(file.declarations)) {
    if (declaration is Decl.Func(funcDecl)) {
      declared[funcDecl.name] = true
    }
  }
  const scope = checker.current
  for (const importDecl of Arrays.values(file.imports)) {
    const packageScope = sourceScope(checker, importDecl.path)
    const extension = extensionScope(checker, importDecl.path)
    for (const name of Arrays.values(importDecl.names)) {
      // A name from the Narra part of a builtin module is checked like a package name.
      let moduleScope = packageScope
      if (extension >= 0 && checker.scopes[extension].exports[name.name] is Some(_)) {
        moduleScope = extension
      }
      const isAlias = checker.scopes[scope].modules[name.local] is Some(_)
      if (moduleScope >= 0) {
        // A type or trait import is itself in the type table, and the
        // The import reports a function or constant that clashes with a
        // declaration. A function can still clash with a type declared
        // later or with an alias.
        if (!isExportedFunc(checker, moduleScope, name.name)) {
          continue
        }
        if (isAlias || aliasTaken(checker, name.local)) {
          reportError(
            mutable checker,
            importDecl.pos,
            "E0423",
            `imported name ${quoteGo(name.local)} is already declared in this module; rename the import with \`as\``,
          )
        }
        continue
      }
      const isConst = checker.scopes[scope].consts[name.local] is Some(_)
      if (
        declared[name.local] is Some(_) || isConst || isAlias || aliasTaken(checker, name.local)
      ) {
        reportError(
          mutable checker,
          importDecl.pos,
          "E0423",
          `imported name ${quoteGo(name.local)} is already declared in this module; rename the import with \`as\``,
        )
      }
    }
  }
}

function isExportedFunc(checker: Checker, moduleScope: int, name: string): bool {
  if (checker.scopes[moduleScope].exports[name] is Some(index)) {
    return checker.scopes[moduleScope].declarations[index] is Decl.Func(_)
  }
  return false
}
