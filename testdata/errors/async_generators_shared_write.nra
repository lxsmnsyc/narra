// error: values[0] = ... may change values, which stream still uses at line 14; take a copy where it is shared, with copy(...)
import * as Async from "std/async"

async function* items(values: Array<int>): AsyncGenerator<int> {
  for (const value of values) {
    yield value
  }
}

export async function run(_args: Array<string>): int {
  let values = [1, 2]
  const stream = items(values)
  values[0] = 5
  const first = await Async.next(stream)
  if (first is Some(value)) {
    return value
  }
  return 0
}
