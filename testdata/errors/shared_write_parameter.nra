// error: list[0] = ... may change list, which items still holds for the caller
function firstDoubled(items: Array<int>): int {
  let list = items
  // The caller still holds items, so the write copies it.
  list[0] = list[0] * 2
  return list[0]
}

export function run(_args: Array<string>): int uses alloc {
  return firstDoubled([1, 2])
}
