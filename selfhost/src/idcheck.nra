// The node id walker: it visits every node that carries an id (every Expr,
// Pattern and Param, every VarStmt and ForStmt) of a parsed file and checks
// that the ids are unique and lie in the file's range [firstId, endId).
// `narrac pkg --ids <path>` runs it on every module after modules.checkIds.
//
// When the AST gains a node type or a child slot, add it to this walker
// too, or its ids go unchecked.
import * as Int from "std/int"
import { File, Decl, FuncDecl, FieldDecl, Block, Stmt, Expr, Pattern, Param, MatchArm } from "narrac/ast"
import * as Arrays from "std/array"

// collectIds returns the ids of a file's nodes in visiting order.
export function collectIds(f: File): Array<int> uses alloc {
  let ids: Array<int> = []
  for (const d of Arrays.values(f.decls)) {
    match (d) {
      Decl.Func(fd) => funcIds(mutable ids, fd)
      Decl.Const(cd) => exprIds(mutable ids, cd.value)
      Decl.Struct(sd) => fieldIds(mutable ids, sd.fields)
      Decl.Enum(ed) => {
        for (const v of Arrays.values(ed.variants)) {
          fieldIds(mutable ids, v.fields)
        }
      }
      Decl.Test(td) => blockIds(mutable ids, td.body)
      Decl.Trait(td) => {
        for (const fd of Arrays.values(td.funcs)) {
          funcIds(mutable ids, fd)
        }
      }
      Decl.Impl(id) => {
        for (const fd of Arrays.values(id.funcs)) {
          funcIds(mutable ids, fd)
        }
      }
      Decl.Distinct(_) => {}
    }
  }
  return ids
}

// checkIdList checks that ids are unique and in [first, end).
export function checkIdList(ids: Array<int>, first: int, end: int): Result<int, string> uses alloc {
  if (end < first) {
    return Err(`ids bad: range ${Int.toString(first)}..${Int.toString(end)}`)
  }
  let seen = Arrays.filled(false, end - first)
  for (const id of Arrays.values(ids)) {
    if (id < first || id >= end) {
      return Err(`ids bad: id ${Int.toString(id)} is outside ${Int.toString(first)}..${Int.toString(end)}`)
    }
    if (seen[id - first]) {
      return Err(`ids bad: id ${Int.toString(id)} is used twice`)
    }
    seen[id - first] = true
  }
  return Ok(Arrays.length(ids))
}

export function funcIds(mutable ids: Array<int>, fd: FuncDecl) uses alloc {
  paramIds(mutable ids, fd.params)
  if (fd.body is Some(b)) {
    blockIds(mutable ids, b)
  }
}

function paramIds(mutable ids: Array<int>, ps: Array<Param>) uses alloc {
  for (const p of Arrays.values(ps)) {
    Arrays.push(mutable ids, p.id)
  }
}

function fieldIds(mutable ids: Array<int>, fields: Array<FieldDecl>) uses alloc {
  for (const f of Arrays.values(fields)) {
    if (f.default is Some(e)) {
      exprIds(mutable ids, e)
    }
  }
}

export function blockIds(mutable ids: Array<int>, b: Block) uses alloc {
  for (const s of Arrays.values(b.stmts)) {
    stmtIds(mutable ids, s)
  }
}

function stmtIds(mutable ids: Array<int>, s: Stmt) uses alloc {
  match (s) {
    Stmt.BlockStmt(b) => blockIds(mutable ids, b)
    Stmt.VarStmt(id, _, _, _, pattern, _, value) => {
      Arrays.push(mutable ids, id)
      if (pattern is Some(p)) {
        patternIds(mutable ids, p)
      }
      exprIds(mutable ids, value)
    }
    Stmt.AssignStmt(_, target, value) => {
      exprIds(mutable ids, target)
      exprIds(mutable ids, value)
    }
    Stmt.ExprStmt(_, e) => exprIds(mutable ids, e)
    Stmt.ReturnStmt(_, value) => {
      if (value is Some(e)) {
        exprIds(mutable ids, e)
      }
    }
    Stmt.IfStmt(_, cond, then, orElse) => {
      exprIds(mutable ids, cond)
      blockIds(mutable ids, then)
      if (orElse is Some(e)) {
        stmtIds(mutable ids, e)
      }
    }
    Stmt.WhileStmt(_, cond, body) => {
      exprIds(mutable ids, cond)
      blockIds(mutable ids, body)
    }
    Stmt.ForStmt(id, _, _, iter, body) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, iter)
      blockIds(mutable ids, body)
    }
    Stmt.BreakStmt(_) => {}
    Stmt.ContinueStmt(_) => {}
  }
}

export function exprIds(mutable ids: Array<int>, e: Expr) uses alloc {
  match (e) {
    Expr.IntLit(id, _, _) => Arrays.push(mutable ids, id)
    Expr.FloatLit(id, _, _) => Arrays.push(mutable ids, id)
    Expr.StringLit(id, _, _, _) => Arrays.push(mutable ids, id)
    Expr.CharLit(id, _, _) => Arrays.push(mutable ids, id)
    Expr.BoolLit(id, _, _) => Arrays.push(mutable ids, id)
    Expr.TemplateLit(id, _, parts) => {
      Arrays.push(mutable ids, id)
      exprsIds(mutable ids, parts)
    }
    Expr.Ident(id, _, _) => Arrays.push(mutable ids, id)
    Expr.FieldExpr(id, _, target, _) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, target)
    }
    Expr.IsExpr(id, _, subject, pattern) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, subject)
      patternIds(mutable ids, pattern)
    }
    Expr.IndexExpr(id, _, target, index) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, target)
      exprIds(mutable ids, index)
    }
    Expr.MapLit(id, _, _, keys, vals) => {
      Arrays.push(mutable ids, id)
      exprsIds(mutable ids, keys)
      exprsIds(mutable ids, vals)
    }
    Expr.CallExpr(id, _, callee, args) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, callee)
      for (const a of Arrays.values(args)) {
        exprIds(mutable ids, a.value)
      }
    }
    Expr.UnaryExpr(id, _, _, operand) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, operand)
    }
    Expr.BinaryExpr(id, _, _, left, right) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, left)
      exprIds(mutable ids, right)
    }
    Expr.StructLit(id, _, _, _, fields, spread) => {
      Arrays.push(mutable ids, id)
      for (const f of Arrays.values(fields)) {
        exprIds(mutable ids, f.value)
      }
      if (spread is Some(s)) {
        exprIds(mutable ids, s)
      }
    }
    Expr.ArrayLit(id, _, elems, _) => {
      Arrays.push(mutable ids, id)
      exprsIds(mutable ids, elems)
    }
    Expr.MatchExpr(id, _, subject, arms) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, subject)
      for (const arm of Arrays.values(arms)) {
        armIds(mutable ids, arm)
      }
    }
    Expr.ArrowExpr(id, _, params, _, body, block) => {
      Arrays.push(mutable ids, id)
      paramIds(mutable ids, params)
      if (body is Some(b)) {
        exprIds(mutable ids, b)
      }
      if (block is Some(b)) {
        blockIds(mutable ids, b)
      }
    }
  }
}

function exprsIds(mutable ids: Array<int>, es: Array<Expr>) uses alloc {
  for (const e of Arrays.values(es)) {
    exprIds(mutable ids, e)
  }
}

function armIds(mutable ids: Array<int>, arm: MatchArm) uses alloc {
  patternIds(mutable ids, arm.pattern)
  if (arm.guard is Some(g)) {
    exprIds(mutable ids, g)
  }
  if (arm.body is Some(b)) {
    exprIds(mutable ids, b)
  }
  if (arm.block is Some(b)) {
    blockIds(mutable ids, b)
  }
}

function patternIds(mutable ids: Array<int>, p: Pattern) uses alloc {
  match (p) {
    Pattern.PatWildcard(id, _) => Arrays.push(mutable ids, id)
    Pattern.PatName(id, _, _) => Arrays.push(mutable ids, id)
    Pattern.PatCtor(id, _, _, _, args, _) => {
      Arrays.push(mutable ids, id)
      for (const a of Arrays.values(args)) {
        patternIds(mutable ids, a)
      }
    }
    Pattern.PatStruct(id, _, fields) => {
      Arrays.push(mutable ids, id)
      for (const f of Arrays.values(fields)) {
        patternIds(mutable ids, f.pattern)
      }
    }
    Pattern.PatTuple(id, _, args) => {
      Arrays.push(mutable ids, id)
      for (const a of Arrays.values(args)) {
        patternIds(mutable ids, a)
      }
    }
    Pattern.PatLit(id, _, lit) => {
      Arrays.push(mutable ids, id)
      exprIds(mutable ids, lit)
    }
  }
}
