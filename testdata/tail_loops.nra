// Self calls in tail position run as loops: 10 million of them do not
// grow the stack. Heap parameters keep correct counts, and calls that do
// more work after the call stay plain calls.
import * as Int from "std/int"
import * as Arrays from "std/array"

function count(n: int, acc: int): int {
  if (n == 0) {
    return acc
  }
  return count(n - 1, acc + 1)
}

// A string and an array parameter, replaced on every jump.
function fold(n: int, label: string, items: Array<int>): string {
  if (n == 0) {
    return `${label}:${Int.toString(Arrays.length(items))}`
  }
  const next = filledArray(n, 2)
  return fold(n - 1, `x${Int.toString(n % 3)}`, next)
}

// Swapped parameters.
function swap(n: int, a: string, b: string): string {
  if (n == 0) {
    return `${a}${b}`
  }
  return swap(n - 1, b, a)
}

// A parameter passed on as it is.
function search(items: Array<int>, begin: int, target: int): int {
  if (begin >= Arrays.length(items)) {
    return -1
  }
  if (items[begin] == target) {
    return begin
  }
  return search(items, begin + 1, target)
}

// A mutable parameter passed on as it is.
function fillTail(mutable out: Array<int>, n: int): int {
  if (n == 0) {
    return Arrays.length(out)
  }
  Arrays.push(mutable out, n)
  return fillTail(mutable out, n - 1)
}

// A tail call inside a loop body.
function find(items: Array<int>, target: int, tries: int): int {
  for (const x of Arrays.values(items)) {
    if (x == target) {
      if (tries < 3) {
        return find(items, target, tries + 1)
      }
      return tries
    }
  }
  return -1
}

enum Step {
  Go(k: int)
  Stop
}

// A returned match whose arm is the self call, with a heap parameter.
function retMatch(n: int, s: Step, label: string): string {
  if (n == 0) {
    return label
  }
  return match (s) {
    Step.Go(k) => retMatch(n - 1, Step.Go(k + 1), `m${Int.toString(k % 2)}`)
    Step.Stop => label
  }
}

// A void self call as the last statement, after an early return.
function voidRec(n: int, s: string, items: Array<int>) {
  if (n == 0) {
    print(`${s}:${Int.toString(Arrays.length(items))}`)
    return
  }
  voidRec(n - 1, `v${Int.toString(n % 2)}`, filledArray(n, 3))
}

// Void self calls at the end of an if/else branch and of match arms.
function voidBranches(n: int, s: Step, label: string) {
  if (n == 0) {
    print(label)
  } else if (n % 2 == 0) {
    voidBranches(n - 1, s, `e${Int.toString(n % 3)}`)
  } else {
    match (s) {
      Step.Go(k) => {
        voidBranches(n - 1, Step.Go(k + 1), label)
      }
      Step.Stop => voidBranches(n - 1, s, label)
    }
  }
}

// Not tail calls: more work follows the call.
function depth(n: int): int {
  if (n == 0) {
    return 0
  }
  return 1 + depth(n - 1)
}

export function run(args: Array<string>): int {
  print(Int.toString(count(10000000, 0)))
  print(fold(10000000, "begin", [1, 2, 3]))
  print(swap(10000001, "a", "b"))
  print(Int.toString(search([4, 5, 6, 7], 0, 6)))
  print(Int.toString(search([4, 5, 6, 7], 0, 9)))
  let out: Array<int> = []
  print(Int.toString(fillTail(mutable out, 1000)))
  print(Int.toString(find([4, 5], 5, 0)))
  print(retMatch(1000000, Step.Go(0), "start"))
  print(retMatch(5, Step.Stop, "stopped"))
  voidRec(1000000, "void", [1])
  voidBranches(1000000, Step.Go(0), "branches")
  voidBranches(1000000, Step.Stop, "stop")
  print(Int.toString(depth(1000)))
  return 0
}

function filledArray<T>(value: T, count: int): Array<T> uses alloc {
  return match (Arrays.filled(value, count)) { Some(items) => items, None => [] }
}
