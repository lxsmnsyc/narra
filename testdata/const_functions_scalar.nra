// An @const function whose result is a scalar: the constant is written at each
// use. The same functions also run at run time, through a local argument.
import * as Int from "std/int"

@const
function square(value: int): int {
  return value * value
}

@const
function isLarge(value: int): bool {
  return square(value) > 100
}

@const
function sumTo(count: int, total: int): int {
  // A self-call in tail position runs as a loop, so it does not count toward the depth.
  if (count == 0) {
    return total
  }
  return sumTo(count - 1, total + count)
}

@const
function narrow(start: i8): i8 {
  // i8 wraps at its own width: 100 + 100 is -56.
  let small = start
  small += 100
  return small
}

const AREA = square(4)
const LARGE = isLarge(11)
const SUM = sumTo(5000, 0)
const WRAPPED = narrow(100)
const DOUBLED = AREA * 2

export function run(args: Array<string>): int uses io, alloc {
  const four = 4
  const eleven = 11
  const many = 5000
  const hundred: i8 = 100
  print(`${Int.toString(AREA)} ${Int.toString(square(four))}`)
  print(`${LARGE ? "large" : "small"} ${isLarge(eleven) ? "large" : "small"}`)
  print(`${Int.toString(SUM)} ${Int.toString(sumTo(many, 0))}`)
  print(`${Int.toString(Int.from(WRAPPED))} ${Int.toString(Int.from(narrow(hundred)))}`)
  print(Int.toString(DOUBLED))
  return 0
}
