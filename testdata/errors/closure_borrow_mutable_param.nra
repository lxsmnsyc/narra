// error: closure_borrow_mutable_param.nra:3:16: a closure cannot capture mutable parameter "n" unless it is passed straight to a function parameter that is not escaping; copy it first with `const copy = n`
function bump(mutable n: int): () => int {
  return () => n
}

export function run(args: Array<string>): int {
  let x = 1
  return bump(mutable x)()
}
