// warning: the arrow function at line 14, which changes totals, may change totals, which saved still uses at line 18
function each(items: Array<int>, visit: (item: int) => void) {
  for (const item of items) {
    visit(item)
  }
}

export function run(_args: Array<string>): int uses alloc {
  const totals = [0]
  const saved = totals
  // The arrow function changes the captured totals where it is passed to each.
  each(
    [1, 2],
    (item: int) => {
      totals[0] = totals[0] + item
    },
  )
  return totals[0] + saved[0]
}
