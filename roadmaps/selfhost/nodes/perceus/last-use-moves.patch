--- /dev/null
+++ b/testdata/perceus_moves.nra
@@ -0,0 +1,146 @@
+// A local whose last use takes it over moves there: no retain at the use and
+// no release when its scope ends. Each case has a path where a wrong move
+// would free the value early, free it twice, or leak it.
+import * as Int from "std/int"
+import * as Str from "std/string"
+import * as Arrays from "std/array"
+
+struct Pair {
+  left: string
+  right: string
+}
+
+enum Tree {
+  Leaf(text: string)
+  Branch(left: Tree, right: Tree)
+}
+
+function make(text: string): string {
+  return Str.repeat(text, 2)
+}
+
+function wrap(text: string): Pair {
+  // `text` is a parameter: it is borrowed and never moves.
+  const left = make(text)
+  const right = make(left)
+  return Pair { left: left, right: right }
+}
+
+function collect(count: int, stopAt: int): Array<string> {
+  let out: Array<string> = []
+  // A local from outside the loop is read on every iteration.
+  const shared = make("s")
+  for (let i = 0; i < count; i++) {
+    // A local of the loop body moves each iteration.
+    const item = make(Int.toString(i))
+    if (i == stopAt) {
+      // An early exit before the move releases it.
+      break
+    }
+    Arrays.push(mutable out, item)
+    Arrays.push(mutable out, shared)
+  }
+  return out
+}
+
+function firstOrEmpty(flag: bool): string {
+  const value = make("v")
+  if (flag) {
+    // The early return releases value; the later move does not happen.
+    return "early"
+  }
+  return value
+}
+
+function pick(flag: bool): string {
+  // Moved on one branch only: the other branch still releases it.
+  const value = make("p")
+  if (flag) {
+    return value
+  }
+  print(value)
+  return "other"
+}
+
+function grow(list: Array<string>, item: string): Array<string> {
+  let copy = list
+  Arrays.push(mutable copy, item)
+  return copy
+}
+
+function build(depth: int): Tree {
+  if (depth == 0) {
+    return Tree.Leaf(make(Int.toString(depth)))
+  }
+  const left = build(depth - 1)
+  const right = build(depth - 1)
+  return Tree.Branch(left, right)
+}
+
+function count(tree: Tree): int {
+  return match (tree) { Tree.Leaf(_) => 1, Tree.Branch(left, right) => count(left) + count(right) }
+}
+
+function sum(items: Array<string>, index: int, total: int): int {
+  if (index == Arrays.length(items)) {
+    return total
+  }
+  // A local passed to a self tail call.
+  const next = items[index]
+  return sum(items, index + 1, total + Str.length(next))
+}
+
+export function run(args: Array<string>): int {
+  const pair = wrap("w")
+  print(`${pair.left} ${pair.right}`)
+  print(Str.join(collect(4, 9), ","))
+  print(Str.join(collect(4, 2), ","))
+  print(firstOrEmpty(true))
+  print(firstOrEmpty(false))
+  print(pick(true))
+  print(pick(false))
+
+  // A local that a later statement reads is not moved before it.
+  const text = make("t")
+  const both = Pair { left: text, right: text }
+  print(`${both.left}/${both.right}/${text}`)
+
+  // The value and the target of an assignment name the same local.
+  let list: Array<string> = []
+  list = grow(list, make("g"))
+  list = grow(list, make("h"))
+  print(Str.join(list, ","))
+
+  // A short-circuit right side runs on some paths only.
+  const maybe = make("m")
+  if (Arrays.length(list) > 5 && Str.length(maybe) > 0) {
+    print("never")
+  }
+
+  // A local captured by a closure is never moved.
+  const captured = make("c")
+  const read = () => captured
+  print(read())
+
+  // Moves inside a loop body that breaks, and into a returned block value.
+  let rounds = 0
+  while (true) {
+    const piece = make(Int.toString(rounds))
+    rounds++
+    if (rounds > 2) {
+      const last = Pair { left: piece, right: "end" }
+      print(last.left)
+      break
+    }
+    Arrays.push(mutable list, piece)
+  }
+  print(Str.join(list, ","))
+
+  // Destructuring and nested constructors take moved locals.
+  const whole = Pair { left: make("l"), right: make("r") }
+  const { left, right } = whole
+  print(`${left}${right}`)
+  print(Int.toString(count(build(4))))
+  print(Int.toString(sum(collect(5, 9), 0, 0)))
+  return 0
+}
