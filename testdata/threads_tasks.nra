// A thread function starts a task that sleeps on the thread's own event loop.
// When the function returns, the thread runs the loop's exit (D109 item 6):
// the sleep is cancelled and the task runs to its end before join gives the
// result, so the task's lines come before the join's.
import * as Thread from "std/thread"
import * as Async from "std/async"
import { AsyncError } from "std/async"
import * as AsyncTime from "std/async/time"
import * as Int from "std/int"
import * as Time from "std/time"

async function sleepThenSay(label: string): int uses io, alloc {
  print(`${label}: task started`)
  const slept = await AsyncTime.sleep(Time.seconds(3600))
  if (slept is Err(AsyncError.Cancelled)) {
    print(`${label}: sleep cancelled when the thread function returned`)
    return 1
  }
  print(`${label}: woke`)
  return 0
}

function work(label: string): int uses io, alloc {
  Async.detach(sleepThenSay(label))
  print(`${label}: thread function returns`)
  return 7
}

export function run(_args: Array<string>): int {
  const result = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => work("worker"))
    return Thread.join(worker)
  })
  print(`joined ${Int.toString(result)}`)
  return 0
}
