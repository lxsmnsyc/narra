// The registry rows and emitters of std/process.
import { StdFunc } from "narrac/std/builtins"
import { Type } from "narrac/check/types"
import { Arg } from "narrac/syntax/ast"
import { getExpressionId } from "narrac/check/check"
import { cachedCType } from "narrac/emit/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  temp,
  readNodeType,
} from "narrac/emit/emitstate"
import {
  NODE,
  plain,
  argumentText,
  stringOut,
  findVariant,
  variantFieldType,
  ioResult,
} from "narrac/std/stdemithelp"

export const INTERNAL_PROCESS_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Spawn.run",
    module: "std/internal/process",
    key: "run",
    parameters: [
      "string",
      "Array<string>",
      "string",
      "bool",
      "Array<string>",
      "Array<string>",
      "string",
      "bool",
    ],
    result: "Result<#[int, string, string], string>",
    effects: ["io", "alloc"],
  },
]

export const PROCESS_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Process.cwd",
    module: "std/process",
    key: "cwd",
    parameters: [],
    parameterNames: [],
    result: "Result<string, string>",
    effects: ["io", "alloc"],
    check: "fixed",
    doc: "Gives the absolute path of the working folder.",
  },
  StdFunc {
    name: "Process.exit",
    module: "std/process",
    key: "exit",
    parameters: ["int"],
    parameterNames: ["code"],
    result: "void",
    effects: ["io"],
    check: "fixed",
    doc: "Ends the program at once with the exit code, after it writes out buffered output.",
  },
]

function emitSpawnRun<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = copy(readNodeType(emitter, nodeId))
  const okVariant = findVariant(emitter, resultType, "Ok")
  const tupleType = copy(variantFieldType(emitter, resultType, okVariant))

  // The arguments are evaluated in order; each array is held in a temporary.
  const command = argumentText(walker, mutable emitter, arguments, 0)
  const argumentsType = copy(readNodeType(emitter, getExpressionId(arguments[1].value)))
  const argumentsValue = argumentText(walker, mutable emitter, arguments, 1)
  const list = temp(mutable emitter, argumentsType, argumentsValue)
  const input = argumentText(walker, mutable emitter, arguments, 2)
  const hasInput = argumentText(walker, mutable emitter, arguments, 3)
  const addedType = copy(readNodeType(emitter, getExpressionId(arguments[4].value)))
  const addedValue = argumentText(walker, mutable emitter, arguments, 4)
  const added = temp(mutable emitter, addedType, addedValue)
  const removedType = copy(readNodeType(emitter, getExpressionId(arguments[5].value)))
  const removedValue = argumentText(walker, mutable emitter, arguments, 5)
  const removed = temp(mutable emitter, removedType, removedValue)
  const folder = argumentText(walker, mutable emitter, arguments, 6)
  const inherit = argumentText(walker, mutable emitter, arguments, 7)

  // The runtime fills the out parameters; a failure leaves a message in bad.
  const code = temp(mutable emitter, Type.TInt, "0")
  const output = stringOut(mutable emitter)
  const errorOutput = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const runCall = `narra_proc_run(${command}, ${list}->items, ${list}->len, ${input}, ${hasInput}, ${added}->items, ${added}->len, ${removed}->items, ${removed}->len, ${folder}, ${inherit}, &${code}, &${output}, &${errorOutput}, &${bad})`
  const success = temp(mutable emitter, Type.TBool, runCall)
  const tupleName = cachedCType(emitter.checker, emitter.typeNames, tupleType)
  const value = `((${tupleName}){.f_0 = ${code}, .f_1 = ${output}, .f_2 = ${errorOutput}})`
  return ioResult(mutable emitter, resultType, success, value, bad)
}

function emitProcessCwd(mutable emitter: Emitter, nodeId: int): Code uses alloc {
  const resultType = copy(readNodeType(emitter, nodeId))
  const output = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const success = temp(mutable emitter, Type.TBool, `narra_proc_cwd(&${output}, &${bad})`)
  return ioResult(mutable emitter, resultType, success, output, bad)
}

function emitProcessExit<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
): Code uses alloc {
  const code = argumentText(walker, mutable emitter, arguments, 0)
  // Flush pending output, then leave without releasing live values or running the leak check.
  return plain(`(fflush(NULL), _exit((int)(${code})))`)
}

export function emitProcessCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "Spawn.run") {
    return emitSpawnRun(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Process.cwd") {
    return emitProcessCwd(mutable emitter, nodeId)
  }
  if (name == "Process.exit") {
    return emitProcessExit(walker, mutable emitter, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
