// error: "N" is already declared in this function; shadowing is not allowed
function hidden<const N: int>(value: int): int {
  const N = 2
  return value / N
}

function named<const M: int>(M: int): int {
  return M
}

export function run(_args: Array<string>): int {
  return hidden<0>(10) + named<1>(2)
}
