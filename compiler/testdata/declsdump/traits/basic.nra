// A trait, a type that implements it, derives, and bounded functions.
trait Area {
  function area(shape: Self): int
  function scale(mutable shape: Self, by: int)
}

struct Rect implements Area, Equatable {
  w: int
  h: int
}

implement Area for Rect {
  function area(shape: Rect): int {
    return shape.w * shape.h
  }
  function scale(mutable shape: Rect, by: int) {
    shape.w = shape.w * by
  }
}

implement Equatable for Rect {
  function equals(a: Rect, b: Rect): bool {
    return a.w == b.w
  }
}

enum Color derives Show, Ordered {
  Red
  Green
}

struct Pair<A, B> derives Show {
  first: A
  second: B
}

function total<T: Area>(items: Array<T>): int {
  return 0
}

function both<T: Equatable & Hashable, U: Show>(a: T, b: U): string {
  return "x"
}
