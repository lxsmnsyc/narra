<script>
  import { $bind, $client, $props, $signal } from 'brumate/signals';
  import Icon from './Icon.brm';
  import { addCopyButtons, followHeadings } from '../docs/enhance.ts';
  import { chapters, packagePages, referencePages } from '../pages.ts';
  import type { Page } from '../pages.ts';
  import { startTwoslash } from '../twoslash/client.ts';
  import Meta from './Meta.brm';

  // A document of the site: a sidebar with the chapters of the guide when `slug` names one, or
  // with the reference pages on a reference page; the page, its outline, and the links to the
  // chapters before and after it.
  const { page, path, slug } = $props<{ page: Page; path: string; slug?: string }>();
  function findIndex(): number {
    for (const [at, chapter] of chapters.entries()) {
      if (chapter.slug === slug) {
        return at;
      }
    }
    return -1;
  }
  const index = findIndex();
  const previous = index > 0 ? chapters[index - 1] : undefined;
  const next = index !== -1 ? chapters[index + 1] : undefined;
  // The spec is listed with the reference, so it shares the reference's sidebar.
  const isReference = path === 'spec' || path === 'reference' || path.startsWith('reference/');
  const isPackages = path === 'packages' || path.startsWith('packages/');
  const hasSidebar = slug !== undefined || isReference || isPackages;
  const REFERENCE_LINKS = [
    { label: 'Overview', path: 'reference' },
    { label: 'Commands', path: 'reference/commands' },
    { label: 'narra.toml', path: 'reference/narra-toml' },
    { label: 'Errors', path: 'reference/errors' },
    { label: 'Spec', path: 'spec' },
  ];
  // The std modules, as `std/option`, in the order of their names.
  const modules: { label: string; path: string }[] = [];
  for (const entry of referencePages) {
    if (entry.slug.startsWith('std/')) {
      modules.push({ label: entry.slug, path: `reference/${entry.slug}` });
    }
  }
  const inStd = path === 'reference/std' || path.startsWith('reference/std/');
  // `SPEC.md` has a heading for each rule, so its outline shows the sections only.
  const outline: Page['headings'] = [];
  for (const heading of page.headings) {
    if (heading.level === 2 || (heading.level === 3 && path !== 'spec')) {
      outline.push(heading);
    }
  }
  // A chapter's title is written as `6. Option and Result`; the page shows the number apart.
  const chapterMatch = /^(\d+)\.\s+(.*)$/.exec(page.title);
  const chapterNumber = index !== -1 && chapterMatch ? chapterMatch[1] : undefined;
  const heading = chapterNumber && chapterMatch ? chapterMatch[2] : page.title;
  const kicker = chapterNumber ? `Chapter ${chapterNumber}` : path === 'spec' || path.startsWith('reference') ? 'Reference' : isPackages ? 'Packages' : path === 'install' ? 'Get started' : 'Guide';

  let article = $signal<HTMLElement>();
  let toc = $signal<HTMLElement>();
  let sidebar = $signal<HTMLElement>();

  $client(() => {
    // A long sidebar scrolls on its own; it opens with the current page in view.
    const current = sidebar?.querySelector<HTMLElement>('[aria-current="page"]');
    if (sidebar && current && current.offsetTop + current.offsetHeight > sidebar.clientHeight) {
      sidebar.scrollTop = current.offsetTop - sidebar.clientHeight / 2;
    }
    if (!article) {
      return;
    }
    addCopyButtons(article);
    startTwoslash();
    if (toc) {
      return followHeadings(article, toc);
    }
    return undefined;
  }, 'load');

  const title = page.title === 'The Narra guide' ? 'Guide | Narra' : `${page.title} | Narra`;
</script>

<Meta {title} description=page.description {path} />
<div class="progress" aria-hidden="true"></div>
<div class={ docs: true, 'no-sidebar': !hasSidebar }>
  #if (hasSidebar) {
    <details class="menu">
      <summary>
        {isReference ? 'Reference' : isPackages ? 'Packages' : 'Chapters'}
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
    </details>
    #if (isReference) {
      <nav class="sidebar" aria-label="Reference" ref=$bind(sidebar)>
        <p class="sidebar-title">Reference</p>
        #for (link of REFERENCE_LINKS by link.path) {
          <a href=(`/${link.path}`) aria-current=(link.path === path ? 'page' : undefined)>{link.label}</a>
        }
        <details class="sidebar-group" open=inStd>
          <summary class="sidebar-toggle">
            Standard library
            <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </summary>
          <a href="/reference/std" aria-current=(path === 'reference/std' ? 'page' : undefined)>Overview</a>
          #for (module of modules by module.path) {
            <a class="sidebar-module" href=(`/${module.path}`) aria-current=(module.path === path ? 'page' : undefined)>{module.label}</a>
          }
        </details>
      </nav>
    } #else if (isPackages) {
      <nav class="sidebar" aria-label="Packages" ref=$bind(sidebar)>
        <p class="sidebar-title">Packages</p>
        <a href="/packages" aria-current=(path === 'packages' ? 'page' : undefined)>Overview</a>
        #for (entry of packagePages by entry.slug) {
          <a href=(`/packages/${entry.slug}`) aria-current=(`packages/${entry.slug}` === path ? 'page' : undefined)>{entry.slug}</a>
        }
      </nav>
    } #else {
      <nav class="sidebar" aria-label="Chapters" ref=$bind(sidebar)>
        <p class="sidebar-title">Guide</p>
        <a href="/guide" aria-current=(slug === '' ? 'page' : undefined)>Overview</a>
        #for (chapter, position of chapters by chapter.slug) {
          <a href=(`/guide/${chapter.slug}`) aria-current=(chapter.slug === slug ? 'page' : undefined)>
            <span class="sidebar-number">{String(position + 1).padStart(2, '0')}</span>
            <span>{chapter.title.replace(/^(\d+)\.\s+/, '')}</span>
          </a>
        }
      </nav>
    }
  }
  <article class="prose" ref=$bind(article)>
    <header class="doc-head">
      <p class="doc-kicker">{kicker}</p>
      <h1 class="doc-title">{heading}</h1>
    </header>
    <div class="doc-body">{page.html}</div>
    #if (path === 'packages') {
      <ul class="package-list">
        #for (entry of packagePages by entry.slug) {
          <li><a href=(`/packages/${entry.slug}`)><code>{entry.slug}</code></a>: {entry.description}</li>
        }
      </ul>
    }
    #if (previous || next) {
      <nav class="pager" aria-label="Chapters">
        #if (previous) {
          <a class="previous" href=(`/guide/${previous.slug}`)>
            <small><span class="pager-icon"><Icon name="arrow-left" size=(14) /></span>Previous</small>
            <span>{previous.title}</span>
          </a>
        }
        #if (next) {
          <a class="next" href=(`/guide/${next.slug}`)>
            <small>Next<span class="pager-icon"><Icon name="arrow-right" size=(14) /></span></small>
            <span>{next.title}</span>
          </a>
        }
      </nav>
    }
  </article>
  <nav class="toc" aria-label="On this page" ref=$bind(toc)>
    #if (outline.length > 0) {
      <p class="toc-title">On this page</p>
      <span class="toc-indicator" aria-hidden="true"></span>
      #for (heading of outline by heading.id) {
        <a href=(`#${heading.id}`) class={ 'level-3': heading.level === 3 }>{heading.text}</a>
      }
    }
  </nav>
</div>
