// A call result whose type names the callee's effect variable gets the
// effects of the argument that binds it.
export function* noisy(): Generator<int> uses io {
  print("noisy")
  yield 1
}

export function* pure(): Generator<int> {
  yield 2
}

export function* relay<effect E>(source: Generator<int> uses E): Generator<int> uses E, alloc {
  yield* source
}

export function total<effect E>(numbers: Generator<int> uses E): int uses E {
  let sum = 0
  for (const n of numbers) {
    sum = sum + n
  }
  return sum
}

// Inside a function with its own E, the result of relay(numbers) has that E.
export function again<effect E>(numbers: Generator<int> uses E): int uses E, alloc {
  return total(relay(numbers))
}

export function quiet(): int uses alloc {
  const relayed = relay(pure())
  return total(relayed) + again(pure())
}

export function loud(): int uses io, alloc {
  return total(relay(noisy())) + again(noisy())
}

export function run(args: Array<string>): int {
  return quiet() + loud()
}
