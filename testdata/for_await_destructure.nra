// The destructuring heads of `for ... of` work in `for await`: a tuple, a
// struct and an enum variant per value of the stream.
import * as Async from "std/async"
import * as Int from "std/int"

struct Point {
  x: int
  y: int
}

enum Shape {
  Square(side: int)
}

async function* pairs(names: Array<string>): AsyncGenerator<#[int, string]> uses alloc {
  let index = 0
  for (const name of names) {
    await Async.idle()
    yield #[index, name]
    index += 1
  }
}

async function* points(count: int): AsyncGenerator<Point> uses alloc {
  for (let step = 1; step <= count; step++) {
    await Async.idle()
    yield Point { x: step, y: step * step }
  }
}

async function* squares(): AsyncGenerator<Shape> uses alloc {
  yield Shape.Square(2)
  await Async.idle()
  yield Shape.Square(5)
}

export async function run(_args: Array<string>): int {
  for await (const #[index, name] of pairs(["ada", "grace", "edsger"])) {
    print(`${Int.toString(index)}: ${name}`)
  }
  for await (const { x, y } of points(3)) {
    print(`point ${Int.toString(x)} ${Int.toString(y)}`)
  }
  for await (const Shape.Square(side) of squares()) {
    print(`square of side ${Int.toString(side)}`)
  }
  return 0
}
