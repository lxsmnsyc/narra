// error: divisor_wraps_i32.nra:5:18: the divisor must be a non-zero constant or a name checked against zero first; this constant is zero
const WRAPS: i32 = 65536 * 65536

function share(total: i32): i32 {
  return total / WRAPS
}

export function run(args: Array<string>): int {
  share(10)
  return 0
}
