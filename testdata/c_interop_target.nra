// `@target` before an extern block: its functions exist, and its library is
// linked, only on that target. The Windows block names a library that does not
// exist here; it is used only in a branch that guarantees Windows, so it is
// neither declared nor linked on macOS and Linux.
import * as Float from "std/float"
import * as U64 from "std/u64"
import * as Build from "std/build"
import { Os } from "std/build"

@target(os = Os.Windows)
extern {
  function narraMissingTicks(): u64
  function narraMissingReset()
} from "narra_no_such_library"

extern {
  function sqrt(value: f64): f64
} from "m"

@target(os = Os.Windows)
function readTicks(): u64 uses unsafe {
  unsafe {
    narraMissingReset()
    return narraMissingTicks()
  }
}

export function run(_args: Array<string>): int uses unsafe {
  unsafe {
    print(Float.toString(sqrt(9.0)))
  }
  if (Build.os == Os.Windows) {
    unsafe {
      print(U64.toString(readTicks()))
    }
  }
  return 0
}
