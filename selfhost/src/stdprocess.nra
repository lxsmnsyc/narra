// The registry rows and emitters of std/process.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Arg } from "narrac/ast"
import { getExpressionId } from "narrac/check"
import { cachedCType } from "narrac/cnames"
import { Emitter, Code, EmitWalker, reportUnsupported, temp, readNodeType } from "narrac/emitstate"
import {
  NODE,
  plain,
  argumentText,
  stringOut,
  findVariant,
  variantFieldType,
  ioResult,
} from "narrac/stdemithelp"

export const PROCESS_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Process.run",
    module: "std/process",
    key: "run",
    parameters: ["string", "Array<string>"],
    result: "Result<#[int, string, string], string>",
    effects: ["io", "alloc"],
    check: "fixed",
  },
]

function emitProcessRun<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const okVariant = findVariant(emitter, resultType, "Ok")
  const tupleType = variantFieldType(emitter, resultType, okVariant)
  const command = argumentText(walker, mutable emitter, arguments, 0)
  const argumentsType = readNodeType(emitter, getExpressionId(arguments[1].value))
  const argumentsValue = argumentText(walker, mutable emitter, arguments, 1)
  const list = temp(mutable emitter, argumentsType, argumentsValue)
  const code = temp(mutable emitter, Type.TInt, "0")
  const output = stringOut(mutable emitter)
  const errorOutput = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const runCall = `narra_proc_run(${command}, ${list}->items, ${list}->len, &${code}, &${output}, &${errorOutput}, &${bad})`
  const success = temp(mutable emitter, Type.TBool, runCall)
  const tupleName = cachedCType(emitter.checker, emitter.typeNames, tupleType)
  const value = `((${tupleName}){.f_0 = ${code}, .f_1 = ${output}, .f_2 = ${errorOutput}})`
  return ioResult(mutable emitter, resultType, success, value, bad)
}

export function emitProcessCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "Process.run") {
    return emitProcessRun(walker, mutable emitter, nodeId, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
