// error: block_expressions_mutable_arg.nra:14:5: "xs" is passed as mutable in this call, so no other argument can use it
import * as Arrays from "std/array"
import * as Int from "std/int"

function addAll(mutable items: Array<int>, extra: int): int {
  Arrays.push(mutable items, extra)
  return Arrays.length(items)
}

export function run(args: Array<string>): int {
  let xs = [1, 2]
  const total = addAll(
    mutable xs,
    {
      Arrays.push(mutable xs, 3)
      return Arrays.length(xs)
    },
  )
  print(Int.toString(total))
  return 0
}
