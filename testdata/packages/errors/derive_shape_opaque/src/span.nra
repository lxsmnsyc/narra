import * as Json from "std/json"

export opaque struct Span derives Shape {
  start: int
  finish: int
}

export function create(start: int, finish: int): Span {
  return Span { start: start, finish: finish }
}

// The declaring module may use the derived Shape.
export function save(span: Span): string uses alloc {
  return Json.encode(span)
}
