// Writes through /dev/stdout and /dev/stderr. WASI has no /dev, so the runtime
// sends those two paths to descriptors 1 and 2.
import * as Fs from "std/fs"

export function run(_args: Array<string>): int uses io, alloc {
  const out = Fs.writeText("/dev/stdout", "to stdout\n")
  if (out is Err(message)) {
    print(message)
    return 1
  }
  const error = Fs.writeText("/dev/stderr", "to stderr\n")
  if (error is Err(message)) {
    print(message)
    return 1
  }
  return 0
}
