// error: for await is allowed only in an async function, an async arrow, an async block or an async generator, not outside an async body
import * as Int from "std/int"

async function* numbers(): AsyncGenerator<int> {
  yield 1
}

function plain(): int uses alloc {
  let total = 0
  for await (const value of numbers()) {
    total += value
  }
  return total
}

function* values(): Generator<int> uses alloc {
  for await (const value of numbers()) {
    yield value
  }
}

async function inArrow(): int uses alloc {
  const sum = (): int => {
    let total = 0
    for await (const value of numbers()) {
      total += value
    }
    return total
  }
  return sum()
}

export function main() {
  print(`${Int.toString(plain())}`)
}
