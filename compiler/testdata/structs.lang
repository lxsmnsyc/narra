import * as Int from "std/int"

struct Vec2 {
  x: int
  y: int
}

struct Player {
  name: string
  hp: int = 100
  position: Vec2
  tags: Array<string> = []
}

function damage(mutable player: Player, amount: int) {
  player.hp = player.hp - amount
}

function describe(p: Player): string {
  return `${p.name} has ${Int.toString(p.hp)} hp at ${Int.toString(p.position.x)},${Int.toString(p.position.y)}`
}

export function run(args: Array<string>): int {
  let hero = Player { name: "Ana", position: Vec2 { x: 1, y: 2 } }
  const before = hero
  damage(mutable hero, 10)
  hero.position.x = 5
  Array.push(mutable hero.tags, "brave")
  print(describe(hero))
  print(describe(before))
  print(Int.toString(Array.length(hero.tags)))
  print(Int.toString(Array.length(before.tags)))
  const origin: Vec2 = { x: 0, y: 0 }
  print(Int.toString(origin.x + origin.y))
  return 0
}
