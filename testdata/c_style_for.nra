import * as Int from "std/int"

function countUp(limit: int): int {
  let total = 0
  for (let i = 0; i < limit; i = i + 1) {
    total = total + i
  }
  return total
}

function firstSquareOver(limit: int): int {
  let result = 0
  for (let n = 1; ; n = n + 1) {
    if (n * n > limit) {
      result = n
      break
    }
  }
  return result
}

function sumOdd(limit: int): int {
  let total = 0
  for (let i = 0; i < limit; i = i + 1) {
    if (i % 2 == 0) {
      continue
    }
    total = total + i
  }
  return total
}

function endless(): int {
  let count = 0
  for (;;) {
    count = count + 1
    if (count == 5) {
      break
    }
  }
  return count
}

function pairs(limit: int): int {
  let found = 0
  outer: for (let i = 0; i < limit; i = i + 1) {
    for (let j = 0; j < limit; j = j + 1) {
      if (j > i) {
        continue outer
      }
      if (i + j > 6) {
        break outer
      }
      found = found + 1
    }
  }
  return found
}

function reuseName(): int {
  let total = 0
  for (let i = 0; i < 3; i = i + 1) {
    total = total + i
  }
  for (let i = 10; i > 7; i = i - 1) {
    total = total + i
  }
  const i = 100
  return total + i
}

function heapLocals(limit: int): string {
  let text = ""
  for (let i = 0; i < limit; i = i + 1) {
    const piece = `item${Int.toString(i)}`
    const pieces = [piece, piece]
    if (i == 1) {
      continue
    }
    text = `${text}${pieces[0]}`
  }
  return text
}

function bump(mutable counter: Array<int>) {
  counter[0] = counter[0] + 1
}

function callStep(): int {
  let counter = [0]
  for (let i = 0; i < 4; bump(mutable counter)) {
    i = i + 2
  }
  return counter[0]
}

export function run(args: Array<string>): int {
  print(Int.toString(countUp(5)))
  print(Int.toString(firstSquareOver(50)))
  print(Int.toString(sumOdd(10)))
  print(Int.toString(endless()))
  print(Int.toString(pairs(5)))
  print(Int.toString(reuseName()))
  print(heapLocals(4))
  print(Int.toString(callStep()))
  return 0
}
