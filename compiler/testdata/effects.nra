// Effects: declared on exported functions, inferred for private ones, and
// effect variables on higher-order functions.
export function map<T, U, effect E>(items: Array<T>, f: (item: T) => U uses E): Array<U> uses alloc, E {
  const out = [f(items[0])]
  return out
}

export function twice(x: int): int {
  return x * 2
}

// Private: the effects are inferred, so no `uses` is needed.
function show(n: int): string {
  print("show")
  return "ok"
}

export function report(n: int): string uses io, alloc {
  return show(n)
}

export function run(args: Array<string>): int {
  // A pure callback and an io callback both fit the same `map`.
  const a = map([1, 2], (x) => x + 1)
  const noisy = (x: int): int => {
    print("visit")
    return x
  }
  const b = map([1, 2], noisy)
  print(report(a[0] + b[0] + twice(1)))
  return 0
}
