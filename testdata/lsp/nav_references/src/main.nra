import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Text from "app/text"
import { Point, Shape, UserId, helper, LIMIT } from "app/text"

function area(shape: Shape): int {
  if (shape is Shape.Circle(radius)) {
    return radius * radius
  }
  return 0
}

export function run(arguments: Array<string>): int uses io, alloc {
  const point: Point = Point { x: Arrays.length(arguments), y: 2 }
  const total = helper("é😀") + point.x + LIMIT
  print(`total ${Int.toString(total)}`)
  const user: Text.UserId = UserId.from(1)
  return area(Shape.Circle(2)) + total + UserId.toInt(user)
}
