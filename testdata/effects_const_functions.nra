// Calls through top-level constants that hold functions charge the effects
// of the function the constant names, and only of that one.
import * as Int from "std/int"

function loud(v: int): int uses io {
  print(`loud ${Int.toString(v)}`)
  return v
}

function quiet(v: int): int {
  return v + 1
}

struct Table {
  quiet: (v: int) => int
  loud: (v: int) => int uses io
}

const table = Table { quiet: quiet, loud: loud }
const first = quiet
const steps = [first, quiet]
const shout = loud

export function pure(): int {
  return table.quiet(2) + steps[1](3) + first(4)
}

export function noisy(): int uses io, alloc {
  return table.loud(5) + shout(6)
}

export function run(args: Array<string>): int {
  print(Int.toString(pure()))
  print(Int.toString(noisy()))
  return 0
}
