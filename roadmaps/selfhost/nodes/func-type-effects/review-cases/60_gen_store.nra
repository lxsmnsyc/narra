function* loud(): Generator<int> {
  print("x")
  yield 1
}

export struct Plain {
  g: Generator<int>
}

export function pure(): int uses alloc {
  const p = Plain { g: loud() }
  let total = 0
  for (const n of p.g) {
    total = total + n
  }
  return total
}

export function run(args: Array<string>): int {
  return 0
}
