// Eight threads each copy one captured array and push to their copy. Each
// copy(...) explains its copy on write, so the debug copy check stays quiet
// although the shared array's count is negative.
import * as Thread from "std/thread"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"

function grow(words: Array<string>): int uses alloc {
  let mine = copy(words)
  Arrays.push(mutable mine, "x")
  return Arrays.length(mine)
}

export function run(args: Array<string>): int {
  const words = ["a", `b${Int.toString(Arrays.length(args))}`]
  const n = Thread.scope((scope) => {
    let threads: Array<Thread.Thread<int>> = []
    for (const _seed of Ranges.between(0, 8)) {
      Arrays.push(mutable threads, Thread.start(scope, () => grow(words)))
    }
    let sum = 0
    for (const thread of Arrays.values(threads)) {
      sum += Thread.join(thread)
    }
    return sum
  })
  print(`${Int.toString(n)}`)
  return 0
}
