struct Grid { rows: Array<Array<int>> }

struct Picker {
  pick: (grid: Grid) => Array<int>   from grid uses alloc
  plain: (Grid, int) => int
}

trait Rows {
  function firstRow(grid: Self): Array<int>  from grid
}

function firstRow(grid: Grid): Array<int>   from grid {
  return grid.rows[0]
}

function lastItem<T>(items: Array<T>, fallback: T): T from items uses alloc {
  if (Arrays.length(items) == 0) { return copy(fallback) }
  return items[Arrays.length(items) - 1]
}

function apply(pick: (grid: Grid) => Array<int> from grid, grid: Grid): Array<int> from grid {
  const second = (target: Grid): Array<int>   from target => target.rows[1]
  return pick(grid)
}
