// The statements, patterns and std functions an @const body may use, each
// result printed beside the same call made at run time.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Float from "std/float"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import * as Str from "std/string"

struct Row {
  cells: Array<int>
  name: string
}

struct Grid {
  rows: Array<Row>
}

@const
function firstOf<T>(items: Array<T>, fallback: T): T {
  if (Arrays.length(items) > 0) {
    return copy(items[0])
  }
  return copy(fallback)
}

@const
function fill(mutable grid: Grid, value: int) {
  grid.rows[1].cells[2] = value
  grid.rows[0].name = "first"
}

@const
function loops(): Array<int> uses alloc {
  let found: Array<int> = []
  outer: for (let row = 0; row < 5; row++) {
    for (const column of Ranges.between(0, 5)) {
      if (column == row) {
        continue outer
      }
      if (row == 4) {
        break outer
      }
      Arrays.push(mutable found, row * 10 + column)
    }
  }
  for (const value of Ranges.stepped(10, 0, -3)) {
    Arrays.push(mutable found, value)
  }
  let count = 0
  while (count < 3) {
    count += 1
  }
  Arrays.push(mutable found, count)
  return found
}

@const
function patterns(items: Array<int>): string uses alloc {
  let parts: Array<string> = []
  match (items) {
    [] => Arrays.push(mutable parts, "empty")
    [only] => Arrays.push(mutable parts, `one ${Int.toString(only)}`)
    [first, ...rest] => {
      Arrays.push(
        mutable parts,
        `first ${Int.toString(first)} rest ${Int.toString(Arrays.length(rest))}`,
      )
    }
  }
  for (const value of items) {
    const word = match (value) { 1 | 2 => "small", _ if (value > 100) => "large", _ => "middle" }
    Arrays.push(mutable parts, word)
  }
  const #[low, high] = #[items[0], items[Arrays.length(items) - 1]]
  Arrays.push(mutable parts, low < high ? "rising" : "falling")
  return Str.join(parts, ",")
}

@const
function numbers(): string uses alloc {
  let parts: Array<string> = []
  const big: u64 = 18446744073709551615
  const half: u64 = big / 2
  Arrays.push(mutable parts, Int.toString(Int.wrap(half)))
  Arrays.push(mutable parts, half < big ? "less" : "more")
  const small: u8 = 250
  const sum: u8 = small + 10
  Arrays.push(mutable parts, Int.toString(Int.from(sum)))
  if (Int.floorDiv(-7, 2) is Some(quotient)) {
    Arrays.push(mutable parts, Int.toString(quotient))
  }
  const ordering = Int.compare(3, 5)
  Arrays.push(mutable parts, ordering == Ordering.Less ? "ordered" : "not ordered")
  if (Int.parse("ff", 16) is Ok(parsed)) {
    Arrays.push(mutable parts, Int.toString(parsed))
  }
  if (Int.parse("zz", 10) is Err(message)) {
    Arrays.push(mutable parts, message)
  }
  if (Float.truncate(2.75) is Some(whole)) {
    Arrays.push(mutable parts, Int.toString(whole))
  }
  if (Int.addChecked(9223372036854775807, 1) is None) {
    Arrays.push(mutable parts, "overflow")
  }
  Arrays.push(mutable parts, Float.toString(Float.from(7) / 2.0 % 1.5))
  Arrays.push(mutable parts, Int.toString(~5 & 255))
  Arrays.push(mutable parts, Int.toString(-9223372036854775807 - 1))
  return Str.join(parts, " ")
}

@const
function grid(): Grid uses alloc {
  let made = Grid { rows: [] }
  for (const index of Ranges.upTo(2)) {
    Arrays.push(mutable made.rows, Row { cells: [index, index, index], name: "row" })
  }
  fill(mutable made, 9)
  for (mutable row of made.rows) {
    row.cells[0] = 7
  }
  return made
}

@const
function counts(text: string): Map<char, int> uses alloc {
  let found: Map<char, int> = Map {}
  for (const character of Str.chars(text)) {
    if (found[character] is Some(count)) {
      found[character] = count + 1
    } else {
      found[character] = 1
    }
  }
  return found
}

@const
function sliced(): Array<int> uses alloc {
  if (Arrays.slice([1, 2, 3, 4, 5], 1, 3) is Some(middle)) {
    return middle
  }
  return []
}

const FIRST_WORD = firstOf(["alpha", "beta"], "none")
const NO_NUMBERS: Array<int> = []
const FIRST_NUMBER = firstOf(NO_NUMBERS, 42)
const LOOPS = loops()
const PATTERNS = patterns([1, 50, 200])
const NUMBERS = numbers()
const GRID = grid()
const COUNTS = counts("banana")
const SLICED = sliced()

function joinNumbers(values: Array<int>): string uses alloc {
  let texts: Array<string> = []
  for (const value of values) {
    Arrays.push(mutable texts, Int.toString(value))
  }
  return Str.join(texts, " ")
}

function describeGrid(made: Grid): string uses alloc {
  let texts: Array<string> = []
  for (const row of made.rows) {
    Arrays.push(mutable texts, `${row.name}:${joinNumbers(row.cells)}`)
  }
  return Str.join(texts, " ")
}

function describeCounts(found: Map<char, int>): string uses alloc {
  let texts: Array<string> = []
  for (const character of Maps.keys(found)) {
    if (found[character] is Some(count)) {
      Arrays.push(mutable texts, `${Str.fromChar(character)}${Int.toString(count)}`)
    }
  }
  return Str.join(texts, " ")
}

export function run(args: Array<string>): int uses io, alloc {
  const words = ["alpha", "beta"]
  const empty: Array<int> = []
  const values = [1, 50, 200]
  const text = "banana"
  print(`${FIRST_WORD} ${firstOf(words, "none")}`)
  print(`${Int.toString(FIRST_NUMBER)} ${Int.toString(firstOf(empty, 42))}`)
  print(joinNumbers(LOOPS))
  print(joinNumbers(loops()))
  print(PATTERNS)
  print(patterns(values))
  print(NUMBERS)
  print(numbers())
  print(describeGrid(GRID))
  print(describeGrid(grid()))
  print(describeCounts(COUNTS))
  print(describeCounts(counts(text)))
  print(`${joinNumbers(SLICED)} ${joinNumbers(sliced())}`)
  return 0
}
