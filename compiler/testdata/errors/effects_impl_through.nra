// error: Function `greet` uses `io` (through `Cat.Named.name`) but its signature does not declare it
trait Named {
  function name(value: Self): string
}

struct Cat implements Named {
  lives: int
}

implement Named for Cat {
  function name(value: Cat): string {
    print("naming")
    return "cat"
  }
}

export function greet(cat: Cat): string {
  return Named.name(cat)
}
