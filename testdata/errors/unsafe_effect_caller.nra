// error: readFirst is unsafe; call it inside an `unsafe { }` block
import * as Ptr from "std/ptr"

// Not @trusted, so the unsafe effect reaches the caller.
function readFirst(items: Ptr<int>): int {
  let value = 0
  unsafe {
    value = Ptr.read(items)
  }
  return value
}

export function run(_args: Array<string>): int uses alloc, unsafe {
  let total = 0
  unsafe {
    const items: Ptr<int> = Ptr.alloc(1)
    Ptr.free(items)
  }
  total = readFirst(Ptr.null())
  return total
}
