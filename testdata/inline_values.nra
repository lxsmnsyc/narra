// A function-type parameter that the body passes on gets a real closure, built
// at the call; a named function or a closure value is passed as it is; and an
// @inline function used as a value has an ordinary C function.
import * as Arrays from "std/array"
import * as Int from "std/int"

function applyAll(items: Array<int>, transform: (item: int) => int): int {
  let total = 0
  for (const item of Arrays.values(items)) {
    total += transform(item)
  }
  return total
}

@inline
function sumBoth(left: Array<int>, right: Array<int>, transform: (item: int) => int): int {
  return applyAll(left, transform) + transform(Arrays.length(right))
}

@inline
function square(value: int): int {
  return value * value
}

@inline
function call(value: int, transform: (item: int) => int): int {
  return transform(value)
}

function negate(value: int): int {
  return -value
}

// Recursion through a function without @inline is allowed: the copy calls it.
@inline
function countHalves(value: int): int {
  if (value <= 1) {
    return 0
  }
  return 1 + halve(value)
}

function halve(value: int): int {
  return countHalves(value / 2)
}

export function run(_args: Array<string>): int uses io, alloc {
  const scale = 3
  print(Int.toString(sumBoth([1, 2], [7, 8, 9], (item) => item * scale)))
  // A named function and a stored closure are values already.
  print(Int.toString(call(4, negate)))
  const shift: (item: int) => int = (item) => item + scale
  print(Int.toString(call(4, shift)))
  // An @inline function as a value, and called through it.
  print(Int.toString(applyAll([1, 2, 3], square)))
  const stored: (item: int) => int = square
  print(Int.toString(call(5, stored) + square(6)))
  print(Int.toString(countHalves(40)))
  return 0
}
