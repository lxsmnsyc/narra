// Text and array helpers that turn the Option results of Str.slice, Str.split, Str.repeat and
// Arrays.filled into plain values. The compiler only passes ranges and counts it has checked, so
// a None here is a compiler bug.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

export function substring(text: string, start: int, end: int): string uses alloc {
  if (Str.slice(text, start, end) is Some(piece)) {
    return piece
  }
  panic(`substring: range ${Int.toString(start)}..${Int.toString(end)} is not in the text`)
}

export function splitString(text: string, separator: string): Array<string> uses alloc {
  if (Str.split(text, separator) is Some(pieces)) {
    return pieces
  }
  panic("splitString: the separator is empty")
}

export function repeatString(text: string, count: int): string uses alloc {
  if (Str.repeat(text, count) is Some(repeated)) {
    return repeated
  }
  panic("repeatString: the count is negative")
}

export function filledArray<T>(value: T, count: int): Array<T> from value uses alloc {
  if (Arrays.filled(value, count) is Some(items)) {
    return items
  }
  panic("filledArray: the count is negative")
}
