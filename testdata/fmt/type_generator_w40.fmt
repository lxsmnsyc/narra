function* relay<effect E>(
  source: Generator<int> uses E,
  _other: int,
): Generator<int> uses (E, alloc) {
  yield* source
}

export function* lines(
  path: string,
): Generator<string> uses (io, alloc) {
  yield path
}

const a: Array<Generator<int> uses io> = []
const b: (
  items: Generator<int> uses io,
) => Generator<string> uses alloc = f
const c: #[
  int,
  Generator<int> uses io,
] = f
function* longParameters(
  _firstGenerator: Generator<int> uses io,
  _secondGenerator: Generator<string> uses io,
  _third: int,
): Generator<int> uses io {
  yield 1
}
