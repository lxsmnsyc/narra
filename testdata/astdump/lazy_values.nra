import * as Lazies from "std/lazy"

function build(): Array<int> uses alloc {
  return [1, 2, 3]
}

const table = lazy build()
export const names: Array<string> = lazy buildNames()
const plain = 5
const lazy = 3

function buildNames(): Array<string> uses alloc {
  return ["a"]
}

export function run(args: Array<string>): int uses alloc {
  return Lazies.force(table)[0] + lazy
}
