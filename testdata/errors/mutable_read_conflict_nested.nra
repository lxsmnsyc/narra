// error: mutable_read_conflict_nested.nra:17:15: "y" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = 10
  return 0
}

function pair(a: int, b: int): int {
  return a + b
}

export function run(args: Array<string>): int {
  const y = Counter { n: 1 }
  return pair(y.n, bump(mutable y))
}
