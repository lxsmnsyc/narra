// error: the divisor must be a non-zero constant or a name checked against zero first; check the name first, as in `if (d != 0) { ... }`
function divide(total: int, first: int, second: int): int {
  if (first != 0 || second != 0) {
    return total / first
  }
  return 0
}

export function run(_args: Array<string>): int {
  return divide(4, 1, 2)
}
