// error: this argument is not proven to meet `requires divisor != 0` of share; pass a constant, or a name checked first with an `if`
function share(total: int, divisor: int): int
  requires divisor != 0
{
  return total / divisor
}

function pick(index: int, count: int): int
  requires index >= 0 && index < 10
  requires count > 0
{
  return index % count
}

function divideAll(total: int, count: int): int {
  return share(total, count)
}

function pickChecked(index: int): int {
  if (index >= 0) {
    return pick(index, 3)
  }
  return pick(0, 0)
}

function pickChanged(index: int): int {
  let current = index
  if (current >= 0 && current < 10) {
    current = current + 1
    return pick(current, 1)
  }
  return 0
}

export function run(_args: Array<string>): int {
  return divideAll(4, 2) + pickChecked(1) + pickChanged(2) + share(1, 0)
}
