// error: yield* in an async generator needs a AsyncGenerator<int>, found Generator<int>; write `for (const x of g) { yield x }`
function* plain(): Generator<int> {
  yield 1
}

async function* words(): AsyncGenerator<string> {
  yield "a"
}

async function* numbers(): AsyncGenerator<int> {
  yield* plain()
  yield* words()
  yield* [1, 2]
}

export function main() {
  const _stream = numbers()
}
