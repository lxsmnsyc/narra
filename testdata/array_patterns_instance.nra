// A generic instance does not judge a match again: the declaration's own body did.
import * as Int from "std/int"

struct Pair {
  ends: FixedArray<int, 2>
}

function span<T>(_tag: T, pair: Pair): int {
  return match (pair) { { ends: [a, b] } => b - a }
}

function sumPair<T>(_tag: T, values: #[FixedArray<int, 2>, int]): int {
  return match (values) { #[[a, b], c] => a + b + c }
}

export function run(args: Array<string>): int {
  print(Int.toString(span("x", Pair { ends: [1, 5] })))
  print(Int.toString(span(1, Pair { ends: [2, 3] })))
  print(Int.toString(sumPair("y", #[[1, 2], 3])))
  return 0
}
