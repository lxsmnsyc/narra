<script>
  import { $signal } from 'brumate/signals';
  import Icon from './Icon.brm';

  // The commands of the install-command contract of the roadmap.
  const COMMANDS = [
    {
      id: 'unix',
      label: 'macOS and Linux',
      prompt: '$',
      command: 'curl -fsSL https://github.com/lxsmnsyc/narra/releases/latest/download/install.sh | sh',
    },
    {
      id: 'windows',
      label: 'Windows',
      prompt: '>',
      command: 'irm https://github.com/lxsmnsyc/narra/releases/latest/download/install.ps1 | iex',
    },
  ];

  let system = $signal('unix');
  let copied = $signal(false);
  let failed = $signal(false);
  let timer = 0;

  async function copyCommand() {
    let text = '';
    for (const item of COMMANDS) {
      if (item.id === system) {
        text = item.command;
      }
    }
    try {
      await navigator.clipboard.writeText(text);
      copied = true;
    } catch {
      failed = true;
    }
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      copied = false;
      failed = false;
    }, 1500);
  }

  function choose(id: string) {
    system = id;
    copied = false;
    failed = false;
  }
</script>

<div class="install">
  <div class="install-systems" role="group" aria-label="System">
    #for (item of COMMANDS by item.id) {
      <button
        type="button"
        class="install-system"
        aria-pressed=(system === item.id ? 'true' : 'false')
        onClick=(() => choose(item.id))
      >{item.label}</button>
    }
  </div>
  <div class="install-line">
    <div class="install-commands">
      #for (item of COMMANDS by item.id) {
        <code class="install-command" aria-hidden=(system === item.id ? 'false' : 'true')><span class="install-prompt" aria-hidden="true">{item.prompt}</span>{item.command}</code>
      }
    </div>
    <button
      type="button"
      class="icon-button install-copy"
      aria-label=(failed ? 'Copy failed' : copied ? 'Copied' : 'Copy')
      title=(failed ? 'Copy failed' : copied ? 'Copied' : 'Copy')
      data-copied=(copied ? 'true' : 'false')
      data-failed=(failed ? 'true' : 'false')
      onClick=copyCommand
    >
      <span class="swap">
        <span class="swap-item" aria-hidden=(copied || failed ? 'true' : 'false')><Icon name="copy" size=(16) /></span>
        <span class="swap-item" aria-hidden=(copied ? 'false' : 'true')><Icon name="check" size=(16) /></span>
        <span class="swap-item" aria-hidden=(failed ? 'false' : 'true')><Icon name="alert" size=(16) /></span>
      </span>
    </button>
  </div>
</div>
