import * as Shapes from "dynamic_traits/shapes"
import { Area, Rect } from "dynamic_traits/shapes"

struct Square implements Area {
  side: int
}

implement Area for Square {
  function area(value: Square): int {
    return value.side * value.side
  }
}

export function run(_args: Array<string>): int {
  const items: Array<Dynamic<Area>> = [
    Dynamic.of(Rect { width: 2, height: 3 }),
    Dynamic.of(Square { side: 4 }),
  ]
  for (const item of items) {
    print(Show.show(Area.area(item)))
  }
  print(`sum ${Show.show(Shapes.sum(items))}`)
  return 0
}
