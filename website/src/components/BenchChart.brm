<script>
  import baseline from 'virtual:bench-baseline';

  const NAMES: Record<string, string> = { narra: 'Narra', c: 'C', go: 'Go', rust: 'Rust', zig: 'Zig' };
  const SOURCE = 'https://github.com/lxsmnsyc/narra/blob/main/bench/BASELINE.md';

  interface Bar {
    language: string;
    name: string;
    seconds: string;
    value: number;
    best: boolean;
  }

  // One group per program. Each group has its own scale: the slowest language fills the track.
  const groups: { program: string; bars: Bar[] }[] = [];
  for (const program of baseline.programs) {
    let slowest = 0;
    let fastest = Infinity;
    for (const time of program.times) {
      slowest = Math.max(slowest, time);
      fastest = Math.min(fastest, time);
    }
    const bars: Bar[] = [];
    for (const [index, language] of baseline.languages.entries()) {
      const time = program.times[index]!;
      bars.push({
        language,
        name: NAMES[language] ?? language,
        seconds: time.toFixed(3),
        value: time / slowest,
        best: time === fastest,
      });
    }
    groups.push({ program: program.name, bars });
  }
</script>

<div class="bench">
  #for (group of groups by group.program) {
    <div class="bench-group" role="group" aria-labelledby=(`bench-${group.program}`)>
      <h3 class="bench-program" id=(`bench-${group.program}`)>{group.program}</h3>
      <ul class="bars">
        #for (bar of group.bars by bar.language) {
          <li class="bar" data-best=(bar.best ? '' : undefined) data-self=(bar.language === 'narra' ? '' : undefined)>
            <span class="bar-name">{bar.name}</span>
            <span class="bar-track" aria-hidden="true"><span class="bar-fill" style=(`--value: ${bar.value.toFixed(3)}`)></span></span>
            <span class="bar-value">{bar.seconds} s</span>
          </li>
        }
      </ul>
    </div>
  }
  <p class="bench-foot">
    Median seconds of {baseline.runs} runs, lower is faster. {baseline.machine}, {baseline.date}. The load average rose from {baseline.loadStart} to {baseline.loadEnd} during the run, so read small gaps as noise. Source: <a href=(SOURCE) rel="noreferrer">bench/BASELINE.md</a>
  </p>
</div>
