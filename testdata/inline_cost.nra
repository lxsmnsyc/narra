// The cost of a capturing callback, through a helper in the shape of
// Options.map with @inline and the same helper without it. Both loops compute
// the same sums. Pass `inline N` or `plain N` to run one loop N times, to time it.
import * as Arrays from "std/array"
import * as Int from "std/int"

@inline
function mapInline(value: Option<int>, transform: (value: int) => int): Option<int> uses alloc {
  if (value is Some(found)) {
    return Some(transform(found))
  }
  return None
}

function mapPlain(value: Option<int>, transform: (value: int) => int): Option<int> uses alloc {
  if (value is Some(found)) {
    return Some(transform(found))
  }
  return None
}

function sumInline(count: int, step: int): int uses alloc {
  let total = 0
  for (let i = 0; i < count; i++) {
    const mapped = mapInline(Some(i), (value) => value * step + total)
    if (mapped is Some(found)) {
      total = total + found / 2
    }
  }
  return total
}

function sumPlain(count: int, step: int): int uses alloc {
  let total = 0
  for (let i = 0; i < count; i++) {
    const mapped = mapPlain(Some(i), (value) => value * step + total)
    if (mapped is Some(found)) {
      total = total + found / 2
    }
  }
  return total
}

export function run(args: Array<string>): int uses io, alloc {
  let count = 1000
  if (Arrays.length(args) > 2) {
    if (Int.parse(args[2], 10) is Ok(parsed)) {
      count = parsed
    }
    if (args[1] == "inline") {
      print(Int.toString(sumInline(count, 3)))
    } else {
      print(Int.toString(sumPlain(count, 3)))
    }
    return 0
  }
  print(Int.toString(sumInline(count, 3)))
  print(Int.toString(sumPlain(count, 3)))
  return 0
}
