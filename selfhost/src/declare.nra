// The declaration passes, ported from check.go (declareModule, the prelude),
// modules_check.go (newPackageChecker, declareSourceModule), check_types.go
// (declareType, declareGeneric), check_opaque.go (declareDistinct,
// resolveDistinct) and check_const.go (declareConsts).
//
// This node checks the modules of a package one by one, each with its own
// declarations and the prelude. Extension points are comments marked HOOK:
// selfhost-check-traits added trait declarations, bounds and implementations (traits.nra);
// selfhost-check-imports adds package and std imports, imported names and
// the imported-constant check; selfhost-check-bodies adds default values,
// bodies and pending generic function instances.
//
// Node ids: the package's files use ids [0, Package.nextId). The prelude is
// parsed after them, from Package.nextId, so its ids (trait parameters)
// never clash with the package's, and the side tables are sized by the
// prelude's nextId.
import { Pos, File, Decl, FuncDecl, ConstDecl, DistinctDecl, FieldDecl, VariantDecl } from "narrac/ast"
import { parse, quoteGo } from "narrac/parser"
import { Package, SourceModule } from "narrac/modules"
import { Type, StructInfo, EnumInfo, DistinctInfo, GenericInfo } from "narrac/types"
import { Checker, FuncInfo, ConstInfo, CheckError, newChecker, newScope, enter, errorf, errorIn, setParamType, lookupType, lookupGeneric, lookupTrait, finish } from "narrac/check"
import { makeParams, envOf } from "narrac/generics"
import { declareTraits, resolveTraits, funcBounds, flushMapKeys } from "narrac/traits"
import { resolveType, resolveOpt, resolveFields, resolveVariants, buildGeneric } from "narrac/resolve"
import * as Array from "std/array"
import * as Range from "std/range"

// The prelude, the same text as preludeSrc in check.go. It is checked once
// per program as module "" with file name "prelude".
const PRELUDE = `
trait Equatable {
  function equals(a: Self, b: Self): bool
}

trait Hashable {
  function hash(value: Self): int
}

trait Ordered {
  function compare(a: Self, b: Self): Ordering
}

trait Show {
  function show(value: Self): string
}

enum Ordering derives Show, Ordered {
  Less
  Equal
  Greater
}

enum Option<T> derives Show, Ordered {
  Some(value: T)
  None
}

enum Result<T, E> derives Show, Ordered {
  Ok(value: T)
  Err(error: E)
}
`

// newPackageChecker makes the checker for pkg and runs the declaration
// passes of the prelude. Its non-generic types start Checker.concrete.
export function newPackageChecker(pkg: Package): Checker uses alloc {
  const parsed = parse(PRELUDE, pkg.nextId)
  if (parsed is Err(d)) {
    let c = newChecker(pkg.nextId)
    errorIn(mutable c, "prelude", d.pos, d.message)
    return c
  }
  let c = newChecker(parsed.value.nextId)
  const s = newScope(mutable c, "", "prelude", parsed.value.file.decls)
  enter(mutable c, s)
  declareModule(mutable c, parsed.value.file)
  return c
}

// declareSourceModule makes m the current module, in a new scope, and runs
// its declaration passes. The full checker checks m's bodies right after.
export function declareSourceModule(mutable c: Checker, m: SourceModule) uses alloc {
  const s = newScope(mutable c, m.path, m.file, m.ast.decls)
  enter(mutable c, s)
  declareModule(mutable c, m.ast)
}

// declareModule runs the declaration passes of the current module: imports,
// type names, fields, function signatures, constants and generic templates.
// Its non-generic structs and enums are appended to Checker.concrete.
export function declareModule(mutable c: Checker, f: File) uses alloc {
  for (const imp of Array.values(f.imports)) {
    // HOOK selfhost-check-imports: package modules, unknown modules, named
    // imports, aliases and the std registry.
    if (imp.path == "std/string") {
      // The type is visible only where its runtime C is emitted.
      const s = c.cur
      c.scopes[s].types["StringBuilder"] = TStringBuilder
    }
  }
  // Declare type names first, so declarations can refer to each other.
  // made holds the type created for each declaration, by position.
  let made: Array<Type> = []
  let own: Array<int> = []
  for (const d of Array.values(f.decls)) {
    let t = TVoid
    match (d) {
      Struct(sd) => {
        if (Array.length(sd.typeParams) > 0) {
          Array.push(mutable own, declareGeneric(mutable c, sd.pos, sd.name, sd.typeParams, true, sd.opaque, sd.fields, []))
        } else {
          t = TStruct(Array.length(c.structs))
          const info = StructInfo { name: sd.name, module: modPath(c), scope: c.cur, pos: declPos(c, sd.pos), opaque: sd.opaque, tuple: false, args: [], generic: -1, fields: [] }
          Array.push(mutable c.structs, info)
          declareType(mutable c, sd.pos, sd.name, t)
          Array.push(mutable c.concrete, t)
        }
      }
      Distinct(dd) => {
        t = TDistinct(Array.length(c.distincts))
        const info = DistinctInfo { name: dd.name, module: modPath(c), opaque: dd.opaque, base: None }
        Array.push(mutable c.distincts, info)
        declareType(mutable c, dd.pos, dd.name, t)
      }
      Enum(ed) => {
        if (Array.length(ed.typeParams) > 0) {
          Array.push(mutable own, declareGeneric(mutable c, ed.pos, ed.name, ed.typeParams, false, false, [], ed.variants))
        } else {
          t = TEnum(Array.length(c.enums))
          const info = EnumInfo { name: ed.name, module: modPath(c), scope: c.cur, pos: declPos(c, ed.pos), args: [], generic: -1, variants: [] }
          Array.push(mutable c.enums, info)
          declareType(mutable c, ed.pos, ed.name, t)
          Array.push(mutable c.concrete, t)
        }
      }
      _ => {}
    }
    Array.push(mutable made, t)
  }
  declareTraits(mutable c, f)
  for (const k of Range.between(0, Array.length(f.decls))) {
    const t = made[k]
    match (f.decls[k]) {
      Struct(sd) => {
        if (t is TStruct(i)) {
          const fields = resolveFields(mutable c, sd.fields)
          c.structs[i].fields = fields
        }
      }
      Enum(ed) => {
        if (t is TEnum(i)) {
          const variants = resolveVariants(mutable c, ed.variants)
          c.enums[i].variants = variants
        }
      }
      Distinct(dd) => resolveDistinct(mutable c, dd, t)
      Func(fd) => declareFunc(mutable c, fd)
      // HOOK selfhost-check-bodies: tests (Go's Program.Tests).
      _ => {}
    }
  }
  declareConsts(mutable c, f)
  for (const g of Array.values(own)) {
    buildGeneric(mutable c, g)
  }
  resolveTraits(mutable c, f)
  // HOOK selfhost-check-bodies: checkDefaults on the fields of every
  // non-generic struct, after every field type is known.
}

function modPath(c: Checker): string {
  return c.scopes[c.cur].path
}

// declPos is where typeErrorf reports a type: its declaration, or the zero
// position in the prelude, which has no source file.
function declPos(c: Checker, pos: Pos): Pos {
  if (modPath(c) == "") {
    return Pos { line: 0, col: 0 }
  }
  return pos
}

function declareType(mutable c: Checker, pos: Pos, name: string, t: Type) uses alloc {
  checkTypeName(mutable c, pos, name)
  const s = c.cur
  c.scopes[s].types[name] = t
}

function checkTypeName(mutable c: Checker, pos: Pos, name: string) uses alloc {
  if (lookupType(c, name) is Some(_)) {
    errorf(mutable c, pos, `type ${quoteGo(name)} is declared twice`)
  }
  if (lookupGeneric(c, name) is Some(_)) {
    errorf(mutable c, pos, `type ${quoteGo(name)} is declared twice`)
  }
}

// declareGeneric adds a generic struct or enum template and returns its index.
function declareGeneric(mutable c: Checker, pos: Pos, name: string, typeParams: Array<string>, isStruct: bool, opaque: bool, fields: Array<FieldDecl>, variants: Array<VariantDecl>): int uses alloc {
  const params = makeParams(mutable c, typeParams)
  checkTypeName(mutable c, pos, name)
  const g = Array.length(c.generics)
  const info = GenericInfo { name: name, module: modPath(c), scope: c.cur, pos: pos, params: params, isStruct: isStruct, opaque: opaque, fieldDecls: fields, variantDecls: variants, built: false, building: false, pending: [], fields: [], variants: [] }
  Array.push(mutable c.generics, info)
  const s = c.cur
  c.scopes[s].generics[name] = g
  return g
}

// resolveDistinct resolves the base type of a distinct declaration. A base
// that is a distinct type not resolved yet (itself, or one declared later)
// is an error.
function resolveDistinct(mutable c: Checker, dd: DistinctDecl, t: Type) uses alloc {
  let base = resolveType(mutable c, dd.base)
  if (base is TDistinct(j)) {
    if (c.distincts[j].base is None) {
      errorf(mutable c, dd.pos, `distinct type ${dd.name} cannot be defined in terms of itself`)
      base = TInt
    }
  }
  if (t is TDistinct(i)) {
    c.distincts[i].base = Some(base)
  }
}

// declareFunc records a function's signature: its type parameters, the
// parameter types (side table paramTypes by Param.id) and the result.
function declareFunc(mutable c: Checker, fd: FuncDecl) uses alloc {
  const s = c.cur
  if (c.scopes[s].funcs[fd.name] is Some(_)) {
    errorf(mutable c, fd.pos, `function ${quoteGo(fd.name)} is declared twice`)
  }
  c.env = Map {}
  let tps: Array<int> = []
  if (Array.length(fd.typeParams) > 0) {
    tps = makeParams(mutable c, fd.typeParams)
    funcBounds(mutable c, fd, tps)
    c.env = envOf(c, tps)
  }
  for (const p of Array.values(fd.params)) {
    const t = resolveOpt(mutable c, p.type)
    setParamType(mutable c, p.id, t)
  }
  const result = resolveOpt(mutable c, fd.result)
  c.env = Map {}
  const idx = Array.length(c.funcs)
  const info = FuncInfo { name: fd.name, module: modPath(c), scope: s, decl: fd, typeParams: tps, result: result }
  Array.push(mutable c.funcs, info)
  c.scopes[s].funcs[fd.name] = idx
}

// declareConsts registers the constants of f in the current module. A
// constant may not share a name with a function, a type or another constant.
function declareConsts(mutable c: Checker, f: File) uses alloc {
  // HOOK selfhost-check-imports: an imported constant clashing with a type.
  const s = c.cur
  for (const d of Array.values(f.decls)) {
    if (d is Const(cd)) {
      const dupFunc = c.scopes[s].funcs[cd.name] is Some(_)
      const dup = c.scopes[s].consts[cd.name] is Some(_)
      const typeNamed = lookupType(c, cd.name) is Some(_) || lookupGeneric(c, cd.name) is Some(_) || lookupTrait(c, cd.name) >= 0
      if (dup || dupFunc || typeNamed) {
        errorf(mutable c, cd.pos, `constant ${quoteGo(cd.name)} is declared twice`)
        continue
      }
      const idx = Array.length(c.consts)
      const info = ConstInfo { name: cd.name, module: modPath(c), scope: s, decl: cd, t: None }
      Array.push(mutable c.consts, info)
      c.scopes[s].consts[cd.name] = idx
    }
  }
}

// declareConstTypes resolves the declared type of every annotated constant,
// module by module in declaration order, after all modules are declared.
// Go resolves it when the body checker first meets the constant
// (constType); the dumps resolve it here, and the body checker reads
// ConstInfo.t.
export function declareConstTypes(mutable c: Checker) uses alloc {
  for (const s of Range.between(1, Array.length(c.scopes))) {
    enter(mutable c, s)
    for (const d of Array.values(c.scopes[s].decls)) {
      if (d is Const(cd)) {
        if (cd.type is Some(te)) {
          const t = resolveType(mutable c, te)
          if (c.scopes[s].consts[cd.name] is Some(idx)) {
            if (c.consts[idx].decl.pos == cd.pos) {
              c.consts[idx].t = Some(t)
            }
          }
        }
      }
    }
  }
}

// declarePackage runs the declaration passes on every module of pkg in load
// order, resolves the constant types and orders the types (finish), as
// DeclDump does. Bodies are not checked.
export function declarePackage(pkg: Package): Checker uses alloc {
  let c = newPackageChecker(pkg)
  if (Array.length(c.errs) > 0 && Array.length(c.scopes) == 0) {
    return c
  }
  for (const m of Array.values(pkg.modules)) {
    declareSourceModule(mutable c, m)
  }
  declareConstTypes(mutable c)
  flushMapKeys(mutable c)
  const concrete = c.concrete
  finish(mutable c, concrete)
  return c
}
