export struct Token {
  text: string
}
export enum Kind {
  Word
  Num(value: int)
}
export struct Pair<A, B> {
  a: A
  b: B
}
export distinct type Id = int
export trait Named {
  function name(self: Self): string
}
export const LIMIT: int = 3
export function make(text: string): Token {
  return Token { text: text }
}
function helper(): int {
  return 1
}
struct Hidden {
  x: int
}
