import * as Int from "std/int"
import * as Arrays from "std/array"

trait Items {
  function items(value: Self): Array<int> from value
}

struct Bag implements Items {
  values: Array<int>
}

implement Items for Bag {
  function items(value: Bag): Array<int> from value {
    return value.values
  }
}

function grow<T: Items>(item: T): int {
  let got = copy(Items.items(item))
  Arrays.push(mutable got, 3)
  return Arrays.length(got)
}

export function run(_args: Array<string>): int {
  const bag = Bag { values: [1, 2] }
  print(Int.toString(grow(bag)))
  return 0
}
