// A local holds its value until its block ends, but a write copies only
// arrays, maps and boxes. A struct of numbers is never copied, and a
// `mutable` call cannot reach inside an enum payload, so these writes are
// accepted.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Pos {
  line: int
  column: int
}

enum Shape {
  Dot
  Line(points: Array<int>)
}

struct Drawing {
  start: Pos
  shape: Shape
  marks: Array<int>
}

function mark(mutable drawing: Drawing) uses alloc {
  const line = drawing.start.line
  Arrays.push(mutable drawing.marks, line)
}

export function run(_args: Array<string>): int uses io, alloc {
  let drawing = Drawing { start: Pos { line: 1, column: 2 }, shape: Shape.Line([3]), marks: [] }
  const start = drawing.start
  const shape = drawing.shape
  let total = start.column
  if (shape is Shape.Line(points)) {
    total += Arrays.length(points)
  }
  drawing.start.line = 5
  mark(mutable drawing)
  print(Int.toString(total + drawing.marks[0]))
  return 0
}
