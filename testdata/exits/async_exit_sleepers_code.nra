// The exit code is the entry's value whatever the other tasks do: tasks still
// sleeping at exit are cancelled and return other values, and the code stays 3.
import * as Async from "std/async"
import * as AsyncTime from "std/async/time"
import * as Time from "std/time"

async function sleeper(code: int): int uses io, alloc {
  const slept = await AsyncTime.sleep(Time.seconds(3600))
  if (slept is Err(_)) {
    print("sleeper cancelled")
    return code
  }
  return code + 1
}

export async function run(_args: Array<string>): int {
  Async.detach(sleeper(7))
  Async.detach(sleeper(0))
  print("entry returns 3")
  return 3
}
