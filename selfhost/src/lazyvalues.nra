// Lazy values: a top-level `const name = lazy expression`, built on the first
// `Lazies.force(name)`. The name has the type of the expression. The checker
// accepts it only as the argument of `Lazies.force`, the effect pass gives the
// force the effects of the expression, and a value that forces itself is an error.
// The graph of bodies for the cycle check keeps its edges as pairs in one array,
// source then target (body indexes): a body calls a function, names it as a value,
// or forces a lazy value.
import { Pos } from "narrac/ast"
import { Checker, Ref, getRef, setRef, reportError } from "narrac/check"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export const FORCE_NAME = "Lazies.force"

export function isLazyConstant(checker: Checker, constIndex: int): bool {
  if (constIndex < 0) {
    return false
  }
  return checker.consts[constIndex].declaration.lazyPos is Some(_)
}

export function markForced(mutable checker: Checker, nodeId: int) uses alloc {
  setRef(mutable checker, nodeId, Ref.Const(-1))
}

export function isForced(checker: Checker, nodeId: int): bool {
  return getRef(checker, nodeId) is Ref.Const(-1)
}

export function checkLazyUse(
  mutable checker: Checker,
  nodeId: int,
  pos: Pos,
  constIndex: int,
) uses alloc {
  if (isLazyConstant(checker, constIndex) && !isForced(checker, nodeId)) {
    const name = checker.consts[constIndex].name
    reportError(
      mutable checker,
      pos,
      "E1033",
      `lazy value ${name} cannot be used here; a lazy value appears only as the name that Lazies.force takes`,
    )
  }
}

export function reportLazyCycle(mutable checker: Checker, pos: Pos, name: string) uses alloc {
  reportError(
    mutable checker,
    pos,
    "E1035",
    `lazy value ${name} forces itself, directly or through the functions and lazy values it uses`,
  )
}

export function addEdge(mutable edges: Array<int>, source: int, target: int) uses alloc {
  Arrays.push(mutable edges, source)
  Arrays.push(mutable edges, target)
}

function collectReachable(edges: Array<int>, start: int): Map<int, bool> uses alloc {
  // The bodies reached by one or more edges from start.
  let reached: Map<int, bool> = Map {}
  let pending: Array<int> = [start]
  let cursor = 0
  while (cursor < Arrays.length(pending)) {
    const current = pending[cursor]
    cursor++
    for (let edge = 0; edge < Arrays.length(edges); edge += 2) {
      if (edges[edge] == current && reached[edges[edge + 1]] is None) {
        reached[edges[edge + 1]] = true
        Arrays.push(mutable pending, edges[edge + 1])
      }
    }
  }
  return reached
}

export function findLazyCycles(edges: Array<int>, lazyBodies: Array<int>): Array<int> uses alloc {
  // The positions in lazyBodies that start a cycle, one for each cycle.
  let starts: Array<int> = []
  let covered: Array<bool> = []
  for (const _ of Ranges.between(0, Arrays.length(lazyBodies))) {
    Arrays.push(mutable covered, false)
  }
  for (const position of Ranges.between(0, Arrays.length(lazyBodies))) {
    if (covered[position]) {
      continue
    }
    const reached = collectReachable(edges, lazyBodies[position])
    if (reached[lazyBodies[position]] is None) {
      continue
    }
    Arrays.push(mutable starts, position)
    covered[position] = true
    // The other lazy values on the same cycle are not reported again.
    for (const other of Ranges.between(0, Arrays.length(lazyBodies))) {
      if (reached[lazyBodies[other]] is Some(_)) {
        if (collectReachable(edges, lazyBodies[other])[lazyBodies[position]] is Some(_)) {
          covered[other] = true
        }
      }
    }
  }
  return starts
}
