// A cycle of awaits: the entry waits on a task that waits on its own handle.
// Nothing is ready and nothing else can finish, so the program stops with
// "async: every task waits on another task" and exit code 101.
import * as Async from "std/async"
import * as Cells from "std/cell"
import { Cell } from "std/cell"

async function waitForSelf(slot: Cell<Option<Async<int>>>): int uses io, alloc {
  await Async.idle()
  print("waits on itself")
  const own = Cells.get(slot)
  if (own is Some(handle)) {
    return await handle
  }
  return 0
}

export async function run(_args: Array<string>): int {
  const slot: Cell<Option<Async<int>>> = Cells.create(None)
  const task = waitForSelf(slot)
  Cells.set(slot, Some(task))
  return await task
}
