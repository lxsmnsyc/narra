// The conditional expression `c ? a : b`: the condition must be bool, both
// branches have one type, and only the chosen branch runs.
import * as Int from "std/int"
import * as Arrays from "std/array"

function pick(flag: bool, a: int, b: int): int {
  return flag ? a : b
}

function sign(n: int): string {
  return n < 0 ? "negative" : n == 0 ? "zero" : "positive"
}

// Nested in the middle branch too.
function grade(score: int): string {
  return score >= 50 ? score >= 90 ? "high" : "pass" : "fail"
}

function describe(label: string, count: int): string {
  return `${label}: ${count == 1 ? "one" : "many"}`
}

// A branch with a side effect proves only one branch runs.
function noisy(mutable trace: Array<string>, name: string, value: int): int {
  Arrays.push(mutable trace, name)
  return value
}

// Heap values in both branches.
function words(flag: bool): Array<string> {
  const left = ["a", "b"]
  const right = ["c"]
  return flag ? left : right
}

function join(items: Array<string>): string {
  let text = ""
  for (const item of Arrays.values(items)) {
    text = `${text}${item}`
  }
  return text
}

// A self call in a returned ternary branch stays a loop.
function climb(n: int): int {
  return n < 0 ? climb(n + 1) : n
}

function countdown(n: int, acc: int): int {
  return n == 0 ? acc : countdown(n - 1, acc + 2)
}

// A branch that is a block expression.
function twice(flag: bool, n: int): int {
  const value = flag ? { return n * 2 } : { return n }
  return value
}

export function run(args: Array<string>): int {
  const chosen = pick(true, 1, 2)
  print(Int.toString(chosen))
  print(Int.toString(pick(false, 1, 2)))
  print(sign(-5))
  print(sign(0))
  print(sign(7))
  print(grade(95))
  print(grade(60))
  print(grade(10))
  print(describe("apple", 1))
  print(describe("pear", 3))

  let trace: Array<string> = []
  const first = true ? noisy(mutable trace, "then", 1) : noisy(mutable trace, "else", 2)
  const second = false ? noisy(mutable trace, "then2", 3) : noisy(mutable trace, "else2", 4)
  print(`${Int.toString(first)} ${Int.toString(second)} ${join(trace)}`)

  print(join(words(true)))
  print(join(words(false)))
  print(Int.toString(climb(-5000000)))
  print(Int.toString(countdown(5000000, 0)))
  print(Int.toString(twice(true, 21)))
  print(Int.toString(twice(false, 21)))

  // Looser than ||, and as an argument.
  print(Int.toString(pick(1 < 2 || 3 < 2 ? true : false, 8, 9)))
  return 0
}
