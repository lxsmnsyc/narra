// Atomic.add wraps like + (D92): an Atomic<u8> at 255 plus 1 is 0, and an
// Atomic<i8> at 127 plus 1 is -128. Each add gives the old value.
import * as Thread from "std/thread"
import * as Atomic from "std/atomic"

export function run(_args: Array<string>): int {
  const smallStart: u8 = 250
  const signedStart: i8 = 127
  const smallOne: u8 = 1
  const signedOne: i8 = 1
  const small = Atomic.create(smallStart)
  const signed = Atomic.create(signedStart)
  const steps = Thread.scope((scope) => {
    const adder = Thread.start(scope, () => {
      let count = 0
      for (let index = 0; index < 10; index++) {
        Atomic.add(small, smallOne)
        count++
      }
      return count
    })
    return Thread.join(adder)
  })
  print(`${Show.show(steps)} adds: ${Show.show(Atomic.load(small))}`)
  const old = Atomic.add(signed, signedOne)
  print(`old ${Show.show(old)}, now ${Show.show(Atomic.load(signed))}`)
  const big = Atomic.create(9223372036854775807)
  Atomic.add(big, 1)
  print(`int wraps to ${Show.show(Atomic.load(big))}`)
  return 0
}
