// The registry rows and emitters of std/path.
import { StdFunc } from "narrac/builtins"
import { Pos, Arg } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported } from "narrac/emitstate"
import { NODE, FixedCall, plain, owned, emitFixedCall } from "narrac/stdemithelp"
import * as Arrays from "std/array"

export const PATH_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Path.basename",
    module: "std/path",
    key: "basename",
    parameters: ["string"],
    result: "string",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Path.dirname",
    module: "std/path",
    key: "dirname",
    parameters: ["string"],
    result: "string",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Path.extname",
    module: "std/path",
    key: "extname",
    parameters: ["string"],
    result: "string",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Path.join",
    module: "std/path",
    key: "join",
    parameters: ["string", "string"],
    result: "string",
    effects: ["alloc"],
  },
]

const PATH_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Path.join",
    call: "narra_path_join",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Path.dirname",
    call: "narra_path_dirname",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Path.basename",
    call: "narra_path_basename",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Path.extname",
    call: "narra_path_extname",
    withPos: false,
    owned: true,
    temporary: false,
  },
]

// emitPathCall emits the calls of std/path.
export function emitPathCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(PATH_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }

  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
