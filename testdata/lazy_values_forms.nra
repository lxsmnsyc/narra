// The expression after lazy may start with [, (, - or !.
import * as Lazies from "std/lazy"
import * as Int from "std/int"

const items = lazy [1, 2, 3]
const sum = lazy (1 + 2) * 4
const negative = lazy -3
const flipped = lazy !true

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(Lazies.force(items)[1]))
  print(Int.toString(Lazies.force(sum)))
  print(Int.toString(Lazies.force(negative)))
  print(Lazies.force(flipped) ? "yes" : "no")
  return 0
}
