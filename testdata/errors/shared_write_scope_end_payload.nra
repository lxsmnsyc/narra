// error: Arrays.push(mutable parser.tokens, ...) may change parser.tokens, which lexed.value still holds until its block ends at line 26
// The narrowed Result keeps its payload until its block ends, so a write to
// the array taken out of it copies the array.
import * as Arrays from "std/array"

struct Parser {
  tokens: Array<string>
  index: int
}

function lexAll(source: string): Result<Array<string>, string> uses alloc {
  if (source == "") {
    return Err("empty")
  }
  return Ok([source])
}

export function run(_args: Array<string>): int uses alloc {
  const lexed = lexAll("a")
  if (lexed is Err(_)) {
    return 1
  }
  let parser = Parser { tokens: lexed.value, index: 0 }
  Arrays.push(mutable parser.tokens, "end")
  return Arrays.length(parser.tokens)
}
