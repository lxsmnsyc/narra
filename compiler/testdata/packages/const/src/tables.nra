export enum Kind {
  Word
  Op(symbol: string)
}

export struct Keyword {
  text: string
  kind: Kind
}

export const LIMIT = 64
export const GREETING = "hello"
export const KEYWORDS: Array<Keyword> = [
  Keyword { text: "if", kind: Kind.Word },
  Keyword { text: "+", kind: Kind.Op("plus") },
]
export const DEFAULT_KIND = Kind.Op("none")
