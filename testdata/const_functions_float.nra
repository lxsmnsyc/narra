// Float tables computed by the compiler: square roots, and a * b + c, which the
// emitted C computes without a fused multiply-add, so both results are equal.
import * as Arrays from "std/array"
import * as Float from "std/float"
import * as Ranges from "std/range"
import * as Str from "std/string"

@const
function roots(): Array<f64> uses alloc {
  let table: Array<f64> = []
  for (const value of Ranges.upTo(16)) {
    Arrays.push(mutable table, Float.sqrt(Float.fromInt(value)))
  }
  return table
}

@const
function multiplyAdd(scale: f64, offset: f64): Array<f64> uses alloc {
  let table: Array<f64> = []
  for (const value of Ranges.upTo(8)) {
    const step = Float.fromInt(value) * 0.1
    Arrays.push(mutable table, step * scale + offset)
  }
  return table
}

const ROOTS = roots()
const MULTIPLY_ADD = multiplyAdd(1.1, 0.3)

function describe(table: Array<f64>): string uses alloc {
  let parts: Array<string> = []
  for (const value of table) {
    Arrays.push(mutable parts, Float.toString(value))
  }
  return Str.join(parts, " ")
}

export function run(args: Array<string>): int uses io, alloc {
  const scale = 1.1
  print(describe(ROOTS))
  print(describe(roots()))
  print(describe(MULTIPLY_ADD))
  print(describe(multiplyAdd(scale, 0.3)))
  return 0
}
