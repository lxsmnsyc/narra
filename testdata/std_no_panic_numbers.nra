import * as Math from "std/math"
import * as Random from "std/random"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import * as Int from "std/int"

function describe(label: string, number: Option<int>) uses alloc {
  if (number is Some(found)) {
    print(`${label}: Some(${Int.toString(found)})`)
  } else {
    print(`${label}: None`)
  }
}

function total(range: Range): int {
  let sum = 0
  for (const value of range) {
    sum += value
  }
  return sum
}

export function run(args: Array<string>): int uses io, alloc {
  // Math.clamp: None when the bounds are swapped.
  describe("clamp", Math.clamp(15, 0, 10))
  describe("clamp swapped", Math.clamp(5, 10, 0))

  // Math.powInt: None for a negative exponent.
  describe("powInt", Math.powInt(2, 10))
  describe("powInt negative", Math.powInt(2, -1))

  // Random.nextInt: None for an empty range.
  let random = Random.seeded(1)
  describe("nextInt empty", Random.nextInt(mutable random, 5, 5))
  describe("nextInt reversed", Random.nextInt(mutable random, 5, 1))
  describe("nextInt single", Random.nextInt(mutable random, 5, 6))

  // Arrays.filled: None for a negative count.
  if (Arrays.filled(7, 3) is Some(items)) {
    print(`filled length: ${Int.toString(Arrays.length(items))}`)
  }
  if (Arrays.filled(7, -1) is None) {
    print("filled negative: None")
  }

  // Ranges.stepped: None for a step of zero.
  if (Ranges.stepped(0, 10, 5) is Some(range)) {
    print(`stepped total: ${Int.toString(total(range))}`)
  }
  if (Ranges.stepped(0, 10, 0) is None) {
    print("stepped zero: None")
  }

  // Maps.update names the missing-key case.
  let counts = Map<string, int> {}
  Maps.update(mutable counts, "a", 0, (count) => count + 1)
  Maps.update(mutable counts, "a", 0, (count) => count + 1)
  Maps.update(mutable counts, "b", 10, (count) => count * 2)
  print(`counts a: ${Show.show(counts["a"])}`)
  print(`counts b: ${Show.show(counts["b"])}`)
  print(`counts c: ${Show.show(counts["c"])}`)
  return 0
}
