import * as Int from "std/int"
import * as Array from "std/array"

struct Entry<K, V> {
  key: K
  value: V
}

enum Tree {
  Leaf
  Node(label: string, size: int)
}

function first<T>(items: Array<T>): Option<T> {
  if (Array.length(items) == 0) {
    return None
  }
  return Some(items[0])
}

function lastOr<T>(items: Array<T>, fallback: T): T {
  const n = Array.length(items)
  if (n == 0) {
    return fallback
  }
  return items[n - 1]
}

function mapStrings<T>(items: Array<T>, label: string): Array<Entry<string, T>> {
  let out: Array<Entry<string, T>> = []
  for (const item of Array.values(items)) {
    Array.push(mutable out, Entry { key: label, value: item })
  }
  return out
}

function describe(o: Option<int>): string {
  return match (o) {
    Some(v) => `some ${Int.toString(v)}`
    None => "none"
  }
}

export function run(args: Array<string>): int {
  const nums: Array<int> = [4, 5, 6]
  const empty: Array<int> = []
  print(describe(first(nums)))
  print(describe(first(empty)))
  const words: Array<string> = ["a", "b"]
  const w = first(words)
  if (w is Some(text)) {
    print(`first word ${text}`)
  }
  print(lastOr(words, "none"))
  print(Int.toString(lastOr(empty, 99)))
  const entries = mapStrings(nums, "n")
  for (const e of Array.values(entries)) {
    print(`${e.key}=${Int.toString(e.value)}`)
  }
  const pair = Entry { key: 1, value: "one" }
  print(`${Int.toString(pair.key)} ${pair.value}`)
  const trees: Array<Tree> = [Leaf, Node("root", 3)]
  const t = first(trees)
  if (t is Some(tree)) {
    if (tree is Leaf) {
      print("leaf")
    }
  }
  return 0
}
