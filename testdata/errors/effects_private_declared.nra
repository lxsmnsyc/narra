}

function countAll<T, effect E>(source: Generator<T> uses E): int uses E {
  let total = 0
  for (const _value of source) {
    total = total + 1
  }
  return total
}

function hidden(): int uses alloc {
  return countAll(noisy())
}

export function run(args: Array<string>): int uses io, alloc {
