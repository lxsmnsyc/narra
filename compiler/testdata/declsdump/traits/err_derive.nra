struct Fn derives Equatable {
  f: (x: int) => int
}

struct Reading derives Hashable {
  value: f64
}

struct Both implements Show derives Show {
  n: int
}

implement Show for Both {
  function show(value: Both): string {
    return ""
  }
}

struct Custom derives Area {
  n: int
}

trait Area {
  function area(v: Self): int
}
