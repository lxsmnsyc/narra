// Type declarations, definitions, reference counting functions and enum
// allocation (emit_types.go, emit_box.go). Stub from selfhost-emit-core; the
// owner is selfhost-emit-decls. Every program has types and arrays, so the
// stubs always have work.
import { Type } from "narrac/types"
import { Emitter, Code, reportUnsupported } from "narrac/emitstate"
import * as Arrays from "std/array"

const NODE = "selfhost-emit-decls"

// emitHeapTypedefs writes the forward declarations of box and enum payload structs.
export function emitHeapTypedefs(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "heap typedefs", NODE)}\n`
}

// emitTypeDefinitions writes the struct of every type and the array structs.
export function emitTypeDefinitions(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "type definitions", NODE)}\n`
}

export function emitHeapDefinitions(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "heap definitions", NODE)}\n`
}

export function emitBoxPrototypes(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "box prototypes", NODE)}\n`
}

// emitRcFunctions writes the retain and release prototypes and functions of
// types, arrays and boxes.
export function emitRcFunctions(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "reference counting functions", NODE)}\n`
}

// enumAllocation is the C expression that builds an enum value of a variant
// from the C texts of its fields.
export function enumAllocation(mutable emitter: Emitter, enumType: Type, variant: int, fields: Array<string>): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "enum allocation", NODE), owned: false }
}
