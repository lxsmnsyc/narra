// error: match_block_values_mutable_conflict.nra:10:10: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function bump(mutable n: int): int {
  n = n + 1
  return 1
}

export function run(args: Array<string>): int {
  let x = 1
  const o: Option<int> = Some(2)
  return x + match (o) {
    Some(v) => {
      return bump(mutable x)
    }
    None => 0
  }
}
