import * as Simd from "std/simd"

export function scale(values: F32x4, factor: f32): F32x4 {
  return values * Simd.splat(factor)
}

export function run(_args: Array<string>): int {
  const point: F32x4 = [1.0, 2.0, 3.0, 4.0]
  const lanes = Simd.toFixed(scale(point, 2.0))
  const wide = Simd.splat<I64x4>(1)
  return wide[0] == 1 && lanes[0] == 2.0 ? 0 : 1
}
