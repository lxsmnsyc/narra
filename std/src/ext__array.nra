// std/array: helpers over Array. The functions that need the compiler are built in.

import * as Arrays from "std/array"

export function map<T, U, effect E>(
  items: Array<T>,
  change: (value: T) => U uses E,
): Array<U> uses alloc, E {
  let result: Array<U> = Arrays.withCapacity(Arrays.length(items))
  for (const item of items) {
    Arrays.push(mutable result, change(item))
  }
  return result
}

export function slice<T>(items: Array<T>, start: int, finish: int): Option<Array<T>> uses alloc {
  // A range outside the array has no slice.
  if (start < 0 || finish > Arrays.length(items) || start > finish) {
    return None
  }
  let result: Array<T> = Arrays.withCapacity(finish - start)
  for (let index = start; index < finish; index++) {
    Arrays.push(mutable result, copy(items[index]))
  }
  return Some(result)
}
