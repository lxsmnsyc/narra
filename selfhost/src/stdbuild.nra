// The registry rows of std/build.
import { StdFunc } from "narrac/builtins"
import { Emitter, Code, reportUnsupported } from "narrac/emitstate"
import { NODE, plain } from "narrac/stdemithelp"

export const BUILD_FUNCS: Array<StdFunc> = [
  // std/build is Narra source (std/src/build.nra): a module row with no function.
  StdFunc { name: "std/build", module: "std/build", key: "", check: "source" },
  // The primitives under hostTarget: codes from the C compiler's predefined macros.
  StdFunc {
    name: "Host.os",
    module: "std/internal/host",
    key: "os",
    parameters: [],
    result: "int",
  },
  StdFunc {
    name: "Host.arch",
    module: "std/internal/host",
    key: "arch",
    parameters: [],
    result: "int",
  },
]

export function emitHostCall(mutable emitter: Emitter, name: string): Code uses alloc {
  if (name == "Host.os") {
    return plain("narra_host_os()")
  }
  if (name == "Host.arch") {
    return plain("narra_host_arch()")
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
