// The parser, ported from compiler/internal/narra/parser.go (and the parse
// half of check_opaque.go). Each function ports the Go function of the same
// name without the parse, create or is prefix (Go's binary is parseBinary,
// tok is currentToken, posOf is getPos). `narrac parse` prints the same AST
// dump as `narra parse`.
//
// Error flow: Go's p.fail panics and file() recovers. Narra has no recover,
// so the first error is kept in Parser.failed. Once it is set, failAt keeps
// the first error, parse functions return dummy nodes, and every loop stops
// (each loop condition starts with isOk(parser)). The caller reads failed and
// throws the tree away.
//
// Node ids: every expression, pattern, parameter, VarStmt and ForStmt gets
// `id` from Parser.nextId when it is built, so a child usually has a smaller
// id than its parent. Ids are unique within one parse call and start at the
// firstId passed to parse; Parsed.nextId is the next free id, so a package
// can number all its files in one sequence. Ids can have gaps (an Ident that
// turns out to be the type name of a struct literal keeps its id unused).
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import { LexError, Token, TokenKind, formatLexError, lex, lexWithComments, hex } from "narrac/lexer"
import {
  Trivia,
  Collector,
  createCollector,
  noteNode,
  buildTrivia,
  getPosKey,
  getIdKey,
  getDeclPos,
  getStmtPos,
  getExprId,
  getPatternId,
} from "narrac/trivia"
import {
  Pos,
  File,
  ImportDecl,
  ImportName,
  TypeExpr,
  Param,
  FuncDecl,
  ConstDecl,
  FieldDecl,
  StructDecl,
  DistinctDecl,
  VariantDecl,
  EnumDecl,
  TestDecl,
  TraitDecl,
  ImplDecl,
  Decl,
  Block,
  Arg,
  FieldInit,
  FieldPattern,
  MatchArm,
  Stmt,
  Expr,
  Pattern,
  YieldBinding,
  LoopReference,
  SourceFacts,
  DotUse,
  createEmptyFacts,
} from "narrac/ast"
import { Fix, createFix, createEdit, insertAt, moveColumn } from "narrac/fixes"
import * as Arrays from "std/array"
import * as Boxes from "std/box"
import * as Ranges from "std/range"
import * as Maps from "std/map"

// A syntax error: `error <line>:<col>: <message>` in the dump.
export struct Diagnostic {
  code: string
  pos: Pos
  message: string
  fixes: Array<Fix> = []
}

export struct Parsed {
  file: File
  nextId: int // the first id not used by file
}

struct Parser {
  tokens: Array<Token>
  index: int
  nextId: int
  failed: Option<Diagnostic>
  // ternaryIds holds the ids of the block expressions that `c ? a : b` produced.
  ternaryIds: Array<int>
  // collector keeps the node ranges for parseWithTrivia; it does nothing
  // unless it is enabled.
  collector: Collector
  // typeNames are the type parameters of the declaration being parsed. A
  // lowercase one still counts as a type in `id<t>(x)`.
  typeNames: Array<string>
  // facts are the side tables for fixes; parse completes them with the source
  // facts (finishFacts). resultFunction is set inside a function declared to
  // return Result, where `throw x` can become `return Err(x)`.
  facts: SourceFacts
  resultFunction: bool
}

// The type parameters of `<A, B: Show & Ordered, effect E>`.
struct TypeParams {
  names: Array<string>
  bounds: Array<Array<TypeExpr>>
  effects: Array<string>
}

struct TraitLists {
  implementations: Array<TypeExpr>
  derived: Array<TypeExpr>
}

// Operator precedence, lowest first.
const BINARY_LEVELS = [
  ["||"],
  ["&&"],
  ["==", "!="],
  ["<", "<=", ">", ">="],
  ["|"],
  ["^"],
  ["&"],
  ["<<", ">>"],
  ["+", "-", "+%", "-%"],
  ["*", "/", "%", "*%"],
]

// `x is Pattern` binds tighter than == and looser than < and +.
const IS_LEVEL = 2

// parse lexes and parses src. Ids start at firstId. A lex or parse error
// gives the first error, as Go's Parse does.
export function parse(source: string, firstId: int): Result<Parsed, Diagnostic> uses alloc {
  const lexed = lex(source)
  if (lexed is Err(error)) {
    return Err(splitLexError(error))
  }
  let parser = Parser {
    tokens: lexed.value,
    index: 0,
    nextId: firstId,
    failed: None,
    ternaryIds: [],
    collector: createCollector(false),
    typeNames: [],
    facts: createEmptyFacts(),
    resultFunction: false,
  }
  const file = parseFile(mutable parser)
  if (parser.failed is Some(diagnostic)) {
    return Err(diagnostic)
  }
  const facts = finishFacts(parser, source)
  return Ok(Parsed { file: File { ...file, facts: facts }, nextId: parser.nextId })
}

// parseWithTrivia parses like parse and also returns the side tables of
// narrac/trivia: comments and where they attach, blank lines, written
// parentheses and node ends. The tree and the ids are the same as parse's.
export function parseWithTrivia(source: string, firstId: int): Result<#[
  Parsed,
  Trivia,
], Diagnostic> uses alloc {
  const lexed = lexWithComments(source)
  if (lexed is Err(error)) {
    return Err(splitLexError(error))
  }
  const #[tokens, comments] = lexed.value
  let parser = Parser {
    tokens: tokens,
    index: 0,
    nextId: firstId,
    failed: None,
    ternaryIds: [],
    collector: createCollector(true),
    typeNames: [],
    facts: createEmptyFacts(),
    resultFunction: false,
  }
  const file = parseFile(mutable parser)
  if (parser.failed is Some(diagnostic)) {
    return Err(diagnostic)
  }
  const trivia = buildTrivia(parser.collector, comments, source)
  const facts = finishFacts(parser, source)
  return Ok(#[Parsed { file: File { ...file, facts: facts }, nextId: parser.nextId }, trivia])
}

// ---- Source facts for fixes

// isAsciiLetter is true for A-Z, a-z and `_`, the start of a name in
// Go's templateDot pattern.
function isNameStart(character: char): bool {
  return (character >= 'a' && character <= 'z') ||
    (character >= 'A' && character <= 'Z') ||
    character == '_'
}

function isNameCharacter(character: char): bool {
  return isNameStart(character) || (character >= '0' && character <= '9')
}

// markTemplateDots notes each `Name.` inside the raw text of a template
// string. The parser keeps no positions inside ${...}, so a fix cannot rename a
// name used there.
function markTemplateDots(mutable names: Map<string, bool>, text: string) uses alloc {
  const characters = Str.chars(text)
  const count = Arrays.length(characters)
  let index = 0
  while (index < count) {
    if (!isNameStart(characters[index])) {
      index = index + 1
      continue
    }
    let end = index
    while (end < count && isNameCharacter(characters[end])) {
      end = end + 1
    }
    if (end < count && characters[end] == '.') {
      names[sliceText(characters, index, end)] = true
      index = end + 1
    } else {
      index = end
    }
  }
}

function sliceText(characters: Array<char>, first: int, last: int): string uses alloc {
  let builder = Str.builder()
  for (const index of Ranges.between(first, last)) {
    Str.appendChar(mutable builder, characters[index])
  }
  return Str.build(builder)
}

// findHeaderLine is the line after the leading comment block that a blank
// line follows; a comment right above a declaration is its doc comment.
function findHeaderLine(source: string): int uses alloc {
  let header = 1
  const lines = Str.split(source, "\n")
  let index = 0
  while (index < Arrays.length(lines) && Str.startsWith(lines[index], "//")) {
    if (index + 1 < Arrays.length(lines) && Str.trim(lines[index + 1]) == "") {
      header = index + 2
    }
    index = index + 1
  }
  return header
}

// finishFacts completes the side tables of a parse with what Go's Parse reads
// from the source and the tokens: the text, the header line, the names used in
// templates and the names written before a `.`.
function finishFacts(parser: Parser, source: string): SourceFacts uses alloc {
  let inTemplate: Map<string, bool> = Map {}
  let dotUses: Map<string, Array<DotUse>> = Map {}
  const count = Arrays.length(parser.tokens)
  for (const index of Ranges.upTo(count)) {
    const token = parser.tokens[index]
    if (token.kind == TokenKind.TokTemplate) {
      markTemplateDots(mutable inTemplate, token.text)
    }
    if (token.kind != TokenKind.TokIdent || index + 1 >= count) {
      continue
    }
    const next = parser.tokens[index + 1]
    if (next.kind != TokenKind.TokPunct || next.text != ".") {
      continue
    }
    if (index > 0) {
      const before = parser.tokens[index - 1]
      if (before.kind == TokenKind.TokPunct && before.text == ".") {
        continue
      }
    }
    let member = ""
    if (index + 2 < count && parser.tokens[index + 2].kind == TokenKind.TokIdent) {
      member = parser.tokens[index + 2].text
    }
    let known: Array<DotUse> = []
    if (dotUses[token.text] is Some(found)) {
      known = found
    }
    Arrays.push(mutable known, DotUse { pos: getPos(token), member: member })
    dotUses[token.text] = known
  }
  let referenced: Map<string, bool> = Map {}
  collectReferencedNames(mutable referenced, parser.tokens)
  return SourceFacts {
    source: source,
    header: findHeaderLine(source),
    inTemplate: inTemplate,
    dotUses: dotUses,
    namePositions: parser.facts.namePositions,
    shorthandIds: parser.facts.shorthandIds,
    callEnds: parser.facts.callEnds,
    referenced: referenced,
  }
}

// collectReferencedNames records the identifiers of tokens that are not
// written after a `.` and not inside an import declaration, which ends at
// its path string. The `${}` parts of a template are lexed and read the
// same way.
function collectReferencedNames(mutable names: Map<string, bool>, tokens: Array<Token>) uses alloc {
  let inImport = false
  for (const index of Ranges.upTo(Arrays.length(tokens))) {
    const token = tokens[index]
    if (token.kind == TokenKind.TokKeyword && token.text == "import") {
      inImport = true
      continue
    }
    if (inImport) {
      inImport = token.kind != TokenKind.TokString
      continue
    }
    if (token.kind == TokenKind.TokTemplate) {
      collectTemplateNames(mutable names, token.text)
      continue
    }
    if (token.kind != TokenKind.TokIdent) {
      continue
    }
    if (index > 0) {
      const before = tokens[index - 1]
      if (before.kind == TokenKind.TokPunct && before.text == ".") {
        continue
      }
    }
    names[token.text] = true
  }
}

// collectTemplateNames lexes each `${}` part of a template's text, as
// parseTemplate finds them, and records its names.
function collectTemplateNames(mutable names: Map<string, bool>, text: string) uses alloc {
  const raw = Str.chars(text)
  const count = Arrays.length(raw)
  let index = 0
  while (index < count) {
    if (raw[index] == '\\') {
      index = index + 2
      continue
    }
    if (raw[index] != '$' || index + 1 >= count || raw[index + 1] != '{') {
      index = index + 1
      continue
    }
    // Find the matching `}`.
    let depth = 1
    let closeIndex = index + 2
    while (closeIndex < count && depth > 0) {
      if (raw[closeIndex] == '{') {
        depth = depth + 1
      } else if (raw[closeIndex] == '}') {
        depth = depth - 1
      }
      closeIndex = closeIndex + 1
    }
    const lexed = lex(sliceText(raw, index + 2, closeIndex - 1))
    if (lexed is Ok(tokens)) {
      collectReferencedNames(mutable names, tokens)
    }
    index = closeIndex
  }
}

// getCallEnd is the position just after the `)` that closed a call. Inside a
// template string the tokens carry the template's position, so it is the
// template's position plus one, as in Go.
function getCallEnd(parser: Parser): Pos {
  return moveColumn(getPos(parser.tokens[parser.index - 1]), 1)
}

// ---- Trivia notes. Each does nothing unless the collector is enabled.

// getEndPos is the position after the last token consumed, not counting
// line breaks.
function getEndPos(parser: Parser): Pos {
  let index = parser.index - 1
  while (index >= 0 && parser.tokens[index].kind == TokenKind.TokNewline) {
    index = index - 1
  }
  if (index < 0) {
    return createEmptyPos()
  }
  const token = parser.tokens[index]
  return Pos { line: token.endLine, column: token.endColumn }
}

// noteKey records the node that started at token startIndex and ends at the
// last consumed token.
function noteKey(mutable parser: Parser, key: string, startIndex: int) {
  if (parser.collector.enabled && isOk(parser)) {
    const start = getPos(parser.tokens[startIndex])
    const end = getEndPos(parser)
    noteNode(mutable parser.collector, key, start, end)
  }
}

function noteExpr(mutable parser: Parser, startIndex: int, expression: Expr) {
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getIdKey(getExprId(expression)), startIndex)
  }
}

function noteType(mutable parser: Parser, startIndex: int, type: TypeExpr) {
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getPosKey("t", type.pos), startIndex)
  }
}

// formatDiagnostic formats an error as Go's Diagnostic.Error does.
export function formatDiagnostic(diagnostic: Diagnostic): string uses alloc {
  return `${Int.toString(diagnostic.pos.line)}:${Int.toString(diagnostic.pos.column)}: ${diagnostic.message}`
}

// splitLexError turns a lex error into a diagnostic (Go: syntaxDiagnostic).
function splitLexError(error: LexError): Diagnostic {
  return Diagnostic {
    code: error.code,
    pos: Pos { line: error.line, column: error.column },
    message: error.message,
    fixes: error.fixes,
  }
}

// ---- Tokens and errors

function isOk(parser: Parser): bool {
  return parser.failed is None
}

// failAt records the first error. Later errors are ignored, like the code
// after a Go panic that never runs.
function failAt(mutable parser: Parser, pos: Pos, code: string, message: string) {
  failAtFix(mutable parser, pos, code, [], message)
}

// failAtFix is failAt with the fixes of the error (Go's failFix).
function failAtFix(
  mutable parser: Parser,
  pos: Pos,
  code: string,
  fixes: Array<Fix>,
  message: string,
) {
  if (parser.failed is None) {
    parser.failed = Some(Diagnostic { code: code, pos: pos, message: message, fixes: fixes })
  }
}

// failHere fails at the current token.
function failHere(mutable parser: Parser, code: string, message: string) {
  const token = currentToken(parser)
  failAt(mutable parser, getPos(token), code, message)
}

// failFound fails at the current token with "<message>, found <token>".
function failFound(mutable parser: Parser, code: string, message: string) {
  const token = currentToken(parser)
  failAt(mutable parser, getPos(token), code, `${message}, found ${describeToken(token)}`)
}

function newId(mutable parser: Parser): int {
  const nodeId = parser.nextId
  parser.nextId = parser.nextId + 1
  return nodeId
}

function getPos(token: Token): Pos {
  return Pos { line: token.line, column: token.column }
}

function currentToken(parser: Parser): Token {
  return parser.tokens[parser.index]
}

// peekToken reads the token offset places ahead, or the last token (EOF) past the end.
// reportHabitWord fails on a TypeScript word that starts an expression: this,
// new, try and throw. token is the identifier just consumed.
function reportHabitWord(mutable parser: Parser, token: Token) {
  const pos = getPos(token)
  const next = currentToken(parser)
  if (token.text == "this") {
    failAt(mutable parser, pos, "E0928", "there is no `this`; pass the value as a parameter")
  }
  if (token.text == "new" && next.kind == TokenKind.TokIdent) {
    failAt(
      mutable parser,
      pos,
      "E0925",
      "there is no `new`; write a struct literal such as `Name { field: value }`, or call a function",
    )
  }
  if (token.text == "try" && next.kind == TokenKind.TokPunct && next.text == "{") {
    failAt(
      mutable parser,
      pos,
      "E0926",
      "there is no `try` or `catch`; return a `Result` and check it with `is Err` or `match`",
    )
  }
  if (token.text == "throw" && isThrowOperand(next)) {
    // Inside a function that returns a Result, a `throw` that starts its
    // statement becomes `return Err(value)`.
    let fixes: Array<Fix> = []
    if (parser.resultFunction && isStatementStart(parser)) {
      if (speculateExpression(mutable parser) is Some(end)) {
        fixes = [
          createFix("return an Err", [
            createEdit(pos, getPos(next), "return Err("),
            insertAt(end, ")"),
          ]),
        ]
      }
    }
    failAtFix(
      mutable parser,
      pos,
      "E0927",
      fixes,
      "there is no `throw`; return `Err(value)`, or call `panic` for a bug",
    )
  }
}

// isStatementStart tells whether the token just consumed, the one before
// the current token, begins a statement.
function isStatementStart(parser: Parser): bool {
  if (parser.index < 2) {
    return false
  }
  const before = parser.tokens[parser.index - 2]
  return before.kind == TokenKind.TokNewline ||
    (before.kind == TokenKind.TokPunct && (before.text == "{" || before.text == "}"))
}

// speculateExpression parses an expression at the current token and gives
// where it ends, which must be the end of the line or a `}`. The parser
// position is restored; a syntax error gives None.
function speculateExpression(mutable parser: Parser): Option<Pos> uses alloc {
  const savedIndex = parser.index
  const savedId = parser.nextId
  parseExpr(mutable parser)
  let end: Option<Pos> = None
  if (isOk(parser)) {
    const last = parser.tokens[parser.index - 1]
    const after = currentToken(parser)
    if (
      after.kind == TokenKind.TokNewline || (after.kind == TokenKind.TokPunct && after.text == "}")
    ) {
      end = Some(Pos { line: last.endLine, column: last.endColumn })
    }
  }
  parser.index = savedIndex
  parser.nextId = savedId
  parser.failed = None
  return end
}

// isThrowOperand tells whether a token can start the value after `throw`.
function isThrowOperand(token: Token): bool {
  const kind = token.kind
  return kind == TokenKind.TokIdent ||
    kind == TokenKind.TokString ||
    kind == TokenKind.TokTemplate ||
    kind == TokenKind.TokInt ||
    kind == TokenKind.TokFloat ||
    kind == TokenKind.TokChar
}

function peekToken(parser: Parser, offset: int): Token {
  const count = Arrays.length(parser.tokens)
  if (parser.index + offset < count) {
    return parser.tokens[parser.index + offset]
  }
  return parser.tokens[count - 1]
}

// advance is Go's next: it returns the token and moves on, but never past EOF.
function advance(mutable parser: Parser): Token {
  const token = parser.tokens[parser.index]
  if (parser.index < Arrays.length(parser.tokens) - 1) {
    parser.index = parser.index + 1
  }
  return token
}

// isAt is Go's is: the current token is that punctuation or keyword.
function isAt(parser: Parser, text: string): bool {
  const token = parser.tokens[parser.index]
  return (token.kind == TokenKind.TokPunct || token.kind == TokenKind.TokKeyword) &&
    token.text == text
}

function accept(mutable parser: Parser, text: string): bool {
  if (isAt(parser, text)) {
    advance(mutable parser)
    return true
  }
  return false
}

function expect(mutable parser: Parser, text: string): Token {
  if (!isAt(parser, text)) {
    const token = currentToken(parser)
    failAt(
      mutable parser,
      getPos(token),
      "E0011",
      `expected "${text}", found ${describeToken(token)}`,
    )
    return token
  }
  return advance(mutable parser)
}

function expectIdent(mutable parser: Parser): Token {
  const token = currentToken(parser)
  if (token.kind != TokenKind.TokIdent) {
    failAt(mutable parser, getPos(token), "E0012", `expected a name, found ${describeToken(token)}`)
    return token
  }
  if (token.text == "this") {
    failAt(
      mutable parser,
      getPos(token),
      "E0928",
      "there is no `this`; pass the value as a parameter",
    )
  }
  return advance(mutable parser)
}

function isWord(parser: Parser, word: string): bool {
  const token = parser.tokens[parser.index]
  return token.kind == TokenKind.TokIdent && token.text == word
}

function skipNewlines(mutable parser: Parser) {
  while (currentToken(parser).kind == TokenKind.TokNewline) {
    advance(mutable parser)
  }
}

// endStatement accepts the end of a statement: a line break, or a closing
// brace or end of file that follows on the same line.
function endStatement(mutable parser: Parser) {
  const token = currentToken(parser)
  if (token.kind == TokenKind.TokNewline) {
    skipNewlines(mutable parser)
  } else if (isAt(parser, "}") || token.kind == TokenKind.TokEof) {
    return
  } else {
    failAt(
      mutable parser,
      getPos(token),
      "E0013",
      `expected the end of the statement, found ${describeToken(token)}`,
    )
  }
}

// endTypeDecl ends a declaration whose last token is a type. The lexer emits
// no line break after a `>`, so the next token on a later line ends it.
function endTypeDecl(mutable parser: Parser) {
  if (parser.index > 0) {
    const previous = parser.tokens[parser.index - 1]
    const current = currentToken(parser)
    if (
      previous.kind == TokenKind.TokPunct && previous.text == ">" && current.line > previous.line
    ) {
      return
    }
  }
  endStatement(mutable parser)
}

function describeToken(token: Token): string {
  if (token.kind == TokenKind.TokEof) {
    return "end of file"
  }
  if (token.kind == TokenKind.TokNewline) {
    return "line break"
  }
  return quoteGo(token.text)
}

// quoteGo copies Go's strconv.Quote. Of the non-ASCII characters it escapes
// only the C1 controls and the common spaces and format characters that Go
// does not count as printable; the rest are written as they are.
export function quoteGo(text: string): string uses alloc {
  let builder = Str.builder()
  Str.append(mutable builder, "\"")
  for (const character of Arrays.values(Str.chars(text))) {
    const code = Char.code(character)
    if (character == '"') {
      Str.append(mutable builder, "\\\"")
    } else if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (code == 7) {
      Str.append(mutable builder, "\\a")
    } else if (code == 8) {
      Str.append(mutable builder, "\\b")
    } else if (code == 12) {
      Str.append(mutable builder, "\\f")
    } else if (code == 10) {
      Str.append(mutable builder, "\\n")
    } else if (code == 13) {
      Str.append(mutable builder, "\\r")
    } else if (code == 9) {
      Str.append(mutable builder, "\\t")
    } else if (code == 11) {
      Str.append(mutable builder, "\\v")
    } else if (code < 0x20 || code == 0x7f) {
      Str.append(mutable builder, `\\x${hex(code, 2)}`)
    } else if (notPrintable(code)) {
      Str.append(mutable builder, `\\u${hex(code, 4)}`)
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  Str.append(mutable builder, "\"")
  return Str.build(builder)
}

function notPrintable(code: int): bool {
  return (code >= 0x80 && code <= 0xa0) ||
    code == 0xad ||
    code == 0x1680 ||
    (code >= 0x2000 && code <= 0x200f) ||
    (code >= 0x2028 && code <= 0x202f) ||
    (code >= 0x205f && code <= 0x2064) ||
    code == 0x3000 ||
    code == 0xfeff
}

// ---- Dummy nodes, returned once parsing has failed

function createEmptyPos(): Pos {
  return Pos { line: 0, column: 0 }
}

function createDummyExpr(): Expr {
  return Expr.Ident(-1, createEmptyPos(), "")
}

function createDummyType(): TypeExpr {
  return TypeExpr {
    pos: createEmptyPos(),
    name: "",
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
  }
}

function createDummyBlock(): Block {
  return Block { pos: createEmptyPos(), statements: [] }
}

function createDummyPattern(): Pattern {
  return Pattern.PatWildcard(-1, createEmptyPos())
}

// ---- Declarations

function parseFile(mutable parser: Parser): File {
  let imports: Array<ImportDecl> = []
  let declarations: Array<Decl> = []
  skipNewlines(mutable parser)
  while (isOk(parser) && isAt(parser, "import")) {
    Arrays.push(mutable imports, parseImport(mutable parser))
    skipNewlines(mutable parser)
  }
  while (isOk(parser) && currentToken(parser).kind != TokenKind.TokEof) {
    parser.typeNames = []
    Arrays.push(mutable declarations, parseDecl(mutable parser))
    skipNewlines(mutable parser)
  }
  return File { imports: imports, declarations: declarations, facts: createEmptyFacts() }
}

function parseImport(mutable parser: Parser): ImportDecl {
  const startIndex = parser.index
  const pos = getPos(expect(mutable parser, "import"))
  let alias = ""
  let aliasPos = createEmptyPos()
  let names: Array<ImportName> = []
  if (accept(mutable parser, "*")) {
    expect(mutable parser, "as")
    const aliasToken = expectIdent(mutable parser)
    alias = aliasToken.text
    aliasPos = getPos(aliasToken)
  } else if (accept(mutable parser, "{")) {
    skipNewlines(mutable parser)
    while (isOk(parser) && !isAt(parser, "}")) {
      const nameToken = expectIdent(mutable parser)
      const name = nameToken.text
      let local = name
      let end = moveColumn(getPos(nameToken), Str.charCount(name))
      if (accept(mutable parser, "as")) {
        const localToken = expectIdent(mutable parser)
        local = localToken.text
        end = moveColumn(getPos(localToken), Str.charCount(local))
      }
      Arrays.push(mutable names, ImportName {
        pos: getPos(nameToken),
        name: name,
        local: local,
        end: end,
      })
      skipNewlines(mutable parser)
      if (!accept(mutable parser, ",")) {
        break
      }
      skipNewlines(mutable parser)
    }
    skipNewlines(mutable parser)
    expect(mutable parser, "}")
  } else {
    const at = getPos(currentToken(parser))
    let fixes: Array<Fix> = []
    if (currentToken(parser).kind == TokenKind.TokIdent) {
      fixes = [createFix("import the module as a namespace", [insertAt(at, "* as ")])]
    }
    failAtFix(
      mutable parser,
      at,
      "E0014",
      fixes,
      "use `import * as Name from \"path\"` or `import { a, b } from \"path\"`; there are no default imports",
    )
  }
  expect(mutable parser, "from")
  let path = ""
  if (currentToken(parser).kind != TokenKind.TokString) {
    failHere(mutable parser, "E0015", "expected a module path string")
  } else {
    path = advance(mutable parser).text
  }
  endStatement(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("i", pos), startIndex)
  }
  return ImportDecl { pos: pos, alias: alias, aliasPos: aliasPos, names: names, path: path }
}

// isFieldsOnlyBody reports whether the tokens after the current `class` or
// `interface` are `Name {` and then lines of `field: type`, with no method,
// modifier, separator or generic parameter.
function isFieldsOnlyBody(parser: Parser): bool {
  const name = peekToken(parser, 1)
  const open = peekToken(parser, 2)
  if (name.kind != TokenKind.TokIdent || open.kind != TokenKind.TokPunct || open.text != "{") {
    return false
  }
  let offset = 3
  while (true) {
    while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
      offset = offset + 1
    }
    const field = peekToken(parser, offset)
    if (field.kind == TokenKind.TokPunct && field.text == "}") {
      return true
    }
    const colon = peekToken(parser, offset + 1)
    if (field.kind != TokenKind.TokIdent || colon.kind != TokenKind.TokPunct || colon.text != ":") {
      return false
    }
    offset = offset + 2
    // The type runs to the end of the line.
    while (peekToken(parser, offset).kind != TokenKind.TokNewline) {
      const part = peekToken(parser, offset)
      if (part.kind == TokenKind.TokEof) {
        return false
      }
      if (part.kind == TokenKind.TokPunct && isTypeBreaker(part.text)) {
        return false
      }
      offset = offset + 1
    }
  }
  return false
}

// isTypeBreaker is true for punctuation that cannot be part of a plain field type.
function isTypeBreaker(text: string): bool {
  return text == ";" ||
    text == "," ||
    text == "{" ||
    text == "}" ||
    text == "?" ||
    text == "(" ||
    text == "="
}

function parseDecl(mutable parser: Parser): Decl {
  const startIndex = parser.index
  const declaration = parseDeclBody(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("d", getDeclPos(declaration)), startIndex)
  }
  return declaration
}

function parseDeclBody(mutable parser: Parser): Decl {
  const exported = accept(mutable parser, "export")
  const special = parseOpaqueOrDistinct(mutable parser, exported)
  if (special is Some(declaration)) {
    return declaration
  }
  if (isAt(parser, "function")) {
    return Decl.Func(parseFuncDecl(mutable parser, exported))
  }
  if (isAt(parser, "const")) {
    return Decl.Const(parseConstDecl(mutable parser, exported))
  }
  if (isAt(parser, "struct")) {
    return Decl.Struct(parseStructDecl(mutable parser, exported))
  }
  if (isAt(parser, "enum")) {
    return Decl.Enum(parseEnumDecl(mutable parser, exported))
  }
  if (isAt(parser, "trait")) {
    return Decl.Trait(parseTraitDecl(mutable parser, exported))
  }
  if (isAt(parser, "implement")) {
    if (exported) {
      failHere(
        mutable parser,
        "E0016",
        "implement blocks cannot be exported; export the trait and the type",
      )
    }
    return Decl.Impl(parseImplDecl(mutable parser))
  }
  if (isAt(parser, "test")) {
    if (exported) {
      failHere(mutable parser, "E0017", "tests cannot be exported")
    }
    const pos = getPos(advance(mutable parser))
    let name = ""
    if (currentToken(parser).kind != TokenKind.TokString) {
      failHere(mutable parser, "E0018", "expected the test name as a string")
    } else {
      name = advance(mutable parser).text
    }
    return Decl.Test(TestDecl { pos: pos, name: name, body: parseBlock(mutable parser) })
  }
  const token = currentToken(parser)
  if (token.kind == TokenKind.TokIdent && (token.text == "class" || token.text == "interface")) {
    // The fix renames the keyword to `struct` only when the body holds fields
    // and nothing else, because only then the result is a valid struct.
    let fixes: Array<Fix> = []
    if (isFieldsOnlyBody(parser)) {
      const end = Pos { line: token.endLine, column: token.endColumn }
      fixes = [createFix("use struct", [createEdit(getPos(token), end, "struct")])]
    }
    if (token.text == "class") {
      failAtFix(
        mutable parser,
        getPos(token),
        "E0923",
        fixes,
        "there is no `class`; use a `struct` and functions in a module",
      )
    } else {
      failAtFix(
        mutable parser,
        getPos(token),
        "E0924",
        fixes,
        "there is no `interface`; use a `struct` for data or a `trait` for behavior",
      )
    }
  }
  failAt(
    mutable parser,
    getPos(token),
    "E0019",
    `expected a declaration, found ${describeToken(token)}`,
  )
  return Decl.Test(TestDecl { pos: createEmptyPos(), name: "", body: createDummyBlock() })
}

// parseOpaqueOrDistinct parses `opaque struct`, `distinct type` and
// `opaque distinct type` after an optional `export` (Go: check_opaque.go).
// It returns None when the declaration is none of them.
function parseOpaqueOrDistinct(mutable parser: Parser, exported: bool): Option<Decl> {
  let opaque = false
  if (isWord(parser, "opaque")) {
    if (!exported) {
      failHere(
        mutable parser,
        "E0043",
        "only an exported type can be opaque; write `export opaque`",
      )
    }
    advance(mutable parser)
    opaque = true
  }
  if (isAt(parser, "struct") && opaque) {
    const structDeclaration = parseStructDecl(mutable parser, exported)
    return Some(Decl.Struct(StructDecl { ...structDeclaration, opaque: true }))
  }
  if (isWord(parser, "distinct")) {
    const pos = getPos(advance(mutable parser))
    if (!isWord(parser, "type")) {
      failFound(mutable parser, "E0044", `expected \`type\` after \`distinct\``)
    }
    advance(mutable parser)
    const name = expectIdent(mutable parser).text
    expect(mutable parser, "=")
    const base = parseType(mutable parser)
    endTypeDecl(mutable parser)
    return Some(
      Decl.Distinct(DistinctDecl {
        pos: pos,
        name: name,
        exported: exported,
        opaque: opaque,
        base: base,
      }),
    )
  }
  if (opaque) {
    failFound(mutable parser, "E0045", `expected \`struct\` or \`distinct type\` after \`opaque\``)
  }
  return None
}

function parseType(mutable parser: Parser): TypeExpr {
  const startIndex = parser.index
  const type = parseTypeBody(mutable parser)
  noteType(mutable parser, startIndex, type)
  return type
}

function parseTypeBody(mutable parser: Parser): TypeExpr {
  if (isAt(parser, "(")) {
    return parseFuncType(mutable parser)
  }
  if (isAt(parser, "#[")) {
    // A tuple type, written like the literal: #[int, string].
    const pos = getPos(advance(mutable parser))
    let arguments: Array<TypeExpr> = []
    while (isOk(parser) && !isAt(parser, "]")) {
      Arrays.push(mutable arguments, parseType(mutable parser))
      if (!accept(mutable parser, ",")) {
        break
      }
    }
    expect(mutable parser, "]")
    return TypeExpr {
      pos: pos,
      name: "",
      arguments: arguments,
      isFunc: false,
      result: None,
      effects: [],
      isTuple: true,
    }
  }
  const token = expectIdent(mutable parser)
  if (!isOk(parser)) {
    return createDummyType()
  }
  let name = token.text
  if (accept(mutable parser, ".")) {
    // a type from a namespace import, such as Text.Token
    name = `${name}.${expectIdent(mutable parser).text}`
  }
  let arguments: Array<TypeExpr> = []
  const named = TypeExpr {
    pos: getPos(token),
    name: name,
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
  }
  if (accept(mutable parser, "<")) {
    while (isOk(parser)) {
      Arrays.push(mutable arguments, parseType(mutable parser))
      if (!accept(mutable parser, ",")) {
        break
      }
    }
    // In `Array<Array<int>>` the lexer reads `>>` as one token. Split it.
    if (isAt(parser, ">>")) {
      const shift = currentToken(parser)
      parser.tokens[parser.index] = Token { ...shift, text: ">", column: shift.column + 1 }
      return TypeExpr { ...named, arguments: arguments }
    }
    expect(mutable parser, ">")
  }
  if (name == "Generator" || name == "Coroutine") {
    // A generator type carries the effects its body has when it runs:
    // `Generator<string> uses io` (D78).
    const effects = parseUsesList(mutable parser)
    if (Arrays.length(effects) > 0) {
      return TypeExpr { ...named, arguments: arguments, effects: effects }
    }
  }
  const after = peekToken(parser, 1)
  if (isAt(parser, "[") && after.kind == TokenKind.TokPunct && after.text == "]") {
    const open = getPos(currentToken(parser))
    const shut = moveColumn(getPos(after), 1)
    failAtFix(
      mutable parser,
      open,
      "E0020",
      [createFix("write Array<...>", [insertAt(named.pos, "Array<"), createEdit(open, shut, ">")])],
      "there is no `T[]` array type; write `Array<T>`",
    )
  }
  return TypeExpr { ...named, arguments: arguments }
}

// parseTypeParams parses `<A, B: Show & Ordered, effect E>`. Effect
// variables are returned apart from the type parameters.
function parseTypeParams(mutable parser: Parser): TypeParams {
  let names: Array<string> = []
  let bounds: Array<Array<TypeExpr>> = []
  let effects: Array<string> = []
  if (!accept(mutable parser, "<")) {
    return TypeParams { names: names, bounds: bounds, effects: effects }
  }
  while (isOk(parser) && !isAt(parser, ">")) {
    const token = currentToken(parser)
    if (
      token.kind == TokenKind.TokIdent &&
        token.text == "effect" &&
        peekToken(parser, 1).kind == TokenKind.TokIdent
    ) {
      advance(mutable parser)
      Arrays.push(mutable effects, expectIdent(mutable parser).text)
      if (!accept(mutable parser, ",")) {
        break
      }
      continue
    }
    const parameterName = expectIdent(mutable parser).text
    Arrays.push(mutable names, parameterName)
    Arrays.push(mutable parser.typeNames, parameterName)
    let traitBounds: Array<TypeExpr> = []
    if (accept(mutable parser, ":")) {
      while (isOk(parser)) {
        const boundName = expectIdent(mutable parser)
        Arrays.push(mutable traitBounds, createNamedType(boundName))
        if (!accept(mutable parser, "&")) {
          break
        }
      }
    }
    Arrays.push(mutable bounds, traitBounds)
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  expect(mutable parser, ">")
  return TypeParams { names: names, bounds: bounds, effects: effects }
}

// createNamedType is a TypeExpr with only a name, for trait names.
function createNamedType(token: Token): TypeExpr {
  return TypeExpr {
    pos: getPos(token),
    name: token.text,
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
  }
}

// parseTypeParamsNoBounds parses type parameters of a struct or enum, which cannot
// have constraints in this compiler.
function parseTypeParamsNoBounds(mutable parser: Parser): Array<string> {
  const pos = getPos(currentToken(parser))
  const typeParameters = parseTypeParams(mutable parser)
  for (const traitBounds of Arrays.values(typeParameters.bounds)) {
    if (Arrays.length(traitBounds) > 0) {
      failAt(
        mutable parser,
        pos,
        "E0021",
        "trait constraints on struct and enum type parameters are not supported by this compiler yet",
      )
    }
  }
  return typeParameters.names
}

// parseConstDecl parses a top-level `const NAME: T = value`.
function parseConstDecl(mutable parser: Parser, exported: bool): ConstDecl {
  const pos = getPos(expect(mutable parser, "const"))
  const name = expectIdent(mutable parser).text
  let declaredType: Option<TypeExpr> = None
  if (accept(mutable parser, ":")) {
    declaredType = Some(parseType(mutable parser))
  }
  expect(mutable parser, "=")
  const value = parseExpr(mutable parser)
  endStatement(mutable parser)
  return ConstDecl { pos: pos, name: name, exported: exported, type: declaredType, value: value }
}

function parseFuncDecl(mutable parser: Parser, exported: bool): FuncDecl {
  const header = parseFuncHeader(mutable parser, exported)
  const savedResult = parser.resultFunction
  parser.resultFunction = false
  if (header.result is Some(resultType)) {
    parser.resultFunction = resultType.name == "Result"
  }
  const body = parseBlock(mutable parser)
  parser.resultFunction = savedResult
  return FuncDecl { ...header, body: Some(body) }
}

// parseFuncHeader parses a function declaration up to its body.
function parseFuncHeader(mutable parser: Parser, exported: bool): FuncDecl {
  const pos = getPos(expect(mutable parser, "function"))
  const generator = accept(mutable parser, "*")
  const name = expectIdent(mutable parser).text
  const typeParameters = parseTypeParams(mutable parser)
  expect(mutable parser, "(")
  let parameters: Array<Param> = []
  while (isOk(parser) && !isAt(parser, ")")) {
    const paramPos = getPos(currentToken(parser))
    const paramStart = parser.index
    const isMutable = accept(mutable parser, "mutable")
    let escaping = false
    if (!isMutable) {
      escaping = acceptEscaping(mutable parser)
    }
    const paramNameToken = expectIdent(mutable parser)
    const paramName = paramNameToken.text
    expect(mutable parser, ":")
    const paramType = parseType(mutable parser)
    const paramId = newId(mutable parser)
    parser.facts.namePositions[paramId] = getPos(paramNameToken)
    Arrays.push(mutable parameters, Param {
      id: paramId,
      pos: paramPos,
      name: paramName,
      isMutable: isMutable,
      type: Some(paramType),
      escaping: escaping,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getIdKey(paramId), paramStart)
    }
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  expect(mutable parser, ")")
  let result: Option<TypeExpr> = None
  if (accept(mutable parser, ":")) {
    result = Some(parseType(mutable parser))
  }
  const effects = parseUsesList(mutable parser)
  return FuncDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters.names,
    bounds: typeParameters.bounds,
    exported: exported,
    generator: generator,
    parameters: parameters,
    result: result,
    effects: effects,
    effectParameters: typeParameters.effects,
    body: None,
  }
}

function parseFieldList(mutable parser: Parser): Array<FieldDecl> {
  let fields: Array<FieldDecl> = []
  skipNewlines(mutable parser)
  while (isOk(parser) && !isAt(parser, "}")) {
    const pos = getPos(currentToken(parser))
    const fieldStart = parser.index
    const name = expectIdent(mutable parser).text
    expect(mutable parser, ":")
    const fieldType = parseType(mutable parser)
    let defaultValue: Option<Expr> = None
    if (accept(mutable parser, "=")) {
      defaultValue = Some(parseExpr(mutable parser))
    }
    Arrays.push(mutable fields, FieldDecl {
      pos: pos,
      name: name,
      type: fieldType,
      default: defaultValue,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("f", pos), fieldStart)
    }
    accept(mutable parser, ",")
    skipNewlines(mutable parser)
  }
  return fields
}

function parseStructDecl(mutable parser: Parser, exported: bool): StructDecl {
  const pos = getPos(expect(mutable parser, "struct"))
  const name = expectIdent(mutable parser).text
  const typeParameters = parseTypeParamsNoBounds(mutable parser)
  const traitLists = parseTraitLists(mutable parser)
  expect(mutable parser, "{")
  const fields = parseFieldList(mutable parser)
  expect(mutable parser, "}")
  return StructDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters,
    exported: exported,
    implementations: traitLists.implementations,
    derived: traitLists.derived,
    fields: fields,
    opaque: false,
  }
}

function parseEnumDecl(mutable parser: Parser, exported: bool): EnumDecl {
  const pos = getPos(expect(mutable parser, "enum"))
  const name = expectIdent(mutable parser).text
  const typeParameters = parseTypeParamsNoBounds(mutable parser)
  const traitLists = parseTraitLists(mutable parser)
  expect(mutable parser, "{")
  skipNewlines(mutable parser)
  let variants: Array<VariantDecl> = []
  while (isOk(parser) && !isAt(parser, "}")) {
    const variantPos = getPos(currentToken(parser))
    const variantStart = parser.index
    const variantName = expectIdent(mutable parser).text
    let fields: Array<FieldDecl> = []
    if (accept(mutable parser, "(")) {
      while (isOk(parser) && !isAt(parser, ")")) {
        const fieldPos = getPos(currentToken(parser))
        const fieldStart = parser.index
        const fieldName = expectIdent(mutable parser).text
        expect(mutable parser, ":")
        const fieldType = parseType(mutable parser)
        Arrays.push(mutable fields, FieldDecl {
          pos: fieldPos,
          name: fieldName,
          type: fieldType,
          default: None,
        })
        if (parser.collector.enabled) {
          noteKey(mutable parser, getPosKey("f", fieldPos), fieldStart)
        }
        if (!accept(mutable parser, ",")) {
          break
        }
      }
      expect(mutable parser, ")")
    }
    Arrays.push(mutable variants, VariantDecl {
      pos: variantPos,
      name: variantName,
      fields: fields,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("v", variantPos), variantStart)
    }
    accept(mutable parser, ",")
    skipNewlines(mutable parser)
  }
  expect(mutable parser, "}")
  return EnumDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters,
    exported: exported,
    implementations: traitLists.implementations,
    derived: traitLists.derived,
    variants: variants,
  }
}

// parseTraitLists parses `implements A, B` and `derives C, D` after a type name.
function parseTraitLists(mutable parser: Parser): TraitLists {
  let implementations: Array<TypeExpr> = []
  let derived: Array<TypeExpr> = []
  if (accept(mutable parser, "implements")) {
    implementations = parseTraitNames(mutable parser)
  }
  if (accept(mutable parser, "derives")) {
    derived = parseTraitNames(mutable parser)
  }
  return TraitLists { implementations: implementations, derived: derived }
}

function parseTraitNames(mutable parser: Parser): Array<TypeExpr> {
  let traits: Array<TypeExpr> = []
  while (isOk(parser)) {
    const traitStart = parser.index
    const token = expectIdent(mutable parser)
    const traitType = createNamedType(token)
    Arrays.push(mutable traits, traitType)
    noteType(mutable parser, traitStart, traitType)
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  return traits
}

function parseTraitDecl(mutable parser: Parser, exported: bool): TraitDecl {
  const pos = getPos(expect(mutable parser, "trait"))
  const name = expectIdent(mutable parser).text
  if (isAt(parser, "<")) {
    failHere(
      mutable parser,
      "E0023",
      "a trait has no type parameters; use Self for the implementing type",
    )
  }
  expect(mutable parser, "{")
  skipNewlines(mutable parser)
  let functions: Array<FuncDecl> = []
  while (isOk(parser) && !isAt(parser, "}")) {
    if (!isAt(parser, "function")) {
      failFound(mutable parser, "E0024", `a trait has functions only`)
      break
    }
    const functionStart = parser.index
    rejectNestedGenerator(mutable parser)
    const header = parseFuncHeader(mutable parser, false)
    if (isAt(parser, "{")) {
      failHere(
        mutable parser,
        "E0025",
        "trait functions have no default implementation; remove the body",
      )
    }
    Arrays.push(mutable functions, header)
    endTypeDecl(mutable parser)
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("d", header.pos), functionStart)
    }
  }
  expect(mutable parser, "}")
  return TraitDecl { pos: pos, name: name, exported: exported, functions: functions }
}

// rejectNestedGenerator rejects `function*` in a trait or an implement
// block: a generator is a top-level function (D74).
function rejectNestedGenerator(mutable parser: Parser) {
  const next = peekToken(parser, 1)
  if (next.kind == TokenKind.TokPunct && next.text == "*") {
    failAt(
      mutable parser,
      getPos(next),
      "E0046",
      "a generator must be a top-level function; declare `function*` at module level",
    )
  }
}

function parseImplDecl(mutable parser: Parser): ImplDecl {
  const pos = getPos(expect(mutable parser, "implement"))
  const traitStart = parser.index
  const token = expectIdent(mutable parser)
  const traitType = createNamedType(token)
  noteType(mutable parser, traitStart, traitType)
  expect(mutable parser, "for")
  const declaredType = parseType(mutable parser)
  expect(mutable parser, "{")
  skipNewlines(mutable parser)
  let functions: Array<FuncDecl> = []
  while (isOk(parser) && !isAt(parser, "}")) {
    if (isAt(parser, "export")) {
      failHere(mutable parser, "E0026", "functions in an implement block cannot be exported")
      break
    }
    if (!isAt(parser, "function")) {
      failFound(mutable parser, "E0027", `an implement block has functions only`)
      break
    }
    const functionStart = parser.index
    rejectNestedGenerator(mutable parser)
    const implFunction = parseFuncDecl(mutable parser, false)
    Arrays.push(mutable functions, implFunction)
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("d", implFunction.pos), functionStart)
    }
    skipNewlines(mutable parser)
  }
  expect(mutable parser, "}")
  return ImplDecl { pos: pos, traitType: traitType, type: declaredType, functions: functions }
}

// parseFuncType parses a function type such as `(item: T) => U`. Parameter
// names are optional and ignored.
function parseFuncType(mutable parser: Parser): TypeExpr {
  const pos = getPos(expect(mutable parser, "("))
  let arguments: Array<TypeExpr> = []
  while (isOk(parser) && !isAt(parser, ")")) {
    const colon = peekToken(parser, 1)
    if (
      currentToken(parser).kind == TokenKind.TokIdent &&
        colon.kind == TokenKind.TokPunct &&
        colon.text == ":"
    ) {
      advance(mutable parser)
      advance(mutable parser)
    }
    Arrays.push(mutable arguments, parseType(mutable parser))
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  expect(mutable parser, ")")
  expect(mutable parser, "=>")
  const result = parseType(mutable parser)
  const effects = parseUsesList(mutable parser)
  return TypeExpr {
    pos: pos,
    name: "",
    arguments: arguments,
    isFunc: true,
    result: Some(Boxes.new(result)),
    effects: effects,
    isTuple: false,
  }
}

// parseUsesList reads an optional `uses a, b` list of effect names.
function parseUsesList(mutable parser: Parser): Array<string> {
  let names: Array<string> = []
  if (accept(mutable parser, "uses")) {
    while (isOk(parser)) {
      Arrays.push(mutable names, expectIdent(mutable parser).text)
      if (isAt(parser, ",") && isParamAfterComma(parser)) {
        break
      }
      if (!accept(mutable parser, ",")) {
        break
      }
    }
  }
  return names
}

// acceptEscaping accepts the `escaping` marker before a parameter name.
// It is not a keyword, so a parameter can still be named escaping.
function acceptEscaping(mutable parser: Parser): bool {
  const token = currentToken(parser)
  if (
    token.kind == TokenKind.TokIdent &&
      token.text == "escaping" &&
      peekToken(parser, 1).kind == TokenKind.TokIdent
  ) {
    advance(mutable parser)
    return true
  }
  return false
}

// isParamAfterComma reports whether the `,` at the current token is followed
// by `name:`, `mutable name` or `escaping name`, the next parameter of a
// function. It ends a `uses` list written inside a parameter list. (This is
// the version of PR #21, which also accepts `mutable`.)
function isParamAfterComma(parser: Parser): bool {
  if (parser.index + 2 >= Arrays.length(parser.tokens)) {
    return false
  }
  const nextToken = parser.tokens[parser.index + 1]
  if (
    nextToken.kind != TokenKind.TokIdent &&
      !(nextToken.kind == TokenKind.TokKeyword && nextToken.text == "mutable")
  ) {
    return false
  }
  const afterNext = parser.tokens[parser.index + 2]
  return afterNext.kind == TokenKind.TokIdent ||
    (afterNext.kind == TokenKind.TokPunct && afterNext.text == ":")
}

// ---- Statements

// isArrowAhead reports whether the `(` at the current token starts an arrow
// function: its matching `)` is followed by `=>` or by `:` and a result type.
function isArrowAhead(parser: Parser): bool {
  let depth = 0
  let index = parser.index
  const count = Arrays.length(parser.tokens)
  while (index < count) {
    const token = parser.tokens[index]
    if (token.kind == TokenKind.TokEof) {
      return false
    }
    if (token.kind == TokenKind.TokPunct) {
      if (token.text == "(") {
        depth = depth + 1
      } else if (token.text == ")") {
        depth = depth - 1
        if (depth == 0) {
          if (index + 1 >= count || parser.tokens[index + 1].kind != TokenKind.TokPunct) {
            return false
          }
          const after = parser.tokens[index + 1].text
          if (after == ":") {
            return isResultTypeThenArrow(parser, index + 2)
          }
          return after == "=>"
        }
      }
    }
    index = index + 1
  }
  return false
}

// isResultTypeThenArrow tells an arrow's `: R =>` from the `:` of a conditional
// expression such as `c ? (a) : b`. From the token after the `:`, it looks for
// a `=>` outside brackets before anything that ends an expression.
function isResultTypeThenArrow(parser: Parser, start: int): bool {
  let depth = 0
  let index = start
  const count = Arrays.length(parser.tokens)
  while (index < count) {
    const token = parser.tokens[index]
    if (token.kind == TokenKind.TokNewline || token.kind == TokenKind.TokEof) {
      return false
    }
    if (token.kind == TokenKind.TokPunct) {
      if (token.text == "(" || token.text == "[" || token.text == "<") {
        depth = depth + 1
      } else if (token.text == ")" || token.text == "]" || token.text == ">") {
        depth = depth - 1
      } else if (token.text == ">>") {
        depth = depth - 2
      } else if (token.text == "=>" && depth == 0) {
        return true
      } else if (
        depth == 0 &&
          (token.text == "?" ||
            token.text == ":" ||
            token.text == "," ||
            token.text == "{" ||
            token.text == "}" ||
            token.text == ";")
      ) {
        return false
      }
      if (depth < 0) {
        return false
      }
    }
    index = index + 1
  }
  return false
}

// parseArrow parses `(a: A, b) : R => body`, where the body is an
// expression or a block. Parameter and result types may be left out.
function parseArrow(mutable parser: Parser): Expr {
  const pos = getPos(expect(mutable parser, "("))
  let parameters: Array<Param> = []
  while (isOk(parser) && !isAt(parser, ")")) {
    if (isAt(parser, "mutable")) {
      failHere(mutable parser, "E0028", "arrow function parameters cannot be mutable")
      return createDummyExpr()
    }
    const paramPos = getPos(currentToken(parser))
    const paramStart = parser.index
    const paramName = expectIdent(mutable parser).text
    let paramType: Option<TypeExpr> = None
    if (accept(mutable parser, ":")) {
      paramType = Some(parseType(mutable parser))
    }
    const paramId = newId(mutable parser)
    Arrays.push(mutable parameters, Param {
      id: paramId,
      pos: paramPos,
      name: paramName,
      isMutable: false,
      type: paramType,
      escaping: false,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getIdKey(paramId), paramStart)
    }
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  expect(mutable parser, ")")
  let result: Option<TypeExpr> = None
  if (accept(mutable parser, ":")) {
    result = Some(parseType(mutable parser))
  }
  expect(mutable parser, "=>")
  const savedResult = parser.resultFunction
  parser.resultFunction = false
  if (isAt(parser, "{")) {
    const block = parseBlock(mutable parser)
    parser.resultFunction = savedResult
    return Expr.ArrowExpr(newId(mutable parser), pos, parameters, result, None, Some(block))
  }
  const body = parseExpr(mutable parser)
  parser.resultFunction = savedResult
  return Expr.ArrowExpr(newId(mutable parser), pos, parameters, result, Some(body), None)
}

function parseBlock(mutable parser: Parser): Block {
  const startIndex = parser.index
  const pos = getPos(expect(mutable parser, "{"))
  skipNewlines(mutable parser)
  let statements: Array<Stmt> = []
  while (isOk(parser) && !isAt(parser, "}")) {
    if (currentToken(parser).kind == TokenKind.TokEof) {
      failHere(mutable parser, "E0029", "unexpected end of file inside a block")
      break
    }
    Arrays.push(mutable statements, parseStmt(mutable parser))
  }
  expect(mutable parser, "}")
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("b", pos), startIndex)
  }
  return Block { pos: pos, statements: statements }
}

// parseLoopExitLabel reads the optional label after break or continue.
function parseLoopExitLabel(mutable parser: Parser): string {
  if (currentToken(parser).kind == TokenKind.TokIdent) {
    return advance(mutable parser).text
  }
  return ""
}

// isMarkedEntries reports a `for` head `const #[index, mutable item]`, the
// marker form over Arrays.entries (D85).
function isMarkedEntries(parser: Parser): bool {
  const pattern = peekToken(parser, 1)
  const index = peekToken(parser, 2)
  const comma = peekToken(parser, 3)
  const marker = peekToken(parser, 4)
  return isAt(parser, "const") &&
    pattern.kind == TokenKind.TokPunct &&
    pattern.text == "#[" &&
    index.kind == TokenKind.TokIdent &&
    comma.kind == TokenKind.TokPunct &&
    comma.text == "," &&
    marker.kind == TokenKind.TokKeyword &&
    marker.text == "mutable"
}

// parseReferenceFor parses the rest of `for (mutable item of items) body` or
// `for (const #[index, mutable item] of Arrays.entries(items)) body`, after
// the `(`. The head is not desugared into a declaration, which would copy
// the element (D85).
function parseReferenceFor(mutable parser: Parser, pos: Pos): Stmt uses alloc {
  let indexName = ""
  let indexPos = pos
  if (accept(mutable parser, "const")) {
    expect(mutable parser, "#[")
    const indexToken = expectIdent(mutable parser)
    indexName = indexToken.text
    indexPos = getPos(indexToken)
    expect(mutable parser, ",")
  }
  expect(mutable parser, "mutable")
  const nameToken = expectIdent(mutable parser)
  if (indexName != "") {
    expect(mutable parser, "]")
  }
  expect(mutable parser, "of")
  const iterable = parseExpr(mutable parser)
  expect(mutable parser, ")")
  const body = parseBlock(mutable parser)
  skipNewlines(mutable parser)

  // The index local and the loop's own local get node ids after the body,
  // as for the other `for` forms.
  let indexId = -1
  if (indexName != "") {
    indexId = newId(mutable parser)
    parser.facts.namePositions[indexId] = indexPos
  }
  const forId = newId(mutable parser)
  parser.facts.namePositions[forId] = getPos(nameToken)
  const reference = LoopReference { indexId: indexId, indexName: indexName }
  return Stmt.ForStmt(forId, pos, "", nameToken.text, iterable, body, Some(reference))
}

// parseLabeledStmt parses `name: for ...` and `name: while ...`.
function parseLabeledStmt(mutable parser: Parser): Stmt uses alloc {
  const labelToken = advance(mutable parser)
  const labelPos = getPos(labelToken)
  advance(mutable parser)
  if (!isAt(parser, "for") && !isAt(parser, "while")) {
    failAt(
      mutable parser,
      labelPos,
      "E0918",
      `label "${labelToken.text}" must be on a for or while loop`,
    )
    return Stmt.BreakStmt(labelPos, "")
  }
  const loop = parseStmtBody(mutable parser)
  if (loop is Stmt.WhileStmt(_, _, condition, body)) {
    return Stmt.WhileStmt(labelPos, labelToken.text, condition, body)
  }
  if (loop is Stmt.ForStmt(nodeId, _, _, name, iterable, body, reference)) {
    return Stmt.ForStmt(nodeId, labelPos, labelToken.text, name, iterable, body, reference)
  }
  return loop
}

function parseStmt(mutable parser: Parser): Stmt {
  const startIndex = parser.index
  const statement = parseStmtBody(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("s", getStmtPos(statement)), startIndex)
  }
  return statement
}

function parseStmtBody(mutable parser: Parser): Stmt {
  const token = currentToken(parser)
  const pos = getPos(token)
  const following = peekToken(parser, 1)
  if (
    token.kind == TokenKind.TokIdent &&
      following.kind == TokenKind.TokPunct &&
      following.text == ":"
  ) {
    return parseLabeledStmt(mutable parser)
  }
  // a nested function declaration, also async function
  if (
    token.kind == TokenKind.TokIdent &&
      token.text == "async" &&
      following.kind == TokenKind.TokKeyword &&
      following.text == "function"
  ) {
    failAt(
      mutable parser,
      getPos(following),
      "E0930",
      "a function inside a function is not supported; declare it at module level as a private function and pass the enclosing values as arguments",
    )
  }
  if (isAt(parser, "function")) {
    failAt(
      mutable parser,
      pos,
      "E0930",
      "a function inside a function is not supported; declare it at module level as a private function and pass the enclosing values as arguments",
    )
  }
  if (isAt(parser, "const") || isAt(parser, "let")) {
    const isMutable = advance(mutable parser).text == "let"
    const after = peekToken(parser, 1)
    const isConstructor =
      currentToken(parser).kind == TokenKind.TokIdent &&
        after.kind == TokenKind.TokPunct &&
        (after.text == "(" || after.text == ".")
    const namePos = getPos(currentToken(parser))
    let name = ""
    let pattern: Option<Pattern> = None
    if (isAt(parser, "{") || isAt(parser, "#[") || isConstructor) {
      pattern = Some(parsePattern(mutable parser))
    } else {
      name = expectIdent(mutable parser).text
    }
    let declaredType: Option<TypeExpr> = None
    if (accept(mutable parser, ":")) {
      declaredType = Some(parseType(mutable parser))
    }
    expect(mutable parser, "=")
    if (
      isAt(parser, "yield") &&
        name != "" &&
        declaredType is None &&
        !(peekToken(parser, 1).kind == TokenKind.TokPunct && peekToken(parser, 1).text == "*")
    ) {
      // `const input = yield value` in a coroutine.
      const yieldPos = getPos(currentToken(parser))
      advance(mutable parser)
      const next = currentToken(parser)
      if (next.kind == TokenKind.TokNewline || next.kind == TokenKind.TokEof || isAt(parser, "}")) {
        failHere(
          mutable parser,
          "E0046",
          "`yield` needs a value: write `yield value`, or `yield* generator`",
        )
        return Stmt.BreakStmt(pos, "")
      }
      const yielded = parseExpr(mutable parser)
      endStatement(mutable parser)
      const binding = YieldBinding {
        id: newId(mutable parser),
        isMutable: isMutable,
        name: name,
        pos: pos,
      }
      return Stmt.YieldStmt(yieldPos, yielded, false, Some(binding))
    }
    const value = parseExpr(mutable parser)
    endStatement(mutable parser)
    const varId = newId(mutable parser)
    parser.facts.namePositions[varId] = namePos
    return Stmt.VarStmt(varId, pos, isMutable, name, pattern, declaredType, value)
  }
  if (isAt(parser, "return")) {
    advance(mutable parser)
    let value: Option<Expr> = None
    if (currentToken(parser).kind != TokenKind.TokNewline && !isAt(parser, "}")) {
      const returned = parseExpr(mutable parser)
      if (isTernary(parser, returned)) {
        endStatement(mutable parser)
        return convertReturnedTernary(mutable parser, returned)
      }
      value = Some(returned)
    }
    endStatement(mutable parser)
    return Stmt.ReturnStmt(pos, value)
  }
  if (isAt(parser, "if")) {
    return parseIf(mutable parser)
  }
  if (isAt(parser, "while")) {
    advance(mutable parser)
    expect(mutable parser, "(")
    const condition = parseExpr(mutable parser)
    expect(mutable parser, ")")
    const body = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    return Stmt.WhileStmt(pos, "", condition, body)
  }
  if (isAt(parser, "for")) {
    advance(mutable parser)
    expect(mutable parser, "(")
    if (isAt(parser, "mutable") || isMarkedEntries(parser)) {
      return parseReferenceFor(mutable parser, pos)
    }
    if (!isAt(parser, "const") && !isAt(parser, "let")) {
      failHere(mutable parser, "E0030", "write `for (const item of items)`")
      return Stmt.BreakStmt(pos, "")
    }
    const isMutable = advance(mutable parser).text == "let"
    const headPos = getPos(currentToken(parser))
    const after = peekToken(parser, 1)
    const isConstructor =
      currentToken(parser).kind == TokenKind.TokIdent &&
        after.kind == TokenKind.TokPunct &&
        (after.text == "(" || after.text == ".")
    let name = ""
    let pattern: Option<Pattern> = None
    if (isAt(parser, "{") || isAt(parser, "#[") || isConstructor) {
      pattern = Some(parsePattern(mutable parser))
    } else {
      name = expectIdent(mutable parser).text
    }
    if (isAt(parser, "in") || isWord(parser, "in")) {
      failHere(mutable parser, "E0031", "use `of`; `for ... in` is not part of the language")
      return Stmt.BreakStmt(pos, "")
    }
    expect(mutable parser, "of")
    const iterable = parseExpr(mutable parser)
    expect(mutable parser, ")")
    let body = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    if (isMutable || pattern is Some(_)) {
      // for (const <pattern> of xs) body becomes
      // for (const __for_L_C of xs) { const <pattern> = __for_L_C; body }
      // where L and C are the line and column of the pattern. A user name
      // cannot clash with it because each loop has its own position.
      const hidden = `__for_${Int.toString(headPos.line)}_${Int.toString(headPos.column)}`
      const declarationId = newId(mutable parser)
      const hiddenId = newId(mutable parser)
      const declaration = Stmt.VarStmt(
        declarationId,
        headPos,
        isMutable,
        name,
        pattern,
        None,
        Expr.Ident(hiddenId, headPos, hidden),
      )
      let statements: Array<Stmt> = [declaration]
      for (const statement of Arrays.values(body.statements)) {
        Arrays.push(mutable statements, statement)
      }
      body = Block { pos: body.pos, statements: statements }
      name = hidden
    }
    const forId = newId(mutable parser)
    parser.facts.namePositions[forId] = headPos
    return Stmt.ForStmt(forId, pos, "", name, iterable, body, None)
  }
  if (isAt(parser, "yield")) {
    advance(mutable parser)
    const delegate = accept(mutable parser, "*")
    const next = currentToken(parser)
    if (next.kind == TokenKind.TokNewline || next.kind == TokenKind.TokEof || isAt(parser, "}")) {
      failHere(
        mutable parser,
        "E0046",
        "`yield` needs a value: write `yield value`, or `yield* generator`",
      )
      return Stmt.BreakStmt(pos, "")
    }
    const value = parseExpr(mutable parser)
    endStatement(mutable parser)
    return Stmt.YieldStmt(pos, value, delegate, None)
  }
  if (isAt(parser, "break")) {
    advance(mutable parser)
    const label = parseLoopExitLabel(mutable parser)
    endStatement(mutable parser)
    return Stmt.BreakStmt(pos, label)
  }
  if (isAt(parser, "continue")) {
    advance(mutable parser)
    const label = parseLoopExitLabel(mutable parser)
    endStatement(mutable parser)
    return Stmt.ContinueStmt(pos, label)
  }
  if (isAt(parser, "{")) {
    failAt(mutable parser, pos, "E0032", "a block must belong to a statement such as if or while")
    return Stmt.BreakStmt(pos, "")
  }
  const expression = parseExpr(mutable parser)
  if (accept(mutable parser, "=")) {
    const value = parseExpr(mutable parser)
    endStatement(mutable parser)
    return Stmt.AssignStmt(pos, expression, value)
  }
  if (expression is Expr.MatchExpr(_, _, _, _)) {
    skipNewlines(mutable parser)
    return Stmt.ExprStmt(pos, expression)
  }
  endStatement(mutable parser)
  return Stmt.ExprStmt(pos, expression)
}

function parseIf(mutable parser: Parser): Stmt {
  const startIndex = parser.index
  const statement = parseIfBody(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("s", getStmtPos(statement)), startIndex)
  }
  return statement
}

function parseIfBody(mutable parser: Parser): Stmt {
  const pos = getPos(expect(mutable parser, "if"))
  expect(mutable parser, "(")
  const condition = parseExpr(mutable parser)
  expect(mutable parser, ")")
  const thenBlock = parseBlock(mutable parser)
  const savedIndex = parser.index
  skipNewlines(mutable parser)
  if (isOk(parser) && accept(mutable parser, "else")) {
    if (isAt(parser, "if")) {
      const rest = parseIf(mutable parser)
      return Stmt.IfStmt(pos, condition, thenBlock, Some(rest))
    }
    const block = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    return Stmt.IfStmt(pos, condition, thenBlock, Some(Stmt.BlockStmt(block)))
  }
  parser.index = savedIndex
  skipNewlines(mutable parser)
  return Stmt.IfStmt(pos, condition, thenBlock, None)
}

// ---- Expressions

// parseExpr parses an expression: a binary expression, or `cond ? a : b`,
// which is looser than `||` and right-associative. It becomes a block
// expression holding one if statement whose branches each return one value,
// like an `if` in value position. Only the chosen branch runs.
function parseExpr(mutable parser: Parser): Expr {
  const startIndex = parser.index
  const expression = parseExprBody(mutable parser)
  noteExpr(mutable parser, startIndex, expression)
  return expression
}

function parseExprBody(mutable parser: Parser): Expr {
  const start = getPos(currentToken(parser))
  const condition = parseBinary(mutable parser, 0)
  if (!isAt(parser, "?")) {
    return condition
  }
  const pos = getPos(advance(mutable parser))
  const thenValue = parseExpr(mutable parser)
  if (!isAt(parser, ":")) {
    // A `:` on the next line is a ternary that spans lines.
    const savedIndex = parser.index
    skipNewlines(mutable parser)
    const spans = isAt(parser, ":")
    parser.index = savedIndex
    if (spans) {
      failHere(
        mutable parser,
        "E0934",
        "a conditional expression that spans lines must be wrapped in parentheses, as in `(cond ? a : b)`",
      )
    } else {
      failHere(
        mutable parser,
        "E0934",
        "a conditional expression needs `:` and a second value, as in `cond ? a : b`",
      )
    }
    return createDummyExpr()
  }
  advance(mutable parser)
  const elseValue = parseExpr(mutable parser)
  const ifStatement = Stmt.IfStmt(
    pos,
    condition,
    createReturnBlock(thenValue),
    Some(Stmt.BlockStmt(createReturnBlock(elseValue))),
  )
  const ternaryId = newId(mutable parser)
  Arrays.push(mutable parser.ternaryIds, ternaryId)
  // The expression starts at the condition and its block at the `?`, which is
  // how isConditional tells it from a plain block and an `if` value.
  return Expr.BlockExpr(ternaryId, start, Block { pos: pos, statements: [ifStatement] })
}

// isTernary tells whether the expression came from `c ? a : b`.
function isTernary(parser: Parser, expression: Expr): bool {
  if (expression is Expr.BlockExpr(expressionId, _, _)) {
    for (const ternaryId of Arrays.values(parser.ternaryIds)) {
      if (ternaryId == expressionId) {
        return true
      }
    }
  }
  return false
}

// getReturnedValue is the value of the `return value` that a ternary branch holds.
function getReturnedValue(block: Block): Expr {
  if (block.statements[0] is Stmt.ReturnStmt(_, Some(value))) {
    return value
  }
  return createDummyExpr()
}

// convertReturnedTernary turns `return c ? a : b` into `if (c) { return a }
// else { return b }`, so a self call in a branch is a tail call. A branch that
// is itself a ternary is turned the same way.
function convertReturnedTernary(mutable parser: Parser, value: Expr): Stmt {
  if (!isTernary(parser, value)) {
    return Stmt.ReturnStmt(getExpressionPos(value), Some(value))
  }
  if (value is Expr.BlockExpr(ternaryId, _, block)) {
    if (parser.collector.enabled) {
      parser.collector.convertedKeys[getIdKey(ternaryId)] = true
    }
    if (
      block.statements[0] is Stmt.IfStmt(pos, condition, thenBlock, Some(Stmt.BlockStmt(elseBlock)))
    ) {
      const thenStatement = convertReturnedTernary(mutable parser, getReturnedValue(thenBlock))
      const elseStatement = convertReturnedTernary(mutable parser, getReturnedValue(elseBlock))
      const newThen = Block { pos: thenBlock.pos, statements: [thenStatement] }
      const newElse = Block { pos: elseBlock.pos, statements: [elseStatement] }
      return Stmt.IfStmt(pos, condition, newThen, Some(Stmt.BlockStmt(newElse)))
    }
  }
  return Stmt.ReturnStmt(getExpressionPos(value), Some(value))
}

function parseBinary(mutable parser: Parser, level: int): Expr {
  if (level == Arrays.length(BINARY_LEVELS)) {
    return parseUnary(mutable parser)
  }
  const startIndex = parser.index
  let left = parseBinary(mutable parser, level + 1)
  while (isOk(parser)) {
    const token = currentToken(parser)
    if (level == IS_LEVEL && isAt(parser, "is")) {
      advance(mutable parser)
      const pattern = parsePattern(mutable parser)
      left = Expr.IsExpr(newId(mutable parser), getPos(token), left, pattern)
      noteExpr(mutable parser, startIndex, left)
      continue
    }
    if (token.kind != TokenKind.TokPunct) {
      return left
    }
    let matched = false
    for (const operator of Arrays.values(BINARY_LEVELS[level])) {
      if (token.text == operator) {
        matched = true
      }
    }
    if (token.text == "===" || token.text == "!==") {
      const replacement = Str.slice(token.text, 0, 2)
      failAtFix(
        mutable parser,
        getPos(token),
        "E0033",
        [
          createFix(`use ${replacement}`, [
            createEdit(getPos(token), moveColumn(getPos(token), 3), replacement),
          ]),
        ],
        `use \`${Str.slice(token.text, 0, 2)}\`; there is no strict equality operator`,
      )
      return left
    }
    if (!matched) {
      return left
    }
    advance(mutable parser)
    if (isAt(parser, "=") && currentToken(parser).column == token.column + Str.length(token.text)) {
      failAt(
        mutable parser,
        getPos(token),
        "E0034",
        `compound assignment is not supported; write \`x = x ${token.text} y\``,
      )
      return left
    }
    const right = parseBinary(mutable parser, level + 1)
    left = Expr.BinaryExpr(newId(mutable parser), getPos(token), token.text, left, right)
    noteExpr(mutable parser, startIndex, left)
  }
  return left
}

function parseUnary(mutable parser: Parser): Expr {
  const startIndex = parser.index
  const token = currentToken(parser)
  if (isAt(parser, "-") || isAt(parser, "!") || isAt(parser, "~")) {
    advance(mutable parser)
    const operand = parseUnary(mutable parser)
    const unary = Expr.UnaryExpr(newId(mutable parser), getPos(token), token.text, operand)
    noteExpr(mutable parser, startIndex, unary)
    return unary
  }
  const expression = parsePrimary(mutable parser)
  return parsePostfix(mutable parser, expression, startIndex)
}

function parsePostfix(mutable parser: Parser, first: Expr, startIndex: int): Expr {
  let expression = first
  while (isOk(parser)) {
    const token = currentToken(parser)
    if (isAt(parser, ".")) {
      advance(mutable parser)
      const name = parseMemberName(mutable parser)
      expression = Expr.FieldExpr(newId(mutable parser), getPos(name), expression, name.text)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, "<") && isCallTypeArgsAhead(parser, expression)) {
      // `f<int>(x)`: type arguments of a call.
      const typeArguments = parseLiteralTypeArgs(mutable parser)
      const openParen = expect(mutable parser, "(")
      const arguments = parseCallArguments(mutable parser)
      const callId = newId(mutable parser)
      parser.facts.callEnds[callId] = getCallEnd(parser)
      expression = Expr.CallExpr(callId, getPos(openParen), expression, typeArguments, arguments)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, "(")) {
      advance(mutable parser)
      const arguments = parseCallArguments(mutable parser)
      const callId = newId(mutable parser)
      parser.facts.callEnds[callId] = getCallEnd(parser)
      expression = Expr.CallExpr(callId, getPos(token), expression, [], arguments)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, "[")) {
      advance(mutable parser)
      const index = parseExpr(mutable parser)
      expect(mutable parser, "]")
      expression = Expr.IndexExpr(newId(mutable parser), getPos(token), expression, index)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, "<") || isAt(parser, "{")) {
      // `Name { field: value }` is a struct literal, and
      // `Name<A, B> { ... }` is one with type arguments.
      if (expression is Expr.Ident(_, identPos, identName)) {
        if (!startsUpper(identName)) {
          return expression
        }
        let typeArguments: Array<TypeExpr> = []
        if (isAt(parser, "<")) {
          if (!isLiteralTypeArgsAhead(parser)) {
            return expression
          }
          typeArguments = parseLiteralTypeArgs(mutable parser)
        }
        if (identName == "Map") {
          expression = parseMapLit(mutable parser, identPos, typeArguments)
        } else {
          expression = parseStructLit(mutable parser, identName, typeArguments, identPos)
        }
        noteExpr(mutable parser, startIndex, expression)
      } else {
        return expression
      }
    } else {
      return expression
    }
  }
  return expression
}

// parseCallArguments parses the arguments of a call after its `(`, and the
// closing `)`.
function parseCallArguments(mutable parser: Parser): Array<Arg> {
  let arguments: Array<Arg> = []
  while (isOk(parser) && !isAt(parser, ")")) {
    const start = getPos(currentToken(parser))
    // A name followed by `:` starts a named argument; no expression does.
    let name: Option<string> = None()
    if (
      currentToken(parser).kind == TokenKind.TokIdent &&
        peekToken(parser, 1).text == ":" &&
        peekToken(parser, 1).kind == TokenKind.TokPunct
    ) {
      name = Some(advance(mutable parser).text)
      advance(mutable parser)
    }
    const isMutable = accept(mutable parser, "mutable")
    const value = parseExpr(mutable parser)
    Arrays.push(mutable arguments, Arg {
      pos: start,
      name: name,
      isMutable: isMutable,
      value: value,
    })
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  expect(mutable parser, ")")
  return arguments
}

// isCallTypeArgsAhead reports whether the `<` at the current token starts the
// type arguments of a call on callee: a name or `Module.name`, then a
// balanced `<` ... `>` of type names followed directly by `(`. A name not
// followed by `.` must be a type: a type parameter in scope, a primitive
// type name, or a capitalized name that is not SCREAMING_CASE. So
// `a < b > (c)` and `x < MAX, MIN > (y)` stay comparisons.
function isCallTypeArgsAhead(parser: Parser, callee: Expr): bool {
  if (callee is Expr.FieldExpr(_, _, target, _)) {
    if (!(target is Expr.Ident(_, _, _))) {
      return false
    }
  } else if (!(callee is Expr.Ident(_, _, _))) {
    return false
  }
  let depth = 0
  let offset = 0
  const count = Arrays.length(parser.tokens)
  while (parser.index + offset < count) {
    const token = peekToken(parser, offset)
    if (token.kind == TokenKind.TokIdent) {
      if (depth == 0) {
        return false
      }
      const next = peekToken(parser, offset + 1)
      const isQualifier = next.kind == TokenKind.TokPunct && next.text == "."
      if (!isTypeNameAhead(parser, token.text) && !isQualifier) {
        return false
      }
    } else if (token.kind != TokenKind.TokPunct) {
      return false
    } else if (token.text == "<") {
      depth = depth + 1
    } else if (token.text == ">" || token.text == ">>") {
      if (token.text == ">") {
        depth = depth - 1
      } else {
        depth = depth - 2
      }
      if (depth < 0) {
        return false
      }
      if (depth == 0) {
        const after = peekToken(parser, offset + 1)
        return after.kind == TokenKind.TokPunct && after.text == "("
      }
    } else if (token.text != "," && token.text != "." && token.text != "#[" && token.text != "]") {
      return false
    }
    offset = offset + 1
  }
  return false
}

// isTypeNameAhead reports whether a name in call type arguments can be a
// type: a type parameter in scope, a primitive type, or a capitalized name
// that is not a constant (two or more characters with no lowercase letter,
// such as MAX or LIMIT_2).
function isTypeNameAhead(parser: Parser, name: string): bool {
  for (const typeName of Arrays.values(parser.typeNames)) {
    if (typeName == name) {
      return true
    }
  }
  if (isPrimitiveTypeName(name)) {
    return true
  }
  return startsUpper(name) && !isConstantName(name)
}

// isConstantName reports whether name looks like a constant: it has two or
// more characters and no lowercase letter.
function isConstantName(name: string): bool {
  if (Str.length(name) < 2) {
    return false
  }
  for (const index of Ranges.between(0, Str.length(name))) {
    const byte = Str.byteAt(name, index)
    if (byte >= 97 && byte <= 122) {
      return false
    }
  }
  return true
}

// isPrimitiveTypeName reports whether text is a type written in lowercase.
function isPrimitiveTypeName(text: string): bool {
  return text == "int" ||
    text == "f64" ||
    text == "bool" ||
    text == "char" ||
    text == "string" ||
    text == "void"
}

// parseMemberName reads the name after `.`. `from` is a keyword, but
// `UserId.from(x)` needs it as a member name.
function parseMemberName(mutable parser: Parser): Token {
  if (isAt(parser, "from")) {
    return advance(mutable parser)
  }
  return expectIdent(mutable parser)
}

// isLiteralTypeArgsAhead reports whether the `<` at the current token starts the
// type arguments of a literal: a balanced `<` ... `>` holding only names,
// `.`, `,`, `#[`, `]` and nested `<>`, followed by `{`. Anything else is a
// comparison, so `a < B` never changes meaning. `>>` closes two levels.
function isLiteralTypeArgsAhead(parser: Parser): bool {
  let depth = 0
  let offset = 0
  const count = Arrays.length(parser.tokens)
  while (parser.index + offset < count) {
    const token = peekToken(parser, offset)
    if (token.kind == TokenKind.TokIdent) {
      if (depth == 0) {
        return false
      }
    } else if (token.kind != TokenKind.TokPunct) {
      return false
    } else if (token.text == "<") {
      depth = depth + 1
    } else if (token.text == ">" || token.text == ">>") {
      if (token.text == ">") {
        depth = depth - 1
      } else {
        depth = depth - 2
      }
      if (depth < 0) {
        return false
      }
      if (depth == 0) {
        const after = peekToken(parser, offset + 1)
        return after.kind == TokenKind.TokPunct && after.text == "{"
      }
    } else if (token.text != "," && token.text != "." && token.text != "#[" && token.text != "]") {
      return false
    }
    offset = offset + 1
  }
  return false
}

// parseLiteralTypeArgs parses the `<A, B>` before a literal's `{`. A trailing `>>`
// is split by parseType, as in a type.
function parseLiteralTypeArgs(mutable parser: Parser): Array<TypeExpr> {
  expect(mutable parser, "<")
  let arguments: Array<TypeExpr> = []
  while (isOk(parser)) {
    Arrays.push(mutable arguments, parseType(mutable parser))
    if (!accept(mutable parser, ",")) {
      break
    }
  }
  expect(mutable parser, ">")
  return arguments
}

function startsUpper(text: string): bool {
  if (text == "") {
    return false
  }
  const firstByte = Str.byteAt(text, 0)
  return firstByte >= 65 && firstByte <= 90
}

// parseMapLit parses `Map { "a": 1, [key]: 2 }`. A key that is not a literal is
// written in brackets.
function parseMapLit(mutable parser: Parser, pos: Pos, typeArguments: Array<TypeExpr>): Expr {
  expect(mutable parser, "{")
  skipNewlines(mutable parser)
  let keys: Array<Expr> = []
  let values: Array<Expr> = []
  while (isOk(parser) && !isAt(parser, "}")) {
    let key = createDummyExpr()
    if (accept(mutable parser, "[")) {
      key = parseExpr(mutable parser)
      expect(mutable parser, "]")
    } else {
      key = parseExpr(mutable parser)
      if (isOk(parser) && !isLiteralKey(key)) {
        failAt(
          mutable parser,
          getExpressionPos(key),
          "E0035",
          "a map key that is not a literal is written [key]: value",
        )
        break
      }
    }
    expect(mutable parser, ":")
    Arrays.push(mutable keys, key)
    Arrays.push(mutable values, parseExpr(mutable parser))
    skipNewlines(mutable parser)
    if (!accept(mutable parser, ",")) {
      break
    }
    skipNewlines(mutable parser)
  }
  skipNewlines(mutable parser)
  expect(mutable parser, "}")
  return Expr.MapLit(newId(mutable parser), pos, typeArguments, keys, values)
}

function isLiteralKey(expression: Expr): bool {
  return match (expression) {
    Expr.IntLit(_, _, _) => true
    Expr.FloatLit(_, _, _) => true
    Expr.StringLit(_, _, _, _) => true
    Expr.CharLit(_, _, _) => true
    Expr.BoolLit(_, _, _) => true
    Expr.UnaryExpr(_, _, operator, operand) => operator == "-" && isLiteralKey(operand)
    _ => false
  }
}

// getExpressionPos is Go's Expr.position().
function getExpressionPos(expression: Expr): Pos {
  return match (expression) {
    Expr.IntLit(_, pos, _) => pos
    Expr.FloatLit(_, pos, _) => pos
    Expr.StringLit(_, pos, _, _) => pos
    Expr.CharLit(_, pos, _) => pos
    Expr.BoolLit(_, pos, _) => pos
    Expr.TemplateLit(_, pos, _) => pos
    Expr.Ident(_, pos, _) => pos
    Expr.FieldExpr(_, pos, _, _) => pos
    Expr.IsExpr(_, pos, _, _) => pos
    Expr.IndexExpr(_, pos, _, _) => pos
    Expr.MapLit(_, pos, _, _, _) => pos
    Expr.CallExpr(_, pos, _, _, _) => pos
    Expr.UnaryExpr(_, pos, _, _) => pos
    Expr.BinaryExpr(_, pos, _, _, _) => pos
    Expr.StructLit(_, pos, _, _, _, _) => pos
    Expr.ArrayLit(_, pos, _, _) => pos
    Expr.MatchExpr(_, pos, _, _) => pos
    Expr.BlockExpr(_, pos, _) => pos
    Expr.ArrowExpr(_, pos, _, _, _, _) => pos
  }
}

// isStructLitAhead reports whether the `{` at the current token starts a
// struct literal whose type comes from context: `{}`, `{ ...spread }` or
// `{ name: value }`. Any other `{` in value position is a block expression.
// A label (`name: for`, `name: while`) starts a block.
function isStructLitAhead(parser: Parser): bool {
  let offset = 1
  while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
    offset = offset + 1
  }
  if (parser.index + offset + 1 >= Arrays.length(parser.tokens)) {
    return false
  }
  const first = peekToken(parser, offset)
  if (first.kind == TokenKind.TokPunct && (first.text == "}" || first.text == "...")) {
    return true
  }
  const second = peekToken(parser, offset + 1)
  if (
    first.kind == TokenKind.TokString && second.kind == TokenKind.TokPunct && second.text == ":"
  ) {
    // A TypeScript object literal: parseStructLit reports it.
    return true
  }
  if (
    first.kind != TokenKind.TokIdent ||
      second.kind != TokenKind.TokPunct ||
      second.text != ":" ||
      parser.index + offset + 2 >= Arrays.length(parser.tokens)
  ) {
    return false
  }
  const third = peekToken(parser, offset + 2)
  return !(third.kind == TokenKind.TokKeyword && (third.text == "for" || third.text == "while"))
}

// parseBlockExpr parses a block in value position.
function parseBlockExpr(mutable parser: Parser): Expr {
  const pos = getPos(currentToken(parser))
  const block = parseBlock(mutable parser)
  return Expr.BlockExpr(newId(mutable parser), pos, block)
}

// createReturnBlock is a block holding `return value`, positioned at the value.
function createReturnBlock(value: Expr): Block {
  const pos = getExpressionPos(value)
  return Block { pos: pos, statements: [Stmt.ReturnStmt(pos, Some(value))] }
}

// parseIfExpr parses `if (c) { ... } else { ... }` in value position. It
// becomes a block expression holding one if statement whose branches each
// return a block expression. The else branch is required; `else if` chains
// are allowed.
function parseIfExpr(mutable parser: Parser): Expr {
  const pos = getPos(expect(mutable parser, "if"))
  expect(mutable parser, "(")
  const condition = parseExpr(mutable parser)
  expect(mutable parser, ")")
  const thenBranch = parseBlockExpr(mutable parser)
  const savedIndex = parser.index
  skipNewlines(mutable parser)
  if (isOk(parser) && !accept(mutable parser, "else")) {
    parser.index = savedIndex
    expect(mutable parser, "else")
  }
  let elseBranch = createDummyExpr()
  if (isAt(parser, "if")) {
    elseBranch = parseIfExpr(mutable parser)
  } else {
    elseBranch = parseBlockExpr(mutable parser)
  }
  const ifStatement = Stmt.IfStmt(
    pos,
    condition,
    createReturnBlock(thenBranch),
    Some(Stmt.BlockStmt(createReturnBlock(elseBranch))),
  )
  return Expr.BlockExpr(newId(mutable parser), pos, Block { pos: pos, statements: [ifStatement] })
}

// parseStructLit parses `{ ...spread, field: value }`. typeName is empty and pos
// is the `{` without a type name; with one, pos is the name's.
function parseStructLit(
  mutable parser: Parser,
  typeName: string,
  typeArguments: Array<TypeExpr>,
  pos: Pos,
): Expr {
  expect(mutable parser, "{")
  skipNewlines(mutable parser)
  let fields: Array<FieldInit> = []
  let spread: Option<Expr> = None
  while (isOk(parser) && !isAt(parser, "}")) {
    if (isAt(parser, "...")) {
      if (spread is Some(_) || Arrays.length(fields) > 0) {
        failHere(
          mutable parser,
          "E0036",
          "a struct literal has at most one spread, and it comes first",
        )
        break
      }
      advance(mutable parser)
      spread = Some(parseExpr(mutable parser))
      skipNewlines(mutable parser)
      if (!accept(mutable parser, ",")) {
        break
      }
      skipNewlines(mutable parser)
      continue
    }
    const fieldStart = parser.index
    const name = expectIdent(mutable parser)
    if (isOk(parser) && !isAt(parser, ":")) {
      failAt(
        mutable parser,
        getPos(name),
        "E0037",
        `write \`${name.text}: ${name.text}\`; field shorthand is not allowed`,
      )
      break
    }
    expect(mutable parser, ":")
    const value = parseExpr(mutable parser)
    Arrays.push(mutable fields, FieldInit { pos: getPos(name), name: name.text, value: value })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("f", getPos(name)), fieldStart)
    }
    skipNewlines(mutable parser)
    if (!accept(mutable parser, ",")) {
      break
    }
    skipNewlines(mutable parser)
  }
  skipNewlines(mutable parser)
  expect(mutable parser, "}")
  return Expr.StructLit(newId(mutable parser), pos, typeName, typeArguments, fields, spread)
}

function parsePrimary(mutable parser: Parser): Expr {
  const startIndex = parser.index
  const expression = parsePrimaryBody(mutable parser)
  noteExpr(mutable parser, startIndex, expression)
  return expression
}

function parsePrimaryBody(mutable parser: Parser): Expr {
  const token = currentToken(parser)
  const pos = getPos(token)
  if (token.kind == TokenKind.TokInt) {
    advance(mutable parser)
    return Expr.IntLit(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokFloat) {
    advance(mutable parser)
    return Expr.FloatLit(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokString) {
    advance(mutable parser)
    return Expr.StringLit(
      newId(mutable parser),
      pos,
      token.text,
      Pos { line: token.endLine, column: token.endColumn },
    )
  }
  if (token.kind == TokenKind.TokChar) {
    advance(mutable parser)
    return Expr.CharLit(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokTemplate) {
    advance(mutable parser)
    return parseTemplate(mutable parser, token)
  }
  if (token.kind == TokenKind.TokIdent) {
    advance(mutable parser)
    reportHabitWord(mutable parser, token)
    if (token.text == "null" || token.text == "undefined") {
      failAtFix(
        mutable parser,
        pos,
        "E0038",
        [
          createFix("use None", [
            createEdit(pos, moveColumn(pos, Str.charCount(token.text)), "None"),
          ]),
        ],
        `there is no ${token.text}; use \`None\` with an \`Option\` type`,
      )
      return createDummyExpr()
    }
    return Expr.Ident(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokKeyword) {
    if (token.text == "true" || token.text == "false") {
      advance(mutable parser)
      return Expr.BoolLit(newId(mutable parser), pos, token.text == "true")
    }
    if (token.text == "match") {
      return parseMatch(mutable parser)
    }
    if (token.text == "if") {
      return parseIfExpr(mutable parser)
    }
    if (token.text == "yield") {
      failAt(
        mutable parser,
        pos,
        "E0046",
        "`yield` is a statement, so it cannot be part of an expression",
      )
      return createDummyExpr()
    }
  }
  if (token.kind == TokenKind.TokPunct) {
    if (token.text == "(") {
      if (isArrowAhead(parser)) {
        return parseArrow(mutable parser)
      }
      advance(mutable parser)
      const inner = parseExpr(mutable parser)
      expect(mutable parser, ")")
      if (parser.collector.enabled && isOk(parser)) {
        parser.collector.parenthesized[getExprId(inner)] = true
      }
      return inner
    }
    if (token.text == "[" || token.text == "#[") {
      advance(mutable parser)
      let elements: Array<Expr> = []
      while (isOk(parser) && !isAt(parser, "]")) {
        Arrays.push(mutable elements, parseExpr(mutable parser))
        if (!accept(mutable parser, ",")) {
          break
        }
      }
      expect(mutable parser, "]")
      return Expr.ArrayLit(newId(mutable parser), pos, elements, token.text == "#[")
    }
    if (token.text == "{") {
      if (isStructLitAhead(parser)) {
        return parseStructLit(mutable parser, "", [], pos)
      }
      return parseBlockExpr(mutable parser)
    }
  }
  if (isAt(parser, "?")) {
    failAt(
      mutable parser,
      pos,
      "E0934",
      "a conditional expression that spans lines must be wrapped in parentheses, as in `(cond ? a : b)`",
    )
    return createDummyExpr()
  }
  failAt(mutable parser, pos, "E0039", `expected an expression, found ${describeToken(token)}`)
  return createDummyExpr()
}

// parseTemplate splits a template string into string pieces and the expressions
// inside `${...}`. Each expression is lexed and parsed on its own; all its
// tokens take the template's position (their ends are kept, as in Go).
function parseTemplate(mutable parser: Parser, token: Token): Expr {
  const pos = getPos(token)
  const end = Pos { line: token.endLine, column: token.endColumn }
  const raw = Str.chars(token.text)
  const count = Arrays.length(raw)
  let parts: Array<Expr> = []
  let text = Str.builder()
  let pending = 0 // characters in text
  let index = 0
  while (isOk(parser) && index < count) {
    const character = raw[index]
    if (character == '\\' && index + 1 < count) {
      const escaped = raw[index + 1]
      if (escaped == 'n') {
        Str.appendChar(mutable text, '\n')
      } else if (escaped == 't') {
        Str.appendChar(mutable text, '\t')
      } else {
        Str.appendChar(mutable text, escaped)
      }
      pending = pending + 1
      index = index + 2
      continue
    }
    if (character == '$' && index + 1 < count && raw[index + 1] == '{') {
      let depth = 1
      let closeIndex = index + 2
      while (closeIndex < count && depth > 0) {
        if (raw[closeIndex] == '{') {
          depth = depth + 1
        } else if (raw[closeIndex] == '}') {
          depth = depth - 1
        }
        closeIndex = closeIndex + 1
      }
      if (depth != 0) {
        failAt(mutable parser, pos, "E0040", "unterminated ${ in template string")
        return createDummyExpr()
      }
      if (pending > 0) {
        Arrays.push(mutable parts, Expr.StringLit(newId(mutable parser), pos, Str.build(text), end))
        text = Str.builder()
        pending = 0
      }
      let source = Str.builder()
      for (const sourceIndex of Ranges.between(index + 2, closeIndex - 1)) {
        Str.appendChar(mutable source, raw[sourceIndex])
      }
      const lexed = lex(Str.build(source))
      if (lexed is Err(error)) {
        failAt(mutable parser, pos, "E0041", `in template string: ${formatLexError(error)}`)
        return createDummyExpr()
      }
      // Report errors inside ${...} at the template's position.
      let inner: Array<Token> = []
      for (const innerToken of Arrays.values(lexed.value)) {
        Arrays.push(mutable inner, Token { ...innerToken, line: token.line, column: token.column })
      }
      let innerParser = Parser {
        tokens: inner,
        index: 0,
        nextId: parser.nextId,
        failed: None,
        ternaryIds: [],
        collector: createCollector(false),
        facts: createEmptyFacts(),
        resultFunction: false,
        typeNames: [],
      }
      const expression = parseExpr(mutable innerParser)
      parser.nextId = innerParser.nextId
      for (const entry of Maps.entries(innerParser.facts.callEnds)) {
        const #[callId, callEnd] = entry
        parser.facts.callEnds[callId] = callEnd
      }
      if (innerParser.failed is Some(diagnostic)) {
        failAt(mutable parser, diagnostic.pos, diagnostic.code, diagnostic.message)
        return createDummyExpr()
      }
      Arrays.push(mutable parts, expression)
      index = closeIndex
      continue
    }
    Str.appendChar(mutable text, character)
    pending = pending + 1
    index = index + 1
  }
  if (pending > 0) {
    Arrays.push(mutable parts, Expr.StringLit(newId(mutable parser), pos, Str.build(text), end))
  }
  return Expr.TemplateLit(newId(mutable parser), pos, parts)
}

function parseMatch(mutable parser: Parser): Expr {
  const pos = getPos(expect(mutable parser, "match"))
  expect(mutable parser, "(")
  const subject = parseExpr(mutable parser)
  expect(mutable parser, ")")
  expect(mutable parser, "{")
  skipNewlines(mutable parser)
  let arms: Array<MatchArm> = []
  while (isOk(parser) && !isAt(parser, "}")) {
    const armPos = getPos(currentToken(parser))
    const armStart = parser.index
    const pattern = parsePattern(mutable parser)
    let guard: Option<Expr> = None
    if (accept(mutable parser, "if")) {
      expect(mutable parser, "(")
      guard = Some(parseExpr(mutable parser))
      expect(mutable parser, ")")
    }
    expect(mutable parser, "=>")
    if (isAt(parser, "{")) {
      const block = parseBlock(mutable parser)
      Arrays.push(mutable arms, MatchArm {
        pos: armPos,
        pattern: pattern,
        guard: guard,
        body: None,
        block: Some(block),
      })
      if (parser.collector.enabled) {
        noteKey(mutable parser, getPosKey("a", armPos), armStart)
      }
    } else {
      const body = parseExpr(mutable parser)
      Arrays.push(mutable arms, MatchArm {
        pos: armPos,
        pattern: pattern,
        guard: guard,
        body: Some(body),
        block: None,
      })
      if (parser.collector.enabled) {
        noteKey(mutable parser, getPosKey("a", armPos), armStart)
      }
    }
    accept(mutable parser, ",")
    skipNewlines(mutable parser)
  }
  expect(mutable parser, "}")
  return Expr.MatchExpr(newId(mutable parser), pos, subject, arms)
}

// ---- Patterns

function parsePattern(mutable parser: Parser): Pattern {
  const startIndex = parser.index
  const pattern = parsePatternBody(mutable parser)
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getIdKey(getPatternId(pattern)), startIndex)
  }
  return pattern
}

function parsePatternBody(mutable parser: Parser): Pattern {
  const token = currentToken(parser)
  const pos = getPos(token)
  if (isAt(parser, "{")) {
    advance(mutable parser)
    skipNewlines(mutable parser)
    let fields: Array<FieldPattern> = []
    while (isOk(parser) && !isAt(parser, "}")) {
      const fieldStart = parser.index
      const name = expectIdent(mutable parser)
      if (accept(mutable parser, ":")) {
        const subpattern = parsePattern(mutable parser)
        Arrays.push(mutable fields, FieldPattern {
          pos: getPos(name),
          name: name.text,
          pattern: subpattern,
        })
      } else {
        const shorthandId = newId(mutable parser)
        parser.facts.shorthandIds[shorthandId] = true
        const shorthand = Pattern.PatName(shorthandId, getPos(name), name.text)
        Arrays.push(mutable fields, FieldPattern {
          pos: getPos(name),
          name: name.text,
          pattern: shorthand,
        })
      }
      if (parser.collector.enabled) {
        noteKey(mutable parser, getPosKey("f", getPos(name)), fieldStart)
      }
      skipNewlines(mutable parser)
      if (!accept(mutable parser, ",")) {
        break
      }
      skipNewlines(mutable parser)
    }
    skipNewlines(mutable parser)
    expect(mutable parser, "}")
    return Pattern.PatStruct(newId(mutable parser), pos, fields)
  }
  if (isAt(parser, "#[")) {
    advance(mutable parser)
    const arguments = parsePatternList(mutable parser, "]")
    return Pattern.PatTuple(newId(mutable parser), pos, arguments)
  }
  if (isAt(parser, "-")) {
    advance(mutable parser)
    const number = currentToken(parser)
    if (number.kind != TokenKind.TokInt && number.kind != TokenKind.TokFloat) {
      failAt(
        mutable parser,
        getPos(number),
        "E0042",
        `expected a number after - in a pattern, found ${describeToken(number)}`,
      )
      return createDummyPattern()
    }
    const operand = parsePrimary(mutable parser)
    const literal = Expr.UnaryExpr(newId(mutable parser), pos, "-", operand)
    return Pattern.PatLit(newId(mutable parser), pos, literal)
  }
  if (
    token.kind == TokenKind.TokInt ||
      token.kind == TokenKind.TokFloat ||
      token.kind == TokenKind.TokString ||
      token.kind == TokenKind.TokChar ||
      isAt(parser, "true") ||
      isAt(parser, "false")
  ) {
    const literal = parsePrimary(mutable parser)
    return Pattern.PatLit(newId(mutable parser), pos, literal)
  }
  const first = expectIdent(mutable parser)
  if (!isOk(parser)) {
    return createDummyPattern()
  }
  if (first.text == "_") {
    return Pattern.PatWildcard(newId(mutable parser), pos)
  }
  let isConstructor = false
  let enumName = ""
  let name = first.text
  // Enum.Name, or Alias.Enum.Name through a namespace import.
  while (isOk(parser) && accept(mutable parser, ".")) {
    isConstructor = true
    if (enumName != "") {
      enumName = `${enumName}.`
    }
    enumName = `${enumName}${name}`
    name = expectIdent(mutable parser).text
  }
  if (accept(mutable parser, "(")) {
    const arguments = parsePatternList(mutable parser, ")")
    return Pattern.PatCtor(newId(mutable parser), pos, enumName, name, arguments, false)
  }
  if (isConstructor) {
    return Pattern.PatCtor(newId(mutable parser), pos, enumName, name, [], true)
  }
  return Pattern.PatName(newId(mutable parser), pos, name)
}

// parsePatternList parses patterns up to close, which it consumes.
function parsePatternList(mutable parser: Parser, close: string): Array<Pattern> {
  let list: Array<Pattern> = []
  skipNewlines(mutable parser)
  while (isOk(parser) && !isAt(parser, close)) {
    Arrays.push(mutable list, parsePattern(mutable parser))
    skipNewlines(mutable parser)
    if (!accept(mutable parser, ",")) {
      break
    }
    skipNewlines(mutable parser)
  }
  expect(mutable parser, close)
  return list
}
