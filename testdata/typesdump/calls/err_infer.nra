trait Named {
  function name(value: Self): string
}

function empty<T>(): Array<T> {
  return []
}

function make<T>(count: int): int {
  return count
}

export function run(args: Array<string>): int {
  const items = empty()
  const nothing = None
  const number = make(1)
  const known: Array<int> = empty()
  const unnamed = Named.name(None)
  return 0
}
