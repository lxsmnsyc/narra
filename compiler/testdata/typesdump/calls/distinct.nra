distinct type UserId = int
distinct type Name = string
export opaque distinct type Token = string
distinct type Ids = Array<int>

function check(id: UserId): bool {
  return UserId.toInt(id) > 0
}

export function run(args: Array<string>): int {
  const id = UserId.from(7)
  const name = Name.from("ada")
  const _text = Name.toString(name)
  const _token = Token.from("t")
  const ids = Ids.from([1, 2])
  const raw = Ids.toArray(ids)
  if (check(id)) {
    return UserId.toInt(id)
  }
  return raw[0]
}
