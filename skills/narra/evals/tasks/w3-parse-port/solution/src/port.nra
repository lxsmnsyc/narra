import * as Int from "std/int"

export function parsePort(text: string): Result<int, string> uses alloc {
  const parsed = Int.parse(text, 10)
  if (parsed is Ok(port)) {
    if (port < 1 || port > 65535) {
      return Err(`port out of range: ${text}`)
    }
    return Ok(port)
  }
  return Err(`not a number: ${text}`)
}
