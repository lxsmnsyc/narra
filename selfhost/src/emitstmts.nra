// Statements and blocks (emit_stmt.go, emit.go block and blockInScope). The
// owner is selfhost-emit-bodies. Statements that open and close the owned
// temporaries of their expressions do so here, as in Go, before and after
// the call into a feature module.
import * as Int from "std/int"
import { Pos, Stmt, Block, Expr, Pattern, LoopReference } from "narrac/ast"
import { Type } from "narrac/types"
import { Ref, getExpressionId } from "narrac/check"
import { cType } from "narrac/cnames"
import {
  Emitter,
  EmitWalker,
  TempVar,
  reportUnsupported,
  writeLine,
  temp,
  consume,
  beginStatement,
  endStatement,
  pushScope,
  popScope,
  addLocal,
  unwindAll,
  unwindBlock,
  unwindLoop,
  enterLoop,
  leaveLoop,
  emitContinueLabel,
  markStepLoop,
  hasStepLoop,
  emitStepJump,
  emitBreakLabel,
  emitLabeledExit,
  readNodeType,
  readNodeRef,
  localRef,
  readLocal,
  retainCode,
  releaseCode,
  declareLocal,
  declareLocalVariable,
  declareVariable,
  variableRef,
  localName,
  containerName,
  underlyingType,
  where,
} from "narrac/emitstate"
import { pointerTemp, declaredLocal, emitArithmetic } from "narrac/emitexprs"
import * as Generators from "narrac/emitgenerators"
import * as Maps from "narrac/emitmaps"
import * as Match from "narrac/emitmatch"
import * as Tail from "narrac/emittail"
import * as Arrays from "std/array"
import * as Str from "std/string"

const NODE = "selfhost-emit-bodies"

// emitBlock emits the statements of a block in a scope of their own.
export function emitBlock<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
  loop: bool,
) uses alloc {
  pushScope(mutable emitter, loop)
  emitBlockInScope(walker, mutable emitter, block)
  popScope(mutable emitter)
}

// emitBlockInScope emits the statements in the scope already open.
export function emitBlockInScope<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
) uses alloc {
  for (const statement of Arrays.values(block.statements)) {
    emitStatement(walker, mutable emitter, statement)
  }
}

export function emitStatement<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => emitNestedBlock(walker, mutable emitter, block)
    Stmt.VarStmt(nodeId, _, _, _, pattern, _, value) => emitVariable(
      walker,
      mutable emitter,
      statement,
      nodeId,
      pattern,
      value,
    )
    Stmt.AssignStmt(_, target, value) => emitAssignment(
      walker,
      mutable emitter,
      statement,
      target,
      value,
    )
    Stmt.CompoundAssignStmt(pos, target, operator, value) => emitCompoundAssignment(
      walker,
      mutable emitter,
      pos,
      target,
      operator,
      value,
    )
    Stmt.ExprStmt(_, expression) => emitExpressionStatement(
      walker,
      mutable emitter,
      statement,
      expression,
    )
    Stmt.ReturnStmt(_, value) => emitReturn(walker, mutable emitter, value)
    Stmt.IfStmt(_, condition, then, orElse) => emitIf(
      walker,
      mutable emitter,
      statement,
      condition,
      then,
      orElse,
    )
    Stmt.WhileStmt(pos, label, condition, body) => emitWhile(
      walker,
      mutable emitter,
      pos,
      label,
      condition,
      body,
    )
    Stmt.CForStmt(pos, label, init, condition, step, body) => emitCFor(
      walker,
      mutable emitter,
      pos,
      label,
      init,
      condition,
      step,
      body,
    )
    Stmt.ForStmt(nodeId, pos, label, _, iterable, body, reference) => emitFor(
      walker,
      mutable emitter,
      statement,
      nodeId,
      pos,
      label,
      iterable,
      body,
      reference,
    )
    Stmt.BreakStmt(_, label) => emitLoopExit(mutable emitter, label, true)
    Stmt.ContinueStmt(_, label) => emitLoopExit(mutable emitter, label, false)
    Stmt.YieldStmt(_, value, delegate, binding) => Generators.emitYield(
      walker,
      mutable emitter,
      value,
      delegate,
      binding,
    )
  }
}

function emitNestedBlock<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
) uses alloc {
  writeLine(mutable emitter, "{")
  emitter.indent = emitter.indent + 1
  emitBlock(walker, mutable emitter, block, false)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
}

function emitLoopExit(mutable emitter: Emitter, label: string, isBreak: bool) uses alloc {
  if (label != "") {
    emitLabeledExit(mutable emitter, label, isBreak)
    return
  }
  if (!isBreak && hasStepLoop(emitter)) {
    emitStepJump(mutable emitter)
    return
  }
  unwindLoop(mutable emitter)
  if (isBreak) {
    writeLine(mutable emitter, "break;")
  } else {
    writeLine(mutable emitter, "continue;")
  }
}

function emitVariable<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  nodeId: int,
  pattern: Option<Pattern>,
  value: Expr,
) uses alloc {
  if (pattern is Some(_)) {
    Match.emitDestructure(walker, mutable emitter, statement)
    return
  }
  beginStatement(mutable emitter)
  const code = EmitWalker.emitExpression(walker, mutable emitter, value)
  const localIndex = declaredLocal(emitter, nodeId)
  const local = emitter.checker.bodies[emitter.body].locals[localIndex]
  const consumed = consume(mutable emitter, code.text, code.owned, local.localType)
  declareLocal(mutable emitter, localIndex, consumed)
  endStatement(mutable emitter)
  addLocal(mutable emitter, localIndex)
}

function emitAssignment<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  target: Expr,
  value: Expr,
) uses alloc {
  beginStatement(mutable emitter)
  // A write to a Map index is the maps module's.
  if (target is Expr.IndexExpr(_, _, indexTarget, _)) {
    if (readNodeType(emitter, getExpressionId(indexTarget)) is Type.TMap(_, _)) {
      Maps.emitMapSet(walker, mutable emitter, statement)
      endStatement(mutable emitter)
      return
    }
  }
  const code = EmitWalker.emitExpression(walker, mutable emitter, value)
  const valueType = readNodeType(emitter, getExpressionId(value))
  const consumed = consume(mutable emitter, code.text, code.owned, valueType)
  const location = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
  const targetType = readNodeType(emitter, getExpressionId(target))
  const releaseText = releaseCode(emitter, targetType, `(*${location})`)
  if (releaseText != "") {
    // The old value is released before the new one is stored.
    const pointer = pointerTemp(mutable emitter, targetType, location)
    const releaseOld = releaseCode(emitter, targetType, `(*${pointer})`)
    writeLine(mutable emitter, releaseOld)
    writeLine(mutable emitter, `*${pointer} = ${consumed};`)
  } else {
    writeLine(mutable emitter, `*${location} = ${consumed};`)
  }
  endStatement(mutable emitter)
}

function emitCompoundAssignment<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  target: Expr,
  operator: string,
  value: Expr,
) uses alloc {
  beginStatement(mutable emitter)
  // `+=` applies `+`; `++` and `--` apply `+` and `-` to the implied 1.
  let arithmetic = Str.slice(operator, 0, Str.length(operator) - 1)
  if (operator == "++") {
    arithmetic = "+"
  } else if (operator == "--") {
    arithmetic = "-"
  }
  const targetType = readNodeType(emitter, getExpressionId(target))
  const operandType = underlyingType(emitter, targetType)
  const valueCode = EmitWalker.emitExpression(walker, mutable emitter, value)
  const valueType = readNodeType(emitter, getExpressionId(value))
  const valueText = temp(mutable emitter, valueType, valueCode.text)
  if (target is Expr.IndexExpr(_, _, mapTarget, index)) {
    if (readNodeType(emitter, getExpressionId(mapTarget)) is Type.TMap(keyType, mapValueType)) {
      emitMapCompound(
        walker,
        mutable emitter,
        pos,
        arithmetic,
        mapTarget,
        index,
        keyType,
        mapValueType,
        valueText,
      )
      endStatement(mutable emitter)
      return
    }
  }
  // The place is found once; the old value is read and the new one stored through it.
  const location = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
  const pointer = pointerTemp(mutable emitter, targetType, location)
  const old = `(*${pointer})`
  if (operandType == Type.TStr) {
    // The joined string is new; the old one is released before it is stored.
    const joined = temp(mutable emitter, Type.TStr, `lstr_concat(${old}, ${valueText})`)
    const releaseOld = releaseCode(emitter, targetType, old)
    writeLine(mutable emitter, releaseOld)
    writeLine(mutable emitter, `*${pointer} = ${joined};`)
  } else {
    const result = emitArithmetic(mutable emitter, pos, arithmetic, operandType, old, valueText)
    writeLine(mutable emitter, `*${pointer} = ${result.text};`)
  }
  endStatement(mutable emitter)
}

function emitMapCompound<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  arithmetic: string,
  mapTarget: Expr,
  index: Expr,
  keyType: Type,
  mapValueType: Type,
  valueText: string,
) uses alloc {
  const mapType = readNodeType(emitter, getExpressionId(mapTarget))
  const keyCode = EmitWalker.emitExpression(walker, mutable emitter, index)
  const key = consume(mutable emitter, keyCode.text, keyCode.owned, keyType)
  const location = EmitWalker.emitLvaluePointer(walker, mutable emitter, mapTarget)
  const pointer = pointerTemp(mutable emitter, mapType, location)
  const name = containerName(emitter, mapType)
  // The key must exist: there is no old value to change otherwise.
  const entry = temp(mutable emitter, Type.TInt, `${name}_lookup(*${pointer}, ${key})`)
  const position = where(emitter, pos)
  writeLine(mutable emitter, `if (${entry} < 0) narra_panic(${position}, "map key not found");`)
  const old = temp(mutable emitter, mapValueType, `(*${pointer})->vals[${entry}]`)
  const operandType = underlyingType(emitter, mapValueType)
  let updated = ""
  if (operandType == Type.TStr) {
    updated = temp(mutable emitter, Type.TStr, `lstr_concat(${old}, ${valueText})`)
  } else {
    const result = emitArithmetic(mutable emitter, pos, arithmetic, operandType, old, valueText)
    updated = result.text
  }
  // The set takes over the key and the new value and releases the old value.
  writeLine(mutable emitter, `${name}_set(${pointer}, ${key}, ${updated});`)
}

function emitExpressionStatement<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  expression: Expr,
) uses alloc {
  if (Tail.isTailCall(emitter, expression)) {
    Tail.emitTailJump(walker, mutable emitter, expression)
    return
  }
  beginStatement(mutable emitter)
  if (expression is Expr.MatchExpr(_, _, _, _)) {
    Match.emitMatchStatement(walker, mutable emitter, statement)
  } else {
    // Only a call that returns nothing is a statement of its own.
    const code = EmitWalker.emitExpression(walker, mutable emitter, expression)
    if (code.text != "" && readNodeType(emitter, getExpressionId(expression)) == Type.TVoid) {
      writeLine(mutable emitter, `${code.text};`)
    }
  }
  endStatement(mutable emitter)
}

// emitBlockReturn emits a return inside a block expression: it stores the
// value, releases what the block holds and jumps past the block.
function emitBlockReturn<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  value: Option<Expr>,
) uses alloc {
  const info = emitter.blocks[Arrays.length(emitter.blocks) - 1]
  beginStatement(mutable emitter)
  if (value is Some(returned)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, returned)
    const returnedType = readNodeType(emitter, getExpressionId(returned))
    const consumed = consume(mutable emitter, code.text, code.owned, returnedType)
    writeLine(mutable emitter, `${info.result} = ${consumed};`)
  }
  unwindBlock(mutable emitter, info)
  writeLine(mutable emitter, `goto ${info.label};`)
  // unwindBlock released everything, so the frame closes without releasing again.
  emitter.frames = Tail.withoutLastFrame(emitter.frames)
}

function emitReturn<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  value: Option<Expr>,
) uses alloc {
  if (Arrays.length(emitter.blocks) > 0) {
    emitBlockReturn(walker, mutable emitter, value)
    return
  }
  if (emitter.inGenerator) {
    Generators.emitGeneratorReturn(mutable emitter)
    return
  }
  if (value is Some(tailValue)) {
    if (Tail.isTailCall(emitter, tailValue)) {
      Tail.emitTailJump(walker, mutable emitter, tailValue)
      return
    }
    if (tailValue is Expr.MatchExpr(_, _, _, arms)) {
      if (Tail.matchHasTailCall(emitter, arms)) {
        Match.emitReturnMatch(walker, mutable emitter, tailValue)
        return
      }
    }
  }
  beginStatement(mutable emitter)
  if (value is Some(returned)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, returned)
    const returnedType = readNodeType(emitter, getExpressionId(returned))
    const consumed = consume(mutable emitter, code.text, code.owned, returnedType)
    const result = temp(mutable emitter, returnedType, consumed)
    unwindAll(mutable emitter)
    writeLine(mutable emitter, `return ${result};`)
  } else {
    unwindAll(mutable emitter)
    writeLine(mutable emitter, "return;")
  }
  // unwindAll released everything, so the frame closes without releasing again.
  emitter.frames = Tail.withoutLastFrame(emitter.frames)
}

function emitIf<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  condition: Expr,
  then: Block,
  orElse: Option<Stmt>,
) uses alloc {
  if (condition is Expr.IsExpr(_, _, _, _)) {
    Match.emitIfIs(walker, mutable emitter, statement)
    return
  }
  beginStatement(mutable emitter)
  const code = EmitWalker.emitExpression(walker, mutable emitter, condition)
  const holds = temp(mutable emitter, Type.TBool, code.text)
  endStatement(mutable emitter)
  writeLine(mutable emitter, `if (${holds}) {`)
  emitter.indent = emitter.indent + 1
  emitBlock(walker, mutable emitter, then, false)
  emitter.indent = emitter.indent - 1
  if (orElse is Some(otherwise)) {
    writeLine(mutable emitter, "} else {")
    emitter.indent = emitter.indent + 1
    if (otherwise is Stmt.BlockStmt(elseBlock)) {
      emitBlock(walker, mutable emitter, elseBlock, false)
    } else {
      emitStatement(walker, mutable emitter, otherwise)
    }
    emitter.indent = emitter.indent - 1
  }
  writeLine(mutable emitter, "}")
}

// emitLoopBody emits a loop body with the frame depth recorded for break and continue.
function emitLoopBody<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  label: string,
  pos: Pos,
  body: Block,
) uses alloc {
  enterLoop(mutable emitter, label, pos)
  emitBlock(walker, mutable emitter, body, true)
  emitContinueLabel(mutable emitter)
}

function emitWhile<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  label: string,
  condition: Expr,
  body: Block,
) uses alloc {
  writeLine(mutable emitter, "while (1) {")
  emitter.indent = emitter.indent + 1
  beginStatement(mutable emitter)
  const code = EmitWalker.emitExpression(walker, mutable emitter, condition)
  const holds = temp(mutable emitter, Type.TBool, code.text)
  endStatement(mutable emitter)
  writeLine(mutable emitter, `if (!${holds}) break;`)
  emitLoopBody(walker, mutable emitter, label, pos, body)
  const info = leaveLoop(mutable emitter)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
}

function emitCFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  label: string,
  init: Option<Stmt>,
  condition: Option<Expr>,
  step: Option<Stmt>,
  body: Block,
) uses alloc {
  // The loop variable lives in a scope around the whole loop.
  pushScope(mutable emitter, false)
  if (init is Some(declaration)) {
    emitStatement(walker, mutable emitter, declaration)
  }
  writeLine(mutable emitter, "while (1) {")
  emitter.indent = emitter.indent + 1
  if (condition is Some(loopCondition)) {
    beginStatement(mutable emitter)
    const code = EmitWalker.emitExpression(walker, mutable emitter, loopCondition)
    const holds = temp(mutable emitter, Type.TBool, code.text)
    endStatement(mutable emitter)
    writeLine(mutable emitter, `if (!${holds}) break;`)
  }
  enterLoop(mutable emitter, label, pos)
  markStepLoop(mutable emitter)
  emitBlock(walker, mutable emitter, body, true)
  emitContinueLabel(mutable emitter)
  const info = leaveLoop(mutable emitter)
  if (step is Some(stepStatement)) {
    emitStatement(walker, mutable emitter, stepStatement)
  }
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
  popScope(mutable emitter)
}

// iterableName is the std function a for loop iterates: Range.upTo, Array.values and so on.
function iterableName(emitter: Emitter, iterable: Expr): string {
  if (iterable is Expr.CallExpr(callId, _, _, _, _)) {
    if (readNodeRef(emitter, callId) is Ref.Builtin(index)) {
      return emitter.checker.registry.functions[index].name
    }
  }
  return ""
}

function emitFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  reference: Option<LoopReference>,
) uses alloc {
  const name = iterableName(emitter, iterable)
  beginStatement(mutable emitter)
  if (reference is Some(marker)) {
    emitReferenceFor(walker, mutable emitter, nodeId, pos, label, iterable, body, marker)
  } else if (name == "Range.upTo" || name == "Range.between") {
    emitRangeFor(walker, mutable emitter, nodeId, pos, label, iterable, body, name)
  } else if (readNodeType(emitter, getExpressionId(iterable)) is Type.TRange) {
    emitRangeValueFor(walker, mutable emitter, nodeId, pos, label, iterable, body)
  } else if (name == "Map.keys" || name == "Map.entries") {
    Maps.emitMapFor(walker, mutable emitter, statement)
  } else if (name == "Array.values" || name == "Array.entries") {
    emitArrayFor(
      walker,
      mutable emitter,
      nodeId,
      pos,
      label,
      iterable,
      body,
      name == "Array.entries",
      true,
    )
  } else if (readNodeType(emitter, getExpressionId(iterable)) is Type.TArray(_)) {
    emitArrayFor(walker, mutable emitter, nodeId, pos, label, iterable, body, false, false)
  } else if (readNodeType(emitter, getExpressionId(iterable)) is Type.TGenerator(_, _, _, _, _)) {
    Generators.emitGeneratorFor(walker, mutable emitter, nodeId, pos, label, iterable, body)
  } else {
    const _ = reportUnsupported(mutable emitter, "for loop", NODE)
  }
  endStatement(mutable emitter)
}

function emitRangeFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  name: string,
) uses alloc {
  let arguments: Array<Expr> = []
  if (iterable is Expr.CallExpr(_, _, _, _, callArguments)) {
    for (const argument of Arrays.values(callArguments)) {
      Arrays.push(mutable arguments, argument.value)
    }
  }
  let low = "0"
  let high = ""
  if (name == "Range.upTo") {
    const upper = EmitWalker.emitExpression(walker, mutable emitter, arguments[0])
    high = temp(mutable emitter, Type.TInt, upper.text)
  } else {
    const lower = EmitWalker.emitExpression(walker, mutable emitter, arguments[0])
    low = temp(mutable emitter, Type.TInt, lower.text)
    const upper = EmitWalker.emitExpression(walker, mutable emitter, arguments[1])
    high = temp(mutable emitter, Type.TInt, upper.text)
  }
  const localIndex = declaredLocal(emitter, nodeId)
  const declaration = declareLocalVariable(mutable emitter, localIndex)
  const variable = localRef(emitter, localIndex)
  writeLine(
    mutable emitter,
    `for (${declaration} = ${low}; ${variable} < ${high}; ${variable}++) {`,
  )
  emitter.indent = emitter.indent + 1
  emitLoopBody(walker, mutable emitter, label, pos, body)
  const info = leaveLoop(mutable emitter)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
}

// emitRangeValueFor loops over a Range value, reading both bounds once.
function emitRangeValueFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
) uses alloc {
  const code = EmitWalker.emitExpression(walker, mutable emitter, iterable)
  const range = temp(mutable emitter, Type.TRange, code.text)
  const localIndex = declaredLocal(emitter, nodeId)
  const declaration = declareLocalVariable(mutable emitter, localIndex)
  const variable = localRef(emitter, localIndex)
  writeLine(
    mutable emitter,
    `for (${declaration} = ${range}.low; ${range}.step > 0 ? ${variable} < ${range}.high : ${variable} > ${range}.high; narra_range_advance(&${variable}, ${range}.step, ${range}.high)) {`,
  )
  emitter.indent = emitter.indent + 1
  emitLoopBody(walker, mutable emitter, label, pos, body)
  const info = leaveLoop(mutable emitter)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
}

// emitReferenceFor writes `for (mutable item of items)` and `for (const
// #[index, mutable item] of Arrays.entries(items))` (D85). The source array
// is made unique once, as for a `mutable` argument; the body cannot reach the
// source, so its storage stays where it is. The loop holds no reference to
// the array, and the element local is a pointer into it that is never
// retained or released.
function emitReferenceFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  marker: LoopReference,
) uses alloc {
  // The source is the iterable, or the argument of Arrays.values or Arrays.entries.
  let source = iterable
  if (iterable is Expr.CallExpr(_, _, _, _, callArguments)) {
    source = callArguments[0].value
  }
  const arrayType = readNodeType(emitter, getExpressionId(source))
  if (arrayType is Type.TArray(element)) {
    const arrayStruct = containerName(emitter, arrayType)
    const place = EmitWalker.emitLvaluePointer(walker, mutable emitter, source)
    const pointer = pointerTemp(mutable emitter, arrayType, place)
    writeLine(mutable emitter, `*${pointer} = ${arrayStruct}_unique(*${pointer});`)
    const array = temp(mutable emitter, arrayType, `*${pointer}`)
    emitter.tempCount = emitter.tempCount + 1
    const indexName = `i${Int.toString(emitter.tempCount)}`
    const indexDeclaration = declareVariable(mutable emitter, "int64_t", indexName)
    const index = variableRef(emitter, indexName)
    writeLine(
      mutable emitter,
      `for (${indexDeclaration} = 0; ${index} < ${array}->len; ${index}++) {`,
    )
    emitter.indent = emitter.indent + 1
    enterLoop(mutable emitter, label, pos)
    pushScope(mutable emitter, true)
    if (marker.indexName != "") {
      const indexLocal = declaredLocal(emitter, marker.indexId)
      declareLocal(mutable emitter, indexLocal, index)
    }
    const localIndex = declaredLocal(emitter, nodeId)
    const elementType = `${cType(emitter.checker, element)}*`
    const elementName = localName(readLocal(emitter, localIndex))
    const declaration = declareVariable(mutable emitter, elementType, elementName)
    writeLine(mutable emitter, `${declaration} = &${array}->items[${index}];`)
    emitBlockInScope(walker, mutable emitter, body)
    popScope(mutable emitter)
    emitContinueLabel(mutable emitter)
    const info = leaveLoop(mutable emitter)
    emitter.indent = emitter.indent - 1
    writeLine(mutable emitter, "}")
    emitBreakLabel(mutable emitter, info)
    return
  }
  const _ = reportUnsupported(mutable emitter, "for loop", NODE)
}

function emitArrayFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  entries: bool,
  isCall: bool,
) uses alloc {
  // Array.values and Array.entries loop over their argument; any other array is the source itself.
  let source = iterable
  if (isCall) {
    if (iterable is Expr.CallExpr(_, _, _, _, callArguments)) {
      source = callArguments[0].value
    }
  }
  const arrayType = readNodeType(emitter, getExpressionId(source))
  if (arrayType is Type.TArray(_)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, source)
    const array = consume(mutable emitter, code.text, code.owned, arrayType)
    // The loop owns the array until the statement ends.
    const top = Arrays.length(emitter.frames) - 1
    Arrays.push(mutable emitter.frames[top], TempVar { name: array, tempType: arrayType })
    emitter.tempCount = emitter.tempCount + 1
    const indexName = `i${Int.toString(emitter.tempCount)}`
    const indexDeclaration = declareVariable(mutable emitter, "int64_t", indexName)
    const index = variableRef(emitter, indexName)
    writeLine(
      mutable emitter,
      `for (${indexDeclaration} = 0; ${index} < ${array}->len; ${index}++) {`,
    )
    emitter.indent = emitter.indent + 1
    enterLoop(mutable emitter, label, pos)
    pushScope(mutable emitter, true)
    const localIndex = declaredLocal(emitter, nodeId)
    if (entries) {
      // Array.entries gives #[index, item]; an assignment to a frame field
      // needs a compound literal.
      let tupleValue = `{.f_0 = ${index}, .f_1 = ${array}->items[${index}]}`
      if (emitter.inGenerator) {
        const tupleName = cType(emitter.checker, readLocal(emitter, localIndex).localType)
        tupleValue = `(${tupleName})${tupleValue}`
      }
      declareLocal(mutable emitter, localIndex, tupleValue)
    } else {
      declareLocal(mutable emitter, localIndex, `${array}->items[${index}]`)
    }
    const variable = localRef(emitter, localIndex)
    const retainText = retainCode(emitter, readLocal(emitter, localIndex).localType, variable)
    if (retainText != "") {
      writeLine(mutable emitter, retainText)
    }
    addLocal(mutable emitter, localIndex)
    emitBlockInScope(walker, mutable emitter, body)
    popScope(mutable emitter)
    emitContinueLabel(mutable emitter)
    const info = leaveLoop(mutable emitter)
    emitter.indent = emitter.indent - 1
    writeLine(mutable emitter, "}")
    emitBreakLabel(mutable emitter, info)
    return
  }
  const _ = reportUnsupported(mutable emitter, "for loop", NODE)
}
