import * as Steps from "eci/steps"
import { step, shout } from "eci/steps"

export function plain(): int {
  return step(2) + shout(2)
}

export function qualified(): int {
  return Steps.step(2) + Steps.shout(2)
}

export function run(args: Array<string>): int uses io {
  return plain() + qualified()
}
