// The debug copy check reports each copy on write that no copy(...) explains.
// Here: one array written while another name shares it, and one array whose
// copy(...) ended before the write, so its credit no longer counts.
import * as Arrays from "std/array"
import * as Int from "std/int"

function total(values: Array<int>): int {
  let sum = 0
  for (const value of values) {
    sum += value
  }
  return sum
}

export function run(_args: Array<string>): int {
  const first = [1, 2, 3]
  let second = first
  second[0] = 10
  print(`${Int.toString(total(first))} ${Int.toString(total(second))}`)

  const third = [4, 5]
  print(Int.toString(total(copy(third))))
  let fourth = third
  Arrays.push(mutable fourth, 6)
  print(`${Int.toString(total(third))} ${Int.toString(total(fourth))}`)
  return 0
}
