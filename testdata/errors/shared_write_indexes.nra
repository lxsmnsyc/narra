// error: rows[j][0] = ... may change rows[i], which first still uses at line 10
export function run(args: Array<string>): int {
  let rows = [[1], [2]]
  // Identifier indexes are not compared: rows[i] and rows[j] may be the same
  // element.
  const i = 0
  const j = 1
  const first = rows[i]
  rows[j][0] = 4
  let total = first[0]
  // The same literal index is the same element.
  const second = rows[1]
  rows[1][0] = 5
  total += second[0]
  // Any element may be the one at a literal index.
  const third = rows[0]
  rows[j][0] = 6
  return total + third[0]
}
