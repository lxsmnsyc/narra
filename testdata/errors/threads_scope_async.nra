// error: a Scope
import * as Async from "std/async"
import * as Thread from "std/thread"

async function startLater(scope: Thread.Scope): int {
  const worker = Thread.start(scope, () => 41)
  return Thread.join(worker)
}

export function run(_args: Array<string>): int {
  Thread.scope((scope) => {
    Async.detach(startLater(scope))
    Async.detach(
      async {
        const worker = Thread.start(scope, () => 1)
        return Thread.join(worker)
      },
    )
    return 0
  })
  const task = Thread.scope(async (scope) => Thread.join(Thread.start(scope, () => 2)))
  Async.detach(task)
  return 0
}
