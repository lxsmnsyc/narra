// Array patterns over FixedArray<T, N>: a pattern of N elements, or `..._` after at
// most N, matches every value, so it destructures in const, let and for ... of.
import * as Int from "std/int"

struct Segment {
  name: string
  ends: FixedArray<int, 2>
}

function length(segment: Segment): int {
  const { name: _, ends: [start, end] } = segment
  return end - start
}

function corner<const N: int>(values: FixedArray<int, N>): string {
  // The length test is made per instance, so the generic body needs a cover for every N.
  return match (values) {
    [] => "empty"
    [only] => `one ${Int.toString(only)}`
    [first, second, ..._] => `first ${Int.toString(first)} ${Int.toString(second)}`
    [..._] => "unreachable in every instance"
  }
}

function label(cells: FixedArray<string, 3>): string {
  return match (cells) {
    ["x", "x", "x"] => "row of x"
    [_, "o", _] => "o in the middle"
    [first, ..._] => `starts with ${first}`
  }
}

export function run(args: Array<string>): int {
  const point: FixedArray<int, 3> = [1, 2, 3]
  const [x, y, z] = point
  print(Int.toString(x + y + z))
  let [head, ..._] = point
  head += 10
  print(Int.toString(head))

  // In a for ... of loop and inside a tuple pattern.
  const rows: Array<FixedArray<string, 2>> = [["a", "b"], ["c", "d"]]
  for (const [left, right] of rows) {
    print(`${left}${right}`)
  }
  const pair: #[FixedArray<int, 2>, string] = #[[7, 8], "pair"]
  const #[[first, second], name] = pair
  print(`${name} ${Int.toString(first)} ${Int.toString(second)}`)
  print(Int.toString(length(Segment { name: "s", ends: [3, 10] })))

  // FixedArray<int, 0> matches [].
  const nothing: FixedArray<int, 0> = []
  const [] = nothing
  print(match (nothing) { [] => "zero elements" })

  const one: FixedArray<int, 1> = [5]
  print(corner(nothing))
  print(corner(one))
  print(corner(point))
  print(label(["x", "x", "x"]))
  print(label(["a", "o", "c"]))
  print(label(["q", "r", "s"]))
  return 0
}
