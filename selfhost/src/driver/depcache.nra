// The dependency cache: a read-only checkout of one tag of a git repository, and the versions a
// repository offers. All git work runs through Process.run. A checkout is built in a temporary
// folder of the cache and moved into place, so an interrupted fetch leaves no half-written version.
import { isHash, splitString } from "narrac/driver/textops"
import * as Arrays from "std/array"
import * as Char from "std/char"
import * as Env from "std/env"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Path from "std/path"
import * as Process from "std/process"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { LoadError, isVersion } from "narrac/driver/manifest"
import * as Hash from "narrac/driver/hash"

export struct Fetched {
  path: string // the checkout, read-only
  commit: string // the full commit hash of the tag
  tree: string // the git tree hash of that commit, the content hash
}

struct ProgramRun {
  code: int
  output: string
  errorOutput: string
}

// Process.run closes stdin and cannot set variables, so git runs under sh: it never asks for a
// password on the terminal, and a missing git ends with exit code 127.
const GIT_SCRIPT = "GIT_TERMINAL_PROMPT=0 exec git \"$@\""

function createFetchError(code: string, message: string): LoadError {
  return LoadError { code, file: "", line: 0, column: 1, message }
}

function makeAbsolute(path: string): string uses io, alloc {
  if (Str.startsWith(path, "/")) {
    return path
  }
  // A relative folder is read against the working directory now, so a later chdir cannot move it.
  const working = Process.cwd()
  if (working is Ok(directory)) {
    if (directory != "") {
      return `${directory}/${path}`
    }
  }
  return path
}

function findCacheRoot(): string uses io, alloc {
  if (Env.get("NARRA_CACHE") is Some(configured)) {
    if (configured != "") {
      return makeAbsolute(configured)
    }
  }
  if (Env.get("HOME") is Some(home)) {
    if (home != "") {
      return `${home}/.cache/narra`
    }
  }
  return ""
}

const MAX_READABLE_BYTES = 64

function isSafeByte(code: int): bool {
  return ((code >= 48 && code <= 57) ||
    (code >= 65 && code <= 90) ||
    (code >= 97 && code <= 122) ||
    code == 45 ||
    code == 46 ||
    code == 95)
}

function sanitizeName(text: string): string uses alloc {
  let builder = Str.builder()
  // The readable part keeps at most 64 bytes; the hash of the whole text tells the names apart.
  let kept = Str.length(text)
  if (kept > MAX_READABLE_BYTES) {
    kept = MAX_READABLE_BYTES
  }
  for (const index of Ranges.between(0, kept)) {
    const code = Str.byteAt(text, index)
    if (isSafeByte(code)) {
      if (Char.fromCode(code) is Some(character)) {
        Str.append(mutable builder, Str.fromChar(character))
      }
    } else {
      Str.append(mutable builder, "_")
    }
  }
  let cleaned = Str.build(builder)
  if (Str.startsWith(cleaned, ".")) {
    cleaned = `_${cleaned}`
  }
  // The hash of the original text keeps `a/b` and `a_b` in separate folders.
  return `${cleaned}-${Hash.hex8(Hash.xxh32(text, 0))}`
}

export function checkoutPath(git: string, tag: string): string uses io, alloc {
  return `${findCacheRoot()}/git/${sanitizeName(git)}/${sanitizeName(tag)}`
}

function runProgram(
  program: string,
  arguments: Array<string>,
): Result<ProgramRun, string> uses io, alloc {
  const ran = Process.run(program, arguments)
  if (ran is Err(message)) {
    return Err(message)
  }
  const #[code, output, errorOutput] = ran.value
  return Ok(ProgramRun { code, output, errorOutput })
}

function runGit(gitArguments: Array<string>): Result<ProgramRun, LoadError> uses io, alloc {
  let shellArguments = ["-c", GIT_SCRIPT, "sh"]
  for (const argument of Arrays.values(gitArguments)) {
    Arrays.push(mutable shellArguments, argument)
  }
  const ran = runProgram("sh", shellArguments)
  if (ran is Err(message)) {
    return Err(createFetchError("E0440", `git cannot run: ${message}`))
  }
  if (ran.value.code == 127) {
    return Err(createFetchError("E0440", "git was not found on PATH"))
  }
  return Ok(ran.value)
}

function getFirstLine(text: string): string uses alloc {
  return splitString(Str.trim(text), "\n")[0]
}

function listTags(git: string): Result<Array<string>, LoadError> uses io, alloc {
  const ran = runGit(["ls-remote", "--tags", "--", git])
  if (ran is Err(error)) {
    return Err(error)
  }
  if (ran.value.code != 0) {
    return Err(
      createFetchError(
        "E0441",
        `cannot read the repository ${git}: ${getFirstLine(ran.value.errorOutput)}`,
      ),
    )
  }
  const prefix = "refs/tags/"
  let tags: Array<string> = []
  for (const line of Arrays.values(splitString(ran.value.output, "\n"))) {
    const columns = splitString(line, "\t")
    if (Arrays.length(columns) != 2 || !Str.startsWith(columns[1], prefix)) {
      continue
    }
    const name = Str.sliceFrom(columns[1], Str.length(prefix))
    // An annotated tag is listed twice; the second line ends with ^{}.
    if (!Str.endsWith(name, "^{}")) {
      Arrays.push(mutable tags, name)
    }
  }
  return Ok(tags)
}

function readVersionPart(version: string, index: int): int uses alloc {
  const parsed = Int.parse(splitString(version, ".")[index], 10)
  if (parsed is Ok(part)) {
    return part
  }
  return 0
}

export function isVersionBefore(left: string, right: string): bool uses alloc {
  // A text that is not a version, such as a part too large for an int, is before nothing.
  if (!isVersion(left) || !isVersion(right)) {
    return false
  }
  for (const index of Ranges.between(0, 3)) {
    const leftPart = readVersionPart(left, index)
    const rightPart = readVersionPart(right, index)
    if (leftPart != rightPart) {
      return leftPart < rightPart
    }
  }
  return false
}

function collectVersions(tags: Array<string>, prefix: string): Array<string> uses alloc {
  let versions: Array<string> = []
  for (const tag of Arrays.values(tags)) {
    if (!Str.startsWith(tag, prefix)) {
      continue
    }
    const version = Str.sliceFrom(tag, Str.length(prefix))
    if (isVersion(version)) {
      Arrays.push(mutable versions, version)
    }
  }
  for (const position of Ranges.between(1, Arrays.length(versions))) {
    const version = versions[position]
    let slot = position
    while (slot > 0 && isVersionBefore(version, versions[slot - 1])) {
      versions[slot] = versions[slot - 1]
      slot--
    }
    versions[slot] = version
  }
  return versions
}

export function listVersions(
  git: string,
  name: string,
): Result<Array<string>, LoadError> uses io, alloc {
  const tags = listTags(git)
  if (tags is Err(error)) {
    return Err(error)
  }
  const members = collectVersions(tags.value, `${name}/v`)
  if (Arrays.length(members) > 0) {
    return Ok(members)
  }
  return Ok(collectVersions(tags.value, "v"))
}

export function readRecorded(path: string): Result<Fetched, LoadError> uses io, alloc {
  const text = Fs.readText(`${path}.hash`)
  if (text is Err(message)) {
    return Err(
      createFetchError("E0443", `the cached version ${path} has no recorded hash: ${message}`),
    )
  }
  const lines = splitString(Str.trim(text.value), "\n")
  if (Arrays.length(lines) != 2 || !isHash(lines[0]) || !isHash(lines[1])) {
    return Err(
      createFetchError(
        "E0443",
        `the recorded hash of the cached version ${path} is damaged; delete it and ${path}.hash to fetch again`,
      ),
    )
  }
  return Ok(Fetched { path, commit: lines[0], tree: lines[1] })
}

function readRevision(
  checkout: string,
  revision: string,
): Result<string, LoadError> uses io, alloc {
  const ran = runGit(["-C", checkout, "rev-parse", revision])
  if (ran is Err(error)) {
    return Err(error)
  }
  const hash = Str.trim(ran.value.output)
  if (ran.value.code != 0 || !isHash(hash)) {
    return Err(
      createFetchError(
        "E0445",
        `cannot read ${revision} of the checkout: ${getFirstLine(ran.value.errorOutput)}`,
      ),
    )
  }
  return Ok(hash)
}

function buildCheckout(
  temporary: string,
  path: string,
  git: string,
  tag: string,
): Result<Fetched, LoadError> uses io, alloc {
  const work = `${temporary}/work`
  // Fetch the tag by its full name: `clone --branch` would prefer a branch of the same name.
  const initialized = runGit(["init", "--quiet", work])
  if (initialized is Err(error)) {
    return Err(error)
  }
  if (initialized.value.code != 0) {
    return Err(
      createFetchError(
        "E0445",
        `cannot start a checkout in ${work}: ${getFirstLine(initialized.value.errorOutput)}`,
      ),
    )
  }
  const reference = `refs/tags/${tag}`
  const cloned = runGit(["-C", work, "fetch", "--quiet", "--depth", "1", "--", git, reference])
  if (cloned is Err(error)) {
    return Err(error)
  }
  if (cloned.value.code != 0) {
    return Err(
      createFetchError(
        "E0445",
        `cannot check out ${tag} of ${git}: ${getFirstLine(cloned.value.errorOutput)}`,
      ),
    )
  }
  const checkedOut = runGit(["-C", work, "checkout", "--quiet", "FETCH_HEAD"])
  if (checkedOut is Err(error)) {
    return Err(error)
  }
  if (checkedOut.value.code != 0) {
    return Err(
      createFetchError(
        "E0445",
        `cannot check out ${tag} of ${git}: ${getFirstLine(checkedOut.value.errorOutput)}`,
      ),
    )
  }
  const commit = readRevision(work, "HEAD")
  if (commit is Err(error)) {
    return Err(error)
  }
  const tree = readRevision(work, "HEAD^{tree}")
  if (tree is Err(error)) {
    return Err(error)
  }
  const hashFile = `${temporary}/hash`
  const written = Fs.writeText(hashFile, `${commit.value}\n${tree.value}\n`)
  if (written is Err(message)) {
    return Err(createFetchError("E0445", `cannot write ${hashFile}: ${message}`))
  }
  const created = Fs.createDirAll(Path.dirname(path))
  if (created is Err(message)) {
    return Err(createFetchError("E0445", `cannot create the cache folder: ${message}`))
  }
  // The history stays out of the cache: a dependency is its files, and .git would hold a second copy.
  const stripped = Fs.removeDirAll(`${work}/.git`)
  if (stripped is Err(message)) {
    return Err(createFetchError("E0445", `cannot remove the history of the checkout: ${message}`))
  }
  // Another fetch of the same version may have won the race.
  if (Fs.exists(path)) {
    return readRecorded(path)
  }
  const hashMoved = Fs.rename(hashFile, `${path}.hash`)
  if (hashMoved is Err(message)) {
    return failInstall(path, `cannot move the checkout into the cache: ${message}`)
  }
  const checkoutMoved = Fs.rename(work, path)
  if (checkoutMoved is Err(message)) {
    return failInstall(path, `cannot move the checkout into the cache: ${message}`)
  }
  // The cache is read-only so a build cannot edit a dependency; a failed chmod leaves it writable.
  const _sealed = runProgram("chmod", ["-R", "a-w", path])
  return Ok(Fetched { path, commit: commit.value, tree: tree.value })
}

function failInstall(path: string, message: string): Result<Fetched, LoadError> uses io, alloc {
  // Another fetch of the same version may have won the race.
  if (Fs.isDir(path)) {
    return readRecorded(path)
  }
  return Err(createFetchError("E0445", message))
}

function downloadVersion(
  root: string,
  path: string,
  git: string,
  tag: string,
): Result<Fetched, LoadError> uses io, alloc {
  const temporaryRoot = `${root}/tmp`
  const created = Fs.createDirAll(temporaryRoot)
  if (created is Err(message)) {
    return Err(createFetchError("E0445", `cannot create ${temporaryRoot}: ${message}`))
  }
  const made = runProgram("mktemp", ["-d", `${temporaryRoot}/fetch.XXXXXX`])
  if (made is Err(message)) {
    return Err(createFetchError("E0445", `cannot create a temporary folder: ${message}`))
  }
  if (made.value.code != 0) {
    return Err(createFetchError("E0445", `cannot create a temporary folder in ${temporaryRoot}`))
  }
  const temporary = Str.trim(made.value.output)
  const built = buildCheckout(temporary, path, git, tag)
  const _ = Fs.removeDirAll(temporary)
  return built
}

export function fetchVersion(git: string, tag: string): Result<Fetched, LoadError> uses io, alloc {
  const root = findCacheRoot()
  if (root == "") {
    return Err(createFetchError("E0444", "no cache folder: set NARRA_CACHE or HOME"))
  }
  const path = checkoutPath(git, tag)
  if (Fs.isDir(path)) {
    return readRecorded(path)
  }
  const tags = listTags(git)
  if (tags is Err(error)) {
    return Err(error)
  }
  let found = false
  for (const name of Arrays.values(tags.value)) {
    if (name == tag) {
      found = true
    }
  }
  if (!found) {
    return Err(createFetchError("E0442", `the repository ${git} has no tag ${tag}`))
  }
  return downloadVersion(root, path, git, tag)
}

export function checkTree(
  fetched: Fetched,
  expectedTree: string,
): Result<Fetched, LoadError> from fetched uses alloc {
  if (expectedTree != "" && fetched.tree != expectedTree) {
    return Err(
      createFetchError(
        "E0443",
        `the cached version ${fetched.path} has tree ${fetched.tree}, but ${expectedTree} was expected`,
      ),
    )
  }
  return Ok(fetched)
}

function printFailure(error: LoadError): int uses io, alloc {
  const _ = Fs.writeText("/dev/stderr", `error ${error.code}: ${error.message}\n`)
  return 1
}

function printText(text: string): int uses io, alloc {
  const written = Fs.writeText("/dev/stdout", text)
  if (written is Err(message)) {
    const _ = Fs.writeText("/dev/stderr", `${message}\n`)
    return 1
  }
  return 0
}

export function runDepsCommand(arguments: Array<string>): int uses io, alloc {
  const count = Arrays.length(arguments)
  if (arguments[2] == "--fetch" && (count == 5 || count == 6)) {
    const fetched = fetchVersion(arguments[3], arguments[4])
    if (fetched is Err(error)) {
      return printFailure(error)
    }
    let expectedTree = ""
    if (count == 6) {
      expectedTree = arguments[5]
    }
    const checked = checkTree(fetched.value, expectedTree)
    if (checked is Err(error)) {
      return printFailure(error)
    }
    return printText(
      `commit ${fetched.value.commit}\ntree ${fetched.value.tree}\npath ${fetched.value.path}\n`,
    )
  }
  if (arguments[2] == "--versions" && count == 5) {
    const versions = listVersions(arguments[3], arguments[4])
    if (versions is Err(error)) {
      return printFailure(error)
    }
    let output = ""
    for (const version of Arrays.values(versions.value)) {
      output = `${output}${version}\n`
    }
    return printText(output)
  }
  const _ = Fs.writeText(
    "/dev/stderr",
    "usage: narrac pkg --fetch <git> <tag> [<tree>] | narrac pkg --versions <git> <name>\n",
  )
  return 2
}
