// Sleeping tasks finish in deadline order, and tasks with equal durations in
// the order they set them. The deadlines are far apart, so a loaded machine
// keeps the order.
import * as Int from "std/int"
import * as AsyncTime from "std/async/time"
import * as Time from "std/time"

async function nap(name: string, milliseconds: int): int uses io, alloc {
  const slept = await AsyncTime.sleep(Time.milliseconds(milliseconds))
  if (slept is Ok(duration)) {
    if (Time.asMilliseconds(duration) >= milliseconds) {
      print(`${name} woke`)
      return 1
    }
    print(`${name} woke early`)
    return 0
  }
  print(`${name} cancelled`)
  return 0
}

export async function run(_args: Array<string>): int {
  const late = nap("late", 600)
  const early = nap("early", 50)
  const middle = nap("middle", 400)
  const first = nap("first of two", 200)
  const second = nap("second of two", 200)
  const third = nap("first of zero", 0)
  const fourth = nap("second of zero", 0)
  print("all started")
  const total =
    await late +
      await early +
      await middle +
      await first +
      await second +
      await third +
      await fourth
  print(`woke ${Int.toString(total)}`)
  return 0
}
