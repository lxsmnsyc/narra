import * as Arrays from "std/array"

trait Label {
  function label(value: Self): string
}

struct Tag implements Label {
  text: string
}

implement Label for Tag {
  function label(value: Tag): string {
    return `#${value.text}`
  }
}

struct Pair<T: Show> implements Label, Show {
  left: T
  right: T
}

implement Label for Pair<T> {
  function label(value: Pair<T>): string {
    return `(${Show.show(value.left)} ${Show.show(value.right)})`
  }
}

implement Show for Pair<T> {
  function show(value: Self): string {
    return `pair ${Label.label(value)}`
  }
}

function wrap<T: Label>(value: T): Dynamic<Label> uses alloc {
  return Dynamic.of(value)
}

function wrapAll<T: Label>(values: Array<T>): Array<Dynamic<Label>> uses alloc {
  let wrapped: Array<Dynamic<Label>> = []
  for (const value of values) {
    Arrays.push(mutable wrapped, Dynamic.of(value))
  }
  return wrapped
}

export function run(_args: Array<string>): int {
  const labels: Array<Dynamic<Label>> = [
    wrap(Tag { text: "a" }),
    wrap(Pair { left: 1, right: 2 }),
    Dynamic.of(Pair { left: "x", right: "y" }),
  ]
  for (const item of labels) {
    print(Label.label(item))
  }
  for (const item of wrapAll([Tag { text: "b" }, Tag { text: "c" }])) {
    print(Label.label(item))
  }
  const shown: Array<Dynamic<Show>> = [
    Dynamic.of(Pair { left: 1, right: 2 }),
    Dynamic.of(Pair { left: Pair { left: 1, right: 2 }, right: Pair { left: 3, right: 4 } }),
  ]
  for (const item of shown) {
    print(Show.show(item))
  }
  return 0
}
