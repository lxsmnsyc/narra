// `mutable` changes the contents of a value and `const` fixes only the name:
// a local `const` can have its fields and elements assigned and be passed as
// mutable, and a closure that changes a captured `const` holds it by reference.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Boxes from "std/box"
import * as Maps from "std/map"
import * as Str from "std/string"

struct Player {
  name: string
  hp: int
  items: Array<string>
}

function heal(mutable player: Player, amount: int) {
  player.hp = player.hp + amount
  Arrays.push(mutable player.items, "potion")
}

function addAll(mutable totals: Map<string, int>, name: string) {
  totals[name] = Str.length(name)
}

function each(items: Array<int>, action: (item: int) => void) {
  for (const item of Arrays.values(items)) {
    action(item)
  }
}

function twice(action: () => void) {
  action()
  action()
}

export function run(args: Array<string>): int {
  // A const struct: field writes and a mutable argument.
  const hero = Player { name: "Ada", hp: 1, items: [] }
  hero.hp = 5
  heal(mutable hero, 3)
  print(`${hero.name} ${Int.toString(hero.hp)} ${Int.toString(Arrays.length(hero.items))}`)

  // A copy stays a copy.
  const copy = hero
  hero.hp = 0
  print(`${Int.toString(copy.hp)} ${Int.toString(hero.hp)}`)

  // A const array, map and box change in place.
  const numbers = [1, 2]
  Arrays.push(mutable numbers, 3)
  numbers[0] = 10
  const totals: Map<string, int> = Map {}
  addAll(mutable totals, "abc")
  const box = Boxes.new(1)
  box.value = 6
  print(
    `${Int.toString(numbers[0] + numbers[2])} ${Int.toString(Maps.size(totals))} ${Int.toString(box.value)}`,
  )

  // A closure, and a closure nested in another, push to a captured const.
  // The pushes reallocate the array, so every closure holds it by reference.
  const seen: Array<int> = []
  each(numbers, (item) => {
    twice(() => {
      Arrays.push(mutable seen, item)
    })
  })
  each(
    [4],
    (item) => {
      Arrays.push(mutable seen, item)
      hero.hp = hero.hp + item
    },
  )
  print(`${Int.toString(Arrays.length(seen))} ${Int.toString(seen[6])} ${Int.toString(hero.hp)}`)

  // A const that a closure only reads is still captured by value.
  const label = "seen"
  twice(() => {
    print(`${label} ${Int.toString(Arrays.length(seen))}`)
  })
  return 0
}
