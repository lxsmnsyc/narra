// Display width in std/unicode: terminal columns per grapheme cluster.
import * as Unicode from "std/unicode"
import * as Int from "std/int"

function show(label: string, text: string) uses io, alloc {
  print(`${label}: ${Int.toString(Unicode.displayWidth(text))}`)
}

export function run(args: Array<string>): int uses io, alloc {
  show("ascii", "hello")
  show("ascii controls", "a\tb\r\n")
  show("empty", "")
  show("cjk", "\u{4e2d}\u{6587}")
  show("fullwidth", "\u{ff21}\u{ff22}")
  show("hangul syllable", "\u{d55c}")
  show("hangul jamo", "\u{1112}\u{1161}\u{11ab}")
  show("combining mark", "e\u{301}")
  show("lone combining mark", "\u{301}")
  show("zero width space", "a\u{200b}b")
  show("flag", "\u{1f1ef}\u{1f1f5}")
  show("zwj family", "\u{1f468}\u{200d}\u{1f469}\u{200d}\u{1f467}\u{200d}\u{1f466}")
  show("emoji", "\u{1f600}")
  show("heart text", "\u{2764}")
  show("heart emoji", "\u{2764}\u{fe0f}")
  show("keycap", "1\u{fe0f}\u{20e3}")
  show("devanagari", "\u{915}\u{94d}\u{937}\u{93f}")
  show("mixed", "ab\u{4e2d}\u{1f600}c")
  show("tab", "\t")
  show("ambiguous", "\u{b1}\u{3b1}")
  show("emoji text selector", "\u{1f600}\u{fe0e}")
  show("hangul filler", "\u{115f}")
  return 0
}
