const limit: int = 3

export function handle(request: string): string from request uses io {
  return request
}

export type Handler = typeof handle

export function call(handler: Handler, request: string): string from request uses io {
  return handler(request)
}

export function repeat(count: typeof limit, same: typeof count): int {
  const total: typeof count = count + same
  return total
}

export function run(_args: Array<string>): int {
  return repeat(limit, 1)
}
