// Async blocks: the value comes from return, which ends the block and not the
// function, and the block starts at once with copies of what it captures.
import * as Int from "std/int"
import * as Async from "std/async"

async function triple(value: int): int {
  return value * 3
}

function start(base: int): Async<string> uses io, alloc {
  return async {
    print("block starts")
    if (base > 10) {
      return "big"
    }
    const tripled = await triple(base)
    await Async.idle()
    return `small ${Int.toString(tripled)}`
  }
}

export async function run(_args: Array<string>): int {
  const label = "count"
  const counted = async {
    const value = await triple(4)
    return `${label} ${Int.toString(value)}`
  }
  print("after the block")
  print(await counted)
  const small = start(2)
  print("started")
  print(await small)
  print(await start(20))
  return 0
}
