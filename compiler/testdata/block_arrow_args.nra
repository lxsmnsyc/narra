// Block-body arrows with several statements as call arguments: alone, nested
// in another call, and as the last of several arguments.
import * as Int from "std/int"

function apply(f: (x: int) => int): int {
  return f(1)
}

function applyTwice(n: int, f: (x: int) => int): int {
  return f(f(n))
}

struct Pair {
  a: int
  b: int
}

export function run(args: Array<string>): int {
  print(
    Int.toString(
      apply((x) => {
        print("io")
        const doubled = x * 2
        return doubled + 1
      }),
    ),
  )
  print(
    Int.toString(
      apply((x) => {
        return applyTwice(x, (y) => {
          print("inner")
          return y + 10
        })
      }),
    ),
  )
  print(
    Int.toString(
      applyTwice(3, (x) => {
        const pair = Pair {
          a: x,
          b: 2,
        }
        return pair.a * pair.b
      }),
    ),
  )
  return 0
}
