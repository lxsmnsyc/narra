// Equality of two lists 60000 deep: the evaluator compares values with its own
// stack, not the C stack.
enum List derives Equatable {
  Nil
  Cons(head: int, tail: List)
}

@const
function build(count: int): List {
  let list = List.Nil
  for (let index = 0; index < count; index++) {
    list = List.Cons(index, list)
  }
  return list
}

@const
function same(count: int): bool {
  return build(count) == build(count)
}

const SAME = same(60000)

export function run(args: Array<string>): int uses io, alloc {
  // The emitted equality recurses in C, so the run-time call uses a list a sanitizer build can hold.
  const count = 2000
  print(SAME ? "same" : "different")
  print(same(count) ? "same" : "different")
  return 0
}
