// Generators that hold strings and arrays across yields, with yields inside
// nested while loops, for-of over an array and over a range, and a match
// statement arm.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

enum Shape {
  Circle(radius: int)
  Square(side: int)
  Label(text: string)
}

// The words of each line, with the line number before each word.
function* words(lines: Array<string>): Generator<string> {
  let number = 0
  for (const line of lines) {
    const prefix = `${Int.toString(number)}:`
    for (const word of splitString(line, " ")) {
      yield `${prefix}${word}`
    }
    number = number + 1
  }
}

// A grid walked with two nested while loops, holding an array of rows.
function* grid(width: int, height: int): Generator<Array<int>> {
  let row = 0
  while (row < height) {
    let column = 0
    let cells: Array<int> = []
    while (column < width) {
      Arrays.push(mutable cells, row * width + column)
      yield cells
      column = column + 1
    }
    row = row + 1
  }
}

// One description per shape; a match arm yields twice.
function* describe(shapes: Array<Shape>): Generator<string> {
  for (const index of Ranges.between(0, Arrays.length(shapes))) {
    const kind = "shape"
    match (shapes[index]) {
      Shape.Circle(radius) => {
        yield `${kind} ${Int.toString(index)} circle`
        yield `radius ${Int.toString(radius)}`
      }
      Shape.Square(side) => {
        yield `${kind} ${Int.toString(index)} square ${Int.toString(side)}`
      }
      Shape.Label(text) => {
        const shown = Str.concat(text, "!")
        yield shown
        yield `${shown} again`
      }
    }
  }
}

// if-is holds its subject across a yield.
function* firstLabel(shapes: Array<Shape>): Generator<string> {
  for (const shape of shapes) {
    if (shape is Shape.Label(text)) {
      yield text
      yield `after ${text}`
      return
    }
  }
}

export function run(args: Array<string>): int {
  for (const word of words(["alpha beta", "gamma", "delta epsilon zeta"])) {
    print(word)
  }
  for (const cells of grid(3, 2)) {
    print(Int.toString(Arrays.length(cells)))
  }
  const shapes = [Shape.Circle(2), Shape.Label("hi"), Shape.Square(4)]
  for (const text of describe(shapes)) {
    print(text)
  }
  for (const text of firstLabel(shapes)) {
    print(text)
  }
  return 0
}

function splitString(text: string, separator: string): Array<string> uses alloc {
  return match (Str.split(text, separator)) { Some(pieces) => pieces, None => [] }
}
