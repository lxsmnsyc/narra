import * as Int from "std/int"

struct A<T> {
  b: Option<Box<B<int>>>
  x: T
}

struct B<U> {
  a: Option<Box<A<string>>>
  y: U
}

export function run(args: Array<string>): int {
  const a: A<string> = A { b: None, x: "a" }
  const b: B<int> = B { a: Some(Box.new(a)), y: 3 }
  if (b.a is Some(p)) {
    print(p.value.x)
  }
  print(Int.toString(b.y))
  return 0
}
