// error: async function grow cannot take a mutable parameter "items"; its task outlives the call
import * as Arrays from "std/array"

async function grow(mutable items: Array<int>): int {
  Arrays.push(mutable items, 1)
  return Arrays.length(items)
}

export async function run(_args: Array<string>): int {
  let items = [0]
  return await grow(mutable items)
}
