// How a type writes its `uses` list: one effect bare, two or more in
// parentheses, so a `,` after the type ends it. A declaration's own list
// stays a bare comma list and is not written here.
import * as Arrays from "std/array"
import * as Str from "std/string"

export function writeTypeUses(effects: Array<string>): string uses alloc {
  if (Arrays.length(effects) == 0) {
    return ""
  }
  return ` uses ${writeTypeEffects(effects)}`
}

export function writeTypeEffects(effects: Array<string>): string uses alloc {
  // The part after `uses`: `io`, or `(io, alloc)`.
  if (Arrays.length(effects) == 1) {
    return effects[0]
  }
  return `(${Str.join(effects, ", ")})`
}
