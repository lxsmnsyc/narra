// Named arguments (D87): positional arguments first, then named ones in any
// order. The arguments are evaluated in the order they are written and passed
// in the order of the parameters.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Options from "std/option"
import * as Str from "std/string"
import * as Ranges from "std/range"

function move(x: int, y: int, z: int): string {
  return `${Int.toString(x)},${Int.toString(y)},${Int.toString(z)}`
}

function joinPair(first: string, second: string): string {
  return `${first}+${second}`
}

function say(label: string, number: int): int {
  print(label)
  return number
}

function pushTimes(mutable items: Array<string>, item: string, times: int) {
  for (const _ of Ranges.upTo(times)) {
    Arrays.push(mutable items, item)
  }
}

function pick<T>(first: T, second: T, takeSecond: bool): T {
  if (takeSecond) {
    return second
  }
  return first
}

trait Sized {
  function size(value: Self, scale: int): int
}

struct Box implements Sized, Padded {
  width: int
}

implement Sized for Box {
  function size(value: Box, scale: int): int {
    return value.width * scale
  }
}

trait Padded {
  function padded(value: Self, scale: int, extra: int): int
}

implement Padded for Box {
  function padded(value: Box, scale: int, extra: int): int {
    return value.width * scale + extra
  }
}

function makeBox(width: int): Box {
  print("box")
  return Box { width: width }
}

// a self tail call with named arguments in another order
function countDown(count: int, total: int, label: string): string {
  if (count == 0) {
    return `${label}${Int.toString(total)}`
  }
  return countDown(label: label, total: total + count, count: count - 1)
}

export function run(args: Array<string>): int {
  // reordering, and mixing positional with named
  print(move(x: 1, y: 2, z: 3))
  print(move(z: 3, x: 1, y: 2))
  print(move(1, z: 3, y: 2))

  // written-order evaluation: "first" prints before "second"
  print(move(z: say("first", 30), x: 10, y: say("second", 20)))

  // a positional argument runs before the reordered named ones after it
  print(move(say("x", 1), z: say("z", 3), y: say("y", 2)))

  // a block argument that assigns a variable read by an earlier argument
  let seen = 1
  print(
    move(
      y: seen,
      x: {
        seen = seen + 1
        return seen
      },
      z: seen,
    ),
  )

  // a reference-counted value read before a later argument changes it
  let word = "old"
  print(
    joinPair(
      second: word,
      first: {
        word = "newer"
        return word
      },
    ),
  )

  // a mutable argument after the colon
  let items: Array<string> = []
  pushTimes(times: 2, item: "a", items: mutable items)
  pushTimes(mutable items, times: 1, item: "b")
  print(Str.join(items, ""))

  // a generic callee infers its type argument from named arguments
  print(pick(takeSecond: true, second: "right", first: "left"))
  print(Int.toString(pick(second: 2, first: 1, takeSecond: false)))

  // an imported generic callee
  const missing: Option<int> = None()
  print(Int.toString(Options.withDefault(fallback: 7, option: missing)))
  const doubled = Options.map(f: (value: int) => value * 2, option: Some(21))
  print(Int.toString(Options.withDefault(doubled, fallback: 0)))

  // a trait function
  print(Int.toString(Sized.size(scale: 3, value: Box { width: 5 })))
  print(Int.toString(Padded.padded(makeBox(5), extra: say("extra", 1), scale: say("scale", 3))))

  print(countDown(total: 0, label: "sum=", count: 4))
  return 0
}
