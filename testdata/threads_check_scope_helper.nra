// A Scope may be passed to a function that starts threads in it (D111 item 4).
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Thread from "std/thread"

function sumRange(first: int, last: int): int {
  let sum = 0
  for (let number = first; number <= last; number++) {
    sum = sum + number
  }
  return sum
}

function startSums(scope: Thread.Scope, parts: int): Array<Thread.Thread<int>> uses alloc {
  let threads: Array<Thread.Thread<int>> = []
  for (let part = 0; part < parts; part++) {
    const first = part * 100 + 1
    Arrays.push(mutable threads, Thread.start(scope, () => sumRange(first, first + 99)))
  }
  return threads
}

export function run(_args: Array<string>): int {
  const total = Thread.scope((scope) => {
    let sum = 0
    for (const thread of Arrays.values(startSums(scope, 4))) {
      sum = sum + Thread.join(thread)
    }
    return sum
  })
  print(Int.toString(total))
  return 0
}
