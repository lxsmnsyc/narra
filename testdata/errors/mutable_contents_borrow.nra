// error: "items" is assigned by a closure passed to this call, so no other argument can use it
import * as Arrays from "std/array"

function each(_values: Array<int>, action: () => void) {
  action()
}

export function run(args: Array<string>): int {
  const items = [1]
  each(items, () => {
    Arrays.push(mutable items, 2)
  })
  return 0
}
