import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

struct Point {
  x: int
  y: int
}

const SECOND = 1
const THIRD = 2

function makePair(label: string): #[int, string] uses alloc {
  return #[Str.length(label), `${label}!`]
}

function readSecond<A, B>(pair: #[A, B]): B from pair {
  return pair[1]
}

function show(value: int): string uses alloc {
  return Int.toString(value)
}

function describe(text: string): string uses alloc {
  return `<${text}>`
}

function kindOf(pair: #[int, string]): string {
  match (pair[0]) {
    0 => {
      return "zero"
    }
    _ => {
      return "many"
    }
  }
}

function readKept(): #[string, Array<int>] uses alloc {
  const triple = #["kept", [1, 2, 3], Point { x: 4, y: 5 }]
  const name = triple[0]
  const numbers = triple[1]
  return #[name, numbers]
}

export function run(_args: Array<string>): int uses io, alloc {
  const pair = #[7, "seven"]
  print(show(pair[0]))
  print(pair[1])

  const triple = #[1, "two", Point { x: 3, y: 4 }]
  const point = triple[2]
  print(show(triple[0] + point.x + triple[2].y))
  print(triple[1])

  const mixed = #["words", [10, 20, 30], 2]
  print(mixed[0])
  print(show(Arrays.length(mixed[1])))
  print(show(mixed[1][2]))
  print(show(Arrays.length(mixed[1]) * mixed[2]))

  const grid = #[#[1, 2], #[3, 4]]
  print(show(grid[0][1] + grid[1][0]))

  print(pair[SECOND])
  print(show(triple[THIRD].x))

  const made = makePair("abc")
  print(show(made[0]))
  print(makePair("hello")[1])

  print(readSecond(pair))
  print(show(readSecond(#[true, 9])))

  print(kindOf(#[0, "a"]))
  print(kindOf(pair))
  print(describe(pair[1]))
  print(show(Str.length(triple[1])))

  const #[kept, numbers] = readKept()
  print(kept)
  print(show(Arrays.length(numbers)))
  print(show(numbers[1]))

  const list = [#[1, "a"], #[2, "b"]]
  print(list[1][1])
  return 0
}
