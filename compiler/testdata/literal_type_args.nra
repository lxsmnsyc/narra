import * as Array from "std/array"
import * as Map from "std/map"
import * as Int from "std/int"

struct Pair<A, B> {
  a: A
  b: B
}

struct Plain {
  n: int
}

function count<K, V>(m: Map<K, V>): int {
  return Map.size(m)
}

function first(p: Pair<int, string>): string {
  return `${Int.toString(p.a)}:${p.b}`
}

function nested(): Map<string, Array<int>> {
  return Map<string, Array<int>> { "x": [1, 2] }
}

export function run(args: Array<string>): int {
  // An empty map without an annotation, passed to a generic function.
  print(Int.toString(count(Map<string, int> {})))
  const m = Map<string, int> { "a": 1, "b": 2 }
  print(Int.toString(count(m)))
  const k = Map<int, Pair<int, string>> { 1: Pair<int, string> { a: 1, b: "one" } }
  print(Int.toString(Map.size(k)))
  const p = Pair<int, string> { a: 7, b: "seven" }
  print(first(p))
  // The type arguments let a field take an empty array literal.
  const e = Pair<Array<int>, string> { a: [], b: "empty" }
  print(Int.toString(Array.length(e.a)))
  const q = Pair<int, string> { ...p, a: 8 }
  print(first(q))
  print(Int.toString(count(nested())))
  // They agree with the expected type.
  const m2: Map<string, int> = Map<string, int> {}
  print(Int.toString(Map.size(m2)))
  // Comparisons still parse.
  const a = 1
  const b = 2
  const lt = a < b
  if (lt) {
    print("lt")
  }
  const g = Plain { n: 3 }
  if (g.n < b + 2) {
    print("lt2")
  }
  return 0
}
