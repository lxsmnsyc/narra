// A std module for the stddocs case of the generated suite. Each `///` run below is
// stray except the one above `double`.

/// Gives twice the value.
@const
export function double(value: int): int {
  return value * 2
}

/// A doc above a function that is not exported.
function half(value: int): int {
  return value / 2
}

/// A doc with a blank line after it.

export function triple(value: int): int {
  return half(value) + value * 2
}

export function quadruple(value: int): int {
  /// A doc inside a body.
  return value * 4
}
/// A doc at the end of the file.
