async function* pairs(): AsyncGenerator<#[int, string]> {
  yield #[1, "one"]
}

export async function run(_args: Array<string>): int {
  let total = 0
  for await (const pair of pairs()) {
    total += pair[0]
  }
  for await (const #[index, _name] of pairs()) {
    total += index
  }
  return total
}
