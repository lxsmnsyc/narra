// error: FixedArray<f32, 3> has no vector type: a vector holds 16 or 32 bytes of i8 to u64, f32 or f64 lanes
import * as Simd from "std/simd"

export function run(_args: Array<string>): int {
  const three: FixedArray<f32, 3> = [1.0, 2.0, 3.0]
  const v = Simd.fromFixed(three)
  const words: FixedArray<string, 4> = ["a", "b", "c", "d"]
  const w = Simd.fromFixed(words)
  const items = [1, 2, 3, 4]
  const z = Simd.fromFixed(items)
  const back = Simd.toFixed(three)
  return 0
}
