// Function types, arrow functions, function values and calls through them
// (emit_closure.go). Stub from selfhost-emit-core; the owner is
// selfhost-emit-closures. The section stubs report only when the program has
// a function type or an arrow function.
import { Expr } from "narrac/ast"
import { Type } from "narrac/types"
import { Emitter, Code, EmitWalker, reportUnsupported, hasWork } from "narrac/emitstate"

const NODE = "selfhost-emit-closures"

// emitFuncTypeDefinitions writes envRuntime and the struct of each function
// type, only when function types exist.
export function emitFuncTypeDefinitions(mutable emitter: Emitter): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `${reportUnsupported(mutable emitter, "function types", NODE)}\n`
  }
  return ""
}

// emitClosureFunctions writes the "\n// Closures\n" section: environments,
// prototypes and definitions. It saves and restores the per-function state.
export function emitClosureFunctions(mutable emitter: Emitter): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `\n// Closures\n${reportUnsupported(mutable emitter, "closure functions", NODE)}\n`
  }
  return ""
}

export function emitFuncValue<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "function value", NODE), owned: false }
}

export function emitArrow<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "arrow function", NODE), owned: false }
}

export function emitValueCall<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "call through a function value", NODE), owned: false }
}

// callFunctionValue calls a function value held in the C expression callee.
export function callFunctionValue(mutable emitter: Emitter, functionType: Type, callee: string, arguments: Array<string>): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "call through a function value", NODE), owned: false }
}
