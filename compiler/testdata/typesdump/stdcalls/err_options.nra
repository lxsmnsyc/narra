import * as Options from "std/option"
import * as Results from "std/result"

enum Option2 { One, Two }

function bad(): int {
  const some: Option<int> = Some(3)
  const ok: Result<int, string> = Ok(1)
  const offset = 2
  Options.map(1, (value) => value)
  Options.map(some)
  Options.map(some, 5)
  Options.map(some, (value) => {
    return
  })
  Options.map(some, (value: string) => value)
  Options.map(some, (a, b) => a)
  Options.map(mutable some, (value) => value)
  Options.andThen(some, (value) => value)
  Options.andThen(some, (value) => Some("s"))
  Options.withDefault(some, "x")
  Options.withDefault(3, 3)
  Options.orElse(some, () => 4)
  Options.orElse(some, () => None)
  Options.isSome(3)
  Options.isNone(some, some)
  Options.okOr(3, 4)
  Results.map(some, (value) => value)
  Results.map(ok, (value) => value + offset)
  Results.mapErr(ok, (message) => message + 1)
  Results.andThen(ok, (value) => Err(5))
  Results.andThen(ok, (value) => Ok(value))
  Results.andThen(ok, (value) => Some(value))
  Results.withDefault(ok, "a")
  Results.ok(some)
  Results.err(ok, ok)
  return 0
}
