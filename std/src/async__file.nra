// std/async/file: whole-file reads and writes for async code (SPEC.md section 8, D109).
//
// kqueue and epoll do not wait on regular files, so each call reads or writes
// in one blocking step, as std/fs does, then lets the other ready tasks run
// once before it returns. A cancelled task's call gives
// Err(AsyncError.Cancelled) before it touches the file.

import * as Fs from "std/fs"
import * as Tasks from "std/internal/async"
import * as Handles from "std/internal/asyncio"
import { AsyncError } from "std/async"

// The text of the file at path.
export async function readText(path: string): Result<string, AsyncError> uses io, alloc {
  if (Handles.cancelled()) {
    return Err(AsyncError.Cancelled)
  }
  const result = Fs.readText(path)
  // A zero timer fires after the ready tasks: one turn for them. The work is
  // done, so a cancel now changes nothing.
  const _turn = await Tasks.sleep(0)
  return match (result) { Ok(text) => Ok(text), Err(message) => Err(AsyncError.Failed(message)) }
}

// The bytes of the file at path.
export async function readBytes(path: string): Result<bytes, AsyncError> uses io, alloc {
  if (Handles.cancelled()) {
    return Err(AsyncError.Cancelled)
  }
  const result = Fs.readBytes(path)
  // A zero timer fires after the ready tasks: one turn for them. The work is
  // done, so a cancel now changes nothing.
  const _turn = await Tasks.sleep(0)
  return match (result) { Ok(data) => Ok(data), Err(message) => Err(AsyncError.Failed(message)) }
}

// Writes text to the file at path, replacing it, and gives the bytes written.
export async function writeText(
  path: string,
  text: string,
): Result<int, AsyncError> uses io, alloc {
  if (Handles.cancelled()) {
    return Err(AsyncError.Cancelled)
  }
  const result = Fs.writeText(path, text)
  // A zero timer fires after the ready tasks: one turn for them. The work is
  // done, so a cancel now changes nothing.
  const _turn = await Tasks.sleep(0)
  return match (result) { Ok(count) => Ok(count), Err(message) => Err(AsyncError.Failed(message)) }
}

// Writes data to the file at path, replacing it, and gives the bytes written.
export async function writeBytes(
  path: string,
  data: bytes,
): Result<int, AsyncError> uses io, alloc {
  if (Handles.cancelled()) {
    return Err(AsyncError.Cancelled)
  }
  const result = Fs.writeBytes(path, data)
  // A zero timer fires after the ready tasks: one turn for them. The work is
  // done, so a cancel now changes nothing.
  const _turn = await Tasks.sleep(0)
  return match (result) { Ok(count) => Ok(count), Err(message) => Err(AsyncError.Failed(message)) }
}
