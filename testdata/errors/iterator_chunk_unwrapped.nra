// error: for ... of needs a Range, an Array, a Generator
import * as Iterators from "std/iterator"

function* numbers(): Generator<int> {
  yield 1
  yield 2
}

export function run(args: Array<string>): int uses io, alloc {
  for (const _group of Iterators.chunk(numbers(), 2)) {
    print("group")
  }
  return 0
}
