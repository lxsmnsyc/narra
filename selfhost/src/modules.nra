// Package loading, ported from compiler/internal/narra/modules.go: read
// narra.toml, walk src/, parse each module, order modules by imports and
// resolve binaries. dump prints the format defined at the top of
// compiler/internal/narra/pkgdump.go.
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Lexer from "narrac/lexer"
import { Pos, File, Decl } from "narrac/ast"
import { parse } from "narrac/parser"
import { Binary, LoadError, parseManifest } from "narrac/manifest"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// One module of a package: one file under src/.
export struct SourceModule {
  path: string // "app/text"
  file: string // the path shown in diagnostics: "src/text.nra"
  ast: File
  exports: Array<string> // exported names, sorted, without duplicates
  firstId: int // the node ids of this file are in [firstId, endId)
  endId: int
}

export struct Package {
  name: string
  dir: string
  modules: Array<SourceModule> // dependency order, imports first
  binaries: Array<Binary>
  libraries: Array<string>
  search: Array<string>
  nextId: int // the next free node id after all files (one sequence)
  single: bool // loaded from one .nra file, without narra.toml
}

// A load error that is not a diagnostic (an unreadable file).
function plain(message: string): Array<LoadError> {
  return [LoadError { file: "", line: 0, col: 0, message: message }]
}

// load reads a package directory, or a single .nra file as a package with
// one module and one binary whose entry is `run`. Errors are the diagnostics
// of the load, in report order.
export function load(path: string): Result<Package, Array<LoadError>> uses io, alloc {
  if (Fs.listDir(path) is Ok(_)) {
    return loadPackage(path)
  }
  if (!Fs.exists(path)) {
    return Err(plain(`stat ${path}: no such file or directory`))
  }
  return loadFile(path)
}

function baseName(path: string): string uses alloc {
  const parts = Str.split(path, "/")
  return parts[Arrays.length(parts) - 1]
}

function dirName(path: string): string uses alloc {
  const parts = Str.split(path, "/")
  if (Arrays.length(parts) == 1) {
    return "."
  }
  let keep: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(parts) - 1)) {
    Arrays.push(mutable keep, parts[index])
  }
  return Str.join(keep, "/")
}

function loadFile(path: string): Result<Package, Array<LoadError>> uses io, alloc {
  const read = Fs.readText(path)
  if (read is Err(message)) {
    return Err(plain(message))
  }
  const base = baseName(path)
  let stem = base
  if (Str.endsWith(base, ".nra")) {
    stem = Str.slice(base, 0, Str.length(base) - 4)
  }
  const parsed = parse(read.value, 0)
  if (parsed is Err(diagnostic)) {
    return Err([LoadError { file: base, line: diagnostic.pos.line, col: diagnostic.pos.col, message: diagnostic.message }])
  }
  const module = newModule(stem, base, parsed.value.file, 0, parsed.value.nextId)
  return Ok(Package {
    name: stem,
    dir: dirName(path),
    modules: [module],
    binaries: [Binary { name: stem, entry: `${stem}.run` }],
    libraries: [],
    search: [],
    nextId: parsed.value.nextId,
    single: true,
  })
}

// loadPackage reads narra.toml and every file under src/, and orders the
// modules so that each comes after the modules it imports. The files are
// numbered in one id sequence, in sorted path order (not load order).
function loadPackage(dir: string): Result<Package, Array<LoadError>> uses io, alloc {
  const text = Fs.readText(`${dir}/narra.toml`)
  if (text is Err(message)) {
    return Err(plain(message))
  }
  const manifest = parseManifest(text.value)
  if (manifest is Err(error)) {
    return Err([error])
  }
  const config = manifest.value
  let paths: Array<string> = []
  const listed = Fs.listDir(`${dir}/src`)
  if (listed is Err(message)) {
    return Err(plain(message))
  }
  collect(`${dir}/src`, "", mutable paths)
  if (Arrays.length(paths) == 0) {
    return Err(plain(`narra.toml: package ${config.name} has no .nra files in src/`))
  }
  sortStrings(mutable paths)
  let mods: Array<SourceModule> = []
  let errs: Array<LoadError> = []
  let nextId = 0
  for (const path of Arrays.values(paths)) {
    const relative = Str.slice(path, 0, Str.length(path) - 4)
    const display = `src/${path}`
    const read = Fs.readText(`${dir}/src/${path}`)
    if (read is Err(message)) {
      return Err(plain(message))
    }
    const parsed = parse(read.value, nextId)
    if (parsed is Err(diagnostic)) {
      Arrays.push(mutable errs, LoadError { file: display, line: diagnostic.pos.line, col: diagnostic.pos.col, message: diagnostic.message })
      continue
    }
    Arrays.push(mutable mods, newModule(`${config.name}/${relative}`, display, parsed.value.file, nextId, parsed.value.nextId))
    nextId = parsed.value.nextId
  }
  if (Arrays.length(errs) > 0) {
    return Err(errs)
  }
  const ordered = orderModules(mods)
  if (Arrays.length(ordered.errs) > 0) {
    return Err(ordered.errs)
  }
  return Ok(Package {
    name: config.name,
    dir: dir,
    modules: ordered.mods,
    binaries: config.binaries,
    libraries: config.libraries,
    search: config.search,
    nextId: nextId,
    single: false,
  })
}

// collect adds the paths of the .nra files under a folder of root, as paths relative to root.
// A name that cannot be listed is a file.
function collect(root: string, relative: string, mutable out: Array<string>) uses io, alloc {
  let here = root
  if (relative != "") {
    here = `${root}/${relative}`
  }
  const names = Fs.listDir(here)
  if (names is Ok(list)) {
    for (const name of Arrays.values(list)) {
      let child = name
      if (relative != "") {
        child = `${relative}/${name}`
      }
      collectEntry(root, child, mutable out)
    }
  }
}

function collectEntry(root: string, relative: string, mutable out: Array<string>) uses io, alloc {
  if (Fs.listDir(`${root}/${relative}`) is Ok(_)) {
    collect(root, relative, mutable out)
  } else if (Str.endsWith(relative, ".nra")) {
    Arrays.push(mutable out, relative)
  }
}

// sortStrings sorts by bytes (insertion sort; the lists are short).
function sortStrings(mutable items: Array<string>) uses alloc {
  let sorted: Array<string> = []
  for (const item of Arrays.values(items)) {
    Arrays.push(mutable sorted, item)
    let index = Arrays.length(sorted) - 1
    while (index > 0 && sorted[index] < sorted[index - 1]) {
      const swap = sorted[index]
      sorted[index] = sorted[index - 1]
      sorted[index - 1] = swap
      index = index - 1
    }
  }
  items = sorted
}

function newModule(path: string, file: string, ast: File, firstId: int, endId: int): SourceModule uses alloc {
  let names: Array<string> = []
  for (const decl of Arrays.values(ast.decls)) {
    const name = exportedName(decl)
    if (name != "") {
      Arrays.push(mutable names, name)
    }
  }
  sortStrings(mutable names)
  let unique: Array<string> = []
  for (const name of Arrays.values(names)) {
    if (Arrays.length(unique) == 0 || unique[Arrays.length(unique) - 1] != name) {
      Arrays.push(mutable unique, name)
    }
  }
  return SourceModule { path: path, file: file, ast: ast, exports: unique, firstId: firstId, endId: endId }
}

// exportedName gives the name of an exported function, const, struct, enum,
// trait or distinct type, and "" for anything else.
function exportedName(decl: Decl): string {
  match (decl) {
    Decl.Func(funcDecl) => {
      if (funcDecl.exported) {
        return funcDecl.name
      }
    }
    Decl.Const(constDecl) => {
      if (constDecl.exported) {
        return constDecl.name
      }
    }
    Decl.Struct(structDecl) => {
      if (structDecl.exported) {
        return structDecl.name
      }
    }
    Decl.Enum(enumDecl) => {
      if (enumDecl.exported) {
        return enumDecl.name
      }
    }
    Decl.Trait(traitDecl) => {
      if (traitDecl.exported) {
        return traitDecl.name
      }
    }
    Decl.Distinct(distinctDecl) => {
      if (distinctDecl.exported) {
        return distinctDecl.name
      }
    }
    _ => {}
  }
  return ""
}

struct Ordered {
  mods: Array<SourceModule>
  errs: Array<LoadError>
}

struct Walk {
  mods: Array<SourceModule>
  index: Map<string, int> // module path -> position in mods
  state: Array<int> // 0 new, 1 visiting, 2 done
  order: Array<SourceModule>
  stack: Array<string>
  errs: Array<LoadError>
}

// orderModules sorts modules so imports come first, and reports import
// cycles. Imports of modules outside the package are skipped; the checker
// reports unknown modules.
function orderModules(mods: Array<SourceModule>): Ordered uses alloc {
  let index: Map<string, int> = Map {}
  let state: Array<int> = []
  for (const i of Ranges.between(0, Arrays.length(mods))) {
    index[mods[i].path] = i
    Arrays.push(mutable state, 0)
  }
  let walk = Walk { mods: mods, index: index, state: state, order: [], stack: [], errs: [] }
  for (const i of Ranges.between(0, Arrays.length(mods))) {
    if (walk.state[i] == 0) {
      visit(mutable walk, i)
    }
  }
  return Ordered { mods: walk.order, errs: walk.errs }
}

function visit(mutable walk: Walk, index: int) uses alloc {
  const module = walk.mods[index]
  walk.state[index] = 1
  Arrays.push(mutable walk.stack, module.path)
  for (const importDecl of Arrays.values(module.ast.imports)) {
    const found = walk.index[importDecl.path]
    if (found is None) {
      continue
    }
    const dependency = found.value
    const visitState = walk.state[dependency]
    if (visitState == 1) {
      let start = 0
      for (const i of Ranges.between(0, Arrays.length(walk.stack))) {
        if (walk.stack[i] == importDecl.path) {
          start = i
        }
      }
      let cycle: Array<string> = []
      for (const i of Ranges.between(start, Arrays.length(walk.stack))) {
        Arrays.push(mutable cycle, walk.stack[i])
      }
      Arrays.push(mutable cycle, importDecl.path)
      Arrays.push(mutable walk.errs, LoadError {
        file: module.file,
        line: importDecl.pos.line,
        col: importDecl.pos.col,
        message: `import cycle: ${Str.join(cycle, " -> ")}`,
      })
    } else if (visitState == 0) {
      visit(mutable walk, dependency)
    }
  }
  walk.stack = popLast(walk.stack)
  walk.state[index] = 2
  Arrays.push(mutable walk.order, module)
}

function popLast(items: Array<string>): Array<string> uses alloc {
  let out: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(items) - 1)) {
    Arrays.push(mutable out, items[index])
  }
  return out
}

// binary finds a binary by name. An empty name selects the only binary.
export function binary(pkg: Package, name: string): Result<Binary, string> uses alloc {
  if (name != "") {
    for (const candidate of Arrays.values(pkg.binaries)) {
      if (candidate.name == name) {
        return Ok(candidate)
      }
    }
    return Err(`narra.toml: package ${pkg.name} has no binary ${quoteDump(name)}`)
  }
  const count = Arrays.length(pkg.binaries)
  if (count == 0) {
    return Err(`narra.toml: package ${pkg.name} has no [[binary]]; it is a library`)
  }
  if (count == 1) {
    return Ok(pkg.binaries[0])
  }
  let names: Array<string> = []
  for (const candidate of Arrays.values(pkg.binaries)) {
    Arrays.push(mutable names, candidate.name)
  }
  return Err(`narra.toml: package ${pkg.name} has several binaries (${Str.join(names, ", ")}); choose one with -bin`)
}

// entryModule resolves the module part of a binary's entry. It accepts the
// contract form "cli.run" and the spec form "app/cli.run". The module is
// returned as written when no module of the package matches.
export function entryModule(pkg: Package, entry: string): #[string, string] uses alloc {
  let last = -1
  for (const index of Ranges.between(0, Str.length(entry))) {
    if (Str.byteAt(entry, index) == 46) {
      last = index
    }
  }
  if (last < 0) {
    return #["", entry]
  }
  const modulePath = Str.slice(entry, 0, last)
  const functionName = Str.sliceFrom(entry, last + 1)
  for (const module of Arrays.values(pkg.modules)) {
    if (module.path == `${pkg.name}/${modulePath}`) {
      return #[module.path, functionName]
    }
  }
  return #[modulePath, functionName]
}

// quoteDump quotes like the AST dump: escapes as in the lex dump, plus `"`.
export function quoteDump(text: string): string uses alloc {
  const parts = Str.split(Lexer.escapeText(text), "\"")
  return `"${Str.join(parts, "\\\"")}"`
}

// errorText prints load errors as the Go dump does, one `error ...` line per
// diagnostic, each ending with a newline.
export function errorText(errs: Array<LoadError>): string uses alloc {
  let builder = Str.builder()
  for (const error of Arrays.values(errs)) {
    if (error.file == "" && error.line == 0) {
      Str.append(mutable builder, `error ${error.message}\n`)
    } else {
      Str.append(mutable builder, `error ${error.file}:${Int.toString(error.line)}:${Int.toString(error.col)}: ${error.message}\n`)
    }
  }
  return Str.build(builder)
}

function listLine(mutable builder: StringBuilder, name: string, items: Array<string>) uses alloc {
  if (Arrays.length(items) == 0) {
    return
  }
  Str.append(mutable builder, name)
  for (const item of Arrays.values(items)) {
    Str.append(mutable builder, ` ${quoteDump(item)}`)
  }
  Str.append(mutable builder, "\n")
}

// dump returns the package dump of pkgdump.go, ending with a newline.
export function dump(pkg: Package): string uses alloc {
  let builder = Str.builder()
  Str.append(mutable builder, `package ${quoteDump(pkg.name)}\n`)
  for (const binaryInfo of Arrays.values(pkg.binaries)) {
    const #[modulePath, functionName] = entryModule(pkg, binaryInfo.entry)
    Str.append(mutable builder, `binary ${quoteDump(binaryInfo.name)} entry=${quoteDump(binaryInfo.entry)} module=${quoteDump(modulePath)} fn=${quoteDump(functionName)}\n`)
  }
  listLine(mutable builder, "libraries", pkg.libraries)
  listLine(mutable builder, "search", pkg.search)
  for (const module of Arrays.values(pkg.modules)) {
    Str.append(mutable builder, `module ${quoteDump(module.path)} file=${quoteDump(module.file)}\n`)
    if (Arrays.length(module.exports) > 0) {
      Str.append(mutable builder, `  exports ${Str.join(module.exports, ",")}\n`)
    }
    for (const importDecl of Arrays.values(module.ast.imports)) {
      Str.append(mutable builder, `  import ${Int.toString(importDecl.pos.line)}:${Int.toString(importDecl.pos.col)} ${quoteDump(importDecl.path)}\n`)
    }
  }
  return Str.build(builder)
}

// checkIds verifies the id sequence of a package: the id ranges of the files
// are disjoint, together they cover [0, nextId) with no gap, and none passes
// nextId. It returns "ids ok <nextId>" or a description of the problem.
export function checkIds(pkg: Package): Result<string, string> uses alloc {
  let total = 0
  const count = Arrays.length(pkg.modules)
  for (const first of Ranges.between(0, count)) {
    const module = pkg.modules[first]
    if (module.firstId < 0 || module.endId < module.firstId || module.endId > pkg.nextId) {
      return Err(`ids bad: ${module.path} has ${Int.toString(module.firstId)}..${Int.toString(module.endId)} with nextId ${Int.toString(pkg.nextId)}`)
    }
    total = total + module.endId - module.firstId
    for (const second of Ranges.between(first + 1, count)) {
      const other = pkg.modules[second]
      if (module.firstId < other.endId && other.firstId < module.endId) {
        return Err(`ids bad: ${module.path} and ${other.path} overlap`)
      }
    }
  }
  if (total != pkg.nextId) {
    return Err(`ids bad: the files use ${Int.toString(total)} ids but nextId is ${Int.toString(pkg.nextId)}`)
  }
  return Ok(`ids ok ${Int.toString(pkg.nextId)}`)
}
