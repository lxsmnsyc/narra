// std/float: constants of f64 and reading text. The rest of the functions are built into the compiler.

import * as Str from "std/string"
import * as FloatText from "std/internal/float"

// The ratio of a circle's circumference to its diameter, to `f64` precision.
export const PI: f64 = 3.141592653589793

// Reads decimal text as an `f64`: an optional sign, digits with an optional point, and an optional exponent. `nan`, `inf`, spaces and a number too large for `f64` are errors.
export function parse(text: string): Result<f64, string> uses alloc {
  const length = Str.length(text)
  if (length == 0) {
    return Err("empty string")
  }
  let index = 0
  // An optional sign.
  if (Str.byteAt(text, index) == 43 || Str.byteAt(text, index) == 45) {
    index++
  }
  // Digits, then an optional point and more digits; at least one digit in all.
  const wholeStart = index
  index = skipDigits(text, index)
  let digitCount = index - wholeStart
  if (index < length && Str.byteAt(text, index) == 46) {
    index++
    const fractionStart = index
    index = skipDigits(text, index)
    digitCount += index - fractionStart
  }
  if (digitCount == 0) {
    return Err("no digits")
  }
  // An optional exponent with an optional sign and at least one digit.
  if (index < length && (Str.byteAt(text, index) == 101 || Str.byteAt(text, index) == 69)) {
    index++
    if (index < length && (Str.byteAt(text, index) == 43 || Str.byteAt(text, index) == 45)) {
      index++
    }
    const exponentStart = index
    index = skipDigits(text, index)
    if (index == exponentStart) {
      return Err("no digits in the exponent")
    }
  }
  if (index != length) {
    return Err("invalid character in the number")
  }
  // The text follows the grammar, so strtod reads all of it; a number too large reads as infinity.
  const value = FloatText.parse(text)
  if (value - value != 0.0) {
    return Err("number does not fit in 64 bits")
  }
  return Ok(value)
}

function skipDigits(text: string, start: int): int {
  const length = Str.length(text)
  let index = start
  while (index < length && Str.byteAt(text, index) >= 48 && Str.byteAt(text, index) <= 57) {
    index++
  }
  return index
}
