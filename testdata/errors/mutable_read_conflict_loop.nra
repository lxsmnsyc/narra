// error: mutable_read_conflict_loop.nra:16:19: "x" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = 10
  return 0
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  let i = 0
  while (i < 3) {
    if (i < 10) {
      i = i + 1 + x.n * bump(mutable x)
    }
  }
  return 0
}
