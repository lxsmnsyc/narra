import * as Int from "std/int"

function countUp(limit: int): int {
  let n = 0
  while (true) {
    n += 1
    if (n > limit) {
      break
    }
  }
  return n
}

function findOuter(limit: int): int {
  let n = 0
  outer: while (true) {
    while (true) {
      n += 1
      if (n > limit) {
        break outer
      }
    }
  }
  return n
}

export function run(args: Array<string>): int {
  print(Int.toString(countUp(3)))
  print(Int.toString(findOuter(5)))
  return 0
}
