// The registry rows and emitters of std/string.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Pos, Arg } from "narrac/ast"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  writeLine,
  where,
  temp,
  ownedTemp,
  typeOf,
  declareVariable,
  variableRef,
} from "narrac/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  arrayStruct,
  findVariant,
  ioEither,
} from "narrac/stdemithelp"
import * as Arrays from "std/array"
import * as Int from "std/int"

