import * as Hash from "std/hash"
import * as U64 from "std/u64"

struct Point derives Equatable, Hashable {
  x: int
  y: int
}

export function run(args: Array<string>): int uses io, alloc {
  print(`of repeats: ${Show.show(Hash.of("abc") == Hash.of("abc"))}`)
  print(`of differs: ${Show.show(Hash.of("abc") != Hash.of("abd"))}`)
  print(`of struct: ${Show.show(Hash.of(Point { x: 1, y: 2 }) == Hash.of(Point { x: 1, y: 2 }))}`)
  print(`of int: ${Show.show(Hash.of(5) == Hash.of(5))}`)
  print(`fnv1a empty: ${U64.toString(Hash.fnv1a(""))}`)
  print(`fnv1a a: ${U64.toString(Hash.fnv1a("a"))}`)
  print(`fnv1a foobar: ${U64.toString(Hash.fnv1a("foobar"))}`)
  return 0
}
