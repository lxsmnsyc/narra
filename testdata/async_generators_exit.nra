// A stream waiting at exit is a live task: it is cancelled, its sleep ends
// with Err(AsyncError.Cancelled), the body runs to its end, and its frame is
// freed. A parked stream that a detached task holds is freed with that task.
import * as Async from "std/async"
import * as Time from "std/time"
import { sleep } from "std/async/time"

async function* waiting(label: string): AsyncGenerator<string> uses (io, alloc) {
  yield `${label} first`
  const slept = await sleep(Time.seconds(60))
  if (slept is Err(_)) {
    print(`${label}: sleep cancelled at exit`)
    return
  }
  yield `${label} never`
}

async function holdParked(stream: AsyncGenerator<string> uses (io, alloc)): int uses io, alloc {
  await Async.idle()
  await Async.idle()
  const _ = await Async.next(stream)
  return 0
}

export async function run(_args: Array<string>): int {
  const stream = waiting("live")
  const first = await Async.next(stream)
  if (first is Some(value)) {
    print(value)
  }
  Async.detach(Async.next(stream))
  const parked = waiting("parked")
  Async.detach(holdParked(parked))
  print("run returns")
  return 0
}
