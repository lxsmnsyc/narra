// Build.debug is true in a debug build and false under -release; the release
// run reads build_debug.release.out.
import * as Build from "std/build"

function describeMode(): string {
  return if (Build.debug) {
    return "debug"
  } else {
    return "release"
  }
}

export function run(args: Array<string>): int {
  if (Build.debug) {
    print("debug build")
  } else {
    print("release build")
  }
  if (!Build.debug) {
    print("no debug checks")
  }
  print(describeMode())
  return 0
}
