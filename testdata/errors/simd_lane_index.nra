// error: index 4 is out of range for F32x4, whose indexes are 0 to 3
import * as Simd from "std/simd"

function read(values: F32x4, index: int): f32 {
  return values[index]
}

export function run(_args: Array<string>): int {
  const v: F32x4 = [1.0, 2.0, 3.0, 4.0]
  const outside = v[4]
  const replaced = Simd.withLane(v, 5, 1.0)
  print(Show.show([outside, read(v, 1)]))
  print(Show.show(replaced))
  return 0
}
