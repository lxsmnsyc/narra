// std/async/time: sleep on the loop of the thread (SPEC.md section 8, D109).
//
// sleep suspends the running task until the duration has passed; the other
// tasks of the loop run meanwhile. Time.sleep of std/time blocks the loop.

import * as Tasks from "std/internal/async"
import * as Time from "std/time"
import { Duration } from "std/time"
import { AsyncError } from "std/async"

// Waits for duration and gives the time slept, or Err(AsyncError.Cancelled)
// at once when the task is cancelled, before or while it waits.
export async function sleep(duration: Duration): Result<Duration, AsyncError> uses io, alloc {
  const slept = await Tasks.sleep(Time.asNanoseconds(duration))
  if (slept < 0) {
    return Err(AsyncError.Cancelled)
  }
  return Ok(Time.nanoseconds(slept))
}
