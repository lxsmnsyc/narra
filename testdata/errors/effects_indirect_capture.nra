// error: Function `pure` uses `io` but its signature does not declare it
function loud(value: int): int {
  print("x")
  return value
}

export function wrapAll<effect E>(escaping f: (value: int) => int uses E): Array<(
  value: int,
) => int uses E> uses alloc {
  return [f]
}

export function pure<effect E>(g: (value: int) => int uses E): int uses alloc, E {
  return wrapAll(loud)[0](g(1))
}

export function run(args: Array<string>): int {
  return 0
}
