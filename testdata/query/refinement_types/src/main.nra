export distinct type Port = int derives Show requires >= 1 && <= 65535
export distinct type Method = string requires "GET" | "POST"
export distinct type Level = u8
  requires 0 | 2 | 4 && != 4

export function parsePort(raw: int): Option<Port> {
  return Port.check(raw)
}

export function run(_args: Array<string>): int {
  const port = parsePort(80)
  const method = Method.check("GET")
  const level = Level.from(2)
  print(Show.show(port))
  return Level.toU8(level) == 2 && method is Some(_) ? 0 : 1
}
