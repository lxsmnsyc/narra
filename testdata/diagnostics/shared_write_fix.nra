// code: E0978
import * as Arrays from "std/array"

struct Emitter {
  names: Array<string>
  lines: Array<string>
}

function startFunction(mutable emitter: Emitter, name: string) uses alloc {
  Arrays.push(mutable emitter.lines, name)
}

export function run(_args: Array<string>): int uses alloc {
  let emitter = Emitter { names: ["main"], lines: [] }
  const info = emitter.names
  startFunction(mutable emitter, "f")
  return Arrays.length(info)
}
