// The module header is no doc: it is a plain comment.

/// The largest size a grid can have.
export const LIMIT = 8

/// A grid of numbers, one array per row.
export struct Grid {
  rows: Array<Array<int>>
}

/// Gives the first row of the grid.
///
/// Panics when the grid has no rows.
export function firstRow(grid: Grid): Array<int> from grid {
  return grid.rows[0]
}

/// Gives twice the value. The `@const` line between this doc and the function is skipped.
@const
export function double(value: int): int {
  return value * 2
}

// A plain comment right above a declaration is no doc.
export function half(value: int): int {
  return value / 2
}

/// A doc with a blank line after it documents nothing.

export function run(_args: Array<string>): int {
  const grid = Grid { rows: [[LIMIT]] }
  return half(double(firstRow(grid)[0]))
}
