import * as Str from "std/string"
import * as Int from "std/int"

export function run(args: Array<string>): int uses io, alloc {
  match (Str.find("key=value", "=")) {
    Some(index) => print(`find ${Int.toString(index)}`)
    None => print("find none")
  }
  match (Str.find("key=value", "&")) {
    Some(index) => print(`find ${Int.toString(index)}`)
    None => print("find none")
  }
  match (Str.find("abc", "")) {
    Some(index) => print(`find empty ${Int.toString(index)}`)
    None => print("find empty none")
  }
  return 0
}
