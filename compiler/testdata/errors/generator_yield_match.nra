// error: generator_yield_match.nra:5:7: yield cannot be used inside a block expression; it is valid only directly in a function* body
function* numbers(flag: bool): Generator<int> {
  const x = match (flag) {
    true => {
      yield 1
      return 1
    }
    false => 2
  }
  yield x
}

export function run(args: Array<string>): int {
  return 0
