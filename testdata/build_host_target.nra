// Build.hostTarget reads the C compiler's predefined macros. The program checks
// the answer against `uname -s -m`, so the output is the same on every host.
import * as Build from "std/build"
import * as Process from "std/process"
import * as Str from "std/string"
import { Os, Arch } from "std/build"

function describeSystem(os: Os): string {
  if (os == Os.MacOS) {
    return "Darwin"
  }
  return "Linux"
}

function describeMachine(os: Os, arch: Arch): string {
  if (arch == Arch.X86_64) {
    return "x86_64"
  }
  if (os == Os.MacOS) {
    return "arm64"
  }
  return "aarch64"
}

export function run(args: Array<string>): int uses io, alloc {
  const ran = Process.run("uname", ["-s", "-m"])
  if (ran is Err(message)) {
    print(`uname failed: ${message}`)
    return 1
  }
  const #[_, output, _errorOutput] = ran.value
  const expected = Str.trim(output)
  if (Build.hostTarget() is Some(target)) {
    const described = `${describeSystem(target.os)} ${describeMachine(target.os, target.arch)}`
    if (described == expected) {
      print("host target matches uname")
      return 0
    }
    print(`host target ${described} differs from ${expected}`)
    return 1
  }
  print(`no host target for ${expected}`)
  return 1
}
