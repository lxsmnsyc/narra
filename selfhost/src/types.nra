// The type model of the checker, ported from compiler/internal/narra/types.go
// and the declaration half of check_opaque.go.
//
// Go compares types by pointer. Here a `Type` is a value: primitives are
// variants, and a struct, enum, distinct type or type parameter is an index
// into a declaration table of the checker (`Checker.structs`, `enums`,
// `distincts`, `parameters` in check.nra). Every generic instance and tuple type
// gets its own table entry, found again through `Checker.instances`, so two
// types are the same exactly when they are `==`. Composite types (`TArray`,
// `TBox`, `TMap`, `TFunc`) hold their child types and compare structurally,
// as Go's sameType does. Printing a type needs the tables: `typeString` in
// check.nra. The C names (`CName`) are not ported here; they belong to
// selfhost-emit.
import * as Int from "std/int"
import * as Str from "std/string"
import {
  Expr,
  Pos,
  FieldDecl,
  VariantDecl,
  FuncDecl,
  TraitDecl,
  ImplDecl,
  TypeExpr,
} from "narrac/ast"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export enum Type derives Equatable {
  TInt
  // The sized integers. i64 is TInt.
  TI8
  TI16
  TI32
  TU8
  TU16
  TU32
  TU64
  TF64
  // f32. A float literal is f32 when the context expects it.
  TF32
  TBool
  TChar
  TStr
  // An immutable byte sequence; a string without the UTF-8 guarantee.
  TBytes
  TVoid
  // std/string's builder, visible only in modules that import std/string.
  TStringBuilder
  TStruct(index: int) // Checker.structs
  TEnum(index: int) // Checker.enums
  TDistinct(index: int) // Checker.distincts
  TParam(index: int) // Checker.parameters: a type parameter of one declaration
  TArray(element: Type)
  TBox(element: Type)
  // A raw pointer from std/ptr: a plain value with no reference count.
  TPtr(element: Type)
  TMap(key: Type, valueType: Type)
  // shared is the index of the parameter the result shares (`from`), or -1
  // for a fresh result.
  TFunc(parameters: Array<Type>, result: Type, effects: Array<string>, binder: int, shared: int)
  // The subject of a for loop over a range (body checker only).
  TRange
  // Generator<element> uses effects (Go's GeneratorType): effects are
  // sorted, binder is the Checker.functions index of the function whose
  // effect variables they name, or -1. origin is set (>= 0) for the result
  // type of a private function*, whose effects the effect pass infers into
  // Checker.generatorEffects; effects is then empty. An origin of -2 - k is
  // the result of a call whose callee's result type names the callee's
  // effect variables: the effect pass fills Checker.boundGenerators[k] with
  // the effects the arguments bind (Go's GeneratorType.Bound).
  // `input` is the input type of a Coroutine<input, element>, and TVoid for a Generator<element>.
  TGenerator(element: Type, effects: Array<string>, binder: int, origin: int, input: Type)
  // A namespace import such as `Int` used as a value (body checker only).
  TModule(path: string)
  // The value of a constant type parameter (`const N: int`) in an instance: the 3 of
  // `Vector<3>`. It is a type argument only, never the type of a value.
  TConst(value: int)
  // FixedArray<element, length>: `length` elements stored inline, with no heap
  // allocation. The length is a TConst, or a constant TParam in a generic body.
  TFixedArray(element: Type, length: Type)
  // Dynamic<Trait>: a value of any type that implements the trait at
  // Checker.traits[traitIndex], called through a table of functions.
  TDynamic(traitIndex: int)
}

// A struct field or variant field. `pos` is the field's declaration, or the
// zero position for tuple fields.
export struct Field {
  name: string
  fieldType: Type
  default: Option<Expr>
  pos: Pos
}

export struct Variant {
  name: string
  index: int
  fields: Array<Field>
}

// A struct: a declared one, a generic instance (arguments set, generic >= 0), or a
// tuple (tuple set, name "Tuple", module "", arguments the element types, fields
// "0", "1", ...). scope is the index of the declaring module's ModScope and
// pos the declaration (the zero position in the prelude), for reportTypeError.
export struct StructInfo {
  name: string
  module: string
  scope: int
  pos: Pos
  opaque: bool
  tuple: bool
  arguments: Array<Type>
  generic: int // Checker.generics, or -1
  fields: Array<Field>
}

export struct EnumInfo {
  name: string
  module: string
  scope: int
  pos: Pos
  arguments: Array<Type>
  generic: int
  variants: Array<Variant>
}

// `distinct type Name = Base`. base is None until resolveDistinct runs, which
// is how a definition in terms of itself is found.
export struct DistinctInfo {
  name: string
  module: string
  opaque: bool
  base: Option<Type>
}

// `type Name<T> = Body`. The body is resolved on each use with the type
// arguments, so an alias is the same type as its body. state is 0 before the
// first resolution, 1 while it runs, 2 when it is resolved and 3 when it
// failed. type is the resolved body of an alias without type parameters.
export struct AliasInfo {
  name: string
  module: string
  scope: int
  pos: Pos
  typeParameters: Array<string>
  body: TypeExpr
  state: int
  type: Type
}

// A type parameter. Each declaration gets fresh ones (makeParameters), so two
// parameters named T of different declarations differ.
export struct ParamInfo {
  name: string
  // Set for `const N: int`: the parameter stands for an integer, not a type.
  isConstant: bool = false
}

// A generic struct or enum declaration (Go's genericType). fields and
// variants are the template with the parameters left open; they are empty
// until buildGeneric runs, and emptied again when checkPolyRecursion fails.
export struct GenericInfo {
  name: string
  module: string
  scope: int
  pos: Pos
  parameters: Array<int> // Checker.parameters
  isStruct: bool
  opaque: bool
  fieldDeclarations: Array<FieldDecl>
  variantDeclarations: Array<VariantDecl>
  built: bool
  building: bool // fields are being resolved; see buildGeneric
  pending: Array<Type> // instances made while building, filled when it ends
  fields: Array<Field>
  variants: Array<Variant>
}

export function isInteger(type: Type): bool {
  return type == Type.TInt || isSizedInteger(type)
}

export function isSizedInteger(type: Type): bool {
  return match (type) {
    Type.TI8 | Type.TI16 | Type.TI32 | Type.TU8 | Type.TU16 | Type.TU32 | Type.TU64 => true
    _ => false
  }
}

export function isUnsignedInteger(type: Type): bool {
  return match (type) { Type.TU8 | Type.TU16 | Type.TU32 | Type.TU64 => true, _ => false }
}

export function findFixedLength(type: Type): int {
  // The length of a FixedArray whose length is known, or -1 while it is an open parameter.
  if (type is Type.TFixedArray(_, length)) {
    if (length is Type.TConst(value)) {
      return value
    }
  }
  return -1
}

export function typeKey(type: Type): string uses alloc {
  // Go keys by C name (typeID); this key has no hash and is unique because struct, enum, distinct and parameter types are indexes.
  return buildKey(type, false)
}

export function plainTypeKey(type: Type): string uses alloc {
  // Two types with the same plain key have one C name, so the emitter makes one of them.
  return buildKey(type, true)
}

function buildKey(type: Type, plain: bool): string uses alloc {
  // Each variant has a head no other variant uses (S, E, D, P, A, B, M, F, G, K, X,
  // the primitive names, Range, module), so the keys of two variants never meet.
  return match (type) {
    Type.TInt => "int"
    Type.TI8 => "i8"
    Type.TI16 => "i16"
    Type.TI32 => "i32"
    Type.TU8 => "u8"
    Type.TU16 => "u16"
    Type.TU32 => "u32"
    Type.TU64 => "u64"
    Type.TF64 => "f64"
    Type.TF32 => "f32"
    Type.TBool => "bool"
    Type.TChar => "char"
    Type.TStr => "string"
    Type.TBytes => "bytes"
    Type.TVoid => "void"
    Type.TStringBuilder => "StringBuilder"
    Type.TStruct(index) => `S${Int.toString(index)}`
    Type.TEnum(index) => `E${Int.toString(index)}`
    Type.TDistinct(index) => `D${Int.toString(index)}`
    Type.TParam(index) => `P${Int.toString(index)}`
    Type.TArray(element) => `A(${buildKey(element, plain)})`
    Type.TBox(element) => `B(${buildKey(element, plain)})`
    Type.TPtr(element) => `R(${buildKey(element, plain)})`
    Type.TMap(key, value) => `M(${buildKey(key, plain)},${buildKey(value, plain)})`
    Type.TFunc(parameters, result, effects, binder, shared) => buildFunctionKey(
      parameters,
      result,
      effects,
      binder,
      shared,
      plain,
    )
    Type.TRange => "Range"
    Type.TGenerator(
      element,
      effects,
      binder,
      origin,
      input,
    ) => `G(${buildKey(element, plain)};${Str.join(effects, ",")};${Int.toString(binder)};${Int.toString(origin)};${buildKey(input, plain)})`
    Type.TModule(path) => `module ${path}`
    Type.TConst(value) => `K${Int.toString(value)}`
    Type.TFixedArray(element, length) => `X(${buildKey(element, plain)},${buildKey(length, plain)})`
    Type.TDynamic(traitIndex) => `Q${Int.toString(traitIndex)}`
  }
}

function buildFunctionKey(
  parameters: Array<Type>,
  result: Type,
  effects: Array<string>,
  binder: int,
  shared: int,
  plain: bool,
): string uses alloc {
  let names = ""
  if (!plain) {
    names = `;${Str.join(effects, ",")};${Int.toString(binder)};${Int.toString(shared)}`
  }
  return `F(${joinKeys(parameters, plain)};${buildKey(result, plain)}${names})`
}

function joinKeys(types: Array<Type>, plain: bool): string uses alloc {
  let out = ""
  for (const index of Ranges.between(0, Arrays.length(types))) {
    if (index > 0) {
      out = `${out},`
    }
    out = `${out}${buildKey(types[index], plain)}`
  }
  return out
}

export function typeKeys(types: Array<Type>): string uses alloc {
  return joinKeys(types, false)
}

export function isBoxedEnum(info: EnumInfo): bool {
  // An enum with no fields stays an inline tag.
  for (const variant of Arrays.values(info.variants)) {
    if (Arrays.length(variant.fields) > 0) {
      return true
    }
  }
  return false
}

// A trait function: the signature with Self as the trait's parameter. The
// parameter types are in the side table Checker.paramTypes by Param.id.
export struct TraitFunc {
  name: string
  declaration: FuncDecl
  parameters: Array<Type>
  result: Type
}

// A declared trait (Go's Trait). selfParameter is the Checker.parameters index of Self.
// The standard traits (Equatable, Hashable, Ordered, Show) are declared in
// the prelude and have std set.
export struct TraitInfo {
  name: string
  module: string
  std: bool
  declaration: TraitDecl
  selfParameter: int
  functions: Array<TraitFunc>
}

// What a struct or enum declaration says about traits (Go's typeTraits),
// found through Checker.typeTraitIndex by "<module>|<name>". All maps are
// keyed by the Checker.traits index.
export struct TypeTraits {
  name: string
  module: string
  pos: Pos
  generic: bool
  implementationExpressions: Array<TypeExpr>
  derivedExpressions: Array<TypeExpr>
  listed: Map<int, bool> // Go's implements
  derived: Map<int, bool> // Go's derives
  blocks: Map<int, int> // Go's implementations: the Checker.implementations index
}

// One function of an implement block. result is the resolved result type;
// the parameter types are in the side table paramTypes.
export struct ImplFunc {
  name: string
  declaration: FuncDecl
  result: Type
}

// A checked `implement Trait for Type` block (Go's implType and the
// implFunctions it fills). Only blocks that passed their checks are recorded.
export struct ImplInfo {
  declaration: ImplDecl
  scope: int
  traitIndex: int
  forType: Type
  functions: Array<ImplFunc>
}

// Where the implementation of a trait function is: Checker.implementations[block].functions[index].
export struct ImplRef {
  block: int
  index: int
}

// The element type of a written Ptr<T>, waiting for flushPointerElements
// (unsafecode.nra), which runs once every struct has its fields.
export struct PointerCheck {
  pos: Pos
  element: Type
  file: string
}

// A Map key type waiting for flushMapKeys (Go's mapKeyCheck).
export struct MapKeyCheck {
  pos: Pos
  key: Type
  file: string
}
