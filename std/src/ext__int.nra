// std/int: ordering and division of int. The rest of the functions are built into the compiler.

export function compare(first: int, second: int): Ordering {
  if (first < second) {
    return Ordering.Less
  }
  if (first > second) {
    return Ordering.Greater
  }
  return Ordering.Equal
}

export function divmod(dividend: int, divisor: int): Option<#[int, int]> uses alloc {
  // A zero divisor has no quotient.
  if (divisor == 0) {
    return None
  }
  return Some(#[dividend / divisor, dividend % divisor])
}

export function floorDiv(dividend: int, divisor: int): Option<int> uses alloc {
  if (divisor == 0) {
    return None
  }
  const quotient = dividend / divisor
  const remainder = dividend % divisor
  // Division truncates toward zero; step down when the signs differ and the division is inexact.
  if (remainder != 0 && (remainder < 0) != (divisor < 0)) {
    return Some(quotient - 1)
  }
  return Some(quotient)
}
