trait module="" std Equatable
  function equals
    param a Self
    param b Self
    result bool
trait module="" std Hashable
  function hash
    param value Self
    result int
trait module="" std Ordered
  function compare
    param a Self
    param b Self
    result Ordering
trait module="" std Show
  function show
    param value Self
    result string
trait module="" Sendable
type enum module="" Ordering
  variant Less
  variant Equal
  variant Greater
impl module="" derived Show Ordering
impl module="" derived Ordered Ordering
