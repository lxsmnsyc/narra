// error: Simd.shiftLeft does not take F32x4, whose lanes are floats; it takes integer vectors
import * as Simd from "std/simd"

export function run(_args: Array<string>): int {
  const floats: F32x4 = [1.0, 2.0, 3.0, 4.0]
  const shifted = Simd.shiftLeft(floats, 1)
  const words: U32x4 = [1, 2, 3, 4]
  const absolute = Simd.abs(words)
  const wide: I64x2 = [-1, 0]
  const picked = Simd.select(wide, floats, floats)
  const tested = Simd.any(floats)
  let items: Array<f64> = [0.0, 0.0, 0.0, 0.0]
  const stored = Simd.store(mutable items, 0, floats)
  const unmarked = Simd.store(items, 0, Simd.splat<F64x2>(1.0))
  return 0
}
