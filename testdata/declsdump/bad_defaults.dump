trait module="" std Equatable
  function equals
    param a Self
    param b Self
    result bool
trait module="" std Hashable
  function hash
    param value Self
    result int
trait module="" std Ordered
  function compare
    param a Self
    param b Self
    result Ordering
trait module="" std Show
  function show
    param value Self
    result string
type enum module="" Ordering
  variant Less
  variant Equal
  variant Greater
impl module="" derived Show Ordering
impl module="" derived Ordered Ordering
generic enum module="" params=T Option
  variant Some
    field value T
  variant None
impl module="" derived Show Option
impl module="" derived Ordered Option
generic enum module="" params=T,E Result
  variant Ok
    field value T
  variant Err
    field error E
impl module="" derived Show Result
impl module="" derived Ordered Result
generic struct module="bad_defaults" params=T Box2
  field value default T
  field count default int
generic enum module="bad_defaults" params=T E
  variant V
    field x T
    field y int
module "bad_defaults"
  scope generic Box2 bad_defaults.Box2
  scope generic E bad_defaults.E
entry "bad_defaults" none
order module="" Ordering
impl module="" holds=true Equatable Ordering
impl module="" holds=true Hashable Ordering
impl module="" holds=true Ordered Ordering
impl module="" holds=true Show Ordering
