function render(name: string, depth: int = 0, indent: string = "  "): string {
  return name
}

function describe(
  first: Option<int> = None,
  second: Array<int> = [1, 2, 3],
  third: string = "a long default value",
  fourth: bool = false,
): string {
  return third
}

export function run(_args: Array<string>): int {
  render("a", indent: "b")
  describe()
  return 0
}
