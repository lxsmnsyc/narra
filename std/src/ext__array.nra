// std/array: helpers over Array. The functions that need the compiler are built in.

import * as Arrays from "std/array"

/// Returns a new array with `change(item)` for each item, in order.
export function map<T, U, effect E>(
  items: Array<T>,
  change: (value: T) => U uses E,
): Array<U> uses alloc, E {
  let result: Array<U> = Arrays.withCapacity(Arrays.length(items))
  for (const item of items) {
    Arrays.push(mutable result, change(item))
  }
  return result
}

/// Returns a copy of the items from start up to but not including finish, or `None` when start is
/// below 0, finish is past the end, or start is after finish.
export function slice<T>(items: Array<T>, start: int, finish: int): Option<Array<T>> uses alloc {
  // A range outside the array has no slice.
  if (start < 0 || finish > Arrays.length(items) || start > finish) {
    return None
  }
  let result: Array<T> = Arrays.withCapacity(finish - start)
  for (let index = start; index < finish; index++) {
    Arrays.push(mutable result, copy(items[index]))
  }
  return Some(result)
}

/// Removes the last item and returns it, or returns `None` when the array is empty.
export function pop<T>(mutable items: Array<T>): Option<T> uses alloc {
  const count = Arrays.length(items)
  if (count == 0) {
    return None
  }
  // The last item is copied out before the array shrinks, so a shared array is copied once.
  const last = copy(items[count - 1])
  Arrays.truncate(mutable items, count - 1)
  return Some(last)
}

/// Returns the index of the first item equal to wanted, or `None` when no item is.
export function indexOf<T: Equatable>(items: Array<T>, wanted: T): Option<int> {
  for (let index = 0; index < Arrays.length(items); index++) {
    if (items[index] == wanted) {
      return Some(index)
    }
  }
  return None
}

/// Tells whether an item equals wanted.
export function contains<T: Equatable>(items: Array<T>, wanted: T): bool {
  return indexOf(items, wanted) is Some(_)
}

/// Reverses the order of the items in place.
export function reverse<T>(mutable items: Array<T>) uses alloc {
  let low = 0
  let high = Arrays.length(items) - 1
  while (low < high) {
    const held = copy(items[low])
    items[low] = copy(items[high])
    items[high] = held
    low++
    high--
  }
}

/// Sorts the items in place from smallest to largest, and keeps equal items in their order.
export function sort<T: Ordered>(mutable items: Array<T>) uses alloc {
  sortBy(mutable items, (first: T, second: T) => Ordered.compare(first, second))
}

/// Sorts the items in place by compare, and keeps items that compare as `Ordering.Equal` in their
/// order.
export function sortBy<T, effect E>(
  mutable items: Array<T>,
  compare: (first: T, second: T) => Ordering uses E,
) uses alloc, E {
  const count = Arrays.length(items)
  if (count < 2) {
    return
  }
  // Bottom-up merge sort: runs of `width` items are merged pairwise. A merge takes
  // from the left run on a tie, which keeps equal items in their order.
  let buffer: Array<T> = Arrays.withCapacity(count)
  for (const item of items) {
    Arrays.push(mutable buffer, copy(item))
  }
  let width = 1
  while (width < count) {
    for (let start = 0; start < count; start += width * 2) {
      const middle = pickSmaller(start + width, count)
      const finish = pickSmaller(start + width * 2, count)
      let left = start
      let right = middle
      for (let target = start; target < finish; target++) {
        if (
          right >= finish ||
            (left < middle && compare(items[left], items[right]) != Ordering.Greater)
        ) {
          buffer[target] = copy(items[left])
          left++
        } else {
          buffer[target] = copy(items[right])
          right++
        }
      }
    }
    for (let index = 0; index < count; index++) {
      items[index] = copy(buffer[index])
    }
    width *= 2
  }
}

function pickSmaller(first: int, second: int): int {
  if (first < second) {
    return first
  }
  return second
}
