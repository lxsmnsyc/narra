// error: mutable_read_conflict_twice.nra:17:44: "x" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function grow(mutable counter: Counter): int {
  counter.n = counter.n + 1
  return 1
}

function sum(a: int, b: int): int {
  return a + b
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  return sum(grow(mutable x), grow(mutable x))
}
