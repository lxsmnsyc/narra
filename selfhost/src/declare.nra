// The declaration passes, ported from check.go (declareModule, the prelude),
// modules_check.go (newPackageChecker, declareSourceModule), check_types.go
// (declareType, declareGeneric), check_opaque.go (declareDistinct,
// resolveDistinct) and check_const.go (declareConsts).
//
// Each module of a package is declared in load order with its own
// declarations, its imports (scopes.nra) and the prelude. Extension points
// are comments marked HOOK: selfhost-check-traits added trait declarations,
// bounds and implementations (traits.nra); selfhost-check-imports added
// package and std imports, imported names, the imported-constant check and
// the entry functions (scopes.nra); selfhost-check-bodies adds default
// values, bodies and pending generic function instances.
//
// Node ids: the package's files use ids [0, Package.nextId). The prelude is
// parsed after them, from Package.nextId, so its ids (trait parameters)
// never clash with the package's, and the side tables are sized by the
// prelude's nextId.
import { Pos, File, Decl, FuncDecl, ConstDecl, DistinctDecl, FieldDecl, VariantDecl } from "narrac/ast"
import { parse, quoteGo } from "narrac/parser"
import { Package, SourceModule } from "narrac/modules"
import { Type, StructInfo, EnumInfo, DistinctInfo, GenericInfo } from "narrac/types"
import { Checker, ProgramFunc, FuncInfo, ConstInfo, CheckError, newChecker, newScope, enter, reportError, reportErrorIn, setParameterType, lookupType, lookupGeneric, lookupTrait, finish } from "narrac/check"
import { stdRegistry } from "narrac/stdlib"
import { collectExports, checkTypeName, declareType, importModules, typeNamed, checkImportedConsts, checkEntries, checkImportNames } from "narrac/scopes"
import { makeParameters, makeEnv } from "narrac/generics"
import { declareTraits, resolveTraits, funcBounds, flushMapKeys } from "narrac/traits"
import { resolveType, resolveOpt, resolveFields, resolveVariants, buildGeneric } from "narrac/resolve"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// The prelude, the same text as preludeSrc in check.go. It is checked once
// per program as module "" with file name "prelude".
const PRELUDE = `
trait Equatable {
  function equals(a: Self, b: Self): bool
}

trait Hashable {
  function hash(value: Self): int
}

trait Ordered {
  function compare(a: Self, b: Self): Ordering
}

trait Show {
  function show(value: Self): string
}

enum Ordering derives Show, Ordered {
  Less
  Equal
  Greater
}

enum Option<T> derives Show, Ordered {
  Some(value: T)
  None
}

enum Result<T, E> derives Show, Ordered {
  Ok(value: T)
  Err(error: E)
}
`

// newPackageChecker makes the checker for pkg and runs the declaration
// passes of the prelude. Its non-generic types start Checker.concrete.
export function newPackageChecker(package: Package): Checker uses alloc {
  const parsed = parse(PRELUDE, package.nextId)
  if (parsed is Err(diagnostic)) {
    let checker = newChecker(package.nextId)
    reportErrorIn(mutable checker, "prelude", diagnostic.pos, diagnostic.message)
    return checker
  }
  let checker = newChecker(parsed.value.nextId)
  checker.registry = stdRegistry()
  checker.packageName = package.name
  checker.single = package.single
  const scope = newScope(mutable checker, "", "prelude", false, [], parsed.value.file.declarations)
  enter(mutable checker, scope)
  declareModule(mutable checker, parsed.value.file)
  return checker
}

// declareSourceModule makes a module the current module, in a new scope, and runs
// its declaration passes. The full checker checks the module's bodies right after.
export function declareSourceModule(mutable checker: Checker, module: SourceModule) uses alloc {
  const scope = newScope(mutable checker, module.path, module.file, true, module.ast.imports, module.ast.declarations)
  checker.scopes[scope].exports = collectExports(module.ast.declarations)
  enter(mutable checker, scope)
  declareModule(mutable checker, module.ast)
}

// declareModule runs the declaration passes of the current module: imports,
// type names, fields, function signatures, constants and generic templates.
// Its non-generic structs and enums are appended to Checker.concrete.
export function declareModule(mutable checker: Checker, file: File) uses alloc {
  importModules(mutable checker, file)
  // Declare type names first, so declarations can refer to each other.
  // made holds the type created for each declaration, by position.
  let made: Array<Type> = []
  let own: Array<int> = []
  for (const declaration of Arrays.values(file.declarations)) {
    let type = Type.TVoid
    match (declaration) {
      Decl.Struct(structDecl) => {
        if (Arrays.length(structDecl.typeParameters) > 0) {
          Arrays.push(mutable own, declareGeneric(mutable checker, structDecl.pos, structDecl.name, structDecl.typeParameters, true, structDecl.opaque, structDecl.fields, []))
        } else {
          type = Type.TStruct(Arrays.length(checker.structs))
          const info = StructInfo { name: structDecl.name, module: modPath(checker), scope: checker.current, pos: declPos(checker, structDecl.pos), opaque: structDecl.opaque, tuple: false, arguments: [], generic: -1, fields: [] }
          Arrays.push(mutable checker.structs, info)
          declareType(mutable checker, structDecl.pos, structDecl.name, type)
          Arrays.push(mutable checker.concrete, type)
        }
      }
      Decl.Distinct(distinctDecl) => {
        type = Type.TDistinct(Arrays.length(checker.distincts))
        const info = DistinctInfo { name: distinctDecl.name, module: modPath(checker), opaque: distinctDecl.opaque, base: None }
        Arrays.push(mutable checker.distincts, info)
        declareType(mutable checker, distinctDecl.pos, distinctDecl.name, type)
      }
      Decl.Enum(enumDecl) => {
        checkConstructorNames(mutable checker, enumDecl.name, enumDecl.variants)
        if (Arrays.length(enumDecl.typeParameters) > 0) {
          Arrays.push(mutable own, declareGeneric(mutable checker, enumDecl.pos, enumDecl.name, enumDecl.typeParameters, false, false, [], enumDecl.variants))
        } else {
          type = Type.TEnum(Arrays.length(checker.enums))
          const info = EnumInfo { name: enumDecl.name, module: modPath(checker), scope: checker.current, pos: declPos(checker, enumDecl.pos), arguments: [], generic: -1, variants: [] }
          Arrays.push(mutable checker.enums, info)
          declareType(mutable checker, enumDecl.pos, enumDecl.name, type)
          Arrays.push(mutable checker.concrete, type)
        }
      }
      _ => {}
    }
    Arrays.push(mutable made, type)
  }
  declareTraits(mutable checker, file)
  checkImportNames(mutable checker, file)
  for (const index of Ranges.between(0, Arrays.length(file.declarations))) {
    const type = made[index]
    match (file.declarations[index]) {
      Decl.Struct(structDecl) => {
        if (type is Type.TStruct(structIndex)) {
          const fields = resolveFields(mutable checker, structDecl.fields)
          checker.structs[structIndex].fields = fields
        }
      }
      Decl.Enum(enumDecl) => {
        if (type is Type.TEnum(enumIndex)) {
          const variants = resolveVariants(mutable checker, enumDecl.variants)
          checker.enums[enumIndex].variants = variants
        }
      }
      Decl.Distinct(distinctDecl) => resolveDistinct(mutable checker, distinctDecl, type)
      Decl.Func(funcDecl) => declareFunc(mutable checker, funcDecl)
      _ => {}
    }
  }
  declareConsts(mutable checker, file)
  for (const generic of Arrays.values(own)) {
    buildGeneric(mutable checker, generic)
  }
  resolveTraits(mutable checker, file)
  // Field defaults are checked after this, by checkDefaults in body.nra.
}

// checkConstructorNames reports a constructor declared twice in one enum.
function checkConstructorNames(mutable checker: Checker, enumName: string, variants: Array<VariantDecl>) uses alloc {
  let seen: Map<string, bool> = Map {}
  for (const variant of Arrays.values(variants)) {
    if (seen[variant.name] is Some(_)) {
      reportError(mutable checker, variant.pos, `enum ${enumName} declares the constructor ${quoteGo(variant.name)} twice`)
    }
    seen[variant.name] = true
  }
}

function modPath(checker: Checker): string {
  return checker.scopes[checker.current].path
}

// declPos is where reportTypeError reports a type: its declaration, or the zero
// position in the prelude, which has no source file.
function declPos(checker: Checker, pos: Pos): Pos {
  if (modPath(checker) == "") {
    return Pos { line: 0, column: 0 }
  }
  return pos
}

// declareGeneric adds a generic struct or enum template and returns its index.
function declareGeneric(mutable checker: Checker, pos: Pos, name: string, typeParameters: Array<string>, isStruct: bool, opaque: bool, fields: Array<FieldDecl>, variants: Array<VariantDecl>): int uses alloc {
  const parameters = makeParameters(mutable checker, typeParameters)
  checkTypeName(mutable checker, pos, name)
  const generic = Arrays.length(checker.generics)
  const info = GenericInfo { name: name, module: modPath(checker), scope: checker.current, pos: pos, parameters: parameters, isStruct: isStruct, opaque: opaque, fieldDeclarations: fields, variantDeclarations: variants, built: false, building: false, pending: [], fields: [], variants: [] }
  Arrays.push(mutable checker.generics, info)
  const scope = checker.current
  checker.scopes[scope].generics[name] = generic
  return generic
}

// resolveDistinct resolves the base type of a distinct declaration. A base
// that is a distinct type not resolved yet (itself, or one declared later)
// is an error.
function resolveDistinct(mutable checker: Checker, distinctDecl: DistinctDecl, type: Type) uses alloc {
  let base = resolveType(mutable checker, distinctDecl.base)
  if (base is Type.TDistinct(baseIndex)) {
    if (checker.distincts[baseIndex].base is None) {
      reportError(mutable checker, distinctDecl.pos, `distinct type ${distinctDecl.name} cannot be defined in terms of itself`)
      base = Type.TInt
    }
  }
  if (type is Type.TDistinct(index)) {
    checker.distincts[index].base = Some(base)
  }
}

// declareFunc records a function's signature: its type parameters, the
// parameter types (side table paramTypes by Param.id) and the result.
function declareFunc(mutable checker: Checker, funcDecl: FuncDecl) uses alloc {
  const scope = checker.current
  if (checker.scopes[scope].functions[funcDecl.name] is Some(_)) {
    reportError(mutable checker, funcDecl.pos, `function ${quoteGo(funcDecl.name)} is declared twice`)
  }
  checker.environment = Map {}
  let typeParameters: Array<int> = []
  if (Arrays.length(funcDecl.typeParameters) > 0) {
    typeParameters = makeParameters(mutable checker, funcDecl.typeParameters)
    funcBounds(mutable checker, funcDecl, typeParameters)
    checker.environment = makeEnv(checker, typeParameters)
  }
  for (const param of Arrays.values(funcDecl.parameters)) {
    const type = resolveOpt(mutable checker, param.type)
    setParameterType(mutable checker, param.id, type)
  }
  const result = resolveOpt(mutable checker, funcDecl.result)
  checker.environment = Map {}
  const index = Arrays.length(checker.functions)
  const info = FuncInfo { name: funcDecl.name, module: modPath(checker), scope: scope, declaration: funcDecl, typeParameters: typeParameters, result: result }
  Arrays.push(mutable checker.functions, info)
  checker.scopes[scope].functions[funcDecl.name] = index
  // A non-generic function is part of the program (Go's Program.Funcs).
  if (Arrays.length(typeParameters) == 0) {
    Arrays.push(mutable checker.programFunctions, ProgramFunc.PlainFunc(index))
  }
}

// declareConsts registers the constants of a file in the current module. A
// constant may not share a name with a function, a type or another constant.
function declareConsts(mutable checker: Checker, file: File) uses alloc {
  checkImportedConsts(mutable checker, file)
  const scope = checker.current
  for (const declaration of Arrays.values(file.declarations)) {
    if (declaration is Decl.Const(constDecl)) {
      const isFunction = checker.scopes[scope].functions[constDecl.name] is Some(_)
      const isConst = checker.scopes[scope].consts[constDecl.name] is Some(_)
      if (isConst || isFunction || typeNamed(checker, constDecl.name)) {
        reportError(mutable checker, constDecl.pos, `constant ${quoteGo(constDecl.name)} is declared twice`)
        continue
      }
      const index = Arrays.length(checker.consts)
      const info = ConstInfo { name: constDecl.name, module: modPath(checker), scope: scope, declaration: constDecl, declaredType: None }
      Arrays.push(mutable checker.consts, info)
      checker.scopes[scope].consts[constDecl.name] = index
    }
  }
}

// declareConstTypes resolves the declared type of every annotated constant,
// module by module in declaration order, after all modules are declared.
// Go resolves it when the body checker first meets the constant
// (constType); the dumps resolve it here, and the body checker reads
// ConstInfo.declaredType.
export function declareConstTypes(mutable checker: Checker) uses alloc {
  for (const scope of Ranges.between(1, Arrays.length(checker.scopes))) {
    enter(mutable checker, scope)
    for (const declaration of Arrays.values(checker.scopes[scope].declarations)) {
      if (declaration is Decl.Const(constDecl)) {
        if (constDecl.type is Some(typeExpr)) {
          const type = resolveType(mutable checker, typeExpr)
          if (checker.scopes[scope].consts[constDecl.name] is Some(index)) {
            if (checker.consts[index].declaration.pos == constDecl.pos) {
              checker.consts[index].declaredType = Some(type)
            }
          }
        }
      }
    }
  }
}

// declarePackage runs the declaration passes on every module of pkg in load
// order, resolves the constant types, checks the Map keys and the entry
// functions and orders the types (finish), as DeclDump does. Bodies are not
// checked.
export function declarePackage(package: Package): Checker uses alloc {
  let checker = newPackageChecker(package)
  if (Arrays.length(checker.errors) > 0 && Arrays.length(checker.scopes) == 0) {
    return checker
  }
  for (const module of Arrays.values(package.modules)) {
    declareSourceModule(mutable checker, module)
  }
  declareConstTypes(mutable checker)
  flushMapKeys(mutable checker)
  checkEntries(mutable checker, package)
  const concrete = checker.concrete
  finish(mutable checker, concrete)
  return checker
}
