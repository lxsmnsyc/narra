import * as Int from "std/int"

enum Note {
  Text(body: string)
  Memo(body: string)
  Empty
}

function bodyOf(note: Note): string {
  return match (note) { Note.Text(body) | Note.Memo(body) => body, Note.Empty => "none" }
}

function lengthOf(note: Note): int {
  const body = match (note) { Note.Text(text) | Note.Memo(text) => text, Note.Empty => "" }
  return match (body) { "" => 0, _ => 1 }
}

function nested(value: Option<Note>): string {
  return match (value) {
    Some(Note.Text(body) | Note.Memo(body)) => body
    Some(Note.Empty) | None => "nothing"
  }
}

export function run(args: Array<string>): int {
  print(bodyOf(Note.Text("one")))
  print(bodyOf(Note.Memo("two")))
  print(bodyOf(Note.Empty))
  print(Int.toString(lengthOf(Note.Memo("x"))))
  print(Int.toString(lengthOf(Note.Empty)))
  print(nested(Some(Note.Memo("deep"))))
  print(nested(None))
  return 0
}
