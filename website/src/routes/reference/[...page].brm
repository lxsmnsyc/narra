<script>
  import { getEvent } from 'brumate/server';
  import { $props } from 'brumate/signals';
  import DocPage from '../../components/DocPage.brm';
  import { findReference } from '../../pages.ts';

  const { params } = $props<{ params: { page: string } }>();
  const entry = findReference(params.page);
  if (!entry) {
    getEvent().setStatus(404);
  }
</script>

#if (entry) {
  <DocPage page=entry.page path=(`reference/${entry.slug}`) />
} #else {
  <main class="not-found">
    <h1>Not found</h1>
    <p>There is no reference page at this address. <a href="/reference">Back to the reference</a>.</p>
  </main>
}
