// error: divisor_field.nra:8:25: the divisor must be a non-zero constant or a name checked against zero first; copy it into a local first, then check the local
struct Size {
  count: int
}

function share(total: int, size: Size): int {
  if (size.count != 0) {
    return total / size.count
  }
  return 0
}

export function run(args: Array<string>): int {
  return share(10, Size { count: 2 })
}
