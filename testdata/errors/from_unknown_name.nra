// error: from names "values", which is not a parameter of readItems
function readItems(items: Array<int>): Array<int> from values {
  return copy(items)
}

struct Holder {
  pick: (Array<int>) => Array<int> from items
}

export function run(_args: Array<string>): int {
  const holder = Holder { pick: readItems }
  const read = (items: Array<int>): Array<int> from list => copy(items)
  return holder.pick([1])[0] + read([2])[0]
}
