  StdFunc {
    name: "Str.trim",
    module: "std/string",
    key: "trim",
    parameters: ["string"],
    parameterNames: ["text"],
    result: "string",
    effects: ["alloc"],
    doc: "Removes ASCII white space (space, tab, line feed, vertical tab, form feed, carriage return) from both ends of the text.",
  },
]

