// Every way a function with a result may end: the closing brace is never reached.
import * as Int from "std/int"

enum Shape {
  Dot
  Line(length: int)
}

function afterIfElse(x: int): int {
  if (x > 0) {
    return 1
  } else if (x < 0) {
    return -1
  } else {
    return 0
  }
}

function afterMatch(shape: Shape): int {
  match (shape) {
    Shape.Dot => {
      return 0
    }
    Shape.Line(length) => {
      return length
    }
  }
}

function afterMatchPanic(shape: Shape): int {
  match (shape) {
    Shape.Dot => panic("a dot has no length")
    Shape.Line(length) => {
      return length
    }
  }
}

function afterLoop(limit: int): int {
  let count = 0
  while (true) {
    count = count + 1
    if (count > limit) {
      return count
    }
  }
}

function afterForever(limit: int): int {
  for (let count = 0; ; count = count + 1) {
    if (count > limit) {
      return count
    }
  }
}

function afterInnerBreak(limit: int): int {
  let total = 0
  while (true) {
    for (let i = 0; i < limit; i = i + 1) {
      if (i == 2) {
        break
      }
      total = total + 1
    }
    return total
  }
}

function afterLabeledBreak(limit: int): int {
  outer: while (true) {
    while (true) {
      if (limit > 0) {
        break outer
      }
      return 7
    }
  }
  return 9
}

function afterPanic(x: int): int {
  if (x > 0) {
    return x
  }
  panic("x must be positive")
}

export function run(args: Array<string>): int {
  const arrow = (x: int): int => {
    if (x > 0) {
      return 1
    } else {
      return 2
    }
  }
  print(Int.toString(afterIfElse(5)))
  print(Int.toString(afterMatch(Shape.Line(4))))
  print(Int.toString(afterMatchPanic(Shape.Line(5))))
  print(Int.toString(afterLoop(3)))
  print(Int.toString(afterForever(2)))
  print(Int.toString(afterInnerBreak(5)))
  print(Int.toString(afterLabeledBreak(1)))
  print(Int.toString(afterPanic(6)))
  print(Int.toString(arrow(0)))
  return 0
}
