import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"

struct Ranked<T: Show & Ordered> {
  items: Array<T>
}

struct Grid<T: Show, const N: int> {
  cells: Array<T>
}

function best<T: Show & Ordered>(ranked: Ranked<T>): string {
  let found = ranked.items[0]
  for (const item of Arrays.values(ranked.items)) {
    if (Ordered.compare(item, found) == Ordering.Greater) {
      found = item
    }
  }
  return Show.show(found)
}

function showRow<T: Show, const N: int>(grid: Grid<T, N>): string {
  let text = ""
  for (const i of Ranges.between(0, N)) {
    text = `${text}${Show.show(grid.cells[i])} `
  }
  return text
}

export function run(_args: Array<string>): int {
  print(best(Ranked { items: [3, 9, 4] }))
  print(best(Ranked { items: ["b", "c", "a"] }))
  const grid: Grid<int, 3> = Grid { cells: [1, 2, 3, 4] }
  print(showRow(grid))
  print(Int.toString(Arrays.length(grid.cells)))
  return 0
}
