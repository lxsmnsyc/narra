// error: the elements of numbers are int, which have no contents to change in place; write `numbers[index] = ...` in a `for (const #[index, number] of Arrays.entries(numbers))` loop
export function run(args: Array<string>): int {
  const numbers = [1, 2, 3]
  for (mutable number of numbers) {
    print("x")
  }
  return numbers[0]
}
