// Build.os and Build.arch are constants: each if keeps one branch, and the C
// holds only the host's (the emit suite checks it). The output is per host:
// build_os.darwin.out and build_os.linux.out.
import * as Arrays from "std/array"
import * as Build from "std/build"
import { Os, Arch } from "std/build"

function describeSystem(): string {
  if (Build.os == Os.MacOS) {
    return "kept the macOS branch"
  } else if (Build.os == Os.Linux) {
    return "kept the Linux branch"
  } else {
    return "kept the Windows branch"
  }
}

function isSixtyFourBit(): bool {
  if (Build.arch is Arch.Arm64 || Build.arch == Arch.X86_64) {
    return true
  }
  return false
}

export function run(args: Array<string>): int {
  print(describeSystem())
  if (!(Build.os == Os.Windows)) {
    print("not Windows")
  }
  if (isSixtyFourBit()) {
    print("64-bit")
  }
  // A condition that mixes a build constant with a runtime value is an ordinary if.
  if (Build.os != Os.Windows && Arrays.length(args) > 0) {
    print("has a program name")
  }
  return 0
}
