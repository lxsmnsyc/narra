import { largest } from "task/stats"
import * as Test from "std/test"

test "the largest of several" {
  Test.eq(largest([3, 9, 2]), Some(9))
}

test "one number" {
  Test.eq(largest([-4]), Some(-4))
}

test "negative numbers" {
  Test.eq(largest([-8, -2, -5]), Some(-2))
}

test "empty array" {
  Test.eq(largest([]), None)
}
