import * as Float from "std/float"
import * as F32 from "std/f32"
import * as Json from "std/json"
import { Value } from "std/shape"

function show(value: f64) uses io, alloc {
  const text = Float.toString(value)
  let back = "read back"
  if (value == value && value - value == 0.0) {
    const parsed = Json.parse(text)
    back = "MISMATCH"
    if (parsed is Ok(Value.Float(number))) {
      if (number == value) {
        back = "read back"
      }
    }
  }
  print(`${text} ${back}`)
}

function showF32(value: f32) uses io, alloc {
  print(F32.toString(value))
}

export function run(args: Array<string>): int uses io, alloc {
  const zero = 0.0
  show(20.0)
  show(100.0)
  show(0.1)
  show(1.0 / 3.0)
  show(1e21)
  show(1e20)
  show(1e-7)
  show(1.5e-7)
  show(0.000001)
  show(123456.0)
  show(-0.0)
  show(0.0 / zero)
  show(1.0 / zero)
  show(-1.0 / zero)
  show(1.7976931348623157e308)
  show(5e-324)
  showF32(20.0)
  showF32(100.0)
  showF32(0.1)
  showF32(1e10)
  showF32(3.4028235e38)
  showF32(1.5e-7)
  return 0
}
