import * as Char from "std/char"

function flags(character: char): string uses alloc {
  let result = ""
  if (Char.isDigit(character)) {
    result = `${result}D`
  }
  if (Char.isLetter(character)) {
    result = `${result}L`
  }
  if (Char.isAlphanumeric(character)) {
    result = `${result}A`
  }
  if (Char.isUpper(character)) {
    result = `${result}U`
  }
  if (Char.isLower(character)) {
    result = `${result}l`
  }
  if (Char.isWhitespace(character)) {
    result = `${result}W`
  }
  return result
}

function codeChar(code: int): char {
  if (Char.fromCode(code) is Some(character)) {
    return character
  }
  return '?'
}

function show(label: string, character: char) uses io, alloc {
  print(`${label} [${flags(character)}]`)
}

export function run(args: Array<string>): int uses io, alloc {
  show("0", '0')
  show("9", '9')
  show("a", 'a')
  show("z", 'z')
  show("A", 'A')
  show("Z", 'Z')
  show("space", ' ')
  show("tab", '\t')
  show("newline", '\n')
  show("return", '\r')
  show("vertical tab", codeChar(11))
  show("form feed", codeChar(12))
  show("slash", '/')
  show("colon", ':')
  show("at", '@')
  show("backtick", '`')
  show("brace", '{')
  show("nul", codeChar(0))
  show("delete", codeChar(127))
  show("e acute", 'é')
  show("sigma", 'σ')
  show("no-break space", codeChar(160))
  show("ideographic space", codeChar(12288))
  show("emoji", '😀')
  return 0
}
