// The standard library's registry: one StdFunc per builtin, in the order of the
// std modules (the prelude first). The rows of each module are in std<module>.nra
// beside its checks and emitters; this file registers them and resolves the type
// texts of the rows.
import { StdFunc, Registry, newRegistry, register } from "narrac/builtins"
import { Checker, typeString } from "narrac/check"
import { stdType } from "narrac/stdtypes"
import * as Arrays from "std/array"
import { PRELUDE_FUNCS } from "narrac/stdprelude"
import { INT_FUNCS } from "narrac/stdint"
import { FLOAT_FUNCS } from "narrac/stdfloat"
import { STRING_FUNCS } from "narrac/stdstring"
import { ARRAY_FUNCS } from "narrac/stdarray"
import { BOX_FUNCS } from "narrac/stdbox"
import { POINTER_FUNCS } from "narrac/stdptr"
import { CHAR_FUNCS } from "narrac/stdchar"
import { CELL_FUNCS } from "narrac/stdcell"
import { LAZY_FUNCS } from "narrac/stdlazy"
import { COROUTINE_FUNCS } from "narrac/stdcoroutine"
import {
  INTERNAL_CELL_FUNCS,
  INTERNAL_CLOCK_FUNCS,
  INTERNAL_COROUTINE_FUNCS,
  INTERNAL_ENTROPY_FUNCS,
  INTERNAL_FLOAT_FUNCS,
  INTERNAL_PROBE_FUNCS,
  internalMathFuncs,
} from "narrac/stdinternal"
import { ENV_FUNCS } from "narrac/stdenv"
import { FS_FUNCS } from "narrac/stdfs"
import { IO_FUNCS } from "narrac/stdio"
import { JSON_FUNCS } from "narrac/stdjson"
import { HASH_FUNCS } from "narrac/stdhash"
import { MATH_FUNCS } from "narrac/stdmath"
import { TIME_FUNCS } from "narrac/stdtime"
import { BUILD_FUNCS } from "narrac/stdbuild"
import { RANDOM_FUNCS } from "narrac/stdrandom"
import { MAP_FUNCS } from "narrac/stdmap"
import { OPTION_FUNCS } from "narrac/stdoption"
import { PATH_FUNCS } from "narrac/stdpath"
import { PROCESS_FUNCS } from "narrac/stdprocess"
import { RANGE_FUNCS } from "narrac/stdrange"
import { RESULT_FUNCS } from "narrac/stdresult"
import { SHAPE_FUNCS } from "narrac/stdshape"
import { TEST_FUNCS } from "narrac/stdtest"
import { F32_FUNCS } from "narrac/stdf32"
import { BYTES_FUNCS } from "narrac/stdbytes"
import { sizedFuncs, intConversionFuncs } from "narrac/stdsized"
import { CSTRING_FUNCS } from "narrac/externs"
import { ASYNC_FUNCS, INTERNAL_ASYNC_FUNCS } from "narrac/stdasync"

// std/fixedarray is Narra source (std/src/fixedarray.nra): a module row with no function.
const FIXED_ARRAY_FUNCS: Array<StdFunc> = [
  StdFunc { name: "std/fixedarray", module: "std/fixedarray", key: "", check: "source" },
]

function registerAll(mutable registry: Registry, table: Array<StdFunc>) uses alloc {
  for (const builtin of Arrays.values(table)) {
    register(mutable registry, builtin)
  }
}

export function stdRegistry(): Registry uses alloc {
  // Registration order gives the module order of the registry. A new std module adds its
  // import and one line here.
  let registry = newRegistry()
  registerAll(mutable registry, PRELUDE_FUNCS)
  registerAll(mutable registry, INT_FUNCS)
  registerAll(mutable registry, intConversionFuncs())
  registerAll(mutable registry, FLOAT_FUNCS)
  registerAll(mutable registry, STRING_FUNCS)
  registerAll(mutable registry, ARRAY_FUNCS)
  registerAll(mutable registry, BOX_FUNCS)
  registerAll(mutable registry, POINTER_FUNCS)
  registerAll(mutable registry, CELL_FUNCS)
  registerAll(mutable registry, CHAR_FUNCS)
  registerAll(mutable registry, COROUTINE_FUNCS)
  registerAll(mutable registry, INTERNAL_COROUTINE_FUNCS)
  registerAll(mutable registry, INTERNAL_CELL_FUNCS)
  registerAll(mutable registry, ENV_FUNCS)
  registerAll(mutable registry, FS_FUNCS)
  registerAll(mutable registry, INTERNAL_CLOCK_FUNCS)
  registerAll(mutable registry, INTERNAL_ENTROPY_FUNCS)
  registerAll(mutable registry, INTERNAL_FLOAT_FUNCS)
  registerAll(mutable registry, internalMathFuncs())
  registerAll(mutable registry, INTERNAL_PROBE_FUNCS)
  registerAll(mutable registry, IO_FUNCS)
  registerAll(mutable registry, HASH_FUNCS)
  registerAll(mutable registry, JSON_FUNCS)
  registerAll(mutable registry, MATH_FUNCS)
  registerAll(mutable registry, MAP_FUNCS)
  registerAll(mutable registry, OPTION_FUNCS)
  registerAll(mutable registry, PATH_FUNCS)
  registerAll(mutable registry, PROCESS_FUNCS)
  registerAll(mutable registry, RANGE_FUNCS)
  registerAll(mutable registry, RANDOM_FUNCS)
  registerAll(mutable registry, RESULT_FUNCS)
  registerAll(mutable registry, SHAPE_FUNCS)
  registerAll(mutable registry, TEST_FUNCS)
  registerAll(mutable registry, TIME_FUNCS)
  registerAll(mutable registry, BUILD_FUNCS)
  registerAll(mutable registry, sizedFuncs())
  registerAll(mutable registry, F32_FUNCS)
  registerAll(mutable registry, BYTES_FUNCS)
  registerAll(mutable registry, FIXED_ARRAY_FUNCS)
  registerAll(mutable registry, CSTRING_FUNCS)
  registerAll(mutable registry, LAZY_FUNCS)
  registerAll(mutable registry, ASYNC_FUNCS)
  registerAll(mutable registry, INTERNAL_ASYNC_FUNCS)
  return registry
}

export function typeProblems(mutable checker: Checker): Array<string> uses alloc {
  // The checker must have declared the prelude. `narrac builtins` prints the lines, so a typo
  // in the table fails TestSelfhostBuiltins.
  let out: Array<string> = []
  const functions = copy(checker.registry.functions)
  for (const builtin of Arrays.values(functions)) {
    let texts = copy(builtin.parameters)
    if (builtin.result != "") {
      Arrays.push(mutable texts, builtin.result)
    }
    for (const text of Arrays.values(texts)) {
      const type = stdType(mutable checker, text)
      const back = typeString(checker, type)
      if (back != text) {
        Arrays.push(mutable out, `stdType ${builtin.name}: ${text} prints as ${back}`)
      }
    }
  }
  return out
}
