-- literals
/abc/ "xxabcxx": "abc" at 2..5
/abc/ "ab": no match
// "abc": "" at 0..0
/a.c/ "abc": "abc" at 0..3
/a.c/ "a
c": no match
/(?s)a.c/ "a
c": "a
c" at 0..3
/a\.c/ "abc a.c": "a.c" at 4..7
/\$\(x\)/ "cost $(x)": "$(x)" at 5..9
/\x41\u0042\u{43}/ "ABC": "ABC" at 0..3
/\t\n/ "a	
b": "	
" at 1..3
-- classes
/[abc]+/ "xxbcaz": "bca" at 2..5
/[a-z]+/ "ABCdefGHI": "def" at 3..6
/[^a-z]+/ "abcDEF1g": "DEF1" at 3..7
/[a-]+/ "x-a-y": "-a-" at 1..4
/[\d.]+/ "pi is 3.14!": "3.14" at 6..10
/\d+/ "abc 123 def": "123" at 4..7
/\D+/ "123abc456": "abc" at 3..6
/\w+/ "  hello_world1 !": "hello_world1" at 2..14
/\W+/ "abc, def": ", " at 3..5
/\s+/ "a 	
 b": " 	
 " at 1..5
/\S+/ "  word  ": "word" at 2..6
/[\s\d]+/ "ab 1 2 cd": " 1 2 " at 2..7
/[]a]/ "a": no match
/[^]/ "x": "x" at 0..1
/[\]]/ "a]b": "]" at 1..2
/[\b]/ "ab": "" at 1..2
-- anchors
/^abc/ "abcabc": "abc" at 0..3
/^abc/ "xabc": no match
/abc$/ "abcabc": "abc" at 3..6
/abc$/ "abcx": no match
/^$/ "": "" at 0..0
/(?m)^b/ "a
b": "b" at 2..3
/^b/ "a
b": no match
/(?m)a$/ "a
b": "a" at 0..1
/\bfoo\b/ "afoo foo": "foo" at 5..8
/\Boo\B/ "foo boot": "oo" at 5..7
/\b/ "": no match
-- repeats
/a*/ "aaab": "aaa" at 0..3
/a*?/ "aaab": "" at 0..0
/a+?/ "aaab": "a" at 0..1
/a?/ "b": "" at 0..0
/a??b/ "ab": "ab" at 0..2
/a{3}/ "aaaaa": "aaa" at 0..3
/a{2,}/ "aaaaa": "aaaaa" at 0..5
/a{2,3}/ "aaaaa": "aaa" at 0..3
/a{2,3}?/ "aaaaa": "aa" at 0..2
/a{,3}/ "a{,3}": "a{,3}" at 0..5
/x{/ "x{": "x{" at 0..2
/<.*>/ "<a><b>": "<a><b>" at 0..6
/<.*?>/ "<a><b>": "<a>" at 0..3
/(a|ab)(c|bcd)(d*)/ "abcd": "abcd" at 0..4 groups "a" "bcd" ""
/(a+)(b+)?/ "aaac": "aaa" at 0..3 groups "aaa" -
/(a*)*b/ "aaab": "aaab" at 0..4 groups "aaa"
/(a*)+/ "b": "" at 0..0 groups ""
/(a|b)*/ "abba": "abba" at 0..4 groups "a"
/(?:(a)|b)+/ "ab": "ab" at 0..2 groups -
/(?:(a)|(b))+/ "ab": "ab" at 0..2 groups - "b"
/(?:(a)|b){2}/ "ab": "ab" at 0..2 groups -
/(|a)+/ "aa": "aa" at 0..2 groups "a"
/(|a)*/ "aa": "aa" at 0..2 groups "a"
/(a|)*?b/ "aab": "aab" at 0..3 groups "a"
/(a?)*/ "aa": "aa" at 0..2 groups "a"
/(a*)*/ "b": "" at 0..0 groups -
/(?:a|())+/ "aa": "aa" at 0..2 groups -
/(a){0,3}/ "aaaa": "aaa" at 0..3 groups "a"
-- alternation
/cat|dog/ "hotdog": "dog" at 3..6
/a|ab/ "ab": "a" at 0..1
/ab|a/ "ab": "ab" at 0..2
/(?:x|y)+z/ "xyxz": "xyxz" at 0..4
/|a/ "a": "" at 0..0
/a|/ "b": "" at 0..0
-- groups
/(\d+)-(\d+)/ "tel 555-1234": "555-1234" at 4..12 groups "555" "1234"
/((a)(b))/ "ab": "ab" at 0..2 groups "ab" "a" "b"
/(a)|(b)/ "b": "b" at 0..1 groups - "b"
/(?:a)(b)/ "ab": "ab" at 0..2 groups "b"
/()/ "x": "" at 0..0 groups ""
/(?<year>\d{4})-(?<month>\d\d)/ "on 2026-11-14" <month>: "11"
/(?<year>\d{4})-(?<month>\d\d)/ "on 2026-11-14" <day>: none
/(?<word>[a-z]+)|(?<num>\d+)/ "42" <word>: none
/(?<word>[a-z]+)|(?<num>\d+)/ "42" <num>: "42"
-- flags
/(?i)hello/ "Say HeLLo": "HeLLo" at 4..9
/(?i)[a-c]+/ "xABCabcd": "ABCabc" at 1..7
/(?i)[^a-c]+/ "abCdeF": "deF" at 3..6
/a(?i)b/ "aB": "aB" at 0..2
/a(?i)b/ "AB": no match
/(?i:a)b/ "Ab": "Ab" at 0..2
/(?i:a)b/ "AB": no match
/(?i)é/ "Éé": "é" at 2..4
/(?ms)^a.b$/ "x
a
b
y": "a
b" at 2..5
/(?i-m)A/ "a": "a" at 0..1
-- non-ASCII text
/é+/ "caféé!": "éé" at 3..7
/caf./ "un café": "café" at 3..8
/./ "😀x": "😀" at 0..4
/[α-ω]+/ "abc αβγ def": "αβγ" at 4..10
/\u{1F600}/ "smile 😀": "😀" at 6..10
/😀+/ "smile 😀😀": "😀😀" at 6..14
/\uD83D\uDE00/ "smile 😀": "😀" at 6..10
/[😀-🙏]/ "a 😂": "😂" at 2..6
/\w+/ "été": "t" at 2..3
/\bt/ "ét": "t" at 2..3
/\s/ "a　b": "　" at 1..4
-- empty matches and findAll
all /a*/ "baaca": ""@0 "aa"@1 ""@3 "a"@4 ""@5
all /b*/ "abc": ""@0 "b"@1 ""@2 ""@3
all /\d+/ "1 22 333": "1"@0 "22"@2 "333"@5
all // "éa": ""@0 ""@2 ""@3
all /x/ "abc": 
-- test and findFrom
matches "foo": yes
matches "bar": no
findFrom 3: "o" at 5..6
findFrom 99: no
findFrom 1 of ^a: no
findFrom inside a character: "x" at 2..3
