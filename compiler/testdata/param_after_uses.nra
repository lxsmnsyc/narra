// A function-typed parameter with a `uses` clause followed by a `mutable`
// parameter: the comma after `E` starts the next parameter.
import * as Arrays from "std/array"

export function fill<U, effect E>(g: () => U uses E, mutable out: Array<int>): int uses alloc, E {
  Arrays.push(mutable out, 1)
  return 0
}

export function run(args: Array<string>): int {
  let xs: Array<int> = []
  fill(() => 1, mutable xs)
  print("ok")
  return 0
}
