// std/regex: patterns that take exponential time in a backtracking engine
// finish in linear time. The time is printed only as a pass or fail against a
// one second bound, so the output is stable.
import * as Regexes from "std/regex"
import * as Str from "std/string"
import * as Time from "std/time"

function repeatText(text: string, count: int): string uses alloc {
  if (Str.repeat(text, count) is Some(repeated)) {
    return repeated
  }
  return ""
}

function check(name: string, pattern: string, text: string) uses io, alloc {
  const compiled = Regexes.compile(pattern)
  if (compiled is Err(error)) {
    print(`${name}: error ${error.reason}`)
    return
  }
  const started = Time.now()
  const found = Regexes.matches(compiled.value, text)
  const elapsed = Time.elapsed(started)
  let answer = "no match"
  if (found) {
    answer = "match"
  }
  let speed = "under 1 s"
  if (elapsed.nanos > 1000000000) {
    speed = "over 1 s"
  }
  print(`${name}: ${answer}, ${speed}`)
}

export function run(_args: Array<string>): int uses io, alloc {
  check("(a*)*b against 10,000 a", "(a*)*b", repeatText("a", 10000))
  check("(a|aa)*c against 5,000 a", "(a|aa)*c", repeatText("a", 5000))
  check("(a+)+$ against 5,000 a and b", "(a+)+$", `${repeatText("a", 5000)}b`)
  check("(x+x+)+y against 5,000 x", "(x+x+)+y", repeatText("x", 5000))
  return 0
}
