// Names in the `_` form and the names the compiler writes are not unused:
// imports named `_Ranges` and `_Value`, a private function `_spare`, a struct
// that derives Shape whose Shape functions nothing calls, and the hidden
// local of a for-destructuring. A private function used only as a function
// value is used.
import * as _Ranges from "std/range"
import { Value as _Value } from "std/shape"

struct Point derives Shape {
  x: int
  y: int
}

function _spare(): int {
  return 1
}

function double(value: int): int {
  return value * 2
}

function sum(points: Array<Point>): int {
  let total = 0
  for (const { x, y } of points) {
    total = total + x + y
  }
  return total
}

export function run(args: Array<string>): int uses io {
  const scale = double
  const total = scale(sum([Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]))
  if (total == 20) {
    print("ok")
  }
  return 0
}
