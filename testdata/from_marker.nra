// The from result marker: a result that shares a parameter names it, in
// declarations, arrow functions and function types. A function with a fresh
// result fits a slot with `from`, and a generic function's `from` covers what
// is reached through the parameter whatever the type arguments are.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Grid {
  rows: Array<Array<int>>
}

struct Picker {
  pick: (grid: Grid) => Array<int> from grid uses alloc
}

function firstRow(grid: Grid): Array<int> from grid {
  return grid.rows[0]
}

function freshRow(grid: Grid): Array<int> {
  return [Arrays.length(grid.rows)]
}

function lastItem<T>(items: Array<T>): T from items {
  return items[Arrays.length(items) - 1]
}

function wrap(items: Array<int>): Option<Array<int>> from items {
  if (Arrays.length(items) == 0) {
    return None
  }
  const kept = items
  return Some(kept)
}

function applyPick(pick: (grid: Grid) => Array<int> from grid, grid: Grid): Array<int> from grid {
  return pick(grid)
}

function sum(values: Array<int>): int {
  let total = 0
  for (const value of Arrays.values(values)) {
    total += value
  }
  return total
}

export function run(_args: Array<string>): int {
  const grid = Grid { rows: [[1, 2], [3, 4]] }

  // A fresh function and a sharing one fit the same `from` slot.
  const pickers = [Picker { pick: firstRow }, Picker { pick: freshRow }]
  for (const picker of Arrays.values(pickers)) {
    print(Int.toString(sum(applyPick(picker.pick, grid))))
  }

  // An arrow function that shares its own parameter says so.
  const second: (grid: Grid) => Array<int> from grid = (target: Grid): Array<int> from target =>
    target.rows[1]
  print(Int.toString(sum(applyPick(second, grid))))
  // Without a written `from`, an arrow function takes the one of its slot.
  print(Int.toString(sum(applyPick((target) => target.rows[0], grid))))

  // A generic result shares its parameter for any type argument.
  print(Int.toString(lastItem([5, 6, 7])))
  print(Int.toString(sum(lastItem(grid.rows))))

  if (wrap([8, 9]) is Some(wrapped)) {
    print(Int.toString(sum(wrapped)))
  }
  return 0
}
