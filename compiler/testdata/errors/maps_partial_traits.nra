// error: it implements one of Equatable and Hashable but not the other
import * as Map from "std/map"

struct Id implements Equatable {
  n: int
}

implement Equatable for Id {
  function equals(a: Id, b: Id): bool {
    return a.n == b.n
  }
}

export function run(args: Array<string>): int {
  let m: Map<Id, int> = Map {}
  return Map.size(m)
}
