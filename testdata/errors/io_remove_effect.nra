// error: Function `cleanup` uses `io` (through `Fs.removeFile`) but its signature does not declare it
import * as Fs from "std/fs"

export function cleanup(path: string): bool uses alloc {
  const removed = Fs.removeFile(path)
  return removed is Ok(_)
}

export function run(args: Array<string>): int {
  const _ = cleanup("x")
  return 0
}
