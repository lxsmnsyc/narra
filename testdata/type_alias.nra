import * as Int from "std/int"
import * as Arrays from "std/array"

enum Token {
  Word(text: string)
  Number(value: int)
  Eof
}

type Tok = Token
type Pair<T> = #[T, T]
type Names = Array<string>
type Table<V> = Map<string, V>
type IntPair = Pair<int>
type Later = Point

struct Point {
  x: int
  y: int
}

function describe(token: Tok): string {
  return match (token) {
    Tok.Word(text) => `word ${text}`
    Tok.Number(value) => `number ${Int.toString(value)}`
    Tok.Eof => "eof"
  }
}

function swap<T>(pair: Pair<T>): Pair<T> {
  const #[first, second] = pair
  return #[second, first]
}

function sum(pair: IntPair): int {
  const #[first, second] = pair
  return first + second
}

function countNames(names: Names): int {
  return Arrays.length(names)
}

export function run(args: Array<string>): int {
  const word: Token = Tok.Word("hi")
  const number: Tok = Token.Number(4)
  print(describe(word))
  print(describe(number))
  print(describe(Tok.Eof))
  const swapped = swap(#[1, 2])
  print(Int.toString(sum(swapped)))
  const #[left, right] = swapped
  print(`${Int.toString(left)} ${Int.toString(right)}`)
  const names: Names = ["a", "b"]
  const table: Table<int> = Map { "one": 1 }
  print(Int.toString(countNames(names)))
  if (table["one"] is Some(one)) {
    print(Int.toString(one))
  }
  const point: Later = Point { x: 3, y: 4 }
  print(Int.toString(point.x + point.y))
  return 0
}
