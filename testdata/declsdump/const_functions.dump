  variant Some
    field value T
  variant None
impl module="" derived Show Option
impl module="" derived Ordered Option
generic enum module="" params=T,E Result
  variant Ok
    field value T
  variant Err
    field error E
impl module="" derived Show Result
impl module="" derived Ordered Result
func module="const_functions" square
  param value int
  result int
func module="const_functions" table
  param count int
  result Array<int>
const module="const_functions" AREA ?
module "const_functions"
  scope func square const_functions.square
  scope func table const_functions.table
  scope const AREA const_functions.AREA
entry "const_functions" none
order module="" Ordering
impl module="" holds=true Equatable Ordering
