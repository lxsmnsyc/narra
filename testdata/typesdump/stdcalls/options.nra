import * as Options from "std/option"
import * as Results from "std/result"
import * as Int from "std/int"
import * as Str from "std/string"

function parse(text: string): Result<int, string> {
  return Int.parse(text, 10)
}

function _options(): int {
  const some: Option<int> = Some(3)
  const none: Option<int> = None
  const offset = 10
  const doubled = Options.map(some, (value) => value * 2)
  const shifted = Options.map(some, (value) => value + offset)
  const chained: Option<int> = Options.andThen(some, (_value) => None)
  const chainedSome = Options.andThen(some, (value) => Some(value + 1))
  const fallback = Options.orElse(none, () => Some(9))
  const _text = Options.map(some, (value) => Int.toString(value))
  const _result: Result<int, string> = Options.okOr(some, "missing")
  const _viaDefault = Options.okOr(none, 5)
  if (Options.isSome(some) && Options.isNone(none)) {
    return Options.withDefault(doubled, 0) + Options.withDefault(shifted, offset)
  }
  return Options.withDefault(chained, 1) +
    Options.withDefault(chainedSome, 2) +
    Options.withDefault(fallback, 3)
}

function _results(text: string): int {
  const parsed = parse(text)
  const offset = 4
  const mapped = Results.map(parsed, (value) => value + offset)
  const _described = Results.mapErr(parsed, (message) => Str.concat(message, "!"))
  const chained: Result<int, string> = Results.andThen(parsed, (_value) => Err("nope"))
  const chainedOk: Result<int, string> = Results.andThen(parsed, (value) => Ok(value + 1))
  const _good: Option<int> = Results.ok(parsed)
  const _bad: Option<string> = Results.err(parsed)
  return Results.withDefault(mapped, 0) +
    Results.withDefault(chained, 1) +
    Results.withDefault(chainedOk, 2)
}
