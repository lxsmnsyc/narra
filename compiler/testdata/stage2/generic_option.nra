// Stage 2 sample: a user generic function next to std/option calls.
import * as Options from "std/option"
import * as Int from "std/int"
import * as Arrays from "std/array"

function firstOr<T>(items: Array<T>, fallback: T): T {
  if (Arrays.length(items) > 0) {
    return items[0]
  }
  return fallback
}

export function run(args: Array<string>): int {
  const doubled = Options.map(Some(21), (n) => n * 2)
  print(Int.toString(Options.withDefault(doubled, 0)))
  print(Int.toString(firstOr([7, 8], 0)))
  print(Int.toString(firstOr([], 5)))
  return 0
}
