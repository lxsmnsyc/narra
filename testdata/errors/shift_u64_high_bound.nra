// error: shift_u64_high_bound.nra:8:21: the shift count must be a constant from 0 to 63 or a name checked against both ends first; check the name first, as in `if (n >= 0 && n < 64) { ... }`
import * as U64 from "std/u64"

const HIGH_BIT: u64 = 9223372036854775807 + 2

function shift(value: u64, count: u64): u64 {
  if (count <= HIGH_BIT) {
    return value << count
  }
  return 0
}

export function run(args: Array<string>): int {
  shift(1, 3)
  return 0
}
