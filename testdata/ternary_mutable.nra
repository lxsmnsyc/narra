// The two branches of a ternary never run together, so a `mutable` use in
// one branch and a read in the other is legal.
import * as Int from "std/int"

function bump(mutable n: int): int {
  n = n + 10
  return 5
}

export function run(args: Array<string>): int {
  let x = 1
  const first = x > 0 ? bump(mutable x) : x
  print(`${Int.toString(first)} ${Int.toString(x)}`)
  let y = 1
  const second = x < 0 ? bump(mutable y) : y
  print(`${Int.toString(second)} ${Int.toString(y)}`)
  return 0
}
