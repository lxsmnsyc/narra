// Async<void> handles work with the std/async functions that need no value:
// detach, then (the callback takes no argument), cancel, and a generic
// function of the program's own over Async<T>.
import * as Async from "std/async"

async function work(label: string) uses io {
  await Async.idle()
  print(`${label} done`)
}

function keep<T>(handle: Async<T>): Async<T> from handle {
  return handle
}

export async function run(_args: Array<string>): int {
  const watched = work("watched")
  Async.then(watched, () => print("then runs"))
  Async.detach(work("detached"))
  const cancelled = work("cancelled")
  Async.then(cancelled, () => print("never printed"))
  Async.cancel(cancelled)
  await keep(watched)
  await cancelled
  Async.then(watched, () => print("then on a finished handle"))
  print("queued")
  await Async.idle()
  print("entry ends")
  return 0
}
