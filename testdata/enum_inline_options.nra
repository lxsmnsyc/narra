// Options stored inline: Option of int, string and a struct with counted
// fields. Copies of an inline value share its counted fields, so each copy
// must retain them and each owner must release them once.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Maps from "std/map"

struct Person derives Show, Equatable {
  name: string
  tags: Array<string>
}

function findEven(values: Array<int>): Option<int> {
  for (const value of values) {
    if (value % 2 == 0) {
      return Some(value)
    }
  }
  return None
}

function makeName(count: int): Option<string> {
  if (count == 0) {
    return None
  }
  return Some(Str.repeat("n", count))
}

function describe(option: Option<string>): string {
  return match (option) { Some(text) => `some ${text}`, None => "none" }
}

function makePerson(name: string): Person {
  return Person { name: Str.repeat(name, 2), tags: [Str.repeat("t", 3), name] }
}

export function run(args: Array<string>): int {
  // Option<int> holds nothing counted.
  print(Show.show(findEven([1, 3, 4, 6])))
  print(Show.show(findEven([1, 3])))

  // Copies of an Option<string>: the original is replaced while copies live.
  let name = makeName(3)
  const copy = name
  let stored: Array<Option<string>> = [name, copy, None]
  name = makeName(2)
  print(describe(copy))
  print(describe(name))
  Arrays.push(mutable stored, name)
  for (const item of stored) {
    print(describe(item))
  }
  name = None
  print(describe(stored[0]))

  // An Option of a struct with counted fields, matched while the subject
  // variable is replaced inside the arm.
  let person: Option<Person> = Some(makePerson("ab"))
  match (person) {
    Some(found) => {
      person = None
      print(found.name)
      print(Str.join(found.tags, "+"))
    }
    None => print("nobody")
  }
  person = Some(makePerson("cd"))
  if (person is Some(other)) {
    person = Some(makePerson("ef"))
    print(other.name)
  }
  print(Show.show(person))

  // Nested options and nested matches.
  let nested: Option<Option<string>> = Some(makeName(4))
  const nestedCopy = nested
  nested = Some(None)
  match (nestedCopy) {
    Some(Some(text)) => print(`nested ${text}`)
    Some(None) => print("nested none")
    None => print("outer none")
  }
  match (nested) {
    Some(inner) => {
      match (inner) { Some(text) => print(text), None => print("inner none") }
    }
    None => print("outer none")
  }

  // Equality and map lookups that return an inline Option.
  print(Show.show(makeName(2) == makeName(2)))
  print(Show.show(Some(makePerson("x")) == Some(makePerson("x"))))
  let ages: Map<string, string> = Map {}
  ages[Str.repeat("k", 2)] = Str.repeat("v", 2)
  const found = ages["kk"]
  ages["kk"] = "w"
  print(describe(found))
  print(describe(ages["zz"]))
  print(Int.toString(Maps.size(ages)))
  return 0
}
