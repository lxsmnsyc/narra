// error: the result shares parameter "items"; write `from items` after the result type
import * as Arrays from "std/array"
import * as Int from "std/int"

async function keep(items: Array<int>): Array<int> {
  return items
}

export async function run(_args: Array<string>): int {
  const items = [1, 2, 3]
  const got = await keep(items)
  print(`${Int.toString(Arrays.length(items))} ${Int.toString(Arrays.length(got))}`)
  return 0
}
