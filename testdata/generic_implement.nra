import * as Int from "std/int"

trait Label {
  function label(value: Self): string
}

struct Pair<T: Show> implements Label, Show derives Equatable {
  left: T
  right: T
}

implement Label for Pair<T> {
  function label(value: Pair<T>): string {
    return `(${Show.show(value.left)}, ${Show.show(value.right)})`
  }
}

implement Show for Pair<T> {
  function show(value: Self): string {
    return `pair ${Label.label(value)}`
  }
}

enum Shape<T: Show> implements Label {
  Dot
  Line(start: T, end: T)
}

implement Label for Shape<T> {
  function label(value: Shape<T>): string {
    return match (value) {
      Shape.Dot => "dot"
      Shape.Line(start, end) => `line ${Show.show(start)} to ${Show.show(end)}`
    }
  }
}

function describe<T: Label>(value: T): string {
  return `<${Label.label(value)}>`
}

export function run(_args: Array<string>): int {
  const numbers = Pair { left: 1, right: 2 }
  const words = Pair { left: "a", right: "b" }
  print(Label.label(numbers))
  print(describe(words))
  print(Show.show(numbers))
  const nested = Pair { left: Pair { left: 1, right: 2 }, right: Pair { left: 3, right: 4 } }
  print(Label.label(nested))
  print(describe(nested))
  print(Show.show(numbers == Pair { left: 1, right: 2 }))
  const line: Shape<int> = Shape.Line(1, 5)
  const dot: Shape<string> = Shape.Dot
  print(Label.label(line))
  print(describe(dot))
  print(Show.show([numbers, Pair { left: 7, right: 8 }]))
  print(Int.toString(42))
  return 0
}
