struct Counter {
  value: int
}

function bump(mutable counter: Counter, by: int) {
  counter.value = counter.value + by
}

function swap(mutable left: Counter, mutable right: Counter) {
  left.value = right.value
}

export function run(args: Array<string>): int {
  let counter = Counter { value: 1 }
  let other = Counter { value: 2 }
  bump(mutable counter, counter.value)
  swap(mutable counter, mutable counter)
  bump(mutable counter, other.value)
  swap(mutable counter, mutable other)
  return counter.value
}
