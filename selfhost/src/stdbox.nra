// The registry rows, checks of std/box.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Checker, internComposite, Walker } from "narrac/check"
import { Pos, Arg } from "narrac/ast"
import { checkExpression } from "narrac/exprs"
import { checkArgumentCount } from "narrac/stdcheckhelp"

export const BOX_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Box.new",
    module: "std/box",
    key: "new",
    effects: ["alloc"],
    check: "checkBoxNew",
  },
]

function checkBoxNew<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  want: Option<Type>,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    return Type.TVoid
  }
  let hint: Option<Type> = None
  if (want is Some(wantType)) {
    if (wantType is Type.TBox(wantElement)) {
      hint = Some(wantElement)
    }
  }
  const element = checkExpression(mutable checker, walker, arguments[0].value, hint)
  return internComposite(mutable checker, Type.TBox(element))
}

export function checkBoxCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
  want: Option<Type>,
): Type uses alloc {
  if (kind == "checkBoxNew") {
    return checkBoxNew(mutable checker, walker, pos, arguments, name, want)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
  return Type.TVoid
}
