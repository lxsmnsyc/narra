// Diagnostic codes, as in Go's diagnostic_codes.go: the table of codes with
// their message formats, the long texts of `narrac explain`, and the JSON line
// of `narrac check --json` (contracts/diagnostic.md). The code of a diagnostic is
// passed at the place that reports it; the formats here only name and explain
// the codes, so the text of a message never decides its code.
//
// Ranges:
//   E0001-E0099  lexer and parser
//   E0100-E0199  declarations and types
//   E0200-E0299  expressions and statements
//   E0300-E0399  calls and constructors
//   E0400-E0499  modules, packages and narra.toml
//   E0500-E0599  traits
//   E0600-E0699  closures and function values
//   E0700-E0799  patterns and match
//   E0800-E0899  effects
//   E0900-E0999  standard library, including maps
//   E1000-E1099  C interop and unsafe code
//
// Add a code by appending the next free number in the range, at the end of
// that range's rows. Never renumber or reuse a code. Rows keep the order of
// the Go table; a code with several formats has several rows.
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import { Pos } from "narrac/ast"
import { Fix } from "narrac/fixes"
import { quoteGo } from "narrac/parser"
import { quoteJson } from "narrac/queryjson"

export struct CodeRow {
  code: string
  format: string
}

export struct Explanation {
  code: string
  text: string
}

