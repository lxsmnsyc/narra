// error: E1053, an index out of range after std/bytes calls
import * as Bytes from "std/bytes"

@const
function third(text: string): u8 uses alloc {
  const data = Bytes.toArray(Bytes.fromString(text))
  return data[2]
}

const THIRD = third("hi")

export function run(args: Array<string>): int {
  return 0
}
