// The CRC-32 table, computed by the compiler from an @const function, and the
// same call made at run time.
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Int from "std/int"
import * as Str from "std/string"

@const
function crcTable(): Array<int> uses alloc {
  let table: Array<int> = []
  for (const entry of Ranges.upTo(256)) {
    let value = entry
    for (const _bit of Ranges.upTo(8)) {
      if ((value & 1) != 0) {
        value = 3988292384 ^ (value >> 1)
      } else {
        value = value >> 1
      }
    }
    Arrays.push(mutable table, value)
  }
  return table
}

const CRC_TABLE = crcTable()

function checksum(table: Array<int>, text: string): int {
  let crc = 4294967295
  for (const index of Ranges.upTo(Str.length(text))) {
    crc = table[(crc ^ Str.byteAt(text, index)) & 255] ^ (crc >> 8)
  }
  return crc ^ 4294967295
}

export function run(args: Array<string>): int uses io, alloc {
  const atRunTime = crcTable()
  print(
    `${Int.toString(Arrays.length(CRC_TABLE))} ${Int.toString(CRC_TABLE[1])} ${Int.toString(CRC_TABLE[255])}`,
  )
  print(
    `${Int.toString(Arrays.length(atRunTime))} ${Int.toString(atRunTime[1])} ${Int.toString(atRunTime[255])}`,
  )
  print(Int.toString(checksum(CRC_TABLE, "The quick brown fox jumps over the lazy dog")))
  print(Int.toString(checksum(atRunTime, "The quick brown fox jumps over the lazy dog")))
  return 0
}
