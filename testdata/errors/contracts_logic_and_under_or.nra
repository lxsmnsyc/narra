// error: requires compares integer parameters with integer constants or with each other, joined by && and ||; split it into clauses joined by &&; && inside || is not supported
function pick(first: int, second: int, third: int): int
  requires first > 0 && second > 0 || third > 0
{
  return first + second + third
}

export function run(_args: Array<string>): int {
  return pick(1, 1, 1)
}
