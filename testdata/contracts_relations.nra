// Relations between two integer parameters in requires: callers prove them from
// constants, intervals, one name passed twice and their own checks, and bounds pass
// one step through them.
function span(low: int, high: int): int
  requires low <= high
{
  return high - low
}

function strictSpan(low: int, high: int): int
  requires low < high
{
  // `<` proves `<=`.
  return span(low, high)
}

function shiftAt(low: int, high: int): int
  requires low >= 0 && low <= high && high < 64
{
  // low takes the high end of high, so it is a valid shift count.
  return 1 << low
}

function readAt(values: FixedArray<int, 4>, low: int, high: int): int
  requires low >= 0 && low <= high && high < 4
{
  return values[low]
}

function lowest(low: int, high: int): int
  requires low >= 0 && low <= high && high < 64
  ensures < 64
{
  return low
}

function ordered(low: int, high: int): int
  requires low < high || low == 0
{
  return low + high
}

function wide(low: u64, high: u64): u64
  requires low != high
{
  return low + high
}

function checkedSpan(first: int, second: int): int {
  if (first <= second) {
    return span(first, second)
  }
  return span(second, first)
}

function boundedSpan(first: int, second: int): int {
  if (first < 10 && second > 20) {
    return span(first, second)
  }
  return 0
}

function sameSpan(value: int): int {
  return span(value, value)
}

function checkedOrdered(first: int, second: int): int {
  if (first < second) {
    return ordered(first, second)
  }
  return ordered(0, second)
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Show.show(span(1, 5)))
  print(Show.show(strictSpan(2, 9)))
  print(Show.show(checkedSpan(8, 3)))
  print(Show.show(boundedSpan(4, 25)))
  print(Show.show(sameSpan(7)))
  print(Show.show(shiftAt(3, 10)))
  const values: FixedArray<int, 4> = [10, 20, 30, 40]
  print(Show.show(readAt(values, 2, 3)))
  print(Show.show(lowest(5, 6)))
  print(Show.show(checkedOrdered(1, 2)))
  print(Show.show(checkedOrdered(5, 2)))
  print(Show.show(wide(18446744073709551615, 1)))
  return 0
}
