// error: closure_borrow_mutable_param.nra:7:16: a closure cannot capture mutable parameter "counter" unless it is passed straight to a function parameter that is not escaping; copy it first with `const copy = counter`
struct Counter {
  n: int
}

function bump(mutable counter: Counter): () => int {
  return () => counter.n
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  return bump(mutable x)()
}
