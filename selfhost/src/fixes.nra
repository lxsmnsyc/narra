// Fix suggestions, ported from compiler/internal/narra/diagnostic_fixes.go and
// ApplyFix of diagnostic_json.go. A diagnostic carries zero or more fixes; a
// A fix is a title and edits that replace text. Builders that only need the
// syntax live here; builders that need checker results sit next to the check that
// reports the error.
//
// Positions are lines and columns from 1, and columns count characters, as the
// lexer does. An edit replaces the text from `start` up to, not including,
// `end`.
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { Pos } from "narrac/ast"

// STD_ALIAS_PATHS maps the aliases the spec's import table names to their std
// module, for the add-import fix of an unknown module name.
export const STD_ALIAS_PATHS: Map<string, string> = Map {
  "Arrays": "std/array",
  "Maps": "std/map",
  "Boxes": "std/box",
  "Ranges": "std/range",
  "Options": "std/option",
  "Results": "std/result",
  "Str": "std/string",
  "Int": "std/int",
  "Float": "std/float",
  "Char": "std/char",
  "Env": "std/env",
  "Fs": "std/fs",
  "Process": "std/process",
  "Test": "std/test",
  "Io": "std/io",
  "Path": "std/path",
  "Build": "std/build",
}

export struct Edit {
  start: Pos
  end: Pos
  text: string
}

export struct Fix {
  title: string
  edits: Array<Edit>
}

export function createEdit(start: Pos, end: Pos, text: string): Edit from start {
  return copy(Edit { start, end, text })
}

export function createFix(title: string, edits: Array<Edit>): Fix from edits {
  return Fix { title, edits }
}

export function moveColumn(pos: Pos, count: int): Pos {
  return Pos { line: pos.line, column: pos.column + count }
}

export function insertAt(pos: Pos, text: string): Edit from pos {
  return Edit { start: pos, end: pos, text }
}

export function buildQuoteFix(open: Pos, close: Pos, raw: string): Array<Fix> from open uses alloc {
  // Swapping the marks keeps the meaning only when the text has no escape and no double quote.
  if (Str.contains(raw, "\\") || Str.contains(raw, "\"")) {
    return []
  }
  return copy([
    createFix("use double quotes", [
      Edit { start: open, end: moveColumn(open, 1), text: "\"" },
      Edit { start: close, end: moveColumn(close, 1), text: "\"" },
    ]),
  ])
}

export function buildRemoveSemicolonFix(pos: Pos): Array<Fix> from pos uses alloc {
  return [
    createFix("remove the semicolon", [Edit { start: pos, end: moveColumn(pos, 1), text: "" }]),
  ]
}

export function buildQualifyFix(pos: Pos, enumName: string): Fix from pos uses alloc {
  return createFix(`qualify the constructor with ${enumName}`, [insertAt(pos, `${enumName}.`)])
}

export function buildTemplateEscape(text: string): Option<string> uses alloc {
  let builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    if (character == '\\' || character == '`' || character == '$') {
      Str.appendChar(mutable builder, '\\')
      Str.appendChar(mutable builder, character)
    } else if (character == '\n') {
      Str.append(mutable builder, "\\n")
    } else if (character == '\t') {
      Str.append(mutable builder, "\\t")
    } else if (character < ' ' || character == '\u{7f}') {
      // A control character has no escape.
      return None
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  return Some(Str.build(builder))
}

export function sliceCharacters(characters: Array<char>, first: int, last: int): string uses alloc {
  let builder = Str.builder()
  for (const index of Ranges.between(first, last)) {
    Str.appendChar(mutable builder, characters[index])
  }
  return Str.build(builder)
}

// ---- Applying a fix

function findOffset(characters: Array<char>, lineStarts: Array<int>, pos: Pos): int {
  const lineIndex = pos.line - 1
  if (lineIndex < 0) {
    return 0
  }
  if (lineIndex >= Arrays.length(lineStarts)) {
    return Arrays.length(characters)
  }
  const start = lineStarts[lineIndex]
  let lineEnd = start
  while (lineEnd < Arrays.length(characters) && characters[lineEnd] != '\n') {
    lineEnd++
  }
  // A column past the end of the line stops at the end of the line.
  let offset = start + pos.column - 1
  if (offset > lineEnd) {
    offset = lineEnd
  }
  if (offset < start) {
    offset = start
  }
  return offset
}

function findLineStarts(characters: Array<char>): Array<int> uses alloc {
  let starts = [0]
  for (const index of Ranges.upTo(Arrays.length(characters))) {
    if (characters[index] == '\n') {
      Arrays.push(mutable starts, index + 1)
    }
  }
  return starts
}

export function applyFix(source: string, fix: Fix): string uses alloc {
  // Edits must not overlap. They apply from the end of the text to the start, so the offsets of the earlier ones stay valid; two edits at the same place keep their order.
  let characters = Str.chars(source)
  const lineStarts = findLineStarts(characters)
  // Sort the edit order by start offset, largest first (a stable insertion sort).
  let order: Array<int> = []
  for (const index of Ranges.upTo(Arrays.length(fix.edits))) {
    Arrays.push(mutable order, index)
  }
  for (const position of Ranges.between(1, Arrays.length(order))) {
    for (
      let current = position;
      current > 0 &&
        findOffset(characters, lineStarts, fix.edits[order[current]].start) >
          findOffset(characters, lineStarts, fix.edits[order[current - 1]].start);
      current--
    ) {
      const swapped = order[current]
      order[current] = order[current - 1]
      order[current - 1] = swapped
    }
  }
  // Offsets are measured on the original text; each edit rebuilds the text
  // before its start and after its end.
  let result = characters
  for (const editIndex of Arrays.values(order)) {
    const edit = fix.edits[editIndex]
    const editStart = findOffset(characters, lineStarts, edit.start)
    const editEnd = findOffset(characters, lineStarts, edit.end)
    let rebuilt: Array<char> = []
    for (const index of Ranges.upTo(editStart)) {
      Arrays.push(mutable rebuilt, result[index])
    }
    for (const character of Arrays.values(Str.chars(edit.text))) {
      Arrays.push(mutable rebuilt, character)
    }
    for (const index of Ranges.between(editEnd, Arrays.length(result))) {
      Arrays.push(mutable rebuilt, result[index])
    }
    result = rebuilt
  }
  let builder = Str.builder()
  for (const character of Arrays.values(result)) {
    Str.appendChar(mutable builder, character)
  }
  return Str.build(builder)
}
