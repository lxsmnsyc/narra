// An @inline call inside a generator: the copied body runs between two yields,
// and the generator's locals and the arrow's captures stay in its frame.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

@inline
function label(value: int, format: (value: int) => string uses alloc): string uses alloc {
  if (value == 0) {
    return "zero"
  }
  const text = format(value)
  return `[${text}]`
}

function* numbered(count: int, prefix: string): Generator<string> uses alloc {
  let index = 0
  while (index < count) {
    const shown = label(index, (value) => `${prefix}${Int.toString(value)}`)
    yield shown
    index++
  }
}

export function run(_args: Array<string>): int uses io, alloc {
  let parts: Array<string> = []
  for (const part of numbered(4, "n")) {
    Arrays.push(mutable parts, part)
  }
  print(Str.join(parts, " "))
  return 0
}
