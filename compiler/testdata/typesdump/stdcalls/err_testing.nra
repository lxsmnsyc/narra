import * as Tests from "std/test"

struct Plain {
  fn: (x: int) => int
}

function outside() {
  Tests.eq(1, 1)
  Tests.ne(1, 2)
  Tests.panics(() => panic("x"))
  Tests.panicsWith(() => panic("x"), "x")
  Tests.golden("a", "b")
}

test "bad calls" {
  Tests.eq(1)
  Tests.eq(1, "a")
  Tests.eq(mutable 1, 1)
  Tests.panics(1)
  Tests.panics(() => 1)
  Tests.panicsWith(() => panic("x"))
  Tests.golden("a")
  Tests.golden(1, "a")
  Tests.eq((x: int) => x, (x: int) => x)
  Tests.eq(Plain { fn: (x: int) => x }, Plain { fn: (x: int) => x })
}
