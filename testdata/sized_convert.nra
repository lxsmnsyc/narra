import * as Int from "std/int"
import * as I8 from "std/i8"
import * as I16 from "std/i16"
import * as I32 from "std/i32"
import * as U8 from "std/u8"
import * as U16 from "std/u16"
import * as U32 from "std/u32"
import * as U64 from "std/u64"

function show<T: Show>(label: string, value: T) uses io, alloc {
  print(`${label}: ${Show.show(value)}`)
}

export function run(args: Array<string>): int uses io, alloc {
  // from: every lossless pair.
  const small: i8 = -5
  const byte: u8 = 200
  const word: u16 = 60000
  const half: u32 = 4000000000
  const wide: i16 = -300
  const mid: i32 = -70000
  show("i8 to i16", I16.from(small))
  show("i8 to i32", I32.from(small))
  show("i8 to int", Int.from(small))
  show("u8 to i16", I16.from(byte))
  show("u8 to u16", U16.from(byte))
  show("u8 to u32", U32.from(byte))
  show("u8 to u64", U64.from(byte))
  show("u8 to int", Int.from(byte))
  show("u16 to i32", I32.from(word))
  show("u16 to u32", U32.from(word))
  show("u16 to u64", U64.from(word))
  show("u32 to u64", U64.from(half))
  show("u32 to int", Int.from(half))
  show("i16 to i32", I32.from(wide))
  show("i16 to int", Int.from(wide))
  show("i32 to int", Int.from(mid))
  show("u8 to u8", U8.from(byte))
  show("i8 to i8", I8.from(small))
  const widened = I32.from(small) * 1000
  show("widened", widened)
  print(`text ${I32.toString(widened)} ${U8.toString(byte)}`)

  // tryFrom at each boundary, through a wider type.
  show("i8 max", I8.tryFrom(127))
  show("i8 max+1", I8.tryFrom(128))
  show("i8 min", I8.tryFrom(-128))
  show("i8 min-1", I8.tryFrom(-129))
  show("i16 max", I16.tryFrom(32767))
  show("i16 max+1", I16.tryFrom(32768))
  show("i16 min", I16.tryFrom(-32768))
  show("i16 min-1", I16.tryFrom(-32769))
  show("i32 max", I32.tryFrom(2147483647))
  show("i32 max+1", I32.tryFrom(2147483648))
  show("i32 min", I32.tryFrom(-2147483648))
  show("i32 min-1", I32.tryFrom(-2147483649))
  show("u8 max", U8.tryFrom(255))
  show("u8 max+1", U8.tryFrom(256))
  show("u8 min", U8.tryFrom(0))
  show("u8 min-1", U8.tryFrom(-1))
  show("u16 max", U16.tryFrom(65535))
  show("u16 max+1", U16.tryFrom(65536))
  show("u16 min-1", U16.tryFrom(-1))
  show("u32 max", U32.tryFrom(4294967295))
  show("u32 max+1", U32.tryFrom(4294967296))
  show("u32 min-1", U32.tryFrom(-1))
  show("u64 min", U64.tryFrom(0))
  show("u64 min-1", U64.tryFrom(-1))
  const biggest: u64 = 18446744073709551615
  const top: u64 = 9223372036854775807
  const over: u64 = 9223372036854775808
  show("u64 to u8", U8.tryFrom(biggest))
  show("u64 to int max", Int.tryFrom(top))
  show("u64 to int max+1", Int.tryFrom(over))
  show("i32 to u32", U32.tryFrom(mid))
  show("i16 to u8", U8.tryFrom(wide))
  show("u16 to i8", I8.tryFrom(word))
  show("int to int", Int.tryFrom(7))
  const fits: u8 = 100
  show("u8 to i8", I8.tryFrom(fits))
  show("u8 to i8 over", I8.tryFrom(byte))
  show("u32 to i32", I32.tryFrom(half))

  // wrap keeps the low bits.
  show("wrap -1 u8", U8.wrap(-1))
  show("wrap -1 u16", U16.wrap(-1))
  show("wrap -1 u32", U32.wrap(-1))
  show("wrap -1 u64", U64.wrap(-1))
  show("wrap 300 u8", U8.wrap(300))
  show("wrap 200 i8", I8.wrap(200))
  show("wrap 40000 i16", I16.wrap(40000))
  show("wrap 4294967295 i32", I32.wrap(4294967295))
  show("wrap u8 into i8", I8.wrap(byte))
  show("wrap i8 into u8", U8.wrap(small))
  show("wrap u64 into int", Int.wrap(biggest))
  show("wrap u64 into i32", I32.wrap(biggest))
  show("back", I8.wrap(U8.wrap(small)))

  // toString and parse at the limits.
  print(I8.toString(-128))
  print(I8.toString(127))
  print(I16.toString(-32768))
  print(I32.toString(-2147483648))
  print(U8.toString(255))
  print(U16.toString(65535))
  print(U32.toString(4294967295))
  print(U64.toString(biggest))
  show("parse i8", I8.parse("-128", 10))
  show("parse i8 over", I8.parse("128", 10))
  show("parse i8 under", I8.parse("-129", 10))
  show("parse u8", U8.parse("255", 10))
  show("parse u8 over", U8.parse("256", 10))
  show("parse u8 negative", U8.parse("-1", 10))
  show("parse u8 hex", U8.parse("ff", 16))
  show("parse i32 under", I32.parse("-2147483649", 10))
  show("parse u32", U32.parse("4294967295", 10))
  show("parse u64", U64.parse("18446744073709551615", 10))
  show("parse u64 over", U64.parse("18446744073709551616", 10))
  show("parse i16 empty", I16.parse("", 10))
  show("parse u16 digit", U16.parse("12x", 10))
  show("parse u8 base", U8.parse("1", 99))
  return 0
}
