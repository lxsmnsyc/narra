// The test program of the package: `narrac run -sanitize packages/http`. It prints a line for
// each failed check and then the counts, and exits with 1 when any failed.

import * as Async from "std/async"
import * as Cells from "std/cell"
import * as Process from "std/process"
import * as Time from "std/time"
import { createReport, describeCount } from "http/checkkit"
import { runCookieChecks } from "http/checkcookie"
import { runCurlChecks } from "http/checkcurl"
import { runMessageChecks } from "http/checkmessage"
import { runNetChecks } from "http/checknet"

async function watchdog() uses io, alloc {
  // Ends the program when the checks hang, so no run waits forever.
  const slept = await Time.sleep(Time.seconds(120))
  if (slept is Ok(_)) {
    print("FAIL - the checks did not finish in 120 seconds")
    Process.exit(1)
  }
}

export async function run(_args: Array<string>): int uses io, alloc {
  const report = createReport()
  Async.detach(watchdog())
  runMessageChecks(report)
  await runNetChecks(report)
  await runCookieChecks(report)
  runCurlChecks(report)
  print(describeCount(report))
  if (Cells.get(report.failed) > 0) {
    return 1
  }
  return 0
}
