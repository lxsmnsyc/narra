// `ensures != 0` makes a u64 result a divisor, as for the other widths.
function nonzeroWide(value: u64): u64
  ensures != 0
{
  if (value != 0) {
    return value
  }
  return 1
}

function nonzeroNarrow(value: u32): u32
  ensures != 0
{
  if (value != 0) {
    return value
  }
  return 1
}

function above(value: u64): u64
  ensures != 0
{
  if (value != 0) {
    return value
  }
  return 18446744073709551615
}

export function run(_args: Array<string>): int {
  const narrow = nonzeroNarrow(0)
  print(Show.show(10 / narrow))
  const wide = nonzeroWide(0)
  print(Show.show(10 / wide))
  const large = above(0)
  print(Show.show(18446744073709551615 / large))
  return 0
}
