// A capacity of 0 or below is taken as 1: the channel holds one value, so a
// send on a channel with no waiting receiver does not block the first time.
import * as Channel from "std/channel"
import * as Thread from "std/thread"
import * as Int from "std/int"

export function run(_args: Array<string>): int {
  for (const capacity of [0, -5]) {
    const #[sender, receiver] = Channel.create<int>(capacity)
    // No other thread runs yet: a channel of no room would block here forever.
    Channel.send(sender, capacity)
    if (Channel.receive(receiver) is Some(value)) {
      print(`capacity ${Int.toString(capacity)} held ${Int.toString(value)}`)
    }
    const total = Thread.scope((scope) => {
      const producer = Thread.start(scope, () => {
        for (let i = 1; i <= 10; i++) {
          Channel.send(sender, i)
        }
        Channel.close(sender)
        return 10
      })
      let sum = 0
      for (const value of Channel.values(receiver)) {
        sum += value
      }
      return sum + Thread.join(producer) * 0
    })
    print(`sum ${Int.toString(total)}`)
  }
  return 0
}
