import * as Int from "std/int"

type Pair = #[Option<int>, Option<int>]

function depthOne(value: Option<Pair>): string {
  return match (value) {
    Some(#[Some(x), _] | #[_, Some(x)]) if (x > 5) => `big ${Int.toString(x)}`
    Some(#[Some(x), _] | #[_, Some(x)]) => `small ${Int.toString(x)}`
    _ => "none"
  }
}

function depthTwo(value: Option<Option<Pair>>): string {
  match (value) {
    Some(Some(#[Some(x), _] | #[_, Some(x)])) if (x > 5) => {
      return `big ${Int.toString(x)}`
    }
    _ => {}
  }
  return "none"
}

function twoLists(value: Option<#[Pair, Pair]>): string {
  return match (value) {
    Some(#[#[Some(a), _] | #[_, Some(a)], #[Some(b), _] | #[_, Some(b)]]) if (
      a + b > 10
    ) => `sum ${Int.toString(a + b)}`
    _ => "none"
  }
}

function nestedList(value: Option<Option<int>>): string {
  return match (value) {
    Some(Some(1 | 2 | 3) | None) if (true) => "low or none"
    Some(Some(4 | 5)) if (false) => "never"
    _ => "other"
  }
}

function withText(value: Option<#[Option<string>, Option<string>]>): string {
  return match (value) {
    Some(#[Some(word), _] | #[_, Some(word)]) if (word == "long") => word
    _ => "no"
  }
}

export function run(args: Array<string>): int {
  print(depthOne(Some(#[Some(1), Some(10)])))
  print(depthOne(Some(#[Some(7), Some(10)])))
  print(depthOne(Some(#[Some(1), Some(2)])))
  print(depthOne(Some(#[None, Some(10)])))
  print(depthOne(Some(#[None, None])))
  print(depthOne(None))
  print(depthTwo(Some(Some(#[Some(1), Some(10)]))))
  print(depthTwo(Some(Some(#[Some(1), Some(2)]))))
  print(depthTwo(Some(None)))
  print(twoLists(Some(#[#[Some(1), Some(9)], #[Some(2), Some(3)]])))
  print(twoLists(Some(#[#[Some(1), Some(2)], #[Some(2), Some(3)]])))
  print(nestedList(Some(Some(2))))
  print(nestedList(Some(None)))
  print(nestedList(Some(Some(4))))
  print(withText(Some(#[Some("short"), Some("long")])))
  print(withText(Some(#[Some("short"), None])))
  return 0
}
