extern {
  function labs(value: i64): i64
} from "c"

@trusted
export function computeAbsolute(value: int): int {
  unsafe {
    return labs(value)
  }
}

export trait Measure {
  function measure(self: Self): int
}

export struct Cells implements Measure {
  count: int
}

implement Measure for Cells {
  @trusted
  function measure(self: Cells): int {
    unsafe {
      return labs(self.count)
    }
  }
}
