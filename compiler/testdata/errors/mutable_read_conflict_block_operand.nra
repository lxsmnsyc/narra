// error: mutable_read_conflict_block_operand.nra:10:5: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function bump(mutable n: int): int {
  n = 10
  return 0
}

export function run(args: Array<string>): int {
  let x = 1
  const total =
    x +
      {
        return bump(mutable x)
      }
  return total
}
