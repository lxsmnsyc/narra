// error: cannot use == on Async<int>: a task handle is shared by identity; await the handles and compare the values
async function one(): int {
  return 1
}

export async function run(_args: Array<string>): int {
  const first = one()
  const second = one()
  if (first == second) {
    return 1
  }
  let byHandle: Map<Async<int>, int> = Map {}
  byHandle[first] = 1
  return await first + await second
}
