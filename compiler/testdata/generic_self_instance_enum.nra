import * as Int from "std/int"
import * as Boxes from "std/box"

enum E<T> {
  Node(o: Option<Box<E<int>>>, v: T)
  Leaf
}

export function run(args: Array<string>): int {
  const inner: E<int> = E.Node(None, 5)
  const outer: E<string> = E.Node(Some(Boxes.new(inner)), "s")
  match (outer) {
    E.Node(o, v) => {
      print(v)
      if (o is Some(b)) {
        match (b.value) {
          E.Node(_, n) => {
            print(Int.toString(n))
          }
          E.Leaf => {
          }
        }
      }
    }
    E.Leaf => {
    }
  }
  return 0
}
