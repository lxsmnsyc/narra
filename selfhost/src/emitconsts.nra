// Function bodies, test bodies and top-level constants (emit.go function and
// the test bodies, emit_const.go). The owner is selfhost-emit-bodies.
import * as Int from "std/int"
import * as Str from "std/string"
import { Expr, Stmt, Block, Pos } from "narrac/ast"
import { Type } from "narrac/types"
import { hasReachableEnd } from "narrac/pathends"
import { Checker, ProgramFunc, BodyRoot, findBody } from "narrac/check"
import { cachedCType, cachedFunctionName, functionSignature, cachedDeclName } from "narrac/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  ScopeFrame,
  reportUnsupported,
  writeLine,
  where,
  consume,
  beginStatement,
  endStatement,
  unwindAll,
  releaseCode,
} from "narrac/emitstate"
import * as Exprs from "narrac/emitexprs"
import * as ConstValues from "narrac/emitconstvalues"
import * as Stmts from "narrac/emitstmts"
import * as Tail from "narrac/emittail"
import * as Generators from "narrac/emitgenerators"
import * as Arrays from "std/array"

const NODE = "selfhost-emit-bodies"

// BodyWalker forwards the recursion points to the expression and statement modules.
struct BodyWalker implements EmitWalker {}

implement EmitWalker for BodyWalker {
  function emitExpression(
    walker: BodyWalker,
    mutable emitter: Emitter,
    expression: Expr,
  ): Code uses alloc {
    return Exprs.emitExpression(walker, mutable emitter, expression)
  }

  function emitStatement(walker: BodyWalker, mutable emitter: Emitter, statement: Stmt) uses alloc {
    Stmts.emitStatement(walker, mutable emitter, statement)
  }

  function emitBlock(
    walker: BodyWalker,
    mutable emitter: Emitter,
    block: Block,
    loop: bool,
  ) uses alloc {
    Stmts.emitBlock(walker, mutable emitter, block, loop)
  }

  function emitBlockInScope(walker: BodyWalker, mutable emitter: Emitter, block: Block) uses alloc {
    Stmts.emitBlockInScope(walker, mutable emitter, block)
  }

  function emitLvaluePointer(
    walker: BodyWalker,
    mutable emitter: Emitter,
    expression: Expr,
  ): string uses alloc {
    return Exprs.emitLvaluePointer(walker, mutable emitter, expression)
  }
}

export function lazyConstants(emitter: Emitter): Array<int> uses alloc {
  let lazy: Array<int> = []
  for (const constIndex of Arrays.values(emitter.checker.programConsts)) {
    if (!Exprs.isStaticConstant(emitter, constIndex)) {
      Arrays.push(mutable lazy, constIndex)
    }
  }
  return lazy
}

export function emitConstPrototypes(
  mutable emitter: Emitter,
  constants: Array<int>,
): string uses alloc {
  let builder = Str.builder()
  for (const constIndex of Arrays.values(constants)) {
    const info = emitter.checker.consts[constIndex]
    const typeName = cachedCType(
      emitter.checker,
      emitter.typeNames,
      Exprs.constType(emitter.checker, constIndex),
    )
    const variable = cachedDeclName(emitter.typeNames, "G", info.module, info.name)
    const getter = cachedDeclName(emitter.typeNames, "g", info.module, info.name)
    Str.append(
      mutable builder,
      `static ${typeName} ${variable};\nstatic int ${variable}_ready;\nstatic ${typeName} ${getter}(void);\n`,
    )
  }
  return Str.build(builder)
}

function takeOutput(mutable emitter: Emitter): string uses alloc {
  const text = Str.build(emitter.out)
  emitter.out = Str.builder()
  return text
}

function startFunction(mutable emitter: Emitter, body: int, owner: string) uses alloc {
  emitter.body = body
  emitter.owner = owner
  emitter.file = moduleFile(emitter.checker, emitter.checker.bodies[body].module)
  emitter.scopes = [ScopeFrame { locals: [], loop: false }]
  emitter.frames = []
  emitter.loopFrames = []
  emitter.loopInfos = []
  emitter.blocks = []
}

function moduleFile(checker: Checker, module: string): string {
  if (checker.scopeIndex[module] is Some(scope)) {
    return checker.scopes[scope].file
  }
  return ""
}

export function emitConstRelease(mutable emitter: Emitter, lazy: Array<int>): string uses alloc {
  writeLine(mutable emitter, "static void narra_consts_release(void) {")
  emitter.indent++
  for (let position = Arrays.length(lazy) - 1; position >= 0; position--) {
    const info = copy(emitter.checker.consts[lazy[position]])
    const variable = cachedDeclName(emitter.typeNames, "G", info.module, info.name)
    const constantType = Exprs.constType(emitter.checker, lazy[position])
    const releaseText = releaseCode(emitter, constantType, variable)
    if (releaseText != "") {
      writeLine(mutable emitter, `if (${variable}_ready) { ${releaseText} }`)
    }
  }
  emitter.indent--
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, "")
  return takeOutput(mutable emitter)
}

export function emitGetter(mutable emitter: Emitter, constIndex: int): string uses alloc {
  const info = copy(emitter.checker.consts[constIndex])
  const body = findBody(emitter.checker, `const|${Int.toString(constIndex)}`)
  if (body < 0) {
    const _ = reportUnsupported(mutable emitter, "constant body", NODE)
    return ""
  }
  const startName = cachedDeclName(emitter.typeNames, "f", info.module, "const")
  startFunction(mutable emitter, body, startName)
  const constantType = Exprs.constType(emitter.checker, constIndex)
  const typeName = cachedCType(emitter.checker, emitter.typeNames, constantType)
  const variable = cachedDeclName(emitter.typeNames, "G", info.module, info.name)
  const getter = cachedDeclName(emitter.typeNames, "g", info.module, info.name)
  writeLine(mutable emitter, `static ${typeName} ${getter}(void) {`)
  emitter.indent++
  writeLine(mutable emitter, `if (!${variable}_ready) {`)
  emitter.indent++
  beginStatement(mutable emitter)
  // A computed constant is built from its value, not from its expression.
  let code = Code { text: "", owned: false }
  if (copy(ConstValues.findComputedValue(emitter, constIndex)) is Some(computed)) {
    code = ConstValues.writeValue(mutable emitter, computed, constantType)
  } else {
    code = EmitWalker.emitExpression(BodyWalker {}, mutable emitter, info.declaration.value)
  }
  const consumed = consume(mutable emitter, code.text, code.owned, constantType)
  writeLine(mutable emitter, `${variable} = ${consumed};`)
  writeLine(mutable emitter, `${variable}_ready = 1;`)
  endStatement(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, `return ${variable};`)
  emitter.indent--
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, "")
  return takeOutput(mutable emitter)
}

// FunctionFacts is what the emitter reads about one function of Go's Program.Funcs.
struct FunctionFacts {
  key: string
  result: Type
  pos: Pos
}

function describeFunction(
  checker: Checker,
  program: ProgramFunc,
): FunctionFacts from checker uses alloc {
  return match (program) {
    ProgramFunc.PlainFunc(funcIndex) => FunctionFacts {
      key: `func|${Int.toString(funcIndex)}`,
      result: checker.functions[funcIndex].result,
      pos: checker.functions[funcIndex].declaration.pos,
    }
    ProgramFunc.InstanceFunc(instance) => describeInstance(checker, instance)
    ProgramFunc.ImplFunc(block, index) => FunctionFacts {
      key: `impl|${Int.toString(block)}|${Int.toString(index)}`,
      result: checker.implementations[block].functions[index].result,
      pos: checker.implementations[block].functions[index].declaration.pos,
    }
  }
}

function describeInstance(checker: Checker, instance: int): FunctionFacts from checker uses alloc {
  const funcIndex = checker.instanceList[instance].funcIndex
  const declaration = checker.functions[funcIndex].declaration
  return FunctionFacts {
    key: `inst|${Int.toString(instance)}`,
    result: checker.instanceList[instance].result,
    pos: declaration.pos,
  }
}

function bodyBlock(checker: Checker, body: int): Option<Block> from checker {
  if (checker.bodies[body].root is BodyRoot.RootFunc(declaration)) {
    return declaration.body
  }
  return None
}

export function emitFunction(mutable emitter: Emitter, program: ProgramFunc): string uses alloc {
  const facts = copy(describeFunction(emitter.checker, program))
  const body = findBody(emitter.checker, facts.key)
  if (body < 0) {
    return `${reportUnsupported(mutable emitter, "function body", NODE)}\n`
  }
  const owner = cachedFunctionName(emitter.checker, emitter.typeNames, program)
  startFunction(mutable emitter, body, owner)
  emitter.resultType = facts.result
  const signature = functionSignature(emitter.checker, emitter.typeNames, program)
  if (emitter.checker.bodies[body].root is BodyRoot.RootFunc(generatorDeclaration)) {
    if (generatorDeclaration.generator) {
      if (generatorDeclaration.body is Some(generatorBody)) {
        return Generators.emitGenerator(
          BodyWalker {},
          mutable emitter,
          generatorDeclaration,
          generatorBody,
          facts.result,
          signature,
          owner,
        )
      }
    }
  }
  writeLine(mutable emitter, `${signature} {`)
  emitter.indent++
  const walker = BodyWalker {}
  let endReachable = true
  if (copy(bodyBlock(emitter.checker, body)) is Some(block)) {
    endReachable = hasReachableEnd(emitter.checker, emitter.body, block)
    // A function with a self tail call owns the parameters a jump replaces and has a jump target.
    emitter.tailProgram = Some(program)
    const tailCalls = copy(Tail.findTailCalls(emitter, program, block, facts.result == Type.TVoid))
    emitter.tailCalls = Tail.collectCallIds(tailCalls)
    if (Arrays.length(emitter.tailCalls) > 0) {
      Tail.openTailLoop(mutable emitter, program, tailCalls)
    }
    EmitWalker.emitBlockInScope(walker, mutable emitter, block)
  }
  emitter.tailProgram = None
  emitter.tailCalls = []
  unwindAll(mutable emitter)
  if (facts.result != Type.TVoid && endReachable) {
    const position = where(emitter, facts.pos)
    writeLine(
      mutable emitter,
      `narra_panic(${position}, "internal compiler error: function ended without returning a value");`,
    )
    const resultName = cachedCType(emitter.checker, emitter.typeNames, facts.result)
    writeLine(mutable emitter, `return (${resultName}){0};`)
  }
  emitter.indent--
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, "")
  return takeOutput(mutable emitter)
}

export function emitTestBody(
  mutable emitter: Emitter,
  number: int,
  module: string,
  moduleNumber: int,
): string uses alloc {
  const found = findBody(emitter.checker, `test|${module}|${Int.toString(moduleNumber)}`)
  if (found < 0) {
    return `${reportUnsupported(mutable emitter, "test body", NODE)}\n`
  }
  const testName = cachedDeclName(emitter.typeNames, "f", module, "test")
  startFunction(mutable emitter, found, testName)
  writeLine(mutable emitter, `static void test_${Int.toString(number)}(void) {`)
  emitter.indent++
  if (emitter.checker.bodies[found].root is BodyRoot.RootBlock(block)) {
    EmitWalker.emitBlockInScope(BodyWalker {}, mutable emitter, block)
  }
  unwindAll(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  return takeOutput(mutable emitter)
}
