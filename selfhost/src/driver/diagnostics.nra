// Long texts of `narrac explain`. A code without one prints its message format.
const EXPLANATIONS: Array<Explanation> = [
  Explanation {
    code: "E0001",
    text: "A block comment starts with `/*` and must end with `*/`. The file ended first.\nFix: add `*/` where the comment ends.",
  },
  Explanation {
    code: "E0002",
    text: "Single quotes write a `char`, which holds exactly one character. Text of any other length is a string.\nFix: use double quotes.\nExample: `'ab'` becomes `\"ab\"`.",
  },
  Explanation {
    code: "E0003",
    text: "Narra has no semicolons. A line break ends a statement.\nFix: delete the `;`.\nExample: `return 0;` becomes `return 0`.",
  },
  Explanation {
    code: "E0004",
    text: "This character cannot start any token, such as `\\` outside a string or a symbol Narra does not use.\nFix: delete the character, or put it inside a string or a comment.",
  },
  Explanation {
    code: "E0005",
    text: "A backslash in a string or character literal starts an escape, and the file ended right after it.\nFix: finish the escape, for example `\\n`, and close the literal.",
  },
  Explanation {
    code: "E0006",
    text: "A `\\u` escape writes its code point in braces.\nFix: `\"\\u0041\"` becomes `\"\\u{41}\"`.",
  },
  Explanation {
    code: "E0007",
    text: "A `\\u{...}` escape holds only hexadecimal digits and ends with `}`.\nFix: write the code point in hexadecimal, as in `\"\\u{1F600}\"`.",
  },
  Explanation {
    code: "E0008",
    text: "The character after the backslash is not an escape. The escapes are `\\n`, `\\t`, `\\r`, `\\0`, `\\\\`, `\\\"`, `\\'`, `` \\` ``, `\\$` and `\\u{...}`.\nFix: use one of these escapes, or write `\\\\` for a backslash.",
  },
  Explanation {
    code: "E0009",
    text: "A string or character literal must close on the line where it starts.\nFix: add the closing quote. For text over several lines, use `\\n` or a template string.",
  },
  Explanation {
    code: "E0010",
    text: "A template string starts with a backtick and must end with one. The file ended first.\nFix: add the closing backtick, and check that every `${` has its `}`.",
  },
  Explanation {
    code: "E0011",
    text: "The parser needs a particular symbol here, such as a closing parenthesis or brace, and found another token.\nFix: add the symbol the message names, or remove the extra token before it.\nExample: `(1 + 2` becomes `(1 + 2)`.",
  },
  Explanation {
    code: "E0012",
    text: "A name is needed here, for example after `const` or `function`. A keyword is not a name.\nFix: write a name, or rename a name that is a keyword.\nExample: `const if = 1` becomes `const cond = 1`.",
  },
  Explanation {
    code: "E0013",
    text: "A statement ends at a line break or a `}`. Another token follows the statement on the same line.\nFix: put the next statement on its own line.\nExample: `const x = 1 const y = 2` becomes two lines.",
  },
  Explanation {
    code: "E0014",
    text: "Imports name the module as a namespace or list the names. There is no default import.\nFix: `import X from \"std/int\"` becomes `import * as X from \"std/int\"`.",
  },
  Explanation {
    code: "E0015",
    text: "An import names its module with a string literal after `from`.\nFix: `from std/array` becomes `from \"std/array\"`.",
  },
  Explanation {
    code: "E0016",
    text: "An implement block cannot be exported. Other modules use it through the trait and the type.\nFix: remove `export` from the implement block, and export the trait and the type.",
  },
  Explanation {
    code: "E0017",
    text: "A test is run by the test runner and is never called from code, so it cannot be exported.\nFix: remove `export` before `test`.",
