// The narra.toml reader, ported from compiler/internal/narra/modules_toml.go.
// It reads the same subset of TOML: tables, arrays of tables, `key = value`
// with basic or literal strings and arrays of strings, and comments. Bytes
// are compared as in Go; whitespace is ASCII only (Str.trim).
import * as Str from "std/string"
import { quoteGo } from "narrac/parser"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export struct Binary {
  name: string
  entry: string // "cli.run": module path inside the package, then the function
}

export struct Manifest {
  name: string
  binaries: Array<Binary>
  libraries: Array<string>
  search: Array<string>
}

// An error of the loader. An empty file and line 0 print as a bare message
// (the Go error was not a diagnostic).
export struct LoadError {
  file: string
  line: int
  column: int
  message: string
}

enum Value {
  VStr(text: string)
  VList(items: Array<string>)
}

const QUOTE = 34
const APOSTROPHE = 39
const BACKSLASH = 92
const HASH = 35
const OPEN = 91
const CLOSE = 93
const COMMA = 44

function createError(line: int, message: string): LoadError {
  return LoadError { file: "narra.toml", line: line, column: 1, message: message }
}

// parseManifest reads the narra.toml keys the compiler uses: [package] name,
// [[binary]] name and entry, and [link] libraries and search.
export function parseManifest(text: string): Result<Manifest, LoadError> uses alloc {
  let name = ""
  let binaries: Array<Binary> = []
  let libraries: Array<string> = []
  let search: Array<string> = []
  let table = ""
  let inBinary = false
  let binaryName = ""
  let binaryEntry = ""
  const lines = Str.split(text, "\n")
  let index = 0
  while (index < Arrays.length(lines)) {
    const lineNumber = index + 1
    const line = Str.trim(stripComment(lines[index]))
    index = index + 1
    if (line == "") {
      continue
    }
    if (Str.startsWith(line, "[[")) {
      if (!Str.endsWith(line, "]]")) {
        return Err(createError(lineNumber, "expected `]]`"))
      }
      if (inBinary) {
        Arrays.push(mutable binaries, Binary { name: binaryName, entry: binaryEntry })
      }
      table = `[[${Str.trim(Str.slice(line, 2, Str.length(line) - 2))}]]`
      inBinary = table == "[[binary]]"
      binaryName = ""
      binaryEntry = ""
      continue
    }
    if (Str.startsWith(line, "[")) {
      if (!Str.endsWith(line, "]")) {
        return Err(createError(lineNumber, "expected `]`"))
      }
      if (inBinary) {
        Arrays.push(mutable binaries, Binary { name: binaryName, entry: binaryEntry })
        inBinary = false
      }
      table = Str.trim(Str.slice(line, 1, Str.length(line) - 1))
      if (table == "dependencies") {
        return Err(createError(lineNumber, "[dependencies] is not supported by this compiler yet"))
      }
      continue
    }
    const known = table == "package" || table == "link" || table == "[[binary]]"
    const equalsIndex = Str.indexOf(line, "=")
    if (equalsIndex is None) {
      if (!known) {
        continue
      }
      return Err(createError(lineNumber, "expected `key = value`"))
    }
    const equalsAt = equalsIndex.value
    const key = Str.trim(Str.slice(line, 0, equalsAt))
    let raw = Str.trim(Str.sliceFrom(line, equalsAt + 1))
    // An array may continue over several lines.
    while (Str.startsWith(raw, "[") && !isClosedArray(raw) && index < Arrays.length(lines)) {
      raw = `${raw} ${Str.trim(stripComment(lines[index]))}`
      index = index + 1
    }
    if (!known) {
      continue
    }
    const parsed = parseValue(raw)
    if (parsed is Err(error)) {
      return Err(createError(lineNumber, `${key}: ${error}`))
    }
    const value = parsed.value
    const qualifiedKey = `${table}.${key}`
    if (qualifiedKey == "package.name") {
      if (value is Value.VStr(packageName)) {
        if (isValidPackageName(packageName)) {
          if (packageName == "std") {
            return Err(createError(lineNumber, "package name \"std\" is reserved for the standard library"))
          }
          name = packageName
          continue
        }
      }
      return Err(createError(lineNumber, "package name must be a string of letters, digits and `_`, starting with a letter"))
    }
    if (qualifiedKey == "[[binary]].name" || qualifiedKey == "[[binary]].entry") {
      if (value is Value.VStr(stringValue)) {
        if (key == "name") {
          binaryName = stringValue
        } else {
          binaryEntry = stringValue
        }
        continue
      }
      return Err(createError(lineNumber, `${key} must be a string`))
    }
    if (qualifiedKey == "link.libraries" || qualifiedKey == "link.search") {
      if (value is Value.VList(items)) {
        if (key == "libraries") {
          libraries = items
        } else {
          search = items
        }
        continue
      }
      return Err(createError(lineNumber, `${key} must be an array of strings`))
    }
  }
  if (inBinary) {
    Arrays.push(mutable binaries, Binary { name: binaryName, entry: binaryEntry })
  }
  if (name == "") {
    return Err(createError(0, "[package] needs a name"))
  }
  let seen: Map<string, bool> = Map {}
  for (const binary of Arrays.values(binaries)) {
    if (binary.name == "" || binary.entry == "") {
      return Err(createError(0, "each [[binary]] needs a name and an entry such as \"cli.run\""))
    }
    if (seen[binary.name] is Some(_)) {
      return Err(createError(0, `two [[binary]] entries are named ${quoteGo(binary.name)}`))
    }
    seen[binary.name] = true
  }
  return Ok(Manifest { name: name, binaries: binaries, libraries: libraries, search: search })
}

function isValidPackageName(name: string): bool {
  const length = Str.length(name)
  if (length == 0 || !isLetter(Str.byteAt(name, 0))) {
    return false
  }
  for (const index of Ranges.between(0, length)) {
    const code = Str.byteAt(name, index)
    if (!(code == 95 || isLetter(code) || (code >= 48 && code <= 57))) {
      return false
    }
  }
  return true
}

function isLetter(code: int): bool {
  return (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
}

// stripComment removes a `#` comment that is not inside a string.
function stripComment(line: string): string uses alloc {
  let quote = 0
  let index = 0
  const length = Str.length(line)
  while (index < length) {
    const code = Str.byteAt(line, index)
    if (quote != 0) {
      if (code == BACKSLASH && quote == QUOTE) {
        index = index + 1
      } else if (code == quote) {
        quote = 0
      }
    } else if (code == QUOTE || code == APOSTROPHE) {
      quote = code
    } else if (code == HASH) {
      return Str.slice(line, 0, index)
    }
    index = index + 1
  }
  return line
}

// isClosedArray reports whether the brackets of an array value are balanced.
function isClosedArray(text: string): bool {
  let depth = 0
  let quote = 0
  let index = 0
  const length = Str.length(text)
  while (index < length) {
    const code = Str.byteAt(text, index)
    if (quote != 0) {
      if (code == BACKSLASH && quote == QUOTE) {
        index = index + 1
      } else if (code == quote) {
        quote = 0
      }
    } else if (code == QUOTE || code == APOSTROPHE) {
      quote = code
    } else if (code == OPEN) {
      depth = depth + 1
    } else if (code == CLOSE) {
      depth = depth - 1
    }
    index = index + 1
  }
  return depth == 0
}

// parseValue reads a string or an array of strings.
function parseValue(text: string): Result<Value, string> uses alloc {
  if (Str.startsWith(text, "[")) {
    let items: Array<string> = []
    let rest = Str.trim(Str.sliceFrom(text, 1))
    while (true) {
      if (Str.startsWith(rest, "]")) {
        if (Str.trim(Str.sliceFrom(rest, 1)) != "") {
          return Err("unexpected text after the array")
        }
        return Ok(Value.VList(items))
      }
      const parsed = parseString(rest)
      if (parsed is Err(error)) {
        return Err(error)
      }
      const #[item, consumed] = parsed.value
      Arrays.push(mutable items, item)
      rest = Str.trim(Str.sliceFrom(rest, consumed))
      if (Str.startsWith(rest, ",")) {
        rest = Str.trim(Str.sliceFrom(rest, 1))
      } else if (!Str.startsWith(rest, "]")) {
        return Err("expected `,` or `]` in the array")
      }
    }
  }
  const parsed = parseString(text)
  if (parsed is Err(error)) {
    return Err(error)
  }
  const #[item, consumed] = parsed.value
  if (Str.trim(Str.sliceFrom(text, consumed)) != "") {
    return Err("unexpected text after the string")
  }
  return Ok(Value.VStr(item))
}

// parseString reads a basic ("...") or literal ('...') string at the start
// of text and returns its value and length in bytes.
function parseString(text: string): Result<#[string, int], string> uses alloc {
  const length = Str.length(text)
  if (length == 0 || (Str.byteAt(text, 0) != QUOTE && Str.byteAt(text, 0) != APOSTROPHE)) {
    return Err("expected a string")
  }
  const quote = Str.byteAt(text, 0)
  let builder = Str.builder()
  let index = 1
  while (index < length) {
    const code = Str.byteAt(text, index)
    if (code == quote) {
      return Ok(#[Str.build(builder), index + 1])
    }
    if (code == BACKSLASH && quote == QUOTE && index + 1 < length) {
      index = index + 1
      const escaped = Str.byteAt(text, index)
      if (escaped == 110) {
        Str.append(mutable builder, "\n")
      } else if (escaped == 116) {
        Str.append(mutable builder, "\t")
      } else if (escaped == QUOTE || escaped == BACKSLASH) {
        Str.append(mutable builder, Str.slice(text, index, index + 1))
      } else {
        // Go prints %code of the byte; for a non-ASCII lead byte this is its
        // Latin-1 character, which the dump tests do not exercise.
        return Err(`unsupported escape \\${Str.slice(text, index, index + 1)}`)
      }
      index = index + 1
      continue
    }
    // Copy a whole character so multi-byte text stays valid.
    const next = Str.nextChar(text, index)
    Str.append(mutable builder, Str.slice(text, index, next))
    index = next
  }
  return Err("unterminated string")
}
