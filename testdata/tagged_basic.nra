// Tagged templates with decoded parts: escapes, empty parts, no holes and a
// function value as the tag.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"
import * as Str from "std/string"

function describe(parts: Array<string>, values: Array<string>): string {
  let quoted: Array<string> = []
  for (const part of Arrays.values(parts)) {
    Arrays.push(mutable quoted, `[${part}]`)
  }
  const partCount = Int.toString(Arrays.length(parts))
  const valueCount = Int.toString(Arrays.length(values))
  return `${partCount} parts ${Str.join(quoted, "")}, ${valueCount} values ${Str.join(values, ",")}`
}

function mark(parts: Array<string>, values: Array<string>): string {
  let builder = Str.builder()
  for (const index of Ranges.upTo(Arrays.length(parts))) {
    Str.append(mutable builder, parts[index])
    if (index < Arrays.length(values)) {
      Str.append(mutable builder, `<${values[index]}>`)
    }
  }
  return Str.build(builder)
}

export function run(_args: Array<string>): int {
  const name = "narra"
  print(describe`a${name}b`)
  print(describe`${name}`)
  print(describe`x`)
  print(describe``)
  print(describe`line\none\ttab \`tick\` \${not}`)
  print(describe`${name}${name}`)
  print(mark`hello ${name}, from ${"c"}!`)
  const tag = mark
  print(tag`value ${Int.toString(42)} end`)
  return 0
}
