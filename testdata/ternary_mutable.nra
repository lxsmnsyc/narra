// The two branches of a ternary never run together, so a `mutable` use in
// one branch and a read in the other is legal.
import * as Int from "std/int"

struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = counter.n + 10
  return 5
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  const first = x.n > 0 ? bump(mutable x) : x.n
  print(`${Int.toString(first)} ${Int.toString(x.n)}`)
  const y = Counter { n: 1 }
  const second = x.n < 0 ? bump(mutable y) : y.n
  print(`${Int.toString(second)} ${Int.toString(y.n)}`)
  return 0
}
