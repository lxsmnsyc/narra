// The C runtime of a std module. The text of each runtime file is generated into
// a module of its own (runtimecore.nra, runtimestdfs.nra, ...) from
// selfhost/runtime; this file is written by hand and picks the text by module
// path. A new selfhost/runtime/std_NAME.c adds its import and one case here.
import { RUNTIME_STD_ASYNC } from "narrac/runtime/runtimestdasync"
import { RUNTIME_STD_ASYNC_LOOP } from "narrac/runtime/runtimestdasyncloop"
import { RUNTIME_STD_ASYNC_IO } from "narrac/runtime/runtimestdasyncio"
import { RUNTIME_STD_BYTES } from "narrac/runtime/runtimestdbytes"
import { RUNTIME_STD_CLOCK } from "narrac/runtime/runtimestdclock"
import { RUNTIME_STD_ENTROPY } from "narrac/runtime/runtimestdentropy"
import { RUNTIME_STD_ENV } from "narrac/runtime/runtimestdenv"
import { RUNTIME_STD_FS } from "narrac/runtime/runtimestdfs"
import { RUNTIME_STD_HOST } from "narrac/runtime/runtimestdhost"
import { RUNTIME_STD_INT } from "narrac/runtime/runtimestdint"
import { RUNTIME_STD_IO } from "narrac/runtime/runtimestdio"
import { RUNTIME_STD_PATH } from "narrac/runtime/runtimestdpath"
import { RUNTIME_STD_SIGNAL } from "narrac/runtime/runtimestdsignal"
import { RUNTIME_STD_SIZED } from "narrac/runtime/runtimestdsized"
import { RUNTIME_STD_PROCESS } from "narrac/runtime/runtimestdprocess"
import { RUNTIME_STD_TERMINAL } from "narrac/runtime/runtimestdterminal"
import { RUNTIME_STD_STRING } from "narrac/runtime/runtimestdstring"
import { RUNTIME_STD_TEST } from "narrac/runtime/runtimestdtest"
import { RUNTIME_STD_THREAD } from "narrac/runtime/runtimestdthread"

export function runtimeFor(path: string): string uses alloc {
  // The tasks, then the loop that runs them (D109 item 3).
  if (path == "std/internal/async") {
    return `${RUNTIME_STD_ASYNC}\n${RUNTIME_STD_ASYNC_LOOP}`
  }
  if (path == "std/internal/signal") {
    return RUNTIME_STD_SIGNAL
  }
  if (path == "std/internal/asyncio") {
    return RUNTIME_STD_ASYNC_IO
  }
  if (path == "std/bytes") {
    return RUNTIME_STD_BYTES
  }
  if (path == "std/internal/clock") {
    return RUNTIME_STD_CLOCK
  }
  if (path == "std/internal/terminal") {
    return RUNTIME_STD_TERMINAL
  }
  if (path == "std/internal/entropy") {
    return RUNTIME_STD_ENTROPY
  }
  if (path == "std/internal/host") {
    return RUNTIME_STD_HOST
  }
  if (path == "std/env") {
    return RUNTIME_STD_ENV
  }
  if (path == "std/fs") {
    return RUNTIME_STD_FS
  }
  if (path == "std/int") {
    return RUNTIME_STD_INT
  }
  if (path == "std/io") {
    return RUNTIME_STD_IO
  }
  if (path == "std/path") {
    return RUNTIME_STD_PATH
  }
  if (path == "std/process") {
    return RUNTIME_STD_PROCESS
  }
  if (path == "std/internal/sized") {
    return RUNTIME_STD_SIZED
  }
  if (path == "std/string") {
    return RUNTIME_STD_STRING
  }
  if (path == "std/test") {
    return RUNTIME_STD_TEST
  }
  if (path == "std/internal/thread") {
    return RUNTIME_STD_THREAD
  }
  // A module with no runtime gives "".
  return ""
}
