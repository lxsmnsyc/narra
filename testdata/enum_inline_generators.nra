// Generators that hold inline enums with counted fields across a yield, and
// generators dropped while suspended with such a value in their frame.
import * as Str from "std/string"
import * as Arrays from "std/array"

enum Step {
  Say(text: string, extra: Array<string>)
  Wait(count: int)
}

function* steps(count: int): Generator<Step> {
  for (let i = 0; i < count; i++) {
    // The local is held across both yields.
    const step = Step.Say(repeatString("s", i + 1), [repeatString("e", 2)])
    yield Step.Wait(i)
    yield step
  }
}

function* names(source: Array<Option<string>>): Generator<string> {
  let options = source
  for (const option of options) {
    options = []
    match (option) {
      Some(text) => {
        yield text
        yield repeatString(text, 2)
      }
      None => {
        yield "none"
      }
    }
  }
}

function* results(): Generator<Result<string, string>> {
  let current: Result<string, string> = Ok(repeatString("a", 3))
  yield current
  const previous = current
  current = Err(repeatString("b", 3))
  yield current
  yield previous
}

function show(step: Step): string {
  return match (step) {
    Step.Say(text, extra) => `${text}:${Str.join(extra, ",")}`
    Step.Wait(_) => "wait"
  }
}

export function run(args: Array<string>): int {
  let seen: Array<string> = []
  for (const step of steps(3)) {
    Arrays.push(mutable seen, show(step))
  }
  print(Str.join(seen, " "))

  seen = []
  for (const text of names([Some(repeatString("x", 2)), None, Some("y")])) {
    Arrays.push(mutable seen, text)
  }
  print(Str.join(seen, " "))

  for (const result of results()) {
    print(Show.show(result))
  }

  // Dropped while suspended, holding an inline value in the frame.
  for (const step of steps(2)) {
    print(show(step))
    break
  }
  for (const text of names([Some(repeatString("z", 2))])) {
    print(text)
    break
  }
  for (const result of results()) {
    print(Show.show(result))
    break
  }
  return 0
}

function repeatString(text: string, count: int): string uses alloc {
  return match (Str.repeat(text, count)) { Some(repeated) => repeated, None => "" }
}
