// error: match does not cover Some(Circle(_, false)), Some(Square(_)); add the cases
enum Shape {
  Circle(radius: int, filled: bool)
  Square(side: int)
}

function f(s: Option<Shape>): int {
  return match (s) {
    None => 0
    Some(Shape.Circle(r, true)) => r
  }
}

export function run(args: Array<string>): int {
  return f(None)
}
