import * as Int from "std/int"

function divmod(a: int, b: int): Tuple<int, int> {
  return [a / b, a % b]
}

function swap<A, B>(t: Tuple<A, B>): Tuple<B, A> {
  const [a, b] = t
  return [b, a]
}

function first<A, B>(t: Tuple<A, B>): A {
  const [a, _] = t
  return a
}

function label(t: Tuple<string, Option<int>>): string {
  return match (t) {
    [name, None] => `${name}: none`
    [name, Some(0)] => `${name}: zero`
    [name, Some(n)] => `${name}: ${Int.toString(n)}`
  }
}

function both(t: Tuple<bool, bool>): string {
  return match (t) {
    [true, true] => "both"
    [false, false] => "neither"
    [true, false] => "left"
    [false, true] => "right"
  }
}

export function run(args: Array<string>): int {
  const [quotient, remainder] = divmod(17, 5)
  print(`${Int.toString(quotient)} ${Int.toString(remainder)}`)

  const named: Tuple<string, Array<string>> = ["list", ["a", "b"]]
  const [name, items] = named
  print(`${name} ${items[1]}`)

  const swapped = swap(Tuple("word", 3))
  const [n, w] = swapped
  print(`${Int.toString(n)} ${w}`)
  print(first(named))

  print(label(["a", None]))
  print(label(["b", Some(0)]))
  print(label(["c", Some(7)]))
  print(both([true, false]))
  print(both([false, false]))

  const nested: Tuple<Tuple<int, string>, string> = [[1, "inner"], "outer"]
  const [[one, inner], outer] = nested
  print(`${Int.toString(one)} ${inner} ${outer}`)

  print(Show.show(nested))
  if (Tuple(1, "x") == Tuple(1, "x")) {
    print("equal")
  }
  if (divmod(7, 2) != divmod(9, 2)) {
    print("different")
  }
  const ord = Ordered.compare(Tuple(1, "b"), Tuple(1, "a"))
  print(Show.show(ord))
  let pairs: Array<Tuple<string, int>> = []
  Array.push(mutable pairs, ["x", 1])
  Array.push(mutable pairs, Tuple("y", 2))
  for (const p of Array.values(pairs)) {
    const [k, v] = p
    print(`${k}=${Int.toString(v)}`)
  }
  return 0
}
