enum Shape {
  Circle(radius: int)
  Square(side: int)
}

enum Flag {
  Yes(count: int)
  No(reason: string)
}

function _direct(shape: Shape): int {
  if (shape is Shape.Circle(radius)) {
    return radius + shape.radius
  }
  return shape.side
}

function _branches(shape: Shape): int {
  if (shape is Shape.Circle(_)) {
    return shape.radius
  } else {
    return shape.side
  }
}

function _early(shape: Shape): int {
  if (shape is Shape.Square(_)) {
    return 0
  }
  return shape.radius
}

function _partial(flag: Flag): int {
  if (flag is Flag.Yes(1)) {
    return 1
  }
  return 0
}

function _option(maybe: Option<int>): int {
  if (maybe is Some(value)) {
    return value
  }
  return 0
}

function _result(outcome: Result<int, string>): int {
  if (outcome is Err(_message)) {
    return 0
  }
  return outcome.value
}

function _plainTest(shape: Shape): bool {
  return shape is Shape.Circle(_)
}
