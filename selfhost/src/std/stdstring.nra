  StdFunc {
    name: "Str.startsWith",
    module: "std/string",
    key: "startsWith",
    parameters: ["string", "string"],
    parameterNames: ["text", "prefix"],
    result: "bool",
    doc: "Tells whether the text starts with `prefix`.",
