import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"

struct Point {
  x: int
  y: int
}

struct Named {
  name: string
  point: Point
}

export function run(args: Array<string>): int {
  // Arrays.entries gives #[index, item]
  const words = ["a", "bc", "def"]
  for (const #[index, word] of Arrays.entries(words)) {
    print(`${Int.toString(index)}=${word}`)
  }

  // an array of tuples
  const pairs = [#[1, "one"], #[2, "two"]]
  for (const #[number, label] of Arrays.values(pairs)) {
    print(`${Int.toString(number)}:${label}`)
  }

  // a nested tuple, with a wildcard
  const nested = [#[1, #[2, "x"]], #[3, #[4, "y"]]]
  for (const #[first, #[second, text]] of Arrays.values(nested)) {
    print(`${Int.toString(first + second)}${text}`)
  }
  for (const #[_, #[_, text]] of Arrays.values(nested)) {
    print(text)
  }

  // index and a struct item
  const points = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
  for (const #[index, { x, y }] of Arrays.entries(points)) {
    print(Int.toString(index * 100 + x * 10 + y))
  }

  // struct heads, with a renamed field
  for (const { x, y: height } of Arrays.values(points)) {
    print(Int.toString(x + height))
  }
  const named = [Named { name: "p", point: Point { x: 5, y: 6 } }]
  for (const { name, point: { x, y } } of Arrays.values(named)) {
    print(`${name}${Int.toString(x)}${Int.toString(y)}`)
  }

  // map entries
  let scores: Map<string, int> = Map {}
  scores["a"] = 7
  for (const #[key, value] of Maps.entries(scores)) {
    print(`${key}->${Int.toString(value)}`)
  }

  // let heads can be changed in the body
  let total = 0
  for (let #[index, item] of Arrays.entries([10, 20, 30])) {
    item = item + index
    total = total + item
  }
  print(Int.toString(total))
  for (let counter of Ranges.upTo(2)) {
    counter = counter * 5
    print(Int.toString(counter))
  }

  // a loop inside a loop
  for (const #[outer, row] of Arrays.entries([[1, 2], [3]])) {
    for (const #[column, cell] of Arrays.entries(row)) {
      print(Int.toString(outer * 100 + column * 10 + cell))
    }
  }
  return 0
}
