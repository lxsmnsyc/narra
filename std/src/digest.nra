// std/digest: SHA-256 and SHA-1 (FIPS 180-4), HMAC (RFC 2104) and PBKDF2-HMAC-SHA-256 (RFC 8018).
// Written in Narra with 32-bit wrapping arithmetic. It is not a cryptography library: there are
// no ciphers or signatures, and `equal` is the only constant-time operation.

import * as Arrays from "std/array"
import * as Bytes from "std/bytes"
import * as Ranges from "std/range"
import * as U8 from "std/u8"
import * as U32 from "std/u32"

const BLOCK_SIZE = 64
const SHA256_SIZE = 32

const SHA256_INITIAL: Array<u32> = [
  0x6a09e667,
  0xbb67ae85,
  0x3c6ef372,
  0xa54ff53a,
  0x510e527f,
  0x9b05688c,
  0x1f83d9ab,
  0x5be0cd19,
]

const SHA1_INITIAL: Array<u32> = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]

const SHA256_ROUND_CONSTANTS: Array<u32> = [
  0x428a2f98,
  0x71374491,
  0xb5c0fbcf,
  0xe9b5dba5,
  0x3956c25b,
  0x59f111f1,
  0x923f82a4,
  0xab1c5ed5,
  0xd807aa98,
  0x12835b01,
  0x243185be,
  0x550c7dc3,
  0x72be5d74,
  0x80deb1fe,
  0x9bdc06a7,
  0xc19bf174,
  0xe49b69c1,
  0xefbe4786,
  0x0fc19dc6,
  0x240ca1cc,
  0x2de92c6f,
  0x4a7484aa,
  0x5cb0a9dc,
  0x76f988da,
  0x983e5152,
  0xa831c66d,
  0xb00327c8,
  0xbf597fc7,
  0xc6e00bf3,
  0xd5a79147,
  0x06ca6351,
  0x14292967,
  0x27b70a85,
  0x2e1b2138,
  0x4d2c6dfc,
  0x53380d13,
  0x650a7354,
  0x766a0abb,
  0x81c2c92e,
  0x92722c85,
  0xa2bfe8a1,
  0xa81a664b,
  0xc24b8b70,
  0xc76c51a3,
  0xd192e819,
  0xd6990624,
  0xf40e3585,
  0x106aa070,
  0x19a4c116,
  0x1e376c08,
  0x2748774c,
  0x34b0bcb5,
  0x391c0cb3,
  0x4ed8aa4a,
  0x5b9cca4f,
  0x682e6ff3,
  0x748f82ee,
  0x78a5636f,
  0x84c87814,
  0x8cc70208,
  0x90befffa,
  0xa4506ceb,
  0xbef9a3f7,
  0xc67178f2,
]

/// The hash functions this module computes.
export enum Algorithm derives Show, Equatable {
  Sha256
  Sha1
}

/// A hash in progress. Make one with `create`, feed it with `update` and read the digest with
/// `finish`. Its fields are internal. Copy it with `copy(hasher)` to continue two inputs from a shared prefix.
export opaque struct Hasher {
  algorithm: Algorithm
  state: Array<u32>
  pending: Array<u8>
  schedule: Array<u32>
  length: int
}

struct MacKey {
  inner: Hasher
  outer: Hasher
}

/// Starts a hash of the given algorithm over empty input.
export function create(algorithm: Algorithm): Hasher uses alloc {
  const state = match (algorithm) {
    Algorithm.Sha256 => copy(SHA256_INITIAL)
    Algorithm.Sha1 => copy(SHA1_INITIAL)
  }
  const words = match (algorithm) { Algorithm.Sha256 => 64, Algorithm.Sha1 => 80 }
  let schedule: Array<u32> = []
  for (const _index of Ranges.upTo(words)) {
    Arrays.push(mutable schedule, 0)
  }
  return Hasher { algorithm: algorithm, state: state, pending: [], schedule: schedule, length: 0 }
}

/// Adds bytes to the hash. Calling it with the parts of a message in order gives the same digest
/// as one call with the whole message, whatever the sizes of the parts.
export function update(mutable hasher: Hasher, data: bytes) uses alloc {
  const total = Bytes.length(data)
  hasher.length += total
  let position = 0
  // Top up a partly filled block first.
  if (Arrays.length(hasher.pending) > 0) {
    while (position < total && Arrays.length(hasher.pending) < BLOCK_SIZE) {
      Arrays.push(mutable hasher.pending, readByte(data, position))
      position++
    }
    if (Arrays.length(hasher.pending) == BLOCK_SIZE) {
      loadPendingBlock(mutable hasher)
      compress(mutable hasher)
      Arrays.truncate(mutable hasher.pending, 0)
    }
  }
  // Hash whole blocks straight from the input.
  while (position + BLOCK_SIZE <= total) {
    loadInputBlock(mutable hasher, data, position)
    compress(mutable hasher)
    position += BLOCK_SIZE
  }
  // Keep the tail for the next call.
  while (position < total) {
    Arrays.push(mutable hasher.pending, readByte(data, position))
    position++
  }
}

/// Gives the digest of everything fed so far: 32 bytes for SHA-256, 20 for SHA-1. The hasher is
/// not changed, so it can take more input afterwards.
export function finish(hasher: Hasher): bytes uses alloc {
  let work = copy(hasher)
  const bitLength = hasher.length * 8
  // Padding is 0x80, zeros up to 56 bytes into a block, and the bit length as 8 big-endian bytes.
  let padding: Array<u8> = [0x80]
  const filled = (hasher.length + 1) % BLOCK_SIZE
  let zeros = 56 - filled
  if (zeros < 0) {
    zeros += BLOCK_SIZE
  }
  for (const _index of Ranges.upTo(zeros)) {
    Arrays.push(mutable padding, 0)
  }
  for (const index of Ranges.upTo(8)) {
    // The stage 2 compile needs the count checked against 0 and 63 first.
    const shift = 56 - 8 * index
    if (shift >= 0 && shift < 64) {
      Arrays.push(mutable padding, U8.wrap(bitLength >> shift))
    }
  }
  update(mutable work, Bytes.fromArray(padding))
  let output: Array<u8> = []
  for (const word of Arrays.values(work.state)) {
    Arrays.push(mutable output, U8.wrap(word >> 24))
    Arrays.push(mutable output, U8.wrap(word >> 16))
    Arrays.push(mutable output, U8.wrap(word >> 8))
    Arrays.push(mutable output, U8.wrap(word))
  }
  return Bytes.fromArray(output)
}

/// Gives the SHA-256 digest (32 bytes) of the data.
export function sha256(data: bytes): bytes uses alloc {
  let hasher = create(Algorithm.Sha256)
  update(mutable hasher, data)
  return finish(hasher)
}

/// Gives the SHA-1 digest (20 bytes) of the data. SHA-1 is broken for signatures; use it only
/// where a protocol demands it, such as the WebSocket handshake.
export function sha1(data: bytes): bytes uses alloc {
  let hasher = create(Algorithm.Sha1)
  update(mutable hasher, data)
  return finish(hasher)
}

/// Gives the HMAC (RFC 2104) of the message under the key, with the given hash.
export function hmac(algorithm: Algorithm, key: bytes, message: bytes): bytes uses alloc {
  const macKey = makeMacKey(algorithm, key)
  return computeMac(macKey, message)
}

/// Derives `length` bytes from a password with PBKDF2-HMAC-SHA-256 (RFC 8018). Gives `None` when
/// `iterations` is below 1, `length` is negative, or `length` is above 32 times 2^32 - 1.
export function pbkdf2Sha256(
  password: bytes,
  salt: bytes,
  iterations: int,
  length: int,
): Option<bytes> uses alloc {
  if (iterations < 1 || length < 0 || length > 0xffffffff * SHA256_SIZE) {
    return None
  }
  const macKey = makeMacKey(Algorithm.Sha256, password)
  let output: Array<u8> = []
  let blockIndex = 1
  while (Arrays.length(output) < length) {
    // U1 is the MAC of the salt and the block number; each later U is the MAC of the one before.
    let seed: Array<u8> = Bytes.toArray(salt)
    Arrays.push(mutable seed, U8.wrap(blockIndex >> 24))
    Arrays.push(mutable seed, U8.wrap(blockIndex >> 16))
    Arrays.push(mutable seed, U8.wrap(blockIndex >> 8))
    Arrays.push(mutable seed, U8.wrap(blockIndex))
    let current = computeMac(macKey, Bytes.fromArray(seed))
    let block = Bytes.toArray(current)
    for (const _round of Ranges.between(1, iterations)) {
      current = computeMac(macKey, current)
      const next = Bytes.toArray(current)
      for (const position of Ranges.upTo(SHA256_SIZE)) {
        block[position] = block[position] ^ next[position]
      }
    }
    for (const byte of Arrays.values(block)) {
      Arrays.push(mutable output, byte)
    }
    blockIndex++
  }
  Arrays.truncate(mutable output, length)
  return Some(Bytes.fromArray(output))
}

/// Tells whether two digests are equal. For equal lengths the loop has no early exit, so it is
/// meant to take the same time wherever the digests differ; the language does not promise constant
/// time in the generated C. Digests of different lengths are not equal.
export function equal(first: bytes, second: bytes): bool {
  const length = Bytes.length(first)
  if (length != Bytes.length(second)) {
    return false
  }
  let difference: u8 = 0
  for (const index of Ranges.upTo(length)) {
    difference = difference | (readByte(first, index) ^ readByte(second, index))
  }
  return difference == 0
}

function readByte(data: bytes, index: int): u8 {
  if (Bytes.at(data, index) is Some(byte)) {
    return byte
  }
  return 0
}

function makeMacKey(algorithm: Algorithm, key: bytes): MacKey uses alloc {
  // A key longer than the block is replaced by its digest, then padded with zeros to a block.
  let keyBytes = key
  if (Bytes.length(key) > BLOCK_SIZE) {
    let keyHasher = create(algorithm)
    update(mutable keyHasher, key)
    keyBytes = finish(keyHasher)
  }
  let inner: Array<u8> = []
  let outer: Array<u8> = []
  for (const index of Ranges.upTo(BLOCK_SIZE)) {
    const keyByte = readByte(keyBytes, index)
    Arrays.push(mutable inner, keyByte ^ 0x36)
    Arrays.push(mutable outer, keyByte ^ 0x5c)
  }
  let innerHasher = create(algorithm)
  update(mutable innerHasher, Bytes.fromArray(inner))
  let outerHasher = create(algorithm)
  update(mutable outerHasher, Bytes.fromArray(outer))
  return MacKey { inner: innerHasher, outer: outerHasher }
}

function computeMac(key: MacKey, message: bytes): bytes uses alloc {
  let innerHasher = copy(key.inner)
  update(mutable innerHasher, message)
  const innerDigest = finish(innerHasher)
  let outerHasher = copy(key.outer)
  update(mutable outerHasher, innerDigest)
  return finish(outerHasher)
}

function loadInputBlock(mutable hasher: Hasher, data: bytes, offset: int) {
  for (const index of Ranges.upTo(16)) {
    const start = offset + 4 * index
    hasher.schedule[index] =
      (U32.from(readByte(data, start)) << 24) |
        (U32.from(readByte(data, start + 1)) << 16) |
        (U32.from(readByte(data, start + 2)) << 8) |
        U32.from(readByte(data, start + 3))
  }
}

function loadPendingBlock(mutable hasher: Hasher) {
  for (const index of Ranges.upTo(16)) {
    const start = 4 * index
    hasher.schedule[index] =
      (U32.from(hasher.pending[start]) << 24) |
        (U32.from(hasher.pending[start + 1]) << 16) |
        (U32.from(hasher.pending[start + 2]) << 8) |
        U32.from(hasher.pending[start + 3])
  }
}

function compress(mutable hasher: Hasher) {
  match (hasher.algorithm) {
    Algorithm.Sha256 => compressSha256(mutable hasher)
    Algorithm.Sha1 => compressSha1(mutable hasher)
  }
}

function compressSha256(mutable hasher: Hasher) {
  for (const index of Ranges.between(16, 64)) {
    const early = hasher.schedule[index - 15]
    const late = hasher.schedule[index - 2]
    const sigma0 = ((early >> 7) | (early << 25)) ^ ((early >> 18) | (early << 14)) ^ (early >> 3)
    const sigma1 = ((late >> 17) | (late << 15)) ^ ((late >> 19) | (late << 13)) ^ (late >> 10)
    hasher.schedule[index] =
      hasher.schedule[index - 16] + sigma0 + hasher.schedule[index - 7] + sigma1
  }
  // The working variables a to h are named as in FIPS 180-4.
  let a = hasher.state[0]
  let b = hasher.state[1]
  let c = hasher.state[2]
  let d = hasher.state[3]
  let e = hasher.state[4]
  let f = hasher.state[5]
  let g = hasher.state[6]
  let h = hasher.state[7]
  for (const index of Ranges.upTo(64)) {
    const sum1 = ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7))
    const choice = (e & f) ^ (~e & g)
    const first = h + sum1 + choice + SHA256_ROUND_CONSTANTS[index] + hasher.schedule[index]
    const sum0 = ((a >> 2) | (a << 30)) ^ ((a >> 13) | (a << 19)) ^ ((a >> 22) | (a << 10))
    const majority = (a & b) ^ (a & c) ^ (b & c)
    const second = sum0 + majority
    h = g
    g = f
    f = e
    e = d + first
    d = c
    c = b
    b = a
    a = first + second
  }
  hasher.state[0] += a
  hasher.state[1] += b
  hasher.state[2] += c
  hasher.state[3] += d
  hasher.state[4] += e
  hasher.state[5] += f
  hasher.state[6] += g
  hasher.state[7] += h
}

function compressSha1(mutable hasher: Hasher) {
  for (const index of Ranges.between(16, 80)) {
    const mixed =
      hasher.schedule[index - 3] ^
        hasher.schedule[index - 8] ^
        hasher.schedule[index - 14] ^
        hasher.schedule[index - 16]
    hasher.schedule[index] = (mixed << 1) | (mixed >> 31)
  }
  // The working variables a to e are named as in FIPS 180-4.
  let a = hasher.state[0]
  let b = hasher.state[1]
  let c = hasher.state[2]
  let d = hasher.state[3]
  let e = hasher.state[4]
  for (const index of Ranges.upTo(80)) {
    let mixer: u32 = 0
    let constant: u32 = 0
    if (index < 20) {
      mixer = (b & c) | (~b & d)
      constant = 0x5a827999
    } else if (index < 40) {
      mixer = b ^ c ^ d
      constant = 0x6ed9eba1
    } else if (index < 60) {
      mixer = (b & c) | (b & d) | (c & d)
      constant = 0x8f1bbcdc
    } else {
      mixer = b ^ c ^ d
      constant = 0xca62c1d6
    }
    const rotated = (a << 5) | (a >> 27)
    const next = rotated + mixer + e + constant + hasher.schedule[index]
    e = d
    d = c
    c = (b << 30) | (b >> 2)
    b = a
    a = next
  }
  hasher.state[0] += a
  hasher.state[1] += b
  hasher.state[2] += c
  hasher.state[3] += d
  hasher.state[4] += e
}
