// The types dump: the format of compiler/internal/narra/typesdump.go (the
// doc comment there is the authority), printed from the side tables of each
// checked body (Checker.bodies, D70). `narrac types <path>` prints it.
//
// Each block walks its body's syntax in the order of idcheck.nra and prints
// one line per node with the type and the resolution its body recorded by
// node id, and a `local` line where a node declares a local.
import * as Int from "std/int"
import * as Str from "std/string"
import { Pos, Expr, Stmt, Block, Param, Pattern, MatchArm } from "narrac/ast"
import { quoteDump } from "narrac/modules"
import { Type } from "narrac/types"
import { Checker, BodyInfo, BodyRoot, Ref, findBodySlot } from "narrac/check"
import { dumpTypeString } from "narrac/declsdump"
import * as Arrays from "std/array"

export function dump(checker: Checker): string uses alloc {
  let out = Str.builder()
  for (const body of Arrays.values(checker.bodies)) {
    // The header names the body; an instance adds its type arguments.
    Str.append(mutable out, `body module=${quoteDump(body.module)} ${body.kind} ${body.name}`)
    if (Arrays.length(body.targs) > 0) {
      let parts: Array<string> = []
      for (const typeArgument of Arrays.values(body.targs)) {
        Arrays.push(mutable parts, dumpTypeString(checker, typeArgument))
      }
      Str.append(mutable out, ` targs=${Str.join(parts, ",")}`)
    }
    Str.append(mutable out, "\n")

    // Then the nodes, parameters first.
    match (body.root) {
      BodyRoot.RootFunc(decl) => {
        writeParams(mutable out, checker, body, decl.params)
        if (decl.body is Some(block)) {
          writeBlock(mutable out, checker, body, block)
        }
      }
      BodyRoot.RootBlock(block) => writeBlock(mutable out, checker, body, block)
      BodyRoot.RootExpr(expression) => writeExpression(mutable out, checker, body, expression)
    }
  }
  return Str.build(out)
}

function describeNodeType(checker: Checker, bodyInfo: BodyInfo, nodeId: int): string uses alloc {
  const slot = findBodySlot(bodyInfo, nodeId)
  if (slot >= 0) {
    if (bodyInfo.types[slot] is Some(nodeType)) {
      return dumpTypeString(checker, nodeType)
    }
  }
  return "-"
}

function qualifiedName(module: string, name: string): string uses alloc {
  if (module == "") {
    return name
  }
  return `${module}.${name}`
}

// describeRef prints the resolution attribute of a node, with its leading
// space, or "".
function describeRef(checker: Checker, bodyInfo: BodyInfo, nodeId: int): string uses alloc {
  const slot = findBodySlot(bodyInfo, nodeId)
  if (slot < 0) {
    return ""
  }
  return match (bodyInfo.refs[slot]) {
    Ref.Unresolved => ""
    Ref.Local(index) => ` local=${bodyInfo.locals[index].name}`
    Ref.Const(index) => ` const=${qualifiedName(checker.consts[index].module, checker.consts[index].name)}`
    Ref.Function(index) => ` func=${qualifiedName(checker.funcs[index].module, checker.funcs[index].name)}`
    Ref.Builtin(index) => ` builtin=${checker.registry.funcs[index].name}`
    Ref.Constructor(enumIndex, variant) => ` ctor=${checker.enums[enumIndex].name}.${checker.enums[enumIndex].variants[variant].name}`
    Ref.Implementation(block, index) => ` func=${describeImplementation(checker, block, index)}`
    Ref.TraitFunction(traitIndex, name) => ` trait=${checker.traits[traitIndex].name}.${name}`
    Ref.Distinct(index) => ` distinct=${qualifiedName(checker.distincts[index].module, checker.distincts[index].name)}`
    Ref.Narrow(enumIndex, variantIndex) => ` narrow=${checker.enums[enumIndex].variants[variantIndex].name}`
  }
}

// describeImplementation names an implement block function as
// <Type>.<Trait>.<function>, the type written as in the decls dump.
function describeImplementation(checker: Checker, block: int, index: int): string uses alloc {
  const impl = checker.impls[block]
  return `${dumpTypeString(checker, impl.forType)}.${checker.traits[impl.traitIdx].name}.${impl.funcs[index].name}`
}

function writeNode(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, nodeId: int, pos: Pos, kind: string) uses alloc {
  const attrs = describeRef(checker, bodyInfo, nodeId)
  const text = describeNodeType(checker, bodyInfo, nodeId)
  Str.append(mutable out, `  ${Int.toString(pos.line)}:${Int.toString(pos.col)} ${kind}${attrs} ${text}\n`)
}

// writeLocal prints the local a node declares, if any.
function writeLocal(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, nodeId: int) uses alloc {
  const slot = findBodySlot(bodyInfo, nodeId)
  if (slot < 0 || bodyInfo.declared[slot] < 0) {
    return
  }
  const local = bodyInfo.locals[bodyInfo.declared[slot]]
  let flag = ""
  if (local.isMutable) {
    flag = " mutable"
  }
  const text = dumpTypeString(checker, local.localType)
  Str.append(mutable out, `  ${Int.toString(local.pos.line)}:${Int.toString(local.pos.col)} local ${local.name}${flag} ${text}\n`)
}

function writeParams(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, params: Array<Param>) uses alloc {
  for (const param of Arrays.values(params)) {
    writeLocal(mutable out, checker, bodyInfo, param.id)
  }
}

function writeBlock(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, block: Block) uses alloc {
  for (const statement of Arrays.values(block.stmts)) {
    writeStatement(mutable out, checker, bodyInfo, statement)
  }
}

function writeStatement(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, statement: Stmt) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => writeBlock(mutable out, checker, bodyInfo, block)
    Stmt.VarStmt(nodeId, _, _, _, pattern, _, value) => {
      writeLocal(mutable out, checker, bodyInfo, nodeId)
      if (pattern is Some(declaredPattern)) {
        writePattern(mutable out, checker, bodyInfo, declaredPattern)
      }
      writeExpression(mutable out, checker, bodyInfo, value)
    }
    Stmt.AssignStmt(_, target, value) => {
      writeExpression(mutable out, checker, bodyInfo, target)
      writeExpression(mutable out, checker, bodyInfo, value)
    }
    Stmt.ExprStmt(_, expression) => writeExpression(mutable out, checker, bodyInfo, expression)
    Stmt.ReturnStmt(_, value) => {
      if (value is Some(expression)) {
        writeExpression(mutable out, checker, bodyInfo, expression)
      }
    }
    Stmt.IfStmt(_, condition, then, orElse) => {
      writeExpression(mutable out, checker, bodyInfo, condition)
      writeBlock(mutable out, checker, bodyInfo, then)
      if (orElse is Some(other)) {
        writeStatement(mutable out, checker, bodyInfo, other)
      }
    }
    Stmt.WhileStmt(_, condition, body) => {
      writeExpression(mutable out, checker, bodyInfo, condition)
      writeBlock(mutable out, checker, bodyInfo, body)
    }
    Stmt.ForStmt(nodeId, _, _, iterable, body) => {
      writeLocal(mutable out, checker, bodyInfo, nodeId)
      writeExpression(mutable out, checker, bodyInfo, iterable)
      writeBlock(mutable out, checker, bodyInfo, body)
    }
    Stmt.BreakStmt(_) => {}
    Stmt.ContinueStmt(_) => {}
  }
}

function writeExpressions(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, expressions: Array<Expr>) uses alloc {
  for (const expression of Arrays.values(expressions)) {
    writeExpression(mutable out, checker, bodyInfo, expression)
  }
}

function writeExpression(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, expression: Expr) uses alloc {
  match (expression) {
    Expr.IntLit(nodeId, pos, _) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "int")
    Expr.FloatLit(nodeId, pos, _) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "float")
    Expr.StringLit(nodeId, pos, _, _) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "string")
    Expr.CharLit(nodeId, pos, _) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "char")
    Expr.BoolLit(nodeId, pos, _) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "bool")
    Expr.TemplateLit(nodeId, pos, parts) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "template")
      writeExpressions(mutable out, checker, bodyInfo, parts)
    }
    Expr.Ident(nodeId, pos, _) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "ident")
    Expr.FieldExpr(nodeId, pos, target, _) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "field-expr")
      writeExpression(mutable out, checker, bodyInfo, target)
    }
    Expr.IsExpr(nodeId, pos, subject, pattern) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "is")
      writeExpression(mutable out, checker, bodyInfo, subject)
      writePattern(mutable out, checker, bodyInfo, pattern)
    }
    Expr.IndexExpr(nodeId, pos, target, index) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "index")
      writeExpression(mutable out, checker, bodyInfo, target)
      writeExpression(mutable out, checker, bodyInfo, index)
    }
    Expr.MapLit(nodeId, pos, _, keys, values) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "map")
      writeExpressions(mutable out, checker, bodyInfo, keys)
      writeExpressions(mutable out, checker, bodyInfo, values)
    }
    Expr.CallExpr(nodeId, pos, callee, args) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "call")
      writeExpression(mutable out, checker, bodyInfo, callee)
      for (const arg of Arrays.values(args)) {
        writeExpression(mutable out, checker, bodyInfo, arg.value)
      }
    }
    Expr.UnaryExpr(nodeId, pos, _, operand) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "unary")
      writeExpression(mutable out, checker, bodyInfo, operand)
    }
    Expr.BinaryExpr(nodeId, pos, _, left, right) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "binary")
      writeExpression(mutable out, checker, bodyInfo, left)
      writeExpression(mutable out, checker, bodyInfo, right)
    }
    Expr.StructLit(nodeId, pos, _, _, fields, spread) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "structlit")
      for (const field of Arrays.values(fields)) {
        writeExpression(mutable out, checker, bodyInfo, field.value)
      }
      if (spread is Some(spreadExpression)) {
        writeExpression(mutable out, checker, bodyInfo, spreadExpression)
      }
    }
    Expr.ArrayLit(nodeId, pos, elements, _) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "array")
      writeExpressions(mutable out, checker, bodyInfo, elements)
    }
    Expr.MatchExpr(nodeId, pos, subject, arms) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "match")
      writeExpression(mutable out, checker, bodyInfo, subject)
      for (const arm of Arrays.values(arms)) {
        writeArm(mutable out, checker, bodyInfo, arm)
      }
    }
    Expr.ArrowExpr(nodeId, pos, params, _, body, block) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "arrow")
      writeParams(mutable out, checker, bodyInfo, params)
      if (body is Some(expressionBody)) {
        writeExpression(mutable out, checker, bodyInfo, expressionBody)
      }
      if (block is Some(blockBody)) {
        writeBlock(mutable out, checker, bodyInfo, blockBody)
      }
    }
  }
}

function writeArm(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, arm: MatchArm) uses alloc {
  writePattern(mutable out, checker, bodyInfo, arm.pattern)
  if (arm.guard is Some(guard)) {
    writeExpression(mutable out, checker, bodyInfo, guard)
  }
  if (arm.body is Some(body)) {
    writeExpression(mutable out, checker, bodyInfo, body)
  }
  if (arm.block is Some(block)) {
    writeBlock(mutable out, checker, bodyInfo, block)
  }
}

function writePattern(mutable out: StringBuilder, checker: Checker, bodyInfo: BodyInfo, pattern: Pattern) uses alloc {
  match (pattern) {
    Pattern.PatWildcard(nodeId, pos) => writeNode(mutable out, checker, bodyInfo, nodeId, pos, "pat-wildcard")
    Pattern.PatName(nodeId, pos, _) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "pat-name")
      writeLocal(mutable out, checker, bodyInfo, nodeId)
    }
    Pattern.PatCtor(nodeId, pos, _, _, args, _) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "pat-ctor")
      for (const arg of Arrays.values(args)) {
        writePattern(mutable out, checker, bodyInfo, arg)
      }
    }
    Pattern.PatStruct(nodeId, pos, fields) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "pat-struct")
      for (const field of Arrays.values(fields)) {
        writePattern(mutable out, checker, bodyInfo, field.pattern)
      }
    }
    Pattern.PatTuple(nodeId, pos, args) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "pat-tuple")
      for (const arg of Arrays.values(args)) {
        writePattern(mutable out, checker, bodyInfo, arg)
      }
    }
    Pattern.PatLit(nodeId, pos, literal) => {
      writeNode(mutable out, checker, bodyInfo, nodeId, pos, "pat-lit")
      writeExpression(mutable out, checker, bodyInfo, literal)
    }
  }
}
