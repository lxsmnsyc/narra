// The registry rows and emitters of std/io.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Pos, Arg } from "narrac/ast"
import { cType } from "narrac/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  writeLine,
  temp,
  ownedTemp,
  readNodeType,
} from "narrac/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  stringOut,
  findVariant,
  variantFieldType,
  ioResult,
} from "narrac/stdemithelp"
import * as Arrays from "std/array"
import * as Decls from "narrac/emitdecls"

export const IO_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Io.flush",
    module: "std/io",
    key: "flush",
    result: "void",
    effects: ["io"],
  },
  StdFunc {
    name: "Io.readAll",
    module: "std/io",
    key: "readAll",
    result: "Result<string, string>",
    effects: ["io", "alloc"],
    check: "fixed",
  },
  StdFunc {
    name: "Io.readBytes",
    module: "std/io",
    key: "readBytes",
    parameters: ["int"],
    result: "Result<string, string>",
    effects: ["io", "alloc"],
    check: "fixed",
  },
  StdFunc {
    name: "Io.readLine",
    module: "std/io",
    key: "readLine",
    result: "Result<Option<string>, string>",
    effects: ["io", "alloc"],
    check: "fixed",
  },
  StdFunc {
    name: "Io.write",
    module: "std/io",
    key: "write",
    parameters: ["string"],
    result: "void",
    effects: ["io"],
  },
  StdFunc {
    name: "Io.writeError",
    module: "std/io",
    key: "writeError",
    parameters: ["string"],
    result: "void",
    effects: ["io"],
  },
]

const IO_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Io.write",
    call: "narra_io_write",
    withPos: false,
    owned: false,
    temporary: false,
  },
  FixedCall {
    name: "Io.writeError",
    call: "narra_io_write_error",
    withPos: false,
    owned: false,
    temporary: false,
  },
  FixedCall {
    name: "Io.flush",
    call: "narra_io_flush",
    withPos: false,
    owned: false,
    temporary: false,
  },
]

function emitReadLine(mutable emitter: Emitter, nodeId: int): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const okVariant = findVariant(emitter, resultType, "Ok")
  const errorVariant = findVariant(emitter, resultType, "Err")
  const optionType = variantFieldType(emitter, resultType, okVariant)
  const some = findVariant(emitter, optionType, "Some")
  const none = findVariant(emitter, optionType, "None")
  const line = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const success = temp(mutable emitter, Type.TBool, `narra_io_read_line(&${line}, &${bad})`)
  const resultName = cType(emitter.checker, resultType)
  const result = ownedTemp(mutable emitter, resultType, `((${resultName}){0})`)
  writeLine(mutable emitter, `if (${success}) {`)
  emitter.indent = emitter.indent + 1
  // The Option moves into Ok, so it is a plain temporary.
  const optionName = cType(emitter.checker, optionType)
  const option = temp(mutable emitter, optionType, `((${optionName}){0})`)
  writeLine(mutable emitter, `if (${line}) {`)
  emitter.indent = emitter.indent + 1
  const someCode = Decls.enumAllocation(mutable emitter, optionType, some, [line])
  writeLine(mutable emitter, `${option} = ${someCode.text};`)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "} else {")
  emitter.indent = emitter.indent + 1
  const noneCode = Decls.enumAllocation(mutable emitter, optionType, none, [])
  writeLine(mutable emitter, `${option} = ${noneCode.text};`)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
  const okCode = Decls.enumAllocation(mutable emitter, resultType, okVariant, [option])
  writeLine(mutable emitter, `${result} = ${okCode.text};`)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "} else {")
  emitter.indent = emitter.indent + 1
  const errorCode = Decls.enumAllocation(mutable emitter, resultType, errorVariant, [bad])
  writeLine(mutable emitter, `${result} = ${errorCode.text};`)
  emitter.indent = emitter.indent - 1
  writeLine(mutable emitter, "}")
  return owned(result)
}

function emitReadBytes<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const count = argumentText(walker, mutable emitter, arguments, 0)
  const output = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const success = temp(
    mutable emitter,
    Type.TBool,
    `narra_io_read_exact(${count}, &${output}, &${bad})`,
  )
  return ioResult(mutable emitter, resultType, success, output, bad)
}

function emitReadAll(mutable emitter: Emitter, nodeId: int): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const output = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const success = temp(mutable emitter, Type.TBool, `narra_io_read_all(&${output}, &${bad})`)
  return ioResult(mutable emitter, resultType, success, output, bad)
}

export function emitIoCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(IO_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Io.readLine") {
    return emitReadLine(mutable emitter, nodeId)
  }
  if (name == "Io.readBytes") {
    return emitReadBytes(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Io.readAll") {
    return emitReadAll(mutable emitter, nodeId)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
