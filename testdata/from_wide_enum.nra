// A wide recursive enum passed beside a `mutable` array: the shared-result
// check walks each type once, so checking stays fast however many fields
// refer back to the enum.
import * as Arrays from "std/array"
import * as Int from "std/int"

enum Node {
  Leaf(value: int)
  Pair(left: Node, right: Node)
  Triple(first: Node, second: Node, third: Node)
  Quad(a: Node, b: Node, c: Node, d: Node)
  Five(a: Node, b: Node, c: Node, d: Node, e: Node)
  Six(a: Node, b: Node, c: Node, d: Node, e: Node, f: Node)
  Seven(a: Node, b: Node, c: Node, d: Node, e: Node, f: Node, g: Node)
  Many(items: Array<Node>, extra: Option<Node>)
}

function keep(mutable nodes: Array<Node>, node: Node) {
  Arrays.push(mutable nodes, node)
}

function collect(root: Node): Array<Node> from root {
  let nodes: Array<Node> = []
  keep(mutable nodes, root)
  keep(mutable nodes, Node.Pair(root, root))
  keep(mutable nodes, Node.Triple(root, root, root))
  keep(mutable nodes, Node.Quad(root, root, root, root))
  keep(mutable nodes, Node.Five(root, root, root, root, root))
  keep(mutable nodes, Node.Six(root, root, root, root, root, root))
  keep(mutable nodes, Node.Seven(root, root, root, root, root, root, root))
  keep(mutable nodes, Node.Many([root], Some(root)))
  return nodes
}

export function run(_args: Array<string>): int {
  const nodes = collect(Node.Leaf(1))
  print(Int.toString(Arrays.length(nodes)))
  return 0
}
