// error: @inline function countDown calls itself (countDown -> countDown); an @inline function cannot be recursive
@inline
export function countDown<T>(value: T, count: int): int {
  if (count == 0) {
    return 0
  }
  return countDown(value, count - 1)
}

export function run(_args: Array<string>): int {
  return 0
}
