// The packages suite: each folder in testdata/packages with a run.out is a
// package with one binary. It runs in debug mode (sanitizers and leak check)
// and in release mode and must print run.out; its test blocks run in debug
// mode and must report `N passed, 0 failed`. The packages in
// testdata/packages/errors belong to the errors suite.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Str from "std/string"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"
import * as Files from "testrunner/files"

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  const folder = Path.join(context.testdata, "packages")
  for (const path of Arrays.values(Files.listPaths(folder, ""))) {
    if (Fs.exists(Path.join(path, "run.out"))) {
      for (const variant of Arrays.values(["debug", "release", "tests"])) {
        Arrays.push(mutable cases, TestCase {
          suite: "packages",
          name: `${Path.basename(path)}/${variant}`,
          path: path,
          variant: variant,
        })
      }
    }
  }
  return cases
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  if (testCase.variant == "tests") {
    const tested = Common.runNarrac(context, ["test", "-sanitize", testCase.path])
    if (tested.code != 0 || !Str.contains(tested.output, " passed, 0 failed")) {
      return Err(`want exit code 0 and " passed, 0 failed", got ${Common.describeRun(tested)}`)
    }
    return Ok(true)
  }
  const want = Common.readExpected(Path.join(testCase.path, "run.out"))
  if (want is Err(message)) {
    return Err(message)
  }
  let flag = "-sanitize"
  if (testCase.variant == "release") {
    flag = "-release"
  }
  const result = Common.runNarrac(context, ["run", flag, testCase.path])
  return Common.expectRun(result, 0, want.value)
}
