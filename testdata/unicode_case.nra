// Case mapping and folding in std/unicode: full mappings, the final sigma
// rule, ASCII and empty strings.
import * as Unicode from "std/unicode"

function show(label: string, text: string) uses io, alloc {
  print(`${label}: [${text}]`)
}

export function run(args: Array<string>): int uses io, alloc {
  // Sharp s has a full upper case mapping of two letters.
  show("upper strasse", Unicode.toUpperCase("stra\u{df}e"))
  print(`upper is STRASSE: ${Show.show(Unicode.toUpperCase("stra\u{df}e") == "STRASSE")}`)
  show("upper ligature", Unicode.toUpperCase("\u{fb03}x"))
  show("upper greek", Unicode.toUpperCase("\u{3b1}\u{3b2}\u{3b3} \u{390}"))
  show("upper cyrillic", Unicode.toUpperCase("\u{43f}\u{440}\u{438}\u{432}\u{435}\u{442}"))

  // A capital sigma at the end of a word lowers to the final form.
  const sigmas = Unicode.toLowerCase("\u{3a3}\u{391}\u{3a3}")
  show("lower sigma word", sigmas)
  print(`ends with final sigma: ${Show.show(sigmas == "\u{3c3}\u{3b1}\u{3c2}")}`)
  show("lower lone sigma", Unicode.toLowerCase("\u{3a3}"))
  show("lower sigma before word", Unicode.toLowerCase("\u{391}\u{3a3} \u{391}\u{3a3}\u{391}"))
  show("lower sigma before apostrophe", Unicode.toLowerCase("\u{391}\u{3a3}'"))
  // A modifier letter is cased and case-ignorable; it is skipped, as ICU and V8 do.
  show("lower sigma before modifier", Unicode.toLowerCase("\u{391}\u{3a3}\u{2b0}"))
  show("lower sigma after modifier", Unicode.toLowerCase("\u{2b0}\u{3a3}"))
  show("lower sigma between modifiers", Unicode.toLowerCase("\u{391}\u{2b0}\u{3a3}\u{2b0}\u{391}"))
  show("lower dotted capital i", Unicode.toLowerCase("\u{130}"))
  show("lower title digraph", Unicode.toLowerCase("\u{1c5}"))

  // Folding compares without case.
  const folded = Unicode.foldCase("Stra\u{df}e")
  show("fold Strasse", folded)
  print(`fold equal: ${Show.show(folded == Unicode.foldCase("STRASSE"))}`)
  print(`fold kelvin: ${Show.show(Unicode.foldCase("\u{212a}") == Unicode.foldCase("k"))}`)
  show("fold greek", Unicode.foldCase("\u{3a3}\u{3c2}\u{3c3}"))

  // ASCII, mixed and empty strings.
  show("upper ascii", Unicode.toUpperCase("Hello, World 42!"))
  show("lower ascii", Unicode.toLowerCase("Hello, World 42!"))
  show("fold ascii", Unicode.foldCase("Hello, World 42!"))
  show("upper mixed", Unicode.toUpperCase("caf\u{e9} na\u{ef}ve"))
  show("upper empty", Unicode.toUpperCase(""))
  show("lower empty", Unicode.toLowerCase(""))
  show("fold empty", Unicode.foldCase(""))
  show("upper unchanged", Unicode.toUpperCase("\u{4e2d}\u{6587} 123"))
  return 0
}
