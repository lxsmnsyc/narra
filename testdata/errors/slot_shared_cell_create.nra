// error: Arrays.push(mutable items, ...) may change items, which the cell cell still holds; take a copy where it is shared, with copy(...)
import * as Arrays from "std/array"
import * as Cells from "std/cell"

export function run(_args: Array<string>): int {
  let items = [1, 2, 3]
  const cell = Cells.create(items)
  Arrays.push(mutable items, 4)
  return Arrays.length(Cells.get(cell))
}
