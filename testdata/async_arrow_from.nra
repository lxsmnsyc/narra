// An async arrow follows the from rules of a plain arrow: a value that shares
// a parameter names it with from, and a write to what await gave takes a
// copy(...) while the argument is still used.
import * as Arrays from "std/array"
import * as Int from "std/int"

export async function run(_args: Array<string>): int {
  const items = [1, 2]
  const keep = async (xs: Array<int>): Array<int> from xs => xs
  const plain = (xs: Array<int>): Array<int> from xs => xs
  let got = copy(await keep(items))
  Arrays.push(mutable got, 3)
  let other = copy(plain(items))
  Arrays.push(mutable other, 4)
  print(`${Int.toString(Arrays.length(items))} ${Int.toString(got[2])} ${Int.toString(other[2])}`)
  return 0
}
