extname(.bashrc) = 
extname(index.) = .
extname(a.b/) = .b
extname(/a/b.nra) = .nra
extname(a/b.tar.gz) = .gz
extname(/) = 
extname() = 
extname(..) = 
extname(a.) = .
extname(a/.b.c) = .c
extname(a//b.x//) = .x
basename(.bashrc) = .bashrc
basename(a.b/) = a.b
basename(/a/b.nra) = b.nra
basename(/) = 
basename() = 
basename(a//b//) = b
dirname(.bashrc) = .
dirname(a.b/) = .
dirname(/a/b.nra) = /a
dirname(a/b.tar.gz) = a
dirname(/) = /
dirname() = .
dirname(/a) = /
dirname(//a) = //
dirname(a//b/) = a/
dirname(/a/b/) = /a
join(a, /b) = a/b
join(a/, b) = a/b
join(a, ../b) = b
join(, ) = .
join(/, a) = /a
join(a, ./b/) = a/b/
join(.., a) = ../a
join(a, ../..) = ..
join(/a, ../..) = /
join(a/b, ..) = a
join(a, ../) = ./
join(, x) = x
join(x, ) = x
join(a//b, c/./d) = a/b/c/d
join(../.., x) = ../../x
join(a/.., ..) = ..
