// A function* assigned to a binding or parameter with an annotated function type.
import * as Int from "std/int"

function* count(limit: int): Generator<int> {
  yield limit
  yield limit + 1
}

function* noisy(limit: int): Generator<int> {
  print("start")
  yield limit
}

const topLevel: (limit: int) => Generator<int> = count

function show(make: (limit: int) => Generator<int>, limit: int) {
  for (const value of make(limit)) {
    print(Int.toString(value))
  }
}

export function run(args: Array<string>): int {
  const local: (limit: int) => Generator<int> = count
  for (const value of topLevel(2)) {
    print(Int.toString(value))
  }
  for (const value of local(5)) {
    print(Int.toString(value))
  }
  show(count, 8)
  // A generator with an effect needs the effect on the annotated type
  const withEffect: (limit: int) => Generator<int> uses io = noisy
  for (const value of withEffect(7)) {
    print(Int.toString(value))
  }
  return 0
}
