enum Kind {
  None
  Sized(size: int)
  Named(name: string, flag: bool)
}

struct Shape {
  kind: Kind = Kind.None
  sized: Kind = Kind.Sized(4)
  named: Kind = Kind.Named("box", true)
  extra: Option<Kind> = Some(Kind.Sized(-1))
  id: int = 0
}

function describe(kind: Kind): string uses alloc {
  return match (kind) {
    Kind.None => "none"
    Kind.Sized(size) => `sized ${Show.show(size)}`
    Kind.Named(name, flag) => `named ${name} ${Show.show(flag)}`
  }
}

function describeExtra(extra: Option<Kind>): string uses alloc {
  return match (extra) { Some(kind) => describe(kind), None => "no extra" }
}

export function run(_args: Array<string>): int uses io, alloc {
  const plain: Shape = { id: 1 }
  const changed: Shape = { kind: Kind.Sized(9), id: 2 }
  print(
    `${describe(plain.kind)} ${describe(plain.sized)} ${describe(plain.named)} ${describeExtra(plain.extra)} ${Show.show(plain.id)}`,
  )
  print(
    `${describe(changed.kind)} ${describe(changed.sized)} ${describeExtra(changed.extra)} ${Show.show(changed.id)}`,
  )
  return 0
}
