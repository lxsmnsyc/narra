import { sumEvens } from "task/numbers"
import * as Test from "std/test"

test "mixed numbers" {
  Test.eq(sumEvens([1, 2, 3, 4]), 6)
}

test "empty array" {
  Test.eq(sumEvens([]), 0)
}

test "negative numbers" {
  Test.eq(sumEvens([-2, 3, -4]), -6)
}

test "no even number" {
  Test.eq(sumEvens([1, 3, 5]), 0)
}
