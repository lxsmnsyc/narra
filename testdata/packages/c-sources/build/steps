# A package with C files named by `from` (wrapper), a package with a [c] table (tables), and a third
# that uses both. NARRA_C_LOG makes the build print a line for each C file it compiles; the first
# build is the debug build with no sanitizer.
0 :: run app :: value=7 scale=3 && depth 3 && limit 65 && system matches && compiled wrapper/wrap.c && compiled wrapper/c/depth.c && compiled tables/c/lib/api.c && compiled tables/c/lib/system.c
# A second build compiles no C file.
0 :: run app :: limit 65 && !compiled
# Editing the header that api.c includes compiles api.c again and no other file.
write :: tables/c/inc2/tables_limit.h :: #define TABLES_LIMIT 2\n
0 :: run app :: limit 66 && compiled tables/c/lib/api.c && !compiled tables/c/lib/system.c && !compiled wrapper
0 :: run app :: limit 66 && !compiled
# A header added to an earlier include folder hides the one in a later folder, so it counts.
write :: tables/c/inc1/tables_limit.h :: #define TABLES_LIMIT 5\n
0 :: run app :: limit 69 && compiled tables/c/lib/api.c && !compiled wrapper
0 :: run app :: limit 69 && !compiled
# The sanitizer and release builds use other flags, so they compile the files again.
0 :: run -sanitize app :: value=7 scale=3 && depth 3 && limit 69 && system matches && compiled wrapper/wrap.c
0 :: run -release app :: value=7 scale=3 && depth 3 && limit 69 && system matches && compiled wrapper/wrap.c
