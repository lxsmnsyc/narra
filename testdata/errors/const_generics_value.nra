// error: cannot tell constant parameter N of share here; a function with a constant parameter cannot be a value
import * as Arrays from "std/array"

struct Vector<const N: int> {
  values: Array<f64>
}

function share<const N: int>(total: int): int {
  return total / N
}

export function run(_args: Array<string>): int {
  const divide: (int) => int = share
  const empty = Vector { values: [] }
  return divide(4) + Arrays.length(empty.values)
}
