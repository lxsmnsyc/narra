import * as Int from "std/int"

function sum(items: Array<int>): int {
  let total = 0
  for (const x of Array.values(items)) {
    total = total + x
  }
  return total
}

function addAll(mutable items: Array<int>, extra: Array<int>) {
  for (const x of Array.values(extra)) {
    Array.push(mutable items, x)
  }
}

export function run(args: Array<string>): int {
  let a: Array<int> = [1, 2, 3]
  const b = a
  Array.push(mutable a, 4)
  a[0] = 10
  print(`${Int.toString(sum(a))} ${Int.toString(sum(b))}`)
  let squares = Array.filled(0, 5)
  for (const i of Range.upTo(5)) {
    squares[i] = i * i
  }
  print(Int.toString(sum(squares)))
  addAll(mutable a, squares)
  print(Int.toString(Array.length(a)))
  let words: Array<string> = []
  for (const i of Range.between(1, 4)) {
    Array.push(mutable words, `w${Int.toString(i)}`)
  }
  let grid: Array<Array<string>> = [words, words]
  grid[1][0] = "changed"
  print(`${grid[0][0]} ${grid[1][0]} ${words[0]}`)
  for (const w of Array.values(words)) {
    if (w == "w2") {
      break
    }
    print(w)
  }
  return 0
}
