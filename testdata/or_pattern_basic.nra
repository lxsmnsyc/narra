import * as Int from "std/int"

enum Token {
  Plus
  Minus
  Star
  Number(value: int)
}

enum Shape {
  Circle(radius: int)
  Sphere(radius: int)
  Square(side: int)
}

function describe(token: Token): string {
  return match (token) {
    Token.Plus | Token.Minus => "additive"
    Token.Star => "multiplicative"
    Token.Number(_) => "number"
  }
}

function measure(shape: Shape): int {
  return match (shape) {
    Shape.Circle(size) | Shape.Sphere(size) => size * 2
    Shape.Square(size) => size
  }
}

function classify(option: Option<int>): string {
  return match (option) {
    Some(1 | 2) => "small"
    Some(3) | None => "three or none"
    Some(_) => "other"
  }
}

function pick(number: int): string {
  return match (number) { 1 | 2 | 3 => "low", 4 | 5 => "mid", _ => "high" }
}

function guarded(shape: Shape): string {
  return match (shape) {
    Shape.Circle(size) | Shape.Sphere(size) if (size > 5) => "big round"
    Shape.Circle(_) | Shape.Sphere(_) => "round"
    Shape.Square(_) => "square"
  }
}

function words(text: string): int {
  return match (text) { "a" | "b" => 1, "c" => 2, _ => 0 }
}

function sum(pair: #[Option<int>, Option<int>]): int {
  return match (pair) {
    #[Some(left), None] | #[None, Some(left)] => left
    #[Some(left), Some(_)] => left
    #[None, None] => 0
  }
}

function roundText(shape: Shape): string {
  match (shape) {
    Shape.Circle(size) | Shape.Sphere(size) => {
      return `round ${Int.toString(size)}`
    }
    _ => {}
  }
  return "other"
}

export function run(args: Array<string>): int {
  print(describe(Token.Plus))
  print(describe(Token.Minus))
  print(describe(Token.Star))
  print(describe(Token.Number(1)))
  print(Int.toString(measure(Shape.Circle(3))))
  print(Int.toString(measure(Shape.Sphere(4))))
  print(Int.toString(measure(Shape.Square(5))))
  print(classify(Some(1)))
  print(classify(Some(2)))
  print(classify(Some(3)))
  print(classify(None))
  print(classify(Some(9)))
  print(pick(2))
  print(pick(5))
  print(pick(9))
  print(guarded(Shape.Circle(9)))
  print(guarded(Shape.Sphere(2)))
  print(guarded(Shape.Square(2)))
  print(Int.toString(words("b")))
  print(Int.toString(sum(#[None, Some(7)])))
  print(Int.toString(sum(#[Some(8), None])))
  print(roundText(Shape.Sphere(6)))
  print(roundText(Shape.Square(1)))
  return 0
}
