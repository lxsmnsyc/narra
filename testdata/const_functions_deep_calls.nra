// 999 nested calls, each with six nested additions: inside both the call limit
// and the nesting limit of the evaluator.
import * as Int from "std/int"

@const
function depth(count: int): int {
  if (count == 0) {
    return 0
  }
  return 1 + (1 + (1 + (1 + (1 + (1 + depth(count - 1))))))
}

const DEEP = depth(999)

export function run(args: Array<string>): int uses io, alloc {
  const count = 999
  print(`${Int.toString(DEEP)} ${Int.toString(depth(count))}`)
  return 0
}
