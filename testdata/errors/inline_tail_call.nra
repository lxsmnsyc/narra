// error: @inline function sumTo calls itself (sumTo -> sumTo); an @inline function cannot be recursive
@inline
function sumTo(value: int, total: int): int {
  if (value == 0) {
    return total
  }
  return sumTo(value - 1, total + value)
}

export function run(_args: Array<string>): int {
  return sumTo(3, 0) - 6
}
