{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "The Narra website: the language guide, the installation guide and the specification",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "check:grammar": "node scripts/check-grammar.ts",
    "build": "pnpm check:grammar && vite build --outDir dist/client && vite build --ssr src/server.ts --outDir dist/server",
    "preview": "node scripts/preview.ts",
    "typecheck": "brumate-tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@twinkleplop/bash": "0.1.7",
    "@twinkleplop/core": "0.3.1",
    "@twinkleplop/json": "0.1.7",
    "@twinkleplop/markdown-it": "0.1.7",
    "@twinkleplop/theme-github": "0.2.4",
    "@twinkleplop/typescript": "0.1.7",
    "brumate": "0.7.2",
    "markdown-it": "14.1.0"
  },
  "devDependencies": {
    "@brumate/tsc": "0.1.17",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  }
}
