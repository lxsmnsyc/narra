// Loops that run but never reach their write make no copy of a shared array:
// only a write on every pass is hoisted. The copy check reports nothing.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  const missing = Arrays.length(args) - 1
  let guarded = filledArray(0, 4)
  const guardedOriginal = copy(guarded)
  for (const g of Ranges.upTo(4)) {
    if (g >= 10 + missing) {
      guarded[g] = 1
    }
  }
  let broken = filledArray(0, 4)
  const brokenOriginal = copy(broken)
  for (const b of Ranges.upTo(4)) {
    if (b >= 0) {
      break
    }
    broken[b] = 1
  }
  let skipped = filledArray(0, 4)
  const skippedOriginal = copy(skipped)
  let position = 0
  while (position < 4) {
    position++
    if (position > 0) {
      continue
    }
    skipped[position] = 1
  }
  let stepped = filledArray(0, 4)
  const steppedOriginal = copy(stepped)
  for (let index = 0; index < 4; index++) {
    if (index >= 0) {
      break
    }
    stepped[index] += 1
  }
  print(
    `${Int.toString(guarded[0])} ${Int.toString(guardedOriginal[0])} ${Int.toString(broken[0])} ${Int.toString(brokenOriginal[0])} ${Int.toString(skipped[0])} ${Int.toString(skippedOriginal[0])} ${Int.toString(stepped[0])} ${Int.toString(steppedOriginal[0])}`,
  )
  return 0
}

function filledArray<T>(value: T, count: int): Array<T> uses alloc {
  return match (Arrays.filled(value, count)) { Some(items) => items, None => [] }
}
