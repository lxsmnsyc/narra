<script>
  import { $props } from 'brumate/signals';
  import { chapters } from '../pages.ts';
  import type { Page } from '../pages.ts';
  import Meta from './Meta.brm';

  // A document of the site: the chapters of the guide in a sidebar when `slug` names one, the
  // page, its outline, and the links to the chapters before and after it.
  const { page, path, slug } = $props<{ page: Page; path: string; slug?: string }>();
  function findIndex(): number {
    for (const [at, chapter] of chapters.entries()) {
      if (chapter.slug === slug) {
        return at;
      }
    }
    return -1;
  }
  const index = findIndex();
  const previous = index > 0 ? chapters[index - 1] : undefined;
  const next = index !== -1 ? chapters[index + 1] : undefined;
  const hasSidebar = slug !== undefined;
  // `SPEC.md` has a heading for each rule, so its outline shows the sections only.
  const outline: Page['headings'] = [];
  for (const heading of page.headings) {
    if (heading.level === 2 || (heading.level === 3 && path !== 'spec')) {
      outline.push(heading);
    }
  }
  const title = page.title === 'The Narra guide' ? 'Guide | Narra' : `${page.title} | Narra`;
</script>

<Meta {title} description=page.description {path} />
<div class={ docs: true, 'no-sidebar': !hasSidebar }>
  #if (hasSidebar) {
    <details class="menu">
      <summary>
        Chapters
        <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
    </details>
    <nav class="sidebar" aria-label="Chapters">
      <p class="sidebar-title">Guide</p>
      <a href="/guide" aria-current=(slug === '' ? 'page' : undefined)>Overview</a>
      #for (chapter of chapters by chapter.slug) {
        <a href=(`/guide/${chapter.slug}`) aria-current=(chapter.slug === slug ? 'page' : undefined)>{chapter.title}</a>
      }
    </nav>
  }
  <article class="prose">
    {page.html}
    #if (previous || next) {
      <nav class="pager" aria-label="Chapters">
        #if (previous) {
          <a class="previous" href=(`/guide/${previous.slug}`)><small>Previous</small>{previous.title}</a>
        }
        #if (next) {
          <a class="next" href=(`/guide/${next.slug}`)><small>Next</small>{next.title}</a>
        }
      </nav>
    }
  </article>
  <nav class="toc" aria-label="On this page">
    #if (outline.length > 0) {
      <p class="toc-title">On this page</p>
      #for (heading of outline by heading.id) {
        <a href=(`#${heading.id}`) class={ 'level-3': heading.level === 3 }>{heading.text}</a>
      }
    }
  </nav>
</div>
