// A compound assignment whose index holds a closure with a block body.
function apply(change: (value: int) => int uses io): int uses io {
  return change(0)
}

export function run(args: Array<string>): int uses io, alloc {
  const items = [5, 5]
  items[apply((value: int): int => {
    print("in")
    return value
  })] += 1
  items[1]++
  print(Show.show(items))
  return 0
}
