// Statements and blocks (emit_stmt.go, emit.go block and blockInScope).
// The owner is selfhost-emit-bodies. Statements that open and close the owned
// temporaries of their expressions do so here, as in Go, before and after
// the call into a feature module.
import { substring } from "narrac/textops"
import * as Int from "std/int"
import { Pos, Stmt, Block, Expr, Pattern, LoopReference, MatchArm } from "narrac/ast"
import { Type } from "narrac/types"
import { Ref, BindingKind, getExpressionId } from "narrac/check"
import { cachedCType } from "narrac/cnames"
import { isPathEndingCall } from "narrac/pathends"
import {
  Emitter,
  EmitWalker,
  TempVar,
  reportUnsupported,
  writeLine,
  temp,
  consume,
  beginStatement,
  endStatement,
  pushScope,
  popScope,
  addLocal,
  unwindAll,
  unwindBlock,
  unwindLoop,
  enterLoop,
  leaveLoop,
  emitContinueLabel,
  markStepLoop,
  hasStepLoop,
  emitStepJump,
  emitBreakLabel,
  emitLabeledExit,
  readNodeType,
  readNodeRef,
  localRef,
  readLocal,
  releaseCode,
  declareLocal,
  declareLocalVariable,
  declareVariable,
  variableRef,
  localName,
  containerName,
  underlyingType,
  useHelper,
} from "narrac/emitstate"
import { pointerTemp, declaredLocal, emitArithmetic } from "narrac/emitexprs"
import * as Generators from "narrac/emitgenerators"
import { emitStreamYield } from "narrac/emitasyncgenerators"
import { emitForAwait } from "narrac/emitforawait"
import * as Async from "narrac/emitasync"
import * as Maps from "narrac/emitmaps"
import * as Match from "narrac/emitmatch"
import * as Tail from "narrac/emittail"
import * as Fixed from "narrac/emitfixed"
import * as Arrays from "std/array"
import * as Str from "std/string"

const NODE = "selfhost-emit-bodies"

export function emitBlock<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
  loop: bool,
) uses alloc {
  pushScope(mutable emitter, loop)
  emitBlockInScope(walker, mutable emitter, block)
  popScope(mutable emitter)
}

export function emitBlockInScope<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
) uses alloc {
  for (const statement of Arrays.values(block.statements)) {
    emitStatement(walker, mutable emitter, statement)
  }
}

export function emitStatement<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => emitNestedBlock(walker, mutable emitter, block)
    Stmt.VarStmt(nodeId, _, _, _, pattern, _, value) => emitVariable(
      walker,
      mutable emitter,
      statement,
      nodeId,
      pattern,
      value,
    )
    Stmt.AssignStmt(_, target, value) => emitAssignment(
      walker,
      mutable emitter,
      statement,
      target,
      value,
    )
    Stmt.CompoundAssignStmt(_, target, operator, value) => emitCompoundAssignment(
      walker,
      mutable emitter,
      target,
      operator,
      value,
    )
    Stmt.ExprStmt(_, expression) => emitExpressionStatement(
      walker,
      mutable emitter,
      statement,
      expression,
    )
    Stmt.ReturnStmt(_, value) => emitReturn(walker, mutable emitter, value)
    Stmt.IfStmt(_, condition, then, orElse) => emitIf(
      walker,
      mutable emitter,
      statement,
      condition,
      then,
      orElse,
    )
    Stmt.WhileStmt(pos, label, condition, body) => emitWhile(
      walker,
      mutable emitter,
      pos,
      label,
      condition,
      body,
    )
    Stmt.CForStmt(pos, label, init, condition, step, body) => emitCFor(
      walker,
      mutable emitter,
      pos,
      label,
      init,
      condition,
      step,
      body,
    )
    Stmt.ForStmt(nodeId, pos, label, _, iterable, body, reference, awaitPos) => emitFor(
      walker,
      mutable emitter,
      statement,
      nodeId,
      pos,
      label,
      iterable,
      body,
      reference,
      awaitPos,
    )
    Stmt.BreakStmt(_, label) => emitLoopExit(mutable emitter, label, true)
    Stmt.ContinueStmt(_, label) => emitLoopExit(mutable emitter, label, false)
    Stmt.YieldStmt(_, value, delegate, binding) => {
      if (emitter.inStream) {
        emitStreamYield(walker, mutable emitter, value, delegate)
      } else {
        Generators.emitYield(walker, mutable emitter, value, delegate, binding)
      }
    }
  }
}

function emitNestedBlock<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
) uses alloc {
  writeLine(mutable emitter, "{")
  emitter.indent++
  emitBlock(walker, mutable emitter, block, false)
  emitter.indent--
  writeLine(mutable emitter, "}")
}

function emitLoopExit(mutable emitter: Emitter, label: string, isBreak: bool) uses alloc {
  if (label != "") {
    emitLabeledExit(mutable emitter, label, isBreak)
    return
  }
  if (!isBreak && hasStepLoop(emitter)) {
    emitStepJump(mutable emitter)
    return
  }
  unwindLoop(mutable emitter)
  if (isBreak) {
    writeLine(mutable emitter, "break;")
  } else {
    writeLine(mutable emitter, "continue;")
  }
}

function emitVariable<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  nodeId: int,
  pattern: Option<Pattern>,
  value: Expr,
) uses alloc {
  if (pattern is Some(_)) {
    Match.emitDestructure(walker, mutable emitter, statement)
    return
  }
  beginStatement(mutable emitter)
  const code = EmitWalker.emitExpression(walker, mutable emitter, value)
  const localIndex = declaredLocal(emitter, nodeId)
  const local = copy(emitter.checker.bodies[emitter.body].locals[localIndex])
  const consumed = consume(mutable emitter, code.text, code.owned, local.localType)
  declareLocal(mutable emitter, localIndex, consumed)
  endStatement(mutable emitter)
  addLocal(mutable emitter, localIndex)
}

function emitAssignment<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  target: Expr,
  value: Expr,
) uses alloc {
  beginStatement(mutable emitter)
  // A write to a Map index is the maps module's.
  if (target is Expr.IndexExpr(_, _, indexTarget, _)) {
    if (readNodeType(emitter, getExpressionId(indexTarget)) is Type.TMap(_, _)) {
      Maps.emitMapSet(walker, mutable emitter, statement)
      endStatement(mutable emitter)
      return
    }
  }
  const code = EmitWalker.emitExpression(walker, mutable emitter, value)
  const valueType = copy(readNodeType(emitter, getExpressionId(value)))
  const consumed = consume(mutable emitter, code.text, code.owned, valueType)
  const location = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
  const targetType = copy(readNodeType(emitter, getExpressionId(target)))
  const releaseText = releaseCode(emitter, targetType, `(*${location})`)
  if (releaseText != "") {
    // The old value is released before the new one is stored.
    const pointer = pointerTemp(mutable emitter, targetType, location)
    const releaseOld = releaseCode(emitter, targetType, `(*${pointer})`)
    writeLine(mutable emitter, releaseOld)
    writeLine(mutable emitter, `*${pointer} = ${consumed};`)
  } else {
    writeLine(mutable emitter, `*${location} = ${consumed};`)
  }
  endStatement(mutable emitter)
}

function emitCompoundAssignment<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  target: Expr,
  operator: string,
  value: Expr,
) uses alloc {
  beginStatement(mutable emitter)
  // `+=` applies `+`; `++` and `--` apply `+` and `-` to the implied 1.
  let arithmetic = substring(operator, 0, Str.length(operator) - 1)
  if (operator == "++") {
    arithmetic = "+"
  } else if (operator == "--") {
    arithmetic = "-"
  }
  const targetType = copy(readNodeType(emitter, getExpressionId(target)))
  const operandType = underlyingType(emitter, targetType)
  const valueCode = EmitWalker.emitExpression(walker, mutable emitter, value)
  const valueType = copy(readNodeType(emitter, getExpressionId(value)))
  const valueText = temp(mutable emitter, valueType, valueCode.text)
  // The place is found once; the old value is read and the new one stored through it.
  const location = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
  const pointer = pointerTemp(mutable emitter, targetType, location)
  const old = `(*${pointer})`
  if (operandType == Type.TStr) {
    // The joined string is new; the old one is released before it is stored.
    const joined = temp(mutable emitter, Type.TStr, `lstr_concat(${old}, ${valueText})`)
    const releaseOld = releaseCode(emitter, targetType, old)
    writeLine(mutable emitter, releaseOld)
    writeLine(mutable emitter, `*${pointer} = ${joined};`)
  } else {
    const result = emitArithmetic(mutable emitter, arithmetic, operandType, old, valueText)
    writeLine(mutable emitter, `*${pointer} = ${result.text};`)
  }
  endStatement(mutable emitter)
}

function emitExpressionStatement<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  expression: Expr,
) uses alloc {
  if (Tail.isTailCall(emitter, expression)) {
    Tail.emitTailJump(walker, mutable emitter, expression)
    return
  }
  beginStatement(mutable emitter)
  if (expression is Expr.MatchExpr(_, _, _, _)) {
    Match.emitMatchStatement(walker, mutable emitter, statement)
  } else {
    // Only a call that returns nothing is a statement of its own.
    const code = EmitWalker.emitExpression(walker, mutable emitter, expression)
    if (code.text != "" && readNodeType(emitter, getExpressionId(expression)) == Type.TVoid) {
      writeLine(mutable emitter, `${code.text};`)
    }
  }
  endStatement(mutable emitter)
}

function emitBlockReturn<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  value: Option<Expr>,
) uses alloc {
  const info = copy(emitter.blocks[Arrays.length(emitter.blocks) - 1])
  beginStatement(mutable emitter)
  if (value is Some(returned)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, returned)
    const returnedType = copy(readNodeType(emitter, getExpressionId(returned)))
    const consumed = consume(mutable emitter, code.text, code.owned, returnedType)
    writeLine(mutable emitter, `${info.result} = ${consumed};`)
  }
  unwindBlock(mutable emitter, info)
  writeLine(mutable emitter, `goto ${info.label};`)
  // unwindBlock released everything, so the frame closes without releasing again.
  emitter.frames = Tail.withoutLastFrame(emitter.frames)
}

function emitReturn<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  value: Option<Expr>,
) uses alloc {
  if (Arrays.length(emitter.blocks) > 0) {
    emitBlockReturn(walker, mutable emitter, value)
    return
  }
  if (emitter.inFrame && emitter.inAsync) {
    Async.emitTaskReturn(walker, mutable emitter, value)
    // emitTaskReturn released everything, so the frame closes without releasing again.
    emitter.frames = Tail.withoutLastFrame(emitter.frames)
    return
  }
  if (emitter.inFrame) {
    Generators.emitGeneratorReturn(mutable emitter)
    return
  }
  if (value is Some(tailValue)) {
    if (Tail.isTailCall(emitter, tailValue)) {
      Tail.emitTailJump(walker, mutable emitter, tailValue)
      return
    }
    if (tailValue is Expr.MatchExpr(_, _, _, arms)) {
      if (Tail.matchHasTailCall(emitter, arms)) {
        Match.emitReturnMatch(walker, mutable emitter, tailValue)
        return
      }
    }
  }
  beginStatement(mutable emitter)
  if (value is Some(returned)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, returned)
    const returnedType = copy(readNodeType(emitter, getExpressionId(returned)))
    const consumed = consume(mutable emitter, code.text, code.owned, returnedType)
    const result = temp(mutable emitter, returnedType, consumed)
    unwindAll(mutable emitter)
    writeLine(mutable emitter, `return ${result};`)
  } else {
    unwindAll(mutable emitter)
    writeLine(mutable emitter, "return;")
  }
  // unwindAll released everything, so the frame closes without releasing again.
  emitter.frames = Tail.withoutLastFrame(emitter.frames)
}

function emitIf<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  condition: Expr,
  then: Block,
  orElse: Option<Stmt>,
) uses alloc {
  // A condition decided by the build target keeps one branch and no test.
  if (emitter.checker.foldedConditions[getExpressionId(condition)] is Some(holds)) {
    emitKeptBranch(walker, mutable emitter, holds, then, orElse)
    return
  }
  if (condition is Expr.IsExpr(_, _, _, _)) {
    Match.emitIfIs(walker, mutable emitter, statement)
    return
  }
  beginStatement(mutable emitter)
  const code = EmitWalker.emitExpression(walker, mutable emitter, condition)
  const holds = temp(mutable emitter, Type.TBool, code.text)
  endStatement(mutable emitter)
  writeLine(mutable emitter, `if (${holds}) {`)
  emitter.indent++
  emitBlock(walker, mutable emitter, then, false)
  emitter.indent--
  if (orElse is Some(otherwise)) {
    writeLine(mutable emitter, "} else {")
    emitter.indent++
    if (otherwise is Stmt.BlockStmt(elseBlock)) {
      emitBlock(walker, mutable emitter, elseBlock, false)
    } else {
      emitStatement(walker, mutable emitter, otherwise)
    }
    emitter.indent--
  }
  writeLine(mutable emitter, "}")
}

function emitKeptBranch<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  holds: bool,
  then: Block,
  orElse: Option<Stmt>,
) uses alloc {
  if (holds) {
    writeLine(mutable emitter, "{")
    emitter.indent++
    emitBlock(walker, mutable emitter, then, false)
    emitter.indent--
    writeLine(mutable emitter, "}")
    return
  }
  if (orElse is Some(otherwise)) {
    writeLine(mutable emitter, "{")
    emitter.indent++
    if (otherwise is Stmt.BlockStmt(elseBlock)) {
      emitBlock(walker, mutable emitter, elseBlock, false)
    } else {
      emitStatement(walker, mutable emitter, otherwise)
    }
    emitter.indent--
    writeLine(mutable emitter, "}")
  }
}

function emitLoopBody<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  label: string,
  pos: Pos,
  body: Block,
) uses alloc {
  enterLoop(mutable emitter, label, pos)
  emitBlock(walker, mutable emitter, body, true)
  emitContinueLabel(mutable emitter)
}

function isLiteralTrue(condition: Expr): bool {
  if (condition is Expr.BoolLit(_, _, value)) {
    return value
  }
  return false
}

function emitWhile<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  label: string,
  condition: Expr,
  body: Block,
) uses alloc {
  let scan = HoistScan { places: [], disqualified: [], unconditional: [], exits: 0 }
  scanHoistExpression(emitter, mutable scan, condition)
  scanHoistBlock(emitter, mutable scan, body)
  scanUnconditionalWrites(emitter, mutable scan, body)
  const outerHoisted = Arrays.length(emitter.hoistedArrays)
  const hoisted = chooseHoistedArrays(mutable emitter, scan)
  const firstFlag = declareFirstIterationFlag(mutable emitter, hoisted)
  writeLine(mutable emitter, "while (1) {")
  emitter.indent++
  // A condition that is the literal `true` gets no test, so the C compiler sees an endless loop.
  if (!isLiteralTrue(condition)) {
    beginStatement(mutable emitter)
    const code = EmitWalker.emitExpression(walker, mutable emitter, condition)
    const holds = temp(mutable emitter, Type.TBool, code.text)
    endStatement(mutable emitter)
    writeLine(mutable emitter, `if (!${holds}) break;`)
  }
  emitFirstIterationUniques(walker, mutable emitter, hoisted, firstFlag)
  emitLoopBody(walker, mutable emitter, label, pos, body)
  const info = leaveLoop(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
  restoreHoistedArrays(mutable emitter, outerHoisted)
}

function emitCFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  label: string,
  init: Option<Stmt>,
  condition: Option<Expr>,
  step: Option<Stmt>,
  body: Block,
) uses alloc {
  // The loop variable lives in a scope around the whole loop.
  pushScope(mutable emitter, false)
  if (init is Some(declaration)) {
    emitStatement(walker, mutable emitter, declaration)
  }
  let scan = HoistScan { places: [], disqualified: [], unconditional: [], exits: 0 }
  if (condition is Some(scannedCondition)) {
    scanHoistExpression(emitter, mutable scan, scannedCondition)
  }
  if (step is Some(scannedStep)) {
    scanHoistStatement(emitter, mutable scan, scannedStep)
  }
  scanHoistBlock(emitter, mutable scan, body)
  scanUnconditionalWrites(emitter, mutable scan, body)
  const outerHoisted = Arrays.length(emitter.hoistedArrays)
  const hoisted = chooseHoistedArrays(mutable emitter, scan)
  let firstFlag = ""
  if (condition is None) {
    // Without a condition the body always runs.
    emitHoistedUniques(walker, mutable emitter, hoisted)
  } else {
    firstFlag = declareFirstIterationFlag(mutable emitter, hoisted)
  }
  writeLine(mutable emitter, "while (1) {")
  emitter.indent++
  if (condition is Some(loopCondition)) {
    if (!isLiteralTrue(loopCondition)) {
      beginStatement(mutable emitter)
      const code = EmitWalker.emitExpression(walker, mutable emitter, loopCondition)
      const holds = temp(mutable emitter, Type.TBool, code.text)
      endStatement(mutable emitter)
      writeLine(mutable emitter, `if (!${holds}) break;`)
    }
    emitFirstIterationUniques(walker, mutable emitter, hoisted, firstFlag)
  }
  enterLoop(mutable emitter, label, pos)
  markStepLoop(mutable emitter)
  emitBlock(walker, mutable emitter, body, true)
  emitContinueLabel(mutable emitter)
  const info = leaveLoop(mutable emitter)
  if (step is Some(stepStatement)) {
    emitStatement(walker, mutable emitter, stepStatement)
  }
  emitter.indent--
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
  restoreHoistedArrays(mutable emitter, outerHoisted)
  popScope(mutable emitter)
}

function iterableName(emitter: Emitter, iterable: Expr): string {
  if (iterable is Expr.CallExpr(callId, _, _, _, _)) {
    if (readNodeRef(emitter, callId) is Ref.Builtin(index)) {
      return emitter.checker.registry.functions[index].name
    }
  }
  return ""
}

function emitFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  reference: Option<LoopReference>,
  awaitPos: Option<Pos>,
) uses alloc {
  const name = iterableName(emitter, iterable)
  beginStatement(mutable emitter)
  if (awaitPos is Some(_)) {
    emitForAwait(walker, mutable emitter, nodeId, pos, label, iterable, body)
  } else if (reference is Some(marker)) {
    emitReferenceFor(walker, mutable emitter, nodeId, pos, label, iterable, body, marker)
  } else if (name == "Range.upTo" || name == "Range.between") {
    emitRangeFor(walker, mutable emitter, nodeId, pos, label, iterable, body, name)
  } else if (readNodeType(emitter, getExpressionId(iterable)) is Type.TRange) {
    emitRangeValueFor(walker, mutable emitter, nodeId, pos, label, iterable, body)
  } else if (name == "Map.keys" || name == "Map.entries") {
    Maps.emitMapFor(walker, mutable emitter, statement)
  } else if (name == "Array.values" || name == "Array.entries") {
    emitArrayFor(
      walker,
      mutable emitter,
      nodeId,
      pos,
      label,
      iterable,
      body,
      name == "Array.entries",
      true,
    )
  } else if (
    readNodeType(emitter, getExpressionId(iterable)) is Type.TArray(_) ||
      readNodeType(emitter, getExpressionId(iterable)) is Type.TFixedArray(_, _)
  ) {
    emitArrayFor(walker, mutable emitter, nodeId, pos, label, iterable, body, false, false)
  } else if (readNodeType(emitter, getExpressionId(iterable)) is Type.TGenerator(_, _, _, _, _)) {
    Generators.emitGeneratorFor(walker, mutable emitter, nodeId, pos, label, iterable, body)
  } else {
    const _ = reportUnsupported(mutable emitter, "for loop", NODE)
  }
  endStatement(mutable emitter)
}

function emitRangeFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  name: string,
) uses alloc {
  let arguments: Array<Expr> = []
  if (iterable is Expr.CallExpr(_, _, _, _, callArguments)) {
    for (const argument of Arrays.values(callArguments)) {
      Arrays.push(mutable arguments, argument.value)
    }
  }
  let low = "0"
  let high = ""
  if (name == "Range.upTo") {
    const upper = EmitWalker.emitExpression(walker, mutable emitter, arguments[0])
    high = temp(mutable emitter, Type.TInt, upper.text)
  } else {
    const lower = EmitWalker.emitExpression(walker, mutable emitter, arguments[0])
    low = temp(mutable emitter, Type.TInt, lower.text)
    const upper = EmitWalker.emitExpression(walker, mutable emitter, arguments[1])
    high = temp(mutable emitter, Type.TInt, upper.text)
  }
  const localIndex = declaredLocal(emitter, nodeId)
  const declaration = declareLocalVariable(mutable emitter, localIndex)
  const variable = localRef(emitter, localIndex)
  let scan = HoistScan { places: [], disqualified: [], unconditional: [], exits: 0 }
  scanHoistBlock(emitter, mutable scan, body)
  scanUnconditionalWrites(emitter, mutable scan, body)
  const outerHoisted = Arrays.length(emitter.hoistedArrays)
  const hoisted = chooseHoistedArrays(mutable emitter, scan)
  emitGuardedUniques(walker, mutable emitter, hoisted, `${low} < ${high}`)
  writeLine(
    mutable emitter,
    `for (${declaration} = ${low}; ${variable} < ${high}; ${variable}++) {`,
  )
  emitter.indent++
  emitLoopBody(walker, mutable emitter, label, pos, body)
  const info = leaveLoop(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
  restoreHoistedArrays(mutable emitter, outerHoisted)
}

function emitRangeValueFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
) uses alloc {
  const code = EmitWalker.emitExpression(walker, mutable emitter, iterable)
  const range = temp(mutable emitter, Type.TRange, code.text)
  const localIndex = declaredLocal(emitter, nodeId)
  const declaration = declareLocalVariable(mutable emitter, localIndex)
  const variable = localRef(emitter, localIndex)
  let scan = HoistScan { places: [], disqualified: [], unconditional: [], exits: 0 }
  scanHoistBlock(emitter, mutable scan, body)
  scanUnconditionalWrites(emitter, mutable scan, body)
  const outerHoisted = Arrays.length(emitter.hoistedArrays)
  const hoisted = chooseHoistedArrays(mutable emitter, scan)
  const runsAtLeastOnce = `${range}.step > 0 ? ${range}.low < ${range}.high : ${range}.low > ${range}.high`
  emitGuardedUniques(walker, mutable emitter, hoisted, runsAtLeastOnce)
  writeLine(
    mutable emitter,
    `for (${declaration} = ${range}.low; ${range}.step > 0 ? ${variable} < ${range}.high : ${variable} > ${range}.high; narra_range_advance(&${variable}, ${range}.step, ${range}.high)) {`,
  )
  emitter.indent++
  emitLoopBody(walker, mutable emitter, label, pos, body)
  const info = leaveLoop(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
  restoreHoistedArrays(mutable emitter, outerHoisted)
}

function emitReferenceFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  marker: LoopReference,
) uses alloc {
  // The source array is made unique once, as for a `mutable` argument; the body
  // cannot reach the source, so its storage stays where it is. The loop holds
  // no reference to the array, and the element local is a pointer into it that
  // is never retained or released.
  // The source is the iterable, or the argument of Arrays.values or Arrays.entries.
  let source = iterable
  if (iterable is Expr.CallExpr(_, _, _, _, callArguments)) {
    source = callArguments[0].value
  }
  const arrayType = copy(readNodeType(emitter, getExpressionId(source)))
  if (arrayType is Type.TArray(element)) {
    const arrayStruct = containerName(emitter, arrayType)
    const place = EmitWalker.emitLvaluePointer(walker, mutable emitter, source)
    const pointer = pointerTemp(mutable emitter, arrayType, place)
    const uniqueHelper = useHelper(emitter, arrayStruct, "unique")
    writeLine(mutable emitter, `*${pointer} = ${uniqueHelper}(*${pointer});`)
    const array = temp(mutable emitter, arrayType, `*${pointer}`)
    emitter.tempCount++
    const indexName = `i${Int.toString(emitter.tempCount)}`
    const indexDeclaration = declareVariable(mutable emitter, "int64_t", indexName)
    const index = variableRef(emitter, indexName)
    writeLine(
      mutable emitter,
      `for (${indexDeclaration} = 0; ${index} < ${array}->len; ${index}++) {`,
    )
    emitter.indent++
    enterLoop(mutable emitter, label, pos)
    pushScope(mutable emitter, true)
    if (marker.indexName != "") {
      const indexLocal = declaredLocal(emitter, marker.indexId)
      declareLocal(mutable emitter, indexLocal, index)
    }
    const localIndex = declaredLocal(emitter, nodeId)
    const elementType = `${cachedCType(emitter.checker, emitter.typeNames, element)}*`
    const elementName = localName(readLocal(emitter, localIndex))
    const declaration = declareVariable(mutable emitter, elementType, elementName)
    writeLine(mutable emitter, `${declaration} = &${array}->items[${index}];`)
    emitBlockInScope(walker, mutable emitter, body)
    popScope(mutable emitter)
    emitContinueLabel(mutable emitter)
    const info = leaveLoop(mutable emitter)
    emitter.indent--
    writeLine(mutable emitter, "}")
    emitBreakLabel(mutable emitter, info)
    return
  }
  const _ = reportUnsupported(mutable emitter, "for loop", NODE)
}

function emitArrayFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
  entries: bool,
  isCall: bool,
) uses alloc {
  // Array.values and Array.entries loop over their argument; any other array is the source itself.
  let source = iterable
  if (isCall) {
    if (iterable is Expr.CallExpr(_, _, _, _, callArguments)) {
      source = callArguments[0].value
    }
  }
  const arrayType = copy(readNodeType(emitter, getExpressionId(source)))
  if (arrayType is Type.TArray(_) || arrayType is Type.TFixedArray(_, _)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, source)
    // A FixedArray is copied here, so writes in the body leave the items the loop reads alone.
    let array = consume(mutable emitter, code.text, code.owned, arrayType)
    if (arrayType is Type.TFixedArray(_, _) && array == code.text && !code.owned) {
      array = temp(mutable emitter, arrayType, code.text)
    }
    // The loop owns the array until the statement ends.
    const top = Arrays.length(emitter.frames) - 1
    Arrays.push(mutable emitter.frames[top], TempVar { name: array, tempType: arrayType })
    emitter.tempCount++
    const indexName = `i${Int.toString(emitter.tempCount)}`
    const indexDeclaration = declareVariable(mutable emitter, "int64_t", indexName)
    const index = variableRef(emitter, indexName)
    writeLine(
      mutable emitter,
      `for (${indexDeclaration} = 0; ${index} < ${Fixed.buildFixedLengthText(arrayType, array)}; ${index}++) {`,
    )
    emitter.indent++
    enterLoop(mutable emitter, label, pos)
    pushScope(mutable emitter, true)
    const localIndex = declaredLocal(emitter, nodeId)
    if (entries) {
      // Array.entries gives #[index, item]; an assignment to a frame field
      // needs a compound literal.
      let tupleValue = `{.f_0 = ${index}, .f_1 = ${array}->items[${index}]}`
      if (emitter.inFrame) {
        const tupleName = cachedCType(
          emitter.checker,
          emitter.typeNames,
          readLocal(emitter, localIndex).localType,
        )
        tupleValue = `(${tupleName})${tupleValue}`
      }
      declareLocal(mutable emitter, localIndex, tupleValue)
    } else {
      declareLocal(mutable emitter, localIndex, Fixed.buildFixedItemText(arrayType, array, index))
    }
    // The item is borrowed from the array the loop holds: it is read-only, and
    // a write to the source array copies it first, so no retain or release.
    emitBlockInScope(walker, mutable emitter, body)
    popScope(mutable emitter)
    emitContinueLabel(mutable emitter)
    const info = leaveLoop(mutable emitter)
    emitter.indent--
    writeLine(mutable emitter, "}")
    emitBreakLabel(mutable emitter, info)
    return
  }
  const _ = reportUnsupported(mutable emitter, "for loop", NODE)
}

// The index writes of a loop body to local arrays, found before the loop is
// emitted. The array is made unique once ahead of the loop when nothing in the
// loop can give it a second owner: it is only indexed or measured, and no
// closure captures it.
struct HoistScan {
  places: Array<Expr>
  disqualified: Array<int>
  unconditional: Array<int>
  exits: int
}

function findArrayLocal(emitter: Emitter, expression: Expr): int {
  if (expression is Expr.Ident(nodeId, _, _)) {
    if (readNodeRef(emitter, nodeId) is Ref.Local(index)) {
      const localType = readLocal(emitter, index).localType
      if (localType is Type.TArray(_)) {
        return index
      }
    }
  }
  return -1
}

function containsLocal(locals: Array<int>, index: int): bool {
  for (const candidate of Arrays.values(locals)) {
    if (candidate == index) {
      return true
    }
  }
  return false
}

function chooseHoistedArrays(
  mutable emitter: Emitter,
  scan: HoistScan,
): Array<Expr> from scan uses alloc {
  let chosen: Array<Expr> = []
  if (emitter.inFrame) {
    return chosen
  }
  for (const place of Arrays.values(scan.places)) {
    const index = findArrayLocal(emitter, place)
    if (!containsLocal(scan.unconditional, index) || !canHoistArray(emitter, scan, index)) {
      continue
    }
    Arrays.push(mutable chosen, place)
    Arrays.push(mutable emitter.hoistedArrays, index)
  }
  return chosen
}

function emitHoistedUniques<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  places: Array<Expr>,
) uses alloc {
  for (const place of Arrays.values(places)) {
    // The array is made unique through the place of the local, as for a `mutable` argument.
    const index = findArrayLocal(emitter, place)
    const arrayType = readLocal(emitter, index).localType
    const arrayStruct = containerName(emitter, arrayType)
    const location = EmitWalker.emitLvaluePointer(walker, mutable emitter, place)
    const pointer = pointerTemp(mutable emitter, arrayType, location)
    const uniqueHelper = useHelper(emitter, arrayStruct, "unique")
    writeLine(mutable emitter, `*${pointer} = ${uniqueHelper}(*${pointer});`)
  }
}

function emitGuardedUniques<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  places: Array<Expr>,
  guard: string,
) uses alloc {
  if (Arrays.length(places) == 0) {
    return
  }
  // The loop may run zero times, and then nothing writes the array.
  writeLine(mutable emitter, `if (${guard}) {`)
  emitter.indent++
  emitHoistedUniques(walker, mutable emitter, places)
  emitter.indent--
  writeLine(mutable emitter, "}")
}

function declareFirstIterationFlag(
  mutable emitter: Emitter,
  places: Array<Expr>,
): string uses alloc {
  if (Arrays.length(places) == 0) {
    return ""
  }
  emitter.tempCount++
  const flag = `first${Int.toString(emitter.tempCount)}`
  writeLine(mutable emitter, `int ${flag} = 1;`)
  return flag
}

function emitFirstIterationUniques<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  places: Array<Expr>,
  flag: string,
) uses alloc {
  if (flag == "") {
    return
  }
  // The uniqueness test waits for the first pass through the loop body.
  writeLine(mutable emitter, `if (${flag}) {`)
  emitter.indent++
  writeLine(mutable emitter, `${flag} = 0;`)
  emitHoistedUniques(walker, mutable emitter, places)
  emitter.indent--
  writeLine(mutable emitter, "}")
}

function restoreHoistedArrays(mutable emitter: Emitter, count: int) uses alloc {
  if (Arrays.length(emitter.hoistedArrays) == count) {
    return
  }
  let kept: Array<int> = []
  for (let position = 0; position < count; position++) {
    Arrays.push(mutable kept, emitter.hoistedArrays[position])
  }
  emitter.hoistedArrays = kept
}

function canHoistArray(emitter: Emitter, scan: HoistScan, index: int): bool {
  if (containsLocal(scan.disqualified, index) || containsLocal(emitter.hoistedArrays, index)) {
    return false
  }
  if (containsLocal(emitter.refCaptures, index)) {
    return false
  }
  // A closure that captures the array could replace it behind the loop's back.
  for (const closure of Arrays.values(emitter.checker.bodies[emitter.body].closures)) {
    if (containsLocal(closure.captures, index)) {
      return false
    }
  }
  const local = readLocal(emitter, index)
  if (local.binding == BindingKind.Reference) {
    return false
  }
  if (local.param) {
    return local.isMutable
  }
  // The local must be declared before the loop.
  for (const scope of Arrays.values(emitter.scopes)) {
    if (containsLocal(scope.locals, index)) {
      return true
    }
  }
  return false
}

function scanHoistBlock(emitter: Emitter, mutable scan: HoistScan, block: Block) uses alloc {
  for (const statement of Arrays.values(block.statements)) {
    scanHoistStatement(emitter, mutable scan, statement)
  }
}

function scanHoistStatement(emitter: Emitter, mutable scan: HoistScan, statement: Stmt) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => {
      scanHoistBlock(emitter, mutable scan, block)
    }
    Stmt.VarStmt(_, _, _, _, _, _, value) => {
      scanHoistExpression(emitter, mutable scan, value)
    }
    Stmt.AssignStmt(_, target, value) => {
      noteArrayWrite(emitter, mutable scan, target)
      scanHoistExpression(emitter, mutable scan, target)
      scanHoistExpression(emitter, mutable scan, value)
    }
    Stmt.CompoundAssignStmt(_, target, _, value) => {
      noteArrayWrite(emitter, mutable scan, target)
      scanHoistExpression(emitter, mutable scan, target)
      scanHoistExpression(emitter, mutable scan, value)
    }
    Stmt.ExprStmt(_, expression) => {
      scanHoistExpression(emitter, mutable scan, expression)
    }
    Stmt.ReturnStmt(_, value) => {
      scan.exits++
      if (value is Some(returned)) {
        scanHoistExpression(emitter, mutable scan, returned)
      }
    }
    Stmt.IfStmt(_, condition, then, orElse) => {
      scanHoistExpression(emitter, mutable scan, condition)
      scanHoistBlock(emitter, mutable scan, then)
      if (orElse is Some(otherwise)) {
        scanHoistStatement(emitter, mutable scan, otherwise)
      }
    }
    Stmt.WhileStmt(_, _, condition, body) => {
      scanHoistExpression(emitter, mutable scan, condition)
      scanHoistBlock(emitter, mutable scan, body)
    }
    Stmt.CForStmt(_, _, init, condition, step, body) => {
      if (init is Some(declaration)) {
        scanHoistStatement(emitter, mutable scan, declaration)
      }
      if (condition is Some(loopCondition)) {
        scanHoistExpression(emitter, mutable scan, loopCondition)
      }
      if (step is Some(stepStatement)) {
        scanHoistStatement(emitter, mutable scan, stepStatement)
      }
      scanHoistBlock(emitter, mutable scan, body)
    }
    Stmt.ForStmt(_, _, _, _, iterable, body, _, _) => {
      scanHoistExpression(emitter, mutable scan, iterable)
      scanHoistBlock(emitter, mutable scan, body)
    }
    Stmt.YieldStmt(_, value, _, _) => {
      scanHoistExpression(emitter, mutable scan, value)
    }
    Stmt.BreakStmt(_, _) => {
      scan.exits++
    }
    Stmt.ContinueStmt(_, _) => {
      scan.exits++
    }
  }
}

function noteArrayWrite(emitter: Emitter, mutable scan: HoistScan, target: Expr) uses alloc {
  // The written array is the local indexed at the root of the place.
  let current = target
  while (true) {
    match (current) {
      Expr.FieldExpr(_, _, inner, _) => {
        current = inner
      }
      Expr.IndexExpr(_, _, inner, _) => {
        if (findArrayLocal(emitter, inner) >= 0) {
          Arrays.push(mutable scan.places, inner)
          return
        }
        current = inner
      }
      _ => {
        return
      }
    }
  }
}

function scanHoistArms(
  emitter: Emitter,
  mutable scan: HoistScan,
  arms: Array<MatchArm>,
) uses alloc {
  for (const arm of Arrays.values(arms)) {
    if (arm.guard is Some(guard)) {
      scanHoistExpression(emitter, mutable scan, guard)
    }
    if (arm.body is Some(armBody)) {
      scanHoistExpression(emitter, mutable scan, armBody)
    }
    if (arm.block is Some(armBlock)) {
      scanHoistBlock(emitter, mutable scan, armBlock)
    }
  }
}

function scanHoistExpression(
  emitter: Emitter,
  mutable scan: HoistScan,
  expression: Expr,
) uses alloc {
  match (expression) {
    Expr.Ident(_, _, _) => {
      // Any use of the array other than indexing it or measuring it disqualifies it.
      const index = findArrayLocal(emitter, expression)
      if (index >= 0) {
        Arrays.push(mutable scan.disqualified, index)
      }
    }
    Expr.IndexExpr(_, _, target, index) => {
      if (findArrayLocal(emitter, target) < 0) {
        scanHoistExpression(emitter, mutable scan, target)
      }
      scanHoistExpression(emitter, mutable scan, index)
    }
    Expr.CallExpr(callId, _, callee, _, arguments) => {
      if (isPathEndingCall(emitter.checker, emitter.body, expression)) {
        scan.exits++
      }
      scanHoistExpression(emitter, mutable scan, callee)
      let measured = false
      if (readNodeRef(emitter, callId) is Ref.Builtin(builtin)) {
        measured = emitter.checker.registry.functions[builtin].name == "Array.length"
      }
      for (const argument of Arrays.values(arguments)) {
        if (!measured || findArrayLocal(emitter, argument.value) < 0) {
          scanHoistExpression(emitter, mutable scan, argument.value)
        }
      }
    }
    Expr.FieldExpr(_, _, target, _) => {
      scanHoistExpression(emitter, mutable scan, target)
    }
    Expr.IsExpr(_, _, subject, _) => {
      scanHoistExpression(emitter, mutable scan, subject)
    }
    Expr.TemplateLit(_, _, parts) => {
      for (const part of Arrays.values(parts)) {
        scanHoistExpression(emitter, mutable scan, part)
      }
    }
    Expr.MapLit(_, _, _, keys, values) => {
      for (const key of Arrays.values(keys)) {
        scanHoistExpression(emitter, mutable scan, key)
      }
      for (const value of Arrays.values(values)) {
        scanHoistExpression(emitter, mutable scan, value)
      }
    }
    Expr.UnaryExpr(_, _, _, operand) => {
      scanHoistExpression(emitter, mutable scan, operand)
    }
    Expr.AwaitExpr(_, _, operand) => {
      scanHoistExpression(emitter, mutable scan, operand)
    }
    Expr.AsyncExpr(_, _, operand) => {
      scanHoistExpression(emitter, mutable scan, operand)
    }
    Expr.BinaryExpr(_, _, _, left, right) => {
      scanHoistExpression(emitter, mutable scan, left)
      scanHoistExpression(emitter, mutable scan, right)
    }
    Expr.StructLit(_, _, _, _, fields, spread) => {
      for (const field of Arrays.values(fields)) {
        scanHoistExpression(emitter, mutable scan, field.value)
      }
      if (spread is Some(base)) {
        scanHoistExpression(emitter, mutable scan, base)
      }
    }
    Expr.ArrayLit(_, _, elements, _) => {
      for (const element of Arrays.values(elements)) {
        scanHoistExpression(emitter, mutable scan, element)
      }
    }
    Expr.MatchExpr(_, _, subject, arms) => {
      scanHoistExpression(emitter, mutable scan, subject)
      scanHoistArms(emitter, mutable scan, arms)
    }
    Expr.BlockExpr(_, _, block) => {
      scanHoistBlock(emitter, mutable scan, block)
    }
    // Closures are checked through their captures in canHoistArray.
    _ => {}
  }
}

function scanUnconditionalWrites(
  emitter: Emitter,
  mutable scan: HoistScan,
  body: Block,
) uses alloc {
  // A write counts when no statement before it, or the statement itself, can leave the body.
  for (const statement of Arrays.values(body.statements)) {
    let probe = HoistScan { places: [], disqualified: [], unconditional: [], exits: 0 }
    scanHoistStatement(emitter, mutable probe, statement)
    if (probe.exits > 0) {
      return
    }
    let written = HoistScan { places: [], disqualified: [], unconditional: [], exits: 0 }
    if (statement is Stmt.AssignStmt(_, target, _)) {
      noteArrayWrite(emitter, mutable written, target)
    } else if (statement is Stmt.CompoundAssignStmt(_, target, _, _)) {
      noteArrayWrite(emitter, mutable written, target)
    }
    for (const place of Arrays.values(written.places)) {
      Arrays.push(mutable scan.unconditional, findArrayLocal(emitter, place))
    }
  }
}
