// error: `for (mutable ...)` is not supported in a function* body yet; change the elements through an index, as in `items[index].field = value`
struct Player {
  hp: int
}

function* drain(players: Array<Player>): Generator<int> {
  const copy = players
  for (mutable player of copy) {
    player.hp = 0
    yield 1
  }
}

export function run(args: Array<string>): int {
  for (const _ of drain([Player { hp: 3 }])) {
    print("x")
  }
  return 0
}
