struct Point derives Show {
  x: int
  y: int
}

enum Shape derives Show {
  Dot
  Line(start: Point, end: Point)
}

struct Named implements Show {
  name: string
  aliases: Array<string>
  a: int
  b: int
  c: int
  d: int
}

implement Show for Named {
  function show(value: Named): string {
    return `Named(${value.name}, ${Show.show(value.aliases)})`
  }
}

function showAll(items: Array<Dynamic<Show>>): string uses alloc {
  let text = ""
  for (const item of items) {
    text = `${text}[${Show.show(item)}]`
  }
  return text
}

export function run(_args: Array<string>): int {
  const items: Array<Dynamic<Show>> = [
    Dynamic.of(42),
    Dynamic.of("text"),
    Dynamic.of(Point { x: 1, y: 2 }),
    Dynamic.of(Shape.Line(Point { x: 0, y: 0 }, Point { x: 3, y: 4 })),
    Dynamic.of(Named { name: "n", aliases: ["m", "o"], a: 1, b: 2, c: 3, d: 4 }),
    Dynamic.of([1, 2, 3]),
    Dynamic.of(Some(2.5)),
    Dynamic.of(true),
  ]
  print(showAll(items))
  const single: Dynamic<Show> = Dynamic.of('c')
  print(Show.show(single))
  return 0
}
