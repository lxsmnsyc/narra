import { divide, ratio } from "task/calc"
import * as Test from "std/test"

function isFailure(result: Result<int, string>): bool {
  return result is Err
}

test "divide" {
  Test.eq(divide(6, 3), Ok(2))
}

test "divide by zero" {
  Test.eq(isFailure(divide(1, 0)), true)
}

test "ratio" {
  Test.eq(ratio(6, 3), "2")
}

test "ratio by zero" {
  Test.eq(ratio(1, 0), "undefined")
}
