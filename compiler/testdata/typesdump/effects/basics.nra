import * as Int from "std/int"
import * as Options from "std/option"

trait Named {
  function name(value: Self): string
}

struct Cat implements Named {
  lives: int
}

implement Named for Cat {
  function name(value: Cat): string {
    print("naming")
    return "cat"
  }
}

// Exported: the declared set is what callers see.
export function pure(x: int): int {
  return x + 1
}

export function shout(text: string): string uses io, alloc {
  print(text)
  return `${text}!`
}

// Private: inferred.
function noisy(x: int): int {
  print("noisy")
  return x
}

function quiet(x: int): int {
  return x * 2
}

function countdown(n: int): int {
  if (n <= 0) {
    return 0
  }
  noisy(n)
  return countdown(n - 1)
}

function ping(n: int): int {
  if (n <= 0) {
    return 0
  }
  return pong(n - 1)
}

function pong(n: int): int {
  if (n <= 0) {
    return 0
  }
  return ping(n - 1)
}

function allocating(n: int): Array<int> {
  return [n, n]
}

function identity<T>(value: T): T {
  return value
}

function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

export function map<T, U, effect E>(items: Array<T>, f: (item: T) => U uses E): Array<U> uses alloc, E {
  return [f(items[0])]
}

export function viaOption(value: Option<int>): Option<int> uses io, alloc {
  const visit = (x: int): int => {
    print("mapped")
    return x
  }
  return Options.map(value, visit)
}

export function viaName(cat: Cat): string uses io {
  return Named.name(cat)
}

export function run(args: Array<string>): int uses io, alloc {
  const a = apply(quiet, 1)
  const b = apply(noisy, 2)
  const c = map([1, 2], quiet)
  const d = map([1, 2], noisy)
  const f = quiet
  const g = noisy
  let h = quiet
  h = noisy
  print(shout(Int.toString(a + b + c[0] + d[0] + f(1) + g(2) + h(3) + countdown(2) + ping(3))))
  const e = identity(allocating(1))
  let table: Map<string, int> = Map {}
  table["k"] = 1
  return pure(e[0])
}

test "effects in tests are discarded" {
  print("in a test")
  assert(noisy(1) == 1)
}
