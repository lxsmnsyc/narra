// Module scopes across modules, ported from compiler/internal/narra:
// the import loop of declareModule and useModule (check.go),
// importPackageModule, exported, entryFunc and checkEntry
// (modules_check.go), importTrait (check_traits.go), importConst and the
// imported-constant check of declareConsts (check_const.go), declareType
// (check_types.go), and checkImportNames and aliasTaken (import_names.go).
//
// Package modules are declared in load order, imports first, so every
// module an import names already has its scope and its table entries. An
// imported name points at the declaring module's entry: a type is the same
// Type value, a function, constant, generic or trait the same table index.
import { Pos, Decl, File, ImportDecl } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Package, entryModule } from "narrac/modules"
import { Type } from "narrac/types"
import { moduleList } from "narrac/builtins"
import { Checker, EntryInfo, errorf, enter, lookupType, lookupGeneric, lookupTrait, unsupported } from "narrac/check"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// declName is the name a top-level declaration declares, or "" (tests and
// implement blocks).
export function declName(d: Decl): string {
  return match (d) {
    Decl.Func(f) => f.name
    Decl.Const(x) => x.name
    Decl.Struct(x) => x.name
    Decl.Enum(x) => x.name
    Decl.Distinct(x) => x.name
    Decl.Trait(x) => x.name
    _ => ""
  }
}

function isExported(d: Decl): bool {
  return match (d) {
    Decl.Func(f) => f.exported
    Decl.Const(x) => x.exported
    Decl.Struct(x) => x.exported
    Decl.Enum(x) => x.exported
    Decl.Distinct(x) => x.exported
    Decl.Trait(x) => x.exported
    _ => false
  }
}

// exportsOf maps each exported name to its declaration's index. A later
// declaration of the same name wins, as in Go's Exports map.
export function exportsOf(decls: Array<Decl>): Map<string, int> uses alloc {
  let out: Map<string, int> = Map {}
  for (const k of Ranges.between(0, Arrays.length(decls))) {
    if (isExported(decls[k])) {
      out[declName(decls[k])] = k
    }
  }
  return out
}

// checkTypeName reports a type name already taken in the current scope.
export function checkTypeName(mutable c: Checker, pos: Pos, name: string) uses alloc {
  if (lookupType(c, name) is Some(_)) {
    errorf(mutable c, pos, `type ${quoteGo(name)} is declared twice`)
  }
  if (lookupGeneric(c, name) is Some(_)) {
    errorf(mutable c, pos, `type ${quoteGo(name)} is declared twice`)
  }
}

export function declareType(mutable c: Checker, pos: Pos, name: string, t: Type) uses alloc {
  checkTypeName(mutable c, pos, name)
  const s = c.cur
  c.scopes[s].types[name] = t
}

// importModules runs the imports of f in the current module: a package
// module, or else a std module of the registry.
export function importModules(mutable c: Checker, f: File) uses alloc {
  let aliases: Map<string, bool> = Map {}
  for (const imp of Arrays.values(f.imports)) {
    if (importPackageModule(mutable c, imp, mutable aliases)) {
      continue
    }
    if (c.registry.modules[imp.path] is Some(mod)) {
      useModule(mutable c, imp.path)
      const s = c.cur
      if (imp.path == "std/string") {
        // The type is visible only where its runtime C is emitted.
        c.scopes[s].types["StringBuilder"] = Type.TStringBuilder
      }
      bindAlias(mutable c, imp, mutable aliases)
      for (const n of Arrays.values(imp.names)) {
        if (mod.funcs[n.name] is Some(k)) {
          if (c.scopes[s].imported[n.local] is Some(previous)) {
            if (previous != k) {
              errorf(mutable c, imp.pos, `imported name ${quoteGo(n.local)} is already imported from another module; rename one with \`as\``)
              continue
            }
          }
          c.scopes[s].imported[n.local] = k
        } else {
          errorf(mutable c, imp.pos, `module ${quoteGo(imp.path)} has no export ${quoteGo(n.name)}`)
        }
      }
    } else {
      const list = moduleList(c.registry)
      errorf(mutable c, imp.pos, `unknown module ${quoteGo(imp.path)} (this compiler supports ${list})`)
    }
  }
}

// useModule records a std module the program uses, once, in first-import
// order (Go's Program.Modules; the emitter writes their runtime C).
function useModule(mutable c: Checker, path: string) uses alloc {
  for (const p of Arrays.values(c.used)) {
    if (p == path) {
      return
    }
  }
  Arrays.push(mutable c.used, path)
}

// sourceScope finds the scope of a package module by path, or -1.
export function sourceScope(c: Checker, path: string): int {
  if (c.scopeIndex[path] is Some(s)) {
    if (c.scopes[s].isSource) {
      return s
    }
  }
  return -1
}

// bindAlias makes the alias of a namespace import visible. aliases holds the
// aliases the current file has bound. Another file of the module may bind an
// alias again for the same path, never for another one.
function bindAlias(mutable c: Checker, imp: ImportDecl, mutable aliases: Map<string, bool>) uses alloc {
  if (imp.alias == "") {
    return
  }
  const cur = c.cur
  if (c.scopes[cur].modules[imp.alias] is Some(prev)) {
    if (prev != imp.path || aliases[imp.alias] is Some(_)) {
      errorf(mutable c, imp.pos, `two imports use the alias ${imp.alias}; give one of them another alias`)
    }
  }
  aliases[imp.alias] = true
  c.scopes[cur].modules[imp.alias] = imp.path
}

// importPackageModule handles an import of a module of this package. It
// returns false when the path is not one, so the caller tries std modules.
function importPackageModule(mutable c: Checker, imp: ImportDecl, mutable aliases: Map<string, bool>): bool uses alloc {
  const s = sourceScope(c, imp.path)
  if (s < 0) {
    const prefix = `${c.pkgName}/`
    if (!c.single && Str.startsWith(imp.path, prefix)) {
      const rest = Str.sliceFrom(imp.path, Str.length(prefix))
      const msg = `unknown module ${quoteGo(imp.path)}; package ${c.pkgName} has no file src/${rest}.nra`
      errorf(mutable c, imp.pos, msg)
      return true
    }
    return false
  }
  const cur = c.cur
  bindAlias(mutable c, imp, mutable aliases)
  for (const n of Arrays.values(imp.names)) {
    if (c.checkingBodies && isConstructorImport(c, s, n.name)) {
      // Go reports E0425 at the name, whose position the Narra AST lacks.
      unsupported(mutable c, imp.pos, "an import of a constructor (selfhost-check-calls)")
      continue
    }
    const d = exported(mutable c, imp.pos, s, n.name)
    match (d) {
      Some(decl) => importDecl(mutable c, imp.pos, s, n.name, n.local, decl)
      None => {}
    }
  }
  return true
}

// importDecl makes the exported declaration n of scope s visible in the
// current module.
function importDecl(mutable c: Checker, pos: Pos, s: int, n: string, local: string, d: Decl) uses alloc {
  const cur = c.cur
  match (d) {
    Decl.Func(_) => {
      if (c.scopes[cur].funcs[local] is Some(_)) {
        errorf(mutable c, pos, `function ${quoteGo(local)} is declared twice`)
      }
      if (c.scopes[s].funcs[n] is Some(k)) {
        c.scopes[cur].funcs[local] = k
      }
    }
    Decl.Const(_) => {
      if (c.scopes[s].consts[n] is Some(k)) {
        importConst(mutable c, pos, local, k)
      }
    }
    Decl.Trait(_) => {
      if (c.scopes[s].traits[n] is Some(ti)) {
        if (c.traits[ti].module == c.scopes[s].path) {
          importTrait(mutable c, pos, local, ti)
        }
      }
    }
    Decl.Distinct(_) => importType(mutable c, pos, s, n, local)
    Decl.Struct(_) => importNamedType(mutable c, pos, s, n, local)
    Decl.Enum(_) => importNamedType(mutable c, pos, s, n, local)
    _ => {}
  }
}

function importType(mutable c: Checker, pos: Pos, s: int, n: string, local: string) uses alloc {
  if (c.scopes[s].types[n] is Some(t)) {
    declareType(mutable c, pos, local, t)
  } else {
    checkTypeName(mutable c, pos, local)
  }
}

// importNamedType imports a struct or enum: a generic template by its
// Checker.generics index, or a type.
function importNamedType(mutable c: Checker, pos: Pos, s: int, n: string, local: string) uses alloc {
  if (c.scopes[s].generics[n] is Some(g)) {
    if (c.scopes[s].types[n] is None) {
      if (lookupType(c, local) is Some(_) || lookupGeneric(c, local) is Some(_)) {
        errorf(mutable c, pos, `type ${quoteGo(local)} is declared twice`)
      }
      const cur = c.cur
      c.scopes[cur].generics[local] = g
      return
    }
  }
  importType(mutable c, pos, s, n, local)
}

// exported returns the exported declaration n of scope s, or reports why it
// cannot be used and returns None.
export function exported(mutable c: Checker, pos: Pos, s: int, n: string): Option<Decl> uses alloc {
  if (c.scopes[s].exports[n] is Some(k)) {
    return Some(c.scopes[s].decls[k])
  }
  const path = c.scopes[s].path
  for (const d of Arrays.values(c.scopes[s].decls)) {
    if (declName(d) == n) {
      errorf(mutable c, pos, `${quoteGo(n)} is not exported by module ${quoteGo(path)}; add \`export\` to its declaration`)
      return None
    }
  }
  errorf(mutable c, pos, `module ${quoteGo(path)} has no export ${quoteGo(n)}`)
  return None
}

// importTrait makes the exported trait ti visible by name.
function importTrait(mutable c: Checker, pos: Pos, n: string, ti: int) uses alloc {
  if (lookupTrait(c, n) >= 0 || lookupType(c, n) is Some(_) || lookupGeneric(c, n) is Some(_)) {
    errorf(mutable c, pos, `${quoteGo(n)} is declared twice`)
    return
  }
  const cur = c.cur
  c.scopes[cur].traits[n] = ti
}

// importConst makes the exported constant k visible by name.
function importConst(mutable c: Checker, pos: Pos, n: string, k: int) uses alloc {
  const cur = c.cur
  if (c.scopes[cur].consts[n] is Some(_) || typeNamed(c, n)) {
    errorf(mutable c, pos, `constant ${quoteGo(n)} is declared twice`)
    return
  }
  c.scopes[cur].consts[n] = k
}

// typeNamed reports whether name is a type or trait of the current module.
export function typeNamed(c: Checker, name: string): bool {
  return lookupType(c, name) is Some(_) || lookupGeneric(c, name) is Some(_) || lookupTrait(c, name) >= 0
}

// checkImportedConsts reports an imported constant whose name the module
// later gave to a type: the import ran before the module's types existed.
export function checkImportedConsts(mutable c: Checker, f: File) uses alloc {
  const cur = c.cur
  const path = c.scopes[cur].path
  for (const imp of Arrays.values(f.imports)) {
    for (const n of Arrays.values(imp.names)) {
      if (c.scopes[cur].consts[n.local] is Some(k)) {
        if (c.consts[k].module != path && typeNamed(c, n.local)) {
          errorf(mutable c, imp.pos, `constant ${quoteGo(n.local)} is declared twice`)
        }
      }
    }
  }
}

// checkEntries finds the entry function of each binary and reports one
// with the wrong signature (Go's entryFunc and checkEntry in CheckPackage).
export function checkEntries(mutable c: Checker, pkg: Package) uses alloc {
  for (const b of Arrays.values(pkg.binaries)) {
    const k = entryFunc(c, pkg, b.entry)
    if (k >= 0) {
      const fs = c.funcs[k].scope
      const saved = enter(mutable c, fs)
      checkEntry(mutable c, k)
      enter(mutable c, saved)
    }
    const info = EntryInfo { binary: b.name, func: k }
    Arrays.push(mutable c.entries, info)
  }
}

// entryFunc finds the exported function an entry names, or -1.
function entryFunc(c: Checker, pkg: Package, entry: string): int uses alloc {
  const target = entryModule(pkg, entry)
  const #[mod, fn] = target
  const s = sourceScope(c, mod)
  if (s < 0) {
    return -1
  }
  if (c.scopes[s].exports[fn] is Some(d)) {
    if (c.scopes[s].decls[d] is Decl.Func(fd)) {
      if (c.scopes[s].funcs[fn] is Some(k)) {
        if (c.funcs[k].decl.pos == fd.pos && c.funcs[k].scope == s) {
          return k
        }
      }
    }
  }
  return -1
}

function checkEntry(mutable c: Checker, k: int) uses alloc {
  const fd = c.funcs[k].decl
  let ok = Arrays.length(fd.params) == 1 && c.funcs[k].result == Type.TInt
  if (ok) {
    const p = fd.params[0]
    ok = c.paramTypes[p.id] == Type.TArray(Type.TStr) && !p.isMutable
  }
  if (!ok) {
    errorf(mutable c, fd.pos, `the entry function must be \`export function ${fd.name}(args: Array<string>): int\``)
  }
}

// isConstructorImport reports `import { Teacher }` where Teacher is not an
// export of the module but a constructor of an exported enum (Go's
// ctorImport).
function isConstructorImport(checker: Checker, moduleScope: int, name: string): bool {
  if (checker.scopes[moduleScope].exports[name] is Some(_)) {
    return false
  }
  for (const decl of Arrays.values(checker.scopes[moduleScope].decls)) {
    if (decl is Decl.Enum(enumDecl)) {
      if (enumDecl.exported) {
        for (const variant of Arrays.values(enumDecl.variants)) {
          if (variant.name == name) {
            return true
          }
        }
      }
    }
  }
  return false
}

// The std modules whose functions are called as Name.f, by the prelude
// type name, with the plural alias the convention gives them (Go's
// namespaceModules and pluralAlias).
struct Namespace {
  name: string
  path: string
  plural: string
}

const NAMESPACES = [
  Namespace { name: "Array", path: "std/array", plural: "Arrays" },
  Namespace { name: "Box", path: "std/box", plural: "Boxes" },
  Namespace { name: "Map", path: "std/map", plural: "Maps" },
  Namespace { name: "Option", path: "std/option", plural: "Options" },
  Namespace { name: "Range", path: "std/range", plural: "Ranges" },
  Namespace { name: "Result", path: "std/result", plural: "Results" },
]

// isNamespaceName reports a prelude type whose functions live in a std
// module (Array, Box, Map, Option, Range, Result).
export function isNamespaceName(name: string): bool {
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == name) {
      return true
    }
  }
  return false
}

// aliasTaken reports whether name is a type, a trait or a prelude
// namespace type visible in the module.
function aliasTaken(checker: Checker, name: string): bool {
  return typeNamed(checker, name) || isNamespaceName(name)
}

// suggestAlias is the alias the alias-equals-type error suggests: the
// plural of a namespace type, or of the std module the import names, or the
// alias with an s.
function suggestAlias(alias: string, path: string): string uses alloc {
  let suggestion = ""
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.name == alias) {
      suggestion = namespace.plural
    }
  }
  for (const namespace of Arrays.values(NAMESPACES)) {
    if (namespace.path == path) {
      suggestion = namespace.plural
    }
  }
  if (suggestion == "") {
    return `${alias}s`
  }
  return suggestion
}

// checkImportNames runs after the module's type names are declared. It
// reports an alias that equals a type name (E0421) and an imported name
// that clashes with a declaration, an alias or a type (E0423). Go's fixes
// are not ported.
export function checkImportNames(mutable checker: Checker, file: File) uses alloc {
  // An alias may not be a type name.
  for (const importDecl of Arrays.values(file.imports)) {
    if (importDecl.alias == "" || !aliasTaken(checker, importDecl.alias)) {
      continue
    }
    const suggestion = suggestAlias(importDecl.alias, importDecl.path)
    errorf(mutable checker, importDecl.pos, `the import alias ${importDecl.alias} is also a type name; rename it, for example \`import * as ${suggestion} from ${quoteGo(importDecl.path)}\``)
  }

  // An imported name may not clash with the module's functions, constants,
  // aliases or types.
  let declared: Map<string, bool> = Map {}
  for (const decl of Arrays.values(file.decls)) {
    if (decl is Decl.Func(funcDecl)) {
      declared[funcDecl.name] = true
    }
  }
  const scope = checker.cur
  for (const importDecl of Arrays.values(file.imports)) {
    const moduleScope = sourceScope(checker, importDecl.path)
    for (const name of Arrays.values(importDecl.names)) {
      const isAlias = checker.scopes[scope].modules[name.local] is Some(_)
      if (moduleScope >= 0) {
        // A type or trait import is itself in the type table, and the
        // import reports a function or constant that clashes with a
        // declaration. A function can still clash with a type declared
        // later or with an alias.
        if (!isExportedFunc(checker, moduleScope, name.name)) {
          continue
        }
        if (isAlias || aliasTaken(checker, name.local)) {
          errorf(mutable checker, importDecl.pos, `imported name ${quoteGo(name.local)} is already declared in this module; rename the import with \`as\``)
        }
        continue
      }
      const isConst = checker.scopes[scope].consts[name.local] is Some(_)
      if (declared[name.local] is Some(_) || isConst || isAlias || aliasTaken(checker, name.local)) {
        errorf(mutable checker, importDecl.pos, `imported name ${quoteGo(name.local)} is already declared in this module; rename the import with \`as\``)
      }
    }
  }
}

function isExportedFunc(checker: Checker, moduleScope: int, name: string): bool {
  if (checker.scopes[moduleScope].exports[name] is Some(index)) {
    return checker.scopes[moduleScope].decls[index] is Decl.Func(_)
  }
  return false
}
