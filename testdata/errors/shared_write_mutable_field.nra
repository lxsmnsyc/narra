// error: clear(mutable game.scores) may change game.scores, which saved still uses at line 25
struct Game {
  scores: Array<int>
  names: Array<string>
}

function clear(mutable scores: Array<int>) {
  scores[0] = 0
}

export function run(_args: Array<string>): int uses alloc {
  let game = Game { scores: [3, 4], names: ["a"] }
  const names = game.names
  // `mutable game.scores` writes only game.scores and what is inside it, so
  // names is not reported.
  clear(mutable game.scores)
  let total = 0
  for (const name of names) {
    if (name == "a") {
      total += 1
    }
  }
  const saved = game.scores
  clear(mutable game.scores)
  return total + saved[0]
}
