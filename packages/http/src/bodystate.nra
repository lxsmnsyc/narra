// The state of a body and the functions the server, client and framing code use on it. This
// module is private: http/body shows the public part, and the other modules make and send
// bodies with the functions here.

import * as Bytes from "std/bytes"
import * as Cells from "std/cell"
import { Cell } from "std/cell"
import { HttpError } from "http/error"

/// The pieces of a body: each Ok value is one piece, and an Err ends the message with that
/// error. The type carries the effects of reading a connection.
export type BodyStream = AsyncGenerator<Result<bytes, HttpError>> uses (io, alloc)

/// Where the content of a body comes from. Held bytes can be read and sent again; a stream is
/// used up by the first read.
enum Source {
  Held(content: bytes)
  Piped(pieces: BodyStream)
}

/// The content of a message. Callers see a stream of bytes. Inside the package the body also
/// knows its length when its source tells it, whether it can be sent again, the most bytes a
/// reader may take from it, and the content type that a sender writes for it.
export opaque struct Body {
  source: Source
  length: Option<int>
  // Set once a piece of an incoming stream has been read, so its length no longer holds.
  used: Option<Cell<bool>>
  limit: Option<int>
  contentType: Option<string>
}

/// A body with no content.
export function empty(): Body {
  return Body {
    source: Source.Held(Bytes.fromString("")),
    length: Some(0),
    used: None,
    limit: None,
    contentType: None,
  }
}

/// A body of the UTF-8 bytes of the text, with the content type text/plain.
export function fromText(text: string): Body {
  const content = Bytes.fromString(text)
  return Body {
    source: Source.Held(content),
    length: Some(Bytes.length(content)),
    used: None,
    limit: None,
    contentType: Some("text/plain; charset=utf-8"),
  }
}

/// A body of the bytes.
export function fromBytes(content: bytes): Body {
  return Body {
    source: Source.Held(content),
    length: Some(Bytes.length(content)),
    used: None,
    limit: None,
    contentType: None,
  }
}

/// A body that the sender reads piece by piece. It has no length and is sent once.
export function fromStream(pieces: BodyStream): Body from pieces {
  return Body {
    source: Source.Piped(pieces),
    length: None,
    used: None,
    limit: None,
    contentType: None,
  }
}

/// The same body with a content type that a sender writes when the message has none.
export function withContentType(body: Body, contentType: string): Body from body {
  return Body {
    source: body.source,
    length: body.length,
    used: body.used,
    limit: body.limit,
    contentType: Some(contentType),
  }
}

/// The same body with a limit on the bytes that a reader takes from it. A limit that the body
/// already has stays when it is lower.
export function limit(body: Body, maxBytes: int): Body from body {
  let tightest = maxBytes
  if (body.limit is Some(existing)) {
    if (existing < tightest) {
      tightest = existing
    }
  }
  return Body {
    source: body.source,
    length: body.length,
    used: body.used,
    limit: Some(tightest),
    contentType: body.contentType,
  }
}

async function* markUsed(
  pieces: BodyStream,
  used: Cell<bool>,
): AsyncGenerator<Result<bytes, HttpError>> uses (io, alloc) {
  // Passes the pieces on, and notes in the cell that a read has started.
  for await (const piece of pieces) {
    Cells.set(used, true)
    yield piece
  }
}

/// A body that arrived on a connection: a stream, with the length that the peer announced and the
/// most bytes that a reader may take from it. Once any of the stream has been read, the length is
/// gone: what is left is not what was announced.
export function fromIncoming(
  pieces: BodyStream,
  length: Option<int>,
  maxBytes: int,
): Body from pieces uses alloc {
  if (length is Some(_)) {
    const used = Cells.create(false)
    return Body {
      source: Source.Piped(markUsed(pieces, used)),
      length,
      used: Some(used),
      limit: Some(maxBytes),
      contentType: None,
    }
  }
  return Body {
    source: Source.Piped(pieces),
    length,
    used: None,
    limit: Some(maxBytes),
    contentType: None,
  }
}

/// The length of the body in bytes when its source knows it and the body is whole. None means
/// the length is not known, or an incoming stream has been read, so a sender frames the body as
/// chunked; a body that was read to its end is then sent empty.
export function findLength(body: Body): Option<int> {
  if (body.used is Some(used)) {
    if (Cells.get(used)) {
      return None
    }
  }
  return body.length
}

/// Whether the body can be sent again, as a redirect needs. A body of held bytes can; a stream
/// is used up by one send.
export function isReplayable(body: Body): bool {
  return body.source is Source.Held(_)
}

/// The bytes of a body that holds them, so a writer can send them with the head. None for a
/// stream.
export function findHeldBytes(body: Body): Option<bytes> {
  if (body.source is Source.Held(content)) {
    return Some(content)
  }
  return None
}

/// The stream of a body that is a stream. None for a body of held bytes.
export function findPieces(body: Body): Option<BodyStream> from body {
  if (body.source is Source.Piped(pieces)) {
    return Some(pieces)
  }
  return None
}

/// The content type that a sender writes for the body when the message has none.
export function findContentType(body: Body): Option<string> {
  return body.contentType
}

function isOverLimit(limit: Option<int>, total: int): bool {
  if (limit is Some(maxBytes)) {
    return total > maxBytes
  }
  return false
}

/// Every byte of the body. It reads the stream to its end, and gives TooLarge("body") as soon as
/// more bytes have come than the limit of the body allows. A body of bytes can be read again; a
/// stream is used up afterwards, and a second read of it gives no bytes.
export async function readAll(body: Body): Result<bytes, HttpError> uses io, alloc {
  if (body.source is Source.Held(content)) {
    if (isOverLimit(body.limit, Bytes.length(content))) {
      return Err(HttpError.TooLarge("body"))
    }
    return Ok(content)
  }
  let content = Bytes.fromString("")
  for await (const piece of chunks(body)) {
    if (piece is Err(error)) {
      return Err(error)
    }
    content = Bytes.concat(content, piece.value)
  }
  return Ok(content)
}

/// The body as one stream of pieces: its bytes when it holds them, otherwise the pieces of its
/// stream. An Err of TooLarge("body") ends the stream when more bytes have come than the limit of
/// the body allows.
export async function* chunks(
  body: Body,
): AsyncGenerator<Result<bytes, HttpError>> uses (io, alloc) {
  if (body.source is Source.Held(content)) {
    if (isOverLimit(body.limit, Bytes.length(content))) {
      yield Err(HttpError.TooLarge("body"))
      return
    }
    if (Bytes.length(content) > 0) {
      yield Ok(content)
    }
  }
  if (body.source is Source.Piped(pieces)) {
    let total = 0
    for await (const piece of pieces) {
      if (piece is Ok(content)) {
        total += Bytes.length(content)
        if (isOverLimit(body.limit, total)) {
          yield Err(HttpError.TooLarge("body"))
          return
        }
      }
      yield piece
    }
  }
}
