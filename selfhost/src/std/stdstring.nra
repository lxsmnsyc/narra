    name: "Str.sliceFrom",
    module: "std/string",
    key: "sliceFrom",
    parameters: ["string", "int"],
    parameterNames: ["text", "start"],
    result: "string",
    effects: ["alloc"],
    doc: "Returns the text from byte offset `start` to the end. Panics when `start` is outside the text or inside a character.",
