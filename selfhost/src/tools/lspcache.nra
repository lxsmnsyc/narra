// The incremental check of narrac lsp. The server keeps the parsed sources
// (Modules.ParseCache) and, per module, the errors of the last check. After a
// change it checks the bodies of the changed modules only, and of the modules
// that import them, directly or not, when a change touches more than function
// bodies (SPEC section 4: other modules check against exported signatures
// only). The other modules are declared again but their bodies are skipped,
// and their errors come from the cache.
//
// A module's errors come in four phases, in the order the full check reports
// them: the check (declarations, defaults, bodies, instances, entries,
// finish), the unused check (only when the package has no check error), the
// effect pass (only when it has no error at all) and the shared writes (every
// body, always). Each module keeps the errors of its file for the first two
// and the last; the unused list is known, and the effect pass found nothing,
// only once a check ran that phase for the module's current text. A module
// whose list is missing is checked again. The shared writes of a module depend
// only on its own bodies and the signatures it imports, so they are found
// again exactly when its bodies are checked again.
//
// The check falls back to the whole package when the incremental result could
// differ from it: the module list changed, an error lies outside every module
// file, a generic struct default or generic function instance has an error
// (other modules' bodies queue those), or the effect pass found an error (it
// stops the pass for every module).
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Io from "std/io"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { Decl } from "narrac/syntax/ast"
import { importsBuildModule } from "narrac/check/buildconditions"
import { BuildTarget, createUnknownTarget, detectHostTarget } from "narrac/driver/buildtarget"
import * as Body from "narrac/check/body"
import { CheckError } from "narrac/check/check"
import * as Effects from "narrac/check/effects"
import { TokenKind, lex } from "narrac/syntax/lexer"
import * as Modules from "narrac/driver/modules"
import { Package, ParseCache, SourceModule } from "narrac/driver/modules"
import { LoadError } from "narrac/driver/manifest"
import { checkConstants } from "narrac/check/consteval"
import { reportSharedWrites } from "narrac/check/sharedwrites"
import * as Sets from "std/set"
import { Set } from "std/set"

// What the cache keeps of one module: the module it checked and its errors.
// A changed source is parsed with new ids, so an equal firstId means an equal
// text.
struct ModuleResult {
  module: SourceModule
  checkErrors: Array<CheckError>
  unusedErrors: Array<CheckError>
  sharedWriteErrors: Array<CheckError>
  unusedKnown: bool
  effectsKnown: bool // the effect pass ran on it and found no error
}

// The state narrac lsp keeps between checks. results holds the modules of the
// last checked package by module path, paths their load order, and valid is
// false until a whole-package check filled them. full makes every check a
// whole-package check (`narrac lsp --full`); trace writes one line per check
// to the standard error (`narrac lsp --trace`).
export struct CheckCache {
  parses: ParseCache
  liveIds: int
  paths: Map<string, Array<string>>
  results: Map<string, ModuleResult>
  valid: Set<string>
  full: bool
  trace: bool
  // The host target, read once per server process.
  hostTarget: Option<BuildTarget> = None
}

export function createCheckCache(): CheckCache uses alloc {
  return CheckCache {
    parses: Modules.createParseCache(),
    liveIds: 0,
    paths: Map {},
    results: Map {},
    valid: Sets.create(),
    full: false,
    trace: false,
  }
}

export function loadPackage(
  mutable cache: CheckCache,
  path: string,
  overrides: Map<string, string>,
): Result<Package, Array<LoadError>> from cache uses io, alloc {
  // Each changed source takes new ids; when they pass four times the ids the package uses, the
  // cache starts over and the next check is whole.
  if (cache.parses.nextId > 4 * cache.liveIds + 100000) {
    cache.parses = Modules.createParseCache()
    cache.valid = Sets.create()
  }
  const loaded = Modules.loadCached(path, overrides, mutable cache.parses)
  if (loaded is Ok(package)) {
    let live = 0
    for (const module of Arrays.values(package.modules)) {
      live = live + module.endId - module.firstId
    }
    cache.liveIds = live
  }
  return loaded
}

export function checkLoaded(
  mutable cache: CheckCache,
  package: Package,
): Array<CheckError> from cache uses io, alloc {
  // Cached results are reused where they cannot change. Each file's errors come in the order
  // of a whole check.
  if (!cache.full && canReuse(cache, package)) {
    const first = checkChanged(mutable cache, package, Sets.create())
    match (first) {
      Ok(errors) => {
        return errors
      }
      Err(missing) => {
        // Check again with the modules whose unused or effect list was missing.
        if (Arrays.length(missing) > 0) {
          let extra: Set<string> = Sets.create()
          for (const path of Arrays.values(missing)) {
            Sets.add(mutable extra, path)
          }
          const second = checkChanged(mutable cache, package, extra)
          if (second is Ok(errors)) {
            return errors
          }
        }
      }
    }
  }
  return copy(checkWhole(mutable cache, package))
}

function makeResultKey(package: Package, modulePath: string): string uses alloc {
  return `${package.directory}\n${modulePath}`
}

function canReuse(cache: CheckCache, package: Package): bool {
  if (!Sets.has(cache.valid, package.directory)) {
    return false
  }
  const known = cache.paths[package.directory]
  if (known is None) {
    return false
  }
  if (Arrays.length(known.value) != Arrays.length(package.modules)) {
    return false
  }
  let index = 0
  for (const module of Arrays.values(package.modules)) {
    if (known.value[index] != module.path) {
      return false
    }
    index++
  }
  return true
}

function chooseServerTarget(
  mutable cache: CheckCache,
  package: Package,
): BuildTarget uses io, alloc {
  // The language server checks for the host, in debug mode.
  if (!importsBuildModule(package)) {
    return createUnknownTarget(true)
  }
  if (cache.hostTarget is Some(known)) {
    return copy(known)
  }
  const detected = detectHostTarget(true)
  cache.hostTarget = Some(copy(detected))
  return detected
}

function checkWhole(
  mutable cache: CheckCache,
  package: Package,
): Array<CheckError> from package uses io, alloc {
  const target = chooseServerTarget(mutable cache, package)
  const result = Body.checkModules(package, Sets.create(), target)
  let checker = copy(result.checker)
  const unusedRan = result.unusedStart == 0
  const checkCount = Arrays.length(checker.errors)
  const effectsRan = checkCount == 0
  if (effectsRan) {
    const effects = Effects.checkEffects(mutable checker)
    checkConstants(mutable checker, effects)
  }
  const effectsEnd = Arrays.length(checker.errors)
  reportSharedWrites(mutable checker)
  const errors = checker.errors
  let moduleFiles: Set<string> = Sets.create()
  for (const module of Arrays.values(package.modules)) {
    Sets.add(mutable moduleFiles, module.file)
  }
  // Every error must lie in a module file to be kept by module. An effect
  // error stops the effect pass for every module, so the results are reused
  // only when there is none.
  let attributable = result.queuedErrors == 0 && effectsEnd == checkCount
  for (const error of Arrays.values(errors)) {
    attributable = attributable && Sets.has(moduleFiles, error.file)
  }
  // The results of the last check of this package go before the new ones are written.
  const keyPrefix = `${package.directory}\n`
  let staleKeys: Array<string> = []
  for (const key of Arrays.values(Maps.keys(cache.results))) {
    if (Str.startsWith(key, keyPrefix)) {
      Arrays.push(mutable staleKeys, key)
    }
  }
  for (const key of Arrays.values(staleKeys)) {
    const _removed = Maps.remove(mutable cache.results, key)
  }
  let paths: Array<string> = []
  for (const module of Arrays.values(package.modules)) {
    Arrays.push(mutable paths, module.path)
    cache.results[makeResultKey(package, module.path)] = ModuleResult {
      module,
      checkErrors: selectErrors(errors, 0, result.unusedStart, module.file),
      unusedErrors: selectErrors(errors, result.unusedStart, checkCount, module.file),
      sharedWriteErrors: selectErrors(errors, effectsEnd, Arrays.length(errors), module.file),
      unusedKnown: unusedRan,
      effectsKnown: effectsRan,
    }
  }
  cache.paths[package.directory] = paths
  if (attributable) {
    Sets.add(mutable cache.valid, package.directory)
  } else {
    const _removed = Sets.remove(mutable cache.valid, package.directory)
  }
  writeTrace(cache, "whole package")
  return errors
}

function selectErrors(
  errors: Array<CheckError>,
  start: int,
  end: int,
  file: string,
): Array<CheckError> from errors uses alloc {
  let selected: Array<CheckError> = []
  for (const index of Ranges.upTo(Arrays.length(errors))) {
    if (index >= start && index < end && errors[index].file == file) {
      Arrays.push(mutable selected, errors[index])
    }
  }
  return selected
}

function checkChanged(
  mutable cache: CheckCache,
  package: Package,
  extra: Set<string>,
): Result<Array<CheckError>, Array<string>> from cache uses io, alloc {
  // An Err lists the modules to add to extra, the modules checked anyway, and is empty when
  // the whole package must be checked.
  const target = chooseServerTarget(mutable cache, package)
  // The changed modules, and those whose signature changed.
  let dirty = copy(extra)
  let reach: Array<string> = []
  let results: Array<ModuleResult> = []
  for (const module of Arrays.values(package.modules)) {
    const cached = cache.results[makeResultKey(package, module.path)]
    if (cached is None) {
      return Err([])
    }
    Arrays.push(mutable results, cached.value)
    if (cached.value.module.firstId != module.firstId) {
      Sets.add(mutable dirty, module.path)
      if (makeSignature(module) != makeSignature(cached.value.module)) {
        Arrays.push(mutable reach, module.path)
      }
    }
  }
  addImporters(mutable dirty, package, reach)

  // The others are declared but not checked.
  let skipped: Set<string> = Sets.create()
  let dirtyFiles: Set<string> = Sets.create()
  let moduleFiles: Set<string> = Sets.create()
  let checkedNames: Array<string> = []
  for (const module of Arrays.values(package.modules)) {
    Sets.add(mutable moduleFiles, module.file)
    if (Sets.has(dirty, module.path)) {
      Sets.add(mutable dirtyFiles, module.file)
      Arrays.push(mutable checkedNames, module.file)
    } else {
      Sets.add(mutable skipped, module.path)
    }
  }
  const result = Body.checkModules(package, skipped, target)
  if (result.queuedErrors > 0) {
    return Err([])
  }
  let checker = copy(result.checker)
  let checkCount = 0
  let unusedCount = 0
  for (const index of Ranges.upTo(Arrays.length(checker.errors))) {
    const error = checker.errors[index]
    if (!Sets.has(moduleFiles, error.file)) {
      return Err([])
    }
    if (Sets.has(dirtyFiles, error.file)) {
      if (index < result.unusedStart) {
        checkCount++
      } else {
        unusedCount++
      }
    }
  }
  for (const index of Ranges.upTo(Arrays.length(package.modules))) {
    if (!Sets.has(dirty, package.modules[index].path)) {
      checkCount += Arrays.length(results[index].checkErrors)
    }
  }

  // The unused check runs when no module has a check error. It ran here only
  // if the declarations of the skipped modules gave no error either.
  const unusedRuns = checkCount == 0
  if (unusedRuns) {
    if (result.unusedStart != 0) {
      return Err([])
    }
    let missing: Array<string> = []
    for (const index of Ranges.upTo(Arrays.length(package.modules))) {
      const path = package.modules[index].path
      if (!Sets.has(dirty, path)) {
        if (!results[index].unusedKnown) {
          Arrays.push(mutable missing, path)
        }
        unusedCount += Arrays.length(results[index].unusedErrors)
      }
    }
    if (Arrays.length(missing) > 0) {
      return Err(missing)
    }
  }

  // The effect pass runs when no module has an error; the checker then holds
  // none either (the unused check left out the skipped modules).
  const effectsRun = unusedRuns && unusedCount == 0
  const errors = copy(checker.errors)
  if (effectsRun) {
    let missing: Array<string> = []
    for (const index of Ranges.upTo(Arrays.length(package.modules))) {
      const path = package.modules[index].path
      if (!Sets.has(dirty, path) && !results[index].effectsKnown) {
        Arrays.push(mutable missing, path)
      }
    }
    if (Arrays.length(missing) > 0) {
      return Err(missing)
    }
    const effects = Effects.checkEffects(mutable checker)
    checkConstants(mutable checker, effects)
    // An effect error stops the pass for every module (checkWhole).
    if (Arrays.length(checker.errors) > 0) {
      return Err([])
    }
  }

  // Only the checked modules have bodies, so every shared write lies in one of them.
  const sharedStart = Arrays.length(checker.errors)
  reportSharedWrites(mutable checker)
  const sharedErrors = copy(checker.errors)

  // Store the results of the checked modules.
  for (const index of Ranges.upTo(Arrays.length(package.modules))) {
    const module = package.modules[index]
    if (Sets.has(dirty, module.path)) {
      results[index] = ModuleResult {
        module,
        checkErrors: selectErrors(errors, 0, result.unusedStart, module.file),
        unusedErrors: selectErrors(errors, result.unusedStart, Arrays.length(errors), module.file),
        sharedWriteErrors: selectErrors(
          sharedErrors,
          sharedStart,
          Arrays.length(sharedErrors),
          module.file,
        ),
        unusedKnown: unusedRuns,
        effectsKnown: effectsRun,
      }
      cache.results[makeResultKey(package, module.path)] = results[index]
    }
  }
  if (Arrays.length(checkedNames) == 0) {
    writeTrace(cache, "no module changed")
  } else {
    writeTrace(cache, `modules ${Str.join(checkedNames, " ")}`)
  }

  // The errors, phase by phase, module by module. The effect pass gave none.
  let merged: Array<CheckError> = []
  for (const moduleResult of Arrays.values(results)) {
    appendErrors(mutable merged, moduleResult.checkErrors)
  }
  if (unusedRuns) {
    for (const moduleResult of Arrays.values(results)) {
      appendErrors(mutable merged, moduleResult.unusedErrors)
    }
  }
  for (const moduleResult of Arrays.values(results)) {
    appendErrors(mutable merged, moduleResult.sharedWriteErrors)
  }
  return copy(Ok(merged))
}

function appendErrors(mutable merged: Array<CheckError>, errors: Array<CheckError>) uses alloc {
  for (const error of Arrays.values(errors)) {
    Arrays.push(mutable merged, error)
  }
}

function addImporters(
  mutable dirty: Set<string>,
  package: Package,
  reach: Array<string>,
) uses alloc {
  let reached: Set<string> = Sets.create()
  let queue = copy(reach)
  let next = 0
  while (next < Arrays.length(queue)) {
    const target = queue[next]
    next++
    for (const module of Arrays.values(package.modules)) {
      if (Sets.has(reached, module.path)) {
        continue
      }
      for (const importDecl of Arrays.values(module.ast.imports)) {
        if (importDecl.path == target) {
          Sets.add(mutable reached, module.path)
          Sets.add(mutable dirty, module.path)
          Arrays.push(mutable queue, module.path)
          break
        }
      }
    }
  }
}

function makeSignature(module: SourceModule): string uses alloc {
  // A source that does not lex gives its whole text.
  const source = module.ast.facts.source
  const lexed = lex(source)
  if (lexed is Err(_)) {
    return source
  }
  const tokens = lexed.value
  // The positions of the opening braces of the bodies to leave out.
  let bodyStarts: Set<string> = Sets.create()
  for (const declaration of Arrays.values(module.ast.declarations)) {
    if (declaration is Decl.Func(funcDecl)) {
      if (Arrays.length(funcDecl.typeParameters) == 0) {
        if (funcDecl.body is Some(block)) {
          Sets.add(
            mutable bodyStarts,
            `${Int.toString(block.pos.line)}:${Int.toString(block.pos.column)}`,
          )
        }
      }
    }
  }
  let builder = Str.builder()
  let depth = 0
  for (const token of Arrays.values(tokens)) {
    if (depth > 0) {
      if (token.kind == TokenKind.TokPunct && token.text == "{") {
        depth++
      } else if (token.kind == TokenKind.TokPunct && token.text == "}") {
        depth--
      }
      continue
    }
    if (token.kind == TokenKind.TokPunct && token.text == "{") {
      if (Sets.has(bodyStarts, `${Int.toString(token.line)}:${Int.toString(token.column)}`)) {
        depth = 1
        Str.append(mutable builder, "{}\n")
        continue
      }
    }
    Str.append(mutable builder, token.text)
    Str.append(mutable builder, "\n")
  }
  return Str.build(builder)
}

function writeTrace(cache: CheckCache, text: string) uses io, alloc {
  if (cache.trace) {
    Io.writeError(`check: ${text}\n`)
  }
}
