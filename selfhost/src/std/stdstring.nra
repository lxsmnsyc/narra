// The registry rows and emitters of std/string.
import { StdFunc, StdType } from "narrac/std/builtins"
import { Type } from "narrac/check/types"
import { Pos, Arg } from "narrac/syntax/ast"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  writeLine,
  temp,
  ownedTemp,
  readNodeType,
  declareVariable,
  variableRef,
  useHelper,
} from "narrac/emit/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  arrayStruct,
  findVariant,
  variantFieldType,
  ioEither,
  emitOptionOut,
} from "narrac/std/stdemithelp"
import * as Arrays from "std/array"
import * as Int from "std/int"

export const STRING_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Str.append",
    module: "std/string",
    key: "append",
    parameters: ["StringBuilder", "string"],
    parameterNames: ["builder", "text"],
    mutables: [true, false],
    result: "void",
    effects: ["alloc"],
    doc: "Adds the text to the end of the builder. A builder that another value shares is copied first, so the other copy does not change.",
  },
  StdFunc {
    name: "Str.appendChar",
    module: "std/string",
    key: "appendChar",
    parameters: ["StringBuilder", "char"],
    parameterNames: ["builder", "character"],
    mutables: [true, false],
    result: "void",
    effects: ["alloc"],
    doc: "Adds one character, encoded as UTF-8, to the end of the builder.",
  },
  StdFunc {
    name: "Str.build",
    module: "std/string",
    key: "build",
    parameters: ["StringBuilder"],
    parameterNames: ["builder"],
    result: "string",
    effects: ["alloc"],
    doc: "Returns the text the builder holds as a new string. The builder stays usable.",
  },
  StdFunc {
    name: "Str.builder",
    module: "std/string",
    key: "builder",
    result: "StringBuilder",
    effects: ["alloc"],
    doc: "Creates an empty `StringBuilder`, for building a string from many pieces.",
  },
  StdFunc {
    name: "Str.byteAt",
    module: "std/string",
    key: "byteAt",
    parameters: ["string", "int"],
    parameterNames: ["text", "index"],
    result: "int",
    doc: "Returns the byte at a byte offset, from 0 to 255. Panics when the offset is outside the text.",
  },
  StdFunc {
    name: "Str.charAt",
    module: "std/string",
    key: "charAt",
    parameters: ["string", "int"],
    parameterNames: ["text", "index"],
    result: "char",
    doc: "Returns the character that starts at a byte offset. Panics when the offset is outside the text, at its end, or inside a character.",
  },
  StdFunc {
    name: "Str.charCount",
    module: "std/string",
    key: "charCount",
    parameters: ["string"],
    parameterNames: ["text"],
    result: "int",
    doc: "Returns the number of characters (code points) in the text, which can be less than its `length` in bytes.",
  },
  StdFunc {
    name: "Str.chars",
    module: "std/string",
    key: "chars",
    parameters: ["string"],
    parameterNames: ["text"],
    result: "Array<char>",
    effects: ["alloc"],
    check: "fixed",
    doc: "Returns the characters of the text in order, one for each code point.",
