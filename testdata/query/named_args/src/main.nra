import * as Int from "std/int"
import * as Shapes from "app/shapes"
import { box, ring } from "app/shapes"

function area(): int {
  return box(height: 2, width: 3) + Shapes.box(4, height: 5)
}

export function run(arguments: Array<string>): int uses io, alloc {
  const total = area() + ring(width: 1, radius: 2) + box(1, 2)
  print(`${Int.toString(box(width: 6, height: 7))}`)
  return total
}
