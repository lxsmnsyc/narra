import { ROWS } from "al/tables"
import { ROWS as OTHER } from "al/tables"

export function run(args: Array<string>): int uses alloc {
  const n = ROWS[0][0]
  let r = OTHER
  r[0] = [5]
  return n + r[0][0]
}

function _second(): int uses alloc {
  const n = OTHER[1][0]
  let r = ROWS[1]
  r[0] = 7
  return n + r[0]
}
