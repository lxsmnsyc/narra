import * as Int from "std/int"
import * as Float from "std/float"
import * as Ranges from "std/range"

function fib(n: int): int {
  if (n < 2) {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

function gcd(a: int, b: int): int {
  if (b == 0) {
    return a
  }
  return gcd(b, a % b)
}

export function run(args: Array<string>): int {
  print(Int.toString(fib(20)))
  print(Int.toString(gcd(1071, 462)))
  let total = 0
  for (const i of Ranges.upTo(10)) {
    if (i % 2 == 0) {
      continue
    }
    total = total + i
  }
  print(`odd sum ${Int.toString(total)}`)
  let n = 0
  while (true) {
    n = n + 1
    if (n == 5) {
      break
    }
  }
  print(Int.toString(n))
  print(Float.toString(Float.sqrt(2.0)))
  print(Float.toString(1.5 * 4.0))
  print(Int.toString(-7 / 2))
  print(Int.toString(0xFF + 0b101 + 1_000))
  print(Int.toString(7 +% 1))
  return 0
}
