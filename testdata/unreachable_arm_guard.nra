import * as Int from "std/int"

enum Token {
  Plus
  Minus
}

export function run(args: Array<string>): int {
  const value = 3
  const guarded = match (value) { 3 if (value > 5) => 1, 3 => 2, _ => 3 }
  const token = match (Token.Plus) {
    Token.Plus if (value > 5) => 1
    Token.Plus => 2
    Token.Minus => 3
  }
  const pair = match (#[1, 2]) { #[1, _] => 1, #[_, 2] => 2, #[_, _] => 3 }
  print(Int.toString(guarded + token + pair))
  return 0
}
