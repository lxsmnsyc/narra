// The C of the vector types of std/simd (D112). Each vector type is a C vector
// extension typedef, `typedef float narra_f32x4 __attribute__((vector_size(16),
// aligned(8)));`, written only when the program names the type. Alignment 8
// matches the runtime's heap blocks, which start at 8-byte boundaries, so an
// `Array<F32x4>` element is never misaligned. Operators are C operators on the
// typedefs; signed integer + - * and unary - go through the unsigned twin, because
// C leaves signed overflow undefined. A lane read is `v[i]`; the checker proved i.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import { Expr, Arg } from "narrac/ast"
import { Type, findLaneSize, isUnsignedInteger } from "narrac/types"
import { getExpressionId } from "narrac/check"
import { cachedCType } from "narrac/cnames"
import { findTypedConstant } from "narrac/operands"
import { findUnsignedTwin, findMaskType, isFloatVector } from "narrac/simdtypes"
import {
  Emitter,
  Code,
  EmitWalker,
  writeLine,
  temp,
  readNodeType,
  reportUnsupported,
  useHelper,
  containerName,
  declareVariable,
  variableRef,
} from "narrac/emitstate"
import {
  NODE,
  plain,
  argumentText,
  findVariant,
  variantFieldType,
  ioEither,
} from "narrac/stdemithelp"

function buildTypedef(emitter: Emitter, vector: Type): string uses alloc {
  if (vector is Type.TVector(lane, count)) {
    const name = cachedCType(emitter.checker, emitter.typeNames, vector)
    const laneName = cachedCType(emitter.checker, emitter.typeNames, lane)
    const size = Int.toString(findLaneSize(lane) * count)
    return `typedef ${laneName} ${name} __attribute__((vector_size(${size}), aligned(8)));\n`
  }
  return ""
}

export function emitVectorTypedefs(emitter: Emitter): string uses alloc {
  // A signed integer vector needs its unsigned twin for the wrapping operators.
  let builder = Str.builder()
  let written: Map<string, bool> = Map {}
  for (const entry of Maps.entries(emitter.checker.composites)) {
    const #[_, composite] = entry
    if (!(composite is Type.TVector(_, _))) {
      continue
    }
    for (const vector of Arrays.values([findUnsignedTwin(composite), composite])) {
      const name = cachedCType(emitter.checker, emitter.typeNames, vector)
      if (written[name] is None) {
        written[name] = true
        Str.append(mutable builder, buildTypedef(emitter, vector))
      }
    }
  }
  return Str.build(builder)
}

function isWrapping(vector: Type): bool {
  // Signed integer lanes, whose C overflow is undefined.
  if (vector is Type.TVector(lane, _)) {
    return !isFloatVector(vector) && !isUnsignedInteger(lane)
  }
  return false
}

export function emitVectorLiteral<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  elements: Array<Expr>,
): Code uses alloc {
  const vector = copy(readNodeType(emitter, nodeId))
  let lanes: Array<string> = []
  for (const element of Arrays.values(elements)) {
    Arrays.push(mutable lanes, EmitWalker.emitExpression(walker, mutable emitter, element).text)
  }
  const name = cachedCType(emitter.checker, emitter.typeNames, vector)
  return plain(temp(mutable emitter, vector, `((${name}){${Str.join(lanes, ", ")}})`))
}

export function emitLaneRead<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  target: Expr,
  index: Expr,
): Code uses alloc {
  const vector = copy(readNodeType(emitter, getExpressionId(target)))
  const targetCode = EmitWalker.emitExpression(walker, mutable emitter, target)
  const indexCode = EmitWalker.emitExpression(walker, mutable emitter, index)
  if (vector is Type.TVector(lane, _)) {
    return plain(temp(mutable emitter, lane, `(${targetCode.text})[${indexCode.text}]`))
  }
  return plain("0")
}

export function emitVectorArithmetic(
  emitter: Emitter,
  operator: string,
  vector: Type,
  leftText: string,
  rightText: string,
): Code uses alloc {
  // + - * on signed lanes run on the unsigned twin, which wraps, and cast back.
  if (isWrapping(vector) && (operator == "+" || operator == "-" || operator == "*")) {
    const name = cachedCType(emitter.checker, emitter.typeNames, vector)
    const twin = cachedCType(emitter.checker, emitter.typeNames, findUnsignedTwin(vector))
    return plain(`((${name})((${twin})(${leftText}) ${operator} (${twin})(${rightText})))`)
  }
  return plain(`(${leftText} ${operator} ${rightText})`)
}

export function emitVectorUnary(
  emitter: Emitter,
  operator: string,
  vector: Type,
  value: string,
): Code uses alloc {
  if (isWrapping(vector) && operator == "-") {
    const name = cachedCType(emitter.checker, emitter.typeNames, vector)
    const twin = cachedCType(emitter.checker, emitter.typeNames, findUnsignedTwin(vector))
    return plain(`((${name})(-(${twin})(${value})))`)
  }
  return plain(`(${operator}${value})`)
}

export function buildLaneLoop(vector: Type, statement: string): string uses alloc {
  // Runs statement once per lane, which it names `i`.
  if (vector is Type.TVector(_, count)) {
    return `  for (int i = 0; i < ${Int.toString(count)}; i++) ${statement}`
  }
  return ""
}

function emitSplat<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  // The value is read once, then written to every lane.
  const vector = copy(readNodeType(emitter, nodeId))
  if (vector is Type.TVector(lane, count)) {
    const valueCode = argumentText(walker, mutable emitter, arguments, 0)
    const value = temp(mutable emitter, lane, valueCode)
    let lanes: Array<string> = []
    for (let i = 0; i < count; i++) {
      Arrays.push(mutable lanes, value)
    }
    const name = cachedCType(emitter.checker, emitter.typeNames, vector)
    return plain(temp(mutable emitter, vector, `((${name}){${Str.join(lanes, ", ")}})`))
  }
  return plain("0")
}

function emitCopyBytes<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
  toFixed: bool,
): Code uses alloc {
  // A FixedArray and a vector of the same lanes hold the same bytes.
  const resultType = copy(readNodeType(emitter, nodeId))
  const sourceType = copy(readNodeType(emitter, getExpressionId(arguments[0].value)))
  const sourceCode = argumentText(walker, mutable emitter, arguments, 0)
  const source = temp(mutable emitter, sourceType, sourceCode)
  const resultName = cachedCType(emitter.checker, emitter.typeNames, resultType)
  const result = temp(mutable emitter, resultType, `((${resultName}){0})`)
  if (toFixed) {
    writeLine(mutable emitter, `memcpy(${result}.items, &${source}, sizeof(${source}));`)
  } else {
    writeLine(mutable emitter, `memcpy(&${result}, ${source}.items, sizeof(${result}));`)
  }
  return plain(result)
}

function emitWithLane<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  // The arguments are read in order into a copy, whose lane is then replaced.
  const vector = copy(readNodeType(emitter, nodeId))
  const vectorCode = argumentText(walker, mutable emitter, arguments, 0)
  const result = temp(mutable emitter, vector, vectorCode)
  const indexCode = argumentText(walker, mutable emitter, arguments, 1)
  const index = temp(mutable emitter, Type.TInt, indexCode)
  const value = argumentText(walker, mutable emitter, arguments, 2)
  writeLine(mutable emitter, `${result}[${index}] = ${value};`)
  return plain(result)
}

function holdArguments<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
): Array<string> uses alloc {
  // Each argument is read once, in the written order, into a temporary.
  let held: Array<string> = []
  for (const argument of Arrays.values(arguments)) {
    const argumentType = copy(readNodeType(emitter, getExpressionId(argument.value)))
    const code = EmitWalker.emitExpression(walker, mutable emitter, argument.value)
    Arrays.push(mutable held, temp(mutable emitter, argumentType, code.text))
  }
  return held
}

function nameVector(emitter: Emitter, vector: Type): string uses alloc {
  return cachedCType(emitter.checker, emitter.typeNames, vector)
}

function buildBlend(
  emitter: Emitter,
  vector: Type,
  mask: string,
  ifTrue: string,
  ifFalse: string,
): string uses alloc {
  // Bits of ifTrue where the mask is set, of ifFalse elsewhere, on the unsigned twin of the mask.
  const name = nameVector(emitter, vector)
  const twin = nameVector(emitter, findUnsignedTwin(findMaskType(vector)))
  return `((${name})(((${twin})(${ifTrue}) & (${twin})(${mask})) | ((${twin})(${ifFalse}) & ~(${twin})(${mask}))))`
}

function buildLaneList(emitter: Emitter, vector: Type, lanes: Array<string>): string uses alloc {
  return `((${nameVector(emitter, vector)}){${Str.join(lanes, ", ")}})`
}

const COMPARISON_NAMES = [
  "Simd.equal",
  "Simd.notEqual",
  "Simd.less",
  "Simd.lessOrEqual",
  "Simd.greater",
  "Simd.greaterOrEqual",
]
const COMPARISON_OPERATORS = ["==", "!=", "<", "<=", ">", ">="]

function findComparisonOperator(name: string): string {
  for (const i of Ranges.upTo(Arrays.length(COMPARISON_NAMES))) {
    if (COMPARISON_NAMES[i] == name) {
      return COMPARISON_OPERATORS[i]
    }
  }
  return ""
}

function emitComparison<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
  operator: string,
): Code uses alloc {
  // A C vector comparison gives lanes of -1 and 0 in the signed type of the same shape.
  const mask = copy(readNodeType(emitter, nodeId))
  const held = holdArguments(walker, mutable emitter, arguments)
  const text = `((${nameVector(emitter, mask)})(${held[0]} ${operator} ${held[1]}))`
  return plain(temp(mutable emitter, mask, text))
}

function emitSelect<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const vector = copy(readNodeType(emitter, nodeId))
  const held = holdArguments(walker, mutable emitter, arguments)
  const blend = buildBlend(emitter, vector, held[0], held[1], held[2])
  return plain(temp(mutable emitter, vector, blend))
}

function emitLaneTest<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
  every: bool,
): Code uses alloc {
  // any joins the lane tests with ||, all with &&.
  const vector = copy(readNodeType(emitter, getExpressionId(arguments[0].value)))
  const held = holdArguments(walker, mutable emitter, arguments)
  let joiner = " || "
  if (every) {
    joiner = " && "
  }
  let tests: Array<string> = []
  if (vector is Type.TVector(_, count)) {
    for (let i = 0; i < count; i++) {
      Arrays.push(mutable tests, `${held[0]}[${Int.toString(i)}] != 0`)
    }
  }
  return plain(temp(mutable emitter, Type.TBool, `(${Str.join(tests, joiner)})`))
}

function buildRangeTest(start: string, length: string, count: int): string uses alloc {
  // start + count is never computed, so a large start cannot overflow.
  return `(${start} >= 0 && ${start} <= ${length} - ${Int.toString(count)})`
}

function emitLoad<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const optionType = copy(readNodeType(emitter, nodeId))
  const some = findVariant(emitter, optionType, "Some")
  const none = findVariant(emitter, optionType, "None")
  const vector = copy(variantFieldType(emitter, optionType, some))
  const held = holdArguments(walker, mutable emitter, arguments)
  if (vector is Type.TVector(_, count)) {
    const inRange = temp(
      mutable emitter,
      Type.TBool,
      buildRangeTest(held[1], `${held[0]}->len`, count),
    )
    const name = nameVector(emitter, vector)
    const lanes = temp(mutable emitter, vector, `((${name}){0})`)
    writeLine(
      mutable emitter,
      `if (${inRange}) memcpy(&${lanes}, &${held[0]}->items[${held[1]}], sizeof(${lanes}));`,
    )
    return ioEither(mutable emitter, optionType, inRange, some, [lanes], none, [])
  }
  return plain("0")
}

function emitStore<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
): Code uses alloc {
  // The array is made unique only when the lanes are written.
  const arrayType = copy(readNodeType(emitter, getExpressionId(arguments[0].value)))
  const vector = copy(readNodeType(emitter, getExpressionId(arguments[2].value)))
  const place = EmitWalker.emitLvaluePointer(walker, mutable emitter, arguments[0].value)
  const arrayName = cachedCType(emitter.checker, emitter.typeNames, arrayType)
  emitter.tempCount++
  const pointerName = `t${Int.toString(emitter.tempCount)}`
  const declaration = declareVariable(mutable emitter, `${arrayName}*`, pointerName)
  writeLine(mutable emitter, `${declaration} = ${place};`)
  const pointer = variableRef(emitter, pointerName)
  const startCode = argumentText(walker, mutable emitter, arguments, 1)
  const start = temp(mutable emitter, Type.TInt, startCode)
  const lanesCode = argumentText(walker, mutable emitter, arguments, 2)
  const lanes = temp(mutable emitter, vector, lanesCode)
  if (vector is Type.TVector(_, count)) {
    const inRange = temp(
      mutable emitter,
      Type.TBool,
      buildRangeTest(start, `(*${pointer})->len`, count),
    )
    const uniqueHelper = useHelper(emitter, containerName(emitter, arrayType), "unique")
    writeLine(mutable emitter, `if (${inRange}) {`)
    emitter.indent++
    writeLine(mutable emitter, `*${pointer} = ${uniqueHelper}(*${pointer});`)
    writeLine(
      mutable emitter,
      `memcpy(&(*${pointer})->items[${start}], &${lanes}, sizeof(${lanes}));`,
    )
    emitter.indent--
    writeLine(mutable emitter, "}")
    return plain(inRange)
  }
  return plain("false")
}

function emitShuffle<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  // Lane reads in a compound literal; clang and gcc turn them into one shuffle.
  const vector = copy(readNodeType(emitter, nodeId))
  const valueCode = argumentText(walker, mutable emitter, arguments, 0)
  const value = temp(mutable emitter, vector, valueCode)
  let lanes: Array<string> = []
  if (arguments[1].value is Expr.ArrayLit(_, _, elements, _)) {
    for (const element of Arrays.values(elements)) {
      let lane = 0
      if (findTypedConstant(emitter.checker, element, Type.TInt) is Some(constant)) {
        lane = constant
      }
      Arrays.push(mutable lanes, `${value}[${Int.toString(lane)}]`)
    }
  }
  const shuffled = buildLaneList(emitter, vector, lanes)
  return plain(temp(mutable emitter, vector, shuffled))
}

function emitSum<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  // The high half is added to the low half until one lane is left; integer
  // lanes are added on the unsigned twin, which wraps.
  const lane = copy(readNodeType(emitter, nodeId))
  const vector = copy(readNodeType(emitter, getExpressionId(arguments[0].value)))
  const twin = findUnsignedTwin(vector)
  const value = argumentText(walker, mutable emitter, arguments, 0)
  const twinName = nameVector(emitter, twin)
  const lanes = temp(mutable emitter, twin, `((${twinName})(${value}))`)
  let terms: Array<string> = []
  if (vector is Type.TVector(_, count)) {
    for (let i = 0; i < count; i++) {
      Arrays.push(mutable terms, `${lanes}[${Int.toString(i)}]`)
    }
  }
  const twinLane = match (twin) { Type.TVector(unsignedLane, _) => unsignedLane, _ => lane }
  const twinLaneName = cachedCType(emitter.checker, emitter.typeNames, twinLane)
  while (Arrays.length(terms) > 1) {
    const half = Arrays.length(terms) / 2
    let folded: Array<string> = []
    for (let i = 0; i < half; i++) {
      Arrays.push(mutable folded, `(${twinLaneName})(${terms[i]} + ${terms[i + half]})`)
    }
    terms = folded
  }
  const laneName = cachedCType(emitter.checker, emitter.typeNames, lane)
  return plain(temp(mutable emitter, lane, `((${laneName})(${terms[0]}))`))
}

function emitMinMax<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
  isMin: bool,
): Code uses alloc {
  // min takes a where a < b, max takes a where b < a; b elsewhere.
  const vector = copy(readNodeType(emitter, nodeId))
  const held = holdArguments(walker, mutable emitter, arguments)
  const maskName = nameVector(emitter, findMaskType(vector))
  let comparison = `${held[0]} < ${held[1]}`
  if (!isMin) {
    comparison = `${held[1]} < ${held[0]}`
  }
  const mask = temp(mutable emitter, findMaskType(vector), `((${maskName})(${comparison}))`)
  const blend = buildBlend(emitter, vector, mask, held[0], held[1])
  return plain(temp(mutable emitter, vector, blend))
}

function emitAbs<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  // Floats clear the sign bit; integers blend v and the wrapping -v.
  const vector = copy(readNodeType(emitter, nodeId))
  const held = holdArguments(walker, mutable emitter, arguments)
  const name = nameVector(emitter, vector)
  const mask = findMaskType(vector)
  const twin = findUnsignedTwin(mask)
  const twinName = nameVector(emitter, twin)
  if (vector is Type.TVector(lane, count)) {
    if (isFloatVector(vector)) {
      let magnitude = "0x7fffffffu"
      if (lane == Type.TF64) {
        magnitude = "0x7fffffffffffffffull"
      }
      let bits: Array<string> = []
      for (let i = 0; i < count; i++) {
        Arrays.push(mutable bits, magnitude)
      }
      const cleared = `((${name})((${twinName})(${held[0]}) & ${buildLaneList(emitter, twin, bits)}))`
      return plain(temp(mutable emitter, vector, cleared))
    }
    const negated = temp(mutable emitter, vector, `((${name})(-(${twinName})(${held[0]})))`)
    const maskName = nameVector(emitter, mask)
    const negative = temp(mutable emitter, mask, `((${maskName})(${held[0]} < (${name}){0}))`)
    const blend = buildBlend(emitter, vector, negative, negated, held[0])
    return plain(temp(mutable emitter, vector, blend))
  }
  return plain("0")
}

function emitShift<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
  isLeft: bool,
): Code uses alloc {
  // The count is a scalar of the lane type, proven in range by the checker. A
  // left shift runs on the unsigned twin; a right shift is arithmetic on signed lanes.
  const vector = copy(readNodeType(emitter, nodeId))
  const held = holdArguments(walker, mutable emitter, arguments)
  const name = nameVector(emitter, vector)
  if (isLeft) {
    const twin = findUnsignedTwin(vector)
    if (twin is Type.TVector(unsignedLane, _)) {
      const twinName = nameVector(emitter, twin)
      const laneName = cachedCType(emitter.checker, emitter.typeNames, unsignedLane)
      return plain(
        temp(
          mutable emitter,
          vector,
          `((${name})((${twinName})(${held[0]}) << (${laneName})(${held[1]})))`,
        ),
      )
    }
  }
  if (vector is Type.TVector(lane, _)) {
    const laneName = cachedCType(emitter.checker, emitter.typeNames, lane)
    return plain(temp(mutable emitter, vector, `(${held[0]} >> (${laneName})(${held[1]}))`))
  }
  return plain("0")
}

export function emitSimdCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "Simd.splat") {
    return emitSplat(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Simd.fromFixed") {
    return emitCopyBytes(walker, mutable emitter, nodeId, arguments, false)
  }
  if (name == "Simd.toFixed") {
    return emitCopyBytes(walker, mutable emitter, nodeId, arguments, true)
  }
  if (name == "Simd.withLane") {
    return emitWithLane(walker, mutable emitter, nodeId, arguments)
  }
  const operator = findComparisonOperator(name)
  if (operator != "") {
    return emitComparison(walker, mutable emitter, nodeId, arguments, operator)
  }
  if (name == "Simd.select") {
    return emitSelect(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Simd.any" || name == "Simd.all") {
    return emitLaneTest(walker, mutable emitter, arguments, name == "Simd.all")
  }
  if (name == "Simd.load") {
    return emitLoad(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Simd.store") {
    return emitStore(walker, mutable emitter, arguments)
  }
  if (name == "Simd.shuffle") {
    return emitShuffle(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Simd.sum") {
    return emitSum(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Simd.min" || name == "Simd.max") {
    return emitMinMax(walker, mutable emitter, nodeId, arguments, name == "Simd.min")
  }
  if (name == "Simd.abs") {
    return emitAbs(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Simd.shiftLeft" || name == "Simd.shiftRight") {
    return emitShift(walker, mutable emitter, nodeId, arguments, name == "Simd.shiftLeft")
  }
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
