// error: < is not defined on I32x4; compare the lanes with Simd.less
import * as Simd from "std/simd"

export function run(_args: Array<string>): int {
  const a: I32x4 = [1, 2, 3, 4]
  const b: I32x4 = [4, 3, 2, 1]
  const ordered = a < b
  const remainder = a % b
  const quotient = a / b
  const shifted = a << b
  const floats: F32x4 = [1.0, 2.0, 3.0, 4.0]
  const masked = floats & floats
  const flipped = ~floats
  let total: I32x4 = Simd.splat(1)
  total /= b
  total >>= b
  if (ordered) {
    return 1
  }
  print(Show.show([remainder, quotient, shifted, total]))
  print(Show.show([masked, flipped]))
  return 0
}
