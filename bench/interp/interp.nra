import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

enum Op {
  Add(n: int)
  Sub(n: int)
  Mul(n: int)
  Mod(n: int)
  Nop
}

function step(op: Op, acc: int): int {
  return match (op) {
    Op.Add(n) => acc + n
    Op.Sub(n) => acc - n
    Op.Mul(n) => acc * n
    Op.Mod(n) => acc % n
    Op.Nop => acc
  }
}

export function run(args: Array<string>): int {
  let program: Array<Op> = []
  for (const i of Ranges.upTo(1000)) {
    const k = i % 5
    if (k == 0) {
      Arrays.push(mutable program, Op.Add(i))
    } else if (k == 1) {
      Arrays.push(mutable program, Op.Mul(3))
    } else if (k == 2) {
      Arrays.push(mutable program, Op.Sub(7))
    } else if (k == 3) {
      Arrays.push(mutable program, Op.Mod(1000003))
    } else {
      Arrays.push(mutable program, Op.Nop)
    }
  }
  let acc = 1
  for (const round of Ranges.upTo(150000)) {
    for (const op of Arrays.values(program)) {
      acc = step(op, acc)
    }
  }
  print(Int.toString(acc))
  return 0
}
