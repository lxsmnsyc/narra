// The debug copy check in the programs suite. Every program runs with
// NARRA_CHECK_COPIES set (Shell.runtimeCheckEnvironment), in both builds. In
// the debug build a sample with a <name>.copies file must fail the check with
// exit code 103 and print that report line; any other sample must pass it.
// For the samples named copy_*.nra, the release build's C, preprocessed as a
// release build, must also hold no credit or hook code, while the same C
// preprocessed as a debug build holds it.
// The copies suite builds a debug compiler and runs it on selfhost/ with the
// copy check on: the compiler must compile itself with no hidden copy.
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Str from "std/string"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"
import * as Files from "testrunner/files"
import * as Shell from "testrunner/shell"
import { CommandResult } from "testrunner/shell"

function isCopySample(testCase: TestCase): bool uses alloc {
  return Str.startsWith(Path.basename(testCase.path), "copy_")
}

export function checkCopyRun(
  context: Context,
  testCase: TestCase,
  result: CommandResult,
  want: string,
): Result<bool, string> uses io, alloc {
  const reportPath = Files.replaceSuffix(testCase.path, ".nra", ".copies")
  if (testCase.variant == "debug" && Fs.exists(reportPath)) {
    const report = Common.readExpected(reportPath)
    if (report is Err(message)) {
      return Err(message)
    }
    const line = Str.trim(report.value)
    if (result.code != 103 || !Str.contains(result.errorOutput, line)) {
      return Err(
        `want the copy report "${line}" and exit code 103, got ${Common.describeRun(result)}`,
      )
    }
    return Common.compareText("stdout", want, result.output)
  }
  const ran = Common.expectRun(result, 0, want)
  if (ran is Err(message)) {
    return Err(message)
  }
  if (testCase.variant == "release" && isCopySample(testCase)) {
    return checkReleaseHasNoHooks(context, testCase)
  }
  return Ok(true)
}

function checkReleaseHasNoHooks(
  context: Context,
  testCase: TestCase,
): Result<bool, string> uses io, alloc {
  const made = Shell.makeTempDirectory()
  if (made is Err(message)) {
    return Err(message)
  }
  const outcome = compareBuilds(context, testCase, made.value)
  Shell.removeTree(made.value)
  return outcome
}

function compareBuilds(
  context: Context,
  testCase: TestCase,
  work: string,
): Result<bool, string> uses io, alloc {
  const cPath = Path.join(work, "out.c")
  const binary = Path.join(work, "out")
  const built = Common.runNarrac(context, [
    "build",
    "-release",
    "-emit-c",
    cPath,
    "-o",
    binary,
    testCase.path,
  ])
  if (built.code != 0) {
    return Err(`the release build failed: ${Common.describeRun(built)}`)
  }
  // The same C, preprocessed as a release build and as a debug build.
  const script = "cc=${CC:-cc}; \"$cc\" -E -std=c11 -w -DNARRA_RELEASE \"$1\" > \"$1.release\" && \"$cc\" -E -std=c11 -w \"$1\" > \"$1.debug\" && grep -q narra_copy \"$1.debug\" && ! grep -q narra_copy \"$1.release\""
  const compared = Shell.runScript(script, [cPath])
  if (compared.code != 0) {
    return Err(
      `the release build's C must have no copy check code and the debug build's must have it: ${Common.describeRun(compared)}`,
    )
  }
  return Ok(true)
}

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  const path = Path.join(context.repository, "selfhost")
  return [TestCase { suite: "copies", name: "selfhost-no-hidden-copies", path: path, variant: "" }]
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  const made = Shell.makeTempDirectory()
  if (made is Err(message)) {
    return Err(message)
  }
  const outcome = checkSelfhostCopies(context, testCase.path, made.value)
  Shell.removeTree(made.value)
  return outcome
}

function checkSelfhostCopies(
  context: Context,
  selfhost: string,
  work: string,
): Result<bool, string> uses io, alloc {
  const compiler = Path.join(work, "narrac-debug")
  const built = Common.runNarrac(context, ["build", "-o", compiler, selfhost])
  if (built.code != 0) {
    return Err(`building the debug compiler failed: ${Common.describeRun(built)}`)
  }
  // Exit code 103 and a report line on stderr mean a copy that no copy(...) explains.
  const script = "NARRA_CHECK_COPIES=1 \"$1\" emit \"$2\" > /dev/null"
  const emitted = Shell.runScript(script, [compiler, selfhost])
  if (emitted.code != 0) {
    return Err(`the debug compiler's copy check failed on selfhost: ${Common.describeRun(emitted)}`)
  }
  return Ok(true)
}
