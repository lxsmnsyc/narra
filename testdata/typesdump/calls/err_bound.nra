trait Named {
  function name(value: Self): string
}

struct Cat {
  lives: int
}

function describe<T: Named>(value: T): string {
  return Named.name(value)
}

function loose<T>(value: T): string {
  return Named.name(value)
}

export function run(args: Array<string>): int {
  const text = describe(Cat { lives: 1 })
  const other = Named.name(3)
  const missing = Named.title(3)
  return 0
}
