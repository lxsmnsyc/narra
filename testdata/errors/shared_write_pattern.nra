// error: bag.items[0] = ... may change bag, which items still uses at line 11
struct Bag {
  items: Array<int>
}

export function run(_args: Array<string>): int uses alloc {
  let bag = Bag { items: [1, 2] }
  // A pattern binding shares the value it was matched from.
  const { items } = bag
  bag.items[0] = 5
  let total = items[0]
  let rows = [[1], [2]]
  for (const row of rows) {
    // A `for (const ...)` binding shares the element of rows.
    if (total > 100) {
      break
    }
    rows[0] = [0]
    total += row[0]
  }
  return total
}
