import * as Int from "std/int"
import * as Jobs from "tam/jobs"
import * as Thread from "std/thread"

export function run(_args: Array<string>): int {
  const result = Thread.scope((scope) => {
    const worker = Thread.start(scope, Jobs.job)
    return Thread.join(worker)
  })
  print(`job ${Int.toString(result)}`)
  return 0
}
