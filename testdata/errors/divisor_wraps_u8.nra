// error: divisor_wraps_u8.nra:5:18: the divisor must be a non-zero constant or a name checked against zero first; this constant is zero
const WRAPS: u8 = 255 + 1

function remainder(total: u8): u8 {
  return total % WRAPS
}

export function run(args: Array<string>): int {
  remainder(10)
  return 0
}
