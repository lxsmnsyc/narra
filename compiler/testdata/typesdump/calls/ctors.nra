enum Shape {
  Circle(radius: int)
  Square(side: int)
  Empty
}

enum Light {
  Red
  Green
  Empty
}

enum Tree<T> {
  Leaf(value: T)
  Node(left: Box<Tree<T>>, right: Box<Tree<T>>)
  Nothing
}

struct Holder {
  shape: Shape
  maybe: Option<int> = None
  sized: Option<int> = Some(3)
}

const ORIGIN = Shape.Circle(0)
const NOTHING: Option<string> = None

function area(shape: Shape): int {
  return 1
}

function pick(flag: bool): Option<int> {
  if (flag) {
    return Some(1)
  }
  return None
}

function fallback(): Result<int, string> {
  return Err("no")
}

export function run(args: Array<string>): int {
  const circle = Shape.Circle(2)
  const empty = Shape.Empty
  const light = Light.Empty
  const leaf = Tree.Leaf(1)
  const none: Tree<string> = Tree.Nothing
  const some = Some("x")
  const ok: Result<int, string> = Ok(1)
  const holder = Holder { shape: Shape.Square(1) }
  const result = fallback()
  const nested: Option<Option<int>> = Some(None)
  return area(circle) + area(ORIGIN)
}
