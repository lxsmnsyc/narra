enum Shape {
  Circle(radius: int)
  Square(side: int)
}

enum Flag {
  Yes(count: int)
  No(reason: string)
}

function direct(shape: Shape): int {
  if (shape is Shape.Circle(radius)) {
    return radius + shape.radius
  }
  return shape.side
}

function branches(shape: Shape): int {
  if (shape is Shape.Circle(_)) {
    return shape.radius
  } else {
    return shape.side
  }
}

function early(shape: Shape): int {
  if (shape is Shape.Square(_)) {
    return 0
  }
  return shape.radius
}

function partial(flag: Flag): int {
  if (flag is Flag.Yes(1)) {
    return 1
  }
  return 0
}

function option(maybe: Option<int>): int {
  if (maybe is Some(value)) {
    return value
  }
  return 0
}

function result(outcome: Result<int, string>): int {
  if (outcome is Err(message)) {
    return 0
  }
  return outcome.value
}

function plainTest(shape: Shape): bool {
  return shape is Shape.Circle(_)
}
