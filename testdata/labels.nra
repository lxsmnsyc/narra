import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"

// break outer from two nested for-of loops, with heap locals in both scopes
function findPair(limit: int): string {
  let found = "none"
  outer: for (const i of Ranges.upTo(limit)) {
    const rowName = `row${Int.toString(i)}`
    const row = [i, i + 1, i + 2]
    for (const j of Ranges.upTo(limit)) {
      const cellName = `${rowName}:${Int.toString(j)}`
      const cell = [j, row[0]]
      if (i * j == 6) {
        found = cellName
        break outer
      }
      if (cell[0] > 4) {
        continue outer
      }
    }
  }
  return found
}

// continue outer from three nested loops: array, range and map loops
function threeDeep(): int {
  let total = 0
  const names = ["a", "bb", "ccc"]
  const table = Map<string, int> { "x": 1, "y": 2 }
  outer: for (const name of Arrays.values(names)) {
    const label = `${name}!`
    middle: for (const i of Ranges.upTo(3)) {
      const bag = [i, i]
      for (const key of Maps.keys(table)) {
        const text = `${label}${key}`
        if (i == 1) {
          continue middle
        }
        if (key == "y" && Str.length(text) > 4) {
          continue outer
        }
        total = total + Str.length(text) + bag[0]
      }
      total = total + 100
    }
    total = total + 1000
  }
  return total
}

// labeled while loops, with break and continue at different depths
function whileLoops(): int {
  let steps = 0
  let n = 0
  outer: while (true) {
    n = n + 1
    const holder = [n]
    let m = 0
    inner: while (m < 5) {
      m = m + 1
      const text = `${Int.toString(n)}.${Int.toString(m)}`
      steps = steps + 1
      if (m == 2 && n < 3) {
        continue outer
      }
      if (n == 4) {
        break outer
      }
      for (const k of Ranges.upTo(3)) {
        if (k == 1) {
          continue inner
        }
        if (n == 3 && m == 3) {
          break inner
        }
        steps = steps + holder[0] + Str.length(text)
      }
    }
  }
  return steps * 10 + n
}

// the same label name in sibling loops, and an unlabeled break inside a labeled loop
function siblings(): int {
  let count = 0
  loop: for (const i of Ranges.upTo(4)) {
    for (const j of Ranges.upTo(4)) {
      if (j == 2) {
        break
      }
      if (i == 3) {
        break loop
      }
      count = count + 1
    }
  }
  loop: for (const i of Ranges.upTo(3)) {
    count = count + 10
    if (i == 1) {
      break loop
    }
  }
  return count
}

export function run(args: Array<string>): int {
  print(findPair(5))
  print(findPair(2))
  print(Int.toString(threeDeep()))
  print(Int.toString(whileLoops()))
  print(Int.toString(siblings()))
  return 0
}
