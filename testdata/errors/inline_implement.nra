// error: `@inline` is not allowed in an implement block; only @trusted is
trait Measure {
  function measure(self: Self): int
}

struct Box {
  size: int
}

implement Measure for Box {
  @inline
  function measure(self: Box): int {
    return self.size
  }
}

export function run(_args: Array<string>): int {
  return Box { size: 0 }.measure()
}
