// error: E1053, a failed assert after std/math and std/i8 calls
import * as I8 from "std/i8"
import * as Math from "std/math"

@const
function check(value: int): int {
  const small = I8.wrap(value)
  assert(Math.abs(I8.toString(small) == "-56" ? value : 0) < 100)
  return value
}

const CHECKED = check(200)

export function run(args: Array<string>): int {
  return CHECKED
}
