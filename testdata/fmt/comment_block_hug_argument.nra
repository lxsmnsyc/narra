function run(xs: Array<int>): int {
  const first = addAll(xs, // after the head
    { Arrays.push(mutable xs, 3)
    return 1 })
  const second = addAll(xs, /* before */ { Arrays.push(mutable xs, 3)
    return 1 })
  const third = addAll(xs, // after the head
    (x) => { return 1 })
  const fourth = addAll(xs, (x) => { return 1 } /* after */)
  return first
}
