// error: this argument is not proven to meet `requires low <= high` of span; pass a constant, or a name checked first with an `if`
import * as Arrays from "std/array"

function span(low: int, high: int): int
  requires low <= high
{
  return high - low
}

export function run(args: Array<string>): int {
  const count = Arrays.length(args)
  return span(count, 3) + span(5, 3)
}
