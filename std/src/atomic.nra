// std/atomic: Atomic<T>, a bool or an integer with atomic operations (SPEC.md
// section 8, D111 item 4).
//
// T is bool or an integer type up to 64 bits (E1411 otherwise). Every
// operation is sequentially consistent. Copies of an Atomic are handles to
// one value. Importing this module builds the program in thread mode (D111
// item 2).

import * as Boxes from "std/box"
import * as Threads from "std/internal/thread"

export opaque struct Atomic<T> {
  slot: Box<T>
}

export function create<T>(value: T): Atomic<T> uses alloc {
  return Atomic { slot: Boxes.new(value) }
}

export function load<T>(atomic: Atomic<T>): T {
  return Threads.atomicLoad(atomic.slot)
}

export function store<T>(atomic: Atomic<T>, value: T) {
  Threads.atomicStore(atomic.slot, value)
}

// Stores value and gives the value it replaced.
export function exchange<T>(atomic: Atomic<T>, value: T): T {
  return Threads.atomicExchange(atomic.slot, value)
}

// Adds amount and gives the old value. The sum wraps, like + (D92).
export function add<T>(atomic: Atomic<T>, amount: T): T {
  return Threads.atomicAdd(atomic.slot, amount)
}

// Stores replacement when the value is expected, and tells whether it stored.
export function compareExchange<T>(atomic: Atomic<T>, expected: T, replacement: T): bool {
  return Threads.atomicCompareExchange(atomic.slot, expected, replacement)
}
