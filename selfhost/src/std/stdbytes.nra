// The registry rows and emitters of std/bytes. A bytes value is an lstr like a
// string, without the UTF-8 guarantee (runtime std_bytes.c).
import { StdFunc } from "narrac/std/builtins"
import { Type } from "narrac/check/types"
import { Pos, Arg } from "narrac/syntax/ast"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  writeLine,
  temp,
  ownedTemp,
  readNodeType,
  useHelper,
} from "narrac/emit/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  stringOut,
  arrayStruct,
  ioResult,
  emitOptionOut,
} from "narrac/std/stdemithelp"
import * as Arrays from "std/array"

export const BYTES_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Bytes.at",
    module: "std/bytes",
    key: "at",
    parameters: ["bytes", "int"],
    parameterNames: ["data", "index"],
    result: "Option<u8>",
    doc: "Returns the byte at `index`, or `None` when the index is outside the data.",
  },
  StdFunc {
    name: "Bytes.concat",
    module: "std/bytes",
    key: "concat",
    parameters: ["bytes", "bytes"],
    parameterNames: ["first", "second"],
    result: "bytes",
    effects: ["alloc"],
    doc: "Returns `first` followed by `second` as one `bytes` value.",
  },
  StdFunc {
    name: "Bytes.fromArray",
    module: "std/bytes",
    key: "fromArray",
    parameters: ["Array<u8>"],
    parameterNames: ["items"],
    result: "bytes",
    effects: ["alloc"],
    doc: "Copies an array of bytes into a `bytes` value.",
  },
  StdFunc {
    name: "Bytes.fromString",
    module: "std/bytes",
    key: "fromString",
    parameters: ["string"],
    parameterNames: ["text"],
    result: "bytes",
    doc: "Returns the UTF-8 bytes of the text, without copying them.",
  },
  StdFunc {
    name: "Bytes.length",
    module: "std/bytes",
    key: "length",
    parameters: ["bytes"],
    parameterNames: ["data"],
    result: "int",
    doc: "Returns the number of bytes.",
  },
  StdFunc {
    name: "Bytes.slice",
    module: "std/bytes",
    key: "slice",
    parameters: ["bytes", "int", "int"],
    parameterNames: ["data", "start", "end"],
    result: "Option<bytes>",
    effects: ["alloc"],
    doc: "Returns the bytes from `start` up to but not including `end`, or `None` when the range is outside the data or `start` is after `end`.",
  },
  StdFunc {
    name: "Bytes.toArray",
    module: "std/bytes",
    key: "toArray",
    parameters: ["bytes"],
    parameterNames: ["data"],
    result: "Array<u8>",
    effects: ["alloc"],
    doc: "Copies the bytes into a new `Array<u8>`.",
  },
  StdFunc {
    name: "Bytes.toString",
    module: "std/bytes",
    key: "toString",
    parameters: ["bytes"],
    parameterNames: ["data"],
    result: "Result<string, string>",
    effects: ["alloc"],
    check: "fixed",
    doc: "Returns the bytes as a string, or an error that names the offset of the first byte that is not valid UTF-8.",
  },
]

const BYTES_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Bytes.concat",
    call: "lstr_concat",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Bytes.fromString",
    call: "narra_bytes_from_string",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Bytes.length",
    call: "narra_bytes_length",
    withPos: false,
    owned: false,
    temporary: false,
  },
]

function emitToString<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = copy(readNodeType(emitter, nodeId))
  const data = argumentText(walker, mutable emitter, arguments, 0)
  const output = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const success = temp(
    mutable emitter,
    Type.TBool,
    `narra_bytes_to_string(${data}, &${output}, &${bad})`,
  )
  // Ok shares the buffer; Err names the first bad byte.
  return ioResult(mutable emitter, resultType, success, output, bad)
}

function emitFromArray<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = copy(readNodeType(emitter, nodeId))
  const value = argumentText(walker, mutable emitter, arguments, 0)
  const items = temp(mutable emitter, Type.TArray(Type.TU8), value)
  const callText = `narra_bytes_from_raw(${items}->items, ${items}->len)`
  return owned(ownedTemp(mutable emitter, resultType, callText))
}

function emitToArray<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const arrayType = copy(readNodeType(emitter, nodeId))
  const value = argumentText(walker, mutable emitter, arguments, 0)
  const data = temp(mutable emitter, Type.TBytes, value)
  const structName = arrayStruct(emitter, arrayType)
  const newHelper = useHelper(emitter, structName, "new")
  const array = ownedTemp(mutable emitter, arrayType, `${newHelper}(${data}->len)`)
  writeLine(
    mutable emitter,
    `if (${data}->len > 0) memcpy(${array}->items, ${data}->data, (size_t)${data}->len);`,
  )
  writeLine(mutable emitter, `${array}->len = ${data}->len;`)
  return owned(array)
}

export function emitBytesCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(BYTES_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Bytes.at") {
    return emitOptionOut(
      walker,
      mutable emitter,
      nodeId,
      arguments,
      "narra_bytes_at",
      Type.TU8,
      "0",
    )
  }
  if (name == "Bytes.slice") {
    return emitOptionOut(
      walker,
      mutable emitter,
      nodeId,
      arguments,
      "narra_bytes_slice",
      Type.TBytes,
      "NULL",
    )
  }
  if (name == "Bytes.toString") {
    return emitToString(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Bytes.fromArray") {
    return emitFromArray(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Bytes.toArray") {
    return emitToArray(walker, mutable emitter, nodeId, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
