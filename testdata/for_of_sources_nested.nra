import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// A Range named here with no value built: the C type must still exist.
struct Holder {
  window: Range
}

function apply(items: Array<int>, change: (int) => int): Array<int> uses alloc {
  let out: Array<int> = []
  for (const item of items) {
    Arrays.push(mutable out, change(item))
  }
  return out
}

export function run(args: Array<string>): int {
  const numbers = [1, 2]
  // a for-of inside an arrow in the source of another for-of
  for (const x of Arrays.values(
    apply(numbers, (v) => {
      let t = v
      for (const i of Ranges.upTo(2)) {
        t = t + i
      }
      return t
    }),
  )) {
    print(Int.toString(x))
  }
  return 0
}
