// Arrow functions and calls of function values, ported from
// compiler/internal/narra/check_closure.go (arrow, hintArrow, valueCall,
// valueCallOf, checkCalleeExclusive, mutableRoots, returnsOf, blockResult,
// inferReturns) and the callback half of std_option.go (checkCallback).
//
// This module sits above narrac/exprs: exprs reaches checkArrow through
// Walker.checkArrow (check.nra). The rules that exprs itself needs (the
// non-escaping parameter, captures, named functions as values) are in
// funcvalues.nra.
//
// The Go compiler records an arrow function in a Closure on the node. Here
// the results are in the current body: the type of the arrow is the
// node type, its parameters are locals declared by their Param ids, and
// BodyInfo.closures holds the stack flag, the captures and the hint.
// A function type is a plain Type.TFunc, so Go's funcOf interning and
// finishFuncTypes are not ported: selfhost-emit collects the function types
// it needs.
import { Pos, Expr, Arg, Param, TypeExpr, Block, Stmt, MatchArm } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Type } from "narrac/types"
import {
  Checker,
  internComposite,
  Ref,
  Walker,
  reportError,
  typeString,
  setRef,
  setParameterType,
  getNodeType,
  setNodeType,
  noteAsyncUse,
  getRef,
  declareLocal,
  pushScope,
  popScope,
  getExpressionId,
  getExpressionPos,
  ArrowContext,
  findParameterIndex,
  findFromNamePos,
} from "narrac/check"
import { resolveType, substitute } from "narrac/resolve"
import { unify } from "narrac/generics"
import {
  checkExpression,
  expectType,
  checkArgument,
  checkExclusive,
  checkBorrowed,
  checkArgumentsLoosely,
  containsOpen,
  findAssignedLocal,
  usesLocal,
  listBlockExpressions,
} from "narrac/exprs"
import { findClosure } from "narrac/funcvalues"
import { checkEveryPathReturns } from "narrac/pathends"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import { isVoidParameterValue } from "narrac/asyncvoid"

export function checkArrow<W: Walker>(
  mutable checker: Checker,
  walker: W,
  expression: Expr,
  want: Option<Type>,
): Type from checker uses alloc {
  // The body is checked as a function of its own whose scope sees the enclosing locals; the ones it uses become captures (useLocal in funcvalues.nra).
  if (expression is Expr.ArrowExpr(nodeId, pos, parameters, resultExpr, bodyExpr, block)) {
    return checkArrowParts(
      mutable checker,
      walker,
      nodeId,
      pos,
      parameters,
      resultExpr,
      bodyExpr,
      block,
      want,
      false,
    )
  }
  if (expression is Expr.AsyncExpr(asyncId, asyncPos, asyncBody)) {
    return checkAsyncExpression(mutable checker, walker, asyncId, asyncPos, asyncBody, want)
  }
  return Type.TVoid
}

function checkAsyncExpression<W: Walker>(
  mutable checker: Checker,
  walker: W,
  asyncId: int,
  pos: Pos,
  body: Expr,
  want: Option<Type>,
): Type from checker uses alloc {
  // An async arrow is an arrow whose result is the handle of its task; an async
  // block is checked as an arrow with no parameters that runs at once.
  noteAsyncUse(mutable checker)
  if (body is Expr.ArrowExpr(nodeId, arrowPos, parameters, resultExpr, bodyExpr, block)) {
    let arrowWant: Option<Type> = None
    if (want is Some(Type.TFunc(wantParams, Type.TAsync(wantValue), effects, binder, _))) {
      arrowWant = Some(Type.TFunc(wantParams, wantValue, effects, binder, -1))
    }
    const found = checkArrowParts(
      mutable checker,
      walker,
      nodeId,
      arrowPos,
      parameters,
      resultExpr,
      bodyExpr,
      block,
      arrowWant,
      true,
    )
    setNodeType(mutable checker, nodeId, found)
    return found
  }
  if (body is Expr.BlockExpr(blockId, _, taskBlock)) {
    let blockWant: Option<Type> = None
    if (want is Some(Type.TAsync(wantValue))) {
      blockWant = Some(Type.TFunc([], wantValue, [], -1, -1))
    }
    const found = checkArrowParts(
      mutable checker,
      walker,
      asyncId,
      pos,
      [],
      None,
      None,
      Some(taskBlock),
      blockWant,
      true,
    )
    if (found is Type.TFunc(_, handleType, _, _, _)) {
      setNodeType(mutable checker, blockId, handleType)
      return copy(handleType)
    }
  }
  return Type.TVoid
}

function checkArrowParts<W: Walker>(
  mutable checker: Checker,
  walker: W,
  nodeId: int,
  pos: Pos,
  parameters: Array<Param>,
  resultExpr: Option<TypeExpr>,
  bodyExpr: Option<Expr>,
  block: Option<Block>,
  want: Option<Type>,
  isAsync: bool,
): Type from checker uses alloc {
  // The expected parameter and result types: the expected function type
  // wins over the hint of a generic call.
  const closure = findClosure(mutable checker, nodeId)
  const bodyIndex = checker.body
  checker.bodies[bodyIndex].closures[closure].isTask = isAsync
  let hasHint = checker.bodies[bodyIndex].closures[closure].hasHint
  let hintParameters = copy(checker.bodies[bodyIndex].closures[closure].hintParameters)
  let hintResult = checker.bodies[bodyIndex].closures[closure].hintResult
  let expectedShared = -1
  if (want is Some(Type.TFunc(wantParams, wantResult, _, _, wantShared))) {
    expectedShared = wantShared
    hasHint = true
    hintParameters = []
    for (const wantParam of Arrays.values(wantParams)) {
      Arrays.push(mutable hintParameters, Some(wantParam))
    }
    hintResult = Some(wantResult)
  }
  if (hasHint && Arrays.length(hintParameters) != Arrays.length(parameters)) {
    const message = `this arrow function takes ${Int.toString(Arrays.length(parameters))} parameters, but the expected function takes ${Int.toString(Arrays.length(hintParameters))}`
    reportError(mutable checker, pos, "E0610", message)
    hasHint = false
  }

  // The parameter types: written, or from the hint.
  let paramTypes: Array<Type> = []
  for (const index of Ranges.between(0, Arrays.length(parameters))) {
    const param = parameters[index]
    let paramType = Type.TVoid
    if (param.type is Some(typeExpression)) {
      paramType = resolveType(mutable checker, typeExpression)
    } else {
      let hinted: Option<Type> = None
      if (hasHint) {
        hinted = hintParameters[index]
      }
      if (hinted is Some(fromHint)) {
        paramType = fromHint
      } else {
        reportError(
          mutable checker,
          param.pos,
          "E0611",
          `cannot tell the type of parameter ${quoteGo(param.name)}; write it as \`${param.name}: Type\``,
        )
      }
    }
    setParameterType(mutable checker, param.id, paramType)
    Arrays.push(mutable paramTypes, paramType)
  }

  // The result type: written, from the hint, or not known yet.
  let result: Option<Type> = None
  if (resultExpr is Some(resultType)) {
    result = Some(resolveFunctionResult(mutable checker, resultType))
  } else if (hasHint) {
    result = hintResult
  }

  // Check the body as a function of its own.
  const savedLoops = checker.loops
  const savedLabels = checker.labels
  const savedBlocks = checker.blocks
  const savedResult = checker.resultType
  const savedInferring = checker.inferring
  const savedGenerator = checker.generator
  const savedAsync = checker.asyncBody
  const outerDepth = checker.scopeDepth
  // Clear the saved lists before any call changes the checker, so they are not shared.
  checker.loops = 0
  checker.labels = []
  checker.blocks = []
  pushArrow(mutable checker, outerDepth, closure)
  pushScope(mutable checker)
  checker.generator = false
  checker.asyncBody = isAsync
  for (const index of Ranges.between(0, Arrays.length(parameters))) {
    const param = parameters[index]
    declareLocal(mutable checker, param.id, param.pos, param.name, paramTypes[index], false, true)
  }
  if (block is Some(arrowBlock)) {
    if (result is None) {
      result = findBlockResult(arrowBlock)
    }
    if (result is Some(knownResult)) {
      checker.resultType = knownResult
      checker.inferring = false
    } else {
      checker.resultType = Type.TVoid
      checker.inferring = true
    }
    Walker.checkBlock(walker, mutable checker, arrowBlock)
    if (result is None) {
      result = Some(inferReturns(mutable checker, arrowBlock))
    }
    if (result is Some(blockResult)) {
      checkEveryPathReturns(mutable checker, arrowBlock, blockResult, true)
    }
  } else if (bodyExpr is Some(arrowBody)) {
    checker.inferring = false
    const bodyPos = getExpressionPos(arrowBody)
    if (result is Some(Type.TVoid)) {
      checkExpression(mutable checker, walker, arrowBody, None)
    } else if (result is Some(_)) {
      const found = checkExpression(mutable checker, walker, arrowBody, result)
      expectType(mutable checker, bodyPos, result, found)
    } else {
      result = Some(checkExpression(mutable checker, walker, arrowBody, None))
    }
  }
  popScope(mutable checker)
  popArrow(mutable checker)
  checker.loops = savedLoops
  checker.labels = copy(savedLabels)
  checker.blocks = copy(savedBlocks)
  checker.resultType = savedResult
  checker.inferring = savedInferring
  checker.generator = savedGenerator
  checker.asyncBody = savedAsync

  // The type of the arrow function.
  let finalResult = Type.TVoid
  if (result is Some(known)) {
    finalResult = known
  }
  // A written `from` names one of the arrow function's own parameters; without
  // one the arrow takes the `from` of the expected type, as it takes its
  // parameter types.
  let shared = -1
  let writesFrom = false
  if (resultExpr is Some(resultType)) {
    writesFrom = resultType.resultFrom != ""
    shared = findParameterIndex(parameters, resultType.resultFrom)
    if (writesFrom && shared < 0) {
      const namePos = findFromNamePos(checker, resultType)
      reportError(
        mutable checker,
        namePos,
        "E0976",
        `from names ${quoteGo(resultType.resultFrom)}, which is not a parameter of this arrow function; a from marker can name only a parameter`,
      )
    }
  }
  if (!writesFrom && hasHint) {
    shared = expectedShared
    checker.bodies[bodyIndex].closures[closure].expectsFresh = shared < 0
  }
  if (isAsync) {
    // The task holds its own copies, so the handle shares no parameter.
    const handleType = internComposite(mutable checker, Type.TAsync(finalResult))
    return copy(internComposite(mutable checker, Type.TFunc(paramTypes, handleType, [], -1, -1)))
  }
  return copy(internComposite(mutable checker, Type.TFunc(paramTypes, finalResult, [], -1, shared)))
}

function resolveFunctionResult(
  mutable checker: Checker,
  typeExpression: TypeExpr,
): Type from checker uses alloc {
  if (
    typeExpression.name == "void" &&
      Arrays.length(typeExpression.arguments) == 0 &&
      !typeExpression.isFunc
  ) {
    return Type.TVoid
  }
  return resolveType(mutable checker, typeExpression)
}

function pushArrow(mutable checker: Checker, outerDepth: int, closure: int) uses alloc {
  const body = checker.body
  const context = ArrowContext { outerDepth: outerDepth, closure: closure }
  const depth = checker.bodies[body].arrowDepth
  if (depth < Arrays.length(checker.bodies[body].arrows)) {
    checker.bodies[body].arrows[depth] = context
  } else {
    Arrays.push(mutable checker.bodies[body].arrows, context)
  }
  checker.bodies[body].arrowDepth = depth + 1
}

function popArrow(mutable checker: Checker) {
  const body = checker.body
  checker.bodies[body].arrowDepth--
}

function listReturns(block: Block): Array<Option<Expr>> from block uses alloc {
  let found: Array<Option<Expr>> = []
  walkReturns(mutable found, Stmt.BlockStmt(block))
  return found
}

function walkReturns(mutable found: Array<Option<Expr>>, statement: Stmt) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => {
      for (const inner of Arrays.values(block.statements)) {
        walkReturns(mutable found, inner)
      }
    }
    Stmt.ReturnStmt(_, value) => Arrays.push(mutable found, value)
    Stmt.IfStmt(_, _, then, orElse) => {
      walkReturns(mutable found, Stmt.BlockStmt(then))
      if (orElse is Some(other)) {
        walkReturns(mutable found, other)
      }
    }
    Stmt.WhileStmt(_, _, _, body)
      | Stmt.CForStmt(_, _, _, _, _, body)
      | Stmt.ForStmt(_, _, _, _, _, body, _) => walkReturns(mutable found, Stmt.BlockStmt(body))
    Stmt.ExprStmt(_, expression) => walkMatchArms(mutable found, expression)
    Stmt.VarStmt(_, _, _, _, _, _, value) => walkMatchArms(mutable found, value)
    _ => {}
  }
}

function walkMatchArms(mutable found: Array<Option<Expr>>, expression: Expr) uses alloc {
  if (expression is Expr.MatchExpr(_, _, _, arms)) {
    for (const arm of Arrays.values(arms)) {
      if (arm.block is Some(armBlock)) {
        walkReturns(mutable found, Stmt.BlockStmt(armBlock))
      }
    }
  }
}

function findBlockResult(block: Block): Option<Type> uses alloc {
  const returns = listReturns(block)
  if (Arrays.length(returns) == 0) {
    return Some(Type.TVoid)
  }
  for (const value of Arrays.values(returns)) {
    if (value is None) {
      return Some(Type.TVoid)
    }
  }
  return None
}

function inferReturns(mutable checker: Checker, block: Block): Type from checker uses alloc {
  // The first return decides the type, the others must agree.
  let result: Option<Type> = None
  for (const value of Arrays.values(listReturns(block))) {
    if (value is Some(expression)) {
      const found = copy(getNodeType(checker, getExpressionId(expression)))
      if (result is None) {
        result = copy(found)
      } else {
        if (found is Some(foundType)) {
          expectType(mutable checker, getExpressionPos(expression), result, foundType)
        }
      }
    }
  }
  if (result is Some(inferred)) {
    return inferred
  }
  return Type.TVoid
}

function learnFromEarlier(
  mutable checker: Checker,
  arguments: Array<Arg>,
  index: int,
  parameters: Array<Param>,
  bindings: Map<int, Type>,
): Map<int, Type> from checker uses alloc {
  let known: Map<int, Type> = Map {}
  for (const entry of Maps.entries(bindings)) {
    const #[key, bound] = entry
    known[key] = bound
  }
  for (const before of Ranges.between(0, index)) {
    if (before < Arrays.length(parameters)) {
      if (getNodeType(checker, getExpressionId(arguments[before].value)) is Some(beforeType)) {
        unify(checker, checker.paramTypes[parameters[before].id], beforeType, mutable known)
      }
    }
  }
  return known
}

function hintNone(
  mutable checker: Checker,
  arguments: Array<Arg>,
  index: int,
  parameters: Array<Param>,
  typeParameters: Array<int>,
  bindings: Map<int, Type>,
): Option<Type> from checker uses alloc {
  if (arguments[index].value is Expr.Ident(_, _, name)) {
    if (name != "None") {
      return None
    }
  } else {
    return None
  }
  const known = learnFromEarlier(mutable checker, arguments, index, parameters, bindings)
  const declared = checker.paramTypes[parameters[index].id]
  const substituted = substitute(mutable checker, declared, known)
  if (containsOpen(checker, substituted, typeParameters)) {
    return None
  }
  return Some(substituted)
}

function hintArrow(
  mutable checker: Checker,
  arguments: Array<Arg>,
  index: int,
  parameters: Array<Param>,
  typeParameters: Array<int>,
  bindings: Map<int, Type>,
) uses alloc {
  // Runs just before the argument at index is checked. An async arrow takes the
  // value of the expected handle as the hint of its result.
  let arrowId = -1
  let isAsync = false
  if (arguments[index].value is Expr.ArrowExpr(_, _, _, _, _, _)) {
    arrowId = getExpressionId(arguments[index].value)
  } else if (
    arguments[index].value is Expr.AsyncExpr(_, _, Expr.ArrowExpr(innerId, _, _, _, _, _))
  ) {
    arrowId = innerId
    isAsync = true
  }
  if (arrowId < 0) {
    return
  }

  const known = learnFromEarlier(mutable checker, arguments, index, parameters, bindings)
  const declared = checker.paramTypes[parameters[index].id]
  const substituted = substitute(mutable checker, declared, known)
  if (substituted is Type.TFunc(funcParams, funcResult, _, _, _)) {
    // Keep the parts that no open type parameter touches.
    let hintParameters: Array<Option<Type>> = []
    for (const funcParam of Arrays.values(funcParams)) {
      if (containsOpen(checker, funcParam, typeParameters)) {
        Arrays.push(mutable hintParameters, None)
      } else {
        Arrays.push(mutable hintParameters, Some(funcParam))
      }
    }
    let hintResult: Option<Type> = None
    if (!containsOpen(checker, funcResult, typeParameters)) {
      hintResult = Some(funcResult)
      if (isAsync) {
        hintResult = findHandleValue(funcResult)
      }
    }
    const closure = findClosure(mutable checker, arrowId)
    const body = checker.body
    checker.bodies[body].closures[closure].hasHint = true
    checker.bodies[body].closures[closure].hintParameters = hintParameters
    checker.bodies[body].closures[closure].hintResult = hintResult
  }
}

function findHandleValue(handleType: Type): Option<Type> from handleType {
  if (handleType is Type.TAsync(value)) {
    return Some(value)
  }
  return None
}

export function checkGenericArguments<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  parameters: Array<Param>,
  typeParameters: Array<int>,
  bindings: Map<int, Type>,
) uses alloc {
  // A parameter that still holds an open type parameter has no expected type, and an arrow function argument gets a hint instead.
  const argCount = Arrays.length(arguments)
  const paramCount = Arrays.length(parameters)
  if (argCount != paramCount) {
    reportError(
      mutable checker,
      pos,
      "E0316",
      `this call passes ${Int.toString(argCount)} arguments, the function takes ${Int.toString(paramCount)}`,
    )
  }
  let mutables: Array<int> = []
  for (const index of Ranges.between(0, argCount)) {
    if (index >= paramCount) {
      checkExpression(mutable checker, walker, arguments[index].value, None)
      continue
    }
    const declared = checker.paramTypes[parameters[index].id]
    const paramWant = substitute(mutable checker, declared, bindings)
    let want: Option<Type> = Some(paramWant)
    if (containsOpen(checker, paramWant, typeParameters)) {
      hintArrow(mutable checker, arguments, index, parameters, typeParameters, bindings)
      want = hintNone(mutable checker, arguments, index, parameters, typeParameters, bindings)
    }
    checkArgument(mutable checker, walker, arguments, parameters, index, want, mutable mutables)
  }
  checkExclusive(mutable checker, arguments, mutables)
  checkBorrowed(mutable checker, arguments)
}

export function checkValueCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  nodeId: int,
  pos: Pos,
  callee: Expr,
  arguments: Array<Arg>,
): Type uses alloc {
  // A non-escaping parameter may be called.
  if (callee is Expr.Ident(calleeId, _, _)) {
    const body = checker.body
    checker.bodies[body].allowedId = calleeId
  }
  const calleeType = checkExpression(mutable checker, walker, callee, None)
  if (calleeType is Type.TFunc(funcParams, funcResult, _, _, _)) {
    return checkCallThroughValue(
      mutable checker,
      walker,
      nodeId,
      pos,
      callee,
      arguments,
      funcParams,
      funcResult,
    )
  }

  // Not a function.
  let isLocal = false
  let calleeName = ""
  if (callee is Expr.Ident(identId, _, identName)) {
    if (getRef(checker, identId) is Ref.Local(_)) {
      isLocal = true
      calleeName = identName
    }
  }
  if (isLocal) {
    const typeText = typeString(checker, calleeType)
    // `a < 3, 4 > (c)` reads as a call with type arguments; parentheses keep the comparison.
    let hint = ""
    if (checker.callTypeArguments[nodeId] is Some(written)) {
      if (Arrays.length(written) > 0) {
        hint = `; if \`<\` is a comparison, wrap it in parentheses, as in \`(${calleeName} < ${written[0].name})\``
      }
    }
    reportError(
      mutable checker,
      pos,
      "E0606",
      `${quoteGo(calleeName)} is a ${typeText}, not a function${hint}`,
    )
  } else {
    reportError(mutable checker, pos, "E0607", "this expression cannot be called")
  }
  checkArgumentsLoosely(mutable checker, walker, arguments)
  return Type.TVoid
}

export function checkCallThroughValue<W: Walker>(
  mutable checker: Checker,
  walker: W,
  nodeId: int,
  pos: Pos,
  callee: Expr,
  arguments: Array<Arg>,
  funcParams: Array<Type>,
  funcResult: Type,
): Type from funcResult uses alloc {
  // Parameters of a function type are escaping.
  setRef(mutable checker, nodeId, Ref.Value)
  // In a generic instance, a value of a type parameter bound to void fills no parameter.
  let parameterIndex = 0
  let passed = 0
  for (const arg of Arrays.values(arguments)) {
    if (arg.isMutable) {
      reportError(
        mutable checker,
        getExpressionPos(arg.value),
        "E0608",
        "a function value takes no mutable arguments; remove `mutable`",
      )
    }
    let want: Option<Type> = None
    if (parameterIndex < Arrays.length(funcParams)) {
      want = Some(funcParams[parameterIndex])
    }
    const found = checkExpression(mutable checker, walker, arg.value, want)
    const fillsNothing =
      found == Type.TVoid &&
        Arrays.length(arguments) != Arrays.length(funcParams) &&
        isVoidParameterValue(checker, getExpressionId(arg.value))
    if (!fillsNothing) {
      expectType(mutable checker, getExpressionPos(arg.value), want, found)
      parameterIndex++
      passed++
    }
  }
  if (passed != Arrays.length(funcParams)) {
    reportError(
      mutable checker,
      pos,
      "E0316",
      `this call passes ${Int.toString(passed)} arguments, the function takes ${Int.toString(Arrays.length(funcParams))}`,
    )
  }
  checkCalleeExclusive(mutable checker, callee, arguments)
  return funcResult
}

function checkCalleeExclusive(
  mutable checker: Checker,
  callee: Expr,
  arguments: Array<Arg>,
) uses alloc {
  // The call could otherwise change or free the function value it is calling (SPEC section 6, exclusive access).
  for (const arg of Arrays.values(arguments)) {
    let roots: Array<int> = []
    collectMutableRoots(checker, arg.value, mutable roots)
    for (const root of Arrays.values(roots)) {
      if (usesLocal(checker, callee, root)) {
        const rootName = quoteGo(checker.bodies[checker.body].locals[root].name)
        reportError(
          mutable checker,
          getExpressionPos(arg.value),
          "E0609",
          `${rootName} is passed as mutable inside this call, so it cannot also hold the function being called`,
        )
      }
    }
  }
}

function collectMutableRoots(
  checker: Checker,
  expression: Expr,
  mutable roots: Array<int>,
) uses alloc {
  match (expression) {
    Expr.CallExpr(_, _, callee, _, arguments) => {
      collectMutableRoots(checker, callee, mutable roots)
      for (const arg of Arrays.values(arguments)) {
        if (arg.isMutable) {
          const root = findAssignedLocal(checker, arg.value)
          if (root >= 0) {
            Arrays.push(mutable roots, root)
          }
        }
        collectMutableRoots(checker, arg.value, mutable roots)
      }
    }
    Expr.FieldExpr(_, _, target, _) => collectMutableRoots(checker, target, mutable roots)
    Expr.IndexExpr(_, _, target, index) => {
      collectMutableRoots(checker, target, mutable roots)
      collectMutableRoots(checker, index, mutable roots)
    }
    Expr.UnaryExpr(_, _, _, operand) => collectMutableRoots(checker, operand, mutable roots)
    Expr.AwaitExpr(_, _, operand) => collectMutableRoots(checker, operand, mutable roots)
    Expr.AsyncExpr(_, _, operand) => collectMutableRoots(checker, operand, mutable roots)
    Expr.BinaryExpr(_, _, _, left, right) => {
      collectMutableRoots(checker, left, mutable roots)
      collectMutableRoots(checker, right, mutable roots)
    }
    Expr.IsExpr(_, _, subject, _) => collectMutableRoots(checker, subject, mutable roots)
    Expr.TemplateLit(_, _, parts) => collectAllRoots(checker, parts, mutable roots)
    Expr.StructLit(_, _, _, _, fields, _) => {
      for (const field of Arrays.values(fields)) {
        collectMutableRoots(checker, field.value, mutable roots)
      }
    }
    Expr.ArrayLit(_, _, elements, _) => collectAllRoots(checker, elements, mutable roots)
    Expr.BlockExpr(_, _, block) => collectAllRoots(
      checker,
      listBlockExpressions(block),
      mutable roots,
    )
    Expr.MapLit(_, _, _, keys, values) => {
      for (const index of Ranges.between(0, Arrays.length(keys))) {
        collectMutableRoots(checker, keys[index], mutable roots)
        collectMutableRoots(checker, values[index], mutable roots)
      }
    }
    Expr.MatchExpr(_, _, subject, arms) => {
      collectMutableRoots(checker, subject, mutable roots)
      for (const arm of Arrays.values(arms)) {
        collectArmRoots(checker, arm, mutable roots)
      }
    }
    _ => {}
  }
}

function collectAllRoots(
  checker: Checker,
  expressions: Array<Expr>,
  mutable roots: Array<int>,
) uses alloc {
  for (const expression of Arrays.values(expressions)) {
    collectMutableRoots(checker, expression, mutable roots)
  }
}

function collectArmRoots(checker: Checker, arm: MatchArm, mutable roots: Array<int>) uses alloc {
  if (arm.guard is Some(guard)) {
    collectMutableRoots(checker, guard, mutable roots)
  }
  if (arm.body is Some(body)) {
    collectMutableRoots(checker, body, mutable roots)
  }
  if (arm.block is Some(block)) {
    collectAllRoots(checker, listBlockExpressions(block), mutable roots)
  }
}

export function checkArrowArgument<W: Walker>(
  mutable checker: Checker,
  walker: W,
  argument: Expr,
  hintParameters: Array<Type>,
  hintResult: Option<Type>,
): Type from hintParameters uses alloc {
  // An arrow function gets its environment on the stack and a hint of the parameter types the helper decides; a name may be a non-escaping function parameter. hintResult is None when the callback decides the result.
  const body = checker.body
  match (argument) {
    Expr.ArrowExpr(arrowId, _, _, _, _, _) => {
      const closure = findClosure(mutable checker, arrowId)
      let hinted: Array<Option<Type>> = []
      for (const hintParam of Arrays.values(hintParameters)) {
        Arrays.push(mutable hinted, Some(hintParam))
      }
      checker.bodies[body].closures[closure].stack = true
      checker.bodies[body].closures[closure].hasHint = true
      checker.bodies[body].closures[closure].hintParameters = hinted
      checker.bodies[body].closures[closure].hintResult = hintResult
    }
    Expr.AsyncExpr(_, _, Expr.ArrowExpr(arrowId, _, _, _, _, _)) => {
      // The task copies the captures, so the closure itself may stay on the stack.
      const closure = findClosure(mutable checker, arrowId)
      let hinted: Array<Option<Type>> = []
      for (const hintParam of Arrays.values(hintParameters)) {
        Arrays.push(mutable hinted, Some(hintParam))
      }
      let valueHint: Option<Type> = None
      if (hintResult is Some(hintedHandle)) {
        valueHint = findHandleValue(hintedHandle)
      }
      checker.bodies[body].closures[closure].stack = true
      checker.bodies[body].closures[closure].hasHint = true
      checker.bodies[body].closures[closure].hintParameters = hinted
      checker.bodies[body].closures[closure].hintResult = valueHint
    }
    Expr.Ident(identId, _, _) => {
      checker.bodies[body].allowedId = identId
    }
    _ => {}
  }
  let want: Option<Type> = None
  if (hintResult is Some(resultType)) {
    want = Some(Type.TFunc(hintParameters, resultType, [], -1, -1))
  }
  return copy(checkExpression(mutable checker, walker, argument, want))
}
