import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Boxes from "std/box"

struct Tree {
  label: int
  children: Array<Tree>
}

struct Link {
  label: int
  next: Option<Box<Link>>
}

struct Holder {
  label: int
  callback: Option<() => int>
}

export function run(args: Array<string>): int {
  // a struct pushed into its own array field: the alias shares the array, so the push copies
  let tree = Tree { label: 1, children: [] }
  const alias = tree
  Arrays.push(mutable tree.children, alias)
  print(Int.toString(Arrays.length(tree.children)))
  print(Int.toString(Arrays.length(tree.children[0].children)))

  // a box stored in its own payload: the box is shared, so the write copies
  let link = Boxes.new(Link { label: 1, next: None })
  link.value = Link { label: 2, next: Some(link) }
  print(Int.toString(link.value.label))

  // a closure stored in the struct it captures: it captures a copy
  let holder = Holder { label: 3, callback: None }
  const snapshot = holder
  holder.callback = Some(() => snapshot.label)
  print(Int.toString(holder.label))
  return 0
}
