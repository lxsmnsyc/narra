// std/json: float text reads back exactly.
import * as Json from "std/json"
import { Value } from "std/shape"

function show(text: string) uses io, alloc {
  const parsed = Json.parse(text)
  if (parsed is Ok(value)) {
    const written = Json.stringify(value)
    const again = Json.parse(written)
    let same = "no"
    if (again is Ok(other)) {
      if (Json.stringify(other) == written) {
        same = "same"
      }
    }
    print(`${text} -> ${written} ${same}`)
  } else if (parsed is Err(message)) {
    print(`${text} -> error ${message}`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  show("0.1")
  show("0.30000000000000004")
  show("1e-300")
  show("5e-324")
  show("1.7976931348623157e308")
  show("1e22")
  show("1E+2")
  show("-2.5e-3")
  show("123456789012345678")
  show("12345678901234567890")
  show("1e999")
  show("[0.5, 100.0]")
  return 0
}
