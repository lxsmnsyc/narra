// error: Ptr.alloc takes its element type from where the result goes, as in `const items: Ptr<int> = Ptr.alloc(4)`
import * as Ptr from "std/ptr"

export function run(_args: Array<string>): int uses alloc, unsafe {
  unsafe {
    const items = Ptr.alloc(4)
    const value = Ptr.read(3)
    const counts: Ptr<int> = Ptr.alloc(1)
    Ptr.write(counts, "one")
    Ptr.free(counts)
  }
  return 0
}
