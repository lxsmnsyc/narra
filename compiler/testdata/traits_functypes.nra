// Function types compare by their parameters and result, and give
// different C names per signature. No function value can be made yet
// (closures), so these functions are compiled but never called.

struct Box<T> {
  value: T
}

function same(g: (x: int) => int): (x: int) => int {
  return g
}

function id<T>(v: T): T {
  return v
}

function viaGeneric(g: (x: int) => int): (y: int) => int {
  return id(g)
}

function wrap(g: (x: int) => int): Box<(x: int) => int> {
  return Box { value: g }
}

function wrapBool(g: (x: bool) => int): Box<(x: bool) => int> {
  return Box { value: g }
}

function unwrap(b: Box<(x: int) => int>): (x: int) => int {
  return b.value
}

export function run(args: Array<string>): int {
  print("function types check")
  return 0
}
