// error: Simd.load takes its vector type from where the result goes or from a type argument
import * as Simd from "std/simd"

export function run(_args: Array<string>): int {
  const items: Array<f32> = [1.0, 2.0, 3.0, 4.0]
  const loaded = Simd.load(items, 0)
  const ints: Option<I32x4> = Simd.load(items, 0)
  return 0
}
