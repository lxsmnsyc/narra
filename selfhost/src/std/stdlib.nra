// The standard library's registry: one StdFunc per builtin, in the order of the
// std modules (the prelude first). The rows of each module are in std<module>.nra
// beside its checks and emitters; this file registers them and resolves the type
// texts of the rows.
import {
  StdFunc,
  StdType,
  Registry,
  newRegistry,
  register,
  registerType,
} from "narrac/std/builtins"
import { Checker, typeString } from "narrac/check/check"
import { stdType } from "narrac/std/stdtypes"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"
import { PRELUDE_FUNCS } from "narrac/std/stdprelude"
import { INT_FUNCS } from "narrac/std/stdint"
import { FLOAT_FUNCS } from "narrac/std/stdfloat"
import { STRING_FUNCS, listStringTypes } from "narrac/std/stdstring"
import { ARRAY_FUNCS } from "narrac/std/stdarray"
import { BOX_FUNCS } from "narrac/std/stdbox"
import { POINTER_FUNCS, listPointerTypes } from "narrac/std/stdptr"
import { SIMD_FUNCS, listSimdTypes } from "narrac/std/stdsimd"
import { CHAR_FUNCS } from "narrac/std/stdchar"
import { CELL_FUNCS } from "narrac/std/stdcell"
import { COROUTINE_FUNCS } from "narrac/std/stdcoroutine"
import {
  INTERNAL_CELL_FUNCS,
  INTERNAL_CLOCK_FUNCS,
  INTERNAL_TERMINAL_FUNCS,
  INTERNAL_COROUTINE_FUNCS,
  INTERNAL_ENTROPY_FUNCS,
  INTERNAL_FLOAT_FUNCS,
  INTERNAL_PROBE_FUNCS,
  internalMathFuncs,
} from "narrac/std/stdinternal"
import { ENV_FUNCS } from "narrac/std/stdenv"
import { FS_FUNCS } from "narrac/std/stdfs"
import { IO_FUNCS } from "narrac/std/stdio"
import { JSON_FUNCS } from "narrac/std/stdjson"
import { HASH_FUNCS } from "narrac/std/stdhash"
import { MATH_FUNCS } from "narrac/std/stdmath"
import { TIME_FUNCS } from "narrac/std/stdtime"
import { BUILD_FUNCS } from "narrac/std/stdbuild"
import { RANDOM_FUNCS } from "narrac/std/stdrandom"
import { MAP_FUNCS } from "narrac/std/stdmap"
import { OPTION_FUNCS } from "narrac/std/stdoption"
import { PATH_FUNCS } from "narrac/std/stdpath"
import { PROCESS_FUNCS } from "narrac/std/stdprocess"
import { RANGE_FUNCS } from "narrac/std/stdrange"
import { RESULT_FUNCS } from "narrac/std/stdresult"
import { SHAPE_FUNCS } from "narrac/std/stdshape"
import { TEST_FUNCS } from "narrac/std/stdtest"
import { F32_FUNCS } from "narrac/std/stdf32"
import { BYTES_FUNCS } from "narrac/std/stdbytes"
import { sizedFuncs, intConversionFuncs } from "narrac/std/stdsized"
import { CSTRING_FUNCS } from "narrac/check/externs"
import { ASYNC_FUNCS, INTERNAL_ASYNC_FUNCS } from "narrac/std/stdasync"
import { ASYNC_IO_FUNCS, INTERNAL_ASYNC_IO_FUNCS } from "narrac/std/stdasyncio"
import { THREAD_FUNCS, INTERNAL_THREAD_FUNCS } from "narrac/std/stdthread"
import { ITERATOR_FUNCS } from "narrac/std/stditerator"
import { ARGS_FUNCS } from "narrac/std/stdargs"
import { ARENA_FUNCS } from "narrac/std/stdarena"
import { SET_FUNCS } from "narrac/std/stdset"
import { SEMVER_FUNCS } from "narrac/std/stdsemver"
import { TOML_FUNCS } from "narrac/std/stdtoml"
import { TERMINAL_FUNCS } from "narrac/std/stdterminal"
import { REGEX_FUNCS } from "narrac/std/stdregex"
import { UNICODE_FUNCS } from "narrac/std/stdunicode"
import { URL_FUNCS } from "narrac/std/stdurl"

// std/fixedarray is Narra source (std/src/fixedarray.nra): a module row with no function.
const FIXED_ARRAY_FUNCS: Array<StdFunc> = [
  StdFunc { name: "std/fixedarray", module: "std/fixedarray", key: "", check: "source" },
]

// std/template is Narra source (std/src/template.nra), the parts type and tag of tagged templates (D114).
const TEMPLATE_FUNCS: Array<StdFunc> = [
  StdFunc { name: "std/template", module: "std/template", key: "", check: "source" },
]

function registerAll(mutable registry: Registry, table: Array<StdFunc>) uses alloc {
  for (const builtin of Arrays.values(table)) {
    register(mutable registry, builtin)
  }
}

function registerTypes(mutable registry: Registry, types: Array<StdType>) uses alloc {
  for (const builtinType of Arrays.values(types)) {
    registerType(mutable registry, builtinType)
  }
}

export function stdRegistry(): Registry uses alloc {
  // Registration order gives the module order of the registry. A new std module adds its
  // import and one line here.
  let registry = newRegistry()
  registerAll(mutable registry, PRELUDE_FUNCS)
  registerAll(mutable registry, INT_FUNCS)
  registerAll(mutable registry, intConversionFuncs())
  registerAll(mutable registry, FLOAT_FUNCS)
  registerAll(mutable registry, STRING_FUNCS)
  registerAll(mutable registry, ARRAY_FUNCS)
  registerAll(mutable registry, BOX_FUNCS)
  registerAll(mutable registry, POINTER_FUNCS)
  registerAll(mutable registry, CELL_FUNCS)
  registerAll(mutable registry, CHAR_FUNCS)
  registerAll(mutable registry, COROUTINE_FUNCS)
  registerAll(mutable registry, INTERNAL_COROUTINE_FUNCS)
  registerAll(mutable registry, INTERNAL_CELL_FUNCS)
  registerAll(mutable registry, ENV_FUNCS)
  registerAll(mutable registry, FS_FUNCS)
  registerAll(mutable registry, INTERNAL_CLOCK_FUNCS)
  registerAll(mutable registry, INTERNAL_TERMINAL_FUNCS)
  registerAll(mutable registry, INTERNAL_ENTROPY_FUNCS)
  registerAll(mutable registry, INTERNAL_FLOAT_FUNCS)
  registerAll(mutable registry, internalMathFuncs())
  registerAll(mutable registry, INTERNAL_PROBE_FUNCS)
  registerAll(mutable registry, IO_FUNCS)
  registerAll(mutable registry, HASH_FUNCS)
  registerAll(mutable registry, JSON_FUNCS)
  registerAll(mutable registry, MATH_FUNCS)
  registerAll(mutable registry, MAP_FUNCS)
  registerAll(mutable registry, OPTION_FUNCS)
  registerAll(mutable registry, PATH_FUNCS)
  registerAll(mutable registry, PROCESS_FUNCS)
  registerAll(mutable registry, RANGE_FUNCS)
  registerAll(mutable registry, RANDOM_FUNCS)
  registerAll(mutable registry, RESULT_FUNCS)
  registerAll(mutable registry, SHAPE_FUNCS)
  registerAll(mutable registry, TEST_FUNCS)
  registerAll(mutable registry, TIME_FUNCS)
  registerAll(mutable registry, BUILD_FUNCS)
  registerAll(mutable registry, sizedFuncs())
  registerAll(mutable registry, F32_FUNCS)
  registerAll(mutable registry, BYTES_FUNCS)
  registerAll(mutable registry, FIXED_ARRAY_FUNCS)
  registerAll(mutable registry, TEMPLATE_FUNCS)
  registerAll(mutable registry, CSTRING_FUNCS)
  registerAll(mutable registry, ASYNC_FUNCS)
  registerAll(mutable registry, INTERNAL_ASYNC_FUNCS)
  registerAll(mutable registry, ASYNC_IO_FUNCS)
  registerAll(mutable registry, INTERNAL_ASYNC_IO_FUNCS)
  registerAll(mutable registry, THREAD_FUNCS)
  registerAll(mutable registry, INTERNAL_THREAD_FUNCS)
  registerAll(mutable registry, SIMD_FUNCS)
  registerAll(mutable registry, ITERATOR_FUNCS)
  registerAll(mutable registry, ARGS_FUNCS)
  registerAll(mutable registry, ARENA_FUNCS)
  registerAll(mutable registry, SET_FUNCS)
  registerAll(mutable registry, SEMVER_FUNCS)
  registerAll(mutable registry, TOML_FUNCS)
  registerAll(mutable registry, TERMINAL_FUNCS)
  registerAll(mutable registry, REGEX_FUNCS)
  registerAll(mutable registry, UNICODE_FUNCS)
  registerAll(mutable registry, URL_FUNCS)
  // A module that brings a type into view without source registers it after its functions.
  registerTypes(mutable registry, listStringTypes())
  registerTypes(mutable registry, listPointerTypes())
  registerTypes(mutable registry, listSimdTypes())
  return registry
}

export function listDisplayProblems(registry: Registry): Array<string> uses alloc {
  // `narrac builtins` prints the lines, and the query suite fails on them: every public row
  // shows named parameters in `narrac query interface`.
  let problems: Array<string> = []
  for (const builtin of Arrays.values(registry.functions)) {
    if (Str.startsWith(builtin.module, "std/internal/")) {
      continue
    }
    const hasCheck = builtin.check != "" && builtin.check != "fixed"
    if (hasCheck && builtin.signature == "") {
      Arrays.push(mutable problems, `display ${builtin.name}: a check function and no signature`)
    }
    const nameCount = Arrays.length(builtin.parameterNames)
    const parameterCount = Arrays.length(builtin.parameters)
    if (builtin.signature == "" && nameCount != parameterCount) {
      Arrays.push(
        mutable problems,
        `display ${builtin.name}: ${Int.toString(nameCount)} parameter names for ${Int.toString(parameterCount)} parameters`,
      )
    }
  }
  return problems
}

export function typeProblems(mutable checker: Checker): Array<string> uses alloc {
  // The checker must have declared the prelude. `narrac builtins` prints the lines, so a typo
  // in the table fails TestSelfhostBuiltins.
  let out: Array<string> = []
  const functions = copy(checker.registry.functions)
  for (const builtin of Arrays.values(functions)) {
    let texts = copy(builtin.parameters)
    if (builtin.result != "") {
      Arrays.push(mutable texts, builtin.result)
    }
    for (const text of Arrays.values(texts)) {
      const type = stdType(mutable checker, text)
      const back = typeString(checker, type)
      if (back != text) {
        Arrays.push(mutable out, `stdType ${builtin.name}: ${text} prints as ${back}`)
      }
    }
  }
  return out
}
