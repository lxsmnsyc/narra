// error: Arrays.push(mutable items, ...) may change items, which the cell sender[] still holds; no fix is offered here: copy the value by hand where the sharing starts, or end the sharing before the write
import * as Arrays from "std/array"
import * as Channel from "std/channel"

export function run(_args: Array<string>): int uses io, alloc {
  const #[sender, _receiver] = Channel.create<Array<int>>(2)
  let items = [1, 2, 3]
  Channel.send(sender, items)
  Arrays.push(mutable items, 4)
  return Arrays.length(items)
}
