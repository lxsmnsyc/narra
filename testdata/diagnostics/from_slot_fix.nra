// code: E0977
struct Board {
  cells: Array<int>
}

function firstCells(board: Board): Array<int> from board {
  return board.cells
}

function useCells(pick: (Board) => Array<int>, board: Board): int {
  return pick(board)[0]
}

export function run(_args: Array<string>): int {
  return useCells(firstCells, Board { cells: [3] })
}
