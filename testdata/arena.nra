// std/arena: insert, get, set, update, remove, slot reuse, clear, entries and a handle as a map key.
import * as Arenas from "std/arena"
import { Arena, Handle } from "std/arena"

function show(label: string, found: Option<string>) uses io, alloc {
  match (found) { Some(text) => print(`${label}: ${text}`), None => print(`${label}: none`) }
}

export function run(args: Array<string>): int uses io, alloc {
  let arena: Arena<string> = Arenas.create()
  const first = Arenas.insert(mutable arena, "one")
  const second = Arenas.insert(mutable arena, "two")
  const third = Arenas.insert(mutable arena, "three")
  print(`size ${Show.show(Arenas.size(arena))}`)
  show("get first", Arenas.get(arena, first))

  // set and update
  print(`set second: ${Show.show(Arenas.set(mutable arena, second, "TWO"))}`)
  print(`update third: ${Show.show(Arenas.update(mutable arena, third, (text) => `${text}!`))}`)
  show("get second", Arenas.get(arena, second))
  show("get third", Arenas.get(arena, third))

  // remove, then reuse the slot: the old handle is stale
  show("remove second", Arenas.remove(mutable arena, second))
  print(`size ${Show.show(Arenas.size(arena))}`)
  print(`contains second: ${Show.show(Arenas.contains(arena, second))}`)
  show("remove second again", Arenas.remove(mutable arena, second))
  const fourth = Arenas.insert(mutable arena, "four")
  print(`same handle: ${Show.show(fourth == second)}`)
  show("get stale", Arenas.get(arena, second))
  print(`set stale: ${Show.show(Arenas.set(mutable arena, second, "x"))}`)
  print(`update stale: ${Show.show(Arenas.update(mutable arena, second, (text) => `${text}?`))}`)
  show("get fourth", Arenas.get(arena, fourth))

  // entries in slot order
  for (const #[handle, text] of Arenas.entries(arena)) {
    print(`entry ${Show.show(handle)}: ${text}`)
  }

  // a handle as a map key
  let names: Map<Handle<string>, int> = Map {}
  names[first] = 10
  names[third] = 30
  print(`key first: ${Show.show(names[first])}`)
  print(`key stale: ${Show.show(names[second])}`)

  // clear raises every generation
  Arenas.clear(mutable arena)
  print(`size after clear ${Show.show(Arenas.size(arena))}`)
  show("get first after clear", Arenas.get(arena, first))
  show("get fourth after clear", Arenas.get(arena, fourth))
  const fresh = Arenas.insert(mutable arena, "fresh")
  show("get fresh", Arenas.get(arena, fresh))
  print(`first == fresh: ${Show.show(first == fresh)}`)
  return 0
}
