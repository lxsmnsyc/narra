import * as Int from "std/int"
import * as Arrays from "std/array"

function none<T>(): Option<T> {
  return None
}

function first<T>(items: Array<T>): Option<T> from items {
  if (Arrays.length(items) == 0) {
    return None
  }
  return Some(items[0])
}

function pair<A, B>(left: A, right: B): #[A, B] from left {
  return #[left, copy(right)]
}

function empty<T>(): Array<T> {
  return []
}

function count<T>(items: Array<T>): int {
  return Arrays.length(items)
}

trait Describe {
  function make(seed: int): Self
  function label(self: Self): string
}

struct Dog implements Describe {
  age: int
}

struct Cat implements Describe {
  age: int
}

implement Describe for Dog {
  function make(seed: int): Dog {
    return Dog { age: seed }
  }
  function label(self: Dog): string {
    return `dog ${Int.toString(self.age)}`
  }
}

implement Describe for Cat {
  function make(seed: int): Cat {
    return Cat { age: seed * 2 }
  }
  function label(self: Cat): string {
    return `cat ${Int.toString(self.age)}`
  }
}

// Self appears only in the result, so the type must be named.
function build<T: Describe>(seed: int): T {
  return Describe.make<T>(seed)
}

function describeNew<T: Describe>(seed: int): string {
  const value = Describe.make<T>(seed)
  return Describe.label(value)
}

export function run(args: Array<string>): int {
  // Inference cannot tell T here.
  const nothing = none<int>()
  if (nothing is None) {
    print("none")
  }
  const nested = first<Array<int>>([[1, 2], [3]])
  if (nested is Some(inner)) {
    print(Int.toString(count<int>(inner)))
  }
  const #[number, text] = pair<int, string>(7, "seven")
  print(`${Int.toString(number)} ${text}`)
  const options = empty<Option<string>>()
  print(Int.toString(count<Option<string>>(options)))

  // Trait calls name Self.
  const dog = Describe.make<Dog>(3)
  print(Describe.label(dog))
  print(Describe.label(Describe.make<Cat>(4)))
  print(Describe.label(build<Dog>(5)))
  print(describeNew<Cat>(6))

  // Comparisons still parse as comparisons.
  const small = 1
  const big = 2
  const flag = true
  if (small < big) {
    print("less")
  }
  if (flag == (small < big)) {
    print("same")
  }
  return 0
}
