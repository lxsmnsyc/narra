// error: Resettable.reset takes `mutable Self`, so Resettable can only be implemented for a type whose contents change in place
trait Resettable {
  function reset(mutable value: Self)
}

enum Light implements Resettable {
  Red
  Green
}

implement Resettable for Light {
  function reset(mutable _value: Light) {
    print("reset")
  }
}

export function run(args: Array<string>): int {
  return 0
}
