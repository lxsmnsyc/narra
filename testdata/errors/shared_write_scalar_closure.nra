// error: the arrow function at line 16, which changes cursor, may change cursor, which saved still uses at line 19
struct Pos {
  line: int
  column: int
}

function twice(visit: () => void) {
  visit()
  visit()
}

export function run(_args: Array<string>): int {
  const cursor = Pos { line: 1, column: 0 }
  const saved = cursor
  // The arrow function changes the captured cursor where it is passed to twice.
  twice(() => {
    cursor.column += 1
  })
  return cursor.column + saved.column
}
