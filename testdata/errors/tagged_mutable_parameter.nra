// error: a tag must be a function of (Array<string> or Template.Raw, Array<T>) with no mutable parameter, found (mutable Array<string>, Array<string>) => string
import * as Str from "std/string"

function tag(mutable parts: Array<string>, values: Array<string>): string {
  return Str.join(parts, Str.join(values, ""))
}

export function run(_args: Array<string>): int {
  print(tag`x`)
  return 0
}
