// error: * needs two vectors of the same type, found F32x4 and f32; make a vector of the scalar with Simd.splat(...)
import * as Simd from "std/simd"

export function run(_args: Array<string>): int {
  const v: F32x4 = [1.0, 2.0, 3.0, 4.0]
  const scaled = v * 2.0
  const shifted = 1.0 + v
  const wide: F64x4 = Simd.splat(1.0)
  const mixed = v == wide
  let total: F32x4 = Simd.splat(0.0)
  total += 1.0
  print(Show.show([scaled, shifted, total]))
  print(Show.show(mixed))
  return 0
}
