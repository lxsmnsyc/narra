// error: let_narrowing_same_statement_param.nra:11:12: this Option<int> may hold any of its variants; check it with `is` or `match` before reading "value"
function clear(mutable x: Option<int>): int {
  x = None
  return 0
}

function read(mutable p: Option<int>): int {
  if (p is None) {
    return 0
  }
  return p.value + clear(mutable p)
}

export function run(args: Array<string>): int {
  return read(Some(1))
}
