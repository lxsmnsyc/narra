import * as Float from "std/float"
import * as F32 from "std/f32"
import * as I32 from "std/i32"

struct Point {
  x: f32
  y: f32
}

function show<T: Show>(label: string, value: T) uses io, alloc {
  print(`${label}: ${Show.show(value)}`)
}

function half(value: f32): f32 {
  return value / 2.0
}

export function run(args: Array<string>): int uses io, alloc {
  // Arithmetic at f32 precision; the literals take f32 from the context.
  const a: f32 = 1.5
  const b: f32 = 0.25
  show("sum", a + b)
  show("difference", a - b)
  show("product", a * b)
  show("quotient", a / b)
  show("remainder", a % 1.0)
  show("negated", -a)
  show("literal left", 0.5 + a)
  show("half", half(3.0))

  // 0.1 as f32 and as f64.
  const tenth32: f32 = 0.1
  const tenth64 = 0.1
  print(`f32 ${F32.toString(tenth32)} f64 ${Float.toString(tenth64)}`)
  print(`sum f32 ${F32.toString(tenth32 + 0.2)} f64 ${Float.toString(tenth64 + 0.2)}`)
  show("widened", Float.from(tenth32))

  // F32.from rounds to nearest; integers convert too.
  show("from f64", F32.from(0.1))
  show("from big", F32.from(16777217.0))
  show("from int", F32.from(16777217))
  show("from i32", F32.from(I32.wrap(7)))
  show("float from int", Float.from(3))
  show("float from i32", Float.from(I32.wrap(-4)))
  show("fromInt", Float.fromInt(5))

  // truncate and toString.
  show("truncate", F32.truncate(-2.75))
  show("truncate big", F32.truncate(F32.from(123456.9)))
  print(F32.toString(1.0e10))
  print(F32.toString(3.4028235e38))

  // NaN and infinities.
  const zero: f32 = 0.0
  const infinity = 1.0 / zero
  const negative = -1.0 / zero
  const nan = zero / zero
  show("infinity", infinity)
  show("negative", negative)
  show("nan eq", nan == nan)
  show("nan ne", nan != nan)
  show("inf gt", infinity > 3.0e38)

  // Equatable, Ordered and Show on a struct of f32 fields.
  const p = Point { x: 1.5, y: 2.5 }
  const q = Point { x: 1.5, y: 2.5 }
  const r = Point { x: 1.5, y: 3.5 }
  show("p == q", p == q)
  show("p == r", p == r)
  show("compare", Ordered.compare(a, b))
  show("less", b < a)
  return 0
}
