// lead
export function pick(index: int, count: int): int // after signature
  // before requires
  requires index >= 0 && index < 64 // trailing on requires
  requires count != 0
  // before body
{
  return index % count
}

function longer(alphaParameterName: int, betaParameterName: int, gammaParameterName: int): int
  requires alphaParameterName >= 0 && alphaParameterName < 1000000 && alphaParameterName != 5 && alphaParameterName != 7
{
  return alphaParameterName + betaParameterName + gammaParameterName
}
