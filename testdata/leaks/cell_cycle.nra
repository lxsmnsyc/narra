// A closure stored in a Cell that captures the same Cell is a cycle: the leak check reports it.
import * as Cells from "std/cell"
import { Cell } from "std/cell"
import * as Int from "std/int"

export function run(args: Array<string>): int uses io, alloc {
  const cell: Cell<Option<() => int>> = Cells.create(None)
  Cells.set(
    cell,
    Some((): int => {
      if (Cells.get(cell) is Some(_)) {
        return 1
      }
      return 0
    }),
  )
  if (Cells.get(cell) is Some(read)) {
    print(`read ${Int.toString(read())}`)
  }
  return 0
}
