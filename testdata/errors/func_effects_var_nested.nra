// error: Function `pure` uses `io` but its signature does not declare it
function loud(value: int): int {
  print("x")
  return value
}
function quiet(value: int): int {
  return value
}
export function twice<effect E>(f: (value: int) => int uses E, value: int): int uses E {
  return f(f(value))
}
export function wrap<effect E>(escaping f: (value: int) => int uses E): (value: int) => int uses E {
  return f
}
export struct Box {
  f: (value: int) => int uses io
}
export struct Plain {
  f: (value: int) => int
}

export function pure(b: Box): int {
  return wrap(wrap(b.f))(1)
}

export function run(args: Array<string>): int {
  return twice(quiet, 1) + wrap(loud)(1) + wrap(quiet)(1)
}
