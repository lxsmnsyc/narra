trait Op {
  function run(mutable v: Self, by: int): int
}

struct A implements Op {
  n: int
}

implement Op for A {
  function run(v: A, by: int): int {
    return 1
  }
}

struct B implements Show {
  n: int
}

implement Show for B {
  function show(value: B): int {
    return 1
  }
  function extra(value: B): string {
    return ""
  }
}
