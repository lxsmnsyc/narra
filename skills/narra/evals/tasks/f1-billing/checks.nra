import { discounted, total } from "task/billing"
import * as Test from "std/test"

test "total adds the prices" {
  Test.eq(total([100, 250, 50]), 400)
}

test "total of nothing" {
  Test.eq(total([]), 0)
}

test "discount" {
  Test.eq(discounted(200, 25), 150)
}

test "discount is capped at 100 percent" {
  Test.eq(discounted(200, 150), 0)
}
