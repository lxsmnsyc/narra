import * as Int from "std/int"

export function divide(dividend: int, divisor: int): Result<int, string> {
  if (divisor == 0) {
    return Err("divide by zero")
  }
  return Ok(dividend / divisor)
}

export function ratio(dividend: int, divisor: int): string uses alloc {
  const quotient = divide(dividend, divisor)
  if (quotient is Ok(value)) {
    return Int.toString(value)
  }
  return "undefined"
}
