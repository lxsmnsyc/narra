// error: "handlers" is passed as mutable inside this call, so it cannot also hold the function being called
function adder(n: int): (x: int) => int {
  return (x) => x + n
}

function swap(mutable handlers: Array<(x: int) => int>): int {
  handlers[0] = adder(1000)
  return 5
}

export function run(args: Array<string>): int {
  const handlers = [adder(1)]
  return handlers[0](swap(mutable handlers))
}
