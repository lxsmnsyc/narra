// error: a closure cannot capture mutable parameter "counter" unless it is passed straight to a function parameter that is not escaping
struct Counter {
  n: int
}

function bump(mutable counter: Counter): () => int {
  return () => counter.n
}

export function run(args: Array<string>): int {
  let x = Counter { n: 1 }
  return bump(mutable x)()
}
