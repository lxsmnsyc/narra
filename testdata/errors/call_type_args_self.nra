// error: call_type_args_self.nra:17:28: Describe.make has Self only in its result; name the type, as in Describe.make<Type>(...)
trait Describe {
  function make(seed: int): Self
}

struct Dog implements Describe {
  age: int
}

implement Describe for Dog {
  function make(seed: int): Dog {
    return Dog { age: seed }
  }
}

export function run(args: Array<string>): int {
  const dog = Describe.make(3)
  return dog.age
}
