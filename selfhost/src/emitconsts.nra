// Constants and function bodies (emit_const.go, emit.go function and the test
// bodies). Stub from selfhost-emit-core; the owner is selfhost-emit-bodies.
// Every program has a function, so the stubs always have work.
import { Emitter, reportUnsupported } from "narrac/emitstate"
import { ProgramFunc } from "narrac/check"

const NODE = "selfhost-emit-bodies"

export function emitConstPrototypes(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "constant prototypes", NODE)}\n`
}

export function emitConstBodies(mutable emitter: Emitter): string uses alloc {
  return `${reportUnsupported(mutable emitter, "constant bodies", NODE)}\n`
}

// emitFunction writes one function of Go's Program.Funcs.
export function emitFunction(mutable emitter: Emitter, program: ProgramFunc): string uses alloc {
  return `${reportUnsupported(mutable emitter, "function body", NODE)}\n`
}

// emitTestBody writes the n-th test of the program (test builds only).
export function emitTestBody(mutable emitter: Emitter, number: int): string uses alloc {
  return `${reportUnsupported(mutable emitter, "test body", NODE)}\n`
}
