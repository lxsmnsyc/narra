// error: mutable_read_conflict_block_operand.nra:14:5: "x" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = 10
  return 0
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  const total =
    x.n +
    {
      return bump(mutable x)
    }
  return total
}
