+
+// The scan for last-use moves over one function body. depth is the block
+// depth, and statements[depth] the serial of the statement being walked in
+// the block at that depth. A candidate is a `const` or `let` local of a
+// counted type; for each one the scan keeps its declaring depth, the serial of
+// the statement at that depth that holds its latest reference, and that
+// reference's node id, or -1 when the reference cannot move.
+struct MoveScan {
+  depth: int = 0
+  serial: int = 0
+  statements: Array<int> = [0]
+  arrows: int = 0
+  declaredDepth: Map<int, int>
+  lastStatement: Map<int, int>
+  lastRead: Map<int, int>
+  pinned: Map<int, bool>
+}
+
+export function findMoves(mutable emitter: Emitter, block: Block) uses alloc {
+  let scan = MoveScan {
+    declaredDepth: Map {},
+    lastStatement: Map {},
+    lastRead: Map {},
+    pinned: Map {},
+  }
+  scanBlock(emitter, mutable scan, block)
+  let moves: Map<int, int> = Map {}
+  for (const local of Arrays.values(emitter.checker.bodies[emitter.body].declared)) {
+    if (scan.lastRead[local] is Some(nodeId)) {
+      if (nodeId >= 0 && scan.pinned[local] is None) {
+        moves[nodeId] = local
+      }
+    }
+  }
+  emitter.moves = moves
+  emitter.movesBody = emitter.body
+}
+
+export function clearMoves(mutable emitter: Emitter) uses alloc {
+  emitter.moves = Map {}
+  emitter.movesBody = -1
+}
+
+function scanBlock(emitter: Emitter, mutable scan: MoveScan, block: Block) uses alloc {
+  for (const statement of Arrays.values(block.statements)) {
+    scanNested(emitter, mutable scan, statement)
+  }
+}
+
+function scanNested(emitter: Emitter, mutable scan: MoveScan, statement: Stmt) uses alloc {
+  // The statement is walked one block deeper, so nothing in it can move a
+  // local declared outside: a block statement, a branch, or a loop step.
+  scan.depth++
+  if (Arrays.length(scan.statements) <= scan.depth) {
+    Arrays.push(mutable scan.statements, 0)
+  }
+  scan.serial++
+  scan.statements[scan.depth] = scan.serial
+  scanStatement(emitter, mutable scan, statement)
+  scan.depth--
+}
+
+function scanStatement(emitter: Emitter, mutable scan: MoveScan, statement: Stmt) uses alloc {
+  match (statement) {
+    Stmt.BlockStmt(block) => scanBlock(emitter, mutable scan, block)
+    Stmt.VarStmt(nodeId, _, _, _, pattern, _, value) => {
+      scanExpression(emitter, mutable scan, value, true)
+      if (pattern is None) {
+        noteDeclaration(emitter, mutable scan, nodeId)
+      }
+    }
+    Stmt.AssignStmt(_, target, value) => {
+      scanExpression(emitter, mutable scan, value, true)
+      scanExpression(emitter, mutable scan, target, false)
+    }
+    Stmt.CompoundAssignStmt(_, target, _, value) => {
+      scanExpression(emitter, mutable scan, target, false)
+      scanExpression(emitter, mutable scan, value, false)
+    }
+    Stmt.ExprStmt(_, expression) => scanExpression(emitter, mutable scan, expression, true)
+    Stmt.ReturnStmt(_, value) => {
+      if (value is Some(returned)) {
+        scanExpression(emitter, mutable scan, returned, true)
+      }
+    }
+    Stmt.IfStmt(_, condition, then, orElse) => {
+      scanExpression(emitter, mutable scan, condition, true)
+      scanBlock(emitter, mutable scan, then)
+      if (orElse is Some(otherwise)) {
+        scanNested(emitter, mutable scan, otherwise)
+      }
+    }
+    Stmt.WhileStmt(_, _, condition, body) => {
+      scanExpression(emitter, mutable scan, condition, false)
+      scanBlock(emitter, mutable scan, body)
+    }
+    Stmt.CForStmt(_, _, init, condition, step, body) => {
+      if (init is Some(declaration)) {
+        scanStatement(emitter, mutable scan, declaration)
+      }
+      if (condition is Some(loopCondition)) {
+        scanExpression(emitter, mutable scan, loopCondition, false)
+      }
+      scanBlock(emitter, mutable scan, body)
+      if (step is Some(stepStatement)) {
+        scanNested(emitter, mutable scan, stepStatement)
+      }
+    }
+    Stmt.ForStmt(_, _, _, _, iterable, body, _) => {
+      scanExpression(emitter, mutable scan, iterable, false)
+      scanBlock(emitter, mutable scan, body)
+    }
+    Stmt.YieldStmt(_, value, _, _) => scanExpression(emitter, mutable scan, value, true)
+    Stmt.BreakStmt(_, _) | Stmt.ContinueStmt(_, _) => {}
+  }
+}
+
+function noteDeclaration(emitter: Emitter, mutable scan: MoveScan, nodeId: int) uses alloc {
+  // Only a plain `const` or `let` local of a counted type can move.
+  const info = emitter.checker.bodies[emitter.body]
+  const slot = findBodySlot(info, nodeId)
+  if (slot < 0) {
+    return
+  }
+  const localIndex = info.declared[slot]
+  if (localIndex < 0) {
+    return
+  }
+  const local = info.locals[localIndex]
+  if (local.param || local.binding != BindingKind.Plain || !needsRc(emitter, local.localType)) {
+    return
+  }
+  scan.declaredDepth[localIndex] = scan.depth
+}
+
+function noteReference(
+  emitter: Emitter,
+  mutable scan: MoveScan,
+  nodeId: int,
+  movable: bool,
+) uses alloc {
+  if (readNodeRef(emitter, nodeId) is Ref.Local(localIndex)) {
+    if (scan.declaredDepth[localIndex] is Some(depth)) {
+      if (scan.arrows > 0) {
+        // A closure captures it.
+        scan.pinned[localIndex] = true
+        return
+      }
+      // A second reference in the same statement keeps the local: the
+      // emitter does not always evaluate a statement in written order.
+      const statement = scan.statements[depth]
+      if (scan.lastStatement[localIndex] is Some(previous)) {
+        if (previous == statement) {
+          scan.lastRead[localIndex] = -1
+          return
+        }
+      }
+      scan.lastStatement[localIndex] = statement
+      if (movable && scan.depth == depth) {
+        scan.lastRead[localIndex] = nodeId
+      } else {
+        scan.lastRead[localIndex] = -1
+      }
+    }
+  }
+}
+
+function scanExpression(
+  emitter: Emitter,
+  mutable scan: MoveScan,
+  expression: Expr,
+  movable: bool,
+) uses alloc {
+  // movable is false where the expression may run more than once, on some
+  // paths only, or as a place.
+  match (expression) {
+    Expr.Ident(nodeId, _, _) => noteReference(emitter, mutable scan, nodeId, movable)
+    Expr.TemplateLit(_, _, parts) => {
+      for (const part of Arrays.values(parts)) {
+        scanExpression(emitter, mutable scan, part, movable)
+      }
+    }
+    Expr.FieldExpr(_, _, target, _) => scanExpression(emitter, mutable scan, target, movable)
+    Expr.IsExpr(_, _, subject, _) => scanExpression(emitter, mutable scan, subject, false)
+    Expr.IndexExpr(_, _, target, index) => {
+      scanExpression(emitter, mutable scan, target, movable)
+      scanExpression(emitter, mutable scan, index, movable)
+    }
+    Expr.MapLit(_, _, _, keys, values) => {
+      for (const index of Ranges.upTo(Arrays.length(keys))) {
+        scanExpression(emitter, mutable scan, keys[index], movable)
+        scanExpression(emitter, mutable scan, values[index], movable)
+      }
+    }
+    Expr.CallExpr(nodeId, _, callee, _, arguments) => {
+      scanExpression(emitter, mutable scan, callee, movable)
+      const passes = movable && callEvaluatesOnce(emitter, nodeId)
+      for (const argument of Arrays.values(arguments)) {
+        scanExpression(emitter, mutable scan, argument.value, passes && !argument.isMutable)
+      }
+    }
+    Expr.UnaryExpr(_, _, _, operand) => scanExpression(emitter, mutable scan, operand, movable)
+    Expr.BinaryExpr(_, _, operator, left, right) => {
+      scanExpression(emitter, mutable scan, left, movable)
+      const always = operator != "&&" && operator != "||"
+      scanExpression(emitter, mutable scan, right, movable && always)
+    }
+    Expr.StructLit(_, _, _, _, fields, spread) => {
+      for (const field of Arrays.values(fields)) {
+        scanExpression(emitter, mutable scan, field.value, movable)
+      }
+      if (spread is Some(source)) {
+        scanExpression(emitter, mutable scan, source, movable)
+      }
+    }
+    Expr.ArrayLit(_, _, elements, _) => {
+      for (const element of Arrays.values(elements)) {
+        scanExpression(emitter, mutable scan, element, movable)
+      }
+    }
+    Expr.MatchExpr(_, _, subject, arms) => {
+      scanExpression(emitter, mutable scan, subject, false)
+      for (const arm of Arrays.values(arms)) {
+        if (arm.guard is Some(guard)) {
+          scanExpression(emitter, mutable scan, guard, false)
+        }
+        if (arm.body is Some(body)) {
+          scanExpression(emitter, mutable scan, body, false)
+        }
+        if (arm.block is Some(armBlock)) {
+          scanBlock(emitter, mutable scan, armBlock)
+        }
+      }
+    }
+    Expr.BlockExpr(_, _, block) => scanBlock(emitter, mutable scan, block)
+    Expr.ArrowExpr(_, _, _, _, body, block) => {
+      scan.arrows++
+      if (body is Some(arrowBody)) {
+        scanExpression(emitter, mutable scan, arrowBody, false)
+      }
+      if (block is Some(arrowBlock)) {
+        scanBlock(emitter, mutable scan, arrowBlock)
+      }
+      scan.arrows--
+    }
+    _ => {}
+  }
+}
+
+function callEvaluatesOnce(emitter: Emitter, nodeId: int): bool {
+  // Calls of functions and constructors evaluate each argument once. Of the
+  // builtins only Array.push is known to; the others may skip an argument or
+  // read it twice.
+  return match (readNodeRef(emitter, nodeId)) {
+    Ref.Function(_) | Ref.Implementation(_, _) | Ref.Constructor(_, _) | Ref.Value => true
+    Ref.Builtin(index) => emitter.checker.registry.functions[index].name == "Array.push"
+    _ => false
+  }
+}
+
+export function takeMove(mutable emitter: Emitter, nodeId: int, localIndex: int): bool uses alloc {
+  // The read is the local's last use: the local leaves its scope, so no
+  // unwind emitted after this point releases it.
+  if (emitter.movesBody != emitter.body || Arrays.length(emitter.frames) == 0) {
+    return false
+  }
+  if (emitter.moves[nodeId] is Some(movedLocal)) {
+    if (movedLocal != localIndex) {
+      return false
+    }
+    emitter.moves[nodeId] = -1
+    for (let scope = Arrays.length(emitter.scopes) - 1; scope >= 0; scope--) {
+      const locals = emitter.scopes[scope].locals
+      for (const position of Ranges.upTo(Arrays.length(locals))) {
+        if (locals[position] == localIndex) {
+          let kept: Array<int> = []
+          for (const other of Ranges.upTo(Arrays.length(locals))) {
+            if (other != position) {
+              Arrays.push(mutable kept, locals[other])
+            }
+          }
+          emitter.scopes[scope].locals = kept
+          return true
+        }
+      }
+    }
+  }
+  return false
+}
