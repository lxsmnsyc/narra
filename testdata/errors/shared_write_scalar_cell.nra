// error: pos.line = ... may change pos, which the cell cursor still holds
import * as Cells from "std/cell"

struct Pos {
  line: int
  column: int
}

export function run(_args: Array<string>): int uses alloc {
  const cursor = Cells.create(Pos { line: 1, column: 2 })
  // A value read from a cell shares it with the cell.
  let pos = Cells.get(cursor)
  pos.line = 3
  return pos.line
}
