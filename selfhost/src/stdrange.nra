// The registry rows, checks of std/range.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Checker, Walker } from "narrac/check"
import { Pos, Arg } from "narrac/ast"
import { checkArgumentCount, checkArgumentAgainst } from "narrac/stdcheckhelp"

export const RANGE_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Range.between",
    module: "std/range",
    key: "between",
    check: "checkRangeBetween",
  },
  StdFunc {
    name: "Range.stepped",
    module: "std/range",
    key: "stepped",
    check: "checkRangeStepped",
  },
  StdFunc { name: "Range.upTo", module: "std/range", key: "upTo", check: "checkRangeUpTo" },
]

function checkRangeUpTo<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
  }
  return Type.TRange
}

function checkRangeBetween<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 2)) {
    checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, arguments[1].value, Type.TInt)
  }
  return Type.TRange
}

function checkRangeStepped<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 3)) {
    checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, arguments[1].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, arguments[2].value, Type.TInt)
  }
  return Type.TRange
}

export function checkRangeCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
): Type uses alloc {
  if (kind == "checkRangeUpTo") {
    return checkRangeUpTo(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkRangeStepped") {
    return checkRangeStepped(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkRangeBetween") {
    return checkRangeBetween(mutable checker, walker, pos, arguments, name)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
  return Type.TVoid
}
