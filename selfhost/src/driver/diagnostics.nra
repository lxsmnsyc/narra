  Explanation {
    code: "E0018",
    text: "A test is named with a string literal.\nFix: `test parsesInts { ... }` becomes `test \"parses ints\" { ... }`.",
  },
  Explanation {
    code: "E0019",
    text: "The top level of a file holds only declarations, such as imports, functions, constants, types, traits, implement blocks and tests. A statement such as `let` or a call belongs inside a function.\nFix: move the statement into a function, or declare a `const` instead of a `let`.",
  },
  Explanation {
    code: "E0020",
    text: "Arrays are written `Array<T>`, not `T[]`.\nFix: `xs: int[]` becomes `xs: Array<int>`.",
