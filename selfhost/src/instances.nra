// Generic function instances, ported from funcInstance (check_call.go).
//
// Go clones the declaration for each instance. Here the syntax is shared,
// so an instance is a FuncInstance (check.nra): the generic function, its
// declaring module, the environment of type arguments and the resolved
// signature. Checker.funcInstances finds it by "<func>|<typeKeys>", which
// names the same instances as Go's C-name key. body.nra's checkPending
// checks each one in its own body, in discovery order.
import { Type, typeKeys } from "narrac/types"
import { Checker, ProgramFunc, FuncInstance, reportError, enter } from "narrac/check"
import { resolveSignature, substitute } from "narrac/resolve"
import { envWith, maxDepth } from "narrac/generics"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// The most instances Go makes before it reports a runaway recursion.
const MAX_INSTANCES = 10000

// The deepest type arguments an instance may have. A function that calls itself with a type
// built from its own parameter (grow(Grow { value: v })) gets a deeper type each time, and
// the instance limit is reached only after minutes.
const MAX_TYPE_DEPTH = 64

export function addFuncInstance(
  mutable checker: Checker,
  funcIndex: int,
  typeArguments: Array<Type>,
): int uses alloc {
  const key = `${Int.toString(funcIndex)}|${typeKeys(typeArguments)}`
  if (checker.funcInstances[key] is Some(found)) {
    return found
  }

  // Resolve the signature in the declaring module with the type arguments.
  const info = copy(checker.functions[funcIndex])
  const savedScope = enter(mutable checker, info.scope)
  let environment = copy(envWith(checker, info.typeParameters, typeArguments))
  // A member of an implement block on a generic type also sees Self.
  if (info.selfType is Some(openSelf)) {
    let bindings: Map<int, Type> = Map {}
    for (const i of Ranges.between(0, Arrays.length(info.typeParameters))) {
      bindings[info.typeParameters[i]] = typeArguments[i]
    }
    environment["Self"] = substitute(mutable checker, openSelf, bindings)
  }
  const savedEnv = checker.environment
  checker.environment = copy(environment)
  const signature = resolveSignature(mutable checker, info.declaration, funcIndex, false)
  const result = signature.result
  checker.environment = copy(savedEnv)

  // Record it and queue its body; past the limit it is not checked, as in Go.
  const index = Arrays.length(checker.instanceList)
  Arrays.push(mutable checker.instanceList, FuncInstance {
    funcIndex: funcIndex,
    scope: info.scope,
    environment: copy(environment),
    typeArguments: copy(typeArguments),
    parameters: copy(signature.parameters),
    result: result,
  })
  checker.funcInstances[key] = index
  if (
    Arrays.length(checker.instanceList) > MAX_INSTANCES ||
      maxDepth(checker, typeArguments) > MAX_TYPE_DEPTH
  ) {
    reportError(
      mutable checker,
      info.declaration.pos,
      "E0310",
      `too many instances of generic functions; ${info.declaration.name} may recurse with ever larger types`,
    )
  } else {
    Arrays.push(mutable checker.pending, index)
    Arrays.push(mutable checker.programFunctions, ProgramFunc.InstanceFunc(index))
  }
  enter(mutable checker, savedScope)
  return index
}
