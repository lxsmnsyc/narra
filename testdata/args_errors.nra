// std/args: every ArgsError case and its message from Args.formatError.
import * as Args from "std/args"
import { Command, Flag, Rest } from "std/args"

const TOOL = Command {
  name: "narrac",
  commands: [
    Command {
      name: "build",
      flags: [
        Flag { name: "release" },
        Flag { name: "output", short: "o", value: "path" },
        Flag { name: "quiet", short: "q" },
      ],
      positionals: ["file"],
    },
    Command { name: "format", rest: Rest.Positionals },
  ],
}

function check(command: Command, arguments: Array<string>) uses io, alloc {
  const parsed = Args.parse(command, arguments)
  if (parsed is Err(error)) {
    print(Show.show(error))
    print(`  ${Args.formatError(error)}`)
    return
  }
  print("ok")
}

export function run(_args: Array<string>): int uses io, alloc {
  // Unknown flags, with and without a close name.
  check(TOOL, ["narrac", "build", "--relase", "main.nra"])
  check(TOOL, ["narrac", "build", "--hlep"])
  check(TOOL, ["narrac", "build", "--color", "main.nra"])
  check(TOOL, ["narrac", "build", "-z", "main.nra"])
  check(TOOL, ["narrac", "build", "-qz", "main.nra"])
  // Values.
  check(TOOL, ["narrac", "build", "main.nra", "--output"])
  check(TOOL, ["narrac", "build", "main.nra", "-o"])
  check(TOOL, ["narrac", "build", "--release=yes", "main.nra"])
  check(TOOL, ["narrac", "build", "--help=yes"])
  check(TOOL, ["narrac", "build", "-q", "--quiet", "main.nra"])
  // Hints compare names without dashes and skip names under three bytes. An
  // empty long name is shown as typed.
  check(TOOL, ["narrac", "build", "--rel", "main.nra"])
  check(TOOL, ["narrac", "build", "--qu", "main.nra"])
  check(TOOL, ["narrac", "build", "--=v", "main.nra"])
  // Commands.
  check(TOOL, ["narrac", "bulid", "main.nra"])
  check(TOOL, ["narrac", "test"])
  check(TOOL, ["narrac"])
  // Positionals.
  check(TOOL, ["narrac", "build"])
  check(TOOL, ["narrac", "build", "a.nra", "b.nra"])
  // Help.
  check(TOOL, ["narrac", "-h"])
  check(TOOL, ["narrac", "build", "--help", "--relase"])
  // Spec mistakes, found on every parse.
  check(
    Command {
      name: "tool",
      flags: [Flag { name: "out" }, Flag { name: "out" }],
    },
    ["tool"],
  )
  check(Command { name: "tool", flags: [Flag { name: "out", short: "ou" }] }, ["tool"])
  check(
    Command {
      name: "tool",
      flags: [Flag { name: "out", short: "o" }, Flag { name: "only", short: "o" }],
    },
    ["tool"],
  )
  check(
    Command {
      name: "tool",
      commands: [Command { name: "a" }, Command { name: "a" }],
    },
    ["tool", "a"],
  )
  check(
    Command {
      name: "tool",
      commands: [Command { name: "a", flags: [Flag { name: "x", short: "xy" }] }],
    },
    ["tool", "a"],
  )
  // A subcommand flag may not reuse the long name of an enclosing command's flag.
  check(
    Command {
      name: "tool",
      flags: [Flag { name: "verbose", short: "v" }],
      commands: [
        Command {
          name: "build",
          flags: [Flag { name: "verbose", short: "V" }],
          positionals: ["file"],
        },
      ],
    },
    ["tool", "-v", "build", "-V", "f"],
  )
  return 0
}
