// error: moveDown(mutable node) may change node.pos, which start still uses at line 21
struct Pos {
  line: int
  column: int
}

struct Node {
  name: string
  pos: Pos
}

function moveDown(mutable node: Node) {
  node.pos.line += 1
}

export function run(_args: Array<string>): int {
  let node = Node { name: "a", pos: Pos { line: 1, column: 2 } }
  const start = node.pos
  // `mutable node` may change node and everything inside it.
  moveDown(mutable node)
  return start.line + node.pos.line
}
