// std/coroutine: Co.resume runs a generator to its next yield, and Co.send runs
// a coroutine to its next yield with an input.
//
// The compiler turns `Co.resume(mutable g)` into resumeGenerator and
// `Co.send(mutable g, input)` into resumeCoroutine.

import * as Internal from "std/internal/coroutine"

// The outcome of one resume: the value of the next `yield`, the end of the body, or a panic in the
// body, which is caught only when the program runs as tests.
export enum Step<Out> derives Show, Equatable {
  Yielded(value: Out)
  Done
  Panicked(message: string)
}

// Runs the generator to its next `yield`, as `Co.resume(mutable generator)` does, and gives
// `Step.Done` for every resume after the body ends.
export function resumeGenerator<T, effect E>(
  mutable g: Generator<T> uses E,
): Step<T> uses E, alloc {
  return readStep(Internal.next(mutable g))
}

// Runs the coroutine to its next `yield`, as `Co.send(mutable coroutine, input)` does, with input as
// the value of the `yield` it stopped at. The first send only starts the body, so its input is unused.
export function resumeCoroutine<In, Out, effect E>(
  mutable g: Coroutine<In, Out> uses E,
  input: In,
): Step<Out> uses E, alloc {
  return readStep(Internal.resume(mutable g, input))
}

// readStep reads the outcome of one resume: a value, the end, or a panic.
function readStep<T>(next: Option<T>): Step<T> from next uses alloc {
  if (next is Some(value)) {
    return Step.Yielded(value)
  }
  if (Internal.panicked()) {
    return Step.Panicked(Internal.panicMessage())
  }
  return Step.Done
}
