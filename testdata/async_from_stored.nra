// A known gap (D109 item 9): from is not followed through a stored handle, so
// a write to what await h gave is not E0978, and the debug copy check reports
// the hidden copy.
import * as Arrays from "std/array"
import * as Int from "std/int"

async function keep(items: Array<int>): Array<int> from items {
  return items
}

export async function run(_args: Array<string>): int {
  const items = [1, 2]
  const handle = keep(items)
  let got = await handle
  Arrays.push(mutable got, 3)
  print(`${Int.toString(Arrays.length(items))} ${Int.toString(Arrays.length(got))}`)
  return 0
}
