// error: value 2 of the tagged template is string, but the tag takes values of type int; convert it inside the ${}
import * as Arrays from "std/array"

function count<T>(_parts: Array<string>, values: Array<T>): int {
  return Arrays.length(values)
}

export function run(_args: Array<string>): int {
  return count`${1} and ${"two"}`
}
