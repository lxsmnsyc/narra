import * as I32 from "std/i32"
import { describe } from "wrapper/wrapper"
import { readDepth } from "wrapper/sub/depth"
import { readLimit, systemMatches } from "tables/tables"

export function run(_args: Array<string>): int uses alloc {
  print(describe(7, 3))
  print(`depth ${I32.toString(readDepth())}`)
  print(`limit ${I32.toString(readLimit())}`)
  if (systemMatches()) {
    print("system matches")
  } else {
    print("system differs")
  }
  return 0
}
