// A `for (mutable ...)` loop makes its source unique before the first
// iteration (D85 rule 5): an array shared with another holder is copied once,
// and the other holder keeps the old elements.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

struct Counter {
  label: string
  count: int
  history: Array<int>
}

struct Board {
  counters: Array<Counter>
}

function describe(counters: Array<Counter>): string {
  let text = ""
  for (const counter of counters) {
    text = `${text}${counter.label}=${Int.toString(counter.count)}/${Int.toString(Arrays.length(counter.history))} `
  }
  return text
}

export function run(args: Array<string>): int {
  // A local shared with a second local.
  const counters = [
    Counter { label: "a", count: 1, history: [] },
    Counter { label: "b", count: 2, history: [] },
  ]
  const saved = counters
  for (mutable counter of counters) {
    const count = counter.count
    Arrays.push(mutable counter.history, count)
    counter.count = count + 10
  }
  print(describe(counters))
  print(describe(saved))

  // A field shared with a local, and an element shared with another array.
  const board = Board { counters: saved }
  const boards = [board, board]
  for (const #[index, mutable counter] of Arrays.entries(boards[1].counters)) {
    counter.count = index
  }
  print(describe(boards[0].counters))
  print(describe(boards[1].counters))
  print(describe(board.counters))

  // An array that is not shared is changed where it is, every time.
  for (const _ of Ranges.upTo(3)) {
    for (mutable counter of counters) {
      counter.count = counter.count + 1
    }
  }
  print(describe(counters))
  return 0
}
