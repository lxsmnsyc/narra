// narrac <file>: prints the tokens of a file, one per line, in the format of
// `narra lex`.
// narrac parse <file>: prints the syntax tree in the format of `narra parse`.
// narrac pkg --ids <path>: checks the node id ranges of the files and the ids
// of every node (idcheck.nra), and prints `ids ok <nextId>`.
// narrac pkg --ids-dup <path>: the same, after copying the first node id of
// the first module over the second, so the walker must fail (a test of the
// check itself).
// narrac pkg <path>: prints the loaded package in the format of `narra pkg`.
// narrac decls <path>: runs the declaration passes of the checker and prints
// the format of `narra decls`.
// narrac builtins: prints the std registry in the `builtin` format of
// decldump.go (BuiltinDump), after a line per registry type text that does
// not resolve back to itself.
// An error prints `error <line>:<col>: <message>` to stderr and exits 1.
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Lexer from "narrac/lexer"
import * as Parser from "narrac/parser"
import * as AstDump from "narrac/astdump"
import * as Modules from "narrac/modules"
import { Package } from "narrac/modules"
import * as Check from "narrac/check"
import * as Declare from "narrac/declare"
import * as DeclsDump from "narrac/declsdump"
import * as IdCheck from "narrac/idcheck"
import * as Builtins from "narrac/builtins"
import * as Stdlib from "narrac/stdlib"
import * as Arrays from "std/array"

export function run(args: Array<string>): int uses io, alloc {
  if (Arrays.length(args) == 3 && args[1] == "parse") {
    return parseFile(args[2])
  }
  if (Arrays.length(args) == 3 && args[1] == "pkg") {
    return pkgDump(args[2])
  }
  if (Arrays.length(args) == 3 && args[1] == "decls") {
    return declsDump(args[2])
  }
  if (Arrays.length(args) == 2 && args[1] == "builtins") {
    return builtinsDump()
  }
  if (Arrays.length(args) == 4 && args[1] == "pkg" && args[2] == "--ids") {
    return pkgIds(args[3], false)
  }
  if (Arrays.length(args) == 4 && args[1] == "pkg" && args[2] == "--ids-dup") {
    return pkgIds(args[3], true)
  }
  if (Arrays.length(args) != 2) {
    printError("usage: narrac file.nra | narrac parse file.nra | narrac pkg path | narrac decls path | narrac builtins")
    return 2
  }
  return lexFile(args[1])
}

// printError writes a line to stderr. There is no eprint yet.
function printError(text: string) {
  const _ = Fs.writeText("/dev/stderr", `${text}\n`)
}

function lexFile(path: string): int {
  const read = Fs.readText(path)
  if (read is Err(e)) {
    printError(e)
    return 1
  }
  const tokens = Lexer.lex(read.value)
  if (tokens is Err(e)) {
    printError(`error ${e}`)
    return 1
  }
  for (const t of Arrays.values(tokens.value)) {
    print(`${Int.toString(t.line)}:${Int.toString(t.col)} ${Lexer.kindName(t.kind)} ${Lexer.escapeText(t.text)}`)
  }
  return 0
}

function parseFile(path: string): int {
  const read = Fs.readText(path)
  if (read is Err(e)) {
    printError(e)
    return 1
  }
  const parsed = Parser.parse(read.value, 0)
  if (parsed is Err(d)) {
    printError(`error ${Parser.diagText(d)}`)
    return 1
  }
  return writeStdout(AstDump.dump(parsed.value.file))
}

// writeStdout writes text as is (print would add a newline). A failed write
// is exit code 1.
function writeStdout(text: string): int uses io {
  const written = Fs.writeText("/dev/stdout", text)
  if (written is Err(e)) {
    printError(e)
    return 1
  }
  return 0
}

// pkgDump loads a package directory or a single file and prints the dump. The
// errors go to stderr, one `error ...` line per diagnostic.
function pkgDump(path: string): int uses io, alloc {
  const loaded = Modules.load(path)
  if (loaded is Err(errs)) {
    const _ = Fs.writeText("/dev/stderr", Modules.errorText(errs))
    return 1
  }
  return writeStdout(Modules.dump(loaded.value))
}

// pkgIds loads a package and checks its node id sequence (modules.checkIds)
// and the ids of every node of every module (idcheck.nra). With corrupt, the
// first module's second id is replaced by its first before the check.
function pkgIds(path: string, corrupt: bool): int uses io, alloc {
  const loaded = Modules.load(path)
  if (loaded is Err(errs)) {
    const _ = Fs.writeText("/dev/stderr", Modules.errorText(errs))
    return 1
  }
  const checked = Modules.checkIds(loaded.value)
  if (checked is Err(e)) {
    printError(e)
    return 1
  }
  let first = corrupt
  for (const m of Arrays.values(loaded.value.modules)) {
    let ids = IdCheck.collectIds(m.ast)
    if (first && Arrays.length(ids) >= 2) {
      ids[1] = ids[0]
      first = false
    }
    const nodes = IdCheck.checkIdList(ids, m.firstId, m.endId)
    if (nodes is Err(e)) {
      printError(`${m.path}: ${e}`)
      return 1
    }
  }
  return writeStdout(`${checked.value}\n`)
}

// declsDump loads a package, runs the declaration passes and prints the
// dump. Load and check errors go to stderr, one `error ...` line each.
function declsDump(path: string): int uses io, alloc {
  const loaded = Modules.load(path)
  if (loaded is Err(errs)) {
    const _ = Fs.writeText("/dev/stderr", Modules.errorText(errs))
    return 1
  }
  let c = Declare.declarePackage(loaded.value)
  if (Arrays.length(c.errs) > 0) {
    const _ = Fs.writeText("/dev/stderr", Check.errorText(c.errs))
    return 1
  }
  return writeStdout(DeclsDump.dump(mutable c))
}

// builtinsDump prints the std registry. The type texts are resolved in a
// checker that has declared only the prelude.
function builtinsDump(): int uses io, alloc {
  const empty = Package { name: "builtins", dir: "", modules: [], binaries: [], libraries: [], search: [], nextId: 0, single: true }
  let c = Declare.newPackageChecker(empty)
  let sb = Str.builder()
  for (const line of Arrays.values(Stdlib.typeProblems(mutable c))) {
    Str.append(mutable sb, `${line}\n`)
  }
  Str.append(mutable sb, Builtins.dump(c.registry))
  return writeStdout(Str.build(sb))
}
