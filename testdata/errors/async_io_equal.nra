// error: Listener does not implement Equatable
// A Listener or a Connection is a handle with no ==, like Async<T>.
import * as Net from "std/async/net"

export function run(_args: Array<string>): int {
  const first = Net.listen("127.0.0.1", 0)
  const second = Net.listen("127.0.0.1", 0)
  if (first is Ok(one)) {
    if (second is Ok(two)) {
      if (one == two) {
        return 1
      }
    }
  }
  return 0
}
