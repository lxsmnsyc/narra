// error: value 1 of the tagged template is int, but the tag takes values of type string; convert it inside the ${}
import * as Str from "std/string"

function tag(parts: Array<string>, values: Array<string>): string {
  return Str.join(parts, Str.join(values, ""))
}

export function run(_args: Array<string>): int {
  print(tag`a${1}b`)
  return 0
}
