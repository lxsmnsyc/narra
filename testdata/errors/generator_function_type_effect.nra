// error: generator_function_type_effect.nra:10:48: expected Generator<int>, found Generator<int> uses io
import * as Int from "std/int"

function* noisy(limit: int): Generator<int> {
  print("start")
  yield limit
}

export function run(args: Array<string>): int {
  const make: (limit: int) => Generator<int> = noisy
  for (const value of make(2)) {
    print(Int.toString(value))
  }
  return 0
}
