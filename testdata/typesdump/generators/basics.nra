import * as Fs from "std/fs"
import * as Str from "std/string"
import * as Options from "std/option"
import * as Ranges from "std/range"

// A private generator that reads a file: its type gets io and alloc.
function* lines(path: string): Generator<string> {
  const text = Fs.readText(path)
  if (text is Ok(content)) {
    for (const line of Options.withDefault(Str.split(content, "\n"), [content])) {
      yield line
    }
  }
}

export function* counter(limit: int): Generator<int> {
  for (const i of Ranges.upTo(limit)) {
    yield i
  }
  return
}

export function* both(limit: int): Generator<int> uses alloc {
  yield* counter(limit)
  yield 0
}

function* repeat<T>(value: T, times: int): Generator<T> {
  for (const _i of Ranges.upTo(times)) {
    yield value
  }
}

export function sum<effect E>(numbers: Generator<int> uses E): int uses E {
  let total = 0
  for (const n of numbers) {
    total = total + n
  }
  return total
}

export function* sizes(path: string): Generator<int> uses (io, alloc) {
  for (const line of lines(path)) {
    yield Str.length(line)
  }
}

// Iterating the io generator charges io where it runs.
function printLines(path: string) {
  const all = lines(path)
  for (const line of all) {
    print(line)
  }
}

export function pureSum(): int uses alloc {
  return sum(counter(3)) + sum(repeat(2, 3))
}

export function fileSum(path: string): int uses io, alloc {
  return sum(sizes(path))
}

export function run(args: Array<string>): int {
  printLines("a.txt")
  return pureSum() + fileSum("a.txt")
}
