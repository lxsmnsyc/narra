import * as Arrays from "std/array"

function total(base: int, items: Array<int> = [1, 2, 3]): int {
  let sum = base
  for (const item of Arrays.values(items)) {
    sum = sum + item
  }
  return sum
}

export function summed(base: int): int {
  return total(base)
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Show.show(summed(1)))
  return 0
}
