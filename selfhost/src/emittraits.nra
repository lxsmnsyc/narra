// Trait functions the compiler writes (eq, hash, cmp, show), trait calls and
// equality (emit_traits.go). Stub from selfhost-emit-core; the owner is
// selfhost-emit-traits.
import { Expr } from "narrac/ast"
import { Type } from "narrac/types"
import { Emitter, Code, EmitWalker, reportUnsupported, hasWork } from "narrac/emitstate"

const NODE = "selfhost-emit-traits"

// emitTraitFunctions writes the trait functions registered by useEq, useHash,
// useCmp and useShow.
export function emitTraitFunctions(mutable emitter: Emitter): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `${reportUnsupported(mutable emitter, "trait functions", NODE)}\n`
  }
  return ""
}

// useEq, useHash, useCmp and useShow register the need for the function of a
// type and return its C name.
export function useEq(mutable emitter: Emitter, type: Type): string uses alloc {
  return reportUnsupported(mutable emitter, "equality function", NODE)
}

export function useHash(mutable emitter: Emitter, type: Type): string uses alloc {
  return reportUnsupported(mutable emitter, "hash function", NODE)
}

export function useCmp(mutable emitter: Emitter, type: Type): string uses alloc {
  return reportUnsupported(mutable emitter, "compare function", NODE)
}

export function useShow(mutable emitter: Emitter, type: Type): string uses alloc {
  return reportUnsupported(mutable emitter, "show function", NODE)
}

// emitEquality is == and != on a struct, enum or array.
export function emitEquality<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "equality", NODE), owned: false }
}

// emitTraitCall is a call of a trait function the compiler implements.
export function emitTraitCall<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "trait call", NODE), owned: false }
}
