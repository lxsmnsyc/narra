// A plain entry starts and detaches tasks. When it returns, the tasks still
// running are cancelled: the idle they wait in finishes at once, and they run
// to their end before the program exits.
import * as Async from "std/async"

async function background(name: string): int uses io {
  print(`${name} starts`)
  await Async.idle()
  print(`${name} ends`)
  return 0
}

export function run(_args: Array<string>): int {
  Async.detach(background("first"))
  Async.detach(background("second"))
  print("entry returns")
  return 0
}
