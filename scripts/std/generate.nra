const LOWER_LETTERS = "abcdefghijklmnopqrstuvwxyz"

const INDEX_INTRODUCTION = "# Standard library\n\nEvery public module of the standard library. A module page lists its types, functions and constants with their signatures and effects, and links to the guide chapter that teaches the module.\n\nThese pages are generated by `scripts/std/generate.nra` from `narrac query --json interface`. Do not edit them.\n\n## Modules\n\n"

function sliceText(text: string, start: int, end: int): string uses alloc {
  const sliced = Str.slice(text, start, end)
  if (sliced is Some(part)) {
    return part
  }
  return ""
}

function containsText(items: Array<string>, wanted: string): bool {
  for (const item of Arrays.values(items)) {
    if (item == wanted) {
      return true
    }
  }
  return false
}

function isIdentifierByte(byte: int): bool {
  return ((byte >= 48 && byte <= 57) ||
    (byte >= 65 && byte <= 90) ||
    (byte >= 97 && byte <= 122) ||
    byte == 95)
}

function makeSlug(heading: string): string uses alloc {
  const builder = Str.builder()
  for (const index of Ranges.upTo(Str.length(heading))) {
    const byte = Str.byteAt(heading, index)
    if (byte >= 65 && byte <= 90) {
      Str.append(mutable builder, sliceText(LOWER_LETTERS, byte - 65, byte - 64))
    } else if (byte == 32) {
      Str.append(mutable builder, "-")
    } else if (isIdentifierByte(byte) || byte == 45) {
      Str.append(mutable builder, sliceText(heading, index, index + 1))
    }
  }
  return Str.build(builder)
}

function escapeText(text: string): string uses alloc {
  const builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    if (
      character == '\\' ||
        character == '`' ||
        character == '<' ||
        character == '>' ||
        character == '&' ||
        character == '|' ||
        character == '*' ||
        character == '_' ||
        character == '[' ||
        character == ']'
    ) {
      Str.appendChar(mutable builder, '\\')
    }
    Str.appendChar(mutable builder, character)
  }
  return Str.build(builder)
}

function escapeProse(text: string): string uses alloc {
  // Code spans in backticks stay as written; the rest is escaped as escapeText does.
  const builder = Str.builder()
  let insideCode = false
  for (const character of Arrays.values(Str.chars(text))) {
    if (character == '`') {
      insideCode = !insideCode
    } else if (
      !insideCode &&
        (character == '\\' ||
          character == '<' ||
          character == '>' ||
          character == '&' ||
          character == '|' ||
          character == '*' ||
          character == '_' ||
          character == '[' ||
          character == ']')
    ) {
      Str.appendChar(mutable builder, '\\')
    }
    Str.appendChar(mutable builder, character)
  }
  return Str.build(builder)
}

function renderDoc(doc: string): string uses alloc {
  if (doc == "") {
    return ""
  }
  return `\n${escapeProse(doc)}\n`
}

function changeDepth(text: string, index: int, depth: int): int {
  const byte = Str.byteAt(text, index)
  if (byte == 40 || byte == 91 || byte == 123 || byte == 60) {
    return depth + 1
  }
  if (byte == 41 || byte == 93 || byte == 125) {
    return depth - 1
  }
  if (byte == 62 && !(index > 0 && Str.byteAt(text, index - 1) == 61)) {
    return depth - 1
  }
  return depth
}

function splitNote(signature: string): Array<string> uses alloc {
  const found = Str.indexOf(signature, " // ")
  if (found is Some(position)) {
    return [sliceText(signature, 0, position), Str.sliceFrom(signature, position + 4)]
  }
  return [signature, ""]
}

function findEffects(signature: string): Array<string> uses alloc {
  let depth = 0
  let start = -1
  for (const index of Ranges.upTo(Str.length(signature))) {
    if (depth == 0 && Str.byteAt(signature, index) == 32) {
      if (sliceText(signature, index, index + 6) == " uses ") {
        start = index + 6
      }
    }
    depth = changeDepth(signature, index, depth)
  }
  if (start < 0) {
    return []
  }
  let list = Str.trim(Str.sliceFrom(signature, start))
  if (Str.startsWith(list, "(") && Str.endsWith(list, ")")) {
    list = sliceText(list, 1, Str.length(list) - 1)
  }
  let effects: Array<string> = []
  const parts = Str.split(list, ",")
  if (parts is Some(names)) {
    for (const name of Arrays.values(names)) {
      Arrays.push(mutable effects, Str.trim(name))
    }
  }
  return effects
}

function layOutBody(signature: string): string uses alloc {
  const opening = Str.indexOf(signature, " { ")
  if (opening is None) {
    return signature
  }
  if (!Str.endsWith(signature, "}")) {
    return signature
  }
  const start = opening.value + 3
  const end = Str.length(signature) - 1
  let members: Array<string> = []
  let depth = 0
  let memberStart = start
  for (const index of Ranges.between(start, end)) {
    const byte = Str.byteAt(signature, index)
    if (depth == 0 && (byte == 44 || byte == 59)) {
      Arrays.push(mutable members, Str.trim(sliceText(signature, memberStart, index)))
      memberStart = index + 1
    }
    depth = changeDepth(signature, index, depth)
  }
  const last = Str.trim(sliceText(signature, memberStart, end))
  if (last != "") {
    Arrays.push(mutable members, last)
  }
  if (Arrays.length(members) == 0) {
    return signature
  }
  let text = `${sliceText(signature, 0, opening.value)} {\n`
  for (const member of Arrays.values(members)) {
    text += `  ${member}\n`
  }
  return `${text}}`
}

function mentionsName(text: string, name: string): bool uses alloc {
  const length = Str.length(name)
  for (const index of Ranges.upTo(Str.length(text) - length + 1)) {
    if (sliceText(text, index, index + length) != name) {
      continue
    }
    const before = index == 0 || !isIdentifierByte(Str.byteAt(text, index - 1))
    const after =
      index + length == Str.length(text) || !isIdentifierByte(Str.byteAt(text, index + length))
    if (before && after) {
      return true
    }
  }
  return false
}

function findTypeFunctions(
  declaration: Declaration,
  functions: Array<Declaration>,
): Array<string> uses alloc {
  if (Arrays.length(declaration.functions) > 0) {
    return copy(declaration.functions)
  }
  // A source type has no list; its functions are the ones whose parameters or result name it.
  let names: Array<string> = []
  for (const other of Arrays.values(functions)) {
    const signature = splitNote(other.signature)[0]
    const found = Str.indexOf(signature, "(")
    if (found is Some(position)) {
      if (mentionsName(Str.sliceFrom(signature, position), declaration.name)) {
        Arrays.push(mutable names, other.name)
      }
    }
  }
  return names
}

function isTypeKind(kind: string): bool {
  return kind == "struct" ||
    kind == "enum" ||
    kind == "distinct" ||
    kind == "type" ||
    kind == "trait"
}

struct Anchors {
  counts: Map<string, int>
}

function takeAnchor(mutable anchors: Anchors, heading: string): string uses alloc {
  // A repeated heading gets a number after its anchor, as the site and GitHub give it.
  const base = makeSlug(heading)
  let seen = 0
  if (anchors.counts[base] is Some(count)) {
    seen = count
  }
  anchors.counts[base] = seen + 1
  if (seen == 0) {
    return base
  }
  return `${base}-${Int.toString(seen)}`
}

function findChapter(
  repository: string,
  reference: string,
  modulePath: string,
  depth: int,
): Result<Chapter, string> uses io, alloc {
  // A reference is a chapter name, or a chapter name and `#` and the anchor of the section to link.
  let chapter = reference
  let fixedAnchor = ""
  const hash = Str.indexOf(reference, "#")
  if (hash is Some(position)) {
    chapter = sliceText(reference, 0, position)
    fixedAnchor = Str.sliceFrom(reference, position + 1)
  }
  const file = Path.join(repository, `docs/guide/${chapter}.md`)
  const read = Fs.readText(file)
  if (read is Err(message)) {
    return Err(`cannot read ${file}: ${message}`)
  }
  const lines = Str.split(read.value, "\n")
  if (lines is None) {
    return Err(`${file} is empty`)
  }

  // The title is the first heading, "N. Title"; a section that names the module gets the link.
  let title = ""
  let section = ""
  let foundFixed = false
  let anchors = Anchors { counts: Map {} }
  let insideFence = false
  for (const line of Arrays.values(lines.value)) {
    if (Str.startsWith(line, "```")) {
      insideFence = !insideFence
      continue
    }
    if (insideFence || !Str.startsWith(line, "#")) {
      continue
    }
    const space = Str.indexOf(line, " ")
    if (space is None) {
      continue
    }
    const heading = Str.sliceFrom(line, space.value + 1)
    if (title == "") {
      title = heading
      continue
    }
    const anchor = takeAnchor(mutable anchors, heading)
    if (fixedAnchor != "") {
      if (anchor == fixedAnchor) {
        foundFixed = true
        section = `#${anchor}`
      }
    } else if (section == "" && mentionsModule(heading, modulePath)) {
      section = `#${anchor}`
    }
  }
  if (fixedAnchor != "" && !foundFixed) {
    return Err(`${file} has no section with the anchor ${fixedAnchor}`)
  }
  if (title == "") {
    return Err(`${file} has no title`)
  }
  const dot = Str.indexOf(title, ". ")
  if (dot is Some(position)) {
    title = `chapter ${sliceText(title, 0, position)}, ${Str.sliceFrom(title, position + 2)}`
  }
  const up = Str.repeat("../", depth + 2)
  if (up is None) {
    return Err(`cannot build the link from ${modulePath} to ${file}`)
  }
  return Ok(Chapter { link: `${up.value}guide/${chapter}.md${section}`, title })
}

function mentionsModule(heading: string, modulePath: string): bool uses alloc {
  const found = Str.indexOf(heading, modulePath)
  if (found is Some(position)) {
    const end = position + Str.length(modulePath)
    // std/async must not match the start of a longer path such as std/async/x.
    return end == Str.length(heading) || Str.byteAt(heading, end) != 47
  }
  return false
}

function renderFence(signature: string): string uses alloc {
  return `\`\`\`narra fragment\n${signature}\n\`\`\`\n`
}

function renderNote(label: string, note: string): string uses alloc {
  if (note == "") {
    return ""
  }
  let text = escapeText(note)
  if (!Str.endsWith(text, ".")) {
    text += "."
  }
  return `\n${label}: ${text}\n`
}

function splitClauses(note: string): Array<string> uses alloc {
  if (note == "") {
    return []
  }
  const parts = Str.split(note, "; ")
  if (parts is Some(clauses)) {
    return clauses
  }
  return [note]
}

function findSharedClauses(notes: Array<Array<string>>): Array<string> uses alloc {
  let shared: Array<string> = []
  if (Arrays.length(notes) < 3) {
    return shared
  }
  for (const clause of Arrays.values(notes[0])) {
    let everywhere = true
    for (const other of Arrays.values(notes)) {
      if (!containsText(other, clause)) {
        everywhere = false
      }
    }
    if (everywhere) {
      Arrays.push(mutable shared, clause)
    }
  }
  return shared
}

function listOwnClauses(clauses: Array<string>, shared: Array<string>): string uses alloc {
  let own: Array<string> = []
  for (const clause of Arrays.values(clauses)) {
    if (!containsText(shared, clause)) {
      Arrays.push(mutable own, clause)
    }
  }
  return Str.join(own, "; ")
}

function renderTypeSection(declaration: Declaration): string uses alloc {
  const parts = splitNote(declaration.signature)
  return `\n### ${declaration.name}\n\n${renderFence(layOutBody(parts[0]))}${renderDoc(declaration.doc)}${renderNote("Details", parts[1])}`
}

function renderFunctionLinks(
  names: Array<string>,
  functionAnchors: Map<string, string>,
): string uses alloc {
  let links: Array<string> = []
  for (const name of Arrays.values(names)) {
    if (functionAnchors[name] is Some(anchor)) {
      Arrays.push(mutable links, `[\`${name}\`](#${anchor})`)
    }
  }
  return Str.join(links, ", ")
}

function renderTypeSections(
  types: Array<Declaration>,
  functions: Array<Declaration>,
  functionAnchors: Map<string, string>,
): string uses alloc {
  let linkLists: Array<string> = []
  for (const declaration of Arrays.values(types)) {
    Arrays.push(
      mutable linkLists,
      renderFunctionLinks(findTypeFunctions(declaration, functions), functionAnchors),
    )
  }

  // Types with the same functions are listed one after the other, with one Functions line.
  let text = ""
  let done: Array<bool> = []
  for (const _type of Arrays.values(types)) {
    Arrays.push(mutable done, false)
  }
  for (const first of Ranges.upTo(Arrays.length(types))) {
    if (done[first]) {
      continue
    }
    let group: Array<string> = []
    for (const index of Ranges.between(first, Arrays.length(types))) {
      if (linkLists[index] == linkLists[first]) {
        done[index] = true
        Arrays.push(mutable group, types[index].name)
        text += renderTypeSection(types[index])
      }
    }
    if (linkLists[first] == "") {
      continue
    }
    if (Arrays.length(group) == 1) {
      text += `\nFunctions: ${linkLists[first]}.\n`
    } else {
      let names: Array<string> = []
      for (const name of Arrays.values(group)) {
        Arrays.push(mutable names, `\`${name}\``)
      }
      text += `\nFunctions of ${Str.join(names, ", ")}: ${linkLists[first]}.\n`
    }
  }
  return text
}

function renderEffects(signature: string): string uses alloc {
  const effects = findEffects(signature)
  if (Arrays.length(effects) == 0) {
    return "\nEffects: none.\n"
  }
  let spans: Array<string> = []
  for (const effect of Arrays.values(effects)) {
    Arrays.push(mutable spans, `\`${effect}\``)
  }
  return `\nEffects: ${Str.join(spans, ", ")}.\n`
}

function renderPage(
  info: ModuleInfo,
  moduleInterface: Interface,
  chapter: Option<Chapter>,
): string uses alloc {
  let page = `# ${info.path}\n\n${info.description}\n\n\`\`\`narra fragment\nimport * as ${info.alias} from "${info.path}"\n\`\`\`\n`
  if (chapter is Some(taught)) {
    page += `\nThe guide teaches it in [${taught.title}](${taught.link}).\n`
  }
  page += `\nThis page is generated by \`scripts/std/generate.nra\` from \`narrac query --json interface ${info.path}\`. Do not edit it.\n`

  // Types, constants and functions each get a section, in that order.
  let types: Array<Declaration> = []
  let constants: Array<Declaration> = []
  let functions: Array<Declaration> = []
  for (const declaration of Arrays.values(moduleInterface.declarations)) {
    if (isTypeKind(declaration.kind)) {
      Arrays.push(mutable types, declaration)
    } else if (declaration.kind == "function") {
      Arrays.push(mutable functions, declaration)
    } else {
      Arrays.push(mutable constants, declaration)
    }
  }

  // The type sections link to functions further down, so every anchor is known first.
  let anchors = Anchors { counts: Map {} }
  let functionAnchors: Map<string, string> = Map {}
  if (Arrays.length(types) > 0) {
    takeAnchor(mutable anchors, "Types")
  }
  for (const declaration of Arrays.values(types)) {
    takeAnchor(mutable anchors, declaration.name)
  }
  if (Arrays.length(constants) > 0) {
    takeAnchor(mutable anchors, "Constants")
  }
  for (const declaration of Arrays.values(constants)) {
    takeAnchor(mutable anchors, declaration.name)
  }
  if (Arrays.length(functions) > 0) {
    takeAnchor(mutable anchors, "Functions")
  }
  for (const declaration of Arrays.values(functions)) {
    functionAnchors[declaration.name] = takeAnchor(mutable anchors, declaration.name)
  }

  if (Arrays.length(types) > 0) {
    page += "\n## Types\n"
  }
  page += renderTypeSections(types, functions, functionAnchors)
  if (Arrays.length(constants) > 0) {
    page += "\n## Constants\n"
  }
  for (const declaration of Arrays.values(constants)) {
    const parts = splitNote(declaration.signature)
    page += `\n### ${declaration.name}\n\n${renderFence(parts[0])}${renderDoc(declaration.doc)}${renderNote("Details", parts[1])}`
  }
  if (Arrays.length(functions) > 0) {
    page += "\n## Functions\n"
  }

  // A note clause that every function repeats is printed once, above the list.
  let notes: Array<Array<string>> = []
  for (const declaration of Arrays.values(functions)) {
    Arrays.push(mutable notes, splitClauses(splitNote(declaration.signature)[1]))
  }
  const shared = findSharedClauses(notes)
  if (Arrays.length(shared) > 0) {
    page += renderNote("Details for every function below", Str.join(shared, "; "))
  }
  for (const index of Ranges.upTo(Arrays.length(functions))) {
    const declaration = functions[index]
    const parts = splitNote(declaration.signature)
    page += `\n### ${declaration.name}\n\n${renderFence(parts[0])}${renderDoc(declaration.doc)}${renderEffects(parts[0])}${renderNote("Details", listOwnClauses(notes[index], shared))}`
  }
  return page
}

function runNarrac(
  narrac: string,
  arguments: Array<string>,
): Result<string, string> uses io, alloc {
  const ran = Process.run(narrac, arguments)
  if (ran is Err(message)) {
    return Err(`cannot run ${narrac}: ${message}`)
  }
  const #[code, output, errorOutput] = ran.value
  if (code != 0) {
    return Err(`${narrac} ${Str.join(arguments, " ")} failed: ${errorOutput}`)
  }
  return Ok(output)
}

function listModules(
  narrac: string,
  repository: string,
): Result<Array<string>, string> uses io, alloc {
  let modules: Array<string> = []

  // A builtin module has a line `builtin module="std/NAME" ...` for each of its functions.
  const builtins = runNarrac(narrac, ["builtins"])
  if (builtins is Err(message)) {
    return Err(message)
  }
  const prefix = "builtin module=\""
  const lines = Str.split(builtins.value, "\n")
  if (lines is Some(all)) {
    for (const line of Arrays.values(all)) {
      if (!Str.startsWith(line, `${prefix}std/`)) {
        continue
      }
      const rest = Str.sliceFrom(line, Str.length(prefix))
      const quote = Str.indexOf(rest, "\"")
      if (quote is Some(end)) {
        const modulePath = sliceText(rest, 0, end)
        if (!Str.startsWith(modulePath, "std/internal/") && !containsText(modules, modulePath)) {
          Arrays.push(mutable modules, modulePath)
        }
      }
    }
  }

  // A source module is std/src/NAME.nra, with `__` for each slash of its path.
  const folder = Path.join(repository, "std/src")
  const names = Fs.listDir(folder)
  if (names is Err(message)) {
    return Err(`cannot list ${folder}: ${message}`)
  }
  for (const name of Arrays.values(names.value)) {
    if (
      !Str.endsWith(name, ".nra") ||
        Str.startsWith(name, "ext__") ||
        Str.startsWith(name, "internal__")
    ) {
      continue
    }
    const modulePath = `std/${Str.replace(sliceText(name, 0, Str.length(name) - 4), "__", "/")}`
    if (!containsText(modules, modulePath)) {
      Arrays.push(mutable modules, modulePath)
    }
  }
  return Ok(modules)
}

function findModuleInfo(
  table: Array<ModuleInfo>,
  modulePath: string,
): Option<ModuleInfo> from table {
  for (const info of Arrays.values(table)) {
    if (info.path == modulePath) {
      return Some(info)
    }
  }
  return None
}

function countSlashes(text: string): int {
  let count = 0
  for (const index of Ranges.upTo(Str.length(text))) {
    if (Str.byteAt(text, index) == 47) {
      count += 1
    }
  }
  return count
}

function writePage(path: string, text: string): Result<bool, string> uses io, alloc {
  const created = Fs.createDirAll(Path.dirname(path))
  if (created is Err(message)) {
    return Err(`cannot create ${Path.dirname(path)}: ${message}`)
  }
  const written = Fs.writeText(path, text)
  if (written is Err(message)) {
    return Err(`cannot write ${path}: ${message}`)
  }
  return Ok(true)
}

function removeStalePages(
  folder: string,
  relative: string,
  written: Array<string>,
): Result<bool, string> uses io, alloc {
  const here = Path.join(folder, relative)
  const names = Fs.listDir(here)
  if (names is Err(message)) {
    return Err(`cannot list ${here}: ${message}`)
  }
  for (const name of Arrays.values(names.value)) {
    let path = name
    if (relative != "") {
      path = `${relative}/${name}`
    }
    if (Fs.isDir(Path.join(folder, path))) {
      const removed = removeStalePages(folder, path, written)
      if (removed is Err(message)) {
        return Err(message)
      }
    } else if (Str.endsWith(name, ".md") && !containsText(written, path)) {
      const removed = Fs.removeFile(Path.join(folder, path))
      if (removed is Err(message)) {
        return Err(`cannot remove ${path}: ${message}`)
      }
    }
  }
  return Ok(true)
}

function findStrayDocs(file: string, text: string): Array<string> uses alloc {
  let problems: Array<string> = []
  const split = Str.split(text, "\n")
  if (split is None) {
    return problems
  }
  const lines = split.value
  const count = Arrays.length(lines)
  let index = 0
  while (index < count) {
    if (!Str.startsWith(Str.trim(lines[index]), "///")) {
      index += 1
      continue
    }

    // A run of `///` lines, then any attribute lines, must end at a top-level export.
    const start = index
    while (index < count && Str.startsWith(Str.trim(lines[index]), "///")) {
      index += 1
    }
    let next = index
    while (next < count && Str.startsWith(lines[next], "@")) {
      next += 1
    }
    if (next == count || !Str.startsWith(lines[next], "export ")) {
      Arrays.push(
        mutable problems,
        `${file}:${Int.toString(start + 1)}: a /// doc comment must sit right above an export declaration`,
      )
    }
  }
  return problems
}

function checkDocComments(repository: string): Result<bool, string> uses io, alloc {
  const folder = Path.join(repository, "std/src")
  const names = Fs.listDir(folder)
  if (names is Err(message)) {
    return Err(`cannot list ${folder}: ${message}`)
  }
  let problems: Array<string> = []
  for (const name of Arrays.values(names.value)) {
    if (!Str.endsWith(name, ".nra")) {
      continue
    }
    const read = Fs.readText(Path.join(folder, name))
    if (read is Err(message)) {
      return Err(`cannot read std/src/${name}: ${message}`)
    }
    for (const problem of Arrays.values(findStrayDocs(`std/src/${name}`, read.value))) {
      Arrays.push(mutable problems, problem)
    }
  }
  if (Arrays.length(problems) > 0) {
    return Err(Str.join(problems, "\n"))
  }
  return Ok(true)
}

function generate(
  narrac: string,
  repository: string,
  folder: string,
): Result<bool, string> uses io, alloc {
  // A doc comment that documents nothing would be lost from the pages, so it stops the run.
  const checked = checkDocComments(repository)
  if (checked is Err(message)) {
    return Err(message)
  }

  const modules = listModules(narrac, repository)
  if (modules is Err(message)) {
    return Err(message)
  }

  // Every public module needs a row in the table, and every row a module.
  const table = listModuleInfo()
  for (const modulePath of Arrays.values(modules.value)) {
    if (findModuleInfo(table, modulePath) is None) {
      return Err(`${modulePath} has no row in listModuleInfo`)
    }
  }
  for (const info of Arrays.values(table)) {
    if (!containsText(modules.value, info.path)) {
      return Err(`listModuleInfo has a row for ${info.path}, which is not a public module`)
    }
  }

  let written: Array<string> = []
  let index = INDEX_INTRODUCTION
  for (const info of Arrays.values(table)) {
    const answer = runNarrac(narrac, ["query", "--json", "interface", info.path])
    if (answer is Err(message)) {
      return Err(message)
    }
    const decoded = Json.decode<Interface>(answer.value)
    if (decoded is Err(message)) {
      return Err(`the interface of ${info.path} is not valid: ${message}`)
    }
    const name = Str.sliceFrom(info.path, 4)
    let chapter: Option<Chapter> = None
    if (info.chapter != "") {
      const found = findChapter(repository, info.chapter, info.path, countSlashes(name))
      if (found is Err(message)) {
        return Err(message)
      }
      chapter = Some(found.value)
    }
    const file = `${name}.md`
    const saved = writePage(Path.join(folder, file), renderPage(info, decoded.value, chapter))
    if (saved is Err(message)) {
      return Err(message)
    }
    Arrays.push(mutable written, file)
    index += `- [\`${info.path}\`](${file}): ${info.description}\n`
  }
  const saved = writePage(Path.join(folder, "README.md"), index)
  if (saved is Err(message)) {
    return Err(message)
  }
  Arrays.push(mutable written, "README.md")
  return removeStalePages(folder, "", written)
}

export function run(args: Array<string>): int uses io, alloc {
  if (Arrays.length(args) != 4) {
    Io.writeError("usage: generate <narrac> <repository> <folder>\n")
    return 2
  }
  const generated = generate(args[1], args[2], args[3])
  if (generated is Err(message)) {
    Io.writeError(`generate: ${message}\n`)
    return 1
  }
  return 0
}
