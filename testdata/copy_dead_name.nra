// A write after the other name's last use is accepted by the shared-write rule,
// but the other name still holds the array until its scope ends, so the push
// copies it. The debug copy check reports it (the hidden copy loadFile made
// when it pushed onto the modules of a StdLoad it no longer used).
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Load {
  items: Array<int>
}

function build(): Load uses alloc {
  return Load { items: [1] }
}

export function run(_args: Array<string>): int uses io, alloc {
  const load = build()
  let items = load.items
  Arrays.push(mutable items, 2)
  print(Int.toString(Arrays.length(items)))
  return 0
}
