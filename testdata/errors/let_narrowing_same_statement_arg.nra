// error: let_narrowing_same_statement_arg.nra:17:7: this Option<int> may hold any of its variants; check it with `is` or `match` before reading "value"
function clear(change: () => void): int {
  change()
  return 0
}

function add(a: int, b: int): int {
  return a + b
}

export function run(args: Array<string>): int {
  let x: Option<int> = Some(1)
  if (x is None) {
    return 0
  }
  return add(
    x.value,
    clear(() => {
      x = None
    }),
  )
}
