// Constant type parameters: `const N: int` on functions and structs.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Vector<const N: int> {
  values: Array<f64>
}

struct Tagged<T, const N: int> {
  value: T
}

function repeat<const N: int>(text: string): string uses alloc {
  let out = ""
  for (let i = 0; i < N; i++) {
    out = `${out}${text}`
  }
  return out
}

function dimension<const N: int>(_vector: Vector<N>): int {
  return N
}

function zeros<const N: int>(): Vector<N> uses alloc {
  let values: Array<f64> = []
  for (let i = 0; i < N; i++) {
    Arrays.push(mutable values, 0.0)
  }
  return Vector { values: values }
}

function share<const N: int>(total: int): int {
  // N is a known constant in each instance, so the divisor needs no check.
  return total / N
}

function shift<const N: int>(value: int): int {
  return value << N
}

function tag<T, const N: int>(value: T): Tagged<T, N> from value {
  return Tagged { value: value }
}

function tagNumber<T, const N: int>(_tagged: Tagged<T, N>): int {
  return N
}

function nested<const N: int>(text: string): string uses alloc {
  // A constant parameter passes on as a type argument.
  return repeat<N>(text)
}

function negative<const N: int>(): int {
  return N
}

function label(vector: Vector<2>): string uses alloc {
  return `${Int.toString(Arrays.length(vector.values))} values`
}

export function run(_args: Array<string>): int {
  print(repeat<3>("ab"))
  print(repeat<1>("cd"))
  print(nested<2>("ef"))

  // Inference from the expected type.
  const plane: Vector<2> = zeros()
  const space: Vector<3> = zeros()
  print(Int.toString(dimension(plane)))
  print(Int.toString(dimension(space)))
  print(label(plane))

  // A struct literal with written arguments.
  const line = Vector<1> { values: [1.5] }
  print(Int.toString(dimension(line)))

  print(Int.toString(share<4>(20)))
  print(Int.toString(share<5>(20)))
  print(Int.toString(shift<2>(1)))
  print(Int.toString(negative<-7>()))

  const tagged: Tagged<string, 9> = tag("x")
  print(Int.toString(tagNumber(tagged)))
  print(tagged.value)
  return 0
}
