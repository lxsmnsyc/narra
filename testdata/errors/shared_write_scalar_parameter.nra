// error: moved.line += ... may change moved, which pos still holds for the caller
struct Pos {
  line: int
  column: int
}

function nextLine(pos: Pos): int {
  let moved = pos
  // The caller still holds pos.
  moved.line += 1
  return moved.line
}

export function run(_args: Array<string>): int {
  return nextLine(Pos { line: 1, column: 2 })
}
