import * as Geo from "p/geo"
import { Shape, Meters, same } from "p/geo"

function local(): int {
  return Geo.same(2)
}

export function run(args: Array<string>): int {
  const circle = Geo.Shape.Circle(1)
  const _dot = Geo.Shape.Dot
  const _bare = Shape.Dot
  const _wrapped = Geo.Wrapped.One("x")
  const length = Geo.meters(4)
  const plain = Meters.toInt(length)
  const _word = same("w")
  return Geo.area(circle) + Geo.same(1) + local() + plain
}
