struct Point {
  x: int
  y: int
}

struct Pair<A, B> {
  first: A
  second: B
}

function maps(): int {
  const _counts = Map { "a": 1, "b": 2 }
  const _typed = Map<string, int> { "c": 3 }
  const _wanted: Map<int, bool> = Map { 1: true }
  const _empty: Map<string, int> = Map {}
  let table: Map<string, int> = Map<string, int> {}
  table["k"] = 4
  const _found = table["k"]
  return 0
}

function tuples(point: Point): int {
  const pair = #[1, "one"]
  const _typed: #[int, f64] = #[1, 2.5]
  const _triple = #[point, pair, true]
  return 0
}

function spreads(point: Point, pair: Pair<int, string>): int {
  const moved = Point { ...point, x: 5 }
  const shifted = { ...point, y: 6 }
  const named: Point = { ...point }
  const _generic = Pair { ...pair, second: "two" }
  const _written = Pair<int, string> { ...pair, first: 1 }
  return moved.x + shifted.y + named.x
}
