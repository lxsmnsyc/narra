import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"

struct Point {
  x: int
  y: int
}

enum Shape {
  Dot
  Line(length: int)
}

function countWords(words: Array<string>): Map<string, int> {
  let counts: Map<string, int> = Map {}
  for (const w of Arrays.values(words)) {
    const current = counts[w]
    if (current is Some(n)) {
      counts[w] = n + 1
    } else {
      counts[w] = 1
    }
  }
  return counts
}

function show(m: Map<string, int>) {
  for (const k of Maps.keys(m)) {
    const v = m[k]
    if (v is Some(n)) {
      print(`${k} = ${Int.toString(n)}`)
    }
  }
}

function clear(mutable m: Map<string, int>, key: string) {
  Maps.remove(mutable m, key)
}

export function run(args: Array<string>): int {
  const words = ["the", "cat", "and", "the", "dog", "and", "the", "bird"]
  const counts = countWords(words)
  show(counts)
  print(Int.toString(Maps.size(counts)))

  // literals, with literal and bracket keys
  const prefix = "k"
  const lit = Map { "a": 1, [prefix]: 2, "b": 3 }
  for (const entry of Maps.entries(lit)) {
    const #[key, value] = entry
    print(`${key}:${Int.toString(value)}`)
  }

  // copy on write
  let a: Map<string, int> = Map { "x": 1 }
  const b = a
  a["x"] = 10
  a["y"] = 20
  print(`${Int.toString(Maps.size(a))} ${Int.toString(Maps.size(b))}`)
  if (b["x"] is Some(v)) {
    print(Int.toString(v))
  }

  // removing and inserting again moves a key to the end
  let order: Map<string, int> = Map { "one": 1, "two": 2, "three": 3 }
  clear(mutable order, "one")
  print(Int.toString(Maps.size(order)))
  order["one"] = 11
  const keys = Maps.keys(order)
  for (const k of Arrays.values(keys)) {
    print(k)
  }
  const removed = Maps.remove(mutable order, "nope")
  assert(!removed)
  assert(order["nope"] is None)

  // struct keys, enum values with fields
  let grid: Map<Point, Shape> = Map {}
  grid[Point { x: 1, y: 2 }] = Shape.Line(5)
  grid[Point { x: 0, y: 0 }] = Shape.Dot
  grid[Point { x: 1, y: 2 }] = Shape.Line(7)
  print(Int.toString(Maps.size(grid)))
  if (grid[Point { x: 1, y: 2 }] is Some(s)) {
    if (s is Shape.Line(n)) {
      print(`line ${Int.toString(n)}`)
    }
  }

  // growth, removal and compaction
  let big: Map<int, string> = Map {}
  for (const i of Ranges.upTo(1000)) {
    big[i] = Int.toString(i * 2)
  }
  for (const i of Ranges.upTo(900)) {
    Maps.remove(mutable big, i)
  }
  for (const i of Ranges.upTo(2000)) {
    big[i + 5000] = "x"
  }
  print(Int.toString(Maps.size(big)))
  if (big[950] is Some(t)) {
    print(t)
  }
  let first = 0
  for (const k of Maps.keys(big)) {
    first = k
    break
  }
  print(Int.toString(first))

  // a write to the variable inside the loop does not change the loop
  let loop: Map<int, int> = Map { 1: 1, 2: 2, 3: 3 }
  for (const k of Maps.keys(loop)) {
    loop[k + 10] = k
  }
  print(Int.toString(Maps.size(loop)))

  // arrays as values
  let nested: Map<string, Array<int>> = Map {}
  nested["a"] = [1, 2, 3]
  if (nested["a"] is Some(arr)) {
    print(Int.toString(Arrays.length(arr)))
  }
  return 0
}
