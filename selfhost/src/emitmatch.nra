// Patterns: is, match, destructuring, tuples and spread literals
// (emit_match.go, emit_patterns.go). The owner is selfhost-emit-match.
//
// Patterns read from a subject held in a C variable for the whole match or
// if statement. A test is a chain of conditions on C paths into the subject,
// joined with &&, so a field of a union member is read only after its tag is
// checked. A binding copies the value at its path and retains it, so the
// local owns one reference and is released with its scope.
import * as Int from "std/int"
import * as Str from "std/string"
import { Expr, Stmt, Block, Pattern, FieldPattern, MatchArm } from "narrac/ast"
import { Type } from "narrac/types"
import { Ref, getExpressionId, findBodySlot } from "narrac/check"
import { getPatternId } from "narrac/patterns"
import { cType } from "narrac/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  TempVar,
  BlockInfo,
  withoutLastBlock,
  unwindAll,
  reportUnsupported,
  writeLine,
  temp,
  ownedTemp,
  consume,
  beginStatement,
  endStatement,
  pushScope,
  popScope,
  addLocal,
  needsRc,
  readNodeType,
  readNodeRef,
  readLocal,
  retainCode,
  releaseCode,
  localRef,
  declareLocal,
  declareLocalVariable,
  declareVariable,
  declareUnset,
  variableRef,
} from "narrac/emitstate"
import * as Tail from "narrac/emittail"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

const NODE = "selfhost-emit-match"

function declaredLocal(emitter: Emitter, nodeId: int): int {
  const info = emitter.checker.bodies[emitter.body]
  // Only a PatName node declares a local.
  const slot = findBodySlot(info, nodeId)
  if (slot < 0) {
    return -1
  }
  return info.declared[slot]
}

function variantPath(
  emitter: Emitter,
  enumIndex: int,
  variantIndex: int,
  index: int,
  path: string,
): string uses alloc {
  const variant = emitter.checker.enums[enumIndex].variants[variantIndex]
  return `${path}.u->v_${variant.name}.f_${variant.fields[index].name}`
}

function tupleFieldName(emitter: Emitter, pattern: Pattern, index: int): string {
  if (readNodeType(emitter, getPatternId(pattern)) is Type.TStruct(structIndex)) {
    return emitter.checker.structs[structIndex].fields[index].name
  }
  return ""
}

function emitPatternCondition<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pattern: Pattern,
  path: string,
): string uses alloc {
  // This may write lines for literal values.
  let conditions: Array<string> = []
  collectConditions(walker, mutable emitter, pattern, path, mutable conditions)
  if (Arrays.length(conditions) == 0) {
    return "true"
  }
  return Str.join(conditions, " && ")
}

function collectConditions<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pattern: Pattern,
  path: string,
  mutable conditions: Array<string>,
) uses alloc {
  match (pattern) {
    Pattern.PatName(nodeId, _, _) => {
      if (readNodeRef(emitter, nodeId) is Ref.Constructor(_, variantIndex)) {
        Arrays.push(mutable conditions, `${path}.tag == ${Int.toString(variantIndex)}`)
      }
    }
    Pattern.PatCtor(nodeId, _, _, _, arguments, _) => {
      if (readNodeRef(emitter, nodeId) is Ref.Constructor(enumIndex, variantIndex)) {
        Arrays.push(mutable conditions, `${path}.tag == ${Int.toString(variantIndex)}`)
        for (const index of Ranges.between(0, Arrays.length(arguments))) {
          const argumentPath = variantPath(emitter, enumIndex, variantIndex, index, path)
          collectConditions(
            walker,
            mutable emitter,
            arguments[index],
            argumentPath,
            mutable conditions,
          )
        }
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        collectConditions(
          walker,
          mutable emitter,
          field.pattern,
          `${path}.f_${field.name}`,
          mutable conditions,
        )
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const index of Ranges.between(0, Arrays.length(arguments))) {
        const name = tupleFieldName(emitter, pattern, index)
        collectConditions(
          walker,
          mutable emitter,
          arguments[index],
          `${path}.f_${name}`,
          mutable conditions,
        )
      }
    }
    Pattern.PatLit(nodeId, _, literal) => {
      const code = EmitWalker.emitExpression(walker, mutable emitter, literal)
      if (readNodeType(emitter, nodeId) == Type.TStr) {
        Arrays.push(mutable conditions, `lstr_eq(${path}, ${code.text})`)
      } else {
        Arrays.push(mutable conditions, `${path} == ${code.text}`)
      }
    }
    Pattern.PatWildcard(_, _) => {}
    Pattern.PatOr(_, _, alternatives) => {
      const condition = emitAlternativesCondition(walker, mutable emitter, alternatives, path)
      if (condition != "true") {
        Arrays.push(mutable conditions, condition)
      }
    }
  }
}

function emitAlternativesCondition<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  alternatives: Array<Pattern>,
  path: string,
): string uses alloc {
  // One alternative that always matches makes the whole list match.
  let parts: Array<string> = []
  for (const alternative of Arrays.values(alternatives)) {
    const condition = emitPatternCondition(walker, mutable emitter, alternative, path)
    if (condition == "true") {
      return "true"
    }
    Arrays.push(mutable parts, `(${condition})`)
  }
  return `(${Str.join(parts, " || ")})`
}

function collectBoundLocals(
  emitter: Emitter,
  pattern: Pattern,
  mutable locals: Array<int>,
) uses alloc {
  // The first alternative of a list stands for all of them.
  match (pattern) {
    Pattern.PatName(nodeId, _, _) => {
      const localIndex = declaredLocal(emitter, nodeId)
      if (localIndex >= 0) {
        Arrays.push(mutable locals, localIndex)
      }
    }
    Pattern.PatCtor(_, _, _, _, arguments, _) => {
      for (const argument of Arrays.values(arguments)) {
        collectBoundLocals(emitter, argument, mutable locals)
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        collectBoundLocals(emitter, field.pattern, mutable locals)
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const argument of Arrays.values(arguments)) {
        collectBoundLocals(emitter, argument, mutable locals)
      }
    }
    Pattern.PatOr(_, _, alternatives) => collectBoundLocals(
      emitter,
      alternatives[0],
      mutable locals,
    )
    _ => {}
  }
}

function bindAlternatives<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  alternatives: Array<Pattern>,
  path: string,
) uses alloc {
  // Test the alternatives in order and bind from the first one that matches. The last one needs no test, because the pattern already matched.
  const count = Arrays.length(alternatives)
  let conditions: Array<string> = []
  for (const index of Ranges.between(0, count - 1)) {
    Arrays.push(
      mutable conditions,
      emitPatternCondition(walker, mutable emitter, alternatives[index], path),
    )
  }
  for (const index of Ranges.between(0, count)) {
    if (index == 0) {
      writeLine(mutable emitter, `if (${conditions[0]}) {`)
    } else if (index < count - 1) {
      writeLine(mutable emitter, `} else if (${conditions[index]}) {`)
    } else {
      writeLine(mutable emitter, "} else {")
    }
    emitter.indent++
    bindPattern(walker, mutable emitter, alternatives[index], path, true)
    emitter.indent--
  }
  writeLine(mutable emitter, "}")
}

function bindPattern<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pattern: Pattern,
  path: string,
  assignOnly: bool,
) uses alloc {
  // Each local takes its own reference. Inside a list of alternatives the locals are declared once before it, so a binding only assigns.
  match (pattern) {
    Pattern.PatName(nodeId, _, _) => {
      const localIndex = declaredLocal(emitter, nodeId)
      if (localIndex >= 0) {
        const local = readLocal(emitter, localIndex)
        if (assignOnly) {
          const target = localRef(emitter, localIndex)
          writeLine(mutable emitter, `${target} = ${path};`)
        } else {
          declareLocal(mutable emitter, localIndex, path)
        }
        const name = localRef(emitter, localIndex)
        const retainText = retainCode(emitter, local.localType, name)
        if (retainText != "") {
          writeLine(mutable emitter, retainText)
        }
        if (!assignOnly) {
          addLocal(mutable emitter, localIndex)
        }
      }
    }
    Pattern.PatCtor(nodeId, _, _, _, arguments, _) => {
      if (readNodeRef(emitter, nodeId) is Ref.Constructor(enumIndex, variantIndex)) {
        for (const index of Ranges.between(0, Arrays.length(arguments))) {
          const argumentPath = variantPath(emitter, enumIndex, variantIndex, index, path)
          bindPattern(walker, mutable emitter, arguments[index], argumentPath, assignOnly)
        }
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        bindPattern(walker, mutable emitter, field.pattern, `${path}.f_${field.name}`, assignOnly)
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const index of Ranges.between(0, Arrays.length(arguments))) {
        const name = tupleFieldName(emitter, pattern, index)
        bindPattern(walker, mutable emitter, arguments[index], `${path}.f_${name}`, assignOnly)
      }
    }
    Pattern.PatOr(_, _, alternatives) => {
      let locals: Array<int> = []
      collectBoundLocals(emitter, pattern, mutable locals)
      if (Arrays.length(locals) > 0) {
        if (!assignOnly) {
          for (const localIndex of Arrays.values(locals)) {
            const declaration = declareLocalVariable(mutable emitter, localIndex)
            if (!emitter.inGenerator) {
              writeLine(mutable emitter, `${declaration};`)
            }
          }
        }
        bindAlternatives(walker, mutable emitter, alternatives, path)
        if (!assignOnly) {
          for (const localIndex of Arrays.values(locals)) {
            addLocal(mutable emitter, localIndex)
          }
        }
      }
    }
    Pattern.PatLit(_, _, _) | Pattern.PatWildcard(_, _) => {}
  }
}

function holdSubject(mutable emitter: Emitter, name: string, subjectType: Type) uses alloc {
  if (needsRc(emitter, subjectType)) {
    const top = Arrays.length(emitter.scopes) - 1
    Arrays.push(mutable emitter.scopes[top].held, TempVar { name: name, tempType: subjectType })
  }
}

export function emitIsCondition<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  if (expression is Expr.IsExpr(_, _, subject, pattern)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, subject)
    const subjectType = readNodeType(emitter, getExpressionId(subject))
    const held = temp(mutable emitter, subjectType, code.text)
    const condition = emitPatternCondition(walker, mutable emitter, pattern, held)
    return Code { text: `(${condition})`, owned: false }
  }
  return Code { text: reportUnsupported(mutable emitter, "is expression", NODE), owned: false }
}

export function emitIfIs<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
) uses alloc {
  // The subject is held for the whole statement, because the pattern's names
  // read from it.
  if (statement is Stmt.IfStmt(_, condition, then, orElse)) {
    if (condition is Expr.IsExpr(_, _, subject, pattern)) {
      const subjectType = readNodeType(emitter, getExpressionId(subject))
      writeLine(mutable emitter, "{")
      emitter.indent++
      pushScope(mutable emitter, false)
      beginStatement(mutable emitter)
      const code = EmitWalker.emitExpression(walker, mutable emitter, subject)
      const consumed = consume(mutable emitter, code.text, code.owned, subjectType)
      const held = temp(mutable emitter, subjectType, consumed)
      endStatement(mutable emitter)
      holdSubject(mutable emitter, held, subjectType)
      beginStatement(mutable emitter)
      const matchTest = emitPatternCondition(walker, mutable emitter, pattern, held)
      const holds = temp(mutable emitter, Type.TBool, matchTest)
      endStatement(mutable emitter)
      writeLine(mutable emitter, `if (${holds}) {`)
      emitter.indent++
      pushScope(mutable emitter, false)
      bindPattern(walker, mutable emitter, pattern, held, false)
      EmitWalker.emitBlockInScope(walker, mutable emitter, then)
      popScope(mutable emitter)
      emitter.indent--
      if (orElse is Some(otherwise)) {
        writeLine(mutable emitter, "} else {")
        emitter.indent++
        if (otherwise is Stmt.BlockStmt(elseBlock)) {
          EmitWalker.emitBlock(walker, mutable emitter, elseBlock, false)
        } else {
          EmitWalker.emitStatement(walker, mutable emitter, otherwise)
        }
        emitter.indent--
      }
      writeLine(mutable emitter, "}")
      popScope(mutable emitter)
      emitter.indent--
      writeLine(mutable emitter, "}")
      return
    }
  }
  const _ = reportUnsupported(mutable emitter, "if is", NODE)
}

function emitMatchArms<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  subject: Expr,
  arms: Array<MatchArm>,
  isValue: bool,
  returning: bool,
  result: string,
  resultType: Type,
) uses alloc {
  // A value match assigns each arm's value to result; a statement match runs
  // each arm.
  const code = EmitWalker.emitExpression(walker, mutable emitter, subject)
  const subjectType = readNodeType(emitter, getExpressionId(subject))
  const held = temp(mutable emitter, subjectType, code.text)
  emitter.tempCount++
  const doneName = `m${Int.toString(emitter.tempCount)}`
  const doneDeclaration = declareVariable(mutable emitter, "bool", doneName)
  const done = variableRef(emitter, doneName)
  writeLine(mutable emitter, `${doneDeclaration} = false;`)
  for (const arm of Arrays.values(arms)) {
    writeLine(mutable emitter, `if (!${done}) {`)
    emitter.indent++
    let armLocals: Array<int> = []
    collectBoundLocals(emitter, arm.pattern, mutable armLocals)
    if (arm.guard is Some(armGuard)) {
      if (Arrays.length(armLocals) > 0 && containsOrPattern(arm.pattern)) {
        emitGuardedAlternatives(
          walker,
          mutable emitter,
          arm,
          expandOrPatterns(arm.pattern),
          armGuard,
          held,
          returning,
          isValue,
          result,
          resultType,
          done,
        )
        emitter.indent--
        writeLine(mutable emitter, "}")
        continue
      }
    }
    beginStatement(mutable emitter)
    const condition = emitPatternCondition(walker, mutable emitter, arm.pattern, held)
    const holds = temp(mutable emitter, Type.TBool, condition)
    endStatement(mutable emitter)
    writeLine(mutable emitter, `if (${holds}) {`)
    emitter.indent++
    pushScope(mutable emitter, false)
    bindPattern(walker, mutable emitter, arm.pattern, held, false)
    if (arm.guard is Some(guard)) {
      beginStatement(mutable emitter)
      const guardCode = EmitWalker.emitExpression(walker, mutable emitter, guard)
      const guardHolds = temp(mutable emitter, Type.TBool, guardCode.text)
      endStatement(mutable emitter)
      writeLine(mutable emitter, `if (${guardHolds}) {`)
      emitter.indent++
    }
    emitArmBody(walker, mutable emitter, arm, returning, isValue, result, resultType, done)
    if (arm.guard is Some(_)) {
      emitter.indent--
      writeLine(mutable emitter, "}")
    }
    popScope(mutable emitter)
    emitter.indent--
    writeLine(mutable emitter, "}")
    emitter.indent--
    writeLine(mutable emitter, "}")
  }
}

function emitArmBody<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arm: MatchArm,
  returning: bool,
  isValue: bool,
  result: string,
  resultType: Type,
  done: string,
) uses alloc {
  writeLine(mutable emitter, `${done} = true;`)
  if (returning) {
    if (arm.body is Some(armBody)) {
      Tail.emitReturnArm(walker, mutable emitter, armBody, resultType)
    } else if (arm.block is Some(armBlock)) {
      emitReturnBlockArm(walker, mutable emitter, armBlock, resultType)
    }
  } else if (isValue) {
    emitValueArm(walker, mutable emitter, arm, result, resultType)
  } else {
    emitStatementArm(walker, mutable emitter, arm)
  }
}

function containsOrPattern(pattern: Pattern): bool {
  match (pattern) {
    Pattern.PatOr(_, _, _) => {
      return true
    }
    Pattern.PatCtor(_, _, _, _, arguments, _) => {
      for (const argument of Arrays.values(arguments)) {
        if (containsOrPattern(argument)) {
          return true
        }
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        if (containsOrPattern(field.pattern)) {
          return true
        }
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const argument of Arrays.values(arguments)) {
        if (containsOrPattern(argument)) {
          return true
        }
      }
    }
    _ => {}
  }
  return false
}

function combinePatternOptions(options: Array<Array<Pattern>>): Array<Array<Pattern>> uses alloc {
  // Every way to pick one pattern from each list, in order.
  let combinations: Array<Array<Pattern>> = [[]]
  for (const choices of Arrays.values(options)) {
    let extended: Array<Array<Pattern>> = []
    for (const prefix of Arrays.values(combinations)) {
      for (const choice of Arrays.values(choices)) {
        let combination: Array<Pattern> = []
        for (const earlier of Arrays.values(prefix)) {
          Arrays.push(mutable combination, earlier)
        }
        Arrays.push(mutable combination, choice)
        Arrays.push(mutable extended, combination)
      }
    }
    combinations = extended
  }
  return combinations
}

function expandOrPatterns(pattern: Pattern): Array<Pattern> uses alloc {
  // The patterns without an or-pattern that together match what this one matches, so a guard can try each.
  let expanded: Array<Pattern> = []
  match (pattern) {
    Pattern.PatOr(_, _, alternatives) => {
      for (const alternative of Arrays.values(alternatives)) {
        for (const choice of Arrays.values(expandOrPatterns(alternative))) {
          Arrays.push(mutable expanded, choice)
        }
      }
    }
    Pattern.PatCtor(nodeId, pos, enumName, name, arguments, bare) => {
      let options: Array<Array<Pattern>> = []
      for (const argument of Arrays.values(arguments)) {
        Arrays.push(mutable options, expandOrPatterns(argument))
      }
      for (const combination of Arrays.values(combinePatternOptions(options))) {
        Arrays.push(
          mutable expanded,
          Pattern.PatCtor(nodeId, pos, enumName, name, combination, bare),
        )
      }
    }
    Pattern.PatStruct(nodeId, pos, fields) => {
      let options: Array<Array<Pattern>> = []
      for (const field of Arrays.values(fields)) {
        Arrays.push(mutable options, expandOrPatterns(field.pattern))
      }
      for (const combination of Arrays.values(combinePatternOptions(options))) {
        let rebuilt: Array<FieldPattern> = []
        for (const index of Ranges.between(0, Arrays.length(fields))) {
          Arrays.push(mutable rebuilt, FieldPattern {
            pos: fields[index].pos,
            name: fields[index].name,
            pattern: combination[index],
          })
        }
        Arrays.push(mutable expanded, Pattern.PatStruct(nodeId, pos, rebuilt))
      }
    }
    Pattern.PatTuple(nodeId, pos, arguments) => {
      let options: Array<Array<Pattern>> = []
      for (const argument of Arrays.values(arguments)) {
        Arrays.push(mutable options, expandOrPatterns(argument))
      }
      for (const combination of Arrays.values(combinePatternOptions(options))) {
        Arrays.push(mutable expanded, Pattern.PatTuple(nodeId, pos, combination))
      }
    }
    _ => {
      Arrays.push(mutable expanded, pattern)
    }
  }
  return expanded
}

function emitGuardedAlternatives<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arm: MatchArm,
  alternatives: Array<Pattern>,
  guard: Expr,
  held: string,
  returning: bool,
  isValue: bool,
  result: string,
  resultType: Type,
  done: string,
) uses alloc {
  // Each alternative that matches binds its own names and runs the guard; the first one whose guard holds selects the arm.
  let locals: Array<int> = []
  collectBoundLocals(emitter, arm.pattern, mutable locals)
  for (const localIndex of Arrays.values(locals)) {
    const declaration = declareLocalVariable(mutable emitter, localIndex)
    if (!emitter.inGenerator) {
      writeLine(mutable emitter, `${declaration};`)
    }
  }
  emitter.tempCount++
  const selectedName = `m${Int.toString(emitter.tempCount)}`
  const selectedDeclaration = declareVariable(mutable emitter, "bool", selectedName)
  const selected = variableRef(emitter, selectedName)
  writeLine(mutable emitter, `${selectedDeclaration} = false;`)
  for (const alternative of Arrays.values(alternatives)) {
    beginStatement(mutable emitter)
    const condition = emitPatternCondition(walker, mutable emitter, alternative, held)
    const holds = temp(mutable emitter, Type.TBool, condition)
    endStatement(mutable emitter)
    writeLine(mutable emitter, `if (!${selected} && ${holds}) {`)
    emitter.indent++
    bindPattern(walker, mutable emitter, alternative, held, true)
    beginStatement(mutable emitter)
    const guardCode = EmitWalker.emitExpression(walker, mutable emitter, guard)
    const guardHolds = temp(mutable emitter, Type.TBool, guardCode.text)
    endStatement(mutable emitter)
    writeLine(mutable emitter, `if (${guardHolds}) {`)
    emitter.indent++
    writeLine(mutable emitter, `${selected} = true;`)
    emitter.indent--
    writeLine(mutable emitter, "} else {")
    emitter.indent++
    for (const localIndex of Arrays.values(locals)) {
      const local = readLocal(emitter, localIndex)
      const releaseText = releaseCode(emitter, local.localType, localRef(emitter, localIndex))
      if (releaseText != "") {
        writeLine(mutable emitter, releaseText)
      }
    }
    emitter.indent--
    writeLine(mutable emitter, "}")
    emitter.indent--
    writeLine(mutable emitter, "}")
  }
  writeLine(mutable emitter, `if (${selected}) {`)
  emitter.indent++
  pushScope(mutable emitter, false)
  for (const localIndex of Arrays.values(locals)) {
    addLocal(mutable emitter, localIndex)
  }
  emitArmBody(walker, mutable emitter, arm, returning, isValue, result, resultType, done)
  popScope(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
}

function emitStatementArm<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arm: MatchArm,
) uses alloc {
  if (arm.block is Some(block)) {
    EmitWalker.emitBlock(walker, mutable emitter, block, false)
    return
  }
  if (arm.body is Some(body)) {
    if (Tail.isTailCall(emitter, body)) {
      Tail.emitTailJump(walker, mutable emitter, body)
      return
    }
    beginStatement(mutable emitter)
    const code = EmitWalker.emitExpression(walker, mutable emitter, body)
    if (code.text != "" && readNodeType(emitter, getExpressionId(body)) == Type.TVoid) {
      writeLine(mutable emitter, `${code.text};`)
    }
    endStatement(mutable emitter)
  }
}

function emitReturnBlockArm<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
  type: Type,
) uses alloc {
  beginStatement(mutable emitter)
  const code = emitBlockBody(walker, mutable emitter, block, type)
  const value = consume(mutable emitter, code.text, code.owned, type)
  const result = temp(mutable emitter, type, value)
  unwindAll(mutable emitter)
  writeLine(mutable emitter, `return ${result};`)
  emitter.frames = Tail.withoutLastFrame(emitter.frames)
}

export function emitBlockBody<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  block: Block,
  resultType: Type,
): Code uses alloc {
  // Each return stores its value, releases what the block holds and jumps to
  // the label after the block. A match arm written as a block uses this too.
  emitter.tempCount++
  const number = Int.toString(emitter.tempCount)
  const typeName = cType(emitter.checker, resultType)
  const result = declareUnset(mutable emitter, typeName, `r${number}`)
  const info = BlockInfo {
    result: result,
    label: `narra_block_${number}`,
    frames: Arrays.length(emitter.frames),
    scopes: Arrays.length(emitter.scopes),
  }
  writeLine(mutable emitter, "{")
  emitter.indent++
  Arrays.push(mutable emitter.blocks, info)
  pushScope(mutable emitter, false)
  EmitWalker.emitBlockInScope(walker, mutable emitter, block)
  popScope(mutable emitter)
  emitter.blocks = withoutLastBlock(emitter.blocks)
  emitter.indent--
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, `${info.label}:;`)
  if (needsRc(emitter, resultType)) {
    const top = Arrays.length(emitter.frames) - 1
    Arrays.push(mutable emitter.frames[top], TempVar { name: info.result, tempType: resultType })
    return Code { text: info.result, owned: true }
  }
  return Code { text: info.result, owned: false }
}

function emitValueArm<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arm: MatchArm,
  result: string,
  resultType: Type,
) uses alloc {
  if (arm.block is Some(block)) {
    beginStatement(mutable emitter)
    const code = emitBlockBody(walker, mutable emitter, block, resultType)
    const value = consume(mutable emitter, code.text, code.owned, resultType)
    writeLine(mutable emitter, `${result} = ${value};`)
    endStatement(mutable emitter)
    return
  }
  if (arm.body is Some(body)) {
    beginStatement(mutable emitter)
    const code = EmitWalker.emitExpression(walker, mutable emitter, body)
    const value = consume(mutable emitter, code.text, code.owned, resultType)
    writeLine(mutable emitter, `${result} = ${value};`)
    endStatement(mutable emitter)
  }
}

export function emitMatchStatement<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
) uses alloc {
  // The caller has opened the statement's temporary frame.
  if (statement is Stmt.ExprStmt(_, expression)) {
    if (expression is Expr.MatchExpr(_, _, subject, arms)) {
      emitMatchArms(walker, mutable emitter, subject, arms, false, false, "", Type.TVoid)
      return
    }
  }
  const _ = reportUnsupported(mutable emitter, "match statement", NODE)
}

export function emitReturnMatch<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
) uses alloc {
  // Each arm returns its own value, so an arm that is a tail call becomes a
  // jump.
  if (expression is Expr.MatchExpr(nodeId, _, subject, arms)) {
    const resultType = readNodeType(emitter, nodeId)
    beginStatement(mutable emitter)
    emitMatchArms(walker, mutable emitter, subject, arms, false, true, "", resultType)
    emitter.frames = Tail.withoutLastFrame(emitter.frames)
    return
  }
  const _ = reportUnsupported(mutable emitter, "match expression", NODE)
}

export function emitMatchValue<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  if (expression is Expr.MatchExpr(nodeId, _, subject, arms)) {
    const resultType = readNodeType(emitter, nodeId)
    emitter.tempCount++
    const resultName = cType(emitter.checker, resultType)
    const variableName = `r${Int.toString(emitter.tempCount)}`
    const result = declareUnset(mutable emitter, resultName, variableName)
    emitMatchArms(walker, mutable emitter, subject, arms, true, false, result, resultType)
    if (needsRc(emitter, resultType)) {
      const top = Arrays.length(emitter.frames) - 1
      Arrays.push(mutable emitter.frames[top], TempVar { name: result, tempType: resultType })
      return Code { text: result, owned: true }
    }
    return Code { text: result, owned: false }
  }
  return Code { text: reportUnsupported(mutable emitter, "match expression", NODE), owned: false }
}

export function emitDestructure<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  statement: Stmt,
) uses alloc {
  // The value is held in a temporary for the statement; each bound name retains
  // its part, and an owned value is released at the end of the statement.
  if (statement is Stmt.VarStmt(_, _, _, _, Some(pattern), _, value)) {
    beginStatement(mutable emitter)
    const code = EmitWalker.emitExpression(walker, mutable emitter, value)
    const patternType = readNodeType(emitter, getPatternId(pattern))
    const held = temp(mutable emitter, patternType, code.text)
    bindPattern(walker, mutable emitter, pattern, held, false)
    endStatement(mutable emitter)
    return
  }
  const _ = reportUnsupported(mutable emitter, "destructuring", NODE)
}

export function emitSpreadLiteral<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  // Given fields are consumed; the others are copied from the spread value and
  // retained, so the result owns every field.
  if (expression is Expr.StructLit(nodeId, _, _, _, fields, Some(spread))) {
    const structType = readNodeType(emitter, nodeId)
    if (structType is Type.TStruct(structIndex)) {
      const spreadCode = EmitWalker.emitExpression(walker, mutable emitter, spread)
      const source = temp(mutable emitter, structType, spreadCode.text)
      let given: Map<string, string> = Map {}
      for (const field of Arrays.values(fields)) {
        const code = EmitWalker.emitExpression(walker, mutable emitter, field.value)
        const fieldType = readNodeType(emitter, getExpressionId(field.value))
        given[field.name] = consume(mutable emitter, code.text, code.owned, fieldType)
      }
      let parts: Array<string> = []
      for (const declared of Arrays.values(emitter.checker.structs[structIndex].fields)) {
        let value = `${source}.f_${declared.name}`
        if (given[declared.name] is Some(givenValue)) {
          value = givenValue
        } else {
          const retainText = retainCode(emitter, declared.fieldType, value)
          if (retainText != "") {
            writeLine(mutable emitter, retainText)
          }
        }
        Arrays.push(mutable parts, `.f_${declared.name} = ${value}`)
      }
      const structName = cType(emitter.checker, structType)
      const built = ownedTemp(
        mutable emitter,
        structType,
        `((${structName}){${Str.join(parts, ", ")}})`,
      )
      return Code { text: built, owned: true }
    }
  }
  return Code { text: reportUnsupported(mutable emitter, "spread literal", NODE), owned: false }
}

export function emitTupleLiteral<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  if (expression is Expr.ArrayLit(nodeId, _, elements, _)) {
    const tupleType = readNodeType(emitter, nodeId)
    if (tupleType is Type.TStruct(structIndex)) {
      let parts: Array<string> = []
      for (const index of Ranges.between(0, Arrays.length(elements))) {
        const code = EmitWalker.emitExpression(walker, mutable emitter, elements[index])
        const declared = emitter.checker.structs[structIndex].fields[index]
        const value = consume(mutable emitter, code.text, code.owned, declared.fieldType)
        Arrays.push(mutable parts, `.f_${declared.name} = ${value}`)
      }
      const structName = cType(emitter.checker, tupleType)
      const built = ownedTemp(
        mutable emitter,
        tupleType,
        `((${structName}){${Str.join(parts, ", ")}})`,
      )
      return Code { text: built, owned: true }
    }
  }
  return Code { text: reportUnsupported(mutable emitter, "tuple literal", NODE), owned: false }
}
