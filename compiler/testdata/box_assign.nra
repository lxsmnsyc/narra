import * as Int from "std/int"
import * as Boxes from "std/box"

struct Point {
  x: int
  y: int
}

export function run(args: Array<string>): int {
  // int payload
  let count = Boxes.new(5)
  count.value = 6
  print(Int.toString(count.value))

  // struct payload
  let point = Boxes.new(Point { x: 1, y: 2 })
  point.value = Point { x: 3, y: 4 }
  print(Int.toString(point.value.x + point.value.y))

  // string payload
  let name = Boxes.new("a")
  name.value = "bc"
  print(name.value)

  // a copy shares the cell until one holder writes
  let first = Boxes.new(10)
  let second = first
  first.value = 11
  print(Int.toString(first.value))
  print(Int.toString(second.value))
  second.value = 12
  print(Int.toString(first.value))
  print(Int.toString(second.value))

  // shared string payload
  let left = Boxes.new("x")
  let right = left
  right.value = "y"
  print(left.value)
  print(right.value)
  return 0
}
