// A string built with templates, a string builder and std/string, by @const
// functions that call each other and read a top-level constant.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

const PREFIX = "item"

@const
function label(index: int): string uses alloc {
  return `${PREFIX}-${Int.toString(index)}`
}

@const
function describeList(count: int): string uses alloc {
  let labels: Array<string> = []
  for (let index = 0; index < count; index++) {
    Arrays.push(mutable labels, label(index))
  }
  let builder = Str.builder()
  Str.append(mutable builder, Str.join(labels, ","))
  Str.appendChar(mutable builder, '!')
  return Str.build(builder)
}

@const
function shout(text: string): string uses alloc {
  let result = Str.replace(Str.trim(text), "a", "A")
  if (Str.repeat("-", 3) is Some(line)) {
    result = Str.concat(line, result)
  }
  if (Str.slice(result, 0, 4) is Some(start)) {
    result = `${result} [${start}]`
  }
  if (Str.split("x:y:z", ":") is Some(parts)) {
    result = `${result} ${Int.toString(Arrays.length(parts))}`
  }
  if (Str.indexOf(result, "A") is Some(position)) {
    result = `${result} ${Int.toString(position)} ${Int.toHex(255)}`
  }
  return `${result} ${Str.charAt(result, 3) == 'b' ? "b" : "?"} ${Int.toString(Str.charCount("héllo"))}`
}

const LIST = describeList(4)
const SHOUTED = shout("  banana bread  ")

export function run(args: Array<string>): int uses io, alloc {
  const four = 4
  const text = "  banana bread  "
  print(LIST)
  print(describeList(four))
  print(SHOUTED)
  print(shout(text))
  return 0
}
