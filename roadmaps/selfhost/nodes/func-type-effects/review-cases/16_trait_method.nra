function loud(value: int): int {
  print("x")
  return value
}

trait Maker {
  function make(m: Self): (value: int) => int uses io
}
struct M implements Maker {
  n: int
}
implement Maker for M {
  function make(_m: M): (value: int) => int uses io {
    return loud
  }
}
export function pure(m: M): int {
  return Maker.make(m)(1)
}

export function run(args: Array<string>): int {
  return 0
}
