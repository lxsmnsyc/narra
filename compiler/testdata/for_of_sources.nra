import * as Int from "std/int"
import * as Char from "std/char"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

struct Span {
  window: Range
  label: string
}

function evens(limit: int): Range {
  return Ranges.between(0, limit)
}

function names(): Array<string> {
  return ["ann", "bo"]
}

function total(window: Range): int {
  let sum = 0
  for (const i of window) {
    sum = sum + i
  }
  return sum
}

export function run(args: Array<string>): int {
  // a Range in a const
  const upTo = Ranges.upTo(3)
  for (const i of upTo) {
    print(Int.toString(i))
  }
  // the same Range can run again
  print(Int.toString(total(upTo)))

  // a Range in a struct field, and from a function result
  const span = Span { window: Ranges.between(2, 5), label: "mid" }
  for (const i of span.window) {
    print(`${span.label}${Int.toString(i)}`)
  }
  for (const i of evens(2)) {
    print(`e${Int.toString(i)}`)
  }
  // an empty Range
  for (const i of Ranges.between(5, 5)) {
    print("never")
  }

  // an array literal, a local and a call result
  for (const item of ["x", "y"]) {
    print(item)
  }
  const local = [10, 20, 30]
  for (const n of local) {
    print(Int.toString(n))
  }
  for (const name of names()) {
    print(name)
  }
  let grown = ["a"]
  for (const item of grown) {
    print(item)
  }
  Arrays.push(mutable grown, "b")
  print(Int.toString(Arrays.length(grown)))

  // Str.chars over ASCII and multi-byte text
  for (const c of Str.chars("ab")) {
    print(Int.toString(Char.code(c)))
  }
  let count = 0
  for (const c of Str.chars("h\u{e9}\u{4e16}")) {
    count = count + 1
  }
  print(Int.toString(count))

  // nested loops and break
  for (const row of Ranges.upTo(3)) {
    for (const column of span.window) {
      if (column == 4) {
        break
      }
      print(`${Int.toString(row)}${Int.toString(column)}`)
    }
    if (row == 1) {
      break
    }
  }
  return 0
}
