<script>
  import { $props, $route } from 'brumate/signals';
  import { raw } from 'brumate/html';
  import Icon from '../components/Icon.brm';
  import Search from '../components/Search.brm';
  import { switchTheme } from '../theme-switch.ts';
  import { STYLES, THEME_SCRIPT } from '../theme.ts';

  const { children } = $props();
  const route = $route();

  const LINKS = [
    { label: 'Install', href: '/install', sections: ['/install'] },
    { label: 'Guide', href: '/guide', sections: ['/guide'] },
    { label: 'Reference', href: '/reference', sections: ['/reference', '/spec'] },
    { label: 'Packages', href: '/packages', sections: ['/packages'] },
  ];

  /** Whether the current page is in a section of a link, such as `/guide/02-values-and-types`. */
  function isCurrent(sections: string[], pathname: string): boolean {
    for (const section of sections) {
      if (pathname === section || pathname.startsWith(`${section}/`)) {
        return true;
      }
    }
    return false;
  }
</script>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/logo.svg">
    <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin>
    {raw(THEME_SCRIPT)}
    {raw(STYLES)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Narra">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <circle cx="16" cy="16" r="14" fill="var(--accent-fill)"/>
            <circle cx="14.5" cy="15" r="9.5" fill="none" stroke="var(--on-accent)" stroke-width="1.6" opacity="0.55"/>
            <circle cx="13.5" cy="14.5" r="5" fill="none" stroke="var(--on-accent)" stroke-width="1.6" opacity="0.8"/>
            <circle cx="13" cy="14" r="1.6" fill="var(--on-accent)"/>
          </svg>
          <span>Narra</span>
        </a>
        <div class="header-slot">
          <Search />
        </div>
        <nav class="header-nav" aria-label="Main">
          #for (link of LINKS by link.href) {
            <a
              class="nav-link"
              href=(link.href)
              aria-current=(isCurrent(link.sections, route.url.pathname) ? 'page' : undefined)
            >{link.label}</a>
          }
          <a class="icon-button github-link" href="https://github.com/lxsmnsyc/narra" aria-label="Narra on GitHub" title="Narra on GitHub">
            <Icon name="github" size=(18) />
          </a>
          <button class="icon-button theme-toggle" type="button" onClick=(() => switchTheme())>
            <span class="moon"><Icon name="moon" size=(18) /><span class="visually-hidden">Switch to dark theme</span></span>
            <span class="sun"><Icon name="sun" size=(18) /><span class="visually-hidden">Switch to light theme</span></span>
          </button>
        </nav>
      </div>
    </header>
    <div id="main" tabindex="-1">
      {children}
    </div>
    <footer class="footer">
      <p>The Narra programming language.</p>
      <nav class="footer-links" aria-label="Project">
        <a href="https://github.com/lxsmnsyc/narra">Source</a>
        <a href="https://github.com/lxsmnsyc/narra/issues">Issues</a>
      </nav>
    </footer>
  </body>
</html>
