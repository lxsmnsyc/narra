// Elements at two different literal indexes are different places, so a write
// to one does not touch a name that shares the other. The shared-write check
// (E0978) accepts every write here, and no copy happens.
import * as Int from "std/int"

struct Grid {
  rows: Array<Array<int>>
}

export function run(_args: Array<string>): int {
  let rows = [[1], [2]]
  const first = rows[0]
  rows[1][0] = 4
  print(`${Int.toString(first[0])} ${Int.toString(rows[1][0])}`)

  // The same through a field.
  let grid = Grid { rows: [[5, 6], [7]] }
  const top = grid.rows[0]
  grid.rows[1][0] = 8
  print(`${Int.toString(top[1])} ${Int.toString(grid.rows[1][0])}`)
  return 0
}
