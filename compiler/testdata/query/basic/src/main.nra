import * as Int from "std/int"
import * as Text from "app/text"
import { Point, Shape, helper, LIMIT } from "app/text"

function apply(f: (value: string) => int uses alloc, text: string): int {
  return f(text)
}

export function run(arguments: Array<string>): int uses io, alloc {
  const point = Point { x: 1, y: 2 }
  const total = point.x + helper("ab")
  const counted = apply((value: string): int => helper(value), "abc")
  const shape = Shape.Circle(2)
  if (shape is Shape.Circle(radius)) {
    print(Int.toString(radius))
  }
  const picked = Text.first(arguments, "none")
  print(picked)
  print(`${picked} ${Int.toString(helper(picked))}`)
  return total + counted + LIMIT + Text.area(Shape.Empty)
}
