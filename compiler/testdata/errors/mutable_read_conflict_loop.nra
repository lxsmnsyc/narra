// error: mutable_read_conflict_loop.nra:12:19: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function bump(mutable n: int): int {
  n = 10
  return 0
}

export function run(args: Array<string>): int {
  let x = 1
  let i = 0
  while (i < 3) {
    if (i < 10) {
      i = i + 1 + x * bump(mutable x)
    }
  }
  return 0
}
