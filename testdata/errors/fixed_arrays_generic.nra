// error: index 0 is out of range for FixedArray<int, 0>
function first<const N: int>(values: FixedArray<int, N>): int {
  return values[0]
}

function mix<const N: int, const M: int>(left: FixedArray<int, N>, right: FixedArray<int, M>): int {
  let total = 0
  for (let i = 0; i < N; i++) {
    total += left[i] + right[i]
  }
  return total
}

export function run(_args: Array<string>): int {
  const one: FixedArray<int, 1> = [1]
  const none: FixedArray<int, 0> = []
  const pair: FixedArray<int, 2> = [1, 2]
  const triple: FixedArray<int, 3> = [1, 2, 3]
  return first(one) + first(none) + mix(pair, triple) + mix(triple, pair)
}
