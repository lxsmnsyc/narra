// C names, ported from cnames.go by selfhost-emit-program. Stub from
// selfhost-emit-core: the signatures are the contract's, but they take the
// Checker instead of the Emitter (emitstate.nra imports this module, so it
// cannot take an Emitter; see contracts/emitter.change-request.md). Nothing
// calls them while Checker.programRecorded is false.
import { Type } from "narrac/types"
import { Checker, ProgramFunc } from "narrac/check"

export function typeId(checker: Checker, type: Type): string {
  return "x"
}

// cType is Go's CName(): the C type, with "*" for arrays, boxes and maps and
// "void*" for a type parameter.
export function cType(checker: Checker, type: Type): string {
  return "x"
}

export function declName(kind: string, module: string, name: string): string uses alloc {
  return `${kind}_${name}`
}

export function internedName(kind: string, head: string, arguments: Array<string>): string uses alloc {
  return `${kind}_${head}`
}

export function payloadName(checker: Checker, enumType: Type): string {
  return "x"
}

export function functionName(checker: Checker, program: ProgramFunc): string {
  return "x"
}

export function instanceName(module: string, name: string, typeIds: Array<string>): string {
  return name
}

export function implName(typeName: string, traitModule: string, traitName: string, member: string): string {
  return member
}

export function opFuncName(operation: string, typeIdText: string): string uses alloc {
  return `${operation}_${typeIdText}`
}

export function closureName(kind: string, owner: string, count: int): string uses alloc {
  return `${kind}${owner}`
}

export function thunkName(owner: string): string uses alloc {
  return `w${owner}`
}

export function constName(module: string, name: string): string uses alloc {
  return declName("G", module, name)
}

export function constGetterName(module: string, name: string): string uses alloc {
  return declName("g", module, name)
}

// checkNameCollisions runs once after naming; Some(message) is an internal error.
export function checkNameCollisions(checker: Checker): Option<string> {
  return None
}
