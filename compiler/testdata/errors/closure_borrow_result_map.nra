// error: closure_borrow_result_map.nra:6:27: "r" is assigned by a closure passed to this call
import * as Results from "std/result"

export function run(args: Array<string>): int {
  let r: Result<string, string> = Ok("a")
  const out = Results.map(r, (s) => {
    r = Err("boom")
    return `${s}x`
  })
  return 0
}
