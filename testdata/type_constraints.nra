import * as Int from "std/int"

struct Labeled<T: Show> {
  label: string
  value: T
}

enum Tree<T: Ordered> {
  Leaf
  Node(left: Tree<T>, value: T, right: Tree<T>)
}

struct Point derives Show, Ordered {
  x: int
  y: int
}

function describe<T: Show>(labeled: Labeled<T>): string {
  return `${labeled.label}=${Show.show(labeled.value)}`
}

function insert<T: Ordered>(tree: Tree<T>, value: T): Tree<T> {
  return match (tree) {
    Tree.Leaf => Tree.Node(Tree.Leaf, copy(value), Tree.Leaf)
    Tree.Node(left, current, right) => {
      if (Ordered.compare(value, current) == Ordering.Less) {
        return Tree.Node(insert(left, value), copy(current), copy(right))
      }
      return Tree.Node(copy(left), copy(current), insert(right, value))
    }
  }
}

function countNodes<T: Ordered>(tree: Tree<T>): int {
  return match (tree) {
    Tree.Leaf => 0
    Tree.Node(left, _, right) => countNodes(left) + 1 + countNodes(right)
  }
}

export function run(_args: Array<string>): int {
  const number = Labeled { label: "number", value: 42 }
  const word: Labeled<string> = Labeled { label: "word", value: "hello" }
  const point = Labeled { label: "point", value: Point { x: 1, y: 2 } }
  print(describe(number))
  print(describe(word))
  print(describe(point))

  let numbers: Tree<int> = Tree.Leaf
  for (const value of [5, 3, 8, 1]) {
    numbers = insert(numbers, value)
  }
  let words: Tree<string> = Tree.Leaf
  for (const value of ["pear", "apple"]) {
    words = insert(words, value)
  }
  let points: Tree<Point> = Tree.Leaf
  points = insert(points, Point { x: 2, y: 0 })
  points = insert(points, Point { x: 1, y: 5 })
  print(Int.toString(countNodes(numbers) + countNodes(words) + countNodes(points)))
  return 0
}
