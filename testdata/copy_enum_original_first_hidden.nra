// Like copy_enum_original_first, with a third write: only two copy(...) calls
// exist, so the debug copy check still reports the third copy on write.
import * as Int from "std/int"
import * as Arrays from "std/array"

enum Tree {
  Leaf(cells: Array<int>)
  Node(left: Tree, right: Tree)
}

function makeCopies(): Array<Tree> {
  const tree = Tree.Node(Tree.Leaf([1, 2]), Tree.Leaf([3]))
  const first = copy(tree)
  const second = copy(tree)
  return [first, second]
}

// The static rule does not follow a mutable argument of a user function, so
// it does not see that lists now shares cells.
function keep(mutable lists: Array<Array<int>>, cells: Array<int>) {
  Arrays.push(mutable lists, cells)
}

export function run(args: Array<string>): int {
  const trees = makeCopies()
  let lists: Array<Array<int>> = []
  if (trees[0] is Tree.Node(Tree.Leaf(cells), _)) {
    keep(mutable lists, cells)
  }
  if (trees[1] is Tree.Node(Tree.Leaf(cells), _)) {
    keep(mutable lists, cells)
  }
  if (trees[0] is Tree.Node(Tree.Leaf(cells), _)) {
    keep(mutable lists, cells)
  }
  lists[0][0] = 9
  lists[1][0] = 8
  lists[2][0] = 7
  print(
    `list ${Int.toString(lists[0][0])} ${Int.toString(lists[1][0])} ${Int.toString(lists[2][0])}`,
  )
  return 0
}
