// error: shift_upper_only.nra:4:21: the shift count must be a constant from 0 to 63 or a name checked against both ends first; check the name first, as in `if (n >= 0 && n < 64) { ... }`
function shift(value: int, count: int): int {
  if (count < 64) {
    return value >> count
  }
  return 0
}

export function run(args: Array<string>): int {
  return shift(1, 3)
}
