import * as Int from "std/int"
import * as Arrays from "std/array"

struct Point derives Show, Ordered {
  x: int
  y: int
}

enum Shape derives Show, Ordered {
  Dot(at: Point)
  Line(start: Point, end: Point)
  Label(text: string)
  Empty
}

struct Scene derives Show {
  name: string
  shapes: Array<Shape>
  focus: Option<Point>
}

struct Pair<A, B> derives Show, Ordered {
  first: A
  second: B
}

struct Tree derives Show {
  label: string
  kids: Array<Tree>
}

struct Plain {
  id: int
  tags: Array<string>
}

function order(o: Ordering): string {
  return match (o) {
    Ordering.Less => "less"
    Ordering.Equal => "equal"
    Ordering.Greater => "greater"
  }
}

export function run(args: Array<string>): int {
  const p = Point { x: 1, y: 2 }
  const q = Point { x: 1, y: 3 }
  print(Show.show(p))
  print(order(Ordered.compare(p, q)))
  print(order(Ordered.compare(q, p)))
  print(order(Ordered.compare(p, Point { x: 1, y: 2 })))
  const shapes: Array<Shape> = [Shape.Dot(p), Shape.Line(p, q), Shape.Label("hi"), Shape.Empty]
  print(Show.show(shapes))
  print(order(Ordered.compare(Shape.Dot(q), Shape.Line(p, p))))
  print(order(Ordered.compare(Shape.Label("b"), Shape.Label("a"))))
  const scene = Scene { name: "main", shapes: shapes, focus: Some(q) }
  print(Show.show(scene))
  const none: Option<Point> = None
  print(Show.show(none))
  const pair = Pair { first: "k", second: 7 }
  print(Show.show(pair))
  print(order(Ordered.compare(pair, Pair { first: "k", second: 8 })))
  const tree = Tree { label: "root", kids: [Tree { label: "leaf", kids: [] }] }
  print(Show.show(tree))
  const r: Result<int, string> = Err("bad")
  print(Show.show(r))

  // Equality on nested structs and enums.
  if (p == Point { x: 1, y: 2 }) {
    print("p equal")
  }
  if (p != q) {
    print("p q differ")
  }
  const scene2 = Scene { name: "main", shapes: [Shape.Dot(p), Shape.Line(p, q), Shape.Label("hi"), Shape.Empty], focus: Some(q) }
  if (scene == scene2) {
    print("scenes equal")
  }
  const scene3 = Scene { name: "main", shapes: [Shape.Dot(p), Shape.Line(q, p), Shape.Label("hi"), Shape.Empty], focus: Some(q) }
  if (scene != scene3) {
    print("scenes differ")
  }
  if (Shape.Line(p, q) == Shape.Line(p, q) && Shape.Label("a") != Shape.Label("b") && Shape.Empty == Shape.Empty) {
    print("enums compare")
  }
  if (Some(p) != None && tree == tree) {
    print("options compare")
  }
  const a = Plain { id: 1, tags: ["x", "y"] }
  const b = Plain { id: 1, tags: ["x", "y"] }
  if (a == b && Hashable.hash(a) == Hashable.hash(b)) {
    print("automatic equality and hash")
  }
  if ([[1, 2], [3]] == [[1, 2], [3]]) {
    print("arrays equal")
  }
  print(Int.toString(Arrays.length(shapes)))
  return 0
}
