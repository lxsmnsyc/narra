import * as Int from "std/int"

function multiply(a: Array<int>, b: Array<int>, n: int): Array<int> {
  let c = Array.filled(0, n * n)
  for (const i of Range.upTo(n)) {
    for (const j of Range.upTo(n)) {
      let sum = 0
      for (const k of Range.upTo(n)) {
        sum = sum + a[i * n + k] * b[k * n + j]
      }
      c[i * n + j] = sum
    }
  }
  return c
}

export function run(args: Array<string>): int {
  const n = 600
  let a = Array.filled(0, n * n)
  let b = Array.filled(0, n * n)
  for (const i of Range.upTo(n)) {
    for (const j of Range.upTo(n)) {
      a[i * n + j] = (i + j) % 10
      b[i * n + j] = (i * j) % 10
    }
  }
  const c = multiply(a, b, n)
  let total = 0
  for (const x of Array.values(c)) {
    total = total + x
  }
  print(Int.toString(total))
  return 0
}
