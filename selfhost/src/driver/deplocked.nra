// The test-only command `narrac pkg --locked <dir>`: loads a package the way the language service
// does, from narra.lock and the cache with no fetch and no lock write, and prints the package in
// the format of `narrac pkg`.
import * as Fs from "std/fs"
import * as Modules from "narrac/driver/modules"

export function runLockedCommand(arguments: Array<string>): int uses io, alloc {
  let cache = Modules.createParseCache()
  const loaded = Modules.loadCached(arguments[3], Map {}, mutable cache)
  if (loaded is Err(errors)) {
    const _ = Fs.writeText("/dev/stderr", Modules.errorText(errors))
    return 1
  }
  const written = Fs.writeText("/dev/stdout", Modules.dump(loaded.value))
  if (written is Err(_)) {
    return 1
  }
  return 0
}
