// error: cannot use == on Shared<int>
import * as Shared from "std/shared"
import * as Atomic from "std/atomic"

export function run(_args: Array<string>): int {
  const left = Shared.create(1)
  const right = Shared.create(1)
  const count = Atomic.create(1)
  const other = Atomic.create(1)
  if (left == right || count != other) {
    return 1
  }
  const _byShared: Map<Shared.Shared<int>, int> = Map {}
  return 0
}
