import { numbered, lastOr } from "app/util/list"

export enum Token {
  Word(text: string)
  Number(value: int)
  Space
}

export struct Span {
  start: int
  end: int
}

// Private, and the same name as a function in app/util/list.
function label(t: Token): string {
  return match (t) {
    Word(text) => `word ${text}`
    Number(n) => `number ${numbered(n)}`
    Space => "space"
  }
}

export function show(t: Token): string uses alloc {
  return label(t)
}

export function width(s: Span): int {
  return s.end - s.start
}

export function lastWord(words: Array<string>): string {
  return lastOr(words, "none")
}
