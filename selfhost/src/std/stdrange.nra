// The registry rows, checks of std/range.
import { StdFunc } from "narrac/std/builtins"
import { Type } from "narrac/check/types"
import { Checker, Walker, reportError, getExpressionPos } from "narrac/check/check"
import { findTypedConstant } from "narrac/check/operands"
import { Pos, Arg } from "narrac/syntax/ast"
import { checkArgumentCount, checkArgumentAgainst } from "narrac/std/stdcheckhelp"

export const RANGE_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Range.between",
    module: "std/range",
    key: "between",
    check: "checkRangeBetween",
    signature: "(start: int, end: int): Range",
  },
  StdFunc {
    name: "Range.stepped",
    module: "std/range",
    key: "stepped",
    check: "checkRangeStepped",
    signature: "(start: int, end: int, step: int): Range",
  },
  StdFunc {
    name: "Range.upTo",
    module: "std/range",
    key: "upTo",
    check: "checkRangeUpTo",
    signature: "(count: int): Range",
  },
]

function checkRangeUpTo<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
  }
  return Type.TRange
}

function checkRangeBetween<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 2)) {
    checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, arguments[1].value, Type.TInt)
  }
  return Type.TRange
}

function checkRangeStepped<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (checkArgumentCount(mutable checker, walker, pos, arguments, name, 3)) {
    checkArgumentAgainst(mutable checker, walker, arguments[0].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, arguments[1].value, Type.TInt)
    checkArgumentAgainst(mutable checker, walker, arguments[2].value, Type.TInt)
    // A step that is zero at compile time never makes progress.
    if (findTypedConstant(checker, arguments[2].value, Type.TInt) is Some(step)) {
      if (step == 0) {
        reportError(
          mutable checker,
          getExpressionPos(arguments[2].value),
          "E1270",
          "the step of Ranges.stepped is 0, so the range is always empty; use a step other than 0",
        )
      }
    }
  }
  return Type.TRange
}

export function checkRangeCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
): Type uses alloc {
  if (kind == "checkRangeUpTo") {
    return checkRangeUpTo(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkRangeBetween") {
    return checkRangeBetween(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkRangeStepped") {
    return checkRangeStepped(mutable checker, walker, pos, arguments, name)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
}
