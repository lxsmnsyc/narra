import * as Cells from "std/cell"
import { Cell } from "std/cell"

export function run(args: Array<string>): int uses alloc {
  const first = Cells.create(0)
  const second = Cells.create(0)
  let keyed: Map<Cell<int>, int> = Map {}
  keyed[first] = 1
  if (first == second) {
    return 1
  }
  if (first != second) {
    return 2
  }
  return 0
}
