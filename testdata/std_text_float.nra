import * as Int from "std/int"
import * as Float from "std/float"

function showParse(text: string) uses io, alloc {
  match (Float.parse(text)) {
    Ok(value) => print(`parse [${text}] ok ${Float.toString(value)}`)
    Err(message) => print(`parse [${text}] error ${message}`)
  }
}

function showFixed(value: f64, digits: int) uses io, alloc {
  match (Float.toFixed(value, digits)) {
    Some(text) => print(`toFixed ${Int.toString(digits)} ${text}`)
    None => print(`toFixed ${Int.toString(digits)} none`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  showParse("3.25")
  showParse("-0.5")
  showParse("+7")
  showParse("1e3")
  showParse("2.5E-2")
  showParse(".5")
  showParse("5.")
  showParse("")
  showParse("-")
  showParse(".")
  showParse("1e")
  showParse("1e+")
  showParse(" 1")
  showParse("1 ")
  showParse("1.2.3")
  showParse("abc")
  showParse("inf")
  showParse("nan")
  showParse("0x10")
  showParse("1e999")
  showParse("0.1")
  showParse("123456789012345678901234567890")
  showFixed(2.0 / 3.0, 2)
  showFixed(2.5, 0)
  showFixed(3.5, 0)
  showFixed(1.005, 2)
  showFixed(0.125, 2)
  showFixed(-0.001, 2)
  showFixed(0.0, 3)
  showFixed(1234.5678, 1)
  showFixed(1e21, 2)
  showFixed(0.1, 20)
  showFixed(0.1, 21)
  showFixed(1.0, -1)
  showFixed(1.0 / 0.0, 2)
  showFixed(0.0 - 1.0 / 0.0, 2)
  showFixed(Float.sqrt(-1.0), 2)
  return 0
}
