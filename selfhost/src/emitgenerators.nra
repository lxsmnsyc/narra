// Generators in C, ported from emit_generator.go (SPEC section 8).
// A function* compiles to five C definitions, named from its function name
// (generatorPart):
//
// - The frame struct Y...: the header narra_gen (runtime.h), then one field
//   per C variable of the body: the parameters, every Narra local and every
//   temporary and loop counter. Nothing of the body lives in a C local
//   across a yield (declareVariable in emitstate.nra).
// - The resume function y...(narra_gen* h, void* out): a switch on the
//   state jumps to the label after the yield it stopped at. A yield writes
//   its value through out, sets the state and returns true. Ending the body
//   or a return releases what is live, sets the state to -1 and returns false.
// - The clone function j...: copies the frame and retains what is live at
//   its state. narra_gen_next calls it to resume a shared generator.
// - The drop function z...: releases what is live at its state and frees
//   the frame.
// - The function itself: it allocates the frame, stores and retains the
//   parameters, and runs nothing of the body.
//
// What is live at a state is what a return at that yield would release (the
// statement temporaries and scope locals of unwindAll), recorded per yield.
import * as Int from "std/int"
import * as Str from "std/string"
import { Expr, Block, Pos, FuncDecl, YieldBinding } from "narrac/ast"
import { Type } from "narrac/types"
import { getExpressionId } from "narrac/check"
import { cachedCType, generatorPart } from "narrac/cnames"
import {
  Emitter,
  EmitWalker,
  TempVar,
  writeLine,
  consume,
  beginStatement,
  endStatement,
  pushScope,
  popScope,
  addLocal,
  unwindAll,
  enterLoop,
  leaveLoop,
  emitContinueLabel,
  emitBreakLabel,
  readNodeType,
  readLocal,
  localRef,
  localName,
  isPointerParameter,
  retainCode,
  releaseCode,
  declareLocalVariable,
  declareLocal,
} from "narrac/emitstate"
import { declaredLocal } from "narrac/emitexprs"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export function emitGenerator<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  declaration: FuncDecl,
  block: Block,
  result: Type,
  signature: string,
  owner: string,
): string uses alloc {
  // The caller has started the function (startFunction); signature is its C
  // signature and owner its C name.
  const frame = generatorPart("Y", owner)
  const resume = generatorPart("y", owner)
  const clone = generatorPart("j", owner)
  const drop = generatorPart("z", owner)
  if (result is Type.TGenerator(element, _, _, _, _)) {
    emitter.generatorElement = element
  }
  emitter.inGenerator = true
  emitter.frameFields = []
  emitter.frameSeen = Map {}
  emitter.liveValues = []

  // The resume body, written first: it decides the frame fields. The frame
  // owns the parameters, so they are locals of the outer scope.
  emitter.indent = 1
  const parameterCount = Arrays.length(declaration.parameters)
  for (const index of Ranges.upTo(parameterCount)) {
    const _ = declareLocalVariable(mutable emitter, index)
    addLocal(mutable emitter, index)
  }
  recordLive(mutable emitter)
  EmitWalker.emitBlockInScope(walker, mutable emitter, block)
  emitGeneratorReturn(mutable emitter)
  const body = Str.build(emitter.out)
  emitter.out = Str.builder()
  emitter.inGenerator = false
  emitter.indent = 0

  // The frame and the resume function.
  let fields = Str.builder()
  for (const field of Arrays.values(emitter.frameFields)) {
    Str.append(mutable fields, ` ${field};`)
  }
  writeLine(
    mutable emitter,
    `typedef struct ${frame} { narra_gen h;${Str.build(fields)} } ${frame};`,
  )
  writeLine(mutable emitter, `static bool ${resume}(narra_gen* h, void* out) {`)
  writeLine(mutable emitter, `  ${frame}* f = (${frame}*)h;`)
  writeLine(mutable emitter, "  (void)out;")
  writeLine(mutable emitter, "  switch (f->h.state) {")
  writeLine(mutable emitter, "  case 0: break;")
  for (const state of Ranges.between(1, Arrays.length(emitter.liveValues))) {
    const number = Int.toString(state)
    writeLine(mutable emitter, `  case ${number}: goto narra_resume_${number};`)
  }
  writeLine(mutable emitter, "  default: return false;")
  writeLine(mutable emitter, "  }")
  Str.append(mutable emitter.out, body)
  writeLine(mutable emitter, "}")

  // Clone and drop.
  writeLine(mutable emitter, `static narra_gen* ${clone}(narra_gen* h) {`)
  writeLine(mutable emitter, `  ${frame}* f = narra_alloc(sizeof(${frame}));`)
  writeLine(mutable emitter, `  memcpy(f, h, sizeof(${frame}));`)
  writeLine(mutable emitter, "  f->h.rc = 1;")
  emitStateSwitch(mutable emitter, true)
  writeLine(mutable emitter, "  return &f->h;")
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, `static void ${drop}(void* p) {`)
  writeLine(mutable emitter, `  ${frame}* f = p;`)
  emitStateSwitch(mutable emitter, false)
  writeLine(mutable emitter, "  narra_free(f);")
  writeLine(mutable emitter, "}")

  // The function: a new frame that owns the parameters.
  writeLine(mutable emitter, `${signature} {`)
  writeLine(mutable emitter, `  ${frame}* f = narra_alloc(sizeof(${frame}));`)
  writeLine(mutable emitter, `  memset(f, 0, sizeof(${frame}));`)
  writeLine(mutable emitter, `  f->h = (narra_gen){1, 0, ${resume}, ${clone}, ${drop}};`)
  for (const index of Ranges.upTo(parameterCount)) {
    const local = copy(readLocal(emitter, index))
    const name = localName(local)
    // The frame copies a large parameter, since the caller's value may be gone
    // when the generator resumes.
    let value = name
    if (isPointerParameter(emitter, index)) {
      value = `*${name}`
    }
    writeLine(mutable emitter, `  f->${name} = ${value};`)
    const retainText = retainCode(emitter, local.localType, `f->${name}`)
    if (retainText != "") {
      writeLine(mutable emitter, `  ${retainText}`)
    }
  }
  writeLine(mutable emitter, "  return &f->h;")
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, "")
  const text = Str.build(emitter.out)
  emitter.out = Str.builder()
  return text
}

function emitStateSwitch(mutable emitter: Emitter, retaining: bool) uses alloc {
  // States with nothing live have no case.
  writeLine(mutable emitter, "  switch (f->h.state) {")
  for (const state of Ranges.upTo(Arrays.length(emitter.liveValues))) {
    let statements: Array<string> = []
    for (const value of Arrays.values(emitter.liveValues[state])) {
      let text = releaseCode(emitter, value.tempType, value.name)
      if (retaining) {
        text = retainCode(emitter, value.tempType, value.name)
      }
      if (text != "") {
        Arrays.push(mutable statements, text)
      }
    }
    if (Arrays.length(statements) > 0) {
      writeLine(
        mutable emitter,
        `  case ${Int.toString(state)}: ${Str.join(statements, " ")} break;`,
      )
    }
  }
  writeLine(mutable emitter, "  default: break;")
  writeLine(mutable emitter, "  }")
}

function recordLive(mutable emitter: Emitter) uses alloc {
  // The list is in the order unwindAll releases it.
  let live: Array<TempVar> = []
  for (let frame = Arrays.length(emitter.frames) - 1; frame >= 0; frame--) {
    const temporaries = emitter.frames[frame]
    for (let index = Arrays.length(temporaries) - 1; index >= 0; index--) {
      Arrays.push(mutable live, temporaries[index])
    }
  }
  for (let scope = Arrays.length(emitter.scopes) - 1; scope >= 0; scope--) {
    const locals = emitter.scopes[scope].locals
    for (let index = Arrays.length(locals) - 1; index >= 0; index--) {
      const local = readLocal(emitter, locals[index])
      Arrays.push(mutable live, TempVar {
        name: localRef(emitter, locals[index]),
        tempType: local.localType,
      })
    }
    const held = emitter.scopes[scope].held
    for (let heldIndex = Arrays.length(held) - 1; heldIndex >= 0; heldIndex--) {
      Arrays.push(mutable live, held[heldIndex])
    }
  }
  // A value held at a yield must be a frame field: a C local does not
  // survive the return, and clone and drop cannot name it.
  for (const value of Arrays.values(live)) {
    if (!Str.startsWith(value.name, "f->")) {
      panic(`internal error: ${value.name} is held at a yield but is not a frame field`)
    }
  }
  Arrays.push(mutable emitter.liveValues, live)
}

export function emitGeneratorReturn(mutable emitter: Emitter) uses alloc {
  unwindAll(mutable emitter)
  writeLine(mutable emitter, "f->h.state = -1;")
  writeLine(mutable emitter, "return false;")
}

function suspend(mutable emitter: Emitter) uses alloc {
  const number = Int.toString(Arrays.length(emitter.liveValues))
  recordLive(mutable emitter)
  writeLine(mutable emitter, `f->h.state = ${number};`)
  writeLine(mutable emitter, "return true;")
  writeLine(mutable emitter, `narra_resume_${number}:;`)
}

export function emitYield<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  value: Expr,
  delegate: bool,
  binding: Option<YieldBinding>,
) uses alloc {
  beginStatement(mutable emitter)
  const valueType = copy(readNodeType(emitter, getExpressionId(value)))
  const code = EmitWalker.emitExpression(walker, mutable emitter, value)
  const consumed = consume(mutable emitter, code.text, code.owned, valueType)
  if (!delegate) {
    // The caller of resume owns the value.
    const elementName = cachedCType(emitter.checker, emitter.typeNames, emitter.generatorElement)
    writeLine(mutable emitter, `*(${elementName}*)out = ${consumed};`)
    endStatement(mutable emitter)
    suspend(mutable emitter)
    if (binding is Some(bound)) {
      // The input of the resume that continued the coroutine: the caller of
      // resume owns it, so the local gets its own reference.
      beginStatement(mutable emitter)
      const localIndex = declaredLocal(emitter, bound.id)
      const local = emitter.checker.bodies[emitter.body].locals[localIndex]
      const inputName = cachedCType(emitter.checker, emitter.typeNames, local.localType)
      const input = consume(mutable emitter, `(*(${inputName}*)f->h.in)`, false, local.localType)
      declareLocal(mutable emitter, localIndex, input)
      endStatement(mutable emitter)
      addLocal(mutable emitter, localIndex)
    }
    return
  }
  // yield* resumes its own copy of other and passes each value on.
  const top = Arrays.length(emitter.frames) - 1
  Arrays.push(mutable emitter.frames[top], TempVar { name: consumed, tempType: valueType })
  writeLine(mutable emitter, `while (narra_gen_next(&${consumed}, out)) {`)
  emitter.indent++
  suspend(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  endStatement(mutable emitter)
}

export function emitGeneratorFor<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  label: string,
  iterable: Expr,
  body: Block,
) uses alloc {
  // The loop resumes its own copy of the generator until it finishes, and x
  // owns each value it gets. nodeId is the for statement's, which declares x.
  const generatorType = copy(readNodeType(emitter, getExpressionId(iterable)))
  const code = EmitWalker.emitExpression(walker, mutable emitter, iterable)
  const generator = consume(mutable emitter, code.text, code.owned, generatorType)
  const top = Arrays.length(emitter.frames) - 1
  Arrays.push(mutable emitter.frames[top], TempVar { name: generator, tempType: generatorType })
  writeLine(mutable emitter, "while (1) {")
  emitter.indent++
  const localIndex = declaredLocal(emitter, nodeId)
  const declaration = declareLocalVariable(mutable emitter, localIndex)
  if (!emitter.inGenerator) {
    writeLine(mutable emitter, `${declaration};`)
  }
  const variable = localRef(emitter, localIndex)
  writeLine(mutable emitter, `if (!narra_gen_next(&${generator}, &${variable})) break;`)
  enterLoop(mutable emitter, label, pos)
  pushScope(mutable emitter, true)
  addLocal(mutable emitter, localIndex)
  EmitWalker.emitBlockInScope(walker, mutable emitter, body)
  popScope(mutable emitter)
  emitContinueLabel(mutable emitter)
  const info = leaveLoop(mutable emitter)
  emitter.indent--
  writeLine(mutable emitter, "}")
  emitBreakLabel(mutable emitter, info)
}
