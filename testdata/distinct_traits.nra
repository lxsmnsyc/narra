// implements and derives on distinct types.
import * as Json from "std/json"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"
import { Shape } from "std/shape"

trait Label {
  function label(value: Self): string
}

distinct type UserId = int implements Label derives Ordered, Show
distinct type Slug = string derives Ordered, Show, Equatable
distinct type Code = int implements Show derives Shape
distinct type Tag = string derives Shape, Show

implement Label for UserId {
  function label(value: UserId): string {
    return `user-${Int.toString(UserId.toInt(value))}`
  }
}

implement Show for Code {
  function show(value: Code): string {
    return `code#${Int.toString(Code.toInt(value))}`
  }
}

function describe<T: Label>(value: T): string {
  return `<${Label.label(value)}>`
}

function render<T: Show>(value: T): string {
  return Show.show(value)
}

function sortAll<T: Ordered>(values: Array<T>): Array<T> {
  let sorted = copy(values)
  for (const i of Ranges.between(0, Arrays.length(sorted))) {
    for (const j of Ranges.between(0, Arrays.length(sorted) - 1 - i)) {
      if (Ordered.compare(sorted[j], sorted[j + 1]) == Ordering.Greater) {
        const held = sorted[j]
        sorted[j] = sorted[j + 1]
        sorted[j + 1] = held
      }
    }
  }
  return sorted
}

export function run(args: Array<string>): int {
  const first = UserId.from(7)
  const second = UserId.from(3)
  print(Show.show(first))
  print(Show.show(Slug.from("abc")))
  print(describe(first))
  print(Show.show(Ordered.compare(first, second)))
  print(Show.show(Ordered.compare(Slug.from("a"), Slug.from("b"))))

  // Sorting through a generic function.
  const ids = sortAll([UserId.from(5), UserId.from(1), UserId.from(3)])
  for (const id of Arrays.values(ids)) {
    print(Show.show(id))
  }

  // A user Show is used directly and through a type parameter.
  print(Show.show(Code.from(4)))
  print(render(Code.from(4)))
  print(render(first))

  // Equality and map keys come from the base.
  print(Show.show(first == UserId.from(7)))
  print(Show.show(first != second))
  let names: Map<UserId, string> = Map {}
  names[first] = "seven"
  names[second] = "three"
  if (names[UserId.from(7)] is Some(found)) {
    print(found)
  }

  // Shape encodes the base value.
  print(Json.encode(Code.from(9)))
  print(Json.encode(Tag.from("x")))
  if (Json.decode<Code>("12") is Ok(decoded)) {
    print(Show.show(decoded))
  }
  if (Json.decode<Tag>("\"y\"") is Ok(tag)) {
    print(Show.show(tag))
  }
  if (Json.decode<Code>("\"no\"") is Err(message)) {
    print(message)
  }
  return 0
}
