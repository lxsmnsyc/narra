// error: closure_borrow_field_arg.nra:12:14: "holder" is assigned by a closure passed to this call
struct Holder {
  count: int
}

function use(count: int, f: () => void) {
  f()
}

export function run(args: Array<string>): int {
  let holder = Holder { count: 1 }
  use(holder.count, () => {
    holder.count = 2
  })
  return 0
}
