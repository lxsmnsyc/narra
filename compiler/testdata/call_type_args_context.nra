import * as Int from "std/int"

trait Make {
  function make(seed: int): Self
}

struct Dog implements Make {
  age: int
}

implement Make for Dog {
  function make(seed: int): Dog {
    return Dog { age: seed }
  }
}

function takes(dog: Dog): int {
  return dog.age
}

export function run(args: Array<string>): int {
  // The expected type fixes Self, so no type argument is needed.
  const a: Dog = Make.make(1)
  print(Int.toString(a.age))
  print(Int.toString(takes(Make.make(2))))
  print(Int.toString(takes(Make.make<Dog>(3))))
  return 0
}
