split /,/ "a,b,,c": ["a", "b", "", "c"]
split /\s*,\s*/ "a , b,c ,d": ["a", "b", "c", "d"]
split /,/ ",a,": ["", "a", ""]
split /,/ "": [""]
split /x*/ "abc": ["a", "b", "c"]
split /b*/ "abc": ["a", "c"]
split // "éa": ["é", "a"]
split /(-)/ "1-2-3": ["1", "2", "3"]
split /\d/ "a1b2c3": ["a", "b", "c", ""]
split /x*/ "": []
split /x/ "": [""]
