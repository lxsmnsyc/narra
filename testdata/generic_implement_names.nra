trait C {
  function f(value: Self): string
}

trait B_C {
  function f(value: Self): string
}

struct A_B<T> implements C {
  v: T
}

struct A<T> implements B_C {
  v: T
}

implement C for A_B<T> {
  function f(_value: Self): string {
    return "A_B as C"
  }
}

implement B_C for A<T> {
  function f(_value: Self): string {
    return "A as B_C"
  }
}

export function run(_args: Array<string>): int {
  print(C.f(A_B { v: 1 }))
  print(B_C.f(A { v: 1 }))
  return 0
}
