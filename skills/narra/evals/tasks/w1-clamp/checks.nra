import { clamp } from "task/math"
import * as Test from "std/test"

test "inside the range" {
  Test.eq(clamp(5, 0, 10), 5)
}

test "below the range" {
  Test.eq(clamp(-3, 0, 10), 0)
}

test "above the range" {
  Test.eq(clamp(99, 0, 10), 10)
}

test "on the edges" {
  Test.eq(clamp(0, 0, 10), 0)
  Test.eq(clamp(10, 0, 10), 10)
}
