// The registry rows and emitters of std/bytes. A bytes value is an lstr like a
// string, without the UTF-8 guarantee (runtime std_bytes.c).
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Pos, Arg } from "narrac/ast"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  writeLine,
  temp,
  ownedTemp,
  readNodeType,
} from "narrac/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  stringOut,
  arrayStruct,
  ioResult,
} from "narrac/stdemithelp"
import * as Arrays from "std/array"

export const BYTES_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Bytes.at",
    module: "std/bytes",
    key: "at",
    parameters: ["bytes", "int"],
    result: "u8",
  },
  StdFunc {
    name: "Bytes.concat",
    module: "std/bytes",
    key: "concat",
    parameters: ["bytes", "bytes"],
    result: "bytes",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Bytes.fromArray",
    module: "std/bytes",
    key: "fromArray",
    parameters: ["Array<u8>"],
    result: "bytes",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Bytes.fromString",
    module: "std/bytes",
    key: "fromString",
    parameters: ["string"],
    result: "bytes",
  },
  StdFunc {
    name: "Bytes.length",
    module: "std/bytes",
    key: "length",
    parameters: ["bytes"],
    result: "int",
  },
  StdFunc {
    name: "Bytes.slice",
    module: "std/bytes",
    key: "slice",
    parameters: ["bytes", "int", "int"],
    result: "bytes",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Bytes.toArray",
    module: "std/bytes",
    key: "toArray",
    parameters: ["bytes"],
    result: "Array<u8>",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Bytes.toString",
    module: "std/bytes",
    key: "toString",
    parameters: ["bytes"],
    result: "Result<string, string>",
    effects: ["alloc"],
    check: "fixed",
  },
]

const BYTES_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Bytes.at",
    call: "narra_bytes_at",
    withPos: true,
    owned: false,
    temporary: true,
  },
  FixedCall {
    name: "Bytes.concat",
    call: "lstr_concat",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Bytes.fromString",
    call: "narra_bytes_from_string",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Bytes.length",
    call: "narra_bytes_length",
    withPos: false,
    owned: false,
    temporary: false,
  },
  FixedCall {
    name: "Bytes.slice",
    call: "narra_bytes_slice",
    withPos: true,
    owned: true,
    temporary: false,
  },
]

function emitToString<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const data = argumentText(walker, mutable emitter, arguments, 0)
  const output = stringOut(mutable emitter)
  const bad = stringOut(mutable emitter)
  const success = temp(
    mutable emitter,
    Type.TBool,
    `narra_bytes_to_string(${data}, &${output}, &${bad})`,
  )
  // Ok shares the buffer; Err names the first bad byte.
  return ioResult(mutable emitter, resultType, success, output, bad)
}

function emitFromArray<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const value = argumentText(walker, mutable emitter, arguments, 0)
  const items = temp(mutable emitter, Type.TArray(Type.TU8), value)
  const callText = `narra_bytes_from_raw(${items}->items, ${items}->len)`
  return owned(ownedTemp(mutable emitter, resultType, callText))
}

function emitToArray<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const arrayType = readNodeType(emitter, nodeId)
  const value = argumentText(walker, mutable emitter, arguments, 0)
  const data = temp(mutable emitter, Type.TBytes, value)
  const structName = arrayStruct(emitter, arrayType)
  const array = ownedTemp(mutable emitter, arrayType, `${structName}_new(${data}->len)`)
  writeLine(
    mutable emitter,
    `if (${data}->len > 0) memcpy(${array}->items, ${data}->data, (size_t)${data}->len);`,
  )
  writeLine(mutable emitter, `${array}->len = ${data}->len;`)
  return owned(array)
}

export function emitBytesCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(BYTES_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Bytes.toString") {
    return emitToString(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Bytes.fromArray") {
    return emitFromArray(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Bytes.toArray") {
    return emitToArray(walker, mutable emitter, nodeId, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
