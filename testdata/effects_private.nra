import * as Int from "std/int"

// A private higher-order function is effect-polymorphic by inference.
function apply(f: (x: int) => int, v: int): int {
  return f(v)
}

function loud(x: int): int {
  print("loud")
  return x + 1
}

function quiet(x: int): int {
  return x + 2
}

export function pureUser(v: int): int {
  return apply(quiet, v)
}

export function ioUser(v: int): int uses io {
  return apply(loud, v)
}

export function run(args: Array<string>): int {
  print(`${Int.toString(pureUser(1) + ioUser(1))}`)
  return 0
}
