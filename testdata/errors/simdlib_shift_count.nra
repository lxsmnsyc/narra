// error: the shift count must be a constant from 0 to 31 or a name checked against both ends first
import * as Simd from "std/simd"

function shift(values: I32x4, count: int): I32x4 {
  return Simd.shiftLeft(values, count)
}

function shiftBytes(values: U8x16, count: int): U8x16 {
  // An unsigned lane does not prove an int count is not negative.
  if (count < 8) {
    return Simd.shiftRight(values, count)
  }
  return values
}

export function run(_args: Array<string>): int {
  const values: I32x4 = [1, 2, 3, 4]
  const far = Simd.shiftRight(values, 32)
  const bytes: U8x16 = Simd.splat(1)
  const wrapped = Simd.shiftLeft(bytes, 264)
  print(Show.show(shift(far, 1)))
  print(Show.show(shiftBytes(wrapped, 1)))
  return 0
}
