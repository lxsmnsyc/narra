// std/process: running programs with options. The rest of the functions are built into the compiler.

import * as Arrays from "std/array"
import * as Spawn from "std/internal/process"

/// Runs a program found through `PATH`, waits for it to end, and gives its exit code, standard output and
/// standard error. A program that cannot start, or a `folder` that does not exist, is an `Err`, and one
/// killed by a signal has the code 128 plus the signal. `input` is the text for the standard input, which
/// is closed with `None`. `environment` lists variables to set as name and value pairs, and a later pair
/// of a name wins. `removed` lists names the program does not get. `folder` is the working folder, with
/// `None` the one of this process. With `inheritOutput` the program writes to the output of this process,
/// in order with its own, and the captured text is empty. The input is written while the output is read,
/// so neither blocks the program. The program is looked up in the `PATH` the program gets, after
/// `removed` and `environment` apply; with no `PATH`, the system's default search decides. Every option
/// has a default and is named in the call: `run("cat", [], input: Some(text))`.
export function run(
  command: string,
  arguments: Array<string>,
  input: Option<string> = None,
  environment: Array<#[string, string]> = [],
  removed: Array<string> = [],
  folder: Option<string> = None,
  inheritOutput: bool = false,
): Result<#[int, string, string], string> uses io, alloc {
  // Each variable to set becomes one NAME=VALUE entry.
  let added: Array<string> = []
  for (const entry of Arrays.values(environment)) {
    const #[name, value] = entry
    Arrays.push(mutable added, `${name}=${value}`)
  }

  // The runtime takes the input and the folder as text, with a flag for the input.
  let hasInput = false
  let inputText = ""
  if (input is Some(text)) {
    hasInput = true
    inputText = text
  }
  let folderText = ""
  if (folder is Some(path)) {
    folderText = path
  }
  return Spawn.run(
    command,
    arguments,
    inputText,
    hasInput,
    added,
    removed,
    folderText,
    inheritOutput,
  )
}
