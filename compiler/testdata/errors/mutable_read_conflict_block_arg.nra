// error: mutable_read_conflict_block_arg.nra:12:14: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function bump(mutable n: int, other: int): int {
  n = 10
  return other
}

export function run(args: Array<string>): int {
  let x = 1
  const total = bump(
    mutable x,
    {
      return x
    },
  )
  return total
}
