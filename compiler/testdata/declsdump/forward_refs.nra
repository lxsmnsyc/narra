function use(a: Later, b: LaterGen<Later>): LaterEnum {
  return LaterEnum.X
}
struct First {
  second: Second
  gen: LaterGen<Second>
}
struct Second {
  value: int
}
enum LaterEnum {
  X
  Y(s: Second)
}
struct Later {
  first: First
}
struct LaterGen<T> {
  item: T
  list: Array<T>
}
const LIMIT: LaterGen<int> = LaterGen { item: 1, list: [] }
