// A lazy struct and a lazy Map.
import * as Lazies from "std/lazy"
import * as Maps from "std/map"
import * as Int from "std/int"

struct Settings {
  name: string
  sizes: Array<int>
}

function buildSettings(): Settings uses alloc {
  return Settings { name: "wide", sizes: [10, 20, 30] }
}

function buildIndex(): Map<string, int> uses alloc {
  let index: Map<string, int> = Map {}
  index["one"] = 1
  index["two"] = 2
  return index
}

const settings = lazy buildSettings()
const index = lazy buildIndex()

export function run(args: Array<string>): int uses io, alloc {
  print(Lazies.force(settings).name)
  print(Int.toString(Lazies.force(settings).sizes[1]))
  print(Int.toString(Maps.size(Lazies.force(index))))
  if (Lazies.force(index)["two"] is Some(value)) {
    print(Int.toString(value))
  }
  return 0
}
