// The value of an async function shares the parameter its `from` names, as a
// plain function's result does, so a write to what `await` gave takes a
// copy(...) while the argument is still used.
import * as Arrays from "std/array"
import * as Int from "std/int"

async function keep(items: Array<int>): Array<int> from items {
  return items
}

async function fresh(count: int): Array<int> uses alloc {
  let made: Array<int> = []
  for (let i = 0; i < count; i++) {
    Arrays.push(mutable made, i)
  }
  return made
}

export async function run(_args: Array<string>): int {
  const items = [1, 2, 3]
  let got = copy(await keep(items))
  Arrays.push(mutable got, 4)
  print(`${Int.toString(Arrays.length(items))} ${Int.toString(Arrays.length(got))}`)
  let made = await fresh(2)
  Arrays.push(mutable made, 9)
  print(Int.toString(Arrays.length(made)))
  return 0
}
