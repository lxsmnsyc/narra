import * as Ptr from "std/ptr"

// lead: above the attribute
@trusted // trail: after the attribute
function first(items: Ptr<int>): int {
  let value = 0
  // lead: above the block
  unsafe {
    // open: after the brace
    value = Ptr.read(items) // trail: after the read
    // close: before the brace
  } // trail: after the block
  unsafe {}
  return value
}

trait Reader {
  function read(self: Self): int
}

struct Cursor implements Reader {
  data: Ptr<int>
}

implement Reader for Cursor {
  // lead: above the member attribute
  @trusted // trail: after the member attribute
  function read(self: Cursor): int {
    return first(self.data)
  }
}
