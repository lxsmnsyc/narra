import * as Time from "std/time"

export function run(args: Array<string>): int uses io, alloc {
  const start = Time.now()
  Time.sleep(Time.milliseconds(5))
  const spent = Time.elapsed(start)
  print(`elapsed >= 5ms: ${Show.show(Time.asMilliseconds(spent) >= 5)}`)
  print(`nanoseconds consistent: ${Show.show(Time.asNanoseconds(spent) >= 5000000)}`)
  const later = Time.now()
  print(`monotonic: ${Show.show(Time.asNanoseconds(Time.between(start, later)) >= 0)}`)
  print(`wall clock after 2020: ${Show.show(Time.unixMillis() > 1577836800000)}`)
  print(`seconds: ${Show.show(Time.asMilliseconds(Time.seconds(2)))}`)
  print(`milliseconds: ${Show.show(Time.asNanoseconds(Time.milliseconds(3)))}`)
  Time.sleep(Time.nanoseconds(0))
  return 0
}
