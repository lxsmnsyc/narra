// error: node.pos.line = ... may change node.pos, which p still uses at line 18
struct Pos {
  line: int
  column: int
}

struct Node {
  name: string
  pos: Pos
}

export function run(_args: Array<string>): int {
  let node = Node { name: "a", pos: Pos { line: 1, column: 2 } }
  // p is a value of its own in Narra, but a reference to node.pos in
  // TypeScript, so the write is an error while p is used later.
  const p = node.pos
  node.pos.line = 5
  return p.line + node.pos.line
}
