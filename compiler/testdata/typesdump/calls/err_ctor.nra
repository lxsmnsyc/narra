enum Shape {
  Circle(radius: int)
  Dot
}

enum Mark {
  Dot
  Cross
}

enum Solo {
  Lonely(count: int)
}

export function run(args: Array<string>): int {
  let radius = 1
  const lonely = Lonely(1)
  const dot = Dot
  const typed: Mark = Dot
  const circle = Shape.Circle(1, 2)
  const hexagon = Shape.Hexagon
  const moved = Shape.Circle(mutable radius)
  const wrong = Shape.Circle("x")
  const some = Some(1, 2)
  return 0
}
