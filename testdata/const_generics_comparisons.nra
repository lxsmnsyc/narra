// An integer between `<` and `>` reads as a type argument, so a comparison
// in call arguments that looks like one is written in parentheses.
function both(first: bool, second: bool): bool {
  return first && second
}

function within<const N: int>(low: int, high: int): bool {
  return both((low < N), N > (high))
}

export function run(_args: Array<string>): int {
  const a = 1
  const c = 2
  if (both((a < 3), 4 > (c))) {
    print("yes")
  }
  if (within<5>(1, 2)) {
    print("within")
  }
  if (!within<1>(3, 0)) {
    print("outside")
  }
  return 0
}
