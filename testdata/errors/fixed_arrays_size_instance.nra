// error: a generic instance makes a FixedArray larger than the limit
struct Holder<const N: int> {
  values: FixedArray<int, N>
}

struct Wrapper {
  holder: Holder<200000>
}

function fits(holder: Holder<131072>): int {
  return holder.values[131071]
}

export function run(_args: Array<string>): int {
  return 0
}
