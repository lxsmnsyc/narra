// A started thread has an 8 MiB stack, the size of the main thread's, so
// recursion 15000 frames deep runs there as it does on the main thread.
import * as Thread from "std/thread"
import * as Int from "std/int"

function depth(remaining: int): int {
  if (remaining == 0) {
    return 0
  }
  return 1 + depth(remaining - 1)
}

export function run(_args: Array<string>): int {
  const reached = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => depth(15000))
    return Thread.join(worker)
  })
  print(`depth ${Int.toString(reached)}`)
  return 0
}
