function loud(value: int): int {
  print("x")
  return value
}

export struct Plain {
  f: (value: int) => int
}
export function pure(p: Plain): int {
  return p.f(1)
}
export function caller(): int uses io {
  return pure(Plain { f: loud })
}

export function run(args: Array<string>): int {
  return 0
}
