// Async thread functions: the thread runs the task on its own event loop until
// it finishes, and join gives the awaited value. One thread sleeps, one echoes
// over a loopback socket, an async arrow leaves a task sleeping that the
// thread cancels at its end, and an Async<void> task gives a Thread<void>.
import * as Async from "std/async"
import * as Bytes from "std/bytes"
import * as Int from "std/int"
import * as Net from "std/net"
import * as Thread from "std/thread"
import * as Time from "std/time"

async function nap(milliseconds: int): int uses io, alloc {
  const slept = await Time.sleep(Time.milliseconds(milliseconds))
  if (slept is Err(_)) {
    return -1
  }
  return milliseconds
}

async function sleepTwice(): int uses io, alloc {
  return (await nap(5)) + (await nap(5))
}

async function echoOnce(): string uses io, alloc {
  const listener = Net.listen("127.0.0.1", 0)
  if (listener is Err(_)) {
    return "listen failed"
  }
  const port = Net.localPort(listener.value)
  const server = async {
    const accepted = await Net.accept(listener.value)
    if (accepted is Err(_)) {
      return 0
    }
    const data = await Net.read(accepted.value, 100)
    if (data is Err(_)) {
      return 0
    }
    const written = await Net.write(accepted.value, data.value)
    if (written is Err(_)) {
      return 0
    }
    return written.value
  }
  const connection = await Net.connect("127.0.0.1", port)
  if (connection is Err(_)) {
    return "connect failed"
  }
  const sent = await Net.write(connection.value, Bytes.fromString("ping"))
  if (sent is Err(_)) {
    return "write failed"
  }
  const reply = await Net.read(connection.value, 100)
  if (reply is Err(_)) {
    return "read failed"
  }
  const echoed = await server
  const text = Bytes.toString(reply.value)
  if (text is Ok(value)) {
    return `${value} ${Int.toString(echoed)}`
  }
  return "not text"
}

export function run(_args: Array<string>): int {
  const base = 3
  Thread.scope((scope) => {
    const sleeper = Thread.start(scope, sleepTwice)
    const echo = Thread.start(scope, echoOnce)
    const arrow = Thread.start(scope, async () => {
      const slept = await nap(2)
      // A task left sleeping when the thread function finishes is cancelled.
      Async.detach(nap(3600000))
      return slept + base
    })
    const quiet = Thread.start(scope, async () => {
      await Async.idle()
    })
    print(`slept ${Int.toString(Thread.join(sleeper))}`)
    print(`echo ${Thread.join(echo)}`)
    print(`arrow ${Int.toString(Thread.join(arrow))}`)
    Thread.join(quiet)
    print("quiet")
  })
  return 0
}
