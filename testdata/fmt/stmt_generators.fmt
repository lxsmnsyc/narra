// Counts up.
function* counter(limit: int): Generator<int> {
  let index = 0
  while (index < limit) {
    yield index // each value
    index = index + 1
  }
  /* done */
}

export function* lines(path: string): Generator<string> uses (io, alloc) {
  // leading
  yield "a"
  yield* other(path)
  yield* /* inner */ other(path)
  yield (1 + 2) * 3
  if (path == "") {
    yield* other(path) // delegate
  }
  // trailing
}

export function* both(): Generator<int> {
  yield* counter(2)

  yield* counter(3)
}

function* pass<effect E>(source: Generator<int> uses E): Generator<int> uses E {
  for (const value of source) {
    yield value
  }
}
