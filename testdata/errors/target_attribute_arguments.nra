// error: target_attribute_arguments.nra:5:14: Os of std/build has no variant Plan9
import { Os, Arch } from "std/build"

// Each attribute is wrong in its own way; none of them depends on the host.
@target(os = Os.Plan9)
function unknownVariant(): int {
  return 1
}

@target(cpu = Arch.Arm64)
function unknownName(): int {
  return 2
}

@target(os = Arch.Arm64)
function wrongEnum(): int {
  return 3
}

@target(os = Os.Linux, os = Os.MacOS)
function repeatedName(): int {
  return 4
}

@target()
function nothingNamed(): int {
  return 5
}

export function run(args: Array<string>): int {
  return unknownVariant() + unknownName() + wrongEnum() + repeatedName() + nothingNamed()
}
