// error: requires compares integer parameters with integer constants or with each other, joined by && and ||; compare two parameters with no arithmetic; + and - wrap
function span(low: int, high: int): int
  requires low + 1 <= high
{
  return high - low
}

function same(value: int): int
  requires value < value
{
  return value
}

function gap(x: int, y: int): int
  requires x - y >= 0
{
  return x - y
}

export function run(_args: Array<string>): int {
  return span(1, 3) + same(1) + gap(3, 1)
}
