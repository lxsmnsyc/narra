import * as Math from "std/math"
import * as Float from "std/float"
import * as Int from "std/int"
import * as Options from "std/option"

function show(label: string, value: f64) uses alloc {
  print(`${label} ${Float.toString(value)}`)
}

function showInt(label: string, value: int) uses alloc {
  print(`${label} ${Int.toString(value)}`)
}

export function run(args: Array<string>): int uses io, alloc {
  showInt("abs", Math.abs(-7))
  show("absFloat", Math.absFloat(-2.5))
  showInt("min", Math.min(3, 9))
  showInt("max", Math.max(3, 9))
  show("minFloat", Math.min(1.5, -0.5))
  show("maxFloat", Math.max(1.5, -0.5))
  showInt("clamp low", Options.withDefault(Math.clamp(-5, 0, 10), 0))
  showInt("clamp high", Options.withDefault(Math.clamp(50, 0, 10), 0))
  showInt("clamp inside", Options.withDefault(Math.clamp(4, 0, 10), 0))
  show("clampFloat", Options.withDefault(Math.clamp(2.5, 0.0, 1.0), 0.0))
  show("pow", Math.pow(2.0, 10.0))
  showInt("powInt", Options.withDefault(Math.powInt(3, 13), 0))
  showInt("powInt zero", Options.withDefault(Math.powInt(5, 0), 0))
  show("sqrt", Math.sqrt(144.0))
  show("floor", Math.floor(-1.5))
  show("ceil", Math.ceil(-1.5))
  show("round", Math.round(2.5))
  show("round negative", Math.round(-2.5))
  show("trunc", Math.trunc(-1.9))
  show("sin 0", Math.sin(0.0))
  show("cos 0", Math.cos(0.0))
  show("tan 0", Math.tan(0.0))
  show("atan2", Math.round(Math.atan2(1.0, 1.0) * 1000000.0) / 1000000.0)
  show("exp 0", Math.exp(0.0))
  show("log 1", Math.log(1.0))
  show("pi", Math.round(Math.PI * 1000.0) / 1000.0)
  show("e", Math.round(Math.E * 1000.0) / 1000.0)
  show("sin pi/2", Math.sin(Math.PI / 2.0))
  return 0
}
