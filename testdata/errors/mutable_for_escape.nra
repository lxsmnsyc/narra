// error: loop element "player" is changed in place, so it cannot be returned or stored; copy it first with `const copy = player`
struct Player {
  hp: int
}

function first(mutable players: Array<Player>): Player {
  for (mutable player of players) {
    return player
  }
  return Player { hp: 0 }
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  return first(mutable players).hp
}
