// std/json and std/shape: round trips of every Value form, escapes and surrogate pairs.
import * as Json from "std/json"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import { Value } from "std/shape"

function roundTrip(text: string) uses io, alloc {
  const parsed = Json.parse(text)
  if (parsed is Ok(value)) {
    print(`${text} -> ${Json.stringify(value)}`)
  } else if (parsed is Err(message)) {
    print(`${text} -> error ${message}`)
  }
}

function kind(value: Value): string {
  return match (value) {
    Value.Null => "null"
    Value.Bool(_) => "bool"
    Value.Int(_) => "int"
    Value.Float(_) => "float"
    Value.Text(_) => "text"
    Value.List(_) => "list"
    Value.Record(_) => "record"
  }
}

function show(text: string) uses io, alloc {
  const parsed = Json.parse(text)
  if (parsed is Ok(value)) {
    print(`${text}: ${kind(value)}`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  // Every form.
  roundTrip("null")
  roundTrip("true")
  roundTrip("false")
  roundTrip("42")
  roundTrip("-7")
  roundTrip("2.5")
  roundTrip("\"text\"")
  roundTrip("[]")
  roundTrip("{}")
  roundTrip(" [1, [2, [3]], {\"a\": {\"b\": null}}] ")
  // Records keep insertion order; the last duplicate wins in the first place.
  roundTrip("{\"b\":1,\"a\":2,\"b\":3}")
  // Escapes and surrogate pairs.
  roundTrip("\"a\\\"b\\\\c\\/d\\n\\t\\r\\b\\f\"")
  roundTrip("\"\\u0041\\u00e9\\u20ac\"")
  roundTrip("\"\\ud83d\\ude00\"")
  roundTrip("\"caf\u{e9} \u{1f600}\"")
  roundTrip("\"\\u0001\\u001f\"")
  // Int versus Float.
  show("1")
  show("1.0")
  show("1e2")
  show("-0")
  show("9223372036854775807")
  show("9223372036854775808")
  show("-9223372036854775808")
  // Built by hand.
  let fields: Map<string, Value> = Map {}
  fields["list"] = Value.List([Value.Int(1), Value.Float(1.5), Value.Null])
  fields["text"] = Value.Text("a\"b")
  print(Json.stringify(Value.Record(fields)))
  print(Json.stringify(Value.Float(1.0)))
  print(Json.stringify(Value.Float(0.0 / 0.0)))
  print(Json.stringify(Value.Float(1.0 / 0.0)))
  return 0
}
