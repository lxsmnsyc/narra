// Arrow functions, function values and captures.
import * as Int from "std/int"
import * as Arrays from "std/array"

struct Button {
  label: string
  onClick: (times: int) => string
}

function map<T, U>(items: Array<T>, f: (item: T) => U): Array<U> {
  let out: Array<U> = []
  for (const item of Arrays.values(items)) {
    Arrays.push(mutable out, f(item))
  }
  return out
}

function forEach<T>(items: Array<T>, f: (item: T) => void) {
  for (const item of Arrays.values(items)) {
    f(item)
  }
}

function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

// A non-escaping parameter can be passed on to another non-escaping one.
function applyTwice(f: (x: int) => int, x: int): int {
  return apply(f, apply(f, x))
}

function double(x: int): int {
  return x * 2
}

function adder(n: int): (x: int) => int {
  return (x: int): int => x + n
}

function compose(escaping f: (x: int) => int, escaping g: (x: int) => int): (x: int) => int {
  return (x) => g(f(x))
}

function greeter(greeting: string, names: Array<string>): (i: int) => string {
  return (i) => `${greeting}, ${names[i]}`
}

function joinAll(items: Array<string>): string {
  let s = ""
  forEach(items, (x) => {
    print(x)
  })
  for (const x of Arrays.values(items)) {
    s = `${s}${x}`
  }
  return s
}

export function run(args: Array<string>): int {
  const prices = [1, 2, 3]
  const rate = 10
  const scaled = map(prices, (p) => p * rate)
  print(Int.toString(scaled[2]))
  const labels = map(prices, (p) => `#${Int.toString(p)}`)
  print(labels[0])

  // Capturing strings and arrays, on the stack and on the heap.
  const prefix = "item"
  const extra = ["a", "b"]
  forEach(labels, (l) => print(`${prefix} ${l} ${extra[1]}`))
  const hello = greeter("hello", ["ana", "bo"])
  print(hello(1))

  // Named functions as values, and closures that escape.
  print(Int.toString(apply(double, 21)))
  print(Int.toString(applyTwice((x) => x + rate, 1)))
  const add5 = adder(5)
  print(Int.toString(add5(1)))
  print(Int.toString(adder(7)(1)))
  const both = compose(add5, double)
  print(Int.toString(both(1)))
  const id = (x: int): int => {
    if (x < 0) {
      return 0
    }
    return x
  }
  print(Int.toString(id(-3)))

  // A closure in a struct field and in an array.
  const b = Button { label: "ok", onClick: (t) => `${prefix} clicked ${Int.toString(t)}` }
  print(b.onClick(3))
  let handlers: Array<(x: int) => int> = [add5, double]
  Arrays.push(mutable handlers, adder(100))
  for (const h of Arrays.values(handlers)) {
    print(Int.toString(h(1)))
  }
  print(joinAll(["x", "y"]))
  return 0
}
