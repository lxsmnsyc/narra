// error: the rest of a FixedArray<int, 3> pattern cannot have a name, since its length would be N minus the elements before it; write `..._` and index the array
function tail(values: FixedArray<int, 3>): int {
  return match (values) { [_, ...rest] => 0 }
}

export function run(_args: Array<string>): int {
  return tail([1, 2, 3])
}
