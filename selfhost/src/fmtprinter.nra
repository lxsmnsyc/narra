// How the statement printer (fmt.nra) and the expression printer (fmtexprs.nra)
// of `narrac fmt` call each other (contract fmt-printer). Narra modules cannot
// import each other in a cycle, and an arrow function body is a block while a
// statement holds expressions, so the two meet through the function fields of
// one Printer. The comment helpers below wrap a node's document with the
// comments that fmt-trivia attached to its anchor key.
import * as Docs from "narrac/fmtdoc"
import { Doc, Options } from "narrac/fmtdoc"
import {
  Trivia,
  Comment,
  CommentKind,
  Placement,
  Attached,
  getIdKey,
  getExprId,
} from "narrac/trivia"
import { Pos, Expr, Pattern, TypeExpr, Block } from "narrac/ast"
import * as Str from "std/string"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Maps from "std/map"

export struct Settings {
  options: Options
  trailingComma: bool // true for "all"
}

export struct Printer {
  source: string
  trivia: Trivia
  settings: Settings
  printExpression: (printer: Printer, expression: Expr) => Doc uses alloc
  printPattern: (printer: Printer, pattern: Pattern) => Doc uses alloc
  printType: (printer: Printer, type: TypeExpr) => Doc uses alloc
  printBlock: (printer: Printer, block: Block) => Doc uses alloc
  lineStarts: Array<int> // byte offset of each line
  commentStarts: Array<int> // byte offset of each comment's first character
  commentEnds: Array<int> // byte offset after each comment's last character
}

// ---- Source text

export function getOffset(source: string, pos: Pos): int {
  const length = Str.length(source)
  let offset = 0
  let line = 1
  while (line < pos.line && offset < length) {
    if (Str.byteAt(source, offset) == 10) {
      line++
    }
    offset++
  }
  // Lines count `\n`; columns count characters.
  for (let column = 1; column < pos.column && offset < length; column++) {
    offset = Str.nextChar(source, offset)
  }
  return offset
}

export function getLineStarts(source: string): Array<int> uses alloc {
  let starts: Array<int> = [0]
  for (const offset of Ranges.upTo(Str.length(source))) {
    if (Str.byteAt(source, offset) == 10) {
      Arrays.push(mutable starts, offset + 1)
    }
  }
  return starts
}

function getPositionOffset(source: string, lineStarts: Array<int>, pos: Pos): int {
  if (pos.line < 1 || pos.line > Arrays.length(lineStarts)) {
    return getOffset(source, pos)
  }
  const length = Str.length(source)
  let offset = lineStarts[pos.line - 1]
  for (let column = 1; column < pos.column && offset < length; column++) {
    offset = Str.nextChar(source, offset)
  }
  return offset
}

export function getCommentOffsets(
  source: string,
  lineStarts: Array<int>,
  comments: Array<Comment>,
  atEnd: bool,
): Array<int> uses alloc {
  let offsets: Array<int> = []
  for (const comment of Arrays.values(comments)) {
    if (atEnd) {
      Arrays.push(mutable offsets, getPositionOffset(source, lineStarts, comment.end))
    } else {
      Arrays.push(mutable offsets, getPositionOffset(source, lineStarts, comment.pos))
    }
  }
  return offsets
}

export function getPrinterOffset(printer: Printer, pos: Pos): int {
  return getPositionOffset(printer.source, printer.lineStarts, pos)
}

export function isNewlineAfter(source: string, offset: int): bool {
  const length = Str.length(source)
  for (let index = offset; index < length; index++) {
    const byte = Str.byteAt(source, index)
    if (byte == 10) {
      return true
    }
    if (byte != 32 && byte != 9 && byte != 13) {
      return false
    }
  }
  return true
}

function trimEnd(value: string): string uses alloc {
  let end = Str.length(value)
  while (end > 0) {
    const byte = Str.byteAt(value, end - 1)
    if (byte != 32 && byte != 9 && byte != 13 && byte != 10) {
      break
    }
    end--
  }
  return Str.slice(value, 0, end)
}

// ---- Expression positions

function getExpressionPosition(expression: Expr): Pos {
  return match (expression) {
    Expr.IntLit(_, pos, _)
      | Expr.FloatLit(_, pos, _)
      | Expr.StringLit(_, pos, _, _)
      | Expr.CharLit(_, pos, _)
      | Expr.BoolLit(_, pos, _)
      | Expr.TemplateLit(_, pos, _)
      | Expr.Ident(_, pos, _)
      | Expr.FieldExpr(_, pos, _, _)
      | Expr.IsExpr(_, pos, _, _)
      | Expr.IndexExpr(_, pos, _, _)
      | Expr.MapLit(_, pos, _, _, _)
      | Expr.CallExpr(_, pos, _, _, _)
      | Expr.UnaryExpr(_, pos, _, _)
      | Expr.BinaryExpr(_, pos, _, _, _)
      | Expr.StructLit(_, pos, _, _, _, _)
      | Expr.ArrayLit(_, pos, _, _)
      | Expr.MatchExpr(_, pos, _, _)
      | Expr.BlockExpr(_, pos, _)
      | Expr.ArrowExpr(_, pos, _, _, _, _) => pos
  }
}

function getLeftChild(expression: Expr): Option<Expr> {
  // The node's own position is an operator or a bracket for these, so the operand that comes first
  // in the source is the left child.
  return match (expression) {
    Expr.BinaryExpr(_, _, _, left, _) => Some(left)
    Expr.IsExpr(_, _, subject, _) => Some(subject)
    Expr.FieldExpr(_, _, target, _) => Some(target)
    Expr.CallExpr(_, _, callee, _, _) => Some(callee)
    Expr.IndexExpr(_, _, target, _) => Some(target)
    _ => None
  }
}

function isBalanced(source: string, start: int, end: int): bool {
  let depth = 0
  for (const offset of Ranges.between(start, end)) {
    const byte = Str.byteAt(source, offset)
    if (byte == 40) {
      depth++
    } else if (byte == 41) {
      depth--
      if (depth < 0) {
        return false
      }
    }
  }
  return depth == 0
}

function findFirstAtLeast(offsets: Array<int>, value: int): int {
  let low = 0
  let high = Arrays.length(offsets)
  while (low < high) {
    const middle = (low + high) / 2
    if (offsets[middle] < value) {
      low = middle + 1
    } else {
      high = middle
    }
  }
  return low
}

export function getCommentStartBefore(printer: Printer, end: int): int {
  const index = findFirstAtLeast(printer.commentEnds, end)
  if (index < Arrays.length(printer.commentEnds) && printer.commentEnds[index] == end) {
    return printer.commentStarts[index]
  }
  // No comment ends at the offset.
  return -1
}

function includeParentheses(printer: Printer, start: int, end: int): int uses alloc {
  const source = printer.source
  let candidates: Array<int> = []
  let index = start
  while (index > 0) {
    const byte = Str.byteAt(source, index - 1)
    const commentStart = getCommentStartBefore(printer, index)
    if (commentStart >= 0) {
      index = commentStart
    } else if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
      index--
    } else if (byte == 40) {
      index--
      Arrays.push(mutable candidates, index)
    } else {
      break
    }
  }
  for (const candidate of Arrays.values(candidates)) {
    if (isBalanced(source, candidate, end)) {
      return candidate
    }
  }
  return start
}

function getEndOffset(printer: Printer, key: string): Option<int> uses alloc {
  if (printer.trivia.ends[key] is Some(end)) {
    return Some(getPrinterOffset(printer, end))
  }
  return None
}

export function getStartOffset(printer: Printer, expression: Expr): int uses alloc {
  let spine: Array<Expr> = [expression]
  let current = expression
  while (true) {
    const next = getLeftChild(current)
    if (next is Some(child)) {
      Arrays.push(mutable spine, child)
      current = child
    } else {
      break
    }
  }
  let offset = getPrinterOffset(printer, getExpressionPosition(current))
  for (const step of Ranges.upTo(Arrays.length(spine))) {
    const node = spine[Arrays.length(spine) - 1 - step]
    const id = getExprId(node)
    if (printer.trivia.parenthesized[id] is Some(_)) {
      if (getEndOffset(printer, getIdKey(id)) is Some(end)) {
        offset = includeParentheses(printer, offset, end)
      }
    }
  }
  return offset
}

export function hasCommentInParens(printer: Printer, expression: Expr): bool uses alloc {
  const id = getExprId(expression)
  if (Arrays.length(printer.commentStarts) == 0 || printer.trivia.parenthesized[id] is None) {
    return false
  }
  if (getEndOffset(printer, getIdKey(id)) is Some(end)) {
    const start = getStartOffset(printer, expression)
    const index = findFirstAtLeast(printer.commentStarts, start)
    return index < Arrays.length(printer.commentStarts) && printer.commentStarts[index] < end
  }
  return false
}

// ---- Comments

function getAttached(printer: Printer, anchor: string): Array<Attached> {
  if (printer.trivia.attached[anchor] is Some(items)) {
    return items
  }
  return []
}

function hasBlank(printer: Printer, key: string): bool {
  if (printer.trivia.blankBefore[key] is Some(blank)) {
    return blank
  }
  return false
}

function getCommentKey(index: int): string uses alloc {
  return `c${Int.toString(index)}`
}

function getLeading(printer: Printer, anchor: string): Array<int> uses alloc {
  let indexes: Array<int> = []
  for (const attached of Arrays.values(getAttached(printer, anchor))) {
    if (attached.placement is Placement.Leading) {
      Arrays.push(mutable indexes, attached.comment)
    }
  }
  return indexes
}

export function getBlankKey(printer: Printer, anchor: string): string uses alloc {
  // The blank line sits before the first leading comment, or before the item itself without one.
  const leading = getLeading(printer, anchor)
  if (Arrays.length(leading) > 0) {
    return getCommentKey(leading[0])
  }
  return anchor
}

export function hasBlankBefore(printer: Printer, anchor: string): bool uses alloc {
  return hasBlank(printer, getBlankKey(printer, anchor))
}

export function hasDangling(printer: Printer, anchor: string): bool uses alloc {
  for (const attached of Arrays.values(getAttached(printer, anchor))) {
    if (attached.placement is Placement.Dangling) {
      return true
    }
  }
  return false
}

export function hasTrailing(printer: Printer, anchor: string): bool uses alloc {
  for (const attached of Arrays.values(getAttached(printer, anchor))) {
    if (attached.placement is Placement.Trailing) {
      return true
    }
  }
  return false
}

export function hasLeading(printer: Printer, anchor: string): bool uses alloc {
  return Arrays.length(getLeading(printer, anchor)) > 0
}

export function getLeadingBefore(
  printer: Printer,
  anchor: string,
  offset: int,
): Array<int> uses alloc {
  let indexes: Array<int> = []
  for (const index of Arrays.values(getLeading(printer, anchor))) {
    if (getOffset(printer.source, printer.trivia.comments[index].pos) < offset) {
      Arrays.push(mutable indexes, index)
    }
  }
  return indexes
}

export function removeComments(
  printer: Printer,
  anchor: string,
  removed: Array<int>,
): Printer uses alloc {
  let attached: Map<string, Array<Attached>> = Map {}
  for (const key of Arrays.values(Maps.keys(printer.trivia.attached))) {
    if (key == anchor) {
      let kept: Array<Attached> = []
      for (const item of Arrays.values(getAttached(printer, key))) {
        let isRemoved = false
        for (const index of Arrays.values(removed)) {
          if (index == item.comment) {
            isRemoved = true
          }
        }
        if (!isRemoved) {
          Arrays.push(mutable kept, item)
        }
      }
      attached[key] = kept
    } else {
      attached[key] = getAttached(printer, key)
    }
  }
  return Printer { ...printer, trivia: Trivia { ...printer.trivia, attached: attached } }
}

function printComment(comment: Comment): Doc uses alloc {
  return Docs.text(trimEnd(comment.text))
}

export function withComments(printer: Printer, anchor: string, document: Doc): Doc uses alloc {
  const attachedList = getAttached(printer, anchor)
  if (Arrays.length(attachedList) == 0) {
    return document
  }
  const leading = getLeading(printer, anchor)
  let parts: Array<Doc> = []
  // Leading comments, each on its own line unless a block comment shares the line with the node.
  for (const position of Ranges.upTo(Arrays.length(leading))) {
    const comment = printer.trivia.comments[leading[position]]
    Arrays.push(mutable parts, printComment(comment))
    let nextKey = anchor
    if (position + 1 < Arrays.length(leading)) {
      nextKey = getCommentKey(leading[position + 1])
    }
    const endOffset = getOffset(printer.source, comment.end)
    if (comment.kind is CommentKind.Block && !isNewlineAfter(printer.source, endOffset)) {
      Arrays.push(mutable parts, Docs.text(" "))
    } else {
      Arrays.push(mutable parts, Doc.HardLine)
      if (hasBlank(printer, nextKey)) {
        Arrays.push(mutable parts, Doc.HardLine)
      }
    }
  }
  Arrays.push(mutable parts, document)
  // Trailing comments: a line comment waits for the end of the line.
  for (const attached of Arrays.values(attachedList)) {
    if (!(attached.placement is Placement.Trailing)) {
      continue
    }
    const comment = printer.trivia.comments[attached.comment]
    if (comment.ownLine) {
      let lines: Array<Doc> = [Doc.HardLine]
      if (hasBlank(printer, getCommentKey(attached.comment))) {
        Arrays.push(mutable lines, Doc.HardLine)
      }
      Arrays.push(mutable lines, printComment(comment))
      Arrays.push(mutable parts, Doc.LineSuffix(Docs.concat(lines)))
      Arrays.push(mutable parts, Doc.BreakParent)
    } else if (comment.kind is CommentKind.Block) {
      Arrays.push(mutable parts, Docs.text(" "))
      Arrays.push(mutable parts, printComment(comment))
    } else {
      Arrays.push(
        mutable parts,
        Doc.LineSuffix(Docs.concat([Docs.text(" "), printComment(comment)])),
      )
      Arrays.push(mutable parts, Doc.BreakParent)
    }
  }
  return Docs.concat(parts)
}

// Hoisted is a printer without the trailing comments of one anchor, and
// those comments as a suffix to put at the end of the line.
export struct Hoisted {
  printer: Printer
  inline: Doc // block comments, to print where the comment would end the line
  suffix: Doc // line comments, which wait for the end of the line
  count: int // comments taken
  hasLine: bool
}

export function hoistTrailingComments(printer: Printer, anchor: string): Hoisted uses alloc {
  // For a node that cannot break before its next part (the subject of `is`); the comments wait for
  // the end of the line.
  let taken: Array<int> = []
  let suffixes: Array<Doc> = []
  let inlines: Array<Doc> = []
  let hasLine = false
  for (const attached of Arrays.values(getAttached(printer, anchor))) {
    if (!(attached.placement is Placement.Trailing)) {
      continue
    }
    const comment = printer.trivia.comments[attached.comment]
    Arrays.push(mutable taken, attached.comment)
    if (comment.kind is CommentKind.Block) {
      Arrays.push(mutable inlines, Docs.concat([Docs.text(" "), printComment(comment)]))
      continue
    }
    hasLine = true
    if (comment.ownLine) {
      Arrays.push(
        mutable suffixes,
        Doc.LineSuffix(Docs.concat([Doc.HardLine, printComment(comment)])),
      )
    } else {
      Arrays.push(
        mutable suffixes,
        Doc.LineSuffix(Docs.concat([Docs.text(" "), printComment(comment)])),
      )
    }
  }
  if (Arrays.length(taken) == 0) {
    return Hoisted {
      printer: printer,
      inline: Docs.concat([]),
      suffix: Docs.concat([]),
      count: 0,
      hasLine: false,
    }
  }
  return Hoisted {
    printer: removeComments(printer, anchor, taken),
    inline: Docs.concat(inlines),
    suffix: Docs.concat(suffixes),
    count: Arrays.length(taken),
    hasLine: hasLine,
  }
}

export function printDangling(printer: Printer, anchor: string): Doc uses alloc {
  let parts: Array<Doc> = []
  let first = true
  for (const attached of Arrays.values(getAttached(printer, anchor))) {
    if (!(attached.placement is Placement.Dangling)) {
      continue
    }
    if (!first) {
      Arrays.push(mutable parts, Doc.HardLine)
      if (hasBlank(printer, getCommentKey(attached.comment))) {
        Arrays.push(mutable parts, Doc.HardLine)
      }
    }
    first = false
    const comment = printer.trivia.comments[attached.comment]
    Arrays.push(mutable parts, printComment(comment))
    if (!(comment.kind is CommentKind.Block)) {
      Arrays.push(mutable parts, Doc.BreakParent)
    }
  }
  return Docs.concat(parts)
}

export function printBracketed(open: string, document: Doc, close: string): Doc uses alloc {
  // The contents sit on lines of their own when they do not fit or hold a comment that ends its
  // line, so a comment stays inside its brackets instead of moving behind the closer.
  return Docs.group(
    Docs.concat([
      Docs.text(open),
      Docs.indent(Docs.concat([Doc.SoftLine, document])),
      Doc.SoftLine,
      Docs.text(close),
    ]),
  )
}

export function trailingComma(printer: Printer): Doc uses alloc {
  if (printer.settings.trailingComma) {
    return Doc.IfBreak(Docs.text(","), Docs.concat([]), -1)
  }
  return Docs.concat([])
}
