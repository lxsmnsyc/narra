import * as Int from "std/int"

// Nested tuples with the same flat element list are different types.

function a(): #[#[int, int, int], int] {
  return #[#[1, 2, 3], 4]
}

function b(): #[#[int, int], int, int] {
  return #[#[1, 2], 3, 4]
}

function left(): #[#[string, string], string] {
  return #[#["a", "b"], "c"]
}

function right(): #[string, #[string, string]] {
  return #["a", #["b", "c"]]
}

function flat(): #[string, string, string] {
  return #["a", "b", "c"]
}

export function run(args: Array<string>): int {
  const #[#[x1, x2, x3], x4] = a()
  const #[#[y1, y2], y3, y4] = b()
  print(Int.toString(x1 + x2 + x3 + x4))
  print(Int.toString(y1 + y2 + y3 + y4))
  print(Show.show(a()))
  print(Show.show(b()))
  const #[#[l1, l2], l3] = left()
  const #[r1, #[r2, r3]] = right()
  const #[f1, f2, f3] = flat()
  print(`${l1}${l2}${l3} ${r1}${r2}${r3} ${f1}${f2}${f3}`)
  print(Show.show(left()))
  print(Show.show(right()))
  print(Show.show(flat()))
  if (left() == #[#["a", "b"], "c"] && right() != #["a", #["b", "x"]]) {
    print("compared")
  }
  return 0
}
