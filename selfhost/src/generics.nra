// Generic templates, ported from check_types.go: type parameters (makeParameters,
// envOf), unification and the polymorphic-recursion check. Instantiation and
// substitution resolve field types, so they are in resolve.nra with
// resolveType (resolveType -> instantiate -> buildGeneric -> resolveFields
// -> resolveType is one cycle, and modules cannot import in a cycle).
//
// Go keys parameters by pointer (map[*TypeParamType]Type). Here every
// parameter is an index into Checker.parameters, and a substitution is a
// Map<int, Type> from that index.
import { Pos } from "narrac/ast"
import { Type, ParamInfo, GenericInfo, Field } from "narrac/types"
import { Checker, reportError, containsTypeParameter, typeString } from "narrac/check"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// makeParameters makes fresh type parameters for one declaration.
export function makeParameters(mutable checker: Checker, names: Array<string>): Array<int> uses alloc {
  let out: Array<int> = []
  for (const name of Arrays.values(names)) {
    Arrays.push(mutable out, Arrays.length(checker.parameters))
    Arrays.push(mutable checker.parameters, ParamInfo { name: name })
  }
  return out
}

// makeEnv maps each parameter's name to the parameter itself, so a template is
// resolved with its parameters left open.
export function makeEnv(checker: Checker, parameters: Array<int>): Map<string, Type> uses alloc {
  let environment: Map<string, Type> = Map {}
  for (const param of Arrays.values(parameters)) {
    environment[checker.parameters[param].name] = Type.TParam(param)
  }
  return environment
}

// envWith maps each parameter's name to a type argument (Go's envOf with
// arguments), for checking an instance of a generic function.
export function envWith(checker: Checker, parameters: Array<int>, arguments: Array<Type>): Map<string, Type> uses alloc {
  let environment: Map<string, Type> = Map {}
  for (const index of Ranges.between(0, Arrays.length(parameters))) {
    environment[checker.parameters[parameters[index]].name] = arguments[index]
  }
  return environment
}

// unify matches a type that holds parameters against a concrete type and
// records what each parameter must be. A parameter keeps its first match,
// and void never matches.
export function unify(checker: Checker, pattern: Type, actual: Type, mutable bindings: Map<int, Type>) uses alloc {
  match (pattern) {
    Type.TParam(param) => {
      if (bindings[param] is None && actual != Type.TVoid) {
        bindings[param] = actual
      }
    }
    Type.TArray(patternElement) => {
      if (actual is Type.TArray(actualElement)) {
        unify(checker, patternElement, actualElement, mutable bindings)
      }
    }
    Type.TBox(patternElement) => {
      if (actual is Type.TBox(actualElement)) {
        unify(checker, patternElement, actualElement, mutable bindings)
      }
    }
    Type.TMap(patternKey, patternValue) => {
      if (actual is Type.TMap(actualKey, actualValue)) {
        unify(checker, patternKey, actualKey, mutable bindings)
        unify(checker, patternValue, actualValue, mutable bindings)
      }
    }
    Type.TFunc(patternParams, patternResult) => {
      if (actual is Type.TFunc(actualParams, actualResult)) {
        if (Arrays.length(actualParams) == Arrays.length(patternParams)) {
          unifyAll(checker, patternParams, actualParams, mutable bindings)
          unify(checker, patternResult, actualResult, mutable bindings)
        }
      }
    }
    Type.TStruct(patternIndex) => {
      if (actual is Type.TStruct(actualIndex)) {
        const patternInfo = checker.structs[patternIndex]
        const actualInfo = checker.structs[actualIndex]
        if (actualInfo.name == patternInfo.name && actualInfo.module == patternInfo.module && Arrays.length(actualInfo.arguments) == Arrays.length(patternInfo.arguments)) {
          unifyAll(checker, patternInfo.arguments, actualInfo.arguments, mutable bindings)
        }
      }
    }
    Type.TEnum(patternIndex) => {
      if (actual is Type.TEnum(actualIndex)) {
        const patternInfo = checker.enums[patternIndex]
        const actualInfo = checker.enums[actualIndex]
        if (actualInfo.name == patternInfo.name && actualInfo.module == patternInfo.module && Arrays.length(actualInfo.arguments) == Arrays.length(patternInfo.arguments)) {
          unifyAll(checker, patternInfo.arguments, actualInfo.arguments, mutable bindings)
        }
      }
    }
    _ => {}
  }
}

function unifyAll(checker: Checker, patterns: Array<Type>, actuals: Array<Type>, mutable bindings: Map<int, Type>) uses alloc {
  for (const index of Ranges.between(0, Arrays.length(patterns))) {
    unify(checker, patterns[index], actuals[index], mutable bindings)
  }
}

// A reference from one generic template to a generic type (or to itself),
// with the instance it names. grow: some argument holds a type parameter
// without being one.
struct GenericEdge {
  target: int // Checker.generics
  instance: Type
  grow: bool
}

// templateEdges lists the generic types a type refers to, at any depth.
function templateEdges(checker: Checker, type: Type, mutable out: Array<GenericEdge>) uses alloc {
  match (type) {
    Type.TArray(element) => templateEdges(checker, element, mutable out)
    Type.TBox(element) => templateEdges(checker, element, mutable out)
    Type.TMap(key, value) => {
      templateEdges(checker, key, mutable out)
      templateEdges(checker, value, mutable out)
    }
    Type.TFunc(parameters, result) => {
      for (const parameter of Arrays.values(parameters)) {
        templateEdges(checker, parameter, mutable out)
      }
      templateEdges(checker, result, mutable out)
    }
    Type.TStruct(index) => {
      const structInfo = checker.structs[index]
      if (Arrays.length(structInfo.arguments) > 0) {
        if (!structInfo.tuple) {
          Arrays.push(mutable out, GenericEdge { target: structInfo.generic, instance: type, grow: growsArgs(checker, structInfo.arguments) })
        }
        for (const argument of Arrays.values(structInfo.arguments)) {
          templateEdges(checker, argument, mutable out)
        }
      }
    }
    Type.TEnum(index) => {
      const enumInfo = checker.enums[index]
      if (Arrays.length(enumInfo.arguments) > 0) {
        Arrays.push(mutable out, GenericEdge { target: enumInfo.generic, instance: type, grow: growsArgs(checker, enumInfo.arguments) })
        for (const argument of Arrays.values(enumInfo.arguments)) {
          templateEdges(checker, argument, mutable out)
        }
      }
    }
    _ => {}
  }
}

function growsArgs(checker: Checker, arguments: Array<Type>): bool {
  for (const argument of Arrays.values(arguments)) {
    if (!(argument is Type.TParam(_)) && containsTypeParameter(checker, argument)) {
      return true
    }
  }
  return false
}

function genericEdges(checker: Checker, generic: int): Array<GenericEdge> uses alloc {
  let out: Array<GenericEdge> = []
  const info = checker.generics[generic]
  for (const field of Arrays.values(info.fields)) {
    templateEdges(checker, field.fieldType, mutable out)
  }
  for (const variant of Arrays.values(info.variants)) {
    for (const field of Arrays.values(variant.fields)) {
      templateEdges(checker, field.fieldType, mutable out)
    }
  }
  return out
}

// checkPolyRecursion rejects a generic type that reaches itself, directly or
// through other generic types, with arguments that strictly hold its
// parameters, such as struct G<T> { next: Array<G<Array<T>>> }: every
// instance would need a larger one. Reaching itself with the same arguments
// (List<T> holding Array<List<T>>) is fine. On failure the template's fields
// are dropped, so no instance can grow forever.
export function checkPolyRecursion(mutable checker: Checker, generic: int) uses alloc {
  let seen: Map<string, bool> = Map {}
  const found = walkEdges(checker, generic, generic, false, None, mutable seen)
  if (found is None) {
    return
  }
  const info = checker.generics[generic]
  const culprit = typeString(checker, found.value)
  reportError(mutable checker, info.pos, `generic type ${info.name} contains ${culprit}, so each instance needs a larger one without end; every instance needs its own C type, so polymorphic recursion is not supported (use the same type arguments, or an enum or Box)`)
  checker.generics[generic].fields = []
  for (const index of Ranges.between(0, Arrays.length(info.variants))) {
    checker.generics[generic].variants[index].fields = []
  }
}

// walkEdges searches from the start template for a grown path back to the generic. It returns the
// first grown instance on that path.
function walkEdges(checker: Checker, generic: int, start: int, grew: bool, via: Option<Type>, mutable seen: Map<string, bool>): Option<Type> uses alloc {
  for (const edge of Arrays.values(genericEdges(checker, start))) {
    if (edge.target < 0) {
      continue
    }
    const nowGrew = grew || edge.grow
    let grownVia = via
    if (edge.grow && via is None) {
      grownVia = Some(edge.instance)
    }
    if (edge.target == generic && nowGrew) {
      return grownVia
    }
    const key = `${Show.show(edge.target)}|${Show.show(nowGrew)}`
    if (seen[key] is Some(_)) {
      continue
    }
    seen[key] = true
    const found = walkEdges(checker, generic, edge.target, nowGrew, grownVia, mutable seen)
    if (found is Some(_)) {
      return found
    }
  }
  return None
}
