// Block expressions: a block in value position gives its value with `return`.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

function lookup(code: int): string {
  if (code == 1) {
    return "one"
  }
  return ""
}

function twice(text: string): string {
  return `${text}${text}`
}

function label(code: int): string {
  // an initializer with an early return, a heap local and a nested block
  const result = {
    const name = lookup(code)
    if (name == "") {
      return "unknown"
    }
    const copy = twice(name)
    return copy
  }
  return result
}

// an argument and an operand
function sum(a: int, b: int): int {
  return a + b
}

// a loop with an early return inside the block expression
function firstOver(items: Array<int>, limit: int): int {
  const found = {
    for (const item of Arrays.values(items)) {
      if (item > limit) {
        return item
      }
    }
    return -1
  }
  return found
}

// heap locals in nested scopes released on every path
function heavy(n: int): string {
  return {
    const first = [n, n + 1]
    const text = `n=${Int.toString(n)}`
    if (n > 5) {
      const big = [n, n, n]
      return `${text}:${Int.toString(Arrays.length(big))}`
    }
    while (true) {
      const inner = twice(text)
      if (Arrays.length(first) == 2) {
        return inner
      }
    }
    return "never"
  }
}

// if as a value
function sign(n: int): string {
  return if (n < 0) {
    return "negative"
  } else if (n == 0) {
    return "zero"
  } else {
    return "positive"
  }
}

function pick(flag: bool): Array<int> {
  const items = if (flag) { return [1, 2, 3] } else { return [4] }
  return items
}

// a loop outside the block expression is fine while the block has its own
function loops(): int {
  let total = 0
  for (const i of Ranges.upTo(4)) {
    if (i == 1) {
      continue
    }
    total = total + {
      let part = 0
      for (const j of Ranges.upTo(10)) {
        if (j == 3) {
          break
        }
        part = part + j
      }
      return part + i
    }
  }
  return total
}

// a block expression inside an arrow body, and an arrow inside one
function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

function inArrow(base: int): int {
  return apply((x) => {
    const y = {
      const scaled = x * base
      return scaled + 1
    }
    return y
  }, 5)
}

function arrowInside(): int {
  return {
    const f = (x: int): int => x + 100
    return f(1)
  }
}

// a block expression in a template, an array and a struct field
struct Pair {
  left: int
  right: string
}

function parts(): string {
  const pair = Pair { left: { return 7 }, right: { return "r" } }
  const nums = [{ return 1 }, { return 2 }]
  return `${{ return Int.toString(pair.left) }}${pair.right}${Int.toString(nums[1])}`
}

// a match with return inside the block, and Option values
function describe(opt: Option<int>): string {
  return {
    match (opt) {
      Some(v) => {
        return `some ${Int.toString(v)}`
      }
      None => {
        return "none"
      }
    }
  }
}

export function run(args: Array<string>): int {
  print(label(1))
  print(label(2))
  print(Int.toString(sum({ return 2 }, { return 3 }) + { return 10 }))
  print(Int.toString(firstOver([1, 5, 9], 4)))
  print(Int.toString(firstOver([1, 2], 4)))
  print(heavy(3))
  print(heavy(8))
  print(sign(-4))
  print(sign(0))
  print(sign(9))
  print(Int.toString(Arrays.length(pick(true))))
  print(Int.toString(Arrays.length(pick(false))))
  print(Int.toString(loops()))
  print(Int.toString(inArrow(3)))
  print(Int.toString(arrowInside()))
  print(parts())
  print(describe(Some(4)))
  print(describe(None))
  print(Str.concat("a", { return "b" }))
  return 0
}
