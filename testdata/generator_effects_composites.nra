// Arrays, Options and tuples whose element types differ only in a generator's effects
// share one C type.
function* loud(): Generator<int> uses io {
  print("loud")
  yield 1
}

function* quiet(): Generator<int> {
  yield 2
}

function hold<T>(value: T): Array<T> from value uses alloc {
  return [value]
}

export function run(args: Array<string>): int uses io, alloc {
  const loudItems = [loud()]
  const quietItems = [quiet()]
  for (const value of loudItems[0]) {
    print(Show.show(value))
  }
  for (const value of quietItems[0]) {
    print(Show.show(value))
  }
  const heldLoud = hold(loud())
  const heldQuiet = hold(quiet())
  for (const value of heldLoud[0]) {
    print(Show.show(value))
  }
  for (const value of heldQuiet[0]) {
    print(Show.show(value))
  }
  const loudOption = Some(loud())
  const quietOption = Some(quiet())
  if (loudOption is Some(loudGenerator)) {
    for (const value of loudGenerator) {
      print(Show.show(value))
    }
  }
  if (quietOption is Some(quietGenerator)) {
    for (const value of quietGenerator) {
      print(Show.show(value))
    }
  }
  const loudPair = #[loud(), 3]
  const quietPair = #[quiet(), 4]
  const #[loudFirst, loudSecond] = loudPair
  const #[quietFirst, quietSecond] = quietPair
  for (const value of loudFirst) {
    print(Show.show(value + loudSecond))
  }
  for (const value of quietFirst) {
    print(Show.show(value + quietSecond))
  }
  const loudMaker: () => Generator<int> uses io = loud
  const quietMaker: () => Generator<int> = quiet
  const loudMakers = [loudMaker]
  const quietMakers = [quietMaker]
  for (const value of loudMakers[0]()) {
    print(Show.show(value))
  }
  for (const value of quietMakers[0]()) {
    print(Show.show(value))
  }
  return 0
}
