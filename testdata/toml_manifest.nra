// std/toml: this repo's selfhost/narra.toml form read into a struct with
// Toml.decode and a derived Shape, then written back with Toml.encode.
import * as Toml from "std/toml"

struct Package derives Shape, Show {
  name: string
}

struct Link derives Shape, Show {
  libraries: Array<string>
}

struct Binary derives Shape, Show {
  name: string
  entry: string
}

struct Manifest derives Shape, Show {
  package: Package
  link: Link
  binary: Array<Binary>
}

const MANIFEST = `# The Narra compiler written in Narra.
[package]
name = "narrac"

[link]
libraries = ["m"]

[[binary]]
name = "narrac"
entry = "main.run"

[[binary]]
name = "narrac-test"
entry = "tests.run"
`

export function run(_args: Array<string>): int {
  const manifest = Toml.decode<Manifest>(MANIFEST)
  if (manifest is Err(message)) {
    print(message)
    return 1
  }
  print(Show.show(manifest.value))
  const written = Toml.encode(manifest.value)
  if (written is Err(message)) {
    print(message)
    return 1
  }
  print(written.value)
  // A field of the wrong type is a D84 path error.
  const wrong = Toml.decode<Manifest>("[package]\nname = 1\n[link]\nlibraries = []\n")
  if (wrong is Err(message)) {
    print(message)
  }
  // A syntax error comes back as formatError writes it.
  const broken = Toml.decode<Manifest>("[package\n")
  if (broken is Err(message)) {
    print(message)
  }
  return 0
}
