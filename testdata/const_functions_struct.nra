// Struct and enum results of @const functions, with field defaults, tuples,
// options and a fixed array.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

struct Point derives Equatable {
  x: int
  y: int
  label: string = "point"
}

enum Shape {
  Circle(center: Point, radius: int)
  Square(corner: Point, side: int)
  Empty
}

@const
function makePoint(x: int, y: int): Point {
  return Point { x: x, y: y }
}

@const
function makeShapes(count: int): Array<Shape> uses alloc {
  let shapes: Array<Shape> = []
  for (let index = 0; index < count; index++) {
    if (index % 3 == 0) {
      Arrays.push(mutable shapes, Shape.Circle(makePoint(index, index * 2), index + 1))
    } else if (index % 3 == 1) {
      Arrays.push(mutable shapes, Shape.Square(makePoint(index, 0), 2))
    } else {
      Arrays.push(mutable shapes, Shape.Empty)
    }
  }
  return shapes
}

@const
function bounds(points: Array<Point>): #[Point, Point] {
  let low = copy(points[0])
  let high = copy(points[0])
  for (const point of points) {
    if (point.x < low.x) {
      low = { ...low, x: point.x }
    }
    if (point.y > high.y) {
      high.y = point.y
    }
  }
  return #[low, high]
}

@const
function findCorner(shapes: Array<Shape>): Option<Point> {
  for (const shape of shapes) {
    match (shape) {
      Shape.Square(corner, _) => {
        return Some(copy(corner))
      }
      _ => {}
    }
  }
  return None
}

@const
function grid(): FixedArray<int, 4> {
  let cells: FixedArray<int, 4> = [1, 2, 3, 4]
  cells[2] = cells[0] + cells[3]
  return cells
}

const ORIGIN = makePoint(0, 0)
const SHAPES = makeShapes(5)
const BOUNDS = bounds([makePoint(3, 1), makePoint(-2, 7), makePoint(5, 4)])
const CORNER = findCorner(SHAPES)
const GRID = grid()

function describeShape(shape: Shape): string uses alloc {
  return match (shape) {
    Shape.Circle(
      center,
      radius,
    ) => `circle ${Int.toString(center.x)},${Int.toString(center.y)} r${Int.toString(radius)}`
    Shape.Square(
      corner,
      side,
    ) => `square ${Int.toString(corner.x)},${Int.toString(corner.y)} s${Int.toString(side)}`
    Shape.Empty => "empty"
  }
}

function describeShapes(shapes: Array<Shape>): string uses alloc {
  let parts: Array<string> = []
  for (const shape of shapes) {
    Arrays.push(mutable parts, describeShape(shape))
  }
  return Str.join(parts, "; ")
}

function describeBounds(pair: #[Point, Point]): string uses alloc {
  const #[low, high] = pair
  return `${Int.toString(low.x)} ${Int.toString(high.y)} ${high.label}`
}

function describeCorner(corner: Option<Point>): string uses alloc {
  if (corner is Some(point)) {
    return `${Int.toString(point.x)},${Int.toString(point.y)}`
  }
  return "none"
}

export function run(args: Array<string>): int uses io, alloc {
  const five = 5
  const points = [makePoint(3, 1), makePoint(-2, 7), makePoint(5, 4)]
  print(`${ORIGIN.label} ${ORIGIN == makePoint(five - 5, 0) ? "equal" : "different"}`)
  print(describeShapes(SHAPES))
  print(describeShapes(makeShapes(five)))
  print(describeBounds(BOUNDS))
  print(describeBounds(bounds(points)))
  print(describeCorner(CORNER))
  print(describeCorner(findCorner(makeShapes(five))))
  print(`${Int.toString(GRID[2])} ${Int.toString(grid()[2])}`)
  return 0
}
