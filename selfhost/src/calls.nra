// Calls, ported from compiler/internal/narra: call and genericCall
// (check_call.go), traitCall (check_traits.go), distinctCall, distinctOf
// and unwrapName (check_opaque.go) and moduleCall (modules_check.go).
//
// This module sits above narrac/exprs: exprs reaches checkCall through
// Walker.checkCall (check.nra), which body.nra's BodyWalker implements, so
// this module can use the argument and builtin checks of exprs. What a call
// resolves to is recorded on the CallExpr: Ref.Function (a plain or generic
// function; an instance names its generic function), Ref.Builtin,
// Ref.Constructor, Ref.Implementation, Ref.TraitFunction or Ref.Distinct.
import { Pos, Expr, Arg, Decl, Param, FuncDecl } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Type } from "narrac/types"
import { Checker, Ref, Walker, reportError, typeString, setRef, setNodeType, getNodeType, findLocal, unsupported, getExpressionId, getExpressionPos, lookupTrait, containsTypeParameter, anyTypeParameter } from "narrac/check"
import { substitute } from "narrac/resolve"
import { unify } from "narrac/generics"
import { findTraitFunc, typeImplements, implFunc, checkBounds } from "narrac/traits"
import { sourceScope, exported } from "narrac/scopes"
import { checkValueCall, checkValueCallOf, checkGenericArguments } from "narrac/closures"
import { findModuleFunction } from "narrac/funcvalues"
import { checkExpression, expectType, checkArguments, checkArgumentsLoosely, checkBuiltinCall, findField, isEnumName, findModuleEnum, reportMissingImport, startsUpper, containsOpen } from "narrac/exprs"
import { checkConstructor } from "narrac/ctors"
import { addFuncInstance } from "narrac/instances"
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// checkCall checks a call (Go's call) and returns its type.
export function checkCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, callee: Expr, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  return match (callee) {
    Expr.Ident(_, calleePos, name) => checkNamedCall(mutable checker, walker, nodeId, pos, callee, calleePos, name, arguments, want)
    Expr.FieldExpr(calleeId, calleePos, target, name) => checkDottedCall(mutable checker, walker, nodeId, pos, callee, calleeId, calleePos, target, name, arguments, want)
    _ => checkValueCall(mutable checker, walker, nodeId, pos, callee, arguments)
  }
}

function checkNamedCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, callee: Expr, calleePos: Pos, name: string, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  // A local or constant holds a function value.
  const scope = checker.current
  if (findLocal(checker, name) >= 0 || checker.scopes[scope].consts[name] is Some(_)) {
    return checkValueCall(mutable checker, walker, nodeId, pos, callee, arguments)
  }

  // Then print, assert and panic, std functions imported by name, the
  // module's functions and the constructors.
  if (checker.registry.prelude[name] is Some(builtin)) {
    return checkBuiltinCall(mutable checker, walker, nodeId, pos, arguments, builtin, want)
  }
  if (checker.scopes[scope].imported[name] is Some(builtin)) {
    return checkBuiltinCall(mutable checker, walker, nodeId, pos, arguments, builtin, want)
  }
  if (checker.scopes[scope].functions[name] is Some(funcIndex)) {
    return checkFunctionCall(mutable checker, walker, nodeId, pos, funcIndex, arguments, want)
  }
  if (checkConstructor(mutable checker, walker, calleePos, "", name, arguments, want) is Some(result)) {
    if (result.enumIndex >= 0) {
      setRef(mutable checker, nodeId, Ref.Constructor(result.enumIndex, result.variant))
    }
    return result.constructorType
  }
  reportError(mutable checker, calleePos, `unknown function ${quoteGo(name)}`)
  checkArgumentsLoosely(mutable checker, walker, arguments)
  return Type.TVoid
}

// checkFunctionCall checks a call of a top-level function, generic or not.
function checkFunctionCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, funcIndex: int, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  if (Arrays.length(checker.functions[funcIndex].typeParameters) > 0) {
    return checkGenericCall(mutable checker, walker, nodeId, pos, funcIndex, arguments, want)
  }
  setRef(mutable checker, nodeId, Ref.Function(funcIndex))
  const parameters = checker.functions[funcIndex].declaration.parameters
  let wants: Array<Option<Type>> = []
  for (const param of Arrays.values(parameters)) {
    Arrays.push(mutable wants, Some(checker.paramTypes[param.id]))
  }
  checkArguments(mutable checker, walker, pos, arguments, parameters, wants)
  return checker.functions[funcIndex].result
}

function checkDottedCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, callee: Expr, calleeId: int, calleePos: Pos, target: Expr, name: string, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  // `Name.f(...)` where Name is not a local: a trait, a module alias, a
  // namespace, a distinct type, an enum or an unknown module.
  const scope = checker.current
  if (target is Expr.Ident(_, targetPos, alias)) {
    if (findLocal(checker, alias) < 0) {
      const traitIndex = lookupTrait(checker, alias)
      if (traitIndex >= 0) {
        return checkTraitCall(mutable checker, walker, nodeId, pos, traitIndex, name, arguments, want)
      }
      if (checker.scopes[scope].modules[alias] is Some(path)) {
        const moduleScope = sourceScope(checker, path)
        if (moduleScope >= 0) {
          return checkModuleCall(mutable checker, walker, nodeId, pos, callee, calleePos, moduleScope, name, arguments, want)
        }
        if (checker.registry.modules[path] is Some(module)) {
          if (module.functions[name] is Some(builtin)) {
            return checkBuiltinCall(mutable checker, walker, nodeId, pos, arguments, builtin, want)
          }
        }
        reportError(mutable checker, calleePos, `module ${quoteGo(path)} has no function ${quoteGo(name)}`)
        checkArgumentsLoosely(mutable checker, walker, arguments)
        return Type.TVoid
      }
      if (reportMissingImport(mutable checker, targetPos, alias, name)) {
        checkArgumentsLoosely(mutable checker, walker, arguments)
        return Type.TVoid
      }
      if (checker.scopes[scope].types[alias] is Some(Type.TDistinct(distinctIndex))) {
        return checkDistinctCall(mutable checker, walker, nodeId, pos, calleePos, distinctIndex, name, arguments)
      }
      if (isEnumName(checker, alias)) {
        return checkConstructorCall(mutable checker, walker, nodeId, calleePos, alias, name, arguments, want)
      }
      if (checker.scopes[scope].types[alias] is None && startsUpper(alias)) {
        reportError(mutable checker, targetPos, `unknown module ${quoteGo(alias)}; import it first, for example \`import * as ${alias} from "std/..."\``)
        checkArgumentsLoosely(mutable checker, walker, arguments)
        return Type.TVoid
      }
    }
  }
  const moduleEnum = findModuleEnum(mutable checker, target)
  if (moduleEnum != "") {
    return checkConstructorCall(mutable checker, walker, nodeId, calleePos, moduleEnum, name, arguments, want)
  }

  // Otherwise `value.f(...)` is a method call, which Narra does not have,
  // unless the field holds a function.
  const targetType = checkExpression(mutable checker, walker, target, None)
  if (targetType is Type.TStruct(index)) {
    const fieldIndex = findField(checker.structs[index].fields, name)
    if (fieldIndex >= 0) {
      const fieldType = checker.structs[index].fields[fieldIndex].fieldType
      if (fieldType is Type.TFunc(funcParams, funcResult)) {
        setNodeType(mutable checker, calleeId, fieldType)
        return checkValueCallOf(mutable checker, walker, nodeId, pos, callee, arguments, funcParams, funcResult)
      }
    }
  }
  const text = typeString(checker, targetType)
  reportError(mutable checker, calleePos, `there are no method calls; call a module function such as Module.${name}(value, ...) (value has type ${text})`)
  checkArgumentsLoosely(mutable checker, walker, arguments)
  return Type.TVoid
}

// checkConstructorCall checks `Enum.Variant(...)` and `Alias.Enum.Variant(...)`.
function checkConstructorCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, calleePos: Pos, enumName: string, name: string, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  if (checkConstructor(mutable checker, walker, calleePos, enumName, name, arguments, want) is Some(result)) {
    if (result.enumIndex >= 0) {
      setRef(mutable checker, nodeId, Ref.Constructor(result.enumIndex, result.variant))
    }
    return result.constructorType
  }
  return Type.TVoid
}

// checkModuleCall checks `Alias.f(...)` where Alias names a package module
// (Go's moduleCall).
function checkModuleCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, callee: Expr, calleePos: Pos, moduleScope: int, name: string, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  const found = exported(mutable checker, calleePos, moduleScope, name)
  if (found is Some(Decl.Const(_))) {
    return checkValueCall(mutable checker, walker, nodeId, pos, callee, arguments)
  }
  if (found is Some(Decl.Func(funcDecl))) {
    const funcIndex = findModuleFunction(checker, moduleScope, funcDecl)
    if (funcIndex >= 0) {
      return checkFunctionCall(mutable checker, walker, nodeId, pos, funcIndex, arguments, want)
    }
  }
  checkArgumentsLoosely(mutable checker, walker, arguments)
  return Type.TVoid
}

// getArgumentType is the type the current body gave an argument.
function getArgumentType(checker: Checker, arg: Arg): Type {
  if (getNodeType(checker, getExpressionId(arg.value)) is Some(argType)) {
    return argType
  }
  return Type.TVoid
}

// checkGenericCall infers the type arguments of a generic function from the
// expected type and the arguments, and finds or queues the instance (Go's
// genericCall). Inside a generic body the call can stay open; each instance
// resolves it again.
function checkGenericCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, funcIndex: int, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  const info = checker.functions[funcIndex]
  const typeParameters = info.typeParameters
  const parameters = info.declaration.parameters
  let bindings: Map<int, Type> = Map {}
  if (want is Some(wanted)) {
    unify(checker, info.result, wanted, mutable bindings)
  }

  // An argument whose parameter type is still open is checked without an
  // expected type; an arrow function argument gets a hint.
  checkGenericArguments(mutable checker, walker, pos, arguments, parameters, typeParameters, bindings)
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    if (index < Arrays.length(parameters)) {
      const argType = getArgumentType(checker, arguments[index])
      unify(checker, checker.paramTypes[parameters[index].id], argType, mutable bindings)
    }
  }

  // Every type parameter must be known and meet its bounds.
  let typeArguments: Array<Type> = []
  for (const param of Arrays.values(typeParameters)) {
    if (bindings[param] is Some(bound)) {
      Arrays.push(mutable typeArguments, bound)
    } else {
      const message = `cannot tell type parameter ${checker.parameters[param].name} of ${info.name} here; add a type annotation`
      reportError(mutable checker, pos, message)
      return Type.TVoid
    }
  }
  checkBounds(mutable checker, pos, info.declaration, typeParameters, typeArguments)
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    if (index < Arrays.length(parameters)) {
      const declared = checker.paramTypes[parameters[index].id]
      const paramType = substitute(mutable checker, declared, bindings)
      const argType = getArgumentType(checker, arguments[index])
      expectType(mutable checker, getExpressionPos(arguments[index].value), Some(paramType), argType)
    }
  }
  const result = substitute(mutable checker, info.result, bindings)
  setRef(mutable checker, nodeId, Ref.Function(funcIndex))
  if (!anyTypeParameter(checker, typeArguments)) {
    const instance = addFuncInstance(mutable checker, funcIndex, typeArguments)
    // The emitter finds the instance of this call through the body.
    checker.bodies[checker.body].instanceRefs[nodeId] = instance
  }
  return result
}

// checkTraitCall checks `Trait.function(arguments)` (Go's traitCall): the
// arguments tell which type's implementation runs.
function checkTraitCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, traitIndex: int, name: string, arguments: Array<Arg>, want: Option<Type>): Type uses alloc {
  const traitName = checker.traits[traitIndex].name
  const funcIndex = findTraitFunc(checker, traitIndex, name)
  if (funcIndex < 0) {
    reportError(mutable checker, pos, `trait ${traitName} has no function ${quoteGo(name)}`)
    checkArgumentsLoosely(mutable checker, walker, arguments)
    return Type.TVoid
  }
  const traitFunc = checker.traits[traitIndex].functions[funcIndex]
  const selfParameter = checker.traits[traitIndex].selfParameter
  const self = [selfParameter]
  let bindings: Map<int, Type> = Map {}
  if (want is Some(wanted)) {
    unify(checker, traitFunc.result, wanted, mutable bindings)
  }

  // Check the arguments, then find Self from them.
  let wants: Array<Option<Type>> = []
  for (const paramType of Arrays.values(traitFunc.parameters)) {
    const paramWant = substitute(mutable checker, paramType, bindings)
    if (containsOpen(checker, paramWant, self)) {
      Arrays.push(mutable wants, None)
    } else {
      Arrays.push(mutable wants, Some(paramWant))
    }
  }
  const parameters = traitFunc.declaration.parameters
  checkArguments(mutable checker, walker, pos, arguments, parameters, wants)
  const paramCount = Arrays.length(traitFunc.parameters)
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    if (index < paramCount) {
      const argType = getArgumentType(checker, arguments[index])
      unify(checker, traitFunc.parameters[index], argType, mutable bindings)
    }
  }
  let selfType = Type.TVoid
  if (bindings[selfParameter] is Some(bound)) {
    selfType = bound
  } else {
    reportError(mutable checker, pos, `cannot tell which type's ${traitName}.${name} to call here; add a type annotation`)
    return Type.TVoid
  }
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    if (index < paramCount) {
      const paramType = substitute(mutable checker, traitFunc.parameters[index], bindings)
      const argType = getArgumentType(checker, arguments[index])
      expectType(mutable checker, getExpressionPos(arguments[index].value), Some(paramType), argType)
    }
  }
  const result = substitute(mutable checker, traitFunc.result, bindings)

  // Self must implement the trait; a type parameter only through its bounds.
  if (!typeImplements(mutable checker, selfType, traitIndex)) {
    if (selfType is Type.TParam(param)) {
      const paramName = checker.parameters[param].name
      reportError(mutable checker, pos, `${traitName}.${name} needs ${paramName} to implement ${traitName}; declare it as <${paramName}: ${traitName}>`)
    } else {
      const message = `${typeString(checker, selfType)} does not implement ${traitName}`
      reportError(mutable checker, pos, message)
    }
    return result
  }
  if (containsTypeParameter(checker, selfType)) {
    return result
  }
  if (implFunc(checker, selfType, traitIndex, name) is Some(implementation)) {
    setRef(mutable checker, nodeId, Ref.Implementation(implementation.block, implementation.index))
  } else {
    setRef(mutable checker, nodeId, Ref.TraitFunction(traitIndex, name))
  }
  return result
}

// checkDistinctCall checks `T.from(x)` and `T.toInt(x)` on a distinct type
// (Go's distinctCall).
function checkDistinctCall<W: Walker>(mutable checker: Checker, walker: W, nodeId: int, pos: Pos, calleePos: Pos, distinctIndex: int, name: string, arguments: Array<Arg>): Type uses alloc {
  setRef(mutable checker, nodeId, Ref.Distinct(distinctIndex))
  const info = checker.distincts[distinctIndex]
  const distinctType = Type.TDistinct(distinctIndex)
  let base = Type.TVoid
  if (info.base is Some(declared)) {
    base = declared
  }
  const unwrap = findUnwrapName(checker, distinctIndex)

  // Only from and the unwrap function exist; from is private to the module
  // of an opaque type.
  const isFrom = name == "from"
  if (isFrom) {
    if (info.opaque && info.module != checker.scopes[checker.current].path) {
      reportError(mutable checker, calleePos, `${info.name}.from is not available outside module ${quoteGo(info.module)}: ${info.name} is an opaque distinct type`)
    }
  } else if (name != unwrap) {
    reportError(mutable checker, calleePos, `${info.name} has no function ${quoteGo(name)}; a distinct type has from and ${unwrap}`)
    checkArgumentsLoosely(mutable checker, walker, arguments)
    return Type.TVoid
  }
  if (Arrays.length(arguments) != 1) {
    reportError(mutable checker, pos, `${info.name}.${name} takes 1 arguments, found ${Int.toString(Arrays.length(arguments))}`)
    checkArgumentsLoosely(mutable checker, walker, arguments)
    return Type.TVoid
  }

  // from wraps a base value; the unwrap function unwraps a distinct one.
  const value = arguments[0].value
  const valuePos = getExpressionPos(value)
  if (isFrom) {
    const valueType = checkExpression(mutable checker, walker, value, Some(base))
    expectType(mutable checker, valuePos, Some(base), valueType)
    return distinctType
  }
  const valueType = checkExpression(mutable checker, walker, value, Some(distinctType))
  expectType(mutable checker, valuePos, Some(distinctType), valueType)
  return base
}

// findUnwrapName is the name of a distinct type's unwrap function: "to" and
// the underlying type's name capitalized, without type arguments (toInt,
// toString, toArray).
function findUnwrapName(checker: Checker, distinctIndex: int): string uses alloc {
  // Follow distinct bases to the underlying type.
  let underlying = Type.TDistinct(distinctIndex)
  let following = true
  while (following) {
    following = false
    if (underlying is Type.TDistinct(index)) {
      if (checker.distincts[index].base is Some(base)) {
        underlying = base
        following = true
      }
    }
  }
  let text = typeString(checker, underlying)
  if (Str.indexOf(text, "<") is Some(angle)) {
    text = Str.slice(text, 0, angle)
  }
  if (Str.length(text) == 0) {
    return "to"
  }
  let first = Str.charAt(text, 0)
  if (first >= 'a' && first <= 'z') {
    if (Char.fromCode(Char.code(first) - 32) is Some(upper)) {
      first = upper
    }
  }
  return `to${Str.fromChar(first)}${Str.sliceFrom(text, 1)}`
}
