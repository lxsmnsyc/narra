// `@target` functions used only where a build condition guarantees their
// target: each use is in a branch that the other targets drop, or in a
// `@target` function with the same or a narrower target. The output is the
// same on every host.
import * as Build from "std/build"
import { Os, Arch } from "std/build"

@target(os = Os.MacOS)
function macSeparator(): string {
  return "/"
}

@target(os = Os.Linux)
function linuxSeparator(): string {
  return "/"
}

@target(os = Os.Linux, arch = Arch.Arm64)
function linuxArmName(): string {
  return "arm64"
}

@target(os = Os.Linux, arch = Arch.X86_64)
function linuxIntelName(): string {
  return "x86_64"
}

// A narrower target may use a wider one.
@target(os = Build.Os.Linux, arch = Build.Arch.Arm64)
function describeLinuxArm(): string {
  return `${linuxArmName()}${linuxSeparator()}`
}

function findSeparator(): string {
  if (Build.os == Os.MacOS) {
    return macSeparator()
  } else if (Build.os == Os.Linux) {
    // A function value is a use too.
    const pick = linuxSeparator
    return pick()
  }
  return "\\"
}

function hasMachineName(): bool {
  if (Build.os == Os.Linux && Build.arch == Arch.Arm64) {
    return describeLinuxArm() != ""
  }
  if (!(Build.os != Os.Linux || Build.arch != Arch.X86_64)) {
    return linuxIntelName() != ""
  }
  return true
}

export function run(args: Array<string>): int {
  print(`separator: ${findSeparator()}`)
  if (hasMachineName()) {
    print("has a machine name")
  }
  return 0
}
