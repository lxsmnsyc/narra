import * as Arrays from "std/array"
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"

// Template strings decode the same escapes as plain strings. Each line
// prints the length and the character codes, so \r and \0 show.
function show(label: string, text: string) {
  let codes = ""
  for (const character of Arrays.values(Str.chars(text))) {
    codes = `${codes} ${Int.toString(Char.code(character))}`
  }
  print(`${label} ${Int.toString(Str.length(text))}:${codes}`)
}

export function run(args: Array<string>): int {
  const name = "x"
  show("n", `a\nb`)
  show("t", `a\tb`)
  show("r", `a\rb`)
  show("crlf", `\r\n`)
  show("zero", `a\0b`)
  show("backslash", `a\\b`)
  show("quote", `\"\'`)
  show("backtick", `\``)
  show("dollar", `\${name}`)
  show("unicode", `\u{41}\u{3bb}\u{1F600}`)
  show("mixed", `${name}\r${name}\0`)
  print(`\r\0\u{41}` == "\r\0\u{41}" ? "same as plain" : "differs from plain")
  return 0
}
