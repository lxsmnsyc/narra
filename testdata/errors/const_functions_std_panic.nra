// error: E1053, a panic after a std/char and std/result call
import * as Char from "std/char"
import * as Results from "std/result"

@const
function describe(code: int): string uses alloc {
  if (Char.fromCode(code) is None) {
    const failed: Result<string, string> = Err("no character")
    panic(Results.withDefault(failed, "failed"))
  }
  return "fine"
}

const NAME = describe(1114112)

export function run(args: Array<string>): int {
  return 0
}
