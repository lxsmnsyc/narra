// error: other_target.nra:16:25: linuxIntelName exists only on @target(os = Os.Linux, arch = Arch.X86_64), but this use is compiled for Linux-Arm64; ...
// The branch guarantees Linux but not X86_64. `narrac check` on a Linux-X86_64
// host passes; `narrac check --all-targets` finds the error on Linux-Arm64.
import * as Build from "std/build"
import { Os, Arch } from "std/build"

@target(os = Os.Linux, arch = Arch.X86_64)
function linuxIntelName(): string {
  return "x86_64"
}

export function run(args: Array<string>): int {
  if (Build.os == Os.MacOS) {
    print("macOS")
  } else if (Build.os == Os.Linux) {
    print(linuxIntelName())
  }
  return 0
}
