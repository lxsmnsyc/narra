const none = () => 1
const typed = (
  a: int,
  b: string,
): bool => a == b
const inferred = (a, b) => a + b
const longParameters = (
  firstParameter: int,
  secondParameter: string,
  third: bool,
) => 1
const longBody = (a) =>
  firstOperandName +
  secondOperandName +
  thirdOperandName +
  fourth
const block = (a: int) => {
  return a
}
const emptyBlock = () => {}
const returnsArrow = (a) => (b) => a + b
const structBody = (a) => Point {
  x: a,
  y: a,
}
const arrowOperand = ((a) => a) + 1
const callee = ((a) => a)(2)
