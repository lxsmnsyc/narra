// error: Function `quiet` uses `io` (through `log`) but its signature does not declare it; write `uses io`
import * as Str from "std/string"

export function log(parts: Array<string>, _values: Array<string>): int uses io, alloc {
  print(Str.join(parts, ""))
  return 0
}

export function quiet(): int uses alloc {
  return log`x`
}

export function run(_args: Array<string>): int {
  return quiet()
}
