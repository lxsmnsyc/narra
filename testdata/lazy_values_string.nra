// A lazy string built with a template, and a lazy value forced in a loop.
import * as Lazies from "std/lazy"
import * as Int from "std/int"
import * as Arrays from "std/array"

function buildGreeting(name: string): string uses alloc {
  return `hello ${name}, ${Int.toString(2 + 3)} times`
}

function buildSquares(count: int): Array<int> uses alloc {
  let result: Array<int> = []
  for (let index = 0; index < count; index++) {
    Arrays.push(mutable result, index * index)
  }
  return result
}

const greeting = lazy buildGreeting("narra")
const squares = lazy buildSquares(4)

export function run(args: Array<string>): int uses io, alloc {
  print(Lazies.force(greeting))
  let total = 0
  for (let round = 0; round < 3; round++) {
    for (const value of Lazies.force(squares)) {
      total += value
    }
  }
  print(Int.toString(total))
  print(Lazies.force(greeting))
  return 0
}
