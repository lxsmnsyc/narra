// The SPEC sample of Thread.scope: two threads sum the halves of one array,
// and the scope gives the total once both have finished.
import * as Thread from "std/thread"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"

function sum(numbers: Array<int>): int {
  let total = 0
  for (const number of Arrays.values(numbers)) {
    total += number
  }
  return total
}

function fill(low: int, high: int): Array<int> uses alloc {
  let numbers: Array<int> = []
  for (const number of Ranges.between(low, high)) {
    Arrays.push(mutable numbers, number)
  }
  return numbers
}

export function run(_args: Array<string>): int {
  const firstHalf = fill(0, 50000)
  const secondHalf = fill(50000, 100000)
  const total = Thread.scope((scope) => {
    const left = Thread.start(scope, () => sum(firstHalf))
    const right = Thread.start(scope, () => sum(secondHalf))
    return Thread.join(left) + Thread.join(right)
  })
  print(`total ${Int.toString(total)}`)
  return 0
}
