<script>
  import { $signal } from 'brumate/signals';

  // From bench/BASELINE.md (end of batch-16, median of 9 runs, macOS arm64) and from default
  // release builds of a hello world program on the same machine.
  const LANGUAGES = [
    { id: 'narra', label: 'Narra' },
    { id: 'go', label: 'Go' },
    { id: 'rust', label: 'Rust' },
  ];

  const SPEED = [
    { name: 'fib', values: [0.111, 0.129, 0.113] },
    { name: 'sieve', values: [0.132, 0.144, 0.133] },
    { name: 'matmul', values: [0.106, 0.205, 0.119] },
    { name: 'strings', values: [0.218, 0.299, 0.358] },
    { name: 'interp', values: [0.186, 0.252, 0.172] },
    { name: 'particles', values: [0.067, 0.076, 0.094] },
    { name: 'dot', values: [0.034, 0.138, 0.059] },
  ];

  const SIZE = [{ name: 'hello world', values: [34056, 2429714, 469176] }];

  let metric = $signal('speed');

  function formatSeconds(value: number): string {
    return `${value.toFixed(3)} s`;
  }

  function formatBytes(value: number): string {
    if (value >= 1_000_000) {
      return `${(value / 1_000_000).toFixed(1)} MB`;
    }
    return `${Math.round(value / 1000)} KB`;
  }

  function findMax(rows: { values: number[] }[]): number {
    let max = 0;
    for (const row of rows) {
      for (const value of row.values) {
        max = Math.max(max, value);
      }
    }
    return max;
  }

  const SPEED_MAX = findMax(SPEED);
  const SIZE_MAX = findMax(SIZE);
</script>

<figure class="bench">
  <div class="bench-top">
    <div class="bench-metrics" role="radiogroup" aria-label="Measure">
      <button type="button" role="radio" class="bench-metric" aria-checked=(metric === 'speed' ? 'true' : 'false') onClick=(() => (metric = 'speed'))>Run time</button>
      <button type="button" role="radio" class="bench-metric" aria-checked=(metric === 'size' ? 'true' : 'false') onClick=(() => (metric = 'size'))>Binary size</button>
    </div>
    <ul class="bench-legend">
      #for (language of LANGUAGES by language.id) {
        <li><span class=(`bench-swatch ${language.id}`)></span>{language.label}</li>
      }
    </ul>
  </div>
  <div class="bench-stack">
    <div class="bench-chart" aria-hidden=(metric === 'speed' ? 'false' : 'true')>
      #for (row of SPEED by row.name) {
        <div class="bench-row">
          <span class="bench-name">{row.name}</span>
          <div class="bench-bars">
            #for (value, index of row.values by index) {
              <div class="bench-bar" tabindex="0" data-value=(`${LANGUAGES[index]!.label} ${formatSeconds(value)}`) style=(`--scale: ${value / SPEED_MAX}`)>
                <span class=(`bench-fill ${LANGUAGES[index]!.id}`)></span>
                #if (index === 0) {
                  <span class="bench-value">{formatSeconds(value)}</span>
                }
              </div>
            }
          </div>
        </div>
      }
    </div>
    <div class="bench-chart" aria-hidden=(metric === 'size' ? 'false' : 'true')>
      #for (row of SIZE by row.name) {
        <div class="bench-row tall">
          <span class="bench-name">{row.name}</span>
          <div class="bench-bars">
            #for (value, index of row.values by index) {
              <div class="bench-bar" tabindex="0" data-value=(`${LANGUAGES[index]!.label} ${formatBytes(value)}`) style=(`--scale: ${Math.max(value / SIZE_MAX, 0.006)}`)>
                <span class=(`bench-fill ${LANGUAGES[index]!.id}`)></span>
                <span class="bench-value">{formatBytes(value)}</span>
              </div>
            }
          </div>
        </div>
      }
      <p class="bench-note">A program that prints one line, built with each compiler's default release settings.</p>
    </div>
  </div>
  <figcaption class="bench-caption">
    #if (metric === 'speed') {
      Seconds, lower is better. Median of 9 runs on an Apple M2. <a href="https://github.com/lxsmnsyc/narra/tree/main/bench">The programs</a>
    } #else {
      Bytes on disk, smaller is better. macOS arm64.
    }
  </figcaption>
</figure>
