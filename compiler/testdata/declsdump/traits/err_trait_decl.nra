trait Bad {
  function none(): int
  function generic<T>(v: Self, t: T): int
  function dup(v: Self): int
  function dup(v: Self): int
}

struct Gen<T> implements Bad {
  v: T
}

implement Bad for Rectangle {
}

struct NotListed {
  n: int
}

implement Bad for NotListed {
}

struct Lone implements Bad {
  n: int
}

implement Bad for Lone {
  function dup<T>(v: Lone): int {
    return 1
  }
  function none(): int {
    return 1
  }
}

const Bad = 1
