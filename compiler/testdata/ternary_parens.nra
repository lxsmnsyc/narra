// A parenthesized first branch is a value, not an arrow function header, and
// a ternary that spans lines is wrapped in parentheses.
import * as Int from "std/int"

function pick(flag: bool, a: int, b: int): int {
  return flag ? (a + b) : 0
}

function single(flag: bool, a: int, b: int): int {
  return flag ? (a) : b
}

function double(flag: bool, a: int, b: int): int {
  return flag ? (a) : b
}

function apply(flag: bool, n: int): int {
  const increment = (x: int): int => x + 1
  const chosen = flag ? (x: int): int => x * 10 : increment
  return chosen(n)
}

// The Prettier layout: `?` and `:` start the lines.
function layout(score: int): string {
  const text = (score >= 90 ? "high" : score >= 50 ? "pass" : "fail")
  return text
}

function nested(a: bool, b: bool): int {
  return (a ? (b ? 1 : 2) : (b ? 3 : 4))
}

export function run(args: Array<string>): int {
  print(Int.toString(pick(true, 2, 3)))
  print(Int.toString(pick(false, 2, 3)))
  print(Int.toString(single(true, 7, 8)))
  print(Int.toString(double(false, 7, 8)))
  print(Int.toString(apply(true, 4)))
  print(Int.toString(apply(false, 4)))
  print(layout(95))
  print(layout(60))
  print(layout(10))
  print(Int.toString(nested(true, true)))
  print(Int.toString(nested(true, false)))
  print(Int.toString(nested(false, true)))
  print(Int.toString(nested(false, false)))
  return 0
}
