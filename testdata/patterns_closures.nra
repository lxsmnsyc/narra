import * as Int from "std/int"
import * as Arrays from "std/array"

// Patterns over values that hold closures: each binding retains the
// closure's environment, and the subject keeps its own reference.

struct Handler {
  name: string
  run: (x: int) => int
}

enum Action {
  Apply(f: (x: int) => int, label: string)
  Skip
}

function adder(n: int): (x: int) => int {
  const tag = `add ${Int.toString(n)}`
  return (x: int): int => {
    if (tag == "") {
      return 0
    }
    return x + n
  }
}

function pair(n: int): #[(x: int) => int, string] {
  return #[adder(n), `pair ${Int.toString(n)}`]
}

function perform(a: Action, v: int): string {
  return match (a) {
    Action.Apply(f, "double") => `double ${Int.toString(f(v))}`
    Action.Apply(f, label) if (f(v) > 10) => `${label} big ${Int.toString(f(v))}`
    Action.Apply(f, label) => `${label} ${Int.toString(f(v))}`
    Action.Skip => "skip"
  }
}

export function run(args: Array<string>): int {
  const #[f, label] = pair(3)
  print(`${label}: ${Int.toString(f(4))}`)

  const h = Handler { name: "inc", run: adder(1) }
  const { name, run: go } = h
  print(`${name} ${Int.toString(go(1))} ${Int.toString(h.run(2))}`)

  const renamed = { ...h, name: "renamed" }
  const { run: again } = renamed
  print(`${renamed.name} ${Int.toString(again(5))}`)

  const swapped = { ...h, run: adder(100) }
  print(`${swapped.name} ${Int.toString(swapped.run(1))} ${Int.toString(h.run(1))}`)

  const doubler = (x: int): int => x * 2
  print(perform(Action.Apply(doubler, "double"), 4))
  print(perform(Action.Apply(adder(20), "add"), 1))
  print(perform(Action.Apply(adder(2), "add"), 1))
  print(perform(Action.Skip, 1))

  const actions = [#[adder(1), 1], #[adder(2), 2]]
  for (const t of Arrays.values(actions)) {
    match (t) {
      #[g, 1] => print(`one ${Int.toString(g(10))}`)
      #[g, n] => {
        const captured = (y: int): int => g(y) + n
        print(`other ${Int.toString(captured(10))}`)
      }
    }
  }

  const maybe: Option<#[(x: int) => int, string]> = Some(pair(5))
  if (maybe is Some(#[k, s])) {
    print(`${s} ${Int.toString(k(1))}`)
  }
  return 0
}
