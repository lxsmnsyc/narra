// error: await is allowed only in an async function, an async arrow or an async block, not in a function* body
async function one(): int {
  return 1
}

function* numbers(): Generator<int> uses alloc {
  yield await one()
}

export function run(_args: Array<string>): int {
  for (const value of numbers()) {
    return value
  }
  return 0
}
