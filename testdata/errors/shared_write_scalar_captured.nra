// error: moved.line = ... may change moved, which read still uses at line 13
struct Pos {
  line: int
  column: int
}

export function run(_args: Array<string>): int {
  const origin = Pos { line: 1, column: 2 }
  // The arrow function keeps the value of origin it captured.
  const read = (): int => origin.line
  let moved = origin
  moved.line = 5
  return read() + moved.line
}
