// error: the result shares parameter "board"; write `from board` after the result type
struct Board {
  cells: Array<int>
  size: int
}

function readCells(board: Board): Array<int> {
  return board.cells
}

// Passes: the result holds no tracked value.
function readSize(board: Board): int {
  return board.size
}

function pickOne(first: Array<int>, second: Array<int>, useFirst: bool): Array<int> from first {
  if (useFirst) {
    return first
  }
  return second
}

function wrapCells(board: Board): Option<Array<int>> {
  const cells = board.cells
  return Some(cells)
}

function viaLoop(boards: Array<Board>): Board {
  for (const board of boards) {
    return board
  }
  return Board { cells: [], size: 0 }
}

export function run(_args: Array<string>): int {
  const board = Board { cells: [1], size: 1 }
  const picked = pickOne([1], [2], true)
  if (wrapCells(board) is Some(cells)) {
    return readCells(board)[0] + readSize(board) + picked[0] + cells[0] + viaLoop([board]).size
  }
  return 0
}
