// FixedArray<T, N>: N elements stored inline, indexes proven at compile time.
import * as Int from "std/int"
import * as Ranges from "std/range"
import * as FixedArrays from "std/fixedarray"

struct Particle derives Show, Equatable {
  name: string
  position: FixedArray<f64, 3>
}

enum Cell derives Show, Equatable {
  Empty
  Filled(label: string)
}

function sum<const N: int>(values: FixedArray<f64, N>): f64 {
  // N is a constant in each instance, so i < N proves the index there.
  let total = 0.0
  for (let i = 0; i < N; i++) {
    total += values[i]
  }
  return total
}

function count<T, const N: int>(_values: FixedArray<T, N>): int {
  return N
}

function scale(mutable values: FixedArray<f64, 3>, factor: f64) {
  for (const i of Ranges.upTo(3)) {
    values[i] = values[i] * factor
  }
}

function read(values: FixedArray<string, 4>, index: int): string {
  if (index >= 0 && index < 4) {
    return values[index]
  }
  return "outside"
}

function readUpTo(values: FixedArray<int, 4>, limit: int): int {
  // limit is at most 4 here, so every i of Ranges.upTo(limit) is below 4.
  let total = 0
  if (limit <= 4) {
    for (const i of Ranges.upTo(limit)) {
      total += values[i]
    }
  }
  return total
}

function readWhile(values: FixedArray<int, 4>): int {
  let total = 0
  let index = 0
  while (index >= 0 && index < 4) {
    total += values[index]
    index++
  }
  return total
}

function* walk(values: FixedArray<int, 4>): Generator<int> {
  let index = 0
  while (index >= 0 && index < 4) {
    yield values[index]
    index++
  }
}

function apply(action: () => int): int {
  return action()
}

function readInClosure(values: FixedArray<int, 4>, index: int): int {
  // A const name cannot change, so its check holds inside the closure.
  if (index >= 0 && index < 4) {
    return apply(() => values[index])
  }
  return 0
}

export function run(_args: Array<string>): int {
  // A literal with an expected type, constant indexes, compound assignment.
  let point: FixedArray<f64, 3> = [1.0, 2.0, 3.0]
  point[1] += 0.5
  print(Show.show(point))
  print(Show.show(point[0] + point[2]))
  print(Show.show(sum(point)))

  // A mutable parameter changes the caller's FixedArray in place.
  scale(mutable point, 2.0)
  print(Show.show(point))

  // Counted elements, an index proven by if, FixedArrays.get and length.
  let words: FixedArray<string, 4> = ["a", "b", "c", "d"]
  words[2] = `c${Int.toString(2)}`
  print(read(words, 2))
  print(read(words, 7))
  print(Show.show(FixedArrays.get(words, 3)))
  print(Show.show(FixedArrays.get(words, -1)))
  print(Int.toString(FixedArrays.length(words)))
  print(Int.toString(count(words)))

  for (const word of words) {
    print(word)
  }

  // Proofs from Ranges.upTo, a while loop, a generator and a closure.
  const numbers: FixedArray<int, 4> = [1, 2, 3, 4]
  print(Int.toString(readUpTo(numbers, 3)))
  print(Int.toString(readWhile(numbers)))
  let walked = 0
  for (const value of walk(numbers)) {
    walked += value
  }
  print(Int.toString(walked))
  print(Int.toString(readInClosure(numbers, 3)))

  // copy(...) gives an independent FixedArray; equality and Show follow the elements.
  let first: FixedArray<string, 2> = ["x", "y"]
  const second = copy(first)
  print(Show.show(first == second))
  first[1] = "w"
  print(Show.show(first == second))
  print(Show.show(first))
  print(Show.show(second))

  // FixedArrays inside structs, enums and other FixedArrays.
  const particle = Particle { name: "p", position: copy(point) }
  print(Show.show(particle))
  print(Show.show(particle == Particle { name: "p", position: copy(point) }))
  let board: FixedArray<Cell, 3> = [Cell.Empty, Cell.Filled("x"), Cell.Empty]
  board[2] = Cell.Filled("o")
  print(Show.show(board))
  let grid: FixedArray<FixedArray<int, 2>, 2> = [[1, 2], [3, 4]]
  grid[1][0] = 9
  print(Show.show(grid))

  // An empty FixedArray.
  const empty: FixedArray<int, 0> = []
  print(Show.show(empty))
  print(Int.toString(FixedArrays.length(empty)))
  return 0
}
