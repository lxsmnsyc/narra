// @inline next to @target and @trusted: the build condition and the unsafe
// wrapper still hold for the copied body.
import * as Build from "std/build"
import * as Int from "std/int"
import * as Ptr from "std/ptr"
import * as Str from "std/string"
import { Os } from "std/build"

@target(os = Os.MacOS)
@inline
function macName(decorate: (name: string) => string uses alloc): string uses alloc {
  return decorate("macOS")
}

@inline
@target(os = Os.Linux)
function linuxName(decorate: (name: string) => string uses alloc): string uses alloc {
  return decorate("Linux")
}

@trusted
@inline
function sumSquares(count: int, weigh: (value: int) => int): int uses alloc {
  let total = 0
  unsafe {
    const items: Ptr<int> = Ptr.alloc(count)
    for (let i = 0; i < count; i++) {
      Ptr.write(Ptr.offset(items, i), weigh(i))
    }
    for (let i = 0; i < count; i++) {
      total += Ptr.read(Ptr.offset(items, i))
    }
    Ptr.free(items)
  }
  return total
}

function findName(): string uses alloc {
  const mark = "*"
  if (Build.os == Os.MacOS) {
    return macName((name) => `${mark}${name}`)
  } else if (Build.os == Os.Linux) {
    return linuxName((name) => `${mark}${name}`)
  }
  return "other"
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Str.length(findName()) > 1 ? "named" : "unnamed")
  print(Int.toString(sumSquares(4, (value) => value * value)))
  return 0
}
