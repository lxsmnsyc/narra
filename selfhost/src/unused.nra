// The unused-import and unused-private-function checks (SPEC.md section 2,
// "Unused names are errors"). They run once every body of the package is
// checked, and only when nothing else failed.
//
// An import name or module alias counts as used when the module's code
// writes it anywhere outside the imports, other than after a `.`
// (SourceFacts.referenced, filled by the parser). A private function counts
// as used when a body other than its own refers to it: another function, a
// test block, a constant or a field default. A name that starts with `_` is
// unused on purpose, which also covers the names the compiler writes itself
// (`__Shape`, `__shapeToValue_Point`).
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { Pos, ImportDecl, ImportName } from "narrac/ast"
import { Checker, BodyInfo, BodyRoot, Ref, enter, reportErrorFix } from "narrac/check"
import { Fix, Edit, createFix, insertAt } from "narrac/fixes"

export function reportUnusedTopLevel(mutable checker: Checker) uses alloc {
  if (Arrays.length(checker.errors) > 0) {
    return
  }
  const used = findUsedFunctions(checker)
  for (const scope of Ranges.upTo(Arrays.length(checker.scopes))) {
    if (!checker.scopes[scope].isSource) {
      continue
    }
    const saved = enter(mutable checker, scope)
    reportUnusedImports(mutable checker, scope)
    reportUnusedFunctions(mutable checker, scope, used)
    enter(mutable checker, saved)
  }
}

// ---- Imports

function reportUnusedImports(mutable checker: Checker, scope: int) uses alloc {
  const facts = checker.scopes[scope].facts
  const lines = Str.split(facts.source, "\n")
  for (const importDecl of Arrays.values(checker.scopes[scope].imports)) {
    // `import * as Alias from "path"`.
    if (importDecl.alias != "") {
      if (!isUnusedName(facts.referenced, importDecl.alias)) {
        continue
      }
      reportErrorFix(
        mutable checker,
        importDecl.aliasPos,
        "E0946",
        [createFix("remove the import", [removeImport(lines, importDecl)])],
        unusedImportMessage(importDecl.alias),
      )
      continue
    }

    // `import { a, b as c } from "path"`: when every name is unused, each
    // fix removes the whole import.
    let unused: Array<int> = []
    for (const index of Ranges.upTo(Arrays.length(importDecl.names))) {
      if (isUnusedName(facts.referenced, importDecl.names[index].local)) {
        Arrays.push(mutable unused, index)
      }
    }
    const removesAll = Arrays.length(unused) == Arrays.length(importDecl.names)
    for (const index of Arrays.values(unused)) {
      const importName = importDecl.names[index]
      let fix = createFix("remove the import", [removeImport(lines, importDecl)])
      if (!removesAll) {
        fix = createFix(
          `remove ${importName.local} from the import`,
          [removeImportName(importDecl.names, index)],
        )
      }
      reportErrorFix(
        mutable checker,
        importName.pos,
        "E0946",
        [fix],
        unusedImportMessage(importName.local),
      )
    }
  }
}

function isUnusedName(referenced: Map<string, bool>, name: string): bool {
  if (name == "" || Str.startsWith(name, "_")) {
    return false
  }
  return referenced[name] is None
}

function unusedImportMessage(name: string): string uses alloc {
  return `"${name}" is imported but never used; remove it, or import it as "_${name}" to mark it as unused on purpose`
}

function removeImport(lines: Array<string>, importDecl: ImportDecl): Edit uses alloc {
  const quoted = `"${importDecl.path}"`
  // The import ends on the line that holds its path.
  let lastLine = importDecl.pos.line
  while (lastLine < Arrays.length(lines) && !Str.contains(lines[lastLine - 1], quoted)) {
    lastLine = lastLine + 1
  }
  return Edit {
    start: Pos { line: importDecl.pos.line, column: 1 },
    end: Pos { line: lastLine + 1, column: 1 },
    text: "",
  }
}

function removeImportName(names: Array<ImportName>, index: int): Edit {
  // Delete the name with its comma: up to the next name, or after the last one from the end of the
  // name before.
  if (index + 1 < Arrays.length(names)) {
    return Edit { start: names[index].pos, end: names[index + 1].pos, text: "" }
  }
  return Edit { start: names[index - 1].end, end: names[index].end, text: "" }
}

// ---- Private functions

function findUsedFunctions(checker: Checker): Array<bool> uses alloc {
  let used: Array<bool> = []
  for (const _index of Ranges.upTo(Arrays.length(checker.functions))) {
    Arrays.push(mutable used, false)
  }
  // Marks, by Checker.functions index, the functions that a body other than their own refers to.
  for (const body of Arrays.values(checker.bodies)) {
    for (const ref of Arrays.values(body.refs)) {
      if (ref is Ref.Function(index)) {
        if (!isOwnBody(checker, body, index)) {
          used[index] = true
        }
      }
    }
  }
  // A function a binary names as its entry is the entry check's concern,
  // even when it is private.
  for (const target of Arrays.values(checker.entryTargets)) {
    for (const index of Ranges.upTo(Arrays.length(checker.functions))) {
      const info = checker.functions[index]
      if (info.module == target.module && info.name == target.name) {
        used[index] = true
      }
    }
  }
  // A Shape call on a prelude type reaches the std/shape function for it
  // (`intToValue`, `arrayFromValue`) by name, so they count as used.
  for (const index of Ranges.upTo(Arrays.length(checker.functions))) {
    const name = checker.functions[index].name
    if (
      checker.functions[index].module == "std/shape" &&
        (Str.endsWith(name, "ToValue") || Str.endsWith(name, "FromValue"))
    ) {
      used[index] = true
    }
  }
  return used
}

function isOwnBody(checker: Checker, body: BodyInfo, funcIndex: int): bool {
  const info = checker.functions[funcIndex]
  if (body.root is BodyRoot.RootFunc(declaration)) {
    // The body checks the function itself or one of its instances; a call there is recursion.
    return body.kind == "func" &&
      body.module == info.module &&
      declaration.pos == info.declaration.pos
  }
  return false
}

function reportUnusedFunctions(mutable checker: Checker, scope: int, used: Array<bool>) uses alloc {
  const lines = Str.split(checker.scopes[scope].facts.source, "\n")
  for (const index of Ranges.upTo(Arrays.length(checker.functions))) {
    const info = checker.functions[index]
    if (info.scope != scope || info.declaration.exported || used[index]) {
      continue
    }
    if (Str.startsWith(info.name, "_") || info.declaration.body is None) {
      continue
    }
    const nameUses = findNameUses(lines, info.declaration.pos, info.name)
    let pos = info.declaration.pos
    let fixes: Array<Fix> = []
    if (Arrays.length(nameUses) > 0) {
      pos = nameUses[0]
      let edits: Array<Edit> = []
      for (const usePos of Arrays.values(nameUses)) {
        Arrays.push(mutable edits, insertAt(usePos, "_"))
      }
      fixes = [createFix(`rename to _${info.name}`, edits)]
    }
    reportErrorFix(
      mutable checker,
      pos,
      "E0947",
      fixes,
      `private function "${info.name}" is never used; remove it, or name it "_${info.name}" to mark it as unused on purpose`,
    )
  }
}

function findNameUses(lines: Array<string>, start: Pos, name: string): Array<Pos> uses alloc {
  // Scans from the declaration at start to the first line after it that starts with `}`, the end of
  // a formatted top-level function. The first use is the declared name; the rest are the function's
  // references to itself. Text in comments, strings and characters is skipped, and so is a name
  // after a `.`.
  let found: Array<Pos> = []
  const nameCharacters = Str.chars(name)
  const nameLength = Arrays.length(nameCharacters)
  let lineNumber = start.line
  while (lineNumber <= Arrays.length(lines)) {
    const characters = Str.chars(lines[lineNumber - 1])
    const count = Arrays.length(characters)
    let index = 0
    if (lineNumber == start.line) {
      index = start.column - 1
    }
    while (index < count) {
      const character = characters[index]
      if (character == '/' && index + 1 < count && characters[index + 1] == '/') {
        break
      }
      if (character == '"' || character == '\'') {
        index = skipQuoted(characters, index)
        continue
      }
      if (!isWordCharacter(character)) {
        index = index + 1
        continue
      }
      let end = index
      while (end < count && isWordCharacter(characters[end])) {
        end = end + 1
      }
      const afterDot = index > 0 && characters[index - 1] == '.'
      if (!afterDot && end - index == nameLength && matchesAt(characters, index, nameCharacters)) {
        Arrays.push(mutable found, Pos { line: lineNumber, column: index + 1 })
      }
      index = end
    }
    if (lineNumber > start.line && count > 0 && characters[0] == '}') {
      break
    }
    lineNumber = lineNumber + 1
  }
  return found
}

function skipQuoted(characters: Array<char>, index: int): int {
  const quote = characters[index]
  let next = index + 1
  while (next < Arrays.length(characters)) {
    if (characters[next] == '\\') {
      next = next + 2
      continue
    }
    if (characters[next] == quote) {
      return next + 1
    }
    next = next + 1
  }
  // No closing quote: the end of the line.
  return Arrays.length(characters)
}

function isWordCharacter(character: char): bool {
  return (character >= 'a' && character <= 'z') ||
    (character >= 'A' && character <= 'Z') ||
    (character >= '0' && character <= '9') ||
    character == '_'
}

function matchesAt(characters: Array<char>, index: int, nameCharacters: Array<char>): bool {
  for (const offset of Ranges.upTo(Arrays.length(nameCharacters))) {
    if (characters[index + offset] != nameCharacters[offset]) {
      return false
    }
  }
  return true
}
