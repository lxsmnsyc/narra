// The style functions of std/terminal: each code, nesting, `style` with every color form, and stripStyles.
import * as Terminal from "std/terminal"
import { Color, Style } from "std/terminal"
import * as Str from "std/string"

function show(label: string, text: string) uses io, alloc {
  const visible = Str.replace(text, "\u{1b}", "<ESC>")
  const stripped = Str.replace(Terminal.stripStyles(text), "\u{1b}", "<ESC>")
  print(`${label}: ${visible} | ${stripped}`)
}

export function run(args: Array<string>): int uses io, alloc {
  show("bold", Terminal.bold("hi"))
  show("dim", Terminal.dim("hi"))
  show("italic", Terminal.italic("hi"))
  show("underline", Terminal.underline("hi"))
  show("inverse", Terminal.inverse("hi"))
  show("strikethrough", Terminal.strikethrough("hi"))
  show("red", Terminal.red("hi"))
  show("gray", Terminal.gray("hi"))
  show("bgBlue", Terminal.bgBlue("hi"))
  show("empty", Terminal.green(""))

  // The outer style is reopened after an inner close.
  show("bold around red", Terminal.bold(`${Terminal.red("x")} done`))
  show("red around red", Terminal.red(`a ${Terminal.red("b")} c`))
  show("bold around dim", Terminal.bold(`${Terminal.dim("x")} done`))
  show("two closes", Terminal.yellow(`${Terminal.blue("1")}${Terminal.blue("2")}`))

  const fancy = Style {
    foreground: Some(Color.Rgb(255, 128, 0)),
    background: Some(Color.Ansi256(21)),
    bold: true,
    underline: true,
  }
  show("style fancy", Terminal.style("go", fancy))
  show(
    "style named",
    Terminal.style("go", Style { foreground: Some(Color.BrightRed), background: Some(Color.Cyan) }),
  )
  show("style plain", Terminal.style("go", Style {}))

  // stripStyles leaves other escapes and text alone.
  show("strip keeps", "a\u{1b}[2Kb\u{1b}[31")
  show("strip colon form", "a\u{1b}[38:5:1mb\u{1b}[0m")
  show("strip text", "no codes é")
  return 0
}
