// error: E1055, an array too large for the memory budget is never built
import * as Arrays from "std/array"

@const
function huge(): Array<int> uses alloc {
  if (Arrays.filled(0, 100000000) is Some(items)) {
    return items
  }
  return []
}

const HUGE = huge()

export function run(args: Array<string>): int {
  return 0
}
