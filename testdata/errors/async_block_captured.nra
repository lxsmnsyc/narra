// error: the async block returns a value that shares captured "items"; return a copy with copy(...)
import * as Arrays from "std/array"
import * as Int from "std/int"

export async function run(_args: Array<string>): int {
  const items = [1, 2]
  let got = await async {
    return items
  }
  Arrays.push(mutable got, 3)
  print(`${Int.toString(Arrays.length(items))} ${Int.toString(Arrays.length(got))}`)
  return 0
}
