// A running-total coroutine, and generators resumed by hand: until Done, and
// zipped two at a time. The first resume's input is dropped.
import * as Co from "std/coroutine"
import { Step } from "std/coroutine"
import * as Int from "std/int"
import * as Ranges from "std/range"

// total yields the sum of the inputs so far. Its first yield has no input to
// receive, so the value 0 it yields first is the sum of nothing.
function* total(): Coroutine<int, int> {
  let sum = 0
  while (true) {
    const next = yield sum
    sum = sum + next
  }
}

function* counter(limit: int): Generator<int> {
  for (const i of Ranges.upTo(limit)) {
    yield i
  }
}

function show(step: Step<int>): string {
  return match (step) {
    Step.Yielded(value) => `yielded ${Int.toString(value)}`
    Step.Done => "done"
    Step.Panicked(message) => `panicked ${message}`
  }
}

export function run(args: Array<string>): int {
  // The running total: the first input (100) is dropped.
  let running = total()
  print(show(Co.resume(mutable running, 100)))
  print(show(Co.resume(mutable running, 5)))
  print(show(Co.resume(mutable running, 7)))
  print(show(Co.resume(mutable running, 30)))

  // A generator resumed until Done.
  let numbers = counter(3)
  while (true) {
    const step = Co.resume(mutable numbers)
    print(show(step))
    if (step is Step.Done) {
      break
    }
  }
  // A finished generator stays Done.
  print(show(Co.resume(mutable numbers)))

  // Zipping two generators by hand.
  let left = counter(3)
  let right = counter(10)
  while (true) {
    const a = Co.resume(mutable left)
    const b = Co.resume(mutable right)
    if (a is Step.Yielded(x)) {
      if (b is Step.Yielded(y)) {
        print(`${Int.toString(x)},${Int.toString(y)}`)
        continue
      }
    }
    break
  }
  return 0
}
