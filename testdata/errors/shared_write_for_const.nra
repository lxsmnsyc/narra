// warning: changed[0] = ... may change changed, which rows[] still uses at line 11
export function run(_args: Array<string>): int uses alloc {
  const rows = [[1, 2], [3]]
  let total = 0
  // `for (const row of rows)` binds each element of rows.
  for (const row of rows) {
    let changed = row
    changed[0] = 9
    total += changed[0]
  }
  return total + rows[0][0]
}
