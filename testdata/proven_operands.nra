import * as I32 from "std/i32"
import * as U64 from "std/u64"

function show<T: Show>(value: T) uses alloc {
  print(Show.show(value))
}

const BUCKETS = 16
const SHIFT = 1 << 3
const WRAPPED_DIVISOR: i32 = 65536 * 65536 + 3
const WRAPPED_BYTE: u8 = 255 + 2
const HIGH_DIVISOR: u64 = 9223372036854775807 + 2
const WRAPPED_COUNT: u8 = 255 + 3

function nonzero(total: int, count: int): int {
  if (count != 0) {
    return total / count
  }
  return -1
}

function positive(total: int, count: int): int {
  if (count > 0) {
    return total % count
  }
  return -1
}

function negative(total: int, count: int): int {
  if (count < 0) {
    return total / count
  }
  return -1
}

function earlyReturn(total: int, count: int): int {
  if (count == 0) {
    return -1
  }
  return total / count
}

function onTheLeft(total: int, count: int): int {
  if (0 < count) {
    return total / count
  }
  return -1
}

function andRight(total: int, count: int): bool {
  return count != 0 && total / count > 1
}

function orRight(total: int, count: int): bool {
  return count == 0 || total / count > 1
}

function negated(total: int, count: int): int {
  if (!(count == 0)) {
    return total / count
  }
  return -1
}

function elseBranch(total: int, count: int): int {
  if (count == 0) {
    return -1
  } else {
    return total / count
  }
}

function whileBody(start: int): int {
  let remaining = start
  let sum = 0
  while (remaining > 0) {
    sum += 100 / remaining
    remaining -= 1
  }
  return sum
}

function compound(total: int, count: int): int {
  let result = total
  if (count != 0) {
    result /= count
    result %= 3
  }
  return result
}

function constants(total: int): int {
  return total / 4 + total % BUCKETS + total / -2
}

function constantLocal(total: int): int {
  const items = 7
  const negativeStep = -3
  return total / items + total % negativeStep
}

function wrappedConstants(total: i32, byte: u8): i32 {
  const shifted: u8 = byte << WRAPPED_COUNT
  return total / WRAPPED_DIVISOR + total % WRAPPED_DIVISOR + I32.from(byte % WRAPPED_BYTE + shifted)
}

function highDivisor(total: u64): u64 {
  return total / HIGH_DIVISOR + total % HIGH_DIVISOR
}

function reNarrowed(total: int, count: int): int {
  let divisor = count
  if (divisor != 0) {
    divisor = divisor - 1
  }
  if (divisor != 0) {
    return total / divisor
  }
  return -1
}

function signedShift(value: int, count: int): int {
  if (count >= 0 && count < 64) {
    return (value << count) + (value >> count)
  }
  return -1
}

function signedShiftEarly(value: int, count: int): int {
  if (count < 0 || count > 63) {
    return -1
  }
  return value << count
}

function unsignedShift(value: u8, count: u8): u8 {
  if (count < 8) {
    return (value << count) | (value >> count)
  }
  return 0
}

function constantShift(value: int): int {
  return (value << SHIFT) + (value >> 2)
}

function shiftAssign(value: int, count: int): int {
  let result = value
  if (count >= 0 && count < 8) {
    result <<= count
    result >>= 1
  }
  return result
}

function floats(left: f64, right: f64): f64 {
  return left / right
}

export function run(args: Array<string>): int {
  show(nonzero(10, 2))
  show(nonzero(10, 0))
  show(positive(10, 3))
  show(positive(10, -3))
  show(negative(10, -3))
  show(negative(10, 3))
  show(earlyReturn(10, 5))
  show(earlyReturn(10, 0))
  show(onTheLeft(10, 5))
  show(onTheLeft(10, 0))
  show(andRight(10, 2))
  show(andRight(10, 0))
  show(orRight(10, 2))
  show(orRight(10, 0))
  show(negated(10, 5))
  show(negated(10, 0))
  show(elseBranch(10, 5))
  show(elseBranch(10, 0))
  show(whileBody(3))
  show(compound(20, 4))
  show(compound(20, 0))
  show(constants(100))
  show(constantLocal(100))
  show(wrappedConstants(20, 5))
  show(highDivisor(U64.wrap(7)))
  show(reNarrowed(10, 3))
  show(reNarrowed(10, 1))
  show(reNarrowed(10, 0))
  show(signedShift(8, 2))
  show(signedShift(8, 64))
  show(signedShift(8, -1))
  show(signedShiftEarly(1, 4))
  show(signedShiftEarly(1, 64))
  show(unsignedShift(129, 1))
  show(unsignedShift(1, 9))
  show(constantShift(1))
  show(shiftAssign(3, 2))
  show(shiftAssign(3, 9))
  show(floats(1.0, 2.0))
  return 0
}
