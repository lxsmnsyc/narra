// error: shift_variable.nra:3:19: the shift count must be a constant from 0 to 63 or a name checked against both ends first; check the name first, as in `if (n >= 0 && n < 64) { ... }`
function shift(value: int, count: int): int {
  return value << count
}

export function run(args: Array<string>): int {
  return shift(1, 3)
}
