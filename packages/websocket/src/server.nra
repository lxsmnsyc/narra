// websocket/server: answers the opening handshake of a request and runs a handler on the socket.

import * as Arrays from "std/array"
import * as Fields from "http/headers"
import * as Handshake from "websocket/handshake"
import * as Responses from "http/response"
import * as Sessions from "websocket/session"
import { Connection } from "std/net"
import { Method, Request } from "http/request"
import { Options } from "websocket/message"
import { Response, Upgrade } from "http/response"
import { Socket } from "websocket/socket"

function chooseProtocol(request: Request, options: Options): Option<string> uses alloc {
  // The first protocol of the client's offer that the server accepts.
  for (const offered of Arrays.values(
    Handshake.listItems(request.headers, "Sec-WebSocket-Protocol"),
  )) {
    if (Arrays.contains(options.protocols, offered)) {
      return Some(offered)
    }
  }
  return None
}

function refuse(status: int, message: string): Response uses alloc {
  return Responses.text(status, message)
}

/// Answers a request that asks for a WebSocket. A good request gets a 101 response with `upgrade`
/// set: the http server writes it, hands the connection over, and `onOpen` runs with the socket.
/// When `onOpen` returns, the socket is closed with 1000 if it is still open. A request that is
/// not a handshake gets 400, and a version other than 13 gets 426 with the version that is
/// supported. A request for an extension is answered without it.
export function accept(
  request: Request,
  options: Options,
  escaping onOpen: (socket: Socket) => Async<void> uses (io, alloc),
): Response uses alloc {
  if (request.method != Method.Get) {
    return refuse(400, "a WebSocket handshake is a GET request")
  }
  if (!Handshake.hasToken(request.headers, "Upgrade", "websocket")) {
    return refuse(400, "the request does not ask for the websocket upgrade")
  }
  if (!Handshake.hasToken(request.headers, "Connection", "upgrade")) {
    return refuse(400, "the request does not ask for the upgrade in Connection")
  }
  const key = Fields.get(request.headers, "Sec-WebSocket-Key")
  if (key is None) {
    return refuse(400, "the request has no Sec-WebSocket-Key")
  }
  if (!Handshake.isValidKey(key.value)) {
    return refuse(400, "the Sec-WebSocket-Key is not 16 bytes in base64")
  }
  const version = Fields.get(request.headers, "Sec-WebSocket-Version")
  if (version is None) {
    return refuse(400, "the request has no Sec-WebSocket-Version")
  }
  if (version.value != "13") {
    let unsupported = refuse(426, "only WebSocket version 13 is supported")
    Fields.add(mutable unsupported.headers, "Sec-WebSocket-Version", "13")
    return unsupported
  }
  const chosen = chooseProtocol(request, options)
  let response = Responses.create(101)
  Fields.add(mutable response.headers, "Upgrade", "websocket")
  Fields.add(mutable response.headers, "Connection", "Upgrade")
  Fields.add(mutable response.headers, "Sec-WebSocket-Accept", Handshake.findAccept(key.value))
  if (chosen is Some(protocol)) {
    Fields.add(mutable response.headers, "Sec-WebSocket-Protocol", protocol)
  }
  response.upgrade = Some(Upgrade {
    run: (connection: Connection, leftover: bytes) => runSession(
      connection,
      leftover,
      options,
      chosen,
      onOpen,
    ),
  })
  return response
}

async function runSession(
  connection: Connection,
  leftover: bytes,
  options: Options,
  chosen: Option<string>,
  escaping onOpen: (socket: Socket) => Async<void> uses (io, alloc),
) uses io, alloc {
  const socket = Sessions.open(connection, leftover, false, options, chosen)
  await onOpen(socket)
  // The handler is done: end the socket politely if the peer has not, and then for certain, since
  // a handler that was cancelled leaves nobody to close it.
  const _closed = await Sessions.close(socket, 1000, "")
  Sessions.drop(socket)
}
