function identity<T>(value: T): T {
  return value
}

function pick<A, B>(first: A, second: B): A {
  return first
}

export function run(args: Array<string>): int {
  const pair: #[int, string] = #[1, "x"]
  const same = identity(pair)
  const mixed = pick(pair, 2)
  const #[count, _] = same
  const #[other, _] = mixed
  return count + other
}
