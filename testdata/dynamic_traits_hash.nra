import * as Arrays from "std/array"

struct Point {
  x: int
  y: int
}

export function run(_args: Array<string>): int {
  const items: Array<Dynamic<Hashable>> = [
    Dynamic.of(7),
    Dynamic.of("seven"),
    Dynamic.of(Point { x: 1, y: 2 }),
  ]
  const expected = [Hashable.hash(7), Hashable.hash("seven"), Hashable.hash(Point { x: 1, y: 2 })]
  for (const #[index, item] of Arrays.entries(items)) {
    print(Show.show(Hashable.hash(item) == expected[index]))
  }
  return 0
}
