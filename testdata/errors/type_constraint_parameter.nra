// error: type_constraint_parameter.nra:7:25: T does not implement Show, which Pair needs for type parameter T; declare it as <T: Show>
struct Pair<T: Show> {
  left: T
  right: T
}

function first<T>(pair: Pair<T>): T from pair {
  return pair.left
}

export function run(_args: Array<string>): int {
  return first(Pair { left: 1, right: 2 })
}
