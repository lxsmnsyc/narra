// lead
export function pick(index: int): Option<int> // after signature
  requires index >= 0
  // before ensures
  ensures Some(>= 0) | None // trailing on ensures
  ensures Some(< 64) | None
// before body
{
  if (index < 64) {
    return Some(index)
  }
  return None
}

function status(code: int): #[int, string]
  ensures #[>= 0, "ok"]
    | #[< 0, "failed"]
    | #[>= 1000000, "a very long status text that does not fit"]
{
  return #[0, "ok"]
}

function size(): Rect
  ensures { width: > 0, height: >= -1 }
{
  return Rect { width: 1, height: 0 }
}
