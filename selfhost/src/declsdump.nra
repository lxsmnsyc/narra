// The declaration dump (`narrac decls <path>`). The format is defined in the
// doc comment at the top of compiler/internal/narra/decldump.go; this file
// prints the same text from the Narra checker's tables. selfhost-check-traits
// added trait, impl and bound; selfhost-check-imports added module, import,
// scope and entry, and writes types with their module (dumpTypeString). The
// builtin lines are printed by builtins.nra (`narrac builtins`).
import * as Str from "std/string"
import { Decl, File, FuncDecl, Param, ImplDecl } from "narrac/ast"
import { quoteDump } from "narrac/modules"
import { Type, Field, Variant } from "narrac/types"
import { Checker, typeString, typeModule, containsTypeParam, stdTrait } from "narrac/check"
import { typeImplements } from "narrac/traits"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"

// dump returns the dump of a checker that ran declarePackage without errors.
export function dump(mutable checker: Checker): string uses alloc {
  let builder = Str.builder()
  // The implement blocks are in checker.impls in the order dumpModule meets them.
  let nextImpl = 0
  for (const scope of Ranges.between(0, Arrays.length(checker.scopes))) {
    dumpModule(mutable builder, checker, scope, mutable nextImpl)
    if (checker.scopes[scope].isSource) {
      dumpScope(mutable builder, checker, scope)
    }
  }
  if (nextImpl != Arrays.length(checker.impls)) {
    panic("declsdump: an implement block was not printed")
  }
  for (const entry of Arrays.values(checker.entries)) {
    let target = "none"
    if (entry.func >= 0) {
      target = `${checker.funcs[entry.func].module}.${checker.funcs[entry.func].name}`
    }
    Str.append(mutable builder, `entry ${quoteDump(entry.binary)} ${target}\n`)
  }
  let blocks: Array<string> = []
  let heads: Array<string> = []
  for (const type of Arrays.values(checker.instTypes)) {
    if (!containsTypeParam(checker, type)) {
      let instanceBuilder = Str.builder()
      dumpType(mutable instanceBuilder, checker, type)
      const text = Str.build(instanceBuilder)
      const head = Str.split(text, "\n")[0]
      Arrays.push(mutable blocks, text)
      Arrays.push(mutable heads, head)
    }
  }
  // Stable order by the first line, as Go's sort.SliceStable.
  for (const index of Arrays.values(sortedByHead(heads))) {
    Str.append(mutable builder, blocks[index])
  }
  for (const type of Arrays.values(checker.order)) {
    Str.append(mutable builder, `order module=${quoteDump(typeModule(checker, type))} ${dumpTypeString(checker, type)}\n`)
  }
  for (const type of Arrays.values(checker.order)) {
    dumpHolds(mutable builder, mutable checker, type)
  }
  return Str.build(builder)
}

// sortedByHead returns the indexes of heads in byte order, equal heads in
// their original order (a bottom-up merge sort).
function sortedByHead(heads: Array<string>): Array<int> uses alloc {
  const count = Arrays.length(heads)
  let order: Array<int> = []
  for (const index of Ranges.between(0, count)) {
    Arrays.push(mutable order, index)
  }
  let width = 1
  while (width < count) {
    let merged: Array<int> = []
    let low = 0
    while (low < count) {
      let middle = low + width
      if (middle > count) {
        middle = count
      }
      let high = low + 2 * width
      if (high > count) {
        high = count
      }
      let left = low
      let right = middle
      while (left < middle || right < high) {
        if (right >= high || (left < middle && heads[order[left]] <= heads[order[right]])) {
          Arrays.push(mutable merged, order[left])
          left = left + 1
        } else {
          Arrays.push(mutable merged, order[right])
          right = right + 1
        }
      }
      low = low + 2 * width
    }
    order = merged
    width = width * 2
  }
  return order
}

function dumpModule(mutable builder: StringBuilder, checker: Checker, scopeIndex: int, mutable nextImpl: int) uses alloc {
  const scope = checker.scopes[scopeIndex]
  const moduleAttr = ` module=${quoteDump(scope.path)} `
  for (const decl of Arrays.values(scope.decls)) {
    match (decl) {
      Decl.Struct(structDecl) => {
        dumpNamed(mutable builder, checker, scopeIndex, structDecl.name)
        dumpListed(mutable builder, checker, moduleAttr, scope.path, structDecl.name)
      }
      Decl.Enum(enumDecl) => {
        dumpNamed(mutable builder, checker, scopeIndex, enumDecl.name)
        dumpListed(mutable builder, checker, moduleAttr, scope.path, enumDecl.name)
      }
      Decl.Trait(traitDecl) => {
        if (scope.traits[traitDecl.name] is Some(traitIndex)) {
          dumpTrait(mutable builder, checker, moduleAttr, traitIndex)
        }
      }
      Decl.Impl(implDecl) => dumpImpl(mutable builder, checker, moduleAttr, scopeIndex, implDecl, mutable nextImpl)
      Decl.Distinct(distinctDecl) => dumpNamed(mutable builder, checker, scopeIndex, distinctDecl.name)
      Decl.Func(funcDecl) => dumpFunc(mutable builder, checker, scopeIndex, moduleAttr, funcDecl)
      Decl.Const(constDecl) => {
        let typeText = "?"
        if (scope.consts[constDecl.name] is Some(constIndex)) {
          if (checker.consts[constIndex].declaredType is Some(constType)) {
            typeText = dumpTypeString(checker, constType)
          }
        }
        Str.append(mutable builder, `const${moduleAttr}${constDecl.name} ${typeText}\n`)
      }
      _ => {}
    }
  }
}

// dumpNamed prints a struct, enum or distinct declaration of a scope: its
// generic template, or its type.
function dumpNamed(mutable builder: StringBuilder, checker: Checker, scope: int, name: string) uses alloc {
  if (checker.scopes[scope].generics[name] is Some(generic)) {
    dumpGeneric(mutable builder, checker, generic)
  } else if (checker.scopes[scope].types[name] is Some(type)) {
    dumpType(mutable builder, checker, type)
  }
}

function dumpFunc(mutable builder: StringBuilder, checker: Checker, scope: int, moduleAttr: string, funcDecl: FuncDecl) uses alloc {
  Str.append(mutable builder, `func${moduleAttr}`)
  if (Arrays.length(funcDecl.typeParams) > 0) {
    Str.append(mutable builder, `typeParams=${Str.join(funcDecl.typeParams, ",")} `)
  }
  Str.append(mutable builder, `${funcDecl.name}\n`)
  for (const param of Arrays.values(funcDecl.params)) {
    let flag = ""
    if (param.isMutable) {
      flag = "mutable "
    }
    Str.append(mutable builder, `  param ${param.name} ${flag}${dumpTypeString(checker, checker.paramTypes[param.id])}\n`)
  }
  let result = "void"
  if (checker.scopes[scope].funcs[funcDecl.name] is Some(funcIndex)) {
    result = dumpTypeString(checker, checker.funcs[funcIndex].result)
  }
  Str.append(mutable builder, `  result ${result}\n`)
  if (checker.scopes[scope].funcs[funcDecl.name] is Some(funcIndex)) {
    for (const i of Ranges.between(0, Arrays.length(checker.funcs[funcIndex].typeParams))) {
      if (checker.bounds[checker.funcs[funcIndex].typeParams[i]] is Some(bounds)) {
        for (const traitIndex of Arrays.values(bounds)) {
          Str.append(mutable builder, `  bound ${funcDecl.typeParams[i]} ${checker.traits[traitIndex].name}\n`)
        }
      }
    }
  }
}

// dumpListed prints the `implements` and `derives` lists of a struct or enum.
function dumpListed(mutable builder: StringBuilder, checker: Checker, moduleAttr: string, path: string, name: string) uses alloc {
  if (checker.typeTraitIndex[`${path}|${name}`] is Some(index)) {
    for (const typeExpr of Arrays.values(checker.typeTraits[index].implExprs)) {
      Str.append(mutable builder, `impl${moduleAttr}listed ${typeExpr.name} ${name}\n`)
    }
    for (const typeExpr of Arrays.values(checker.typeTraits[index].derivExprs)) {
      Str.append(mutable builder, `impl${moduleAttr}derived ${typeExpr.name} ${name}\n`)
    }
  }
}

function dumpTrait(mutable builder: StringBuilder, checker: Checker, moduleAttr: string, traitIndex: int) uses alloc {
  const info = checker.traits[traitIndex]
  let std = ""
  if (info.std) {
    std = "std "
  }
  Str.append(mutable builder, `trait${moduleAttr}${std}${info.name}\n`)
  for (const traitFunc of Arrays.values(info.funcs)) {
    dumpSignature(mutable builder, checker, traitFunc.name, traitFunc.decl, traitFunc.result)
  }
}

// dumpImpl prints an `implement` block. Checker.impls holds the checked
// blocks in declaration order, so the next one is this block. The dump runs
// only without errors, when every block was recorded; a mismatch is a bug
// and stops the dump.
function dumpImpl(mutable builder: StringBuilder, checker: Checker, moduleAttr: string, scope: int, implDecl: ImplDecl, mutable nextImpl: int) uses alloc {
  if (nextImpl >= Arrays.length(checker.impls)) {
    panic("declsdump: an implement block is missing from Checker.impls")
  }
  const block = checker.impls[nextImpl]
  if (block.scope != scope || block.decl.pos != implDecl.pos) {
    panic("declsdump: Checker.impls is out of declaration order")
  }
  nextImpl = nextImpl + 1
  Str.append(mutable builder, `impl${moduleAttr}block ${checker.traits[block.traitIdx].name} ${implTypeName(checker, block.forType)}\n`)
  for (const implFunc of Arrays.values(block.funcs)) {
    dumpSignature(mutable builder, checker, implFunc.name, implFunc.decl, implFunc.result)
  }
}

function implTypeName(checker: Checker, type: Type): string {
  return match (type) {
    Type.TStruct(index) => checker.structs[index].name
    Type.TEnum(index) => checker.enums[index].name
    _ => ""
  }
}

function dumpSignature(mutable builder: StringBuilder, checker: Checker, name: string, funcDecl: FuncDecl, result: Type) uses alloc {
  Str.append(mutable builder, `  function ${name}\n`)
  for (const param of Arrays.values(funcDecl.params)) {
    let flags = ""
    if (param.isMutable) {
      flags = "mutable "
    }
    if (param.escaping) {
      flags = `${flags}escaping `
    }
    Str.append(mutable builder, `    param ${param.name} ${flags}${dumpTypeString(checker, checker.paramTypes[param.id])}\n`)
  }
  Str.append(mutable builder, `    result ${dumpTypeString(checker, result)}\n`)
}

// dumpHolds prints typeImplements(type, trait) for the four standard traits.
function dumpHolds(mutable builder: StringBuilder, mutable checker: Checker, type: Type) uses alloc {
  const names = ["Equatable", "Hashable", "Ordered", "Show"]
  for (const name of Arrays.values(names)) {
    const traitIndex = stdTrait(checker, name)
    let holds = "false"
    if (typeImplements(mutable checker, type, traitIndex)) {
      holds = "true"
    }
    Str.append(mutable builder, `impl module=${quoteDump(typeModule(checker, type))} holds=${holds} ${name} ${dumpTypeString(checker, type)}\n`)
  }
}

function dumpType(mutable builder: StringBuilder, checker: Checker, type: Type) uses alloc {
  match (type) {
    Type.TStruct(index) => {
      const info = checker.structs[index]
      if (info.tuple) {
        Str.append(mutable builder, `type tuple module="" ${dumpTypeString(checker, type)}\n`)
      } else {
        Str.append(mutable builder, `type struct module=${quoteDump(info.module)} ${opaqueFlag(info.opaque)}${dumpTypeString(checker, type)}\n`)
      }
      dumpFields(mutable builder, checker, "  ", info.fields)
    }
    Type.TEnum(index) => {
      Str.append(mutable builder, `type enum module=${quoteDump(checker.enums[index].module)} ${dumpTypeString(checker, type)}\n`)
      dumpVariants(mutable builder, checker, checker.enums[index].variants)
    }
    Type.TDistinct(index) => {
      const info = checker.distincts[index]
      Str.append(mutable builder, `type distinct module=${quoteDump(info.module)} ${opaqueFlag(info.opaque)}${info.name}\n`)
      let base = "void"
      if (info.base is Some(baseType)) {
        base = dumpTypeString(checker, baseType)
      }
      Str.append(mutable builder, `  base ${base}\n`)
    }
    _ => {}
  }
}

function dumpGeneric(mutable builder: StringBuilder, checker: Checker, generic: int) uses alloc {
  const info = checker.generics[generic]
  let names: Array<string> = []
  for (const param of Arrays.values(info.params)) {
    Arrays.push(mutable names, checker.params[param].name)
  }
  let kind = "enum"
  if (info.isStruct) {
    kind = "struct"
  }
  Str.append(mutable builder, `generic ${kind} module=${quoteDump(info.module)} params=${Str.join(names, ",")} ${opaqueFlag(info.opaque)}${info.name}\n`)
  dumpFields(mutable builder, checker, "  ", info.fields)
  dumpVariants(mutable builder, checker, info.variants)
}

function dumpVariants(mutable builder: StringBuilder, checker: Checker, variants: Array<Variant>) uses alloc {
  for (const variant of Arrays.values(variants)) {
    Str.append(mutable builder, `  variant ${variant.name}\n`)
    dumpFields(mutable builder, checker, "    ", variant.fields)
  }
}

function dumpFields(mutable builder: StringBuilder, checker: Checker, indent: string, fields: Array<Field>) uses alloc {
  for (const field of Arrays.values(fields)) {
    let flag = ""
    if (field.default is Some(_)) {
      flag = "default "
    }
    Str.append(mutable builder, `${indent}field ${field.name} ${flag}${dumpTypeString(checker, field.fieldType)}\n`)
  }
}

function opaqueFlag(opaque: bool): string {
  if (opaque) {
    return "opaque "
  }
  return ""
}

// dumpTypeString prints a type as typeString does, except that a struct,
// enum or distinct type declared in a package module is written
// <module>.<Name> (decldump.go's dumpTypeString).
export function dumpTypeString(checker: Checker, type: Type): string uses alloc {
  return match (type) {
    Type.TStruct(index) => structText(checker, index)
    Type.TEnum(index) => `${qualified(checker.enums[index].module, checker.enums[index].name)}${argsText(checker, checker.enums[index].args)}`
    Type.TDistinct(index) => qualified(checker.distincts[index].module, checker.distincts[index].name)
    Type.TArray(element) => `Array<${dumpTypeString(checker, element)}>`
    Type.TBox(element) => `Box<${dumpTypeString(checker, element)}>`
    Type.TMap(key, value) => `Map<${dumpTypeString(checker, key)}, ${dumpTypeString(checker, value)}>`
    Type.TFunc(parameters, result) => `(${listText(checker, parameters)}) => ${dumpTypeString(checker, result)}`
    _ => typeString(checker, type)
  }
}

function structText(checker: Checker, index: int): string uses alloc {
  const info = checker.structs[index]
  if (info.tuple) {
    return `#[${listText(checker, info.args)}]`
  }
  return `${qualified(info.module, info.name)}${argsText(checker, info.args)}`
}

function qualified(module: string, name: string): string uses alloc {
  if (module == "") {
    return name
  }
  return `${module}.${name}`
}

function argsText(checker: Checker, args: Array<Type>): string uses alloc {
  if (Arrays.length(args) == 0) {
    return ""
  }
  return `<${listText(checker, args)}>`
}

function listText(checker: Checker, types: Array<Type>): string uses alloc {
  let parts: Array<string> = []
  for (const type of Arrays.values(types)) {
    Arrays.push(mutable parts, dumpTypeString(checker, type))
  }
  return Str.join(parts, ", ")
}

// dumpScope prints the `module` block of a package module: its imports in
// source order, then the names of its scope that the prelude does not give
// every module, by kind and then by name (byte order).
function dumpScope(mutable builder: StringBuilder, checker: Checker, scopeIndex: int) uses alloc {
  const scope = checker.scopes[scopeIndex]
  Str.append(mutable builder, `module ${quoteDump(scope.path)}\n`)
  for (const importDecl of Arrays.values(scope.imports)) {
    let kind = "std"
    if (checker.scopeIndex[importDecl.path] is Some(index)) {
      if (checker.scopes[index].isSource) {
        kind = "package"
      }
    }
    Str.append(mutable builder, `  import ${quoteDump(importDecl.path)} ${kind}`)
    if (importDecl.alias != "") {
      Str.append(mutable builder, ` alias=${importDecl.alias}`)
    }
    if (Arrays.length(importDecl.names) > 0) {
      let parts: Array<string> = []
      for (const name of Arrays.values(importDecl.names)) {
        if (name.local == name.name) {
          Arrays.push(mutable parts, name.name)
        } else {
          Arrays.push(mutable parts, `${name.name} as ${name.local}`)
        }
      }
      Str.append(mutable builder, ` names=${Str.join(parts, ",")}`)
    }
    Str.append(mutable builder, "\n")
  }
  let lines: Array<string> = []
  for (const entry of Maps.entries(scope.types)) {
    const #[name, type] = entry
    let inherited = false
    if (checker.scopes[0].types[name] is Some(preludeType)) {
      inherited = preludeType == type
    }
    if (!inherited) {
      Arrays.push(mutable lines, `type ${name} ${dumpTypeString(checker, type)}`)
    }
  }
  writeScopeLines(mutable builder, lines)
  lines = []
  for (const entry of Maps.entries(scope.generics)) {
    const #[name, generic] = entry
    let inherited = false
    if (checker.scopes[0].generics[name] is Some(preludeGeneric)) {
      inherited = preludeGeneric == generic
    }
    if (!inherited) {
      Arrays.push(mutable lines, `generic ${name} ${qualified(checker.generics[generic].module, checker.generics[generic].name)}`)
    }
  }
  writeScopeLines(mutable builder, lines)
  lines = []
  for (const entry of Maps.entries(scope.funcs)) {
    const #[name, index] = entry
    Arrays.push(mutable lines, `func ${name} ${qualified(checker.funcs[index].module, checker.funcs[index].name)}`)
  }
  writeScopeLines(mutable builder, lines)
  lines = []
  for (const entry of Maps.entries(scope.consts)) {
    const #[name, index] = entry
    Arrays.push(mutable lines, `const ${name} ${qualified(checker.consts[index].module, checker.consts[index].name)}`)
  }
  writeScopeLines(mutable builder, lines)
  lines = []
  for (const entry of Maps.entries(scope.traits)) {
    const #[name, index] = entry
    Arrays.push(mutable lines, `trait ${name} ${qualified(checker.traits[index].module, checker.traits[index].name)}`)
  }
  writeScopeLines(mutable builder, lines)
  lines = []
  for (const entry of Maps.entries(scope.imported)) {
    const #[name, index] = entry
    Arrays.push(mutable lines, `builtin ${name} ${checker.registry.funcs[index].name}`)
  }
  writeScopeLines(mutable builder, lines)
  lines = []
  for (const entry of Maps.entries(scope.modules)) {
    const #[alias, path] = entry
    Arrays.push(mutable lines, `alias ${alias} ${quoteDump(path)}`)
  }
  writeScopeLines(mutable builder, lines)
}

function writeScopeLines(mutable builder: StringBuilder, lines: Array<string>) uses alloc {
  for (const index of Arrays.values(sortedByHead(lines))) {
    Str.append(mutable builder, `  scope ${lines[index]}\n`)
  }
}
