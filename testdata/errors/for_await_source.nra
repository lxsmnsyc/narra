// error: for await reads an AsyncGenerator<T>, found Generator<int>
function* values(): Generator<int> {
  yield 1
}

async function later(value: int): int {
  return value
}

export async function run(_args: Array<string>): int {
  for await (const _value of values()) {
    print("value")
  }
  const handles = [later(1), later(2)]
  for await (const _value of handles) {
    print("value")
  }
  const count = 3
  for await (const _value of count) {
    print("value")
  }
  return 0
}
