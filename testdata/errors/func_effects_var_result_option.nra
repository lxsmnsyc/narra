// error: func_effects_var_result_option.nra:15:18: Function `quiet` uses `io` but its signature does not declare it; write `uses io`
function loud(value: int): int {
  print("x")
  return value
}

export function keep<effect E>(escaping action: (value: int) => int uses E): Option<(
  value: int,
) => int uses E> uses alloc {
  return Some(action)
}

export function quiet(): int uses alloc {
  if (keep(loud) is Some(action)) {
    return action(1)
  }
  return 0
}

export function run(args: Array<string>): int uses io, alloc {
  return quiet()
}
