// error: holds a Scope
import * as Thread from "std/thread"

struct Holder {
  scope: Thread.Scope
}

export function run(_args: Array<string>): int {
  return Thread.scope((scope) => {
    const _holder = Holder { scope: scope }
    const _scopes = [scope]
    const _pair = #[scope, 1]
    const _wrapped = Some(scope)
    const _nested = [[scope]]
    const _generic = wrap(scope)
    return 0
  })
}

function wrap<T>(value: T): Array<T> from value uses alloc {
  return [value]
}
