// Patterns: is, match, destructuring, tuples and spread literals
// (emit_match.go, emit_patterns.go). Stub from selfhost-emit-core; the owner
// is selfhost-emit-match.
import { Expr, Stmt } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported, hasWork } from "narrac/emitstate"

const NODE = "selfhost-emit-match"

// reportMatchWork is called by the driver while the program facts are
// missing, so an input that needs this node is listed. selfhost-emit-match
// removes it.
export function reportMatchWork(mutable emitter: Emitter): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `${reportUnsupported(mutable emitter, "patterns", NODE)}\n`
  }
  return ""
}

export function emitIsCondition<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "is expression", NODE), owned: false }
}

export function emitMatchValue<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "match expression", NODE), owned: false }
}

export function emitSpreadLiteral<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "spread literal", NODE), owned: false }
}

export function emitTupleLiteral<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "tuple literal", NODE), owned: false }
}

export function emitDestructure<W: EmitWalker>(walker: W, mutable emitter: Emitter, statement: Stmt) uses alloc {
  const _ = reportUnsupported(mutable emitter, "destructuring", NODE)
}

export function emitIfIs<W: EmitWalker>(walker: W, mutable emitter: Emitter, statement: Stmt) uses alloc {
  const _ = reportUnsupported(mutable emitter, "if is", NODE)
}

export function emitMatchStatement<W: EmitWalker>(walker: W, mutable emitter: Emitter, statement: Stmt) uses alloc {
  const _ = reportUnsupported(mutable emitter, "match statement", NODE)
}
