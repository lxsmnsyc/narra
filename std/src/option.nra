// std/option: helpers over the prelude Option.

@inline
export function map<T, U, effect E>(
  option: Option<T>,
  f: (value: T) => U uses E
): Option<U> uses alloc, E {
  return match (option) { Some(value) => Some(f(value)), None => None }
}

@inline
export function andThen<T, U, effect E>(
  option: Option<T>,
  f: (value: T) => Option<U> uses E
): Option<U> uses E {
  return match (option) { Some(value) => f(value), None => None }
}

export function withDefault<T>(option: Option<T>, fallback: T): T from option {
  return match (option) { Some(value) => value, None => copy(fallback) }
}

@inline
export function orElse<T, effect E>(
  option: Option<T>,
  f: () => Option<T> uses E
): Option<T> from option uses E {
  return match (option) { Some(_) => option, None => f() }
}

export function isSome<T>(option: Option<T>): bool {
  return option is Some(_)
}

export function isNone<T>(option: Option<T>): bool {
  return option is None
}

export function okOr<T, F>(option: Option<T>, error: F): Result<T, F> from option uses alloc {
  return match (option) { Some(value) => Ok(value), None => Err(copy(error)) }
}
