import * as Int from "std/int"

function show<T: Show>(value: T) uses io, alloc {
  print(Show.show(value))
}

export function run(args: Array<string>): int uses io, alloc {
  const minInt = -9223372036854775807 - 1
  const maxInt = 9223372036854775807
  print(Int.toString(0))
  print(Int.toString(7))
  print(Int.toString(-7))
  print(Int.toString(10))
  print(Int.toString(-100))
  print(Int.toString(1234567890))
  print(Int.toString(-1234567890))
  print(Int.toString(minInt))
  print(Int.toString(maxInt))
  print(Int.toString(minInt + 1))

  const minI8: i8 = -128
  const maxI8: i8 = 127
  const minI16: i16 = -32768
  const maxI16: i16 = 32767
  const minI32: i32 = -2147483648
  const maxI32: i32 = 2147483647
  show(minI8)
  show(maxI8)
  show(minI16)
  show(maxI16)
  show(minI32)
  show(maxI32)

  const zeroU8: u8 = 0
  const maxU8: u8 = 255
  const zeroU16: u16 = 0
  const maxU16: u16 = 65535
  const zeroU32: u32 = 0
  const maxU32: u32 = 4294967295
  const zeroU64: u64 = 0
  const maxU64: u64 = 18446744073709551615
  const highU64: u64 = 9223372036854775808
  show(zeroU8)
  show(maxU8)
  show(zeroU16)
  show(maxU16)
  show(zeroU32)
  show(maxU32)
  show(zeroU64)
  show(maxU64)
  show(highU64)
  return 0
}
