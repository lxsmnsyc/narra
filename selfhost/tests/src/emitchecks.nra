// The emit suite: checks of `narrac emit` that the program suites do not make.
//   emit-errors/NAME   a file without an entry function (testdata/emit-errors/
//                      noentry.nra) and an unknown binary of a package
//                      (--bin nope) exit with code 1 and print NAME.err on
//                      stderr. The messages were made by the Go compiler.
//   xxh32              `narrac hash SEED TEXT` gives the xxHash32 test vectors
//   cnames/ignore-directory   the same package in two different folders
//                      gives the same C
//   cnames/stable-under-edits   adding an unrelated function does not change
//                      the C names of the types the program already had
//   proven-operands/no-panic-path   the C of a program with proven divisors and
//                      shift counts has no division or shift panic
//   endless-loop/return-type   the C of testdata/endless_loop_returns.nra, whose
//                      functions end in an endless loop, compiles with
//                      -Werror=return-type
//   build-conditions/one-branch   the C of testdata/build_os.nra holds the
//                      host's branch of an if on Build.os and no other
//   build-conditions/unsupported-host   with NARRA_HOST_TARGET naming no
//                      supported target, a program importing std/build fails
//                      with one error per module
//   tree-shake/unreached   the C of testdata/tree_shake.nra has no unreached
//                      function, generic instance, trait implementation or
//                      constant
//   tree-shake/std-source   the C of bench/fib/fib.nra has none of the
//                      std/int functions written in Narra, which it never calls
//   tree-shake/unused-types   the C of bench/fib/fib.nra has no type that only
//                      unreached code uses, and no array function it never calls
//   build-targets/outside-branch   `narrac check --all-targets` reports a use
//                      of a `@target` function outside a guaranteeing branch
//                      once per target it fails on
//   build-targets/other-target   a use that passes `narrac check` on a
//                      Linux-X86_64 host fails `check --all-targets` on Linux-Arm64
//   build-targets/release-only   a use kept only when Build.debug is false
//                      fails `check --all-targets` in the release builds
//   build-targets/extern-outside-branch   the same for a function of a `@target`
//                      extern block
//   audit/basic        `narrac audit` lists the unsafe blocks and @trusted
//                      functions of testdata/audit/basic
//   const-generics/distinct-instances   in the C of testdata/const_generics.nra,
//                      instances that differ only in a constant type argument
//                      (repeat<1>, repeat<2>, repeat<3>; Vector<1>, Vector<2>,
//                      Vector<3>) have C names of their own
//   inline/no-closure  the C of testdata/inline.nra has no C function for the
//                      @inline function applyTwice, and no closure function or
//                      environment for its arrow argument
import { splitString } from "testrunner/textops"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Path from "std/path"
import * as Ranges from "std/range"
import * as Str from "std/string"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"
import * as Scratch from "testrunner/scratch"
import * as Shell from "testrunner/shell"
import { readHostSystem } from "testrunner/programs"

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  const emitErrors = Path.join(context.testdata, "emit-errors")
  const cnames = Path.join(context.testdata, "cnames")
  const buildTargets = Path.join(context.testdata, "build-targets")
  return [
    makeCase("emit-errors/noentry", Path.join(emitErrors, "noentry.nra"), "noentry"),
    makeCase(
      "emit-errors/unknown_binary",
      Path.join(emitErrors, "unknown_binary.err"),
      "unknown_binary",
    ),
    makeCase(
      "cnames/ignore-directory",
      Path.join(Path.join(context.testdata, "packages"), "cnames_modules"),
      "ignore-directory",
    ),
    makeCase("cnames/stable-under-edits", cnames, "stable-under-edits"),
    makeCase("xxh32", cnames, "xxh32"),
    makeCase(
      "proven-operands/no-panic-path",
      Path.join(context.testdata, "proven_operands.nra"),
      "no-panic-path",
    ),
    makeCase(
      "endless-loop/return-type",
      Path.join(context.testdata, "endless_loop_returns.nra"),
      "endless-loop",
    ),
    makeCase(
      "build-conditions/one-branch",
      Path.join(context.testdata, "build_os.nra"),
      "one-branch",
    ),
    makeCase(
      "build-conditions/unsupported-host",
      Path.join(context.testdata, "build_os.nra"),
      "unsupported-host",
    ),
    makeCase("tree-shake/unreached", Path.join(context.testdata, "tree_shake.nra"), "unreached"),
    makeCase(
      "tree-shake/std-source",
      Path.join(Path.dirname(context.testdata), "bench/fib/fib.nra"),
      "std-source",
    ),
    makeCase(
      "tree-shake/unused-types",
      Path.join(Path.dirname(context.testdata), "bench/fib/fib.nra"),
      "unused-types",
    ),
    makeCase(
      "build-targets/outside-branch",
      Path.join(buildTargets, "outside_branch.nra"),
      "outside-branch",
    ),
    makeCase(
      "build-targets/other-target",
      Path.join(buildTargets, "other_target.nra"),
      "other-target",
    ),
    makeCase(
      "build-targets/release-only",
      Path.join(buildTargets, "release_only.nra"),
      "release-only",
    ),
    makeCase(
      "build-targets/extern-outside-branch",
      Path.join(buildTargets, "extern_outside_branch.nra"),
      "extern-outside-branch",
    ),
    makeCase("audit/basic", Path.join(Path.join(context.testdata, "audit"), "basic"), "audit"),
    makeCase(
      "const-generics/distinct-instances",
      Path.join(context.testdata, "const_generics.nra"),
      "distinct-instances",
    ),
    makeCase("inline/no-closure", Path.join(context.testdata, "inline.nra"), "no-closure"),
  ]
}

function makeCase(name: string, path: string, variant: string): TestCase {
  return TestCase { suite: "emit", name: name, path: path, variant: variant }
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  if (testCase.variant == "noentry") {
    return expectEmitError(context, ["emit", testCase.path], testCase.path, "noentry.err")
  }
  if (testCase.variant == "unknown_binary") {
    const packagePath = Path.join(Path.join(context.testdata, "packages"), "app")
    return expectEmitError(
      context,
      ["emit", "--bin", "nope", packagePath],
      testCase.path,
      "unknown_binary.err",
    )
  }
  if (testCase.variant == "no-panic-path") {
    return checkNoOperandPanic(context, testCase.path)
  }
  if (testCase.variant == "endless-loop") {
    return checkEndlessLoop(context, testCase.path)
  }
  if (testCase.variant == "one-branch") {
    return checkOneBranch(context, testCase.path)
  }
  if (testCase.variant == "unsupported-host") {
    return checkUnsupportedHost(context, testCase.path)
  }
  if (testCase.variant == "unreached") {
    return checkUnreached(context, testCase.path)
  }
  if (testCase.variant == "distinct-instances") {
    return checkDistinctInstances(context, testCase.path)
  }
  if (testCase.variant == "no-closure") {
    return checkInlineCopied(context, testCase.path)
  }
  if (testCase.variant == "std-source") {
    return checkStdSourceShaken(context, testCase.path)
  }
  if (testCase.variant == "unused-types") {
    return checkUnusedTypesShaken(context, testCase.path)
  }
  if (testCase.variant == "outside-branch") {
    return checkAllTargets(context, testCase.path, "outside_branch.err", false)
  }
  if (testCase.variant == "other-target") {
    return checkAllTargets(context, testCase.path, "other_target.err", true)
  }
  if (testCase.variant == "extern-outside-branch") {
    return checkAllTargets(context, testCase.path, "extern_outside_branch.err", false)
  }
  if (testCase.variant == "audit") {
    return checkAudit(context, testCase.path)
  }
  if (testCase.variant == "release-only") {
    return checkAllTargets(context, testCase.path, "release_only.err", false)
  }
  if (testCase.variant == "xxh32") {
    return checkHashVectors(context)
  }
  if (testCase.variant == "ignore-directory") {
    return checkIgnoreDirectory(context, testCase.path)
  }
  return checkStableUnderEdits(context, testCase.path)
}

function expectEmitError(
  context: Context,
  arguments: Array<string>,
  goldenPath: string,
  goldenName: string,
): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, arguments)
  if (result.code != 1 || result.output != "") {
    return Err(`want exit code 1 and no stdout, got ${Common.describeRun(result)}`)
  }
  const want = Common.readExpected(Path.join(Path.dirname(goldenPath), goldenName))
  if (want is Err(message)) {
    return Err(message)
  }
  return Common.compareText("stderr", want.value, result.errorOutput)
}

function checkNoOperandPanic(
  context: Context,
  source: string,
): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  const forbidden = ["division by zero", "shift count out of range"]
  for (const text of Arrays.values(forbidden)) {
    if (Str.contains(result.output, text)) {
      return Err(`the emitted C has a panic path: ${text}`)
    }
  }
  if (!Str.contains(result.output, "narra_div(") || !Str.contains(result.output, "narra_shl(")) {
    return Err("the emitted C has no division or shift to check")
  }
  return Ok(true)
}

function checkEndlessLoop(context: Context, source: string): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  const made = Scratch.makeScratch()
  if (made is Err(message)) {
    return Err(message)
  }
  const scratch = made.value
  const target = Path.join(scratch.work, "endless.c")
  let outcome: Result<bool, string> = Ok(true)
  const written = Scratch.writeFile(target, result.output)
  if (written is Err(message)) {
    outcome = Err(message)
  } else {
    const compiled = Shell.runScript(
      "cc -std=c11 -Wreturn-type -Werror=return-type -fsyntax-only \"$1\"",
      [target],
    )
    if (compiled.code != 0) {
      outcome = Err(`cc rejects the C: ${Common.describeRun(compiled)}`)
    }
  }
  Scratch.removeScratch(scratch)
  return outcome
}

function checkOneBranch(context: Context, source: string): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  // Each branch returns its own string; only the host's may reach the C.
  let kept = "kept the Linux branch"
  if (readHostSystem() == "darwin") {
    kept = "kept the macOS branch"
  }
  const branches = ["kept the macOS branch", "kept the Linux branch", "kept the Windows branch"]
  for (const text of Arrays.values(branches)) {
    if (Str.contains(result.output, text) != (text == kept)) {
      return Err(`the emitted C should hold only "${kept}"; "${text}" is wrong`)
    }
  }
  return Ok(true)
}

function checkInlineCopied(context: Context, source: string): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  // The callee's C name ends in its own name; closures and environments use narra_env.
  for (const text of Arrays.values(["_applyTwice", "narra_env"])) {
    if (Str.contains(result.output, text)) {
      return Err(`the emitted C should not hold "${text}"`)
    }
  }
  if (!Str.contains(result.output, "narra_inline_")) {
    return Err("the emitted C has no copied body")
  }
  return Ok(true)
}

function checkDistinctInstances(
  context: Context,
  source: string,
): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  // Each name is followed by the hash of its arguments; count the different hashes.
  const expected: Array<#[string, int]> = [#["_repeat_", 3], #["_Vector_", 3], #["_share_", 2]]
  for (const entry of Arrays.values(expected)) {
    const #[name, count] = entry
    const found = countHashes(result.output, name)
    if (found != count) {
      return Err(
        `expected ${Int.toString(count)} C names for ${name}, found ${Int.toString(found)}`,
      )
    }
  }
  return Ok(true)
}

function countHashes(output: string, name: string): int uses alloc {
  let hashes: Map<string, bool> = Map {}
  let count = 0
  const pieces = splitString(output, name)
  for (const index of Ranges.between(1, Arrays.length(pieces))) {
    const piece = pieces[index]
    if (Str.slice(piece, 0, 8) is Some(hash)) {
      if (hashes[hash] is None) {
        hashes[hash] = true
        count++
      }
    }
  }
  return count
}

function checkUnreached(context: Context, source: string): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  // Names of the reached declarations must be in the C, the unreached ones must not.
  const reached = ["reachedHelper", "Shown_Show_show_", "usedNames"]
  for (const name of Arrays.values(reached)) {
    if (!Str.contains(result.output, name)) {
      return Err(`the emitted C should hold "${name}"`)
    }
  }
  const unreached = ["unreachedHelper", "Hidden_Show_show_", "unreachedNames"]
  for (const name of Arrays.values(unreached)) {
    if (Str.contains(result.output, name)) {
      return Err(`the emitted C should not hold "${name}"`)
    }
  }
  // pick has an int and a string instance; only the int one is reached.
  let definitions = 0
  for (const line of Arrays.values(splitString(result.output, "\n"))) {
    if (
      Str.startsWith(line, "static ") && Str.contains(line, "_pick_") && Str.endsWith(line, "{")
    ) {
      definitions++
    }
  }
  if (definitions != 1) {
    return Err(`want one definition of an instance of pick, got ${Int.toString(definitions)}`)
  }
  return Ok(true)
}

function checkStdSourceShaken(
  context: Context,
  source: string,
): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  for (const name of Arrays.values(["_compare(", "_divmod(", "_floorDiv("])) {
    if (Str.contains(result.output, name)) {
      return Err(`the emitted C should not hold "${name}"`)
    }
  }
  return Ok(true)
}

function checkUnusedTypesShaken(
  context: Context,
  source: string,
): Result<bool, string> uses io, alloc {
  // fib reaches Array<string> (the arguments) through main only, by _new and
  // _release. Option<int> and #[int, int] come from std/int functions it never
  // calls.
  const result = Common.runNarrac(context, ["emit", source])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  for (const text of Arrays.values([
    "= Option<int> */",
    "= #[int, int] */",
    "_get(",
    "_push(",
    "_filled(",
  ])) {
    if (Str.contains(result.output, text)) {
      return Err(`the emitted C should not hold "${text}"`)
    }
  }
  for (const text of Arrays.values(["= Array<string> */", "_new(int64_t cap)", "_release("])) {
    if (!Str.contains(result.output, text)) {
      return Err(`the emitted C should hold "${text}"`)
    }
  }
  return Ok(true)
}

function checkUnsupportedHost(
  context: Context,
  source: string,
): Result<bool, string> uses io, alloc {
  // NARRA_HOST_TARGET names a host with no target. The sample imports std/build
  // twice, and the error comes once for the module.
  const result = Common.runNarracWith(
    context,
    "",
    ["NARRA_HOST_TARGET=Plan9-mips"],
    ["check", source],
  )
  const want = "std/build has no target for this host (Plan9-mips)"
  const count = Arrays.length(splitString(result.errorOutput, want)) - 1
  if (result.code != 1 || count != 1) {
    return Err(`want exit code 1 and "${want}" once, got ${Common.describeRun(result)}`)
  }
  return Ok(true)
}

function checkAllTargets(
  context: Context,
  source: string,
  goldenName: string,
  passesOnHost: bool,
): Result<bool, string> uses io, alloc {
  // The error must be on a target other than the host's.
  if (passesOnHost) {
    const host = Common.runNarracWith(
      context,
      "",
      ["NARRA_HOST_TARGET=Linux-X86_64"],
      ["check", source],
    )
    if (host.code != 0) {
      return Err(`want no error for Linux-X86_64, got ${Common.describeRun(host)}`)
    }
  }
  return expectEmitError(context, ["check", "--all-targets", source], source, goldenName)
}

function checkAudit(context: Context, folder: string): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["audit", folder])
  if (result.code != 0 || result.errorOutput != "") {
    return Err(`audit failed: ${Common.describeRun(result)}`)
  }
  const want = Common.readExpected(Path.join(folder, "expected.txt"))
  if (want is Err(message)) {
    return Err(message)
  }
  return Common.compareText("stdout", want.value, result.output)
}

function emitIn(context: Context, folder: string): Result<string, string> uses io, alloc {
  const result = Common.runNarracWith(context, folder, [], ["emit", "."])
  if (result.code != 0) {
    return Err(`emit failed in ${folder}: ${Common.describeRun(result)}`)
  }
  return Ok(result.output)
}

function checkIgnoreDirectory(
  context: Context,
  source: string,
): Result<bool, string> uses io, alloc {
  const made = Scratch.makeScratch()
  if (made is Err(message)) {
    return Err(message)
  }
  const scratch = made.value
  let outcome: Result<bool, string> = Ok(true)
  const first = Path.join(scratch.work, "one")
  const second = Path.join(Path.join(Path.join(scratch.work, "two"), "deeper"), "still")
  const prepared = Shell.runScript(
    "mkdir -p \"$2\" \"$3\" && cp -R \"$1\"/. \"$2\" && cp -R \"$1\"/. \"$3\"",
    [source, first, second],
  )
  if (prepared.code != 0) {
    outcome = Err(`cannot copy the package: ${Common.describeRun(prepared)}`)
  } else {
    outcome = compareEmits(context, first, second)
  }
  Scratch.removeScratch(scratch)
  return outcome
}

function compareEmits(
  context: Context,
  first: string,
  second: string,
): Result<bool, string> uses io, alloc {
  const firstC = emitIn(context, first)
  if (firstC is Err(message)) {
    return Err(message)
  }
  const secondC = emitIn(context, second)
  if (secondC is Err(message)) {
    return Err(message)
  }
  if (firstC.value != secondC.value) {
    return Err("the C differs between directories")
  }
  if (!Str.contains(firstC.value, "/* S_Tuple2_")) {
    return Err("no comment table for the tuple types")
  }
  return Ok(true)
}

function tableLines(c: string): Array<string> uses alloc {
  let lines: Array<string> = []
  for (const line of Arrays.values(splitString(c, "\n"))) {
    if (Str.startsWith(line, "/* ") && Str.endsWith(line, " */") && Str.contains(line, " = ")) {
      Arrays.push(mutable lines, line)
    }
  }
  return lines
}

function emitAsProgram(
  context: Context,
  scratch: Scratch.Scratch,
  source: string,
  folderName: string,
): Result<string, string> uses io, alloc {
  const text = Scratch.readFile(source)
  if (text is Err(message)) {
    return Err(message)
  }
  // The C names of a module come from its file name, so both versions need the same one.
  const target = Path.join(Path.join(scratch.work, folderName), "prog.nra")
  const written = Scratch.writeFile(target, text.value)
  if (written is Err(message)) {
    return Err(message)
  }
  const result = Common.runNarrac(context, ["emit", target])
  if (result.code != 0) {
    return Err(`emit failed: ${Common.describeRun(result)}`)
  }
  return Ok(result.output)
}

function checkStableUnderEdits(
  context: Context,
  folder: string,
): Result<bool, string> uses io, alloc {
  const made = Scratch.makeScratch()
  if (made is Err(message)) {
    return Err(message)
  }
  const scratch = made.value
  const base = emitAsProgram(context, scratch, Path.join(folder, "base.nra"), "base")
  const edited = emitAsProgram(context, scratch, Path.join(folder, "edited.nra"), "edited")
  Scratch.removeScratch(scratch)
  if (base is Err(message)) {
    return Err(message)
  }
  if (edited is Err(message)) {
    return Err(message)
  }
  const baseTable = tableLines(base.value)
  const editedTable = tableLines(edited.value)
  if (Arrays.length(baseTable) < 4) {
    return Err(`too few interned types: ${Str.join(baseTable, "; ")}`)
  }
  for (const line of Arrays.values(baseTable)) {
    let found = false
    for (const other of Arrays.values(editedTable)) {
      if (other == line) {
        found = true
      }
    }
    if (!found) {
      return Err(`a type name changed or is gone after the edit: ${line}`)
    }
  }
  return Ok(true)
}

// The test vectors of xxHash32: the seed (decimal), the text and the hash.
const HASH_SEED = "2654435761"

const HASH_VECTORS = [
  ["0", "", "02cc5d05"],
  ["0", "abc", "32d153ff"],
  ["0", "Nobody inspects the spammish repetition", "e2293b2f"],
  ["0", "abcdefghijklmno", "b918a375"],
  ["0", "abcdefghijklmnop", "9d2d8b62"],
  ["0", "abcdefghijklmnopq", "b3b873e1"],
  [HASH_SEED, "abc", "a1ae7709"],
  [HASH_SEED, "abcdefghijklmnop", "3fab7bd8"],
]

function checkHashVectors(context: Context): Result<bool, string> uses io, alloc {
  for (const vector of Arrays.values(HASH_VECTORS)) {
    const result = Common.runNarrac(context, ["hash", vector[0], vector[1]])
    const want = `${vector[2]}\n`
    if (result.code != 0 || result.output != want) {
      return Err(
        `hash ${vector[0]} "${vector[1]}": want ${vector[2]}, got ${Common.describeRun(result)}`,
      )
    }
  }
  return Ok(true)
}
