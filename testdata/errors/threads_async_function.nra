// error: a thread function cannot be async
import * as Thread from "std/thread"

async function count(): int {
  return 1
}

export function run(_args: Array<string>): int {
  return Thread.scope((scope) => {
    const _first = Thread.start(scope, async () => 1)
    const _second = Thread.start(scope, count)
    return 0
  })
}
