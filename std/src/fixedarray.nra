// std/fixedarray: helpers over FixedArray. An index written as values[i] must be
// proven in range; get checks the index and returns None outside it.

export function get<T, const N: int>(values: FixedArray<T, N>, index: int): Option<T> from values {
  if (index >= 0 && index < N) {
    return Some(values[index])
  }
  return None
}

export function length<T, const N: int>(_values: FixedArray<T, N>): int {
  return N
}
