import * as Int from "std/int"
import * as Str from "std/string"

function greet(name: string): string {
  return `Hello, ${name}!`
}

export function run(args: Array<string>): int {
  const g = greet("Narra")
  print(g)
  print(Int.toString(Str.length(g)))
  print(Str.concat("ab", "cd"))
  print(Str.repeat("-", 5))
  print(Str.fromChar('λ'))
  if ("apple" < "banana" && g != "x") {
    print("ordered")
  }
  let s = ""
  for (const i of Range.upTo(3)) {
    s = `${s}${Int.toString(i)}`
  }
  print(s)
  return 0
}
