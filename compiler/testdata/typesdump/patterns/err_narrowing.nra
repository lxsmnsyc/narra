enum Shape {
  Circle(radius: int)
  Square(side: int)
}

enum Wide {
  A
  B
  C
  D
  E
  F
  G
  H
  I
  J
  K
  L
  M
}

function leaksPastIf(shape: Shape): int {
  if (shape is Shape.Circle(_)) {
    const inside = shape.radius
  }
  return shape.radius
}

function leaksPastElse(shape: Shape): int {
  if (shape is Shape.Circle(_)) {
    return 0
  } else {
    const inside = shape.side
  }
  return shape.side
}

function mutableNotNarrowed(shape: Shape): int {
  let current = shape
  if (current is Shape.Circle(_)) {
    return current.radius
  }
  return 0
}

function wrongVariantField(shape: Shape): int {
  if (shape is Shape.Circle(_)) {
    return shape.side
  }
  return 0
}

function beyondLimit(wide: Wide): int {
  return match (wide) {
    Wide.A => 1
  }
}
