// The panics suite: each sample in testdata/panics must stop with exit code
// 101 and a message on stderr, built with the sanitizers and the leak check.
import * as Arrays from "std/array"
import * as Path from "std/path"
import * as Str from "std/string"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"

struct PanicSample {
  file: string
  message: string
}

// The message each sample must print (a part of the stderr text).
const SAMPLES = [
  PanicSample { file: "bounds.nra", message: "index 5 out of range for length 2" },
  PanicSample {
    file: "strings2_charat_end.nra",
    message: "Str.charAt: position 2 is at the end of the string",
  },
  PanicSample {
    file: "strings2_nextchar_past.nra",
    message: "Str.nextChar: position 5 out of range for length 2",
  },
  PanicSample {
    file: "strings2_byteat_range.nra",
    message: "Str.byteAt: position 2 out of range for length 2",
  },
  PanicSample { file: "inline_bounds.nra", message: "index 8 out of range for length 2" },
  PanicSample { file: "threads_panic.nra", message: "thread failed with 3" },
]

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  for (const sample of Arrays.values(SAMPLES)) {
    const path = Path.join(Path.join(context.testdata, "panics"), sample.file)
    Arrays.push(mutable cases, TestCase {
      suite: "panics",
      name: sample.file,
      path: path,
      variant: sample.message,
    })
  }
  return cases
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["run", "-sanitize", testCase.path])
  if (result.code != 101 || !Str.contains(result.errorOutput, testCase.variant)) {
    return Err(
      `want a panic with "${testCase.variant}" and exit code 101, got ${Common.describeRun(result)}`,
    )
  }
  return Ok(true)
}
