// error: release_only.nra:15:20: linuxName exists only on @target(os = Os.Linux), but this use is compiled for MacOS-Arm64 (release), MacOS-X86_64 (release); ...
// A condition on Build.debug keeps the use in release builds only, so the
// debug check passes and `check --all-targets` finds it in the release builds
// of both macOS targets.
import * as Build from "std/build"
import { Os } from "std/build"

@target(os = Os.Linux)
function linuxName(): string {
  return "linux"
}

export function run(args: Array<string>): int {
  if (!Build.debug) {
    print(linuxName())
  }
  return 0
}
