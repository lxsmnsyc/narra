enum Chain {
  Link(name: string, next: Chain)
  End
}

enum Wrap {
  Pair(left: Chain, right: Chain)
  Nothing
}

function describeName(wrap: Wrap): string {
  match (wrap) {
    Wrap.Pair(Chain.Link(n, _), _) | Wrap.Pair(_, Chain.Link(n, _)) => {
      return n
    }
    _ => {}
  }
  return "none"
}

function describeGuarded(wrap: Wrap): string {
  match (wrap) {
    Wrap.Pair(Chain.Link(n, _), _) | Wrap.Pair(_, Chain.Link(n, _)) if (n == "long") => {
      return `guarded ${n}`
    }
    Wrap.Pair(Chain.Link(n, _), _) | Wrap.Pair(_, Chain.Link(n, _)) => {
      return `plain ${n}`
    }
    _ => {}
  }
  return "none"
}

function describeDepths(wrap: Wrap): string {
  match (wrap) {
    Wrap.Pair(Chain.Link(a, Chain.Link(b, _)), _)
      | Wrap.Pair(_, Chain.Link(b, Chain.Link(a, _))) => {
      return `${a} ${b}`
    }
    _ => {}
  }
  return "none"
}

export function run(args: Array<string>): int {
  const end = Chain.End
  print(describeName(Wrap.Pair(Chain.Link("left", end), end)))
  print(describeName(Wrap.Pair(end, Chain.Link("right", end))))
  print(describeName(Wrap.Pair(end, end)))
  print(describeName(Wrap.Nothing))
  print(describeGuarded(Wrap.Pair(Chain.Link("long", end), end)))
  print(describeGuarded(Wrap.Pair(end, Chain.Link("long", end))))
  print(describeGuarded(Wrap.Pair(Chain.Link("short", end), end)))
  print(describeGuarded(Wrap.Pair(end, end)))
  print(describeDepths(Wrap.Pair(Chain.Link("a1", Chain.Link("b1", end)), end)))
  print(describeDepths(Wrap.Pair(end, Chain.Link("b2", Chain.Link("a2", end)))))
  print(describeDepths(Wrap.Pair(Chain.Link("a3", end), end)))
  return 0
}
