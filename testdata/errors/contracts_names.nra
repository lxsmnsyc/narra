// error: requires compares an integer parameter with an integer constant, joined by &&; compare one integer parameter with a constant, as in `count >= 0`
// A parameter named like a module constant is the parameter, and a bound
// must fit the parameter's type.
const margin = 10

function shifted(value: int, margin: int): int
  requires value > margin - 5
{
  return 100 / value + margin
}

export function small(value: u8): u8
  requires value < 255 + 1
{
  return 10 / value
}

export function run(_args: Array<string>): int {
  return shifted(6, 1) + margin
}
