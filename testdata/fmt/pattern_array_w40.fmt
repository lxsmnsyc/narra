function describe(
  items: Array<string>,
): string {
  const [...all] = items
  return match (items) {
    [] => "none"
    [only] => only
    [first, ..._] if (first == "a") =>
      first
    [
      _,
      "hash",
      text,
      output,
      ...others
    ] => text
    [first, ...rest] => first
  }
}
