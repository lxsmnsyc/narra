// typeof in a type position stands for the type of a value in scope: a local,
// a parameter, a top-level constant or a function, with its effects and from.
import * as Arrays from "std/array"
import * as Int from "std/int"

const limit: int = 3
const greeting = "hi"
const names: Array<string> = ["ann", "bo"]

struct Request {
  path: string
}

export function handle(request: Request): string from request uses io {
  print(request.path)
  return request.path
}

export type Handler = typeof handle

function tally(counts: Map<string, int>, key: string): int {
  const copied: typeof counts = copy(counts)
  const fallback: typeof limit = 0
  if (copied[key] is Some(found)) {
    return found
  }
  return fallback
}

function replay(handler: Handler, request: Request): string from request uses io {
  return handler(request)
}

function label(request: Request, other: typeof request): string {
  return `${request.path}${other.path}`
}

function fill(target: typeof limit, base: typeof names): int {
  const local = Arrays.length(base)
  const rows: Array<typeof local> = [local, target]
  return rows[0] + rows[1]
}

export function run(_args: Array<string>): int uses io {
  const counts: Map<string, int> = Map { "a": 2 }
  const same: typeof counts = Map { "b": 5 }
  const again: typeof greeting = "yo"
  print(again)
  print(Int.toString(tally(counts, "a")))
  print(Int.toString(tally(same, "b")))
  print(replay(handle, Request { path: "/home" }))
  print(label(Request { path: "x" }, Request { path: "y" }))
  print(Int.toString(fill(limit, names)))
  return 0
}
