// An async entry: the value of its Async<int> is the exit code.
import * as Async from "std/async"

async function code(base: int): int uses io, alloc {
  await Async.idle()
  print("computed")
  return base + 2
}

export async function run(_args: Array<string>): int {
  print("entry starts")
  return await code(3)
}
