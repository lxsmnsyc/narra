import * as Int from "std/int"
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  const names = ["a", "b", "c"]
  const window = Ranges.between(0, 3)
  // continue and break with a label, over an array value and a Range value
  outer: for (const name of names) {
    for (const i of window) {
      if (i == 1) {
        continue outer
      }
      print(`${name}${Int.toString(i)}`)
    }
  }
  done: for (const i of window) {
    for (const name of names) {
      if (i == 1) {
        break done
      }
      print(`${Int.toString(i)}${name}`)
    }
  }
  return 0
}
