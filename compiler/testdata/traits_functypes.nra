// Function types compare by their parameters and result, and give
// different C names per signature. The parameters are escaping because
// they are stored or returned.

struct Box<T> {
  value: T
}

function same(escaping g: (x: int) => int): (x: int) => int {
  return g
}

function id<T>(v: T): T {
  return v
}

function viaGeneric(escaping g: (x: int) => int): (y: int) => int {
  return id(g)
}

function wrap(escaping g: (x: int) => int): Box<(x: int) => int> {
  return Box { value: g }
}

function wrapBool(escaping g: (x: bool) => int): Box<(x: bool) => int> {
  return Box { value: g }
}

function unwrap(b: Box<(x: int) => int>): (x: int) => int {
  return b.value
}

export function run(args: Array<string>): int {
  print("function types check")
  const f = unwrap(wrap(viaGeneric(same((x: int): int => x + 1))))
  const b = wrapBool((x) => 2)
  print(`${Show.show(f(1))} ${Show.show(b.value(true))}`)
  return 0
}
