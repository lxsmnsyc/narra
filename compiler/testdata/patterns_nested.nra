import * as Int from "std/int"

enum Tree {
  Leaf
  Node(label: string, weight: int)
}

enum Shape {
  Circle(radius: int)
  Square(side: int)
}

enum Wrapped {
  One(inner: Option<Tree>)
  Two(first: Shape, second: Option<Shape>)
}

function describe(t: Option<Tree>): string {
  return match (t) {
    None => "nothing"
    Some(Tree.Leaf) => "a leaf"
    Some(Tree.Node("root", _)) => "the root"
    Some(Tree.Node(label, w)) if (w > 10) => `heavy ${label}`
    Some(Tree.Node(label, 0)) => `empty ${label}`
    Some(Tree.Node(label, w)) => `${label} weighs ${Int.toString(w)}`
  }
}

function pair(w: Wrapped): string {
  return match (w) {
    Wrapped.One(None) => "one: none"
    Wrapped.One(Some(tree)) => `one: ${describe(Some(tree))}`
    Wrapped.Two(Shape.Circle(r), None) => `circle ${Int.toString(r)} alone`
    Wrapped.Two(Shape.Circle(_), Some(Shape.Circle(_))) => "two circles"
    Wrapped.Two(Shape.Square(s), Some(Shape.Square(t))) if (s == t) => "equal squares"
    Wrapped.Two(_, Some(other)) => match (other) {
      Shape.Circle(r) => `then circle ${Int.toString(r)}`
      Shape.Square(s) => `then square ${Int.toString(s)}`
    }
    Wrapped.Two(Shape.Square(_), None) => "square alone"
  }
}

function order(a: int, b: int): string {
  return match (Ordered.compare(a, b)) {
    Ordering.Less => "less"
    Ordering.Equal => "equal"
    Ordering.Greater => "greater"
  }
}

function word(n: int, loud: bool): string {
  return match (n) {
    0 => "zero"
    -1 => "minus one"
    _ => match (loud) {
      true => "MANY"
      false => "many"
    }
  }
}

function greet(name: string): string {
  return match (name) {
    "" => "nobody"
    "Ana" => "hi Ana"
    other => `hello ${other}`
  }
}

export function run(args: Array<string>): int {
  print(describe(None))
  print(describe(Some(Tree.Leaf)))
  print(describe(Some(Tree.Node("root", 3))))
  print(describe(Some(Tree.Node("big", 20))))
  print(describe(Some(Tree.Node("box", 0))))
  print(describe(Some(Tree.Node("cup", 4))))
  print(pair(Wrapped.One(None)))
  print(pair(Wrapped.One(Some(Tree.Node("x", 1)))))
  print(pair(Wrapped.Two(Shape.Circle(2), None)))
  print(pair(Wrapped.Two(Shape.Circle(2), Some(Shape.Circle(3)))))
  print(pair(Wrapped.Two(Shape.Square(2), Some(Shape.Square(2)))))
  print(pair(Wrapped.Two(Shape.Square(2), Some(Shape.Square(5)))))
  print(pair(Wrapped.Two(Shape.Square(2), Some(Shape.Circle(7)))))
  print(pair(Wrapped.Two(Shape.Square(1), None)))
  print(order(1, 2))
  print(order(2, 2))
  print(order(3, 2))
  print(word(0, false))
  print(word(-1, false))
  print(word(5, true))
  print(word(5, false))
  print(greet(""))
  print(greet("Ana"))
  print(greet("Bo"))
  const t: Option<Tree> = Some(Tree.Node("deep", 1))
  if (t is Some(Tree.Node(label, 1))) {
    print(`is: ${label}`)
  }
  if (t is Some(Tree.Leaf)) {
    print("leaf")
  } else {
    print("not a leaf")
  }
  const leafy = t is Some(Tree.Leaf) || t is None
  if (!leafy) {
    print("has a node")
  }
  return 0
}
