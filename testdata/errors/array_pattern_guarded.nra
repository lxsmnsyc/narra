// error: match does not cover [_, ..._]; add the cases or a `_` arm
// A guarded arm does not count toward exhaustiveness.
function first(items: Array<int>): int {
  return match (items) { [] => 0, [head, ..._] if (head > 0) => head }
}

export function run(_args: Array<string>): int {
  return first([1])
}
