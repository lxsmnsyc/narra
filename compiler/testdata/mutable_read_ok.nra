import * as Int from "std/int"

function bump(mutable n: int): int {
  n = n + 10
  return 1
}

function pair(a: int, b: int): int {
  return a * 100 + b
}

function describe(mutable n: int, flag: bool): string {
  n = n + 1
  if (flag) {
    return "yes"
  }
  return "no"
}

export function run(args: Array<string>): int {
  // Two mutable calls on different variables in one expression.
  let a = 1
  let b = 2
  const first = pair(bump(mutable a), bump(mutable b))
  print(Int.toString(first))
  print(Int.toString(a))
  print(Int.toString(b))

  // The left side of && finishes before the right side starts.
  let c = 0
  if (c == 0 && bump(mutable c) == 1) {
    print(Int.toString(c))
  }

  // Different arms of a match never run together.
  let d = 5
  const label = match (a) {
    11 => describe(mutable d, true)
    _ => describe(mutable d, false)
  }
  print(label)
  print(Int.toString(d))

  // A mutable call in its own statement, then the read.
  let e = 1
  const result = bump(mutable e)
  print(Int.toString(e + result))

  // Sibling arms with blocks, and statements one after the other in a block.
  let g = 1
  const flag: Option<int> = Some(1)
  match (flag) {
    Some(v) => {
      bump(mutable g)
      print(Int.toString(g + v))
    }
    None => {
      bump(mutable g)
    }
  }
  return 0
}
