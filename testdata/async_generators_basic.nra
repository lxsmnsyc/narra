// An async generator awaits a sleep between its yields. A reader asks for
// each value with Async.next and gets them in order, then None once the body
// has ended, and None again for every later step.
import * as Int from "std/int"
import * as Async from "std/async"
import * as Time from "std/time"
import { sleep } from "std/async/time"

async function* countdown(start: int, label: string): AsyncGenerator<string> uses (io, alloc) {
  for (let count = start; count > 0; count--) {
    const slept = await sleep(Time.milliseconds(1))
    if (slept is Err(_)) {
      return
    }
    yield `${label} ${Int.toString(count)}`
  }
  print(`${label} ends`)
}

export async function run(_args: Array<string>): int {
  const stream = countdown(3, "tick")
  while (true) {
    const next = await Async.next(stream)
    if (next is Some(value)) {
      print(value)
    } else {
      print("None")
      break
    }
  }
  const after = await Async.next(stream)
  if (after is None) {
    print("None again")
  }
  return 0
}
