import * as Int from "std/int"

struct Button {
  label: string
  onClick: (times: int) => string
}

function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

function applyTwice(f: (x: int) => int, x: int): int {
  return apply(f, apply(f, x))
}

function double(x: int): int {
  return x * 2
}

function adder(n: int): (x: int) => int {
  return (x: int): int => x + n
}

function compose(escaping f: (x: int) => int, escaping g: (x: int) => int): (x: int) => int {
  return (x) => g(f(x))
}

function greeter(greeting: string, names: Array<string>): (i: int) => string {
  return (i) => `${greeting}, ${names[i]}`
}

function run(args: Array<string>): int {
  const rate = 10
  const label = "item"

  // Non-capturing, capturing, stack and heap environments.
  print(Int.toString(apply((x) => x + 1, 1)))
  print(Int.toString(apply((x) => x + rate, 1)))
  print(Int.toString(applyTwice((x) => x * rate + rate, 1)))
  const kept = (x: int): int => x + rate

  // Nested arrows capture through the inner one.
  const outer = (a: int) => (b: int) => a + b + rate
  print(Int.toString(outer(1)(2)))

  // Function names as values, calls of values and fields holding functions.
  print(Int.toString(apply(double, 21)))
  const add5 = adder(5)
  print(Int.toString(add5(1)))
  print(Int.toString(adder(7)(1)))
  const both = compose(add5, double)
  print(Int.toString(both(kept(1))))
  const button = Button { label: label, onClick: (t) => `${label} clicked ${Int.toString(t)}` }
  print(button.onClick(3))
  return 0
}
