// error: mutable_read_conflict_arm.nra:14:52: "p" is passed as mutable in one call, so the rest of the expression cannot use it
struct P {
  x: int
}

function move(mutable p: P, d: int): int {
  p.x = p.x + d
  return p.x
}

export function run(args: Array<string>): int {
  let p = P { x: 1 }
  const o: Option<int> = Some(2)
  const r = move(mutable p, match (o) { Some(v) => p.x + v, None => 0 })
  return r
}
