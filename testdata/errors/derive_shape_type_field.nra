// error: derive_shape_type_field.nra:5:8: Token derives Shape, so Token.Word cannot have a field named "type": the encoding writes the constructor name there
import * as Json from "std/json"

enum Token derives Shape {
  Word(type: string, text: string)
  End
}

export function run(args: Array<string>): int {
  print(Json.encode(Token.End))
  return 0
}
