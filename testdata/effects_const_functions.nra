// Top-level constants that hold functions. A constant with an effectful
// function writes its type with `uses`, and every copy keeps it.
import * as Arrays from "std/array"
import * as Int from "std/int"

function loud(v: int): int uses io {
  print("loud")
  return v
}

function quiet(v: int): int {
  return v + 1
}

struct Table {
  quiet: (v: int) => int
  loud: (v: int) => int uses io
}

const table = Table { quiet: quiet, loud: loud }
const calm = Table { ...table, loud: quiet }
const first = quiet
const steps = [first, quiet]
const shout: (v: int) => int uses io = loud
const mixed: Array<(v: int) => int uses io> = [quiet, loud]

export function pure(): int {
  const xs = steps
  const t = table
  return table.quiet(2) + calm.quiet(2) + steps[1](3) + first(4) + xs[0](1) + t.quiet(1)
}

export function noisy(): int uses io {
  let total = table.loud(5) + shout(6) + calm.loud(7)
  for (const step of Arrays.values(mixed)) {
    total = total + step(10)
  }
  return total
}

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(pure()))
  print(Int.toString(noisy()))
  return 0
}
