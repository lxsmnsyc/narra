import * as Str from "std/string"
import * as Int from "std/int"

function showLast(text: string, needle: string) uses io, alloc {
  match (Str.lastIndexOf(text, needle)) {
    Some(index) => print(`lastIndexOf [${text}] [${needle}] ${Int.toString(index)}`)
    None => print(`lastIndexOf [${text}] [${needle}] none`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  showLast("a/b/c", "/")
  showLast("a/b/c", "b")
  showLast("abab", "ab")
  showLast("abc", "x")
  showLast("abc", "abcd")
  showLast("abc", "")
  showLast("", "")
  showLast("", "a")
  showLast("héé", "é")
  showLast("aaa", "aa")
  print(`trimStart [${Str.trimStart("  \t a b \t ")}]`)
  print(`trimEnd [${Str.trimEnd("  \t a b \t ")}]`)
  print(`trimStart none [${Str.trimStart("ab")}]`)
  print(`trimEnd none [${Str.trimEnd("ab")}]`)
  print(`trimStart blank [${Str.trimStart(" \n ")}]`)
  print(`trimEnd blank [${Str.trimEnd(" \n ")}]`)
  print(`trimStart empty [${Str.trimStart("")}]`)
  print(`trimEnd empty [${Str.trimEnd("")}]`)
  print(`trimEnd keeps é [${Str.trimEnd(" é ")}]`)
  print(`padStart [${Str.padStart("42", 5, '0')}]`)
  print(`padEnd [${Str.padEnd("42", 5, '.')}]`)
  print(`padStart exact [${Str.padStart("12345", 5, '0')}]`)
  print(`padEnd longer [${Str.padEnd("123456", 5, '.')}]`)
  print(`padStart zero width [${Str.padStart("ab", 0, '*')}]`)
  print(`padStart negative width [${Str.padStart("ab", -3, '*')}]`)
  print(`padStart empty [${Str.padStart("", 3, '-')}]`)
  print(`padStart bytes [${Str.padStart("é", 4, ' ')}]`)
  print(`padEnd wide fill [${Str.padEnd("a", 6, 'é')}]`)
  print(`padStart wide fill [${Str.padStart("a", 4, 'é')}]`)
  return 0
}
