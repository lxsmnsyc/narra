// Patterns, `is`, `match` and destructuring declarations, ported from
// compiler/internal/narra/check_match.go (resolvePattern, resolvePat,
// bindRest, isExpr, match, requireQualified, enumNameFor) and
// check_patterns.go (destructure).
//
// This module sits above narrac/exprs and below narrac/statements. exprs reaches
// it through the Walker trait (checkPatterns), statements calls it directly. The
// exhaustiveness check and the narrowing helpers are in narrac/patterns.
//
// A pattern's results go into the side tables of the current body:
// its type (setNodeType), the variant a name or constructor pattern means
// (Ref.Constructor on the pattern id) and the local a binding declares
// (BodyInfo.declared). A binding is created when the pattern resolves but
// is put into scope later by the caller (bindPatternLocals), as in Go.
import { Pos, Expr, Pattern, FieldPattern, MatchArm, TypeExpr } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Type, isInteger } from "narrac/types"
import {
  Checker,
  Ref,
  Walker,
  reportError,
  reportErrorFix,
  findImportAt,
  typeString,
  setNodeType,
  setRef,
  getRef,
  findLocal,
  pushScope,
  popScope,
  findBodySlot,
  getExpressionPos,
  getLocal,
} from "narrac/check"
import { LocalInfo, BindingKind, setBinding } from "narrac/check"
import { buildQualifyFix, createEdit, createFix, insertAt } from "narrac/fixes"
import { resolveType } from "narrac/resolve"
import { checkExpression, expectType, findField, isHiddenStruct } from "narrac/exprs"
import { namesEnum, findEnumName } from "narrac/ctors"
import { seedPatternFacts } from "narrac/contracts"
import {
  getPatternId,
  getPatternPos,
  collectPatternLocals,
  bindPatternLocals,
  isIrrefutable,
  findMissingCases,
  isUseful,
  CaseBudget,
} from "narrac/patterns"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

function startsUpper(name: string): bool {
  if (Str.length(name) == 0) {
    return false
  }
  const first = Str.charAt(name, 0)
  return first >= 'A' && first <= 'Z'
}

function findVariant(checker: Checker, enumIndex: int, name: string): int {
  const variants = checker.enums[enumIndex].variants
  for (const index of Ranges.between(0, Arrays.length(variants))) {
    if (variants[index].name == name) {
      return index
    }
  }
  return -1
}

function createPatternLocal(
  mutable checker: Checker,
  nodeId: int,
  pos: Pos,
  name: string,
  localType: Type,
) uses alloc {
  checker.localCount++
  const body = checker.body
  const local = LocalInfo {
    name: name,
    localType: localType,
    isMutable: false,
    param: false,
    binding: BindingKind.Pattern,
    pos: pos,
    noEscape: false,
    used: false,
    number: checker.localCount,
    namePos: pos,
    shorthand: checker.scopes[checker.current].facts.shorthandIds[nodeId] is Some(_),
  }
  Arrays.push(mutable checker.bodies[body].locals, local)
  const index = Arrays.length(checker.bodies[body].locals) - 1
  const slot = findBodySlot(checker.bodies[body], nodeId)
  if (slot >= 0) {
    checker.bodies[body].declared[slot] = index
  }
}

export function resolvePattern<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pattern: Pattern,
  valueType: Type,
) uses alloc {
  // The caller puts the locals in scope (collectPatternLocals, bindPatternLocals).
  let seen: Map<string, bool> = Map {}
  resolveNode(mutable checker, walker, pattern, valueType, mutable seen)
}

function resolveNode<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pattern: Pattern,
  valueType: Type,
  mutable seen: Map<string, bool>,
) uses alloc {
  setNodeType(mutable checker, getPatternId(pattern), valueType)
  match (pattern) {
    Pattern.PatWildcard(_, _) => {}
    Pattern.PatName(nodeId, pos, name) => resolveName(
      mutable checker,
      nodeId,
      pos,
      name,
      valueType,
      mutable seen,
    )
    Pattern.PatCtor(nodeId, pos, enumName, name, arguments, bare) => resolveConstructor(
      mutable checker,
      walker,
      pattern,
      nodeId,
      pos,
      enumName,
      name,
      arguments,
      bare,
      valueType,
      mutable seen,
    )
    Pattern.PatStruct(_, pos, fields) => resolveStruct(
      mutable checker,
      walker,
      pattern,
      pos,
      fields,
      valueType,
      mutable seen,
    )
    Pattern.PatTuple(_, pos, arguments) => resolveTuple(
      mutable checker,
      walker,
      pattern,
      pos,
      arguments,
      valueType,
      mutable seen,
    )
    Pattern.PatLit(_, pos, literal) => resolveLiteral(
      mutable checker,
      walker,
      pos,
      literal,
      valueType,
    )
    Pattern.PatOr(_, _, alternatives) => resolveAlternatives(
      mutable checker,
      walker,
      alternatives,
      valueType,
      mutable seen,
    )
    Pattern.PatCompare(_, pos, operator, _) => {
      // The prover keeps facts for integers only.
      if (!isInteger(valueType)) {
        const found = typeString(checker, valueType)
        reportError(
          mutable checker,
          pos,
          "E0987",
          `the comparison pattern \`${operator}\` needs an integer value, found ${found}`,
        )
      }
    }
  }
}

function resolveAlternatives<W: Walker>(
  mutable checker: Checker,
  walker: W,
  alternatives: Array<Pattern>,
  valueType: Type,
  mutable seen: Map<string, bool>,
) uses alloc {
  // The first alternative declares the locals. Each later one resolves on its own, then its names are checked against the first and its nodes point at the first one's locals.
  resolveNode(mutable checker, walker, alternatives[0], valueType, mutable seen)
  let firstLocals: Array<int> = []
  collectPatternLocals(checker, alternatives[0], mutable firstLocals)
  for (const index of Ranges.between(1, Arrays.length(alternatives))) {
    const alternative = alternatives[index]
    const errorCount = Arrays.length(checker.errors)
    let alternativeSeen: Map<string, bool> = Map {}
    resolveNode(mutable checker, walker, alternative, valueType, mutable alternativeSeen)
    if (Arrays.length(checker.errors) > errorCount) {
      continue
    }
    let locals: Array<int> = []
    collectPatternLocals(checker, alternative, mutable locals)
    if (checkAlternativeLocals(mutable checker, alternative, firstLocals, locals)) {
      let nodeIds: Array<int> = []
      collectNameIds(checker, alternative, mutable nodeIds)
      shareLocals(mutable checker, firstLocals, nodeIds)
    }
    // The locals this alternative created are never read.
    for (const local of Arrays.values(locals)) {
      checker.bodies[checker.body].locals[local].used = true
    }
  }
}

function findLocalByName(checker: Checker, locals: Array<int>, name: string): int {
  for (const local of Arrays.values(locals)) {
    if (getLocal(checker, local).name == name) {
      return local
    }
  }
  return -1
}

function checkAlternativeLocals(
  mutable checker: Checker,
  alternative: Pattern,
  firstLocals: Array<int>,
  locals: Array<int>,
): bool uses alloc {
  const pos = getPatternPos(alternative)
  for (const local of Arrays.values(locals)) {
    const name = getLocal(checker, local).name
    const first = findLocalByName(checker, firstLocals, name)
    if (first < 0) {
      const message = `${quoteGo(name)} is bound in one alternative but not in the other; every alternative binds the same names`
      reportError(mutable checker, pos, "E0967", message)
      return false
    }
    const firstType = getLocal(checker, first).localType
    const type = getLocal(checker, local).localType
    if (firstType != type) {
      const message = `${quoteGo(name)} has type ${typeString(checker, type)} here and ${typeString(checker, firstType)} in the first alternative; every alternative binds the same types`
      reportError(mutable checker, pos, "E0968", message)
      return false
    }
  }
  for (const first of Arrays.values(firstLocals)) {
    const name = getLocal(checker, first).name
    if (findLocalByName(checker, locals, name) < 0) {
      const message = `${quoteGo(name)} is bound in one alternative but not in the other; every alternative binds the same names`
      reportError(mutable checker, pos, "E0967", message)
      return false
    }
  }
  return true
}

function collectNameIds(
  checker: Checker,
  pattern: Pattern,
  mutable nodeIds: Array<int>,
) uses alloc {
  match (pattern) {
    Pattern.PatName(nodeId, _, _) => {
      const body = checker.bodies[checker.body]
      const slot = findBodySlot(body, nodeId)
      if (slot >= 0 && body.declared[slot] >= 0) {
        Arrays.push(mutable nodeIds, nodeId)
      }
    }
    Pattern.PatCtor(_, _, _, _, arguments, _) => {
      for (const argument of Arrays.values(arguments)) {
        collectNameIds(checker, argument, mutable nodeIds)
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        collectNameIds(checker, field.pattern, mutable nodeIds)
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const argument of Arrays.values(arguments)) {
        collectNameIds(checker, argument, mutable nodeIds)
      }
    }
    Pattern.PatOr(_, _, alternatives) => {
      for (const alternative of Arrays.values(alternatives)) {
        collectNameIds(checker, alternative, mutable nodeIds)
      }
    }
    _ => {}
  }
}

function shareLocals(mutable checker: Checker, firstLocals: Array<int>, nodeIds: Array<int>) {
  for (const nodeId of Arrays.values(nodeIds)) {
    const slot = findBodySlot(checker.bodies[checker.body], nodeId)
    const name = getLocal(checker, checker.bodies[checker.body].declared[slot]).name
    const first = findLocalByName(checker, firstLocals, name)
    if (first >= 0) {
      checker.bodies[checker.body].declared[slot] = first
    }
  }
}

function resolveName(
  mutable checker: Checker,
  nodeId: int,
  pos: Pos,
  name: string,
  valueType: Type,
  mutable seen: Map<string, bool>,
) uses alloc {
  // A name is a constructor without fields when the value is an enum with a variant of that name, otherwise it binds.
  if (valueType is Type.TEnum(enumIndex)) {
    const variantIndex = findVariant(checker, enumIndex, name)
    if (variantIndex >= 0) {
      setRef(mutable checker, nodeId, Ref.Constructor(enumIndex, variantIndex))
      requireQualified(mutable checker, pos, name, enumIndex)
      return
    }
    if (startsUpper(name)) {
      const message = `enum ${typeString(checker, valueType)} has no constructor ${quoteGo(name)}`
      reportError(mutable checker, pos, "E0304", message)
      return
    }
  } else if (startsUpper(name)) {
    const message = `${name} is not a constructor of ${typeString(checker, valueType)}; a name that binds starts with a lowercase letter`
    reportError(mutable checker, pos, "E0700", message)
    return
  }
  if (seen[name] is Some(_)) {
    reportError(mutable checker, pos, "E0701", `${quoteGo(name)} is bound twice in this pattern`)
    return
  }
  seen[name] = true
  if (findLocal(checker, name) >= 0) {
    reportError(
      mutable checker,
      pos,
      "E0103",
      `${quoteGo(name)} is already declared in this function; shadowing is not allowed`,
    )
  }
  createPatternLocal(mutable checker, nodeId, pos, name, valueType)
}

function resolveConstructor<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pattern: Pattern,
  nodeId: int,
  pos: Pos,
  enumName: string,
  name: string,
  arguments: Array<Pattern>,
  bare: bool,
  valueType: Type,
  mutable seen: Map<string, bool>,
) uses alloc {
  if (readEnumIndex(valueType) < 0) {
    const message = `constructor pattern ${name} needs an enum value, found ${typeString(checker, valueType)}`
    reportError(mutable checker, pos, "E0702", message)
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  const enumIndex = readEnumIndex(valueType)
  if (enumName != "" && !namesEnum(checker, enumName, enumIndex)) {
    const message = `${enumName}.${name} does not match a value of type ${typeString(checker, valueType)}`
    reportError(mutable checker, pos, "E0703", message)
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  const variantIndex = findVariant(checker, enumIndex, name)
  if (variantIndex < 0) {
    const message = `enum ${typeString(checker, valueType)} has no constructor ${quoteGo(name)}`
    reportError(mutable checker, pos, "E0304", message)
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  setRef(mutable checker, nodeId, Ref.Constructor(enumIndex, variantIndex))
  if (enumName == "") {
    requireQualified(mutable checker, pos, name, enumIndex)
  }
  if (bare) {
    return
  }
  const variant = copy(checker.enums[enumIndex].variants[variantIndex])
  if (Arrays.length(arguments) != Arrays.length(variant.fields)) {
    reportError(
      mutable checker,
      pos,
      "E0704",
      `${variant.name} has ${Int.toString(Arrays.length(variant.fields))} fields, the pattern lists ${Int.toString(Arrays.length(arguments))}`,
    )
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    resolveNode(
      mutable checker,
      walker,
      arguments[index],
      variant.fields[index].fieldType,
      mutable seen,
    )
  }
}

function readEnumIndex(enumType: Type): int {
  if (enumType is Type.TEnum(index)) {
    return index
  }
  return -1
}

function resolveStruct<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pattern: Pattern,
  pos: Pos,
  fields: Array<FieldPattern>,
  valueType: Type,
  mutable seen: Map<string, bool>,
) uses alloc {
  let structIndex = -1
  if (valueType is Type.TStruct(index)) {
    if (!checker.structs[index].tuple) {
      structIndex = index
    }
  }
  if (structIndex < 0) {
    // void marks a value that already had an error
    if (!(valueType is Type.TVoid)) {
      const message = `a struct pattern needs a struct value, found ${typeString(checker, valueType)}`
      reportError(mutable checker, pos, "E0705", message)
    }
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  const text = typeString(checker, valueType)
  if (isHiddenStruct(checker, structIndex)) {
    const message = `cannot match the fields of ${text}: it is an opaque struct of module ${quoteGo(checker.structs[structIndex].module)}`
    reportError(mutable checker, pos, "E0720", message)
  }
  let given: Map<string, bool> = Map {}
  const structFields = copy(checker.structs[structIndex].fields)
  for (const fieldPattern of Arrays.values(fields)) {
    const fieldIndex = findField(structFields, fieldPattern.name)
    if (fieldIndex < 0) {
      reportError(
        mutable checker,
        fieldPattern.pos,
        "E0204",
        `struct ${text} has no field ${quoteGo(fieldPattern.name)}`,
      )
      bindRest(mutable checker, fieldPattern.pattern, mutable seen)
      continue
    }
    if (given[fieldPattern.name] is Some(_)) {
      reportError(
        mutable checker,
        fieldPattern.pos,
        "E0706",
        `field ${quoteGo(fieldPattern.name)} is listed twice`,
      )
      bindRest(mutable checker, fieldPattern.pattern, mutable seen)
      continue
    }
    given[fieldPattern.name] = true
    resolveNode(
      mutable checker,
      walker,
      fieldPattern.pattern,
      structFields[fieldIndex].fieldType,
      mutable seen,
    )
  }
}

function resolveTuple<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pattern: Pattern,
  pos: Pos,
  arguments: Array<Pattern>,
  valueType: Type,
  mutable seen: Map<string, bool>,
) uses alloc {
  let structIndex = -1
  if (valueType is Type.TStruct(index)) {
    if (checker.structs[index].tuple) {
      structIndex = index
    }
  }
  if (structIndex < 0) {
    if (!(valueType is Type.TVoid)) {
      const message = `a tuple pattern needs a tuple value, found ${typeString(checker, valueType)}`
      reportError(mutable checker, pos, "E0707", message)
    }
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  const structFields = copy(checker.structs[structIndex].fields)
  if (Arrays.length(arguments) != Arrays.length(structFields)) {
    const message = `${typeString(checker, valueType)} has ${Int.toString(Arrays.length(structFields))} elements, the pattern lists ${Int.toString(Arrays.length(arguments))}`
    reportError(mutable checker, pos, "E0708", message)
    bindRest(mutable checker, pattern, mutable seen)
    return
  }
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    resolveNode(
      mutable checker,
      walker,
      arguments[index],
      structFields[index].fieldType,
      mutable seen,
    )
  }
}

function resolveLiteral<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  literal: Expr,
  valueType: Type,
) uses alloc {
  const isPrimitive =
    isInteger(valueType) ||
      valueType == Type.TF64 ||
      valueType == Type.TF32 ||
      valueType == Type.TBool ||
      valueType == Type.TChar ||
      valueType == Type.TStr ||
      valueType == Type.TStringBuilder
  if (!isPrimitive) {
    const message = `a literal pattern needs an int, f64, bool, char or string value, found ${typeString(checker, valueType)}`
    reportError(mutable checker, pos, "E0709", message)
    return
  }
  const found = checkExpression(mutable checker, walker, literal, Some(valueType))
  expectType(mutable checker, pos, Some(valueType), found)
}

function bindRest(
  mutable checker: Checker,
  pattern: Pattern,
  mutable seen: Map<string, bool>,
) uses alloc {
  // The names get type void, so their uses do not also report "unknown name".
  match (pattern) {
    Pattern.PatName(nodeId, pos, name) => {
      const body = checker.bodies[checker.body]
      const slot = findBodySlot(body, nodeId)
      const isDeclared = slot >= 0 && body.declared[slot] >= 0
      if (
        getRef(checker, nodeId) is Ref.Unresolved &&
          !isDeclared &&
          !startsUpper(name) &&
          seen[name] is None
      ) {
        seen[name] = true
        createPatternLocal(mutable checker, nodeId, pos, name, Type.TVoid)
      }
    }
    Pattern.PatCtor(_, _, _, _, arguments, _) => {
      for (const argument of Arrays.values(arguments)) {
        bindRest(mutable checker, argument, mutable seen)
      }
    }
    Pattern.PatStruct(_, _, fields) => {
      for (const field of Arrays.values(fields)) {
        bindRest(mutable checker, field.pattern, mutable seen)
      }
    }
    Pattern.PatTuple(_, _, arguments) => {
      for (const argument of Arrays.values(arguments)) {
        bindRest(mutable checker, argument, mutable seen)
      }
    }
    Pattern.PatOr(_, _, alternatives) => {
      for (const alternative of Arrays.values(alternatives)) {
        bindRest(mutable checker, alternative, mutable seen)
      }
    }
    _ => {}
  }
}

function requireQualified(
  mutable checker: Checker,
  pos: Pos,
  name: string,
  enumIndex: int,
) uses alloc {
  const info = copy(checker.enums[enumIndex])
  // Some, None, Ok and Err of the prelude stay bare.
  if (info.module == "") {
    if ((name == "Some" || name == "None") && info.name == "Option") {
      return
    }
    if ((name == "Ok" || name == "Err") && info.name == "Result") {
      return
    }
  }
  let enumName = findEnumName(mutable checker, enumIndex)
  const isVisible = enumName != ""
  if (!isVisible) {
    enumName = info.name
  }
  let fix = copy(buildQualifyFix(pos, enumName))
  if (!isVisible && info.module != "") {
    // The module does not name the enum yet, so the fix imports it too.
    Arrays.push(
      mutable fix.edits,
      insertAt(findImportAt(checker), `import { ${enumName} } from "${info.module}"\n`),
    )
  }
  reportErrorFix(
    mutable checker,
    pos,
    "E0323",
    [fix],
    `constructor ${name} needs its enum; write ${enumName}.${name}`,
  )
}

// ---- is, match, destructuring ----

export function checkPatternExpression<W: Walker>(
  mutable checker: Checker,
  walker: W,
  expression: Expr,
  want: Option<Type>,
): Type from want uses alloc {
  return match (expression) {
    Expr.IsExpr(_, pos, subject, pattern) => checkIs(
      mutable checker,
      walker,
      pos,
      subject,
      pattern,
      false,
    )
    Expr.MatchExpr(_, pos, subject, arms) => checkMatch(
      mutable checker,
      walker,
      pos,
      subject,
      arms,
      want,
      true,
    )
    _ => Type.TVoid
  }
}

function findAlternatives(pattern: Pattern): Option<Pos> from pattern {
  if (pattern is Pattern.PatOr(_, pos, _)) {
    return Some(pos)
  }
  if (pattern is Pattern.PatCtor(_, _, _, _, arguments, _)) {
    return findAlternativesIn(arguments)
  }
  if (pattern is Pattern.PatTuple(_, _, arguments)) {
    return findAlternativesIn(arguments)
  }
  if (pattern is Pattern.PatStruct(_, _, fields)) {
    for (const field of Arrays.values(fields)) {
      if (findAlternatives(field.pattern) is Some(pos)) {
        return Some(pos)
      }
    }
  }
  return None
}

function findAlternativesIn(patterns: Array<Pattern>): Option<Pos> from patterns {
  for (const pattern of Arrays.values(patterns)) {
    if (findAlternatives(pattern) is Some(pos)) {
      return Some(pos)
    }
  }
  return None
}

export function checkIs<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  subject: Expr,
  pattern: Pattern,
  binds: bool,
): Type uses alloc {
  // `binds` is set when the test is the whole condition of an if, the only place it may bind names.
  const subjectType = checkExpression(mutable checker, walker, subject, None)
  if (findAlternatives(pattern) is Some(alternativesPos)) {
    reportError(
      mutable checker,
      alternativesPos,
      "E0974",
      "an `is` test takes one pattern, not alternatives; use `match` to list alternatives",
    )
    return Type.TBool
  }
  resolvePattern(mutable checker, walker, pattern, subjectType)
  let locals: Array<int> = []
  collectPatternLocals(checker, pattern, mutable locals)
  if (Arrays.length(locals) > 0 && !binds) {
    reportError(
      mutable checker,
      pos,
      "E0710",
      "an `is` pattern can only bind names when it is the whole condition of an if or a conditional expression",
    )
  }
  return Type.TBool
}

function reportCoveredAlternatives(
  mutable checker: Checker,
  rows: Array<Array<Pattern>>,
  pattern: Pattern,
  subjectType: Type,
) uses alloc {
  // Each alternative is tested against the earlier arms and the alternatives before it.
  if (pattern is Pattern.PatOr(_, _, alternatives)) {
    let covered: Array<Array<Pattern>> = []
    for (const row of Arrays.values(rows)) {
      Arrays.push(mutable covered, row)
    }
    for (const alternative of Arrays.values(alternatives)) {
      if (!isUseful(checker, covered, [alternative], [subjectType])) {
        reportError(
          mutable checker,
          getPatternPos(alternative),
          "E0974",
          "this alternative is unreachable: the arms and alternatives before it already match every value it matches",
        )
      }
      Arrays.push(mutable covered, [alternative])
    }
  }
}

export function checkMatch<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  subject: Expr,
  arms: Array<MatchArm>,
  want: Option<Type>,
  isValue: bool,
): Type from want uses alloc {
  const subjectType = checkExpression(mutable checker, walker, subject, None)
  if (subjectType == Type.TVoid) {
    reportError(mutable checker, pos, "E0711", "match needs a value, found void")
    return Type.TVoid
  }
  let rows: Array<Array<Pattern>> = []
  let patternFailed = false
  let result = want
  for (const arm of Arrays.values(arms)) {
    pushScope(mutable checker)
    const errorCount = Arrays.length(checker.errors)
    resolvePattern(mutable checker, walker, arm.pattern, subjectType)
    if (Arrays.length(checker.errors) > errorCount) {
      // Checking the guard and body would only report errors that follow
      // from this one.
      patternFailed = true
      popScope(mutable checker)
      continue
    }
    let locals: Array<int> = []
    collectPatternLocals(checker, arm.pattern, mutable locals)
    bindPatternLocals(mutable checker, locals)
    seedPatternFacts(mutable checker, subject, arm.pattern)

    // An arm that no value reaches is an error, guarded or not; an or-pattern reports its alternatives.
    if (!(arm.pattern is Pattern.PatOr(_, _, _))) {
      if (!isUseful(checker, rows, [arm.pattern], [subjectType])) {
        reportErrorFix(
          mutable checker,
          arm.pos,
          "E0983",
          [createFix("remove the unreachable arm", [createEdit(arm.pos, arm.next, "")])],
          "this arm is unreachable: the arms before it already match every value it matches",
        )
      }
    }

    // Only an arm without a guard counts for exhaustiveness.
    if (arm.guard is Some(guard)) {
      const guardType = checkExpression(mutable checker, walker, guard, Some(Type.TBool))
      expectType(mutable checker, getExpressionPos(guard), Some(Type.TBool), guardType)
    } else {
      reportCoveredAlternatives(mutable checker, rows, arm.pattern, subjectType)
      Arrays.push(mutable rows, [arm.pattern])
    }
    if (arm.block is Some(block)) {
      if (isValue) {
        // In value position a block arm is a block expression.
        const found = Walker.checkBlockBody(walker, mutable checker, block.pos, block, result)
        if (result is None) {
          result = Some(found)
        }
        expectType(mutable checker, block.pos, result, found)
      } else {
        Walker.checkBlock(walker, mutable checker, block)
      }
    } else if (arm.body is Some(body)) {
      const found = checkExpression(mutable checker, walker, body, result)
      if (isValue) {
        if (result is None) {
          result = Some(found)
        }
        expectType(mutable checker, getExpressionPos(body), result, found)
      }
    }
    popScope(mutable checker)
  }

  // Every value of the subject must match some arm.
  if (!patternFailed) {
    let budget = CaseBudget { remaining: 10 }
    const missing = findMissingCases(checker, rows, [subjectType], mutable budget)
    if (Arrays.length(missing) > 0) {
      let names: Array<string> = []
      let other = false
      for (const example of Arrays.values(missing)) {
        if (example[0] == "_") {
          other = true
        }
        Arrays.push(mutable names, example[0])
      }
      if (other) {
        const message = `match does not cover every ${typeString(checker, subjectType)} value; add a \`_\` arm`
        reportError(mutable checker, pos, "E0713", message)
      } else {
        reportError(
          mutable checker,
          pos,
          "E0714",
          `match does not cover ${Str.join(names, ", ")}; add the cases or a \`_\` arm`,
        )
      }
    }
  }
  if (isValue) {
    if (result is Some(resultType)) {
      return resultType
    }
  }
  return Type.TVoid
}

export function checkDestructure<W: Walker>(
  mutable checker: Checker,
  walker: W,
  isMutable: bool,
  pattern: Pattern,
  type: Option<TypeExpr>,
  value: Expr,
) uses alloc {
  let want: Option<Type> = None
  if (type is Some(typeExpression)) {
    want = Some(resolveType(mutable checker, typeExpression))
  }
  let found = checkExpression(mutable checker, walker, value, want)
  if (want is Some(declared)) {
    expectType(mutable checker, getExpressionPos(value), want, found)
    found = declared
  }
  if (findAlternatives(pattern) is Some(alternativesPos)) {
    reportError(
      mutable checker,
      alternativesPos,
      "E0974",
      "a destructuring takes one pattern, not alternatives; use `match` to list alternatives",
    )
  }
  resolvePattern(mutable checker, walker, pattern, found)
  if (!isIrrefutable(checker, pattern)) {
    const message = `this pattern does not match every ${typeString(checker, found)}; use match or \`is\` to test a value`
    reportError(mutable checker, getPatternPos(pattern), "E0715", message)
  }

  // The names go into scope, as variables when the declaration is `let`.
  let locals: Array<int> = []
  collectPatternLocals(checker, pattern, mutable locals)
  for (const index of Arrays.values(locals)) {
    const body = checker.body
    checker.bodies[body].locals[index].isMutable = isMutable
    setBinding(mutable checker, index, value, BindingKind.Destructured)
  }
  bindPatternLocals(mutable checker, locals)
  seedPatternFacts(mutable checker, value, pattern)
}
