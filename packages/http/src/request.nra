// http/request: the request type that the client sends and the server hands to a handler.

import * as Bodies from "http/body"
import * as Fields from "http/headers"
import * as Urls from "std/url"
import { Body } from "http/body"
import { HttpError } from "http/error"
import { Headers } from "http/headers"
import { Url } from "std/url"

/// The method of a request. Other holds any method that is not one of the common seven, as
/// written.
export enum Method {
  Get
  Head
  Post
  Put
  Delete
  Patch
  Options
  Other(name: string)
}

/// A request. On a server the url is as the request line wrote it, usually a path and a query.
/// On a client it is absolute: the scheme, the host, and a port if it is not 80.
export struct Request {
  method: Method
  url: Url
  headers: Headers
  body: Body
}

/// A request with no headers and no body. The url is parsed with std/url, and a url that does
/// not parse gives Malformed.
export function create(method: Method, url: string): Result<Request, HttpError> uses alloc {
  const parsed = Urls.parse(url)
  if (parsed is Err(message)) {
    return Err(HttpError.Malformed(`url: ${message}`))
  }
  return Ok(Request {
    method,
    url: parsed.value,
    headers: Fields.empty(),
    body: Bodies.empty(),
  })
}

/// A request with the body and no headers, for a client to send. The body may hold bytes or a
/// stream; a stream is sent chunked. A url that does not parse gives Malformed.
export function createWithBody(
  method: Method,
  url: string,
  body: Body,
): Result<Request, HttpError> from body uses alloc {
  const parsed = Urls.parse(url)
  if (parsed is Err(message)) {
    return Err(HttpError.Malformed(`url: ${message}`))
  }
  return Ok(Request { method, url: parsed.value, headers: Fields.empty(), body })
}

/// The name of the method as it is written on the request line.
export function methodName(method: Method): string {
  if (method is Method.Other(name)) {
    return name
  }
  if (method == Method.Get) {
    return "GET"
  }
  if (method == Method.Head) {
    return "HEAD"
  }
  if (method == Method.Post) {
    return "POST"
  }
  if (method == Method.Put) {
    return "PUT"
  }
  if (method == Method.Delete) {
    return "DELETE"
  }
  if (method == Method.Patch) {
    return "PATCH"
  }
  return "OPTIONS"
}

/// The method written as name. Method names are case-sensitive, so "get" is Other("get").
export function methodFromName(name: string): Method {
  if (name == "GET") {
    return Method.Get
  }
  if (name == "HEAD") {
    return Method.Head
  }
  if (name == "POST") {
    return Method.Post
  }
  if (name == "PUT") {
    return Method.Put
  }
  if (name == "DELETE") {
    return Method.Delete
  }
  if (name == "PATCH") {
    return Method.Patch
  }
  if (name == "OPTIONS") {
    return Method.Options
  }
  return Method.Other(name)
}
