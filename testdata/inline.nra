// An @inline function copies its body and its arrow argument into the call: the
// C has no function for applyTwice, no closure and no environment.
import * as Int from "std/int"

@inline
function applyTwice(value: int, transform: (item: int) => int): int {
  return transform(transform(value))
}

export function run(_args: Array<string>): int uses io, alloc {
  const rate = 3
  print(Int.toString(applyTwice(2, (item) => item * rate)))
  return applyTwice(2, (item) => item * rate) - 18
}
