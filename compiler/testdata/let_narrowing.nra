import * as Int from "std/int"
import * as Ranges from "std/range"
import * as Str from "std/string"

function earlyNone(): int {
  let x: Option<int> = Some(1)
  if (x is None) {
    return 0
  }
  return x.value
}

function earlyErr(): int {
  let r: Result<int, string> = Ok(7)
  if (r is Err(e)) {
    return Str.length(e)
  }
  return r.value
}

function inBranch(): int {
  let x: Option<int> = Some(5)
  if (x is Some(v)) {
    return x.value + v
  }
  return 0
}

function reassignedBefore(): int {
  let x: Option<int> = None
  if (x is None) {
    x = Some(3)
  }
  if (x is None) {
    return 0
  }
  return x.value
}

function loopReassigns(): int {
  let x: Option<int> = Some(1)
  let total = 0
  let count = 0
  while (count < 3) {
    if (x is None) {
      x = Some(count)
      count = count + 1
      continue
    }
    total = total + x.value
    x = None
    count = count + 1
  }
  return total
}

function loopNoAssign(): int {
  let x: Option<int> = Some(2)
  if (x is None) {
    return 0
  }
  let total = 0
  for (const i of Ranges.upTo(3)) {
    total = total + x.value + i
  }
  return total
}

export function run(args: Array<string>): int uses io {
  print(Int.toString(earlyNone()))
  print(Int.toString(earlyErr()))
  print(Int.toString(inBranch()))
  print(Int.toString(reassignedBefore()))
  print(Int.toString(loopReassigns()))
  print(Int.toString(loopNoAssign()))
  return 0
}
