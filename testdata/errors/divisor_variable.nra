// error: divisor_variable.nra:3:18: the divisor must be a non-zero constant or a name checked against zero first; check the name first, as in `if (d != 0) { ... }`
function share(total: int, count: int): int {
  return total / count
}

export function run(args: Array<string>): int {
  return share(10, 2)
}
