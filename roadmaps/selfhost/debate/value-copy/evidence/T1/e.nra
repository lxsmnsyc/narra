import * as Arrays from "std/array"
import * as Int from "std/int"

function reset(mutable items: Array<int>) {
  items = [9]
}

export function run(args: Array<string>): int uses io, alloc {
  let prices = [100, 200]
  const synonym = copy(prices)
  reset(mutable prices)
  print(Int.toString(Arrays.length(synonym)))
  print(Int.toString(synonym[0]))
  return 0
}
