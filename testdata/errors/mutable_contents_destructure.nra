// error: "items" is destructured from a copy of the value, so it cannot be changed
import * as Arrays from "std/array"

struct Bag {
  items: Array<int>
}

export function run(args: Array<string>): int {
  const bag = Bag { items: [] }
  const { items } = bag
  Arrays.push(mutable items, 1)
  return 0
}
