import * as Int from "std/int"
import * as Arrays from "std/array"

const MIN = 1
const MAX = 10

function both(left: bool, right: bool): bool {
  return left && right
}

function id<t>(value: t): t {
  return value
}

// A lowercase type parameter still counts as a type in the call.
function again<t>(value: t): t {
  return id<t>(value)
}

function twice<T>(value: T): T {
  return id<T>(id<T>(value))
}

export function run(args: Array<string>): int {
  const x = 5
  const y = 7
  if (both(x < MAX, MIN > (y))) {
    print("wrong")
  } else {
    print("comparisons")
  }
  const flags = [x < MAX, MAX > (x)]
  print(Int.toString(Arrays.length(flags)))
  print(Int.toString(again<int>(3)))
  print(Int.toString(twice<int>(4)))
  return 0
}
