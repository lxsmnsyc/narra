// error: generator_bound_capture.nra:17:23: Function `f` uses `io` (through `Generator<int> uses alloc, io`) but its signature does not declare it; write `uses io`
export function* noisy(): Generator<int> uses io {
  print("hi")
  yield 1
}

export function* pure(): Generator<int> {
  yield 1
}

export function* mapG<effect E>(g: Generator<int> uses E): Generator<int> uses E, alloc {
  yield* g
}

export function f<effect E>(k: Generator<int> uses E): int uses E, alloc {
  let total = 0
  for (const n of mapG(noisy())) {
    total = total + n
  }
  return total
}

export function quiet(): int uses alloc {
  return f(pure())
}

export function run(args: Array<string>): int {
  return 0
}
