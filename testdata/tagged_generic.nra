// A generic tag takes its value type from the holes: int, a struct that
// derives Show, and Option<int> with a None hole typed by the tag.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"
import * as Str from "std/string"

struct Point derives Show {
  x: int
  y: int
}

function list<T: Show>(parts: Array<string>, values: Array<T>): string {
  let builder = Str.builder()
  for (const index of Ranges.upTo(Arrays.length(parts))) {
    Str.append(mutable builder, parts[index])
    if (index < Arrays.length(values)) {
      Str.append(mutable builder, Show.show(values[index]))
    }
  }
  return Str.build(builder)
}

function maybe(parts: Array<string>, values: Array<Option<int>>): string {
  let found: Array<string> = []
  for (const value of Arrays.values(values)) {
    if (value is Some(number)) {
      Arrays.push(mutable found, Int.toString(number))
    } else {
      Arrays.push(mutable found, "none")
    }
  }
  return `${Str.join(parts, "|")} -> ${Str.join(found, ",")}`
}

function tally<T>(_parts: Array<string>, values: Array<T>): int {
  return Arrays.length(values)
}

export function run(_args: Array<string>): int {
  const count = 3
  print(list`${count} items, ${count + 1} slots`)
  const origin = Point { x: 0, y: 1 }
  print(list`from ${origin} to ${Point { x: 2, y: 3 }}`)
  print(maybe`a${Some(1)}b${None}c`)
  // A generic tag takes T from the first value with a type of its own.
  print(Int.toString(tally`${None}${Some(1)}${None}`))
  return 0
}
