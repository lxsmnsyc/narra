// error: the shift count must be a constant from 0 to 63 or a name checked against both ends first; check the name first, as in `if (n >= 0 && n < 64) { ... }`
function shift(y: u64, x: u64, limit: u64): u64 {
  // limit has no bound below 2^63, so the relation passes nothing on to x.
  if (limit != 0) {
    if (x <= limit) {
      return y << x
    }
  }
  return 0
}

function shiftBelow(y: u64, x: u64, limit: u64): u64 {
  // `limit < 0` leaves a high end of -1, which is 2^64 - 1 as a u64 and no bound.
  if (limit < 0) {
    if (x <= limit) {
      return y << x
    }
  }
  return 0
}

export function run(_args: Array<string>): int {
  shift(1, 1, 2)
  shiftBelow(1, 1, 2)
  return 0
}
