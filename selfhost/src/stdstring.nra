// Str.join(parts, separator)
function emitJoin<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
): Code uses alloc {
  const parts = argumentText(walker, mutable emitter, arguments, 0)
  const separator = argumentText(walker, mutable emitter, arguments, 1)
  return owned(
    ownedTemp(
      mutable emitter,
      Type.TStr,
      `narra_str_join(${parts}->items, ${parts}->len, ${separator})`,
    ),
  )
}

// Str.indexOf(text, needle): Some(position) or None.
function emitIndexOf<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const optionType = typeOf(emitter, nodeId)
  const some = findVariant(emitter, optionType, "Some")
  const none = findVariant(emitter, optionType, "None")
  const text = argumentText(walker, mutable emitter, arguments, 0)
  const needle = argumentText(walker, mutable emitter, arguments, 1)
  const position = temp(mutable emitter, Type.TInt, `narra_str_index_of(${text}, ${needle})`)
  return ioEither(mutable emitter, optionType, `${position} >= 0`, some, [position], none, [])
}

// Str.split(text, separator)
function emitSplit<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  const arrayType = typeOf(emitter, nodeId)
  const text = argumentText(walker, mutable emitter, arguments, 0)
  const separator = argumentText(walker, mutable emitter, arguments, 1)
  const count = temp(mutable emitter, Type.TInt, "0")
  const position = where(emitter, pos)
  const pieces = rawTemp(
    mutable emitter,
    "lstr**",
    `narra_str_split(${text}, ${separator}, &${count}, ${position})`,
  )
  const structName = arrayStruct(emitter, arrayType)
  const array = ownedTemp(mutable emitter, arrayType, `${structName}_new(${count})`)
  writeLine(
    mutable emitter,
    `for (int64_t i = 0; i < ${count}; i++) ${array}->items[${array}->len++] = ${pieces}[i];`,
  )
  writeLine(mutable emitter, `narra_free(${pieces});`)
  return owned(array)
}

// Str.chars(text)
function emitChars<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const arrayType = typeOf(emitter, nodeId)
  const text = argumentText(walker, mutable emitter, arguments, 0)
  const structName = arrayStruct(emitter, arrayType)
  const array = ownedTemp(
    mutable emitter,
    arrayType,
    `${structName}_new(narra_str_char_count(${text}))`,
  )
  writeLine(
    mutable emitter,
    `for (int64_t i = 0; i < ${text}->len; i += narra_str_char_len(${text}, i)) ${array}->items[${array}->len++] = narra_str_decode(${text}, i);`,
  )
  return owned(array)
}

// Str.append and Str.appendChar: the builder is passed by pointer.
function emitAppend<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  call: string,
  arguments: Array<Arg>,
): Code uses alloc {
  const value = argumentText(walker, mutable emitter, arguments, 1)
  const builder = EmitWalker.emitLvaluePointer(walker, mutable emitter, arguments[0].value)
  return plain(`${call}(${builder}, ${value})`)
}

// rawTemp declares a temporary of a C type given as text.
function rawTemp(mutable emitter: Emitter, cTypeText: string, code: string): string uses alloc {
  emitter.tempCount = emitter.tempCount + 1
  const name = `t${Int.toString(emitter.tempCount)}`
  const declaration = declareVariable(mutable emitter, cTypeText, name)
  writeLine(mutable emitter, `${declaration} = ${code};`)
  return variableRef(emitter, name)
}

// emitStringCall emits the calls of std/string.
export function emitStringCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(STRING_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Str.join") {
    return emitJoin(walker, mutable emitter, arguments)
  }
  if (name == "Str.indexOf") {
    return emitIndexOf(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Str.split") {
    return emitSplit(walker, mutable emitter, nodeId, pos, arguments)
  }
  if (name == "Str.chars") {
    return emitChars(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Str.append") {
    return emitAppend(walker, mutable emitter, "narra_sb_append", arguments)
  }
  if (name == "Str.appendChar") {
    return emitAppend(walker, mutable emitter, "narra_sb_append_char", arguments)
  }
  if (name == "Str.length") {
    const text = argumentText(walker, mutable emitter, arguments, 0)
    return plain(`(${text})->len`)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
