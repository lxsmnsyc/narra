// A Shared whose value holds the same Shared is never freed (D80): the value
// holds the slot that holds it, so the leak check reports it at exit.
import * as Shared from "std/shared"

enum Link {
  Next(target: Shared.Shared<Link>)
  End
}

export function run(_args: Array<string>): int {
  const node = Shared.create(Link.End)
  Shared.set(node, Link.Next(node))
  if (Shared.get(node) is Link.Next(_)) {
    print("linked")
  }
  return 0
}
