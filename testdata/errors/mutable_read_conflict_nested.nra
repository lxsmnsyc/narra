// error: mutable_read_conflict_nested.nra:13:15: "y" is passed as mutable in one call, so the rest of the expression cannot use it
function bump(mutable n: int): int {
  n = 10
  return 0
}

function pair(a: int, b: int): int {
  return a + b
}

export function run(args: Array<string>): int {
  let y = 1
  return pair(y, bump(mutable y))
}
