import * as Int from "std/int"
import * as Array from "std/array"

enum Color {
  Red
  Green
  Rgb(r: int, g: int, b: int)
}

struct Point {
  x: int
  y: int
}

const COUNT = 3
const SIZE: int = COUNT * 4 + 1
const NEG = -5
const RATIO = 0.5
const NAME = "narra"
const FLAG = true
const LETTER = 'n'
const ALIAS = COUNT
const ORIGIN = Point { x: 0, y: 0 }
const CORNERS = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
const PRIMES = [2, 3, 5, 7]
const WORDS = ["a", "bc", "def"]
const PALETTE = [Red, Green, Rgb(1, 2, 3)]
const FAVORITE = Rgb(9, 8, 7)
const LATER = FIRST + 1
const FIRST = 10
const TRIPLE = triple
const GREETING = `hi ${NAME}`

function triple(n: int): int {
  return n * 3
}

function show(c: Color): string {
  return match (c) {
    Red => "red"
    Green => "green"
    Rgb(r, g, b) => `rgb ${Int.toString(r)} ${Int.toString(g)} ${Int.toString(b)}`
  }
}

function sum(xs: Array<int>): int {
  let total = 0
  for (const x of Array.values(xs)) {
    total = total + x
  }
  return total
}

export function run(args: Array<string>): int {
  print(Int.toString(SIZE))
  print(Int.toString(NEG))
  print(NAME)
  print(GREETING)
  print(Int.toString(ALIAS))
  print(Int.toString(ORIGIN.x + CORNERS[1].y))
  print(Int.toString(sum(PRIMES)))
  print(WORDS[2])
  for (const c of Array.values(PALETTE)) {
    print(show(c))
  }
  print(show(FAVORITE))
  print(Int.toString(LATER))
  print(Int.toString(TRIPLE(LATER)))
  if (FLAG && LETTER == 'n' && RATIO < 1.0) {
    print("scalars ok")
  }
  // A copy of a constant array can change without changing the constant.
  let copy = PRIMES
  Array.push(mutable copy, 11)
  print(Int.toString(Array.length(copy)))
  print(Int.toString(Array.length(PRIMES)))
  return 0
}
