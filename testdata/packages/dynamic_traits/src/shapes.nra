export trait Area {
  function area(value: Self): int
}

export struct Rect implements Area {
  width: int
  height: int
}

implement Area for Rect {
  function area(value: Rect): int {
    return value.width * value.height
  }
}

export function sum(items: Array<Dynamic<Area>>): int {
  let total = 0
  for (const item of items) {
    total += Area.area(item)
  }
  return total
}
