// The checker context, ported from the Checker struct and helpers of
// compiler/internal/narra/check.go, diagnostic.go (report) and the
// orderTypes half of check_types.go.
//
// One `Checker` value is threaded through every pass as `mutable checker`. Every
// array and map in it has one owner, so pushes and writes happen in place.
// Declaration tables are written through `checker.structs[i].fields = ...`.
//
// Side tables are indexed by node id (D63). They are sized by the id count
// given to newChecker (the package's `nextId` plus the prelude's ids, see
// declare.nra), never by the number of nodes, because ids have gaps. A
// dummy node built after a parse error has id -1; parsed files that reach
// the checker have none, but every write checks the range anyway.
import * as Int from "std/int"
import * as Str from "std/string"
import { Pos, FuncDecl, ConstDecl, Decl, File, ImportDecl, Expr, Block } from "narrac/ast"
import { Type, Field, StructInfo, EnumInfo, DistinctInfo, ParamInfo, GenericInfo, TraitInfo, TypeTraits, ImplInfo, ImplRef, MapKeyCheck, typeKey, isBoxedEnum } from "narrac/types"
import { Registry, newRegistry } from "narrac/builtins"
import { funcIds, blockIds, exprIds } from "narrac/idcheck"
import * as Arrays from "std/array"
import * as Maps from "std/map"

// The names one module sees (Go's modScope): its own declarations, the
// names it imports and the prelude's types and generics. An imported name
// maps to the same table index as in the module that declares it, so
// types, functions, constants and traits compare by index across modules.
export struct ModScope {
  path: string // "" for the prelude
  file: string // for diagnostics: "prelude", "src/text.nra", "hello.nra"
  isSource: bool // a module of the package (Go's src != nil); false for the prelude
  imports: Array<ImportDecl> // the module's imports, in source order
  decls: Array<Decl> // the module's declarations, for typeErrorf
  exports: Map<string, int> // exported name -> index in decls (Go's SourceModule.Exports; the last one wins)
  types: Map<string, Type> // non-generic named types, with the primitives
  generics: Map<string, int> // Checker.generics
  funcs: Map<string, int> // Checker.funcs, own and imported
  consts: Map<string, int> // Checker.consts, own and imported
  traits: Map<string, int> // Checker.traits: the module's own traits and its imports'
  modules: Map<string, string> // namespace alias -> module path, package or std
  imported: Map<string, int> // std function imported by name -> Registry.funcs index
}

// The entry function of one binary: a Checker.funcs index, or -1 when the
// entry names no exported function of the package.
export struct EntryInfo {
  binary: string
  func: int
}

// A top-level function. typeParams is empty for a non-generic function.
// Parameter types are in the side table Checker.paramTypes by Param.id.
export struct FuncInfo {
  name: string
  module: string
  scope: int
  decl: FuncDecl
  typeParams: Array<int> // Checker.params
  result: Type
}

// A top-level constant. declaredType is the declared type, set by declareConstTypes;
// None without an annotation until the body checker infers it. The body
// checker checks the value once (state CONST_NEW, CONST_BUSY, CONST_DONE)
// and keeps its type in valueType.
export struct ConstInfo {
  name: string
  module: string
  scope: int
  decl: ConstDecl
  declaredType: Option<Type>
  state: int = 0
  valueType: Option<Type> = None
}

export const CONST_NEW = 0
export const CONST_BUSY = 1
export const CONST_DONE = 2

// What a name or call resolves to, kept per checked body by node id.
export enum Ref {
  Unresolved
  Local(index: int) // BodyInfo.locals
  Const(index: int) // Checker.consts
  Function(index: int) // Checker.funcs
  Builtin(index: int) // Registry.funcs
}

// A local variable, parameter or loop variable of one checked body (Go's
// Local). noEscape marks a function-type parameter without `escaping`.
// selfhost-check-patterns adds narrowing beside it.
export struct LocalInfo {
  name: string
  localType: Type
  isMutable: bool
  param: bool
  pos: Pos
  noEscape: bool
  used: bool
}

// The syntax a checked body walks, for the types dump and later passes.
export enum BodyRoot {
  RootFunc(decl: FuncDecl)
  RootBlock(block: Block)
  RootExpr(expr: Expr)
}

// The results of one checked body (D70). A generic function is checked once
// with its type parameters open and once per instance over the same syntax,
// so results are kept per body, not per package: types, refs and declared
// are indexed by `id - first`, where [first, first + length) covers the ids
// of the body's nodes. declared gives the local a node declares (a
// parameter, VarStmt or ForStmt), or -1.
export struct BodyInfo {
  module: string
  kind: string // func, test, impl, const, default
  name: string // the header text after the kind
  targs: Array<Type>
  root: BodyRoot
  first: int
  types: Array<Option<Type>>
  refs: Array<Ref>
  declared: Array<int>
  locals: Array<LocalInfo>
}

// The entry point of the recursive body checker. Narra modules cannot
// import in a cycle and a function value cannot take a mutable parameter,
// so modules below narrac/exprs (calls, patterns, closures, builtins) reach
// expressions and blocks through a type that implements this trait: the
// functions that need it take `walker: W` with `<W: Walker>`, and
// narrac/body passes its BodyWalker.
export trait Walker {
  function checkExpression(walker: Self, mutable checker: Checker, expression: Expr, want: Option<Type>): Type uses alloc
  function checkBlock(walker: Self, mutable checker: Checker, block: Block) uses alloc
}

// A compile error. There are no codes or fixes yet: they go with the driver
// in selfhost-bootstrap.
export struct CheckError {
  file: string
  pos: Pos
  message: string
}

export struct Checker {
  // Declaration tables. A Type indexes into the first four.
  structs: Array<StructInfo>
  enums: Array<EnumInfo>
  distincts: Array<DistinctInfo>
  params: Array<ParamInfo>
  generics: Array<GenericInfo>
  funcs: Array<FuncInfo>
  consts: Array<ConstInfo>
  // Generic instances and tuple types by "<generic>|<typeKeys>" or
  // "T|<typeKeys>", and the instances in creation order (Go's instTypes).
  instances: Map<string, Type>
  instTypes: Array<Type>
  // Non-generic structs and enums in declaration order, prelude first
  // (the concrete list Go passes to finish).
  concrete: Array<Type>
  // Module scopes; cur is the module being checked (Go's c.mod).
  scopes: Array<ModScope>
  cur: int
  // The type parameters in scope by name (Go's c.env).
  env: Map<string, Type>
  // Side tables by node id.
  paramTypes: Array<Type> // the type of each Param, TVoid until set
  // Locals declared so far, for unique local names (body checker).
  localN: int
  // Traits (traits.nra). traits holds every declared trait; a module's
  // ModScope.traits maps names to indexes. typeTraits has one entry per
  // struct and enum declaration (and the prelude's), found by
  // "<module>|<name>" in typeTraitIndex. bounds maps a type parameter to the
  // traits in its constraint. impls are the checked implement blocks, and
  // implFuncs maps "<typeKey>|Trait.function" to the implementing function.
  traits: Array<TraitInfo>
  typeTraits: Array<TypeTraits>
  typeTraitIndex: Map<string, int>
  bounds: Map<int, Array<int>>
  busy: Map<string, bool>
  impls: Array<ImplInfo>
  implFuncs: Map<string, ImplRef>
  mapKeys: Array<MapKeyCheck>
  errs: Array<CheckError>
  errKeys: Map<string, bool> // file, line, column and message of each error in errs
  // Structs and enums in C definition order, set by finish (Go's
  // Program.Types).
  order: Array<Type>
  // The std registry (stdlib.nra), the scope index of each module path,
  // the package (for unknown-module errors), the std modules the program
  // uses in first-import order (Go's Program.Modules) and the entry
  // function of each binary.
  registry: Registry
  scopeIndex: Map<string, int>
  pkgName: string
  single: bool
  used: Array<string>
  entries: Array<EntryInfo>
  // The body checker (body.nra, exprs.nra, stmts.nra). checkingBodies is
  // set by `narrac types`; without it the declaration passes skip field
  // defaults, as `narrac decls` did before bodies existed. bodies lists
  // the checked bodies in the order their checks start; body is the one
  // being checked, or -1. localScopes is the stack of block scopes of that
  // body, each mapping a name to a BodyInfo.locals index. resultType is the
  // result of the function being checked (void outside functions), loops
  // the depth of loops, and inTest is set inside a test body.
  checkingBodies: bool = false
  // Generic structs built since the last default check (resolve.nra's
  // buildGeneric queues them; Go checks their defaults during the build).
  pendingDefaults: Array<int> = []
  bodies: Array<BodyInfo> = []
  body: int = -1
  localScopes: Array<Map<string, int>> = []
  scopeDepth: int = 0
  resultType: Type
  loops: int = 0
  inTest: bool = false
}

// newChecker makes an empty checker whose side tables hold ids [0, ids).
export function newChecker(ids: int): Checker uses alloc {
  return Checker {
    structs: [], enums: [], distincts: [], params: [], generics: [], funcs: [], consts: [],
    instances: Map {}, instTypes: [], concrete: [], scopes: [], cur: 0, env: Map {},
    paramTypes: Arrays.filled(Type.TVoid, ids), localN: 0,
    traits: [], typeTraits: [], typeTraitIndex: Map {}, bounds: Map {}, busy: Map {}, impls: [], implFuncs: Map {}, mapKeys: [],
    errs: [], errKeys: Map {}, order: [],
    registry: newRegistry(), scopeIndex: Map {}, pkgName: "", single: false, used: [], entries: [],
    resultType: Type.TVoid,
  }
}

// errorf records an error in the current module's file. An error equal to
// one already recorded is dropped, as Go's report does.
export function errorf(mutable checker: Checker, pos: Pos, message: string) uses alloc {
  let file = ""
  if (Arrays.length(checker.scopes) > 0) {
    file = checker.scopes[checker.cur].file
  }
  errorIn(mutable checker, file, pos, message)
}

export function errorIn(mutable checker: Checker, file: string, pos: Pos, message: string) uses alloc {
  const key = `${file}|${Int.toString(pos.line)}|${Int.toString(pos.col)}|${message}`
  if (checker.errKeys[key] is Some(_)) {
    return
  }
  checker.errKeys[key] = true
  Arrays.push(mutable checker.errs, CheckError { file: file, pos: pos, message: message })
}

// errorText prints the errors as the Go dumps do, one line each.
export function errorText(errors: Array<CheckError>): string uses alloc {
  let builder = Str.builder()
  for (const error of Arrays.values(errors)) {
    Str.append(mutable builder, `error ${error.file}:${Int.toString(error.pos.line)}:${Int.toString(error.pos.col)}: ${error.message}\n`)
  }
  return Str.build(builder)
}

// newScope adds the scope of a module and returns its index. Every module
// sees the primitive names and the prelude's types and generics.
export function newScope(mutable checker: Checker, path: string, file: string, isSource: bool, imports: Array<ImportDecl>, decls: Array<Decl>) : int uses alloc {
  let types: Map<string, Type> = Map { "int": Type.TInt, "i64": Type.TInt, "f64": Type.TF64, "bool": Type.TBool, "char": Type.TChar, "string": Type.TStr }
  let generics: Map<string, int> = Map {}
  if (Arrays.length(checker.scopes) > 0) {
    for (const entry of Maps.entries(checker.scopes[0].types)) {
      const #[name, type] = entry
      types[name] = type
    }
    for (const entry of Maps.entries(checker.scopes[0].generics)) {
      const #[name, generic] = entry
      generics[name] = generic
    }
  }
  const scope = ModScope { path: path, file: file, isSource: isSource, imports: imports, decls: decls, exports: Map {}, types: types, generics: generics, funcs: Map {}, consts: Map {}, traits: Map {}, modules: Map {}, imported: Map {} }
  Arrays.push(mutable checker.scopes, scope)
  const index = Arrays.length(checker.scopes) - 1
  checker.scopeIndex[path] = index
  return index
}

// enter makes a scope current and returns the previous one.
export function enter(mutable checker: Checker, scope: int): int {
  const previous = checker.cur
  checker.cur = scope
  return previous
}

// lookupType finds a non-generic named type in the current scope.
export function lookupType(checker: Checker, name: string): Option<Type> {
  return checker.scopes[checker.cur].types[name]
}

export function lookupGeneric(checker: Checker, name: string): Option<int> {
  return checker.scopes[checker.cur].generics[name]
}

// setParamType records the type of a parameter in the side table. Ids
// outside the table are ignored.
export function setParamType(mutable checker: Checker, nodeId: int, type: Type) {
  if (nodeId >= 0 && nodeId < Arrays.length(checker.paramTypes)) {
    checker.paramTypes[nodeId] = type
  }
}

// lookupTrait finds a trait by the name the current module uses for it: its
// own and imported traits, then the prelude's. It returns the Checker.traits
// index, or -1.
export function lookupTrait(checker: Checker, name: string): int {
  if (checker.scopes[checker.cur].traits[name] is Some(index)) {
    return index
  }
  if (checker.scopes[0].traits[name] is Some(preludeIndex)) {
    return preludeIndex
  }
  return -1
}

// stdTrait finds Equatable, Hashable, Ordered or Show, or returns -1.
export function stdTrait(checker: Checker, name: string): int {
  if (checker.scopes[0].traits[name] is Some(index)) {
    if (checker.traits[index].std) {
      return index
    }
  }
  return -1
}

// checkMapKey queues the check of a Map key type. Keys that still hold type
// parameters are checked when the generic is used. The check runs once every
// module is declared (flushMapKeys in traits.nra), when the trait facts of
// later types are known.
export function checkMapKey(mutable checker: Checker, pos: Pos, key: Type) uses alloc {
  if (containsTypeParam(checker, key)) {
    return
  }
  let file = ""
  if (Arrays.length(checker.scopes) > 0) {
    file = checker.scopes[checker.cur].file
  }
  const item = MapKeyCheck { pos: pos, key: key, file: file }
  Arrays.push(mutable checker.mapKeys, item)
}

// typeString prints a type as Go's Type.String does: structs and enums by
// name with their type arguments, tuples as #[A, B].
export function typeString(checker: Checker, type: Type): string uses alloc {
  return match (type) {
    Type.TInt => "int"
    Type.TF64 => "f64"
    Type.TBool => "bool"
    Type.TChar => "char"
    Type.TStr => "string"
    Type.TVoid => "void"
    Type.TStringBuilder => "StringBuilder"
    Type.TStruct(index) => structString(checker, index)
    Type.TEnum(index) => `${checker.enums[index].name}${typeArgs(checker, checker.enums[index].args)}`
    Type.TDistinct(index) => checker.distincts[index].name
    Type.TParam(index) => checker.params[index].name
    Type.TArray(element) => `Array<${typeString(checker, element)}>`
    Type.TBox(element) => `Box<${typeString(checker, element)}>`
    Type.TMap(key, value) => `Map<${typeString(checker, key)}, ${typeString(checker, value)}>`
    Type.TFunc(parameters, result) => `(${typeList(checker, parameters)}) => ${typeString(checker, result)}`
    Type.TRange => "Range"
    Type.TModule(path) => `module ${path}`
  }
}

function structString(checker: Checker, index: int): string uses alloc {
  const info = checker.structs[index]
  if (info.tuple) {
    return `#[${typeList(checker, info.args)}]`
  }
  return `${info.name}${typeArgs(checker, info.args)}`
}

function typeArgs(checker: Checker, args: Array<Type>): string uses alloc {
  if (Arrays.length(args) == 0) {
    return ""
  }
  return `<${typeList(checker, args)}>`
}

export function typeList(checker: Checker, types: Array<Type>): string uses alloc {
  let parts: Array<string> = []
  for (const type of Arrays.values(types)) {
    Arrays.push(mutable parts, typeString(checker, type))
  }
  return Str.join(parts, ", ")
}

// typeModule is the declaring module of a struct, enum or distinct type, or
// "" for any other type.
export function typeModule(checker: Checker, type: Type): string {
  return match (type) {
    Type.TStruct(index) => checker.structs[index].module
    Type.TEnum(index) => checker.enums[index].module
    Type.TDistinct(index) => checker.distincts[index].module
    _ => ""
  }
}

export function containsTypeParam(checker: Checker, type: Type): bool {
  return match (type) {
    Type.TParam(_) => true
    Type.TFunc(parameters, result) => anyTypeParam(checker, parameters) || containsTypeParam(checker, result)
    Type.TArray(element) => containsTypeParam(checker, element)
    Type.TBox(element) => containsTypeParam(checker, element)
    Type.TMap(key, value) => containsTypeParam(checker, key) || containsTypeParam(checker, value)
    Type.TStruct(index) => anyTypeParam(checker, checker.structs[index].args)
    Type.TEnum(index) => anyTypeParam(checker, checker.enums[index].args)
    _ => false
  }
}

export function anyTypeParam(checker: Checker, types: Array<Type>): bool {
  for (const type of Arrays.values(types)) {
    if (containsTypeParam(checker, type)) {
      return true
    }
  }
  return false
}

// typeErrorf reports an error at the declaration of a struct or enum, in the
// file of the module that declares it.
export function typeErrorf(mutable checker: Checker, type: Type, message: string) uses alloc {
  let scope = 0
  let pos = Pos { line: 0, col: 0 }
  match (type) {
    Type.TStruct(index) => {
      scope = checker.structs[index].scope
      pos = checker.structs[index].pos
    }
    Type.TEnum(index) => {
      scope = checker.enums[index].scope
      pos = checker.enums[index].pos
    }
    _ => {}
  }
  const saved = enter(mutable checker, scope)
  errorf(mutable checker, pos, message)
  enter(mutable checker, saved)
}

// finish orders the program's structs and enums for the emitter: concrete
// are the non-generic ones in declaration order, then come the instances
// without type parameters. Go's finish also lists arrays, boxes, maps and
// function types; the emitter collects those itself (selfhost-emit).
export function finish(mutable checker: Checker, concrete: Array<Type>) uses alloc {
  let all = concrete
  for (const type of Arrays.values(checker.instTypes)) {
    if (!containsTypeParam(checker, type)) {
      Arrays.push(mutable all, type)
    }
  }
  let state: Map<string, int> = Map {}
  for (const type of Arrays.values(all)) {
    visitOrder(mutable checker, mutable state, type)
  }
}

// visitOrder places a type after the types it holds inline (Go's orderTypes). A
// boxed enum is complete before its fields, which lets an enum hold itself.
function visitOrder(mutable checker: Checker, mutable state: Map<string, int>, type: Type) uses alloc {
  let fields: Array<Field> = []
  let boxed = false
  match (type) {
    Type.TStruct(index) => {
      fields = checker.structs[index].fields
    }
    Type.TEnum(index) => {
      boxed = isBoxedEnum(checker.enums[index])
      for (const variant of Arrays.values(checker.enums[index].variants)) {
        for (const field of Arrays.values(variant.fields)) {
          Arrays.push(mutable fields, field)
        }
      }
    }
    _ => {
      return
    }
  }
  const key = typeKey(type)
  let mark = 0
  if (state[key] is Some(stored)) {
    mark = stored
  }
  if (mark == 2) {
    return
  }
  if (mark == 1) {
    const text = typeString(checker, type)
    typeErrorf(mutable checker, type, `type ${text} contains itself; put the recursive field in an enum, Box or array`)
    return
  }
  if (boxed) {
    state[key] = 2
    Arrays.push(mutable checker.order, type)
    for (const field of Arrays.values(fields)) {
      visitOrder(mutable checker, mutable state, field.fieldType)
    }
    return
  }
  state[key] = 1
  for (const field of Arrays.values(fields)) {
    visitOrder(mutable checker, mutable state, field.fieldType)
  }
  state[key] = 2
  Arrays.push(mutable checker.order, type)
}

// The state of the body being checked, saved while another body (a
// constant checked at its first use) is checked in the middle of it.
export struct BodyState {
  body: int
  localScopes: Array<Map<string, int>>
  scopeDepth: int
  resultType: Type
  loops: int
  env: Map<string, Type>
}

// startBody adds a body to Checker.bodies, makes it current with one empty
// scope and returns the state to give back to finishBody. Its tables cover
// the ids of the nodes under root.
export function startBody(mutable checker: Checker, kind: string, name: string, targs: Array<Type>, root: BodyRoot, resultType: Type, env: Map<string, Type>): BodyState uses alloc {
  // Find the id range of the body's nodes.
  let ids: Array<int> = []
  match (root) {
    BodyRoot.RootFunc(decl) => funcIds(mutable ids, decl)
    BodyRoot.RootBlock(block) => blockIds(mutable ids, block)
    BodyRoot.RootExpr(expression) => exprIds(mutable ids, expression)
  }
  let first = 0
  let last = -1
  for (const nodeId of Arrays.values(ids)) {
    if (last < first || nodeId < first) {
      first = nodeId
    }
    if (nodeId > last) {
      last = nodeId
    }
  }
  let size = 0
  if (last >= first) {
    size = last - first + 1
  }

  // Save the outer body's state and start the new one.
  const saved = BodyState { body: checker.body, localScopes: checker.localScopes, scopeDepth: checker.scopeDepth, resultType: checker.resultType, loops: checker.loops, env: checker.env }
  const module = checker.scopes[checker.cur].path
  const info = BodyInfo { module: module, kind: kind, name: name, targs: targs, root: root, first: first, types: Arrays.filled(None, size), refs: Arrays.filled(Ref.Unresolved, size), declared: Arrays.filled(-1, size), locals: [] }
  Arrays.push(mutable checker.bodies, info)
  checker.body = Arrays.length(checker.bodies) - 1
  checker.localScopes = [Map {}]
  checker.scopeDepth = 1
  checker.resultType = resultType
  checker.loops = 0
  checker.env = env
  return saved
}

// finishBody makes the saved body current again.
export function finishBody(mutable checker: Checker, saved: BodyState) {
  checker.body = saved.body
  checker.localScopes = saved.localScopes
  checker.scopeDepth = saved.scopeDepth
  checker.resultType = saved.resultType
  checker.loops = saved.loops
  checker.env = saved.env
}

// findBodySlot is the table index of a node id in a body, or -1.
export function findBodySlot(body: BodyInfo, nodeId: int): int {
  const slot = nodeId - body.first
  if (slot < 0 || slot >= Arrays.length(body.types)) {
    return -1
  }
  return slot
}

// findSlot is the table index of a node id in the current body, or -1.
function findSlot(checker: Checker, nodeId: int): int {
  if (checker.body < 0) {
    return -1
  }
  return findBodySlot(checker.bodies[checker.body], nodeId)
}

export function setNodeType(mutable checker: Checker, nodeId: int, nodeType: Type) uses alloc {
  const slot = findSlot(checker, nodeId)
  if (slot >= 0) {
    const body = checker.body
    checker.bodies[body].types[slot] = Some(nodeType)
  }
}

// getNodeType is the type the current body gave a node, or None.
export function getNodeType(checker: Checker, nodeId: int): Option<Type> {
  const slot = findSlot(checker, nodeId)
  if (slot < 0) {
    return None
  }
  return checker.bodies[checker.body].types[slot]
}

export function setRef(mutable checker: Checker, nodeId: int, ref: Ref) uses alloc {
  const slot = findSlot(checker, nodeId)
  if (slot >= 0) {
    const body = checker.body
    checker.bodies[body].refs[slot] = ref
  }
}

export function getRef(checker: Checker, nodeId: int): Ref {
  const slot = findSlot(checker, nodeId)
  if (slot < 0) {
    return Ref.Unresolved
  }
  return checker.bodies[checker.body].refs[slot]
}

// findLocal finds a name in the scopes of the current body, innermost
// first, and returns its BodyInfo.locals index or -1 (Go's lookup).
export function findLocal(checker: Checker, name: string): int {
  let depth = checker.scopeDepth - 1
  while (depth >= 0) {
    if (checker.localScopes[depth][name] is Some(index)) {
      return index
    }
    depth = depth - 1
  }
  return -1
}

export function getLocal(checker: Checker, index: int): LocalInfo {
  return checker.bodies[checker.body].locals[index]
}

// declareLocal adds a local to the innermost scope (Go's declare); nodeId is
// the declaring node. Shadowing is an error, except for `_`.
export function declareLocal(mutable checker: Checker, nodeId: int, pos: Pos, name: string, localType: Type, isMutable: bool, param: bool): int uses alloc {
  if (name != "_" && findLocal(checker, name) >= 0) {
    errorf(mutable checker, pos, `"${name}" is already declared in this function; shadowing is not allowed`)
  }
  checker.localN = checker.localN + 1

  // Record the local and the node that declares it.
  const body = checker.body
  const local = LocalInfo { name: name, localType: localType, isMutable: isMutable, param: param, pos: pos, noEscape: false, used: false }
  Arrays.push(mutable checker.bodies[body].locals, local)
  const index = Arrays.length(checker.bodies[body].locals) - 1
  const slot = findSlot(checker, nodeId)
  if (slot >= 0) {
    checker.bodies[body].declared[slot] = index
  }
  const depth = checker.scopeDepth - 1
  checker.localScopes[depth][name] = index
  return index
}

// pushScope opens a block scope. The stack keeps popped slots and empties
// them on reuse, since std/array has no pop.
export function pushScope(mutable checker: Checker) uses alloc {
  if (checker.scopeDepth < Arrays.length(checker.localScopes)) {
    const depth = checker.scopeDepth
    checker.localScopes[depth] = Map {}
  } else {
    Arrays.push(mutable checker.localScopes, Map {})
  }
  checker.scopeDepth = checker.scopeDepth + 1
}

export function popScope(mutable checker: Checker) {
  checker.scopeDepth = checker.scopeDepth - 1
}

// unsupported reports a construct that a later roadmap node ports. The
// harness (selfhost_bodies_test.go) skips any input whose output holds
// `unsupported:`. what names the construct and the node, as in
// "`is` (selfhost-check-patterns)".
export function unsupported(mutable checker: Checker, pos: Pos, what: string): Type uses alloc {
  errorf(mutable checker, pos, `unsupported: ${what}`)
  return Type.TVoid
}

export function getExpressionId(expression: Expr): int {
  return match (expression) {
    Expr.IntLit(nodeId, _, _) => nodeId
    Expr.FloatLit(nodeId, _, _) => nodeId
    Expr.StringLit(nodeId, _, _, _) => nodeId
    Expr.CharLit(nodeId, _, _) => nodeId
    Expr.BoolLit(nodeId, _, _) => nodeId
    Expr.TemplateLit(nodeId, _, _) => nodeId
    Expr.Ident(nodeId, _, _) => nodeId
    Expr.FieldExpr(nodeId, _, _, _) => nodeId
    Expr.IsExpr(nodeId, _, _, _) => nodeId
    Expr.IndexExpr(nodeId, _, _, _) => nodeId
    Expr.MapLit(nodeId, _, _, _, _) => nodeId
    Expr.CallExpr(nodeId, _, _, _) => nodeId
    Expr.UnaryExpr(nodeId, _, _, _) => nodeId
    Expr.BinaryExpr(nodeId, _, _, _, _) => nodeId
    Expr.StructLit(nodeId, _, _, _, _, _) => nodeId
    Expr.ArrayLit(nodeId, _, _, _) => nodeId
    Expr.MatchExpr(nodeId, _, _, _) => nodeId
    Expr.ArrowExpr(nodeId, _, _, _, _, _) => nodeId
  }
}

export function getExpressionPos(expression: Expr): Pos {
  return match (expression) {
    Expr.IntLit(_, pos, _) => pos
    Expr.FloatLit(_, pos, _) => pos
    Expr.StringLit(_, pos, _, _) => pos
    Expr.CharLit(_, pos, _) => pos
    Expr.BoolLit(_, pos, _) => pos
    Expr.TemplateLit(_, pos, _) => pos
    Expr.Ident(_, pos, _) => pos
    Expr.FieldExpr(_, pos, _, _) => pos
    Expr.IsExpr(_, pos, _, _) => pos
    Expr.IndexExpr(_, pos, _, _) => pos
    Expr.MapLit(_, pos, _, _, _) => pos
    Expr.CallExpr(_, pos, _, _) => pos
    Expr.UnaryExpr(_, pos, _, _) => pos
    Expr.BinaryExpr(_, pos, _, _, _) => pos
    Expr.StructLit(_, pos, _, _, _, _) => pos
    Expr.ArrayLit(_, pos, _, _) => pos
    Expr.MatchExpr(_, pos, _, _) => pos
    Expr.ArrowExpr(_, pos, _, _, _, _) => pos
  }
}

export function isNumeric(valueType: Type): bool {
  return valueType == Type.TInt || valueType == Type.TF64
}
