// error: parameter "players" is read-only; declare it as `mutable players` to pass it on as mutable
struct Player {
  hp: int
}

function reset(players: Array<Player>) {
  for (mutable player of players) {
    player.hp = 0
  }
}

export function run(args: Array<string>): int {
  reset([Player { hp: 3 }])
  return 0
}
