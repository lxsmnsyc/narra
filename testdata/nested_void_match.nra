function note(text: string) uses io {
  print(text)
}

function report(value: Result<int, string>, flag: bool) uses io {
  match (value) {
    Ok(_number) => match (flag) { true => print("shown"), false => print("hidden") }
    Err(message) => print(message)
  }
}

function deep(value: Result<int, string>, flag: bool, other: bool) uses io {
  match (value) {
    Ok(_number) => match (flag) {
      true => match (other) { true => note("deep true"), false => note("deep false") }
      false => note("hidden")
    }
    Err(message) => note(message)
  }
}

function withBlock(value: Result<int, string>, flag: bool) uses io {
  match (value) {
    Ok(_number) => {
      match (flag) { true => note("block true"), false => note("block false") }
    }
    Err(message) => note(message)
  }
}

function valued(value: Result<int, string>, flag: bool): string {
  return match (value) {
    Ok(_number) => match (flag) { true => "a", false => "b" }
    Err(message) => message
  }
}

export function run(args: Array<string>): int uses io {
  report(Ok(3), true)
  report(Err("bad"), false)
  deep(Ok(3), true, true)
  deep(Ok(3), true, false)
  deep(Ok(3), false, false)
  deep(Err("deep bad"), false, false)
  withBlock(Ok(1), true)
  withBlock(Ok(1), false)
  note(valued(Ok(1), true))
  note(valued(Ok(1), false))
  note(valued(Err("e"), true))
  return 0
}
