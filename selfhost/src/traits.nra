// Traits, ported from compiler/internal/narra/check_traits.go and the Map key
// rules of std_map.go (mapKeyProblem, flushMapKeys). See
// roadmaps/selfhost/contracts/trait-model.md.
//
// Go keys traits and parameters by pointer. Here a trait is an index into
// Checker.traits, a type parameter an index into Checker.parameters, and the
// facts about a struct or enum (Go's typeTraits) sit in Checker.typeTraits,
// found by "<module>|<name>". Go's `implements` is typeImplements here,
// because `implements` is a keyword.
//
// Left to selfhost-check-bodies: traitCall (calls of trait functions),
// implBodies (the bodies of the functions in checker.implementations) and the call-site use
// of checkBounds. Left to selfhost-check-imports: importTrait (an exported
// trait of another module becomes visible by name in ModScope.traits).
import { flushPointerElements } from "narrac/unsafecode"
import * as Int from "std/int"
import * as Str from "std/string"
import { Pos, File, Decl, FuncDecl, TraitDecl, ImplDecl, EnumDecl, TypeExpr } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import {
  Type,
  Field,
  Variant,
  ParamInfo,
  TraitInfo,
  TraitFunc,
  TypeTraits,
  ImplInfo,
  ImplFunc,
  ImplRef,
  typeKey,
} from "narrac/types"
import {
  Checker,
  ProgramFunc,
  setParameterType,
  reportError,
  reportErrorIn,
  lookupType,
  lookupGeneric,
  lookupTrait,
  stdTrait,
  typeString,
  containsTypeParameter,
  checkMutableType,
  isContentsType,
  findSharedParameter,
} from "narrac/check"
import { resolveOpt, resolveType, substitute } from "narrac/resolve"
import { makeEnv } from "narrac/generics"
import {
  checkImplementHead,
  createImplementEnvironment,
  registerImplementMember,
} from "narrac/genericimpl"
import { HIDDEN_SHAPE, isShapeDerive } from "narrac/deriveshape"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"

function isDerivable(name: string): bool {
  return name == "Equatable" || name == "Hashable" || name == "Ordered" || name == "Show"
}

function modPath(checker: Checker): string {
  return checker.scopes[checker.current].path
}

function typeNamePos(): Pos {
  return Pos { line: 0, column: 0 }
}

function ownsType(checker: Checker, info: TypeTraits): bool {
  return info.module == modPath(checker)
}

function traitNamed(mutable checker: Checker, typeExpr: TypeExpr): int uses alloc {
  const traitIndex = lookupTrait(checker, typeExpr.name)
  if (traitIndex < 0) {
    reportError(mutable checker, typeExpr.pos, "E0505", `unknown trait ${quoteGo(typeExpr.name)}`)
  }
  return traitIndex
}

export function findTraitFunc(checker: Checker, traitIndex: int, name: string): int {
  let found = -1
  for (const index of Ranges.between(0, Arrays.length(checker.traits[traitIndex].functions))) {
    if (checker.traits[traitIndex].functions[index].name == name) {
      found = index
    }
  }
  return found
}

function typeTraitsKey(checker: Checker, type: Type): string {
  // Two modules may use one name, so the key holds the module.
  return match (type) {
    Type.TStruct(index) => `${checker.structs[index].module}|${checker.structs[index].name}`
    Type.TEnum(index) => `${checker.enums[index].module}|${checker.enums[index].name}`
    Type.TDistinct(index) => `${checker.distincts[index].module}|${checker.distincts[index].name}`
    _ => ""
  }
}

export function findTypeTraits(mutable checker: Checker, type: Type): int uses alloc {
  const key = typeTraitsKey(checker, type)
  if (key == "") {
    return -1
  }
  if (checker.typeTraitIndex[key] is Some(index)) {
    return index
  }
  if (type is Type.TStruct(structIndex)) {
    // Tuples derive Show and Ordered, and get Equatable and Hashable like any struct. Go records that when the first tuple is made, here it is made on first use.
    if (checker.structs[structIndex].tuple) {
      let derived: Map<int, bool> = Map {}
      const ordered = stdTrait(checker, "Ordered")
      const show = stdTrait(checker, "Show")
      if (ordered >= 0) {
        derived[ordered] = true
      }
      if (show >= 0) {
        derived[show] = true
      }
      const info = TypeTraits {
        name: "Tuple",
        module: "",
        pos: typeNamePos(),
        generic: true,
        implementationExpressions: [],
        derivedExpressions: [],
        listed: Map {},
        derived: derived,
        blocks: Map {},
      }
      return addTypeTraitsEntry(mutable checker, key, info)
    }
  }
  return -1
}

function typeTraitsAt(checker: Checker, key: string): int {
  if (checker.typeTraitIndex[key] is Some(index)) {
    return index
  }
  return -1
}

function addTypeTraitsEntry(
  mutable checker: Checker,
  key: string,
  info: TypeTraits,
): int uses alloc {
  if (checker.typeTraitIndex[key] is Some(index)) {
    checker.typeTraits[index] = info
    return index
  }
  const newIndex = Arrays.length(checker.typeTraits)
  Arrays.push(mutable checker.typeTraits, info)
  checker.typeTraitIndex[key] = newIndex
  return newIndex
}

export function declareTraits(mutable checker: Checker, file: File) uses alloc {
  // Runs after type names are declared and before function signatures, so constraints can name traits.
  const modulePath = modPath(checker)
  for (const declaration of Arrays.values(file.declarations)) {
    match (declaration) {
      Decl.Trait(traitDecl) => declareTrait(mutable checker, traitDecl, modulePath)
      Decl.Struct(structDecl) => {
        const info = TypeTraits {
          name: structDecl.name,
          module: modulePath,
          pos: structDecl.pos,
          generic: Arrays.length(structDecl.typeParameters) > 0,
          implementationExpressions: structDecl.implementations,
          derivedExpressions: structDecl.derived,
          listed: Map {},
          derived: Map {},
          blocks: Map {},
        }
        const _ = addTypeTraitsEntry(mutable checker, `${modulePath}|${structDecl.name}`, info)
      }
      Decl.Enum(enumDecl) => {
        const info = TypeTraits {
          name: enumDecl.name,
          module: modulePath,
          pos: enumDecl.pos,
          generic: Arrays.length(enumDecl.typeParameters) > 0,
          implementationExpressions: enumDecl.implementations,
          derivedExpressions: enumDecl.derived,
          listed: Map {},
          derived: Map {},
          blocks: Map {},
        }
        const _ = addTypeTraitsEntry(mutable checker, `${modulePath}|${enumDecl.name}`, info)
      }
      Decl.Distinct(distinctDecl) => {
        const info = TypeTraits {
          name: distinctDecl.name,
          module: modulePath,
          pos: distinctDecl.pos,
          generic: false,
          implementationExpressions: distinctDecl.implementations,
          derivedExpressions: distinctDecl.derived,
          listed: Map {},
          derived: Map {},
          blocks: Map {},
        }
        const _ = addTypeTraitsEntry(mutable checker, `${modulePath}|${distinctDecl.name}`, info)
      }
      _ => {}
    }
  }
  for (const declaration of Arrays.values(file.declarations)) {
    match (declaration) {
      Decl.Distinct(distinctDecl) => {
        declareListed(mutable checker, `${modulePath}|${distinctDecl.name}`)
      }
      Decl.Struct(structDecl) => declareListed(mutable checker, `${modulePath}|${structDecl.name}`)
      Decl.Enum(enumDecl) => declareListed(mutable checker, `${modulePath}|${enumDecl.name}`)
      _ => {}
    }
  }
}

function declareTrait(
  mutable checker: Checker,
  traitDecl: TraitDecl,
  modulePath: string,
) uses alloc {
  const isType = lookupType(checker, traitDecl.name) is Some(_)
  const isGeneric = lookupGeneric(checker, traitDecl.name) is Some(_)
  if (lookupTrait(checker, traitDecl.name) >= 0 || isType || isGeneric) {
    reportError(
      mutable checker,
      traitDecl.pos,
      "E0500",
      `${quoteGo(traitDecl.name)} is declared twice`,
    )
    return
  }
  const selfParameter = Arrays.length(checker.parameters)
  Arrays.push(mutable checker.parameters, ParamInfo { name: "Self" })
  const index = Arrays.length(checker.traits)
  const info = TraitInfo {
    name: traitDecl.name,
    module: modulePath,
    std: modulePath == "" && isDerivable(traitDecl.name),
    declaration: traitDecl,
    selfParameter: selfParameter,
    functions: [],
  }
  Arrays.push(mutable checker.traits, info)
  const scope = checker.current
  checker.scopes[scope].traits[traitDecl.name] = index
}

function declareListed(mutable checker: Checker, key: string) uses alloc {
  const entryIndex = typeTraitsAt(checker, key)
  if (entryIndex < 0) {
    return
  }
  checker.typeTraits[entryIndex].listed = Map {}
  checker.typeTraits[entryIndex].derived = Map {}
  checker.typeTraits[entryIndex].blocks = Map {}
  const info = copy(checker.typeTraits[entryIndex])
  for (const typeExpr of Arrays.values(info.implementationExpressions)) {
    const traitIndex = traitNamed(mutable checker, typeExpr)
    if (traitIndex < 0) {
      continue
    }
    if (checker.typeTraits[entryIndex].listed[traitIndex] is Some(_)) {
      const message = `${checker.traits[traitIndex].name} is listed twice in \`implements\``
      reportError(mutable checker, typeExpr.pos, "E0501", message)
    }
    checker.typeTraits[entryIndex].listed[traitIndex] = true
  }
  for (const typeExpr of Arrays.values(info.derivedExpressions)) {
    let traitIndex = derivedTrait(checker, typeExpr)
    if (traitIndex < 0) {
      traitIndex = traitNamed(mutable checker, typeExpr)
    }
    if (traitIndex < 0) {
      continue
    }
    if (!checker.traits[traitIndex].std && !isShapeTrait(checker, traitIndex)) {
      const message = `${checker.traits[traitIndex].name} cannot be derived; only Equatable, Hashable, Ordered, Show and Shape can. List it in \`implements\` and write \`implement ${checker.traits[traitIndex].name} for ${info.name}\``
      reportError(mutable checker, typeExpr.pos, "E0503", message)
      continue
    }
    if (checker.typeTraits[entryIndex].derived[traitIndex] is Some(_)) {
      const message = `${checker.traits[traitIndex].name} is listed twice in \`derives\``
      reportError(mutable checker, typeExpr.pos, "E0504", message)
    }
    checker.typeTraits[entryIndex].derived[traitIndex] = true
  }
}

function derivedTrait(checker: Checker, typeExpr: TypeExpr): int {
  const traitIndex = lookupTrait(checker, typeExpr.name)
  // A bare Shape is the trait of std/shape when the module has no Shape of its own: the code written for `derives Shape` imports it under a hidden name.
  if (traitIndex < 0 && isShapeDerive(typeExpr)) {
    return lookupTrait(checker, HIDDEN_SHAPE)
  }
  return traitIndex
}

export function funcBounds(
  mutable checker: Checker,
  funcDecl: FuncDecl,
  typeParameters: Array<int>,
) uses alloc {
  for (const i of Ranges.between(0, Arrays.length(funcDecl.bounds))) {
    if (i >= Arrays.length(typeParameters)) {
      continue
    }
    let seen: Map<int, bool> = Map {}
    for (const typeExpr of Arrays.values(funcDecl.bounds[i])) {
      const traitIndex = traitNamed(mutable checker, typeExpr)
      if (traitIndex < 0) {
        continue
      }
      if (seen[traitIndex] is Some(_)) {
        const message = `${checker.traits[traitIndex].name} is listed twice in the constraint of ${funcDecl.typeParameters[i]}`
        reportError(mutable checker, typeExpr.pos, "E0506", message)
        continue
      }
      seen[traitIndex] = true
      let current: Array<int> = []
      if (checker.bounds[typeParameters[i]] is Some(bounds)) {
        current = copy(bounds)
      }
      Arrays.push(mutable current, traitIndex)
      checker.bounds[typeParameters[i]] = current
    }
  }
}

export function resolveTraits(mutable checker: Checker, file: File) uses alloc {
  // Runs once every type's fields are known.
  const modulePath = modPath(checker)
  for (const declaration of Arrays.values(file.declarations)) {
    if (declaration is Decl.Trait(traitDecl)) {
      if (checker.scopes[checker.current].traits[traitDecl.name] is Some(traitIndex)) {
        if (
          checker.traits[traitIndex].module == modulePath &&
            checker.traits[traitIndex].declaration.pos == traitDecl.pos
        ) {
          resolveTraitDecl(mutable checker, traitIndex)
        }
      }
    }
  }
  for (const declaration of Arrays.values(file.declarations)) {
    if (declaration is Decl.Impl(implDecl)) {
      resolveImpl(mutable checker, implDecl)
    }
  }
  if (modulePath == "") {
    return
  }
  for (const declaration of Arrays.values(file.declarations)) {
    match (declaration) {
      Decl.Struct(structDecl) => {
        let type = Type.TVoid
        if (Arrays.length(structDecl.typeParameters) == 0) {
          if (lookupType(checker, structDecl.name) is Some(structType)) {
            type = copy(structType)
          }
        }
        checkListed(mutable checker, modulePath, structDecl.name, type)
      }
      Decl.Enum(enumDecl) => {
        let type = Type.TVoid
        if (Arrays.length(enumDecl.typeParameters) == 0) {
          if (lookupType(checker, enumDecl.name) is Some(enumType)) {
            type = copy(enumType)
          }
        }
        checkListed(mutable checker, modulePath, enumDecl.name, type)
        checkShapeTags(mutable checker, enumDecl)
      }
      Decl.Distinct(distinctDecl) => {
        let type = Type.TVoid
        if (lookupType(checker, distinctDecl.name) is Some(distinctType)) {
          type = copy(distinctType)
        }
        checkListed(mutable checker, modulePath, distinctDecl.name, type)
      }
      _ => {}
    }
  }
}

function checkListed(
  mutable checker: Checker,
  modulePath: string,
  name: string,
  type: Type,
) uses alloc {
  // The type is TVoid for a generic type.
  const entryIndex = typeTraitsAt(checker, `${modulePath}|${name}`)
  if (entryIndex < 0) {
    return
  }
  const info = copy(checker.typeTraits[entryIndex])
  for (const typeExpr of Arrays.values(info.implementationExpressions)) {
    const traitIndex = lookupTrait(checker, typeExpr.name)
    if (traitIndex >= 0) {
      if (
        checker.typeTraits[entryIndex].blocks[traitIndex] is None &&
          checker.typeTraits[entryIndex].derived[traitIndex] is None
      ) {
        const traitName = checker.traits[traitIndex].name
        let message = `${info.name} implements ${traitName} but has no \`implement ${traitName} for ${info.name}\` block`
        // Only the built-in traits can be derived.
        if (checker.traits[traitIndex].std || isShapeTrait(checker, traitIndex)) {
          message = `${message} or \`derives ${traitName}\``
        }
        reportError(mutable checker, typeExpr.pos, "E0507", message)
      }
    }
  }
  for (const typeExpr of Arrays.values(info.derivedExpressions)) {
    const traitIndex = derivedTrait(checker, typeExpr)
    if (traitIndex < 0) {
      continue
    }
    if (checker.typeTraits[entryIndex].derived[traitIndex] is None) {
      continue
    }
    if (checker.typeTraits[entryIndex].blocks[traitIndex] is Some(_)) {
      const message = `${info.name} both derives and implements ${checker.traits[traitIndex].name}; keep one`
      reportError(mutable checker, typeExpr.pos, "E0508", message)
      continue
    }
    // A distinct type derives a trait when its base type implements it.
    if (type is Type.TDistinct(distinctIndex)) {
      if (checker.distincts[distinctIndex].base is Some(base)) {
        if (!typeImplements(mutable checker, base, traitIndex)) {
          const traitName = checker.traits[traitIndex].name
          const baseText = typeString(checker, base)
          const message = `cannot derive ${traitName} for ${info.name}: its base type ${baseText} does not implement ${traitName}`
          reportError(mutable checker, typeExpr.pos, "E1012", message)
        }
      }
      continue
    }
    if (isShapeTrait(checker, traitIndex)) {
      for (const field of Arrays.values(copy(shapeCheckedFields(checker, name, type)))) {
        const reason = shapeProblem(mutable checker, field.fieldType, traitIndex)
        if (reason != "") {
          const message = `cannot derive Shape for ${info.name}: field ${quoteGo(field.name)} has type ${typeString(checker, field.fieldType)}, which does not implement Shape: ${reason}`
          reportError(mutable checker, typeExpr.pos, "E0531", message)
        }
      }
      continue
    }
    // A generic type derives a trait for the instances whose contents
    // implement it, so only concrete types are checked here.
    if (type == Type.TVoid) {
      continue
    }
    for (const field of Arrays.values(copy(listFields(checker, type)))) {
      if (!typeImplements(mutable checker, field.fieldType, traitIndex)) {
        const message = `cannot derive ${checker.traits[traitIndex].name} for ${info.name}: field ${quoteGo(field.name)} has type ${typeString(checker, field.fieldType)}, which does not implement ${checker.traits[traitIndex].name}`
        reportError(mutable checker, typeExpr.pos, "E0509", message)
      }
    }
  }
}

function shapeCheckedFields(
  checker: Checker,
  name: string,
  type: Type,
): Array<Field> from checker uses alloc {
  // A concrete type checks every field. A generic type (TVoid) checks the fields that do not mention its type parameters, since the generated code bounds those by Shape.
  if (type != Type.TVoid) {
    return listFields(checker, type)
  }
  let out: Array<Field> = []
  if (lookupGeneric(checker, name) is Some(generic)) {
    let fields = copy(checker.generics[generic].fields)
    for (const variant of Arrays.values(checker.generics[generic].variants)) {
      for (const field of Arrays.values(variant.fields)) {
        Arrays.push(mutable fields, field)
      }
    }
    for (const field of Arrays.values(fields)) {
      if (!containsTypeParameter(checker, field.fieldType)) {
        Arrays.push(mutable out, field)
      }
    }
  }
  return out
}

function shapeDerivedIndex(checker: Checker, name: string): int {
  const entryIndex = typeTraitsAt(checker, `${modPath(checker)}|${name}`)
  const shape = lookupTrait(checker, HIDDEN_SHAPE)
  if (entryIndex < 0 || shape < 0) {
    return -1
  }
  if (checker.typeTraits[entryIndex].derived[shape] is None) {
    return -1
  }
  return shape
}

function checkShapeTags(mutable checker: Checker, enumDecl: EnumDecl) uses alloc {
  if (shapeDerivedIndex(checker, enumDecl.name) < 0) {
    return
  }
  for (const variant of Arrays.values(enumDecl.variants)) {
    for (const field of Arrays.values(variant.fields)) {
      // The encoding keeps the constructor name under "type".
      if (field.name == "type") {
        const message = `${enumDecl.name} derives Shape, so ${enumDecl.name}.${variant.name} cannot have a field named "type": the encoding writes the constructor name there`
        reportError(mutable checker, field.pos, "E0532", message)
      }
    }
  }
}

export function shapeDeriveHolds(mutable checker: Checker, typeName: string): bool uses alloc {
  // The body checker skips the generated functions of a type for which this is false, so the error is reported once.
  const shape = shapeDerivedIndex(checker, typeName)
  if (shape < 0) {
    return false
  }
  let type = Type.TVoid
  if (lookupType(checker, typeName) is Some(found)) {
    type = copy(found)
  }
  if (type is Type.TDistinct(distinctIndex)) {
    if (checker.distincts[distinctIndex].base is Some(base)) {
      return typeImplements(mutable checker, base, shape)
    }
    return false
  }
  for (const field of Arrays.values(copy(shapeCheckedFields(checker, typeName, type)))) {
    if (!typeImplements(mutable checker, field.fieldType, shape)) {
      return false
    }
  }
  // An enum with a constructor field named type is E0532.
  let variants: Array<Variant> = []
  if (type is Type.TEnum(enumIndex)) {
    variants = checker.enums[enumIndex].variants
  } else if (lookupGeneric(checker, typeName) is Some(generic)) {
    variants = checker.generics[generic].variants
  }
  for (const variant of Arrays.values(variants)) {
    for (const field of Arrays.values(variant.fields)) {
      if (field.name == "type") {
        return false
      }
    }
  }
  return true
}

function containsParam(checker: Checker, type: Type, param: int): bool {
  return match (type) {
    Type.TParam(found) => found == param
    Type.TArray(element)
      | Type.TBox(element)
      | Type.TPtr(element)
      | Type.TFixedArray(element, _) => containsParam(checker, element, param)
    Type.TMap(key, value) =>
      containsParam(checker, key, param) || containsParam(checker, value, param)
    Type.TFunc(parameters, result, _, _, _) =>
      anyParam(checker, parameters, param) || containsParam(checker, result, param)
    Type.TStruct(index) => anyParam(checker, checker.structs[index].arguments, param)
    Type.TEnum(index) => anyParam(checker, checker.enums[index].arguments, param)
    _ => false
  }
}

function anyParam(checker: Checker, types: Array<Type>, param: int): bool {
  for (const type of Arrays.values(types)) {
    if (containsParam(checker, type, param)) {
      return true
    }
  }
  return false
}

function resolveTraitDecl(mutable checker: Checker, traitIndex: int) uses alloc {
  const traitDecl = copy(checker.traits[traitIndex].declaration)
  const name = checker.traits[traitIndex].name
  const selfParameter = checker.traits[traitIndex].selfParameter
  checker.environment = Map { "Self": Type.TParam(selfParameter) }
  let seen: Map<string, bool> = Map {}
  for (const funcDecl of Arrays.values(traitDecl.functions)) {
    if (Arrays.length(funcDecl.typeParameters) > 0) {
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0510",
        "trait functions cannot have type parameters in this compiler yet",
      )
    }
    if (seen[funcDecl.name] is Some(_)) {
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0511",
        `${name} declares function ${quoteGo(funcDecl.name)} twice`,
      )
    }
    seen[funcDecl.name] = true
    let parameters: Array<Type> = []
    let mentionsSelf = false
    for (const param of Arrays.values(funcDecl.parameters)) {
      const paramType = resolveOpt(mutable checker, param.type)
      setParameterType(mutable checker, param.id, paramType)
      Arrays.push(mutable parameters, paramType)
      if (param.isMutable) {
        checkMutableType(mutable checker, param.pos, paramType, selfParameter)
      }
      if (containsParam(checker, paramType, selfParameter)) {
        mentionsSelf = true
      }
    }
    const result = resolveOpt(mutable checker, funcDecl.result)
    // Self only in the result is allowed; a call names the type with
    // Trait.f<T>(...).
    if (containsParam(checker, result, selfParameter)) {
      mentionsSelf = true
    }
    if (!mentionsSelf) {
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0512",
        `${name}.${funcDecl.name} must use Self in a parameter or its result, so a call can tell which implementation to run`,
      )
    }
    const traitFunc = TraitFunc {
      name: funcDecl.name,
      declaration: copy(funcDecl),
      parameters: parameters,
      result: result,
    }
    Arrays.push(mutable checker.traits[traitIndex].functions, traitFunc)
  }
  checker.environment = Map {}
}

export function typeExprString(typeExpr: TypeExpr): string uses alloc {
  if (typeExpr.isFunc) {
    return "a function type"
  }
  if (Arrays.length(typeExpr.arguments) == 0 && !typeExpr.isTuple) {
    return typeExpr.name
  }
  let parts: Array<string> = []
  for (const argument of Arrays.values(typeExpr.arguments)) {
    Arrays.push(mutable parts, typeExprString(argument))
  }
  if (typeExpr.isTuple) {
    return `#[${Str.join(parts, ", ")}]`
  }
  return `${typeExpr.name}<${Str.join(parts, ", ")}>`
}

function resolveImpl(mutable checker: Checker, implDecl: ImplDecl) uses alloc {
  const traitIndex = traitNamed(mutable checker, implDecl.traitType)
  if (traitIndex < 0) {
    return
  }
  const traitName = checker.traits[traitIndex].name
  const typeExpr = implDecl.type
  let entryIndex = -1
  if (!typeExpr.isFunc) {
    if (lookupType(checker, typeExpr.name) is Some(named)) {
      const key = typeTraitsKey(checker, named)
      if (key != "") {
        entryIndex = typeTraitsAt(checker, key)
      }
    } else if (lookupGeneric(checker, typeExpr.name) is Some(generic)) {
      entryIndex = typeTraitsAt(
        checker,
        `${checker.generics[generic].module}|${checker.generics[generic].name}`,
      )
    } else if (typeExpr.name != "Array") {
      reportError(mutable checker, typeExpr.pos, "E0118", `unknown type ${quoteGo(typeExpr.name)}`)
      return
    }
  }
  if (entryIndex < 0 || !ownsType(checker, checker.typeTraits[entryIndex])) {
    reportError(
      mutable checker,
      implDecl.pos,
      "E0513",
      `cannot implement ${traitName} for ${typeExprString(typeExpr)}: the type is declared in another module; wrap it in a struct`,
    )
    return
  }
  const info = copy(checker.typeTraits[entryIndex])
  // A generic type is named with its own parameters, and the block holds the type with them open.
  let type = Type.TVoid
  let parameters: Array<int> = []
  if (info.generic) {
    if (lookupGeneric(checker, typeExpr.name) is Some(generic)) {
      const writtenType = typeExprString(typeExpr)
      if (!checkImplementHead(mutable checker, implDecl, traitName, writtenType, generic)) {
        markRejectedBlock(mutable checker, entryIndex, traitIndex)
        return
      }
      parameters = copy(checker.generics[generic].parameters)
      checker.environment = makeEnv(checker, parameters)
      type = resolveType(mutable checker, typeExpr)
      checker.environment = Map {}
    }
  } else if (Arrays.length(typeExpr.arguments) > 0) {
    reportError(mutable checker, typeExpr.pos, "E0117", `type ${typeExpr.name} is not generic`)
    markRejectedBlock(mutable checker, entryIndex, traitIndex)
    return
  } else if (lookupType(checker, typeExpr.name) is Some(namedType)) {
    type = copy(namedType)
  }
  if (type is Type.TDistinct(_) && checker.traits[traitIndex].std) {
    // == and map keys use the base value, so a block for them would never run.
    if (traitName == "Equatable" || traitName == "Hashable") {
      const use = match (traitName) { "Equatable" => "`==`", _ => "a map key" }
      const message = `cannot implement ${traitName} for ${info.name}: ${use} on a distinct type compares the base value (D62)`
      reportError(mutable checker, implDecl.pos, "E1014", message)
      markRejectedBlock(mutable checker, entryIndex, traitIndex)
      return
    }
  }
  if (info.listed[traitIndex] is None) {
    reportError(
      mutable checker,
      implDecl.pos,
      "E0515",
      `${info.name} does not list ${traitName} in \`implements\`; add \`implements ${traitName}\` to its declaration`,
    )
    return
  }
  if (info.blocks[traitIndex] is Some(_)) {
    reportError(
      mutable checker,
      implDecl.pos,
      "E0516",
      `${traitName} is implemented twice for ${info.name}`,
    )
    return
  }
  const blockIndex = Arrays.length(checker.implementations)
  checker.typeTraits[entryIndex].blocks[traitIndex] = blockIndex
  const implScope = checker.current
  Arrays.push(mutable checker.implementations, ImplInfo {
    declaration: copy(implDecl),
    scope: implScope,
    traitIndex: traitIndex,
    forType: type,
    functions: [],
  })
  let selfMap: Map<int, Type> = Map {}
  selfMap[checker.traits[traitIndex].selfParameter] = type
  checker.environment = createImplementEnvironment(checker, parameters, type)
  checkMutableSelf(mutable checker, implDecl.pos, traitIndex, type, info.name)
  let got: Map<string, bool> = Map {}
  for (const funcDecl of Arrays.values(implDecl.functions)) {
    if (Arrays.length(funcDecl.typeParameters) > 0) {
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0517",
        "functions in an implement block cannot have type parameters in this compiler yet",
      )
    }
    for (const param of Arrays.values(funcDecl.parameters)) {
      const paramType = resolveOpt(mutable checker, param.type)
      setParameterType(mutable checker, param.id, paramType)
    }
    const result = resolveOpt(mutable checker, funcDecl.result)
    const funcIndex = findTraitFunc(checker, traitIndex, funcDecl.name)
    if (funcIndex < 0) {
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0518",
        `trait ${traitName} has no function ${quoteGo(funcDecl.name)}`,
      )
      continue
    }
    if (got[funcDecl.name] is Some(_)) {
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0519",
        `function ${quoteGo(funcDecl.name)} is implemented twice`,
      )
      continue
    }
    got[funcDecl.name] = true
    if (!sameSignature(mutable checker, funcDecl, result, traitIndex, funcIndex, selfMap)) {
      const text = signatureText(mutable checker, traitIndex, funcIndex, selfMap)
      reportError(
        mutable checker,
        funcDecl.pos,
        "E0520",
        `${traitName}.${funcDecl.name} for ${info.name} must be \`${text}\``,
      )
    }
    const implIndex = Arrays.length(checker.implementations[blockIndex].functions)
    Arrays.push(
      mutable checker.implementations[blockIndex].functions,
      ImplFunc { name: funcDecl.name, declaration: copy(funcDecl), result: result },
    )
    if (info.generic) {
      registerImplementMember(mutable checker, blockIndex, funcDecl, parameters, result, type)
      continue
    }
    checker.implFunctions[`${typeKey(type)}|${traitName}.${funcDecl.name}`] = ImplRef {
      block: blockIndex,
      index: implIndex,
    }
    Arrays.push(mutable checker.programFunctions, ProgramFunc.ImplFunc(blockIndex, implIndex))
  }
  checker.environment = Map {}
  for (const traitFunc of Arrays.values(copy(checker.traits[traitIndex].functions))) {
    if (got[traitFunc.name] is None) {
      reportError(
        mutable checker,
        implDecl.pos,
        "E0521",
        `implement ${traitName} for ${info.name} is missing function ${traitFunc.name}`,
      )
    }
  }
}

function markRejectedBlock(mutable checker: Checker, entryIndex: int, traitIndex: int) uses alloc {
  // A block whose head is wrong was still written: -1 keeps E0507 from asking for it again.
  if (checker.typeTraits[entryIndex].blocks[traitIndex] is None) {
    checker.typeTraits[entryIndex].blocks[traitIndex] = -1
  }
}

function checkMutableSelf(
  mutable checker: Checker,
  pos: Pos,
  traitIndex: int,
  type: Type,
  typeName: string,
) uses alloc {
  // Only a type whose contents change in place can implement a trait whose functions take `mutable Self`.
  if (isContentsType(checker, type)) {
    return
  }
  const selfType = Type.TParam(checker.traits[traitIndex].selfParameter)
  for (const traitFunc of Arrays.values(copy(checker.traits[traitIndex].functions))) {
    for (const i of Ranges.between(0, Arrays.length(traitFunc.parameters))) {
      if (traitFunc.declaration.parameters[i].isMutable && traitFunc.parameters[i] == selfType) {
        const traitName = checker.traits[traitIndex].name
        reportError(
          mutable checker,
          pos,
          "E0952",
          `${traitName}.${traitFunc.name} takes \`mutable Self\`, so ${traitName} can only be implemented for a type whose contents change in place (a struct, Array, Map, Box, StringBuilder or Generator), not ${typeName}`,
        )
        return
      }
    }
  }
}

function sameSignature(
  mutable checker: Checker,
  funcDecl: FuncDecl,
  result: Type,
  traitIndex: int,
  funcIndex: int,
  selfMap: Map<int, Type>,
): bool uses alloc {
  const traitFunc = copy(checker.traits[traitIndex].functions[funcIndex])
  const want = copy(traitFunc.declaration)
  if (Arrays.length(funcDecl.parameters) != Arrays.length(want.parameters)) {
    return false
  }
  const wantResult = substitute(mutable checker, traitFunc.result, selfMap)
  if (result != wantResult) {
    return false
  }
  // A fresh result fits a trait function with `from`, not the other way round.
  const shared = findSharedParameter(funcDecl)
  if (shared >= 0 && shared != findSharedParameter(want)) {
    return false
  }
  for (const i of Ranges.between(0, Arrays.length(funcDecl.parameters))) {
    const param = funcDecl.parameters[i]
    if (
      param.isMutable != want.parameters[i].isMutable ||
        param.escaping != want.parameters[i].escaping
    ) {
      return false
    }
    const wantType = substitute(mutable checker, traitFunc.parameters[i], selfMap)
    if (checker.paramTypes[param.id] != wantType) {
      return false
    }
  }
  return true
}

function signatureText(
  mutable checker: Checker,
  traitIndex: int,
  funcIndex: int,
  selfMap: Map<int, Type>,
): string uses alloc {
  const traitFunc = copy(checker.traits[traitIndex].functions[funcIndex])
  let parts: Array<string> = []
  for (const i of Ranges.between(0, Arrays.length(traitFunc.declaration.parameters))) {
    const param = copy(traitFunc.declaration.parameters[i])
    let flags = ""
    if (param.isMutable) {
      flags = "mutable "
    }
    if (param.escaping) {
      flags = "escaping "
    }
    const paramType = substitute(mutable checker, traitFunc.parameters[i], selfMap)
    Arrays.push(mutable parts, `${flags}${param.name}: ${typeString(checker, paramType)}`)
  }
  let text = `function ${traitFunc.name}(${Str.join(parts, ", ")})`
  const result = substitute(mutable checker, traitFunc.result, selfMap)
  if (result != Type.TVoid) {
    text = `${text}: ${typeString(checker, result)}`
    if (traitFunc.declaration.result is Some(written)) {
      if (written.resultFrom != "") {
        text = `${text} from ${written.resultFrom}`
      }
    }
  }
  return text
}

export function listFields(checker: Checker, type: Type): Array<Field> from checker uses alloc {
  let out: Array<Field> = []
  match (type) {
    Type.TStruct(index) => {
      out = checker.structs[index].fields
    }
    Type.TEnum(index) => {
      for (const variant of Arrays.values(checker.enums[index].variants)) {
        for (const field of Arrays.values(variant.fields)) {
          Arrays.push(mutable out, field)
        }
      }
    }
    _ => {}
  }
  return out
}

export function typeImplements(
  mutable checker: Checker,
  type: Type,
  traitIndex: int,
): bool uses alloc {
  if (traitIndex < 0) {
    return false
  }
  const key = `${Int.toString(traitIndex)}|${typeKey(type)}`
  if (checker.busy[key] is Some(_)) {
    // Reached again through an array, as in `struct Tree { kids: Array<Tree> }`.
    return true
  }
  checker.busy[key] = true
  const result = computeImplements(mutable checker, type, traitIndex)
  const _ = Maps.remove(mutable checker.busy, key)
  return result
}

function computeImplements(mutable checker: Checker, type: Type, traitIndex: int): bool uses alloc {
  if (isShapeTrait(checker, traitIndex) && !(type is Type.TParam(_))) {
    return shapeImplements(mutable checker, type, traitIndex)
  }
  const std = checker.traits[traitIndex].std
  const name = checker.traits[traitIndex].name
  match (type) {
    Type.TParam(param) => {
      if (checker.bounds[param] is Some(bounds)) {
        for (const bound of Arrays.values(bounds)) {
          if (bound == traitIndex) {
            return true
          }
        }
      }
      return false
    }
    Type.TVoid | Type.TStringBuilder => {
      return false
    }
    // Arrays, boxes and the prelude enums implement a standard trait when their contents do.
    Type.TArray(element) | Type.TBox(element) | Type.TFixedArray(element, _) => {
      return std && typeImplements(mutable checker, element, traitIndex)
    }
    Type.TDistinct(_) => {
      return distinctImplements(mutable checker, type, traitIndex)
    }
    Type.TStruct(_) | Type.TEnum(_) => {
      return nominalImplements(mutable checker, type, traitIndex)
    }
    Type.TFunc(_, _, _, _, _)
      | Type.TMap(_, _)
      | Type.TRange
      | Type.TGenerator(_, _, _, _, _)
      | Type.TAsync(_)
      | Type.TPtr(_)
      | Type.TModule(_)
      | Type.TDynamic(_) => {
      return false
    }
    _ => {
      // The primitives.
      if (!std) {
        return false
      }
      return name != "Hashable" || !(type == Type.TF64 || type == Type.TF32)
    }
  }
}

export function isShapeTrait(checker: Checker, traitIndex: int): bool {
  return checker.traits[traitIndex].name == "Shape" &&
    checker.traits[traitIndex].module == "std/shape"
}

function shapeImplements(mutable checker: Checker, type: Type, traitIndex: int): bool uses alloc {
  match (type) {
    Type.TBool | Type.TInt | Type.TF64 | Type.TChar | Type.TStr => {
      return true
    }
    Type.TArray(element) => {
      return typeImplements(mutable checker, element, traitIndex)
    }
    Type.TMap(key, valueType) => {
      return key == Type.TStr && typeImplements(mutable checker, valueType, traitIndex)
    }
    Type.TDistinct(_) => {
      return distinctImplements(mutable checker, type, traitIndex)
    }
    Type.TEnum(index) => {
      if (checker.enums[index].module == "" && checker.enums[index].name == "Option") {
        const element = checker.enums[index].arguments[0]
        return typeImplements(mutable checker, element, traitIndex)
      }
      return nominalImplements(mutable checker, type, traitIndex)
    }
    // A tuple of two to four items implements Shape when its items do. A struct or enum needs an implement block.
    Type.TStruct(index) => {
      if (checker.structs[index].tuple) {
        const count = Arrays.length(checker.structs[index].arguments)
        if (count < 2 || count > 4) {
          return false
        }
        for (const argument of Arrays.values(copy(checker.structs[index].arguments))) {
          if (!typeImplements(mutable checker, argument, traitIndex)) {
            return false
          }
        }
        return true
      }
      return nominalImplements(mutable checker, type, traitIndex)
    }
    // Sized integers, functions and the rest do not implement Shape.
    _ => {
      return false
    }
  }
}

function shapeProblem(mutable checker: Checker, type: Type, traitIndex: int): string uses alloc {
  if (typeImplements(mutable checker, type, traitIndex)) {
    return ""
  }
  const text = typeString(checker, type)
  match (type) {
    Type.TArray(element) => {
      return shapeProblem(mutable checker, element, traitIndex)
    }
    Type.TMap(key, valueType) => {
      if (key != Type.TStr) {
        return `${text} has keys of type ${typeString(checker, key)}; a Map needs string keys`
      }
      return shapeProblem(mutable checker, valueType, traitIndex)
    }
    Type.TFunc(_, _, _, _, _) => {
      return `${text} is a function, which has no Value form`
    }
    Type.TEnum(index) => {
      if (checker.enums[index].module == "" && checker.enums[index].name == "Option") {
        const element = checker.enums[index].arguments[0]
        return shapeProblem(mutable checker, element, traitIndex)
      }
      return nominalShapeProblem(mutable checker, type, traitIndex)
    }
    Type.TStruct(index) => {
      if (checker.structs[index].tuple) {
        const count = Arrays.length(checker.structs[index].arguments)
        if (count < 2 || count > 4) {
          return `a tuple of ${Int.toString(count)} items is not supported; use two to four`
        }
        for (const argument of Arrays.values(copy(checker.structs[index].arguments))) {
          const problem = shapeProblem(mutable checker, argument, traitIndex)
          if (problem != "") {
            return problem
          }
        }
        return ""
      }
      return nominalShapeProblem(mutable checker, type, traitIndex)
    }
    _ => {
      return `${text} has no Value form`
    }
  }
}

function nominalShapeProblem(
  mutable checker: Checker,
  type: Type,
  traitIndex: int,
): string uses alloc {
  const text = typeString(checker, type)
  const entryIndex = findTypeTraits(mutable checker, type)
  if (entryIndex >= 0 && checker.typeTraits[entryIndex].derived[traitIndex] is Some(_)) {
    for (const field of Arrays.values(copy(listFields(checker, type)))) {
      const problem = shapeProblem(mutable checker, field.fieldType, traitIndex)
      if (problem != "") {
        return `${text} derives Shape, but its field ${quoteGo(field.name)} does not implement it: ${problem}`
      }
    }
  }
  return `${text} has no \`implement Shape for ${text}\` block`
}

export function reportShapeProblem(
  mutable checker: Checker,
  pos: Pos,
  type: Type,
  traitIndex: int,
) uses alloc {
  const reason = shapeProblem(mutable checker, type, traitIndex)
  const message = `${typeString(checker, type)} does not implement Shape: ${reason}`
  reportError(mutable checker, pos, "E0530", message)
}

export function isCellType(checker: Checker, type: Type): bool {
  if (type is Type.TStruct(index)) {
    return checker.structs[index].module == "std/cell" && checker.structs[index].name == "Cell"
  }
  return false
}

function distinctImplements(
  mutable checker: Checker,
  type: Type,
  traitIndex: int,
): bool uses alloc {
  // An implement block is the type's own; Equatable and Hashable come with the base, and a derived trait holds when the base implements it.
  const entryIndex = findTypeTraits(mutable checker, type)
  if (entryIndex >= 0 && checker.typeTraits[entryIndex].blocks[traitIndex] is Some(_)) {
    return true
  }
  const name = checker.traits[traitIndex].name
  const auto = checker.traits[traitIndex].std && (name == "Equatable" || name == "Hashable")
  const derived = entryIndex >= 0 && checker.typeTraits[entryIndex].derived[traitIndex] is Some(_)
  if (!auto && !derived) {
    return false
  }
  if (type is Type.TDistinct(index)) {
    if (checker.distincts[index].base is Some(base)) {
      return typeImplements(mutable checker, base, traitIndex)
    }
  }
  return false
}

function nominalImplements(mutable checker: Checker, type: Type, traitIndex: int): bool uses alloc {
  // A Cell is an identity type: no automatic Equatable or Hashable.
  if (isCellType(checker, type)) {
    return false
  }
  const entryIndex = findTypeTraits(mutable checker, type)
  if (entryIndex < 0) {
    return false
  }
  if (checker.typeTraits[entryIndex].blocks[traitIndex] is Some(_)) {
    return true
  }
  const name = checker.traits[traitIndex].name
  const auto = checker.traits[traitIndex].std && (name == "Equatable" || name == "Hashable")
  if (!auto && checker.typeTraits[entryIndex].derived[traitIndex] is None) {
    return false
  }
  for (const field of Arrays.values(copy(listFields(checker, type)))) {
    if (!typeImplements(mutable checker, field.fieldType, traitIndex)) {
      return false
    }
  }
  return true
}

export function implFunc(
  checker: Checker,
  type: Type,
  traitIndex: int,
  name: string,
): Option<ImplRef> from checker uses alloc {
  // None when the compiler provides the function (automatic Equatable and Hashable, derives).
  return checker.implFunctions[`${typeKey(type)}|${checker.traits[traitIndex].name}.${name}`]
}

export function checkBounds(
  mutable checker: Checker,
  pos: Pos,
  funcDecl: FuncDecl,
  typeParameters: Array<int>,
  typeArguments: Array<Type>,
): bool uses alloc {
  let ok = true
  for (const i of Ranges.between(0, Arrays.length(typeParameters))) {
    if (checker.bounds[typeParameters[i]] is Some(bounds)) {
      for (const traitIndex of Arrays.values(bounds)) {
        if (!typeImplements(mutable checker, typeArguments[i], traitIndex)) {
          if (isShapeTrait(checker, traitIndex)) {
            reportShapeProblem(mutable checker, pos, typeArguments[i], traitIndex)
            ok = false
            continue
          }
          const message = `${typeString(checker, typeArguments[i])} does not implement ${checker.traits[traitIndex].name}, which ${funcDecl.name} needs for type parameter ${checker.parameters[typeParameters[i]].name}`
          reportError(mutable checker, pos, "E0525", message)
          ok = false
        } else if (isShapeTrait(checker, traitIndex)) {
          checkShapeVisible(mutable checker, pos, typeArguments[i], traitIndex)
        }
      }
    }
  }
  return ok
}

export function checkShapeVisible(
  mutable checker: Checker,
  pos: Pos,
  type: Type,
  traitIndex: int,
) uses alloc {
  // Instance bodies are not checked; their call site was.
  if (
    checker.body >= 0 &&
      checker.body < Arrays.length(checker.bodies) &&
      Arrays.length(checker.bodies[checker.body].typeArguments) > 0
  ) {
    return
  }
  const name = findOpaqueShape(mutable checker, type, traitIndex)
  if (name != "") {
    const message = `${name} is an opaque struct that derives Shape; its Shape is usable only in its own module`
    reportError(mutable checker, pos, "E0533", message)
  }
}

function findOpaqueShape(mutable checker: Checker, type: Type, traitIndex: int): string uses alloc {
  let parts: Array<Type> = []
  match (type) {
    Type.TArray(element) => {
      parts = [element]
    }
    Type.TMap(_, valueType) => {
      parts = [valueType]
    }
    Type.TStruct(index) => {
      if (checker.structs[index].opaque && checker.structs[index].module != modPath(checker)) {
        const entryIndex = findTypeTraits(mutable checker, type)
        if (entryIndex >= 0 && checker.typeTraits[entryIndex].derived[traitIndex] is Some(_)) {
          return typeString(checker, type)
        }
      }
      parts = copy(checker.structs[index].arguments)
    }
    Type.TEnum(index) => {
      parts = copy(checker.enums[index].arguments)
    }
    _ => {}
  }
  for (const part of Arrays.values(parts)) {
    const name = findOpaqueShape(mutable checker, part, traitIndex)
    if (name != "") {
      return name
    }
  }
  return ""
}

export function checkEquatable(mutable checker: Checker, pos: Pos, type: Type) uses alloc {
  const equatable = stdTrait(checker, "Equatable")
  if (type == Type.TVoid || typeImplements(mutable checker, type, equatable)) {
    return
  }
  let seen: Map<string, bool> = Map {}
  const text = typeString(checker, type)
  if (type is Type.TAsync(_)) {
    reportError(
      mutable checker,
      pos,
      "E1106",
      `cannot use == on ${text}: a task handle is shared by identity; await the handles and compare the values`,
    )
  } else if (isCellType(checker, type)) {
    reportError(
      mutable checker,
      pos,
      "E0965",
      `cannot use == on ${text}: a Cell is shared by identity; compare the values with Cells.get`,
    )
  } else if (containsFunc(checker, type, mutable seen)) {
    reportError(mutable checker, pos, "E0526", `cannot use == on ${text}: it contains a function`)
  } else if (containsTypeParameter(checker, type)) {
    reportError(
      mutable checker,
      pos,
      "E0527",
      `== on ${text} needs Equatable; declare the type parameter as <T: Equatable>`,
    )
  } else {
    reportError(mutable checker, pos, "E0528", `${text} does not implement Equatable`)
  }
}

export function containsFunc(
  checker: Checker,
  type: Type,
  mutable seen: Map<string, bool>,
): bool uses alloc {
  const key = typeKey(type)
  if (seen[key] is Some(_)) {
    return false
  }
  seen[key] = true
  match (type) {
    Type.TFunc(_, _, _, _, _) => {
      return true
    }
    Type.TArray(element) | Type.TBox(element) | Type.TFixedArray(element, _) => {
      return containsFunc(checker, element, mutable seen)
    }
    Type.TDistinct(index) => {
      if (checker.distincts[index].base is Some(base)) {
        return containsFunc(checker, base, mutable seen)
      }
      return false
    }
    Type.TStruct(_) | Type.TEnum(_) => {
      return anyFunc(checker, type, mutable seen)
    }
    _ => {
      return false
    }
  }
}

function anyFunc(checker: Checker, type: Type, mutable seen: Map<string, bool>): bool uses alloc {
  for (const field of Arrays.values(listFields(checker, type))) {
    if (containsFunc(checker, field.fieldType, mutable seen)) {
      return true
    }
  }
  return false
}

export function mapKeyProblem(
  mutable checker: Checker,
  type: Type,
  mutable seen: Map<string, bool>,
): string uses alloc {
  // A key needs Equatable and Hashable. A user Equatable without a user Hashable keeps the field-based hash, so equal keys could hash differently: both or neither must be written.
  const key = typeKey(type)
  if (seen[key] is Some(_)) {
    return ""
  }
  seen[key] = true
  match (type) {
    Type.TF64 | Type.TF32 => {
      return "float keys are not allowed"
    }
    Type.TVoid => {
      return "void has no value"
    }
    Type.TArray(element) | Type.TBox(element) | Type.TFixedArray(element, _) => {
      return mapKeyProblem(mutable checker, element, mutable seen)
    }
    Type.TDistinct(index) => {
      if (checker.distincts[index].base is Some(base)) {
        return mapKeyProblem(mutable checker, base, mutable seen)
      }
      return ""
    }
    Type.TFunc(_, _, _, _, _) => {
      return "a function is not hashable"
    }
    Type.TMap(_, _) => {
      return "a map is not hashable"
    }
    Type.TRange => {
      return "a Range is not hashable"
    }
    Type.TGenerator(_, _, _, _, _) => {
      return "a Generator is not hashable"
    }
    Type.TAsync(_) => {
      return "an Async handle is shared by identity, not hashable"
    }
    Type.TPtr(_) => {
      return "a pointer is not hashable"
    }
    Type.TDynamic(_) => {
      return "a Dynamic is not hashable"
    }
    Type.TStruct(_) | Type.TEnum(_) => {
      return nominalKeyProblem(mutable checker, type, mutable seen)
    }
    _ => {
      return ""
    }
  }
}

function nominalKeyProblem(
  mutable checker: Checker,
  type: Type,
  mutable seen: Map<string, bool>,
): string uses alloc {
  if (isCellType(checker, type)) {
    return "a Cell is shared by identity, not hashable"
  }
  for (const field of Arrays.values(copy(listFields(checker, type)))) {
    const problem = mapKeyProblem(mutable checker, field.fieldType, mutable seen)
    if (problem != "") {
      return problem
    }
  }
  const entryIndex = findTypeTraits(mutable checker, type)
  if (entryIndex >= 0) {
    const equatable = stdTrait(checker, "Equatable")
    const hash = stdTrait(checker, "Hashable")
    const hasEquatable = checker.typeTraits[entryIndex].blocks[equatable] is Some(_)
    const hasHash = checker.typeTraits[entryIndex].blocks[hash] is Some(_)
    if (hasEquatable != hasHash) {
      return "it implements one of Equatable and Hashable but not the other"
    }
  }
  return ""
}

export function flushMapKeys(mutable checker: Checker) uses alloc {
  // Runs once every module is declared.
  flushPointerElements(mutable checker)
  const keys = checker.mapKeys
  checker.mapKeys = []
  for (const check of Arrays.values(keys)) {
    let seen: Map<string, bool> = Map {}
    const problem = mapKeyProblem(mutable checker, check.key, mutable seen)
    if (problem != "") {
      const message = `${typeString(checker, check.key)} cannot be a map key: ${problem}`
      // A handle as the key itself has a code of its own (D109 item 9).
      let code = "E0900"
      if (check.key is Type.TAsync(_)) {
        code = "E1106"
      }
      reportErrorIn(mutable checker, check.file, check.pos, code, message)
    }
  }
}
