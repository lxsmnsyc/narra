// error: a tag must be a function of (Array<string> or Template.Raw, Array<T>) with no mutable parameter, found (Array<int>, Array<int>) => int
struct Tags {
  tag: (parts: Array<int>, values: Array<int>) => int
}

function bad(_parts: Array<int>, _values: Array<int>): int {
  return 0
}

export function run(_args: Array<string>): int {
  const tags = Tags { tag: bad }
  return tags.tag`x${1}`
}
