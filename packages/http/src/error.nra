// http/error: the error of every HTTP operation.

import { AsyncError } from "std/async"

/// Why an operation failed. Io carries the error of the socket, Malformed names what the peer
/// or the caller got wrong, TooLarge names the limit that was passed ("headers", "body",
/// "chunk size line"), Closed means the peer ended the connection early, and TimedOut means a
/// wait ran past its limit.
export enum HttpError {
  Io(error: AsyncError)
  Malformed(message: string)
  TooLarge(what: string)
  Closed
  TimedOut
}

/// The error as one line of text.
export function describe(error: HttpError): string uses alloc {
  if (error is HttpError.Io(AsyncError.Failed(message))) {
    return `i/o error: ${message}`
  }
  if (error is HttpError.Io(AsyncError.Cancelled)) {
    return "cancelled"
  }
  if (error is HttpError.Malformed(message)) {
    return `malformed message: ${message}`
  }
  if (error is HttpError.TooLarge(what)) {
    return `${what} too large`
  }
  if (error is HttpError.Closed) {
    return "connection closed"
  }
  return "timed out"
}
