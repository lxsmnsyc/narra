import * as Path from "std/path"

export function run(args: Array<string>): int uses alloc, io {
  print(`extname(.bashrc) = ${Path.extname(".bashrc")}`)
  print(`extname(index.) = ${Path.extname("index.")}`)
  print(`extname(a.b/) = ${Path.extname("a.b/")}`)
  print(`extname(/a/b.nra) = ${Path.extname("/a/b.nra")}`)
  print(`extname(a/b.tar.gz) = ${Path.extname("a/b.tar.gz")}`)
  print(`extname(/) = ${Path.extname("/")}`)
  print(`extname() = ${Path.extname("")}`)
  print(`extname(..) = ${Path.extname("..")}`)
  print(`extname(a.) = ${Path.extname("a.")}`)
  print(`extname(a/.b.c) = ${Path.extname("a/.b.c")}`)
  print(`extname(a//b.x//) = ${Path.extname("a//b.x//")}`)
  print(`basename(.bashrc) = ${Path.basename(".bashrc")}`)
  print(`basename(a.b/) = ${Path.basename("a.b/")}`)
  print(`basename(/a/b.nra) = ${Path.basename("/a/b.nra")}`)
  print(`basename(/) = ${Path.basename("/")}`)
  print(`basename() = ${Path.basename("")}`)
  print(`basename(a//b//) = ${Path.basename("a//b//")}`)
  print(`dirname(.bashrc) = ${Path.dirname(".bashrc")}`)
  print(`dirname(a.b/) = ${Path.dirname("a.b/")}`)
  print(`dirname(/a/b.nra) = ${Path.dirname("/a/b.nra")}`)
  print(`dirname(a/b.tar.gz) = ${Path.dirname("a/b.tar.gz")}`)
  print(`dirname(/) = ${Path.dirname("/")}`)
  print(`dirname() = ${Path.dirname("")}`)
  print(`dirname(/a) = ${Path.dirname("/a")}`)
  print(`dirname(//a) = ${Path.dirname("//a")}`)
  print(`dirname(a//b/) = ${Path.dirname("a//b/")}`)
  print(`dirname(/a/b/) = ${Path.dirname("/a/b/")}`)
  print(`join(a, /b) = ${Path.join("a", "/b")}`)
  print(`join(a/, b) = ${Path.join("a/", "b")}`)
  print(`join(a, ../b) = ${Path.join("a", "../b")}`)
  print(`join(, ) = ${Path.join("", "")}`)
  print(`join(/, a) = ${Path.join("/", "a")}`)
  print(`join(a, ./b/) = ${Path.join("a", "./b/")}`)
  print(`join(.., a) = ${Path.join("..", "a")}`)
  print(`join(a, ../..) = ${Path.join("a", "../..")}`)
  print(`join(/a, ../..) = ${Path.join("/a", "../..")}`)
  print(`join(a/b, ..) = ${Path.join("a/b", "..")}`)
  print(`join(a, ../) = ${Path.join("a", "../")}`)
  print(`join(, x) = ${Path.join("", "x")}`)
  print(`join(x, ) = ${Path.join("x", "")}`)
  print(`join(a//b, c/./d) = ${Path.join("a//b", "c/./d")}`)
  print(`join(../.., x) = ${Path.join("../..", "x")}`)
  print(`join(a/.., ..) = ${Path.join("a/..", "..")}`)
  return 0
}
