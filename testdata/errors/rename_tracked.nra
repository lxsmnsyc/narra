// error: synonym would be a second name for the array in prices; use prices, or copy(prices) for an array of its own
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Str from "std/string"

struct Point {
  x: int
  y: int
}

struct Hero {
  name: string
  items: Array<int>
}

export function takeArray(prices: Array<int>, point: Point, hero: Hero): int uses alloc {
  const synonym = prices
  let second = prices
  Arrays.push(mutable second, 1)
  let other = [1, 2]
  other = prices
  const near = point
  const same = hero
  return Arrays.length(synonym) +
    Arrays.length(second) +
    Arrays.length(other) +
    near.x +
    Arrays.length(same.items)
}

export function takeMap(
  table: Map<string, int>,
  box: Box<int>,
  builder: StringBuilder,
): int uses alloc {
  const alias = table
  const boxed = box
  const text = builder
  return Maps.size(alias) + boxed.value + Str.length(Str.build(text))
}

export function takeGenerator(source: Generator<int>): int {
  const _again = source
  return 0
}

export function takeFixed(cells: FixedArray<int, 3>): int {
  const view = cells
  return view[0]
}

const SHARED: Array<int> = [1, 2]

export function readConstant(): int uses alloc {
  const alias = SHARED
  return Arrays.length(alias)
}

export function loopName(items: Array<Array<int>>): int uses alloc {
  let total = 0
  for (const row of Arrays.values(items)) {
    const same = row
    total += Arrays.length(same)
  }
  return total
}

export function run(_args: Array<string>): int uses alloc {
  const prices = [100, 200]
  const synonym = prices
  Arrays.push(mutable prices, 300)
  return Arrays.length(synonym)
}

export function takeCoroutine(worker: Coroutine<int, int>): int {
  const _same = worker
  return 0
}

export function takeTuple(pair: #[Array<int>, int]): int {
  const again = pair
  return again[1]
}

export function selfAssign(items: Array<int>): int uses alloc {
  let current = items
  current = current
  return Arrays.length(current)
}
