// The expression, pattern and type printers of `narrac fmt` (contract
// fmt-printer). They turn a node into a document of narrac/fmtdoc and leave
// the layout to the document printer: groups fit on one line or break, as
// Prettier does for TypeScript.
//
// What the printers rely on:
// - Literal text (strings, characters, templates and numbers) is copied from
//   the source by position, so escapes and spellings stay as written.
// - Parentheses: the ones the author wrote (Trivia.parenthesized) are kept,
//   and the printer adds a pair where precedence needs one.
// - `c ? a : b` is a BlockExpr whose block starts at the `?` (the parser's
//   `isConditional`), and an `if` value is a BlockExpr that holds one IfStmt
//   at its own position. Both print back in the source form.
// - A function type keeps no parameter names in the AST, so they are read
//   again from the source text of the type.
// - Every node handles its own comments (withComments) and parentheses, so the
//   caller never does. A block is printed by printer.printBlock.
import { substring } from "narrac/textops"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import { Doc as Document } from "narrac/fmtdoc"
import { Token, TokenKind, lex } from "narrac/lexer"
import {
  Pos,
  TypeExpr,
  Param,
  Block,
  Arg,
  FieldInit,
  FieldPattern,
  MatchArm,
  Stmt,
  Expr,
  Pattern,
} from "narrac/ast"
import { getPosKey, getIdKey, getExprId, getPatternId } from "narrac/trivia"
import {
  Printer,
  withComments,
  printDangling,
  printBracketed,
  hoistTrailingComments,
  hasLeading,
  hasTrailing,
  hasCommentInParens,
  trailingComma,
} from "narrac/fmtprinter"

// Operator precedence, lowest first, as in the parser. The numbers below are
// the level plus one; a ternary and an arrow function are 0.
const BINARY_LEVELS = [
  ["||"],
  ["&&"],
  ["==", "!="],
  ["<", "<=", ">", ">="],
  ["|"],
  ["^"],
  ["&"],
  ["<<", ">>"],
  ["+", "-"],
  ["*", "/", "%"],
]

// `x is Pattern` sits on the level of `==`.
const IS_PRECEDENCE = 3
const UNARY_PRECEDENCE = 11
const PRIMARY_PRECEDENCE = 12

// ---- Small helpers

function createText(value: string): Document {
  return Document.Text(value)
}

function createConcat(parts: Array<Document>): Document from parts {
  return Document.Concat(parts)
}

function createEmpty(): Document {
  return Document.Concat([])
}

function createGroup(contents: Document): Document from contents {
  return Document.Group(contents, -1)
}

function createIndent(contents: Document): Document from contents {
  return Document.Indent(contents)
}

function isParenthesized(printer: Printer, id: int): bool {
  return printer.trivia.parenthesized[id] is Some(_)
}

function dropsParentheses(printer: Printer, expression: Expr): bool uses alloc {
  // A conditional keeps its pair, which printConditional prints. For any other expression, the pair
  // is redundant until printWithMinimum finds that precedence needs it.
  return !isConditional(expression) && hasCommentInParens(printer, expression)
}

function hasAttached(printer: Printer, anchor: string): bool {
  return printer.trivia.attached[anchor] is Some(_)
}

function getOffset(source: string, position: Pos): int {
  const length = Str.length(source)
  let offset = 0
  let line = 1
  while (line < position.line && offset < length) {
    if (Str.byteAt(source, offset) == 10) {
      line++
    }
    offset++
  }
  for (let column = 1; column < position.column && offset < length; column++) {
    offset = Str.nextChar(source, offset)
  }
  return offset
}

function getSourceText(printer: Printer, start: Pos, end: Pos): string uses alloc {
  return substring(printer.source, getOffset(printer.source, start), getOffset(printer.source, end))
}

function getBinaryPrecedence(operator: string): int {
  for (const index of Ranges.between(0, Arrays.length(BINARY_LEVELS))) {
    for (const candidate of Arrays.values(BINARY_LEVELS[index])) {
      if (candidate == operator) {
        return index + 1
      }
    }
  }
  return 1
}

function isConditional(expression: Expr): bool {
  if (expression is Expr.BlockExpr(_, pos, block)) {
    // The parser starts the block of `c ? a : b` at the `?` and the expression at the condition.
    return block.pos.line != pos.line || block.pos.column != pos.column
  }
  return false
}

function isIfValue(expression: Expr): bool {
  if (expression is Expr.BlockExpr(_, pos, block)) {
    if (Arrays.length(block.statements) == 1 && !isConditional(expression)) {
      // An `if` in value position has one IfStmt that starts where the expression does.
      if (block.statements[0] is Stmt.IfStmt(ifPos, _, _, _)) {
        return ifPos.line == pos.line && ifPos.column == pos.column
      }
    }
  }
  return false
}

function getPrecedence(expression: Expr): int {
  return match (expression) {
    Expr.BinaryExpr(_, _, operator, _, _) => getBinaryPrecedence(operator)
    Expr.IsExpr(_, _, _, _) => IS_PRECEDENCE
    Expr.UnaryExpr(_, _, _, _) => UNARY_PRECEDENCE
    Expr.ArrowExpr(_, _, _, _, _, _) => 0
    Expr.BlockExpr(_, _, _) => isConditional(expression) ? 0 : PRIMARY_PRECEDENCE
    _ => PRIMARY_PRECEDENCE
  }
}

function printWithMinimum(
  printer: Printer,
  expression: Expr,
  minimum: int,
): Document from printer uses alloc {
  const document = printExpression(printer, expression)
  const dropped = dropsParentheses(printer, expression)
  // Wrap in parentheses when precedence is lower than the position needs and the author did not
  // write them.
  if (
    getPrecedence(expression) < minimum &&
      (!isParenthesized(printer, getExprId(expression)) || dropped)
  ) {
    if (expression is Expr.BlockExpr(conditionalId, _, conditionalBlock)) {
      if (isConditional(expression)) {
        return withComments(
          printer,
          getIdKey(conditionalId),
          printConditional(printer, conditionalBlock, true, false),
        )
      }
    }
    if (dropped) {
      return printBracketed("(", document, ")")
    }
    return createConcat([createText("("), document, createText(")")])
  }
  return document
}

function getReturnedValue(block: Block): Expr from block {
  if (block.statements[0] is Stmt.ReturnStmt(_, Some(value))) {
    return value
  }
  return Expr.BoolLit(-1, block.pos, false)
}

function printElement(printer: Printer, expression: Expr): Document from printer uses alloc {
  if (expression is Expr.BlockExpr(id, _, block)) {
    // Items of a call, array or tuple sit inside brackets, where a conditional may span lines
    // without parentheses.
    if (isConditional(expression) && !isParenthesized(printer, id)) {
      return withComments(printer, getIdKey(id), printConditional(printer, block, false, true))
    }
  }
  return printExpression(printer, expression)
}

export function endsWithUses(type: TypeExpr): bool {
  // A function type or a `Generator<T> uses E` carries the list.
  if (Arrays.length(type.effects) > 0) {
    return true
  }
  if (!type.isFunc) {
    return false
  }
  if (type.result is Some(resultType)) {
    return endsWithUses(resultType.value)
  }
  return false
}

function printList(
  printer: Printer,
  open: string,
  close: string,
  items: Array<Document>,
  blanks: Array<bool>,
  spaced: bool,
  hasComma: bool,
): Document from items uses alloc {
  return printListWith(printer, open, close, items, blanks, spaced, hasComma, false)
}

function printListWith(
  printer: Printer,
  open: string,
  close: string,
  items: Array<Document>,
  blanks: Array<bool>,
  spaced: bool,
  hasComma: bool,
  forceBreak: bool,
): Document from items uses alloc {
  if (Arrays.length(items) == 0) {
    return createText(`${open}${close}`)
  }
  // A flat list gets a space inside the braces when spaced is set.
  let edge = Document.SoftLine
  if (spaced) {
    edge = Document.Line
  }
  let inner: Array<Document> = [edge]
  let forced = forceBreak
  for (const index of Ranges.between(0, Arrays.length(items))) {
    if (index > 0) {
      Arrays.push(mutable inner, createText(","))
      Arrays.push(mutable inner, Document.Line)
      // A blank line before an item keeps the list broken.
      if (index < Arrays.length(blanks) && blanks[index]) {
        Arrays.push(mutable inner, Document.SoftLine)
        forced = true
      }
    }
    Arrays.push(mutable inner, items[index])
  }
  let parts: Array<Document> = [createText(open), createIndent(createConcat(inner))]
  if (hasComma) {
    Arrays.push(mutable parts, Document.IfBreak(trailingComma(printer), createEmpty(), -1))
  }
  Arrays.push(mutable parts, edge)
  Arrays.push(mutable parts, createText(close))
  if (forced) {
    Arrays.push(mutable parts, Document.BreakParent)
  }
  return createGroup(createConcat(parts))
}

function printTypeArguments(printer: Printer, typeArguments: Array<TypeExpr>): Document uses alloc {
  if (Arrays.length(typeArguments) == 0) {
    return createEmpty()
  }
  // Never breaks: a line break before the closing `>` would end the statement, and Narra reads a
  // break only inside parentheses and brackets.
  let parts: Array<Document> = [createText("<")]
  for (const index of Ranges.between(0, Arrays.length(typeArguments))) {
    if (index > 0) {
      Arrays.push(mutable parts, createText(", "))
    }
    Arrays.push(mutable parts, printType(printer, typeArguments[index]))
  }
  Arrays.push(mutable parts, createText(">"))
  return createConcat(parts)
}

function printEmptyBraces(
  printer: Printer,
  anchor: string,
  open: string,
  close: string,
): Document uses alloc {
  if (hasAttached(printer, anchor)) {
    return createConcat([
      createText(open),
      createIndent(createConcat([Document.HardLine, printDangling(printer, anchor)])),
      Document.HardLine,
      createText(close),
    ])
  }
  return createText(`${open}${close}`)
}

// ---- Expressions

export function printExpression(
  printer: Printer,
  expression: Expr,
): Document from printer uses alloc {
  const id = getExprId(expression)
  if (isConditional(expression) && hasCommentInParens(printer, expression)) {
    return printKeptParentheses(printer, expression)
  }
  let document = printExpressionBody(printer, expression, isParenthesized(printer, id))
  if (
    isParenthesized(printer, id) &&
      !isConditional(expression) &&
      !dropsParentheses(printer, expression)
  ) {
    document = createConcat([createText("("), document, createText(")")])
  }
  return withComments(printer, getIdKey(id), document)
}

function printKeptParentheses(
  printer: Printer,
  expression: Expr,
): Document from printer uses alloc {
  // A conditional keeps its parentheses, and so does an operand of a conditional: dropping them
  // would leave a comment after `?` or `:`, which attaches elsewhere when formatted again.
  let body = printExpressionBody(printer, expression, true)
  if (expression is Expr.BlockExpr(_, _, block)) {
    if (isConditional(expression)) {
      body = printConditional(printer, block, true, true)
    }
  }
  return printBracketed("(", withComments(printer, getIdKey(getExprId(expression)), body), ")")
}

function printOperand(printer: Printer, expression: Expr): Document from printer uses alloc {
  if (isParenthesized(printer, getExprId(expression)) && hasCommentInParens(printer, expression)) {
    return printKeptParentheses(printer, expression)
  }
  return printExpression(printer, expression)
}

function printExpressionBody(
  printer: Printer,
  expression: Expr,
  written: bool,
): Document from printer uses alloc {
  return match (expression) {
    Expr.IntLit(id, pos, value) | Expr.FloatLit(id, pos, value) => createText(
      getEndedText(printer, id, pos, value),
    )
    Expr.StringLit(_, pos, value, end) => createText(
      getLiteralText(printer, pos, end, `"${value}"`),
    )
    Expr.CharLit(id, pos, value) => createText(getEndedText(printer, id, pos, `'${value}'`))
    Expr.BoolLit(_, _, value) => createText(value ? "true" : "false")
    Expr.TemplateLit(id, pos, _) => createText(getEndedText(printer, id, pos, "``"))
    Expr.Ident(_, _, name) => createText(name)
    Expr.FieldExpr(_, _, target, name) => createConcat([
      printWithMinimum(printer, target, PRIMARY_PRECEDENCE),
      createText(`.${name}`),
    ])
    Expr.IsExpr(_, _, subject, pattern) => printIs(printer, subject, pattern)
    Expr.IndexExpr(_, _, target, index) => createConcat([
      printWithMinimum(printer, target, PRIMARY_PRECEDENCE),
      printIndex(printer, index),
    ])
    Expr.MapLit(id, _, typeArguments, keys, values) => printMapLiteral(
      printer,
      id,
      typeArguments,
      keys,
      values,
    )
    Expr.CallExpr(_, _, callee, typeArguments, arguments) => createConcat([
      printWithMinimum(printer, callee, PRIMARY_PRECEDENCE),
      printTypeArguments(printer, typeArguments),
      printArguments(printer, arguments),
    ])
    Expr.UnaryExpr(_, _, operator, operand) => printUnary(printer, operator, operand)
    Expr.BinaryExpr(_, _, _, _, _) => printBinary(printer, expression)
    Expr.StructLit(id, pos, typeName, typeArguments, fields, spread) => printStructLiteral(
      printer,
      id,
      pos,
      typeName,
      typeArguments,
      fields,
      spread,
    )
    Expr.ArrayLit(id, _, elements, isTuple) => printArrayLiteral(printer, id, elements, isTuple)
    Expr.MatchExpr(_, _, subject, arms) => printMatch(printer, subject, arms)
    Expr.BlockExpr(_, _, block) => printBlockExpression(printer, expression, block, written)
    Expr.ArrowExpr(id, _, parameters, result, body, block) => printArrow(
      printer,
      id,
      parameters,
      result,
      body,
      block,
    )
  }
}

function getLiteralText(
  printer: Printer,
  start: Pos,
  end: Pos,
  fallback: string,
): string uses alloc {
  if (end.line < start.line || (end.line == start.line && end.column <= start.column)) {
    return fallback
  }
  return getSourceText(printer, start, end)
}

function getEndedText(printer: Printer, id: int, start: Pos, fallback: string): string uses alloc {
  const end = printer.trivia.ends[getIdKey(id)]
  if (end is Some(endPos)) {
    const text = getLiteralText(printer, start, endPos, fallback)
    if (isParenthesized(printer, id)) {
      return cutClosingParens(text, fallback)
    }
    return text
  }
  return fallback
}

function cutClosingParens(text: string, fallback: string): string uses alloc {
  // Trivia.ends of a parenthesized expression includes its parentheses; the text ends after the
  // last token that is not `)`.
  const lexed = lex(text)
  if (lexed is Err(_)) {
    return fallback
  }
  let last: Option<Token> = None
  for (const token of Arrays.values(lexed.value)) {
    const isSkipped =
      token.kind == TokenKind.TokNewline || token.kind == TokenKind.TokEof || token.text == ")"
    if (!isSkipped) {
      last = Some(token)
    }
  }
  if (last is Some(token)) {
    return substring(text, 0, getOffset(text, Pos { line: token.endLine, column: token.endColumn }))
  }
  return fallback
}

function printIndex(printer: Printer, index: Expr): Document from printer uses alloc {
  const key = getIdKey(getExprId(index))
  // A comment on the index keeps it inside the brackets, which then break; without one the brackets
  // are plain text.
  if (hasLeading(printer, key) || hasTrailing(printer, key)) {
    return printBracketed("[", printElement(printer, index), "]")
  }
  return createConcat([createText("["), printElement(printer, index), createText("]")])
}

function printIs(
  printer: Printer,
  subject: Expr,
  pattern: Pattern,
): Document from printer uses alloc {
  const hoisted = hoistTrailingComments(printer, getIdKey(getExprId(subject)))
  const left = printWithMinimum(hoisted.printer, subject, IS_PRECEDENCE)
  // A line comment after the subject cannot stay there, as a line break before `is` would end the
  // statement, and a block comment there would move behind `is` when formatted again. They go after
  // `is` and the pattern moves to the next line, which Narra reads (`is` ends a line like an
  // operator). A comment on the lines before the pattern gets the same layout.
  if (hoisted.count == 0 && !hasLeading(printer, getIdKey(getPatternId(pattern)))) {
    return createConcat([left, createText(" is "), printPattern(printer, pattern)])
  }
  let parts: Array<Document> = [left, createText(" is"), hoisted.inline, hoisted.suffix]
  if (hoisted.hasLine) {
    Arrays.push(mutable parts, Document.BreakParent)
  }
  Arrays.push(
    mutable parts,
    createIndent(createConcat([Document.Line, printPattern(hoisted.printer, pattern)])),
  )
  return createGroup(createConcat(parts))
}

function printUnary(
  printer: Printer,
  operator: string,
  operand: Expr,
): Document from printer uses alloc {
  // Two minus signs get a space, so `- -x` stays two tokens.
  let separator = ""
  if (operand is Expr.UnaryExpr(operandId, _, operandOperator, _)) {
    if (
      operator == "-" &&
        operandOperator == "-" &&
        (!isParenthesized(printer, operandId) || dropsParentheses(printer, operand))
    ) {
      separator = " "
    }
  }
  // a comment that leads the operand must not touch the sign
  if (
    hasLeading(printer, getIdKey(getExprId(operand))) && getPrecedence(operand) >= UNARY_PRECEDENCE
  ) {
    separator = " "
  }
  return createConcat([
    createText(operator),
    createText(separator),
    printWithMinimum(printer, operand, UNARY_PRECEDENCE),
  ])
}

function printBinary(printer: Printer, expression: Expr): Document from printer uses alloc {
  return printBinaryChain(printer, expression, true)
}

function printBinaryChain(
  printer: Printer,
  expression: Expr,
  indentRest: bool,
): Document from printer uses alloc {
  // A broken chain breaks after each operator and indents the rest. The chain is walked along the
  // left operands in a loop, so a long chain does not recurse.
  let operators: Array<string> = []
  let rights: Array<Expr> = []
  let first = expression
  let precedence = 1
  if (expression is Expr.BinaryExpr(_, _, topOperator, _, _)) {
    precedence = getBinaryPrecedence(topOperator)
  }
  let current = expression
  let walking = true
  while (walking) {
    walking = false
    if (current is Expr.BinaryExpr(_, _, operator, left, right)) {
      Arrays.push(mutable operators, operator)
      Arrays.push(mutable rights, right)
      first = left
      // Keep walking when the left operand continues the same chain.
      if (left is Expr.BinaryExpr(leftId, _, leftOperator, _, _)) {
        if (
          getBinaryPrecedence(leftOperator) == precedence &&
            !isParenthesized(printer, leftId) &&
            !hasAttached(printer, getIdKey(leftId))
        ) {
          current = left
          walking = true
        }
      }
    }
  }
  // indentRest false leaves the operands after the first at the indentation of the caller, for a
  // chain that is already indented, such as an arrow function body.
  let rest: Array<Document> = []
  for (let index = Arrays.length(operators) - 1; index >= 0; index--) {
    Arrays.push(mutable rest, createText(" "))
    Arrays.push(mutable rest, createText(operators[index]))
    Arrays.push(mutable rest, Document.Line)
    Arrays.push(mutable rest, printWithMinimum(printer, rights[index], precedence + 1))
  }
  if (!indentRest) {
    return createGroup(
      createConcat([printWithMinimum(printer, first, precedence), createConcat(rest)]),
    )
  }
  return createGroup(
    createConcat([printWithMinimum(printer, first, precedence), createIndent(createConcat(rest))]),
  )
}

function isHuggable(expression: Expr): bool {
  // The last argument that stays on the line of the call and opens its own lines: an arrow function
  // or a non-empty literal.
  return match (expression) {
    Expr.ArrowExpr(_, _, _, _, body, _) => isCompactArrowBody(body)
    Expr.StructLit(_, _, _, _, fields, spread) => Arrays.length(fields) > 0 || spread is Some(_)
    Expr.ArrayLit(_, _, elements, _) => Arrays.length(elements) > 0
    Expr.MapLit(_, _, _, keys, _) => Arrays.length(keys) > 0
    _ => false
  }
}

function isCompactArrowBody(body: Option<Expr>): bool {
  if (body is Some(bodyExpression)) {
    return isCompactBody(bodyExpression)
  }
  return true
}

function getFlatWidth(document: Document, limit: int): int {
  // A hard line is wider than limit, so a document that holds one never fits.
  return match (document) {
    Document.Text(value) => Str.charCount(value)
    Document.Concat(parts) => getPartsWidth(parts, limit)
    Document.Indent(contents) | Document.Group(contents, _) => getFlatWidth(contents, limit)
    Document.Line => 1
    Document.SoftLine => 0
    Document.HardLine => limit + 1
    Document.IfBreak(_, flat, _) => getFlatWidth(flat, limit)
    Document.LineSuffix(_) | Document.BreakParent => 0
  }
}

function getPartsWidth(parts: Array<Document>, limit: int): int {
  let width = 0
  for (const part of Arrays.values(parts)) {
    if (width > limit) {
      return width
    }
    width += getFlatWidth(part, limit - width)
  }
  return width
}

function printArguments(printer: Printer, arguments: Array<Arg>): Document from printer uses alloc {
  const count = Arrays.length(arguments)
  if (count == 0) {
    return createText("()")
  }
  let items: Array<Document> = []
  for (const argument of Arrays.values(arguments)) {
    let value = printElement(printer, argument.value)
    if (argument.isMutable) {
      value = createConcat([createText("mutable "), value])
    }
    if (argument.name is Some(argumentName)) {
      value = createConcat([createText(`${argumentName}: `), value])
    }
    Arrays.push(mutable items, value)
  }
  // When the last argument is huggable and the one before it is not, the arguments stay on the line
  // of the call and only the last one breaks, as in `f(a, (x) => { ... })`.
  const last = arguments[count - 1].value
  let hug = isHuggable(last)
  if (hug && count > 1 && isHuggable(arguments[count - 2].value)) {
    hug = false
  }
  // The arguments before the last one never break, so hug only when they are
  // short; else every argument goes on its own line.
  if (hug && count > 1) {
    let headWidth = 0
    const limit = printer.settings.options.printWidth / 3
    for (const index of Ranges.between(0, count - 1)) {
      headWidth = headWidth + getFlatWidth(items[index], limit) + 2
    }
    if (headWidth > limit) {
      hug = false
    }
  }
  if (hug) {
    let parts: Array<Document> = [createText("(")]
    for (const index of Ranges.between(0, count)) {
      if (index > 0) {
        Arrays.push(mutable parts, createText(", "))
      }
      Arrays.push(mutable parts, items[index])
    }
    Arrays.push(mutable parts, createText(")"))
    return createConcat(parts)
  }
  return printList(printer, "(", ")", items, [], false, true)
}

function printBlockExpression(
  printer: Printer,
  expression: Expr,
  block: Block,
  written: bool,
): Document from printer uses alloc {
  if (isConditional(expression)) {
    return printConditional(printer, block, written, false)
  }
  if (isIfValue(expression)) {
    return printIfValue(printer, block)
  }
  return printer.printBlock(printer, block)
}

function printConditional(
  printer: Printer,
  block: Block,
  written: bool,
  bare: bool,
): Document from printer uses alloc {
  let parts: Array<Document> = []
  let current = block
  let walking = true
  while (walking) {
    walking = false
    if (
      current.statements[0] is Stmt.IfStmt(_, condition, thenBlock, Some(Stmt.BlockStmt(elseBlock)))
    ) {
      const elseValue = getReturnedValue(elseBlock)
      Arrays.push(mutable parts, printConditionOperand(printer, condition))
      Arrays.push(mutable parts, Document.Line)
      Arrays.push(mutable parts, createText("? "))
      Arrays.push(mutable parts, printOperand(printer, getReturnedValue(thenBlock)))
      Arrays.push(mutable parts, Document.Line)
      Arrays.push(mutable parts, createText(": "))
      let continues = false
      if (elseValue is Expr.BlockExpr(elseId, _, elseInner)) {
        if (
          isConditional(elseValue) &&
            !isParenthesized(printer, elseId) &&
            !hasAttached(printer, getIdKey(elseId))
        ) {
          // Put the next condition on the same line as the colon.
          current = elseInner
          walking = true
          continues = true
        }
      }
      if (!continues) {
        Arrays.push(mutable parts, printOperand(printer, elseValue))
      }
    }
  }
  // A chain of conditionals in the else branch stays at one level: `a ? b : c ? d : e`. Narra does
  // not read a conditional that spans lines unless it is in parentheses, so a broken one gets them
  // (written says that they are already there).
  // The first condition leads, then the rest is indented.
  const head = parts[0]
  let tail: Array<Document> = []
  for (const index of Ranges.between(1, Arrays.length(parts))) {
    Arrays.push(mutable tail, parts[index])
  }
  const body = createConcat([head, createIndent(createConcat(tail))])
  let open = Document.IfBreak(createText("("), createEmpty(), -1)
  let close = Document.IfBreak(createText(")"), createEmpty(), -1)
  if (written) {
    open = createText("(")
    close = createText(")")
  }
  if (bare) {
    return createGroup(body)
  }
  return createGroup(
    createConcat([
      open,
      createIndent(createConcat([Document.SoftLine, body])),
      Document.SoftLine,
      close,
    ]),
  )
}

function printConditionOperand(
  printer: Printer,
  condition: Expr,
): Document from printer uses alloc {
  if (isParenthesized(printer, getExprId(condition)) && hasCommentInParens(printer, condition)) {
    return printKeptParentheses(printer, condition)
  }
  return printWithMinimum(printer, condition, 1)
}

function printIfValue(printer: Printer, block: Block): Document from printer uses alloc {
  let parts: Array<Document> = []
  let current = block
  let walking = true
  while (walking) {
    walking = false
    if (
      current.statements[0] is Stmt.IfStmt(_, condition, thenBlock, Some(Stmt.BlockStmt(elseBlock)))
    ) {
      Arrays.push(mutable parts, createText("if "))
      Arrays.push(mutable parts, printBracketed("(", printExpression(printer, condition), ")"))
      Arrays.push(mutable parts, createText(" "))
      Arrays.push(mutable parts, printBranch(printer, getReturnedValue(thenBlock)))
      Arrays.push(mutable parts, createText(" else "))
      const elseValue = getReturnedValue(elseBlock)
      let continues = false
      if (elseValue is Expr.BlockExpr(_, _, elseInner)) {
        if (isIfValue(elseValue)) {
          current = elseInner
          walking = true
          continues = true
        }
      }
      if (!continues) {
        Arrays.push(mutable parts, printBranch(printer, elseValue))
      }
    }
  }
  return createConcat(parts)
}

function printBranch(printer: Printer, branch: Expr): Document from printer uses alloc {
  if (branch is Expr.BlockExpr(_, _, inner)) {
    return printer.printBlock(printer, inner)
  }
  return printExpression(printer, branch)
}

function printArrayLiteral(
  printer: Printer,
  id: int,
  elements: Array<Expr>,
  isTuple: bool,
): Document from printer uses alloc {
  let open = "["
  if (isTuple) {
    open = "#["
  }
  if (Arrays.length(elements) == 0) {
    return printEmptyBraces(printer, getIdKey(id), open, "]")
  }
  let items: Array<Document> = []
  for (const element of Arrays.values(elements)) {
    Arrays.push(mutable items, printElement(printer, element))
  }
  return printList(printer, open, "]", items, [], false, true)
}

function printStructLiteral(
  printer: Printer,
  id: int,
  pos: Pos,
  typeName: string,
  typeArguments: Array<TypeExpr>,
  fields: Array<FieldInit>,
  spread: Option<Expr>,
): Document from printer uses alloc {
  let head: Array<Document> = []
  if (typeName != "") {
    Arrays.push(mutable head, createText(typeName))
    Arrays.push(mutable head, printTypeArguments(printer, typeArguments))
    Arrays.push(mutable head, createText(" "))
  }
  if (Arrays.length(fields) == 0 && spread is None) {
    Arrays.push(mutable head, printEmptyBraces(printer, getIdKey(id), "{", "}"))
    return createConcat(head)
  }
  let items: Array<Document> = []
  let blanks: Array<bool> = []
  if (spread is Some(spreadValue)) {
    Arrays.push(
      mutable items,
      createConcat([createText("..."), printExpression(printer, spreadValue)]),
    )
    Arrays.push(mutable blanks, false)
  }
  for (const field of Arrays.values(fields)) {
    const key = getPosKey("f", field.pos)
    // A comment on the lines before the value moves it below the name.
    let fieldDocument = createConcat([
      createText(`${field.name}: `),
      printExpression(printer, field.value),
    ])
    if (hasLeading(printer, getIdKey(getExprId(field.value)))) {
      fieldDocument = createGroup(
        createConcat([
          createText(`${field.name}:`),
          createIndent(createConcat([Document.Line, printExpression(printer, field.value)])),
        ]),
      )
    }
    Arrays.push(mutable items, withComments(printer, key, fieldDocument))
    Arrays.push(mutable blanks, printer.trivia.blankBefore[key] is Some(_))
  }
  // As in Prettier, an object that starts on a new line after the brace stays broken.
  let keepBroken = false
  if (spread is None && fields[0].pos.line > pos.line) {
    keepBroken = true
  }
  Arrays.push(mutable head, printListWith(printer, "{", "}", items, blanks, true, true, keepBroken))
  return createConcat(head)
}

function getLiteralPos(expression: Expr): Pos {
  return match (expression) {
    Expr.IntLit(_, pos, _)
      | Expr.FloatLit(_, pos, _)
      | Expr.StringLit(_, pos, _, _)
      | Expr.CharLit(_, pos, _)
      | Expr.BoolLit(_, pos, _)
      | Expr.UnaryExpr(_, pos, _, _) => copy(pos)
    _ => Pos { line: 0, column: 0 }
  }
}

function isBracketed(printer: Printer, expression: Expr): bool {
  const pos = getLiteralPos(expression)
  if (pos.line == 0) {
    return false
  }
  let offset = getOffset(printer.source, pos) - 1
  while (
    offset >= 0 &&
      (Str.byteAt(printer.source, offset) == 32 ||
        Str.byteAt(printer.source, offset) == 9 ||
        Str.byteAt(printer.source, offset) == 10)
  ) {
    offset--
  }
  return offset >= 0 && Str.byteAt(printer.source, offset) == 91
}

function isLiteralKey(expression: Expr): bool {
  return match (expression) {
    Expr.IntLit(_, _, _)
      | Expr.FloatLit(_, _, _)
      | Expr.StringLit(_, _, _, _)
      | Expr.CharLit(_, _, _)
      | Expr.BoolLit(_, _, _) => true
    Expr.UnaryExpr(_, _, operator, operand) => operator == "-" && isLiteralKey(operand)
    _ => false
  }
}

function printMapLiteral(
  printer: Printer,
  id: int,
  typeArguments: Array<TypeExpr>,
  keys: Array<Expr>,
  values: Array<Expr>,
): Document from printer uses alloc {
  let head: Array<Document> = [
    createText("Map"),
    printTypeArguments(printer, typeArguments),
    createText(" "),
  ]
  if (Arrays.length(keys) == 0) {
    Arrays.push(mutable head, printEmptyBraces(printer, getIdKey(id), "{", "}"))
    return createConcat(head)
  }
  let items: Array<Document> = []
  for (const index of Ranges.between(0, Arrays.length(keys))) {
    // A literal key may be written in brackets too; keep them as written.
    let key = printExpression(printer, keys[index])
    if (!isLiteralKey(keys[index]) || isBracketed(printer, keys[index])) {
      key = createConcat([createText("["), printElement(printer, keys[index]), createText("]")])
    }
    Arrays.push(
      mutable items,
      createConcat([key, createText(": "), printExpression(printer, values[index])]),
    )
  }
  Arrays.push(mutable head, printList(printer, "{", "}", items, [], true, true))
  return createConcat(head)
}

function isCompactBody(expression: Expr): bool {
  return match (expression) {
    Expr.StructLit(_, _, _, _, _, _)
      | Expr.MapLit(_, _, _, _, _)
      | Expr.ArrayLit(_, _, _, _)
      | Expr.MatchExpr(_, _, _, _)
      | Expr.ArrowExpr(_, _, _, _, _, _)
      | Expr.TemplateLit(_, _, _)
      | Expr.CallExpr(_, _, _, _, _)
      | Expr.BlockExpr(_, _, _) => true
    _ => false
  }
}

function printBody(printer: Printer, body: Expr): Document from printer uses alloc {
  // A comment on the lines before the body moves it below the `=>`.
  const isLed = hasLeading(printer, getIdKey(getExprId(body))) && !isConditional(body)
  if (isCompactBody(body) && !isLed) {
    return createConcat([createText(" "), printExpression(printer, body)])
  }
  // The chain of a binary body is already indented by the line before it.
  if (body is Expr.BinaryExpr(bodyId, _, _, _, _)) {
    if (!isParenthesized(printer, bodyId) && !hasAttached(printer, getIdKey(bodyId))) {
      return createGroup(
        createIndent(createConcat([Document.Line, printBinaryChain(printer, body, false)])),
      )
    }
  }
  // Comments after the body end the line it is on, as they do when the body is
  // not in parentheses: they must not make the body move to the next line.
  const hoisted = hoistTrailingComments(printer, getIdKey(getExprId(body)))
  if (hoisted.count == 0) {
    return createGroup(createIndent(createConcat([Document.Line, printExpression(printer, body)])))
  }
  let parts: Array<Document> = [
    createGroup(
      createIndent(createConcat([Document.Line, printExpression(hoisted.printer, body)])),
    ),
    hoisted.inline,
    hoisted.suffix,
  ]
  if (hoisted.hasLine) {
    Arrays.push(mutable parts, Document.BreakParent)
  }
  return createConcat(parts)
}

function printMatch(
  printer: Printer,
  subject: Expr,
  arms: Array<MatchArm>,
): Document from printer uses alloc {
  const head = createConcat([
    createText("match "),
    printBracketed("(", printExpression(printer, subject), ")"),
    createText(" {"),
  ])
  if (Arrays.length(arms) == 0) {
    return createConcat([head, createText("}")])
  }
  let inner: Array<Document> = [Document.Line]
  let forced = false
  for (const index of Ranges.between(0, Arrays.length(arms))) {
    const arm = arms[index]
    const key = getPosKey("a", arm.pos)
    if (index > 0) {
      // Flat arms are separated by commas; broken ones by lines alone.
      Arrays.push(mutable inner, Document.IfBreak(createEmpty(), createText(","), -1))
      Arrays.push(mutable inner, Document.Line)
      if (printer.trivia.blankBefore[key] is Some(_)) {
        Arrays.push(mutable inner, Document.SoftLine)
        forced = true
      }
    }
    let parts: Array<Document> = [printPattern(printer, arm.pattern)]
    if (arm.guard is Some(guard)) {
      Arrays.push(mutable parts, createText(" if "))
      Arrays.push(mutable parts, printBracketed("(", printExpression(printer, guard), ")"))
    }
    Arrays.push(mutable parts, createText(" =>"))
    if (arm.block is Some(armBlock)) {
      Arrays.push(mutable parts, createText(" "))
      Arrays.push(mutable parts, printer.printBlock(printer, armBlock))
    } else if (arm.body is Some(armBody)) {
      Arrays.push(mutable parts, printBody(printer, armBody))
    }
    Arrays.push(mutable inner, withComments(printer, key, createConcat(parts)))
  }
  let parts: Array<Document> = [
    head,
    createIndent(createConcat(inner)),
    Document.Line,
    createText("}"),
  ]
  if (forced) {
    Arrays.push(mutable parts, Document.BreakParent)
  }
  return createGroup(createConcat(parts))
}

function printArrow(
  printer: Printer,
  id: int,
  parameters: Array<Param>,
  result: Option<TypeExpr>,
  body: Option<Expr>,
  block: Option<Block>,
): Document from printer uses alloc {
  let items: Array<Document> = []
  for (const parameter of Arrays.values(parameters)) {
    let parts: Array<Document> = [createText(parameter.name)]
    if (parameter.type is Some(parameterType)) {
      Arrays.push(mutable parts, createText(": "))
      Arrays.push(mutable parts, printType(printer, parameterType))
    }
    Arrays.push(mutable items, withComments(printer, getIdKey(parameter.id), createConcat(parts)))
  }
  let hasComma = true
  if (Arrays.length(parameters) > 0) {
    if (parameters[Arrays.length(parameters) - 1].type is Some(lastType)) {
      hasComma = !endsWithUses(lastType)
    }
  }
  let parts: Array<Document> = [printList(printer, "(", ")", items, [], false, hasComma)]
  if (Arrays.length(parameters) == 0 && hasAttached(printer, getIdKey(id))) {
    // A comment in an empty parameter list is dangling on the arrow.
    parts = [
      createConcat([
        createText("("),
        createIndent(createConcat([Document.HardLine, printDangling(printer, getIdKey(id))])),
        Document.HardLine,
        createText(")"),
      ]),
    ]
  }
  if (result is Some(resultType)) {
    Arrays.push(mutable parts, createText(": "))
    Arrays.push(mutable parts, printType(printer, resultType))
  }
  Arrays.push(mutable parts, createText(" =>"))
  if (block is Some(arrowBlock)) {
    Arrays.push(mutable parts, createText(" "))
    Arrays.push(mutable parts, printer.printBlock(printer, arrowBlock))
  } else if (body is Some(arrowBody)) {
    Arrays.push(mutable parts, printBody(printer, arrowBody))
  }
  return createConcat(parts)
}

// ---- Patterns

export function printPattern(printer: Printer, pattern: Pattern): Document from printer uses alloc {
  const id = getPatternId(pattern)
  return withComments(printer, getIdKey(id), printPatternBody(printer, pattern))
}

function printPatternList(
  printer: Printer,
  open: string,
  close: string,
  patterns: Array<Pattern>,
): Document from printer uses alloc {
  let items: Array<Document> = []
  for (const pattern of Arrays.values(patterns)) {
    Arrays.push(mutable items, printPattern(printer, pattern))
  }
  return printList(printer, open, close, items, [], false, true)
}

function printPatternBody(printer: Printer, pattern: Pattern): Document from printer uses alloc {
  return match (pattern) {
    Pattern.PatWildcard(_, _) => createText("_")
    Pattern.PatName(_, _, name) => createText(name)
    Pattern.PatCtor(_, _, enumName, name, arguments, bare) => printConstructorPattern(
      printer,
      enumName,
      name,
      arguments,
      bare,
    )
    Pattern.PatStruct(id, _, fields) => printStructPattern(printer, id, fields)
    Pattern.PatTuple(_, _, arguments) => printPatternList(printer, "#[", "]", arguments)
    Pattern.PatLit(_, _, literal) => printExpression(printer, literal)
    Pattern.PatOr(_, _, alternatives) => printAlternatives(printer, alternatives)
    Pattern.PatCompare(_, _, operator, bound) => createConcat([
      createText(`${operator} `),
      printExpression(printer, bound),
    ])
  }
}

function printAlternatives(
  printer: Printer,
  alternatives: Array<Pattern>,
): Document from printer uses alloc {
  // One line when it fits, otherwise each further alternative on its own line, starting with a bar.
  let rest: Array<Document> = []
  for (const index of Ranges.between(1, Arrays.length(alternatives))) {
    Arrays.push(mutable rest, Document.Line)
    Arrays.push(mutable rest, createText("| "))
    Arrays.push(mutable rest, printPattern(printer, alternatives[index]))
  }
  return createGroup(
    createConcat([printPattern(printer, alternatives[0]), createIndent(createConcat(rest))]),
  )
}

function printConstructorPattern(
  printer: Printer,
  enumName: string,
  name: string,
  arguments: Array<Pattern>,
  bare: bool,
): Document from printer uses alloc {
  let fullName = name
  if (enumName != "") {
    fullName = `${enumName}.${name}`
  }
  if (bare) {
    return createText(fullName)
  }
  return createConcat([createText(fullName), printPatternList(printer, "(", ")", arguments)])
}

function printStructPattern(
  printer: Printer,
  id: int,
  fields: Array<FieldPattern>,
): Document from printer uses alloc {
  if (Arrays.length(fields) == 0) {
    return printEmptyBraces(printer, getIdKey(id), "{", "}")
  }
  let items: Array<Document> = []
  let blanks: Array<bool> = []
  for (const field of Arrays.values(fields)) {
    const key = getPosKey("f", field.pos)
    // A field is shorthand when its pattern is a name the parser made at the field's own position.
    let isShorthand = false
    if (field.pattern is Pattern.PatName(_, namePos, _)) {
      isShorthand = namePos.line == field.pos.line && namePos.column == field.pos.column
    }
    let document = createText(field.name)
    if (!isShorthand) {
      document = createConcat([createText(`${field.name}: `), printPattern(printer, field.pattern)])
    }
    Arrays.push(mutable items, withComments(printer, key, document))
    Arrays.push(mutable blanks, printer.trivia.blankBefore[key] is Some(_))
  }
  return printList(printer, "{", "}", items, blanks, true, true)
}

// ---- Types

export function printType(printer: Printer, type: TypeExpr): Document uses alloc {
  const printed = withComments(printer, getPosKey("t", type.pos), printTypeBody(printer, type))
  if (type.resultFrom != "") {
    return createConcat([printed, createText(` from ${type.resultFrom}`)])
  }
  return printed
}

function printTypeBody(printer: Printer, type: TypeExpr): Document uses alloc {
  if (type.isTuple) {
    let items: Array<Document> = []
    for (const element of Arrays.values(type.arguments)) {
      Arrays.push(mutable items, printType(printer, element))
    }
    let hasComma = true
    if (Arrays.length(type.arguments) > 0) {
      hasComma = !endsWithUses(type.arguments[Arrays.length(type.arguments) - 1])
    }
    return printList(printer, "#[", "]", items, [], false, hasComma)
  }
  if (type.isFunc) {
    return printFunctionType(printer, type)
  }
  if (type.typeofName != "") {
    return createText(`typeof ${type.typeofName}`)
  }
  let parts: Array<Document> = [createText(type.name), printTypeArguments(printer, type.arguments)]
  if (Arrays.length(type.effects) > 0) {
    // `Generator<T> uses E`.
    Arrays.push(mutable parts, createText(` uses ${Str.join(type.effects, ", ")}`))
  }
  return createConcat(parts)
}

function printFunctionType(printer: Printer, type: TypeExpr): Document uses alloc {
  const names = getParameterNames(printer, type)
  let items: Array<Document> = []
  for (const index of Ranges.between(0, Arrays.length(type.arguments))) {
    const argument = printType(printer, type.arguments[index])
    if (index < Arrays.length(names) && names[index] != "") {
      Arrays.push(mutable items, createConcat([createText(`${names[index]}: `), argument]))
    } else {
      Arrays.push(mutable items, argument)
    }
  }
  let hasComma = true
  if (Arrays.length(type.arguments) > 0) {
    hasComma = !endsWithUses(type.arguments[Arrays.length(type.arguments) - 1])
  }
  let parts: Array<Document> = [
    printList(printer, "(", ")", items, [], false, hasComma),
    createText(" => "),
  ]
  if (type.result is Some(resultType)) {
    Arrays.push(mutable parts, printType(printer, resultType.value))
  }
  if (Arrays.length(type.effects) > 0) {
    Arrays.push(mutable parts, createText(` uses ${Str.join(type.effects, ", ")}`))
  }
  return createConcat(parts)
}

function getParameterNames(printer: Printer, type: TypeExpr): Array<string> uses alloc {
  let names: Array<string> = []
  // The syntax tree does not keep the parameter names, so read them from the source text. An
  // unnamed parameter gives an empty string.
  const end = printer.trivia.ends[getPosKey("t", type.pos)]
  let source = ""
  if (end is Some(endPos)) {
    source = getSourceText(printer, type.pos, endPos)
  }
  if (source == "") {
    return names
  }
  const lexed = lex(source)
  if (lexed is Err(_)) {
    return names
  }
  let tokens: Array<Token> = []
  for (const token of Arrays.values(lexed.value)) {
    if (token.kind != TokenKind.TokNewline) {
      Arrays.push(mutable tokens, token)
    }
  }
  let depth = 0
  let atStart = false
  let index = 0
  while (index < Arrays.length(tokens)) {
    const token = tokens[index]
    index++
    if (token.kind != TokenKind.TokPunct && depth == 1 && atStart) {
      // The first token of a parameter: a name when a `:` follows.
      atStart = false
      if (
        token.kind == TokenKind.TokIdent &&
          index < Arrays.length(tokens) &&
          tokens[index].text == ":"
      ) {
        Arrays.push(mutable names, token.text)
        index++
      } else {
        Arrays.push(mutable names, "")
      }
      continue
    }
    if (token.kind != TokenKind.TokPunct) {
      continue
    }
    if (token.text == ")" && depth == 1) {
      break
    }
    if (depth == 1 && atStart) {
      // A parameter that starts with punctuation, such as `(` or `#[`.
      atStart = false
      Arrays.push(mutable names, "")
    }
    if (token.text == "(" || token.text == "[" || token.text == "#[" || token.text == "<") {
      depth++
      if (depth == 1) {
        atStart = true
      }
    } else if (token.text == ")" || token.text == "]" || token.text == ">") {
      depth--
    } else if (token.text == ">>") {
      depth -= 2
    } else if (token.text == "," && depth == 1) {
      atStart = true
    }
  }
  return names
}
