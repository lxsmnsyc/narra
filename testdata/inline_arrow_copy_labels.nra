// An inlined arrow and a copied body in one function, each with a loop that
// uses continue and break. Their C labels carry different prefixes.
import * as Arrays from "std/array"
import * as Int from "std/int"

@inline
function each(items: Array<int>, visit: (item: int) => void) {
  for (const item of Arrays.values(items)) {
    if (item < 0) {
      continue
    }
    visit(item)
  }
}

@inline
function first(items: Array<int>, check: (item: int) => bool): int {
  let found = -1
  for (const item of Arrays.values(items)) {
    if (check(item)) {
      found = item
      break
    }
  }
  return found
}

export function run(_args: Array<string>): int uses io, alloc {
  let total = 0
  each(
    [1, -2, 3],
    (item) => {
      for (const inner of Arrays.values([item, item + 1, -1])) {
        if (inner < 0) {
          continue
        }
        if (inner > 3) {
          break
        }
        total += inner
      }
    },
  )
  each(
    [4, -5, 6],
    (item) => {
      total += item
    },
  )
  const index = first([1, 8, 9], (item) => item > 5)
  print(`${Int.toString(total)} ${Int.toString(index)}`)
  return 0
}
