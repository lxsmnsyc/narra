// Calls to `@inline` functions (SPEC section 2). The callee's body is
// written at the call inside a C block, the way a block expression is: a
// `return` stores the result and jumps to the label after the block. An arrow
// argument for a function-type parameter that the body only calls is not
// built; each call of the parameter writes the arrow's body in its place, back
// in the caller's state, so its captures are the caller's locals.
//
// While the copied body is written the emitter reads the callee's side tables.
// The output, frames, scopes and loops stay shared, so a `return` releases only
// what the copy holds. C names of locals are program-wide, and a second copy of
// the same body is a sibling or an inner C block, so only loop labels need a
// suffix per copy.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import { Pos, Expr, Stmt, Block, Arg, Param } from "narrac/ast"
import { Type } from "narrac/types"
import { hasReachableEnd } from "narrac/pathends"
import { ProgramFunc, Ref, findBody, findBodySlot, isPassedByPointer } from "narrac/check"
import { cachedCType, parameterCType } from "narrac/cnames"
import { collectBlockUses } from "narrac/inlining"
import {
  Emitter,
  Code,
  TempVar,
  EmitWalker,
  BlockInfo,
  InlineCaller,
  InlineArrow,
  InlineSite,
  writeLine,
  where,
  readNodeType,
  readNodeRef,
  readLocal,
  localName,
  isPointerParameter,
  passArgument,
  declareUnset,
  declareVariable,
  pushScope,
  popScope,
  needsRc,
} from "narrac/emitstate"
import * as Closures from "narrac/emitclosures"

// What a call needs to know about its callee.
struct InlineCallee {
  body: int
  pos: Pos
  block: Block
  parameters: Array<Param>
  parameterTypes: Array<Type>
  result: Type
}

// The C text bound to one parameter of the copy, or the arrow written in its place.
struct BoundArgument {
  text: string
  arrow: Option<Expr>
}

export function emitInlineCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  program: ProgramFunc,
  arguments: Array<Arg>,
): Code uses alloc {
  const callee = copy(describeCallee(emitter, program))
  const calledOnly = findCalledOnlyParameters(emitter, callee)

  // The arguments, left to right in the caller's state, as the call would pass them.
  let bound: Array<BoundArgument> = []
  for (const index of Ranges.upTo(Arrays.length(arguments))) {
    const value = arguments[index].value
    const parameter = callee.parameters[index]
    if (parameter.isMutable) {
      const pointer = EmitWalker.emitLvaluePointer(walker, mutable emitter, value)
      Arrays.push(mutable bound, BoundArgument { text: pointer, arrow: None })
    } else if (value is Expr.ArrowExpr(_, _, _, _, _, _) && calledOnly[index]) {
      Arrays.push(mutable bound, BoundArgument { text: "", arrow: Some(value) })
    } else {
      const code = EmitWalker.emitExpression(walker, mutable emitter, value)
      let text = code.text
      // Inside the copy a large parameter points at the argument, even in a generator.
      if (isPassedByPointer(emitter.checker, callee.parameterTypes[index])) {
        text = passArgument(mutable emitter, callee.parameterTypes[index], code.text)
      }
      Arrays.push(mutable bound, BoundArgument { text: text, arrow: None })
    }
  }

  // The result and the label that a return jumps to.
  emitter.tempCount++
  const number = Int.toString(emitter.tempCount)
  let result = ""
  if (callee.result != Type.TVoid) {
    const typeName = cachedCType(emitter.checker, emitter.typeNames, callee.result)
    result = declareUnset(mutable emitter, typeName, `r${number}`)
  }
  const info = BlockInfo {
    result: result,
    label: `narra_inline_${number}`,
    frames: Arrays.length(emitter.frames),
    scopes: Arrays.length(emitter.scopes),
  }
  writeLine(mutable emitter, "{")
  emitter.indent++

  // The callee's state: its side tables, its file for panics, no blocks of the caller.
  let arrows: Array<InlineArrow> = []
  for (const index of Ranges.upTo(Arrays.length(bound))) {
    if (bound[index].arrow is Some(arrow)) {
      Arrays.push(mutable arrows, InlineArrow {
        parameter: findParameterLocal(emitter, callee.body, callee.parameters[index]),
        arrow: arrow,
      })
    }
  }
  const caller = enterCallee(mutable emitter, callee.body, info, arrows)
  pushScope(mutable emitter, false)
  for (const index of Ranges.upTo(Arrays.length(bound))) {
    if (bound[index].arrow is None) {
      bindParameter(mutable emitter, callee, index, bound[index].text)
    }
  }
  EmitWalker.emitBlockInScope(walker, mutable emitter, callee.block)
  if (callee.result != Type.TVoid && hasReachableEnd(emitter.checker, callee.body, callee.block)) {
    writeMissingReturn(mutable emitter, callee.pos)
  }
  popScope(mutable emitter)
  leaveCallee(mutable emitter, caller)

  emitter.indent--
  writeLine(mutable emitter, "}")
  writeLine(mutable emitter, `${info.label}:;`)
  return finishResult(mutable emitter, result, callee.result)
}

export function emitInlineValueCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  // A call of a parameter bound to an arrow writes the arrow; any other goes through the value.
  if (copy(findBoundArrow(emitter, expression)) is Some(arrow)) {
    return emitArrowBody(walker, mutable emitter, expression, arrow)
  }
  return Closures.emitValueCall(walker, mutable emitter, expression)
}

function findBoundArrow(emitter: Emitter, expression: Expr): Option<Expr> from emitter uses alloc {
  const count = Arrays.length(emitter.inlineSites)
  if (count == 0) {
    return None
  }
  if (expression is Expr.CallExpr(_, _, callee, _, _)) {
    if (callee is Expr.Ident(identId, _, _)) {
      if (readNodeRef(emitter, identId) is Ref.Local(index)) {
        for (const bound of Arrays.values(emitter.inlineSites[count - 1].arrows)) {
          if (bound.parameter == index) {
            return Some(bound.arrow)
          }
        }
      }
    }
  }
  return None
}

function emitArrowBody<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  arrow: Expr,
): Code uses alloc {
  // The arguments are the copied body's; the arrow's body is the caller's.
  let argumentCodes: Array<Code> = []
  if (expression is Expr.CallExpr(_, _, _, _, arguments)) {
    for (const argument of Arrays.values(arguments)) {
      Arrays.push(
        mutable argumentCodes,
        EmitWalker.emitExpression(walker, mutable emitter, argument.value),
      )
    }
  }
  if (arrow is Expr.ArrowExpr(nodeId, pos, parameters, _, bodyExpression, block)) {
    const saved = enterArrowCaller(mutable emitter)
    let result = Type.TVoid
    if (readNodeType(emitter, nodeId) is Type.TFunc(_, resultType, _, _, _)) {
      result = copy(resultType)
    }
    // Large parameters point at the argument, as in the closure function.
    let texts: Array<string> = []
    for (const index of Ranges.upTo(Arrays.length(parameters))) {
      const local = findParameterLocal(emitter, emitter.body, parameters[index])
      let text = argumentCodes[index].text
      if (isPointerParameter(emitter, local)) {
        const localType = copy(readLocal(emitter, local).localType)
        text = passArgument(mutable emitter, localType, text)
      }
      Arrays.push(mutable texts, text)
    }
    emitter.tempCount++
    const number = Int.toString(emitter.tempCount)
    let resultName = ""
    if (result != Type.TVoid) {
      const typeName = cachedCType(emitter.checker, emitter.typeNames, result)
      resultName = declareUnset(mutable emitter, typeName, `r${number}`)
    }
    const info = BlockInfo {
      result: resultName,
      label: `narra_inline_${number}`,
      frames: Arrays.length(emitter.frames),
      scopes: Arrays.length(emitter.scopes),
    }
    writeLine(mutable emitter, "{")
    emitter.indent++
    emitter.blocks = [copy(info)]
    emitter.labelSuffix = `_a${number}`
    pushScope(mutable emitter, false)
    for (const index of Ranges.upTo(Arrays.length(parameters))) {
      const local = findParameterLocal(emitter, emitter.body, parameters[index])
      bindArrowParameter(mutable emitter, local, texts[index])
    }
    // An expression body is a return, or a statement when the arrow returns nothing.
    if (block is Some(arrowBlock)) {
      EmitWalker.emitBlockInScope(walker, mutable emitter, arrowBlock)
      if (result != Type.TVoid && hasReachableEnd(emitter.checker, emitter.body, arrowBlock)) {
        writeMissingReturn(mutable emitter, pos)
      }
    } else if (bodyExpression is Some(arrowBody)) {
      if (result == Type.TVoid) {
        EmitWalker.emitStatement(walker, mutable emitter, Stmt.ExprStmt(pos, arrowBody))
      } else {
        EmitWalker.emitStatement(walker, mutable emitter, Stmt.ReturnStmt(pos, Some(arrowBody)))
      }
    }
    popScope(mutable emitter)
    emitter.indent--
    writeLine(mutable emitter, "}")
    writeLine(mutable emitter, `${info.label}:;`)
    leaveArrowCaller(mutable emitter, saved)
    return finishResult(mutable emitter, resultName, result)
  }
  return Closures.emitValueCall(walker, mutable emitter, expression)
}

// The state an arrow body replaces: the copied body's, and the sites above the caller's.
struct ArrowSaved {
  callee: InlineCaller
  sites: Array<InlineSite>
}

function enterArrowCaller(mutable emitter: Emitter): ArrowSaved uses alloc {
  const count = Arrays.length(emitter.inlineSites)
  const caller = copy(emitter.inlineSites[count - 1].caller)
  const saved = ArrowSaved { callee: copy(saveCaller(emitter)), sites: copy(emitter.inlineSites) }
  // The arrow sees the inline calls that enclose its own caller, not the one it was passed to.
  let outer: Array<InlineSite> = []
  for (const index of Ranges.upTo(count - 1)) {
    Arrays.push(mutable outer, copy(emitter.inlineSites[index]))
  }
  restoreCaller(mutable emitter, caller)
  emitter.inlineSites = outer
  return saved
}

function leaveArrowCaller(mutable emitter: Emitter, saved: ArrowSaved) uses alloc {
  restoreCaller(mutable emitter, saved.callee)
  emitter.inlineSites = saved.sites
}

function enterCallee(
  mutable emitter: Emitter,
  body: int,
  info: BlockInfo,
  arrows: Array<InlineArrow>,
): InlineCaller uses alloc {
  const caller = copy(saveCaller(emitter))
  Arrays.push(mutable emitter.inlineSites, InlineSite { caller: caller, arrows: arrows })
  emitter.inlineCount++
  emitter.body = body
  emitter.file = findModuleFile(emitter, body)
  emitter.refCaptures = []
  emitter.hoistedArrays = []
  // No yield runs inside the copy, so its locals are C locals even in a generator.
  emitter.inGenerator = false
  emitter.blocks = [copy(info)]
  emitter.labelSuffix = `_i${Int.toString(emitter.inlineCount)}`
  return caller
}

function leaveCallee(mutable emitter: Emitter, caller: InlineCaller) uses alloc {
  restoreCaller(mutable emitter, caller)
  let kept: Array<InlineSite> = []
  for (const index of Ranges.upTo(Arrays.length(emitter.inlineSites) - 1)) {
    Arrays.push(mutable kept, emitter.inlineSites[index])
  }
  emitter.inlineSites = kept
}

function saveCaller(emitter: Emitter): InlineCaller from emitter uses alloc {
  return InlineCaller {
    body: emitter.body,
    file: emitter.file,
    refCaptures: emitter.refCaptures,
    hoistedArrays: emitter.hoistedArrays,
    inGenerator: emitter.inGenerator,
    blocks: emitter.blocks,
    labelSuffix: emitter.labelSuffix,
  }
}

function restoreCaller(mutable emitter: Emitter, caller: InlineCaller) {
  emitter.body = caller.body
  emitter.file = caller.file
  emitter.refCaptures = caller.refCaptures
  emitter.hoistedArrays = caller.hoistedArrays
  emitter.inGenerator = caller.inGenerator
  emitter.blocks = caller.blocks
  emitter.labelSuffix = caller.labelSuffix
}

function findModuleFile(emitter: Emitter, body: int): string {
  const module = emitter.checker.bodies[body].module
  if (emitter.checker.scopeIndex[module] is Some(scope)) {
    return emitter.checker.scopes[scope].file
  }
  return module
}

function describeCallee(
  emitter: Emitter,
  program: ProgramFunc,
): InlineCallee from emitter uses alloc {
  // A generic function is copied from the body checked for the call's type arguments.
  let key = ""
  let funcIndex = -1
  let parameterTypes: Array<Type> = []
  let result = Type.TVoid
  if (program is ProgramFunc.InstanceFunc(instance)) {
    key = `inst|${Int.toString(instance)}`
    funcIndex = emitter.checker.instanceList[instance].funcIndex
    parameterTypes = emitter.checker.instanceList[instance].parameters
    result = emitter.checker.instanceList[instance].result
  } else if (program is ProgramFunc.PlainFunc(plainIndex)) {
    key = `func|${Int.toString(plainIndex)}`
    funcIndex = plainIndex
    for (const parameter of Arrays.values(
      emitter.checker.functions[plainIndex].declaration.parameters,
    )) {
      Arrays.push(mutable parameterTypes, emitter.checker.paramTypes[parameter.id])
    }
    result = emitter.checker.functions[plainIndex].result
  }
  const declaration = emitter.checker.functions[funcIndex].declaration
  let block = Block { pos: declaration.pos, end: declaration.pos, statements: [] }
  if (declaration.body is Some(found)) {
    block = found
  }
  return InlineCallee {
    body: findBody(emitter.checker, key),
    pos: declaration.pos,
    block: block,
    parameters: declaration.parameters,
    parameterTypes: parameterTypes,
    result: result,
  }
}

function findParameterLocal(emitter: Emitter, body: int, parameter: Param): int {
  const info = emitter.checker.bodies[body]
  return info.declared[parameter.id - info.first]
}

function findCalledOnlyParameters(emitter: Emitter, callee: InlineCallee): Array<bool> uses alloc {
  // A function-type parameter is only called when every name that reads it is
  // the callee of a call outside any arrow function in the body.
  const info = emitter.checker.bodies[callee.body]
  const bodyUses = collectBlockUses(callee.block)
  let called: Map<int, bool> = Map {}
  for (const call of Arrays.values(bodyUses.calls)) {
    if (call.calleeId >= 0 && !call.inArrow) {
      called[call.calleeId] = true
    }
  }
  let calledOnly: Array<bool> = []
  for (const parameter of Arrays.values(callee.parameters)) {
    const local = findParameterLocal(emitter, callee.body, parameter)
    let only = info.locals[local].localType is Type.TFunc(_, _, _, _, _)
    for (const name of Arrays.values(bodyUses.names)) {
      const slot = findBodySlot(info, name.nodeId)
      if (slot >= 0 && only) {
        if (info.refs[slot] is Ref.Local(index)) {
          if (index == local && called[name.nodeId] is None) {
            only = false
          }
        }
      }
    }
    Arrays.push(mutable calledOnly, only)
  }
  return calledOnly
}

function bindParameter(
  mutable emitter: Emitter,
  callee: InlineCallee,
  index: int,
  text: string,
) uses alloc {
  // The C declaration of the parameter in the out-of-line function, set to the argument.
  const parameter = callee.parameters[index]
  const local = findParameterLocal(emitter, callee.body, parameter)
  const typeName = parameterCType(
    emitter.checker,
    emitter.typeNames,
    callee.parameterTypes[index],
    parameter.isMutable,
  )
  const name = localName(readLocal(emitter, local))
  writeLine(mutable emitter, `${typeName} ${name} = ${text};`)
}

function bindArrowParameter(mutable emitter: Emitter, local: int, text: string) uses alloc {
  // A generator frame holds a copy where a function would hold a pointer.
  const localType = copy(readLocal(emitter, local).localType)
  let typeName = cachedCType(emitter.checker, emitter.typeNames, localType)
  if (isPointerParameter(emitter, local)) {
    typeName = parameterCType(emitter.checker, emitter.typeNames, localType, false)
  }
  const name = localName(readLocal(emitter, local))
  const declaration = declareVariable(mutable emitter, typeName, name)
  writeLine(mutable emitter, `${declaration} = ${text};`)
}

function writeMissingReturn(mutable emitter: Emitter, pos: Pos) uses alloc {
  // The panic the out-of-line function has at its end.
  const position = where(emitter, pos)
  writeLine(
    mutable emitter,
    `narra_panic(${position}, "internal compiler error: function ended without returning a value");`,
  )
}

function finishResult(mutable emitter: Emitter, result: string, resultType: Type): Code uses alloc {
  // A counted result is an owned temporary of the caller's statement.
  if (resultType == Type.TVoid) {
    return Code { text: "", owned: false }
  }
  if (needsRc(emitter, resultType)) {
    const top = Arrays.length(emitter.frames) - 1
    Arrays.push(mutable emitter.frames[top], TempVar { name: result, tempType: resultType })
    return Code { text: result, owned: true }
  }
  return Code { text: result, owned: false }
}
