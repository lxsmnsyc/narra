// error: mutable_read_conflict_twice.nra:13:44: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function grow(mutable n: int): int {
  n = n + 1
  return 1
}

function sum(a: int, b: int): int {
  return a + b
}

export function run(args: Array<string>): int {
  let x = 1
  return sum(grow(mutable x), grow(mutable x))
}
