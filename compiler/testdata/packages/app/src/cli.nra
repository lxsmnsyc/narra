import * as Int from "std/int"
import * as Text from "app/text"
import * as List from "app/util/list"
import { Token, Span, show } from "app/text"
import * as Array from "std/array"

function label(s: Text.Span): string {
  return `span of ${Int.toString(Text.width(s))}`
}

export function run(args: Array<string>): int {
  const tokens: Array<Token> = [Word("hi"), Token.Number(7), Space]
  for (const t of Array.values(tokens)) {
    print(show(t))
  }
  print(label(Span { start: 2, end: 5 }))
  const words: Array<string> = ["a", "b"]
  print(Text.lastWord(words))
  const empty: Array<string> = []
  print(Text.lastWord(empty))
  const bag: List.Bag<int> = List.bagOf([1, 2, 3])
  print(`bag holds ${Int.toString(List.size(bag))}`)
  const names = List.bagOf(words)
  print(`last name ${List.lastOr(names.items, "?")}`)
  return 0
}

test "tokens show" {
  assert(show(Space) == "space")
}
