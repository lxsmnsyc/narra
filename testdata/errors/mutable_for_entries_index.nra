// error: `#[index, mutable player]` needs `Arrays.entries(items)` as the source; without the index, write `for (mutable player of items)`
struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  for (const #[index, mutable player] of players) {
    player.hp = index
  }
  return 0
}
