    key: "slice",
    parameters: ["string", "int", "int"],
    parameterNames: ["text", "start", "end"],
    result: "Option<string>",
    effects: ["alloc"],
    doc: "Returns the text from byte offset `start` up to but not including `end`. Gives `None` when an offset is outside the text or inside a character, or `start` is after `end`.",
