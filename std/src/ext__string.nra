// std/string: searching, trimming and padding. The rest of the functions are built into the compiler.

import * as Str from "std/string"

export function find(text: string, needle: string): Option<int> uses alloc {
  return Str.indexOf(text, needle)
}

export function lastIndexOf(text: string, needle: string): Option<int> uses alloc {
  let start = Str.length(text) - Str.length(needle)
  while (start >= 0) {
    if (Str.slice(text, start, start + Str.length(needle)) is Some(piece)) {
      if (piece == needle) {
        return Some(start)
      }
    }
    start--
  }
  return None
}

export function trimStart(text: string): string uses alloc {
  const length = Str.length(text)
  let start = 0
  while (start < length && isSpace(Str.byteAt(text, start))) {
    start++
  }
  return Str.sliceFrom(text, start)
}

export function trimEnd(text: string): string uses alloc {
  let end = Str.length(text)
  while (end > 0 && isSpace(Str.byteAt(text, end - 1))) {
    end--
  }
  if (Str.slice(text, 0, end) is Some(kept)) {
    return kept
  }
  return text
}

export function padStart(text: string, width: int, fill: char): string uses alloc {
  return `${makePadding(text, width, fill)}${text}`
}

export function padEnd(text: string, width: int, fill: char): string uses alloc {
  return `${text}${makePadding(text, width, fill)}`
}

function makePadding(text: string, width: int, fill: char): string uses alloc {
  const fillText = Str.fromChar(fill)
  const fillLength = Str.length(fillText)
  if (fillLength == 0) {
    return ""
  }
  // Whole copies of fill only, so a multi-byte fill is never split.
  const count = (width - Str.length(text)) / fillLength
  if (count > 0) {
    if (Str.repeat(fillText, count) is Some(padding)) {
      return padding
    }
  }
  return ""
}

function isSpace(byte: int): bool {
  return byte == 32 || (byte >= 9 && byte <= 13)
}
