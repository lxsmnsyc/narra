import * as Process from "std/process"

export function run(args: Array<string>): int uses io, alloc {
  // The shell's parent is this program, so $PPID is the pid to report.
  const written = Process.run("sh", ["-c", "echo $PPID > \"$1\"", "sh", args[1]])
  if (written is Err(_message)) {
    return 2
  }
  let count = 0
  while (true) {
    count = count + 1
    if (count < 0) {
      print("never")
    }
  }
  return 0
}
