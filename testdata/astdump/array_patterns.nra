function patterns(items: Array<int>, words: Option<Array<string>>): int {
  const [...all] = items
  for (const [left, right] of rows) {}
  let n = match (items) {
    [] => 0
    [only] => 1
    [first, ..._] => 2
    [first, second, ...rest] => 3
    [_, 0 | 1] => 4
  }
  if (words is Some([_, "hash", text])) {}
  return n
}
