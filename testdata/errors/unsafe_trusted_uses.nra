// error: peek is @trusted, so it does not have the unsafe effect; remove `uses unsafe`
import * as Ptr from "std/ptr"

@trusted
export function peek(items: Ptr<int>): int uses unsafe {
  let value = 0
  unsafe {
    value = Ptr.read(items)
  }
  return value
}

export function run(_args: Array<string>): int {
  return 0
}
