// The registry rows, checks and emitters of std/lazy.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Checker, Walker, Ref, getRef, reportError, getExpressionPos } from "narrac/check"
import { Pos, Expr, Arg } from "narrac/ast"
import { checkExpression } from "narrac/exprs"
import { checkArgumentCount } from "narrac/stdcheckhelp"
import { isLazyConstant, markForced } from "narrac/lazyvalues"
import { Emitter, Code, EmitWalker } from "narrac/emitstate"

export const LAZY_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Lazies.force",
    module: "std/lazy",
    key: "force",
    check: "checkLazyForce",
  },
]

function getNamedNode(argument: Expr): Option<int> {
  return match (argument) {
    Expr.Ident(nodeId, _, _) => Some(nodeId)
    Expr.FieldExpr(nodeId, _, _, _) => Some(nodeId)
    _ => None
  }
}

function checkLazyForce<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    return Type.TVoid
  }
  const argument = arguments[0].value
  // The name is the one place a lazy value may appear.
  if (getNamedNode(argument) is Some(nodeId)) {
    markForced(mutable checker, nodeId)
  }
  const found = checkExpression(mutable checker, walker, argument, None)
  if (getNamedNode(argument) is Some(checkedId)) {
    if (getRef(checker, checkedId) is Ref.Const(index)) {
      if (isLazyConstant(checker, index)) {
        return found
      }
    }
  }
  reportError(
    mutable checker,
    getExpressionPos(argument),
    "E1033",
    "this argument is not the name of a lazy value; a lazy value appears only as the name that Lazies.force takes",
  )
  return found
}

export function checkLazyCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
): Type uses alloc {
  if (kind == "checkLazyForce") {
    return checkLazyForce(mutable checker, walker, pos, arguments, name)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
  return Type.TVoid
}

export function emitLazyCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
): Code uses alloc {
  // The name reads the getter, which builds the value on its first use.
  return EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
}
