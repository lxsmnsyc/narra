import * as Arrays from "std/array"

function add(mutable items: Array<int>, item: int) {
  Arrays.push(mutable items, item)
}

export function run(args: Array<string>): int {
  let numbers: Array<int> = []
  add(item: 1, items: mutable numbers)
  add(item: 2, items: numbers)
  return Arrays.length(numbers)
}
