// error: this function's result shares its parameter 1, but the expected type (Array<int>) => Array<int> uses alloc has no matching from; add `from` naming that parameter to the expected type
function same(items: Array<int>): Array<int> from items {
  return items
}

function fresh(items: Array<int>): Array<int> uses alloc {
  return [items[0]]
}

struct Holder {
  pick: (Array<int>) => Array<int> uses alloc
  sharing: (items: Array<int>) => Array<int> from items uses alloc
}

// Passes: the result is an int, so sharing changes nothing.
function first<T>(items: Array<T>): T from items {
  return items[0]
}

function applyToInt(pick: (Array<int>) => int, items: Array<int>): int {
  return pick(items)
}

export function run(_args: Array<string>): int {
  const plain = Holder { pick: same, sharing: fresh }
  const marked = Holder { pick: fresh, sharing: same }
  return plain.pick([1])[0] + marked.sharing([2])[0] + applyToInt(first, [3])
}
