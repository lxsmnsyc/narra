// The registry rows and emitters of std/int.
import { StdFunc } from "narrac/std/builtins"
import { Type } from "narrac/check/types"
import { Pos, Arg } from "narrac/syntax/ast"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  temp,
  readNodeType,
} from "narrac/emit/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  stringOut,
  ioResult,
} from "narrac/std/stdemithelp"
import { emitSizedCall } from "narrac/std/stdsized"
import * as Arrays from "std/array"

export const INT_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Int.abs",
    module: "std/int",
    key: "abs",
    parameters: ["int"],
    parameterNames: ["value"],
    result: "int",
    doc: "Gives the absolute value. The smallest `int` has no positive counterpart and comes back unchanged.",
  },
  StdFunc {
    name: "Int.parse",
    module: "std/int",
    key: "parse",
    parameters: ["string", "int"],
    parameterNames: ["text", "base"],
    result: "Result<int, string>",
    effects: ["alloc"],
    check: "fixed",
    doc: "Reads text in `base` (2 to 36) as an `int`. The text is an optional `-` and digits only, with no `+`, spaces or `0x` prefix, and a number outside 64 bits is an error.",
  },
  StdFunc {
    name: "Int.toHex",
    module: "std/int",
    key: "toHex",
    parameters: ["int"],
    parameterNames: ["value"],
    result: "string",
    effects: ["alloc"],
    doc: "Writes the value in lowercase base 16 with no `0x` prefix. A negative value gets a leading `-`, not its two's complement.",
  },
  StdFunc {
    name: "Int.toString",
    module: "std/int",
    key: "toString",
    parameters: ["int"],
    parameterNames: ["value"],
    result: "string",
    effects: ["alloc"],
    doc: "Writes the value in base 10, with a leading `-` when it is negative.",
  },
]

const INT_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Int.toString",
    call: "lstr_from_int",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Int.toHex",
    call: "narra_int_to_hex",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall { name: "Int.abs", call: "narra_abs", withPos: true, owned: false, temporary: true },
]

function emitParse<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = copy(readNodeType(emitter, nodeId))
  const text = argumentText(walker, mutable emitter, arguments, 0)
  const base = argumentText(walker, mutable emitter, arguments, 1)
  const number = temp(mutable emitter, Type.TInt, "0")
  const bad = stringOut(mutable emitter)
  const success = temp(
    mutable emitter,
    Type.TBool,
    `narra_int_parse(${text}, ${base}, &${number}, &${bad})`,
  )
  return ioResult(mutable emitter, resultType, success, number, bad)
}

export function emitIntCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  if (
    name == "Int.from" ||
      name == "Int.tryFrom" ||
      name == "Int.wrap" ||
      name == "Int.addChecked" ||
      name == "Int.subChecked" ||
      name == "Int.mulChecked"
  ) {
    return emitSizedCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  for (const fixed of Arrays.values(INT_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Int.parse") {
    return emitParse(walker, mutable emitter, nodeId, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
