// error: the arrow function returns a value that shares captured "rows"; a from marker can name only a parameter, so return a copy with copy(...)
import * as Arrays from "std/array"

function rowsLater(): () => Array<int> uses alloc {
  const rows = [1, 2]
  return () => rows
}

// Passes: a generic result taken out of its `from` parameter shares it.
function lastItem<T>(items: Array<T>): T from items {
  return items[Arrays.length(items) - 1]
}

// Passes: an arrow function that shares its own parameter says so.
function keepFirst(): (rows: Array<Array<int>>) => Array<int> from rows {
  return (rows: Array<Array<int>>): Array<int> from rows => rows[0]
}

export function run(_args: Array<string>): int {
  const later = rowsLater()
  const pick = keepFirst()
  return later()[0] + lastItem([3, 4]) + pick([[5]])[0]
}
