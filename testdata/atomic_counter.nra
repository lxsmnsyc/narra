// Eight threads each add to one Atomic<int> 10000 times. Atomic.add gives the
// old value, and the total is exact without a lock.
import * as Thread from "std/thread"
import * as Atomic from "std/atomic"
import * as Arrays from "std/array"
import * as Int from "std/int"

function count(hits: Atomic.Atomic<int>): int {
  let largest = 0
  for (let index = 0; index < 10000; index++) {
    const old = Atomic.add(hits, 1)
    if (old > largest) {
      largest = old
    }
  }
  return largest
}

export function run(_args: Array<string>): int {
  const hits = Atomic.create(0)
  const largest = Thread.scope((scope) => {
    let threads: Array<Thread.Thread<int>> = []
    for (let index = 0; index < 8; index++) {
      Arrays.push(mutable threads, Thread.start(scope, () => count(hits)))
    }
    let largestOld = 0
    for (const thread of Arrays.values(threads)) {
      const old = Thread.join(thread)
      if (old > largestOld) {
        largestOld = old
      }
    }
    return largestOld
  })
  print(`total ${Int.toString(Atomic.load(hits))}`)
  print(`largest old value ${Int.toString(largest)}`)
  Atomic.store(hits, 5)
  print(
    `exchange gave ${Int.toString(Atomic.exchange(hits, 9))}, now ${Int.toString(Atomic.load(hits))}`,
  )
  return 0
}
