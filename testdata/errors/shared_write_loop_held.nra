// warning: rows[0] = ... may change rows, which the loop over rows still holds
import * as Arrays from "std/array"

export function run(_args: Array<string>): int uses alloc {
  let rows = [[1], [2]]
  // The loop's iterator holds rows until the loop ends, so the write copies
  // rows even though row is not used after it.
  for (const row of rows) {
    if (row[0] > 0) {
      rows[0] = [0]
    }
  }
  let values = [1, 2]
  for (const value of Arrays.values(values)) {
    values[0] = value
  }
  return rows[0][0] + values[0]
}
