// error: an escaping closure cannot capture Scope "scope"
import * as Thread from "std/thread"

export function run(_args: Array<string>): int {
  return Thread.scope((scope) => {
    const outer = Thread.start(scope, () => {
      const inner = Thread.start(scope, () => 1)
      return Thread.join(inner)
    })
    return Thread.join(outer)
  })
}
