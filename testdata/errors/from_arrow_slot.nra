// error: the arrow function returns a value that shares its parameter "picked", which its function type does not allow; return a copy with copy(...)
struct Row {
  cells: Array<int>
  size: int
}

function applyFresh(pick: (row: Row) => Array<int>, row: Row): Array<int> {
  return pick(row)
}

function applyShared(pick: (row: Row) => Array<int> from row, row: Row): Array<int> from row {
  return pick(row)
}

// Passes: an arrow without `from` takes the `from` of the expected type.
function sharedCells(row: Row): Array<int> from row {
  return applyShared((picked) => picked.cells, row)
}

// Passes: a spread whose shared fields are all written shares nothing.
function emptied(row: Row): Row {
  return Row { ...row, cells: [] }
}

export function run(_args: Array<string>): int {
  const row = Row { cells: [1], size: 1 }
  return applyFresh((picked) => picked.cells, row)[0] + sharedCells(row)[0] + emptied(row).size
}
