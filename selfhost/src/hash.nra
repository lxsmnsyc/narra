// Hashing for C names: xxHash32 and the module hash, ported from cnames.go.
// This module imports std only, so modules.nra can use it for the module hash
// clash check.
//
// An int is 64 bits, so every 32-bit value is kept in 0 <= value < 2^32 and a
// wrapping product or sum is cut with MASK.
import * as Int from "std/int"
import * as Str from "std/string"

const MASK = 4294967295
const PRIME1 = 2654435761
const PRIME2 = 2246822519
const PRIME3 = 3266489917
const PRIME4 = 668265263
const PRIME5 = 374761393

function rotateLeft32(value: int, bits: int): int {
  // Rotates by 1 to 31 bits.
  return ((value << bits) | (value >> (32 - bits))) & MASK
}

function multiply32(left: int, right: int): int {
  return (left * right) & MASK
}

function readWord32(text: string, offset: int): int {
  return Str.byteAt(text, offset) |
    (Str.byteAt(text, offset + 1) << 8) |
    (Str.byteAt(text, offset + 2) << 16) |
    (Str.byteAt(text, offset + 3) << 24)
}

function round32(accumulator: int, word: int): int {
  return multiply32(rotateLeft32((accumulator + multiply32(word, PRIME2)) & MASK, 13), PRIME1)
}

export function xxh32(text: string, seed: int): int {
  const length = Str.length(text)
  let offset = 0
  let hash = 0
  if (length >= 16) {
    // Four lanes take 16 bytes at a time.
    let lane1 = (seed + PRIME1 + PRIME2) & MASK
    let lane2 = (seed + PRIME2) & MASK
    let lane3 = seed & MASK
    let lane4 = (seed - PRIME1) & MASK
    while (offset + 16 <= length) {
      lane1 = round32(lane1, readWord32(text, offset))
      lane2 = round32(lane2, readWord32(text, offset + 4))
      lane3 = round32(lane3, readWord32(text, offset + 8))
      lane4 = round32(lane4, readWord32(text, offset + 12))
      offset += 16
    }
    hash =
      (rotateLeft32(lane1, 1) +
        rotateLeft32(lane2, 7) +
        rotateLeft32(lane3, 12) +
        rotateLeft32(lane4, 18)) &
        MASK
  } else {
    hash = (seed + PRIME5) & MASK
  }
  hash = (hash + length) & MASK
  // Whole words, then single bytes.
  while (offset + 4 <= length) {
    hash = multiply32(
      rotateLeft32((hash + multiply32(readWord32(text, offset), PRIME3)) & MASK, 17),
      PRIME4,
    )
    offset += 4
  }
  while (offset < length) {
    hash = multiply32(
      rotateLeft32((hash + multiply32(Str.byteAt(text, offset), PRIME5)) & MASK, 11),
      PRIME1,
    )
    offset++
  }
  // Final mix.
  hash ^= hash >> 15
  hash = multiply32(hash, PRIME2)
  hash ^= hash >> 13
  hash = multiply32(hash, PRIME3)
  hash ^= hash >> 16
  return hash
}

export function hex8(value: int): string uses alloc {
  const digits = Int.toHex(value)
  return `${Str.repeat("0", 8 - Str.length(digits))}${digits}`
}

export function relativeModule(path: string): string uses alloc {
  if (Str.indexOf(path, "/") is Some(index)) {
    return Str.sliceFrom(path, index + 1)
  }
  return path
}

export function moduleHash(path: string): string uses alloc {
  // The hash does not depend on the package name or on where the package is on disk.
  return hex8(xxh32(relativeModule(path), 0))
}
