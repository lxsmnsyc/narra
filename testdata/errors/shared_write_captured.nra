// error: other[0] = ... may change other, which items still uses at line 11
import * as Arrays from "std/array"

export function run(_args: Array<string>): int uses alloc {
  const items = [1, 2]
  // The arrow function keeps the value of items it captured.
  const read = (): int => Arrays.length(items)
  let other = items
  other[0] = 5
  // Inside an arrow function, a captured value stays shared with its source.
  const first = (): int => {
    let list = items
    list[0] = 3
    return list[0]
  }
  return read() + other[0] + first()
}
