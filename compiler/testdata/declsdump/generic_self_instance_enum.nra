import * as Int from "std/int"
import * as Box from "std/box"

enum E<T> {
  Node(o: Option<Box<E<int>>>, v: T)
  Leaf
}

export function run(args: Array<string>): int {
  const inner: E<int> = Node(None, 5)
  const outer: E<string> = Node(Some(Box.new(inner)), "s")
  match (outer) {
    Node(o, v) => {
      print(v)
      if (o is Some(b)) {
        match (b.value) {
          Node(_, n) => {
            print(Int.toString(n))
          }
          Leaf => {
          }
        }
      }
    }
    Leaf => {
    }
  }
  return 0
}
