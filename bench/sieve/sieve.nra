import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

function countPrimes(n: int): int {
  let marks = Arrays.filled(1, n)
  marks[0] = 0
  marks[1] = 0
  let i = 2
  while (i * i < n) {
    if (marks[i] == 1) {
      let j = i * i
      while (j < n) {
        marks[j] = 0
        j = j + i
      }
    }
    i = i + 1
  }
  let count = 0
  for (const k of Ranges.upTo(n)) {
    count = count + marks[k]
  }
  return count
}

export function run(args: Array<string>): int {
  print(Int.toString(countPrimes(20000000)))
  return 0
}
