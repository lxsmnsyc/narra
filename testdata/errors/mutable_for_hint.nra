// error: "player" is a copy of an element of game.players, so changing it would not change game.players; write `for (mutable player of game.players)`, or copy it first with `const copy = player`
struct Player {
  hp: int
}

struct Game {
  players: Array<Player>
  round: int
}

export function run(args: Array<string>): int {
  const game = Game { players: [Player { hp: 3 }], round: 1 }
  for (const player of game.players) {
    player.hp = 0
  }
  return game.round
}
