  StdFunc {
    name: "Str.concat",
    module: "std/string",
    key: "concat",
    parameters: ["string", "string"],
    parameterNames: ["first", "second"],
    result: "string",
    effects: ["alloc"],
    doc: "Returns `first` followed by `second` as one string.",
  },
  StdFunc {
    name: "Str.contains",
    module: "std/string",
    key: "contains",
    parameters: ["string", "string"],
    parameterNames: ["text", "needle"],
    result: "bool",
    doc: "Tells whether `needle` occurs in the text. An empty `needle` is always found.",
  },
  StdFunc {
    name: "Str.endsWith",
    module: "std/string",
    key: "endsWith",
    parameters: ["string", "string"],
    parameterNames: ["text", "suffix"],
    result: "bool",
    doc: "Tells whether the text ends with `suffix`.",
  },
  StdFunc {
    name: "Str.fromChar",
    module: "std/string",
    key: "fromChar",
    parameters: ["char"],
    parameterNames: ["character"],
    result: "string",
    effects: ["alloc"],
    doc: "Returns a string that holds the one character.",
  },
  StdFunc {
    name: "Str.indexOf",
    module: "std/string",
    key: "indexOf",
    parameters: ["string", "string"],
    parameterNames: ["text", "needle"],
    result: "Option<int>",
    effects: ["alloc"],
    check: "fixed",
    doc: "Returns the byte offset of the first `needle` in the text, or `None` when it does not occur. An empty `needle` gives `Some(0)`.",
  },
  StdFunc {
    name: "Str.join",
    module: "std/string",
    key: "join",
    parameters: ["Array<string>", "string"],
    parameterNames: ["parts", "separator"],
    result: "string",
    effects: ["alloc"],
    check: "fixed",
    doc: "Returns the parts as one string, with `separator` between each pair.",
  },
  StdFunc {
    name: "Str.length",
    module: "std/string",
    key: "length",
    parameters: ["string"],
    parameterNames: ["text"],
    result: "int",
    doc: "Returns the length of the text in bytes, not in characters.",
  },
  StdFunc {
    name: "Str.nextChar",
    module: "std/string",
    key: "nextChar",
    parameters: ["string", "int"],
    parameterNames: ["text", "index"],
