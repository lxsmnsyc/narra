// error: Arrays.push(mutable items, ...) may change items, which arena[] still uses at line 10; no fix is offered here: copy the value by hand where the sharing starts, or end the sharing before the write
import * as Arrays from "std/array"
import * as Arenas from "std/arena"

export function run(_args: Array<string>): int uses alloc {
  let arena = Arenas.create<Array<int>>()
  let items = [1, 2, 3]
  const _handle = Arenas.insert(mutable arena, items)
  Arrays.push(mutable items, 4)
  return Arrays.length(items) + Arenas.size(arena)
}
