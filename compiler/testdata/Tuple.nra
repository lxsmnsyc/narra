import * as Int from "std/int"

// This file is module "Tuple". Tuple C names have no module hash segment
// and are interned from their parts, so they never equal a user type's name.

struct Foo {
  n: int
}

struct A_int<T> {
  item: T
}

export function run(args: Array<string>): int {
  const t: #[Array<int>, Foo] = #[[1, 2], Foo { n: 3 }]
  const a = A_int { item: Foo { n: 4 } }
  const #[xs, foo] = t
  print(`${Int.toString(xs[1])} ${Int.toString(foo.n)} ${Int.toString(a.item.n)}`)
  return 0
}
