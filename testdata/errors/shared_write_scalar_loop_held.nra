// error: positions[0].line = ... may change positions, which the loop over positions still holds
struct Pos {
  line: int
  column: int
}

export function run(_args: Array<string>): int {
  let positions = [Pos { line: 1, column: 2 }, Pos { line: 3, column: 4 }]
  let total = 0
  for (const pos of positions) {
    // The loop still walks positions.
    positions[0].line = 0
    total += pos.line
  }
  return total
}
