// error: E1053, a failed assert while the constant is computed
@const
function checked(value: int): int {
  assert(value > 10)
  return value
}

@const
function outer(value: int): int {
  return checked(value) + 1
}

const CHECKED = outer(4)

export function run(args: Array<string>): int {
  return CHECKED
}
