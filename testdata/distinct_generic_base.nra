import * as Int from "std/int"
import * as Arrays from "std/array"

distinct type Ids = Array<int>
distinct type Grid = Array<Array<int>>
distinct type Name = string

export function run(args: Array<string>): int {
  const ids = Ids.from([1, 2, 3])
  const grid = Grid.from([[1], [2, 3]])
  const name = Name.from("ok")
  print(Int.toString(Arrays.length(Ids.toArray(ids))))
  print(Int.toString(Arrays.length(Grid.toArray(grid))))
  print(Name.toString(name))
  return 0
}
