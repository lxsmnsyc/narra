import * as Int from "std/int"

struct Box {
  run: (value: int) => int uses io
}

struct Plain {
  run: (value: int) => int
}

function loud(value: int): int {
  print("loud")
  return value + 1
}

export function pick(): (value: int) => int uses io {
  return loud
}

// An effect variable bound to a function read from a field.
export function twice<effect E>(f: (value: int) => int uses E, value: int): int uses E {
  return f(f(value))
}

function fromField(box: Box): int uses io {
  return box.run(1)
}

function fromIndex(steps: Array<(value: int) => int uses io>): int uses io {
  return steps[0](2)
}

function fromResult(): int uses io {
  return pick()(3)
}

function viaVariable(box: Box): int uses io {
  return twice(box.run, 4)
}

function viaLocal(box: Box): int uses io {
  const step = box.run
  return step(5)
}

function pureField(plain: Plain): int {
  return plain.run(6)
}

function quiet(value: int): int {
  return value + 10
}

export function wrapAll<effect E>(escaping f: (value: int) => int uses E): Array<(
  value: int,
) => int uses E> uses alloc {
  return [f]
}

// The variable of the callee is replaced by the effects bound at the call.
function boundIndex(): int uses alloc {
  return wrapAll(quiet)[0](7)
}

function boundLocal(): int uses alloc {
  const steps = wrapAll(quiet)
  return steps[0](8)
}

function boundIo(): int uses alloc, io {
  return wrapAll(loud)[0](9)
}

function parenthesized(box: Box): int uses io {
  return (box.run)(10)
}

export function run(args: Array<string>): int {
  const box = Box { run: loud }
  const plain = Plain { run: (value: int): int => value * 2 }
  const total =
    fromField(box) +
      fromIndex([loud]) +
      fromResult() +
      viaVariable(box) +
      viaLocal(box) +
      pureField(plain) +
      boundIndex() +
      boundLocal() +
      boundIo() +
      parenthesized(box)
  print(Int.toString(total))
  return 0
}
