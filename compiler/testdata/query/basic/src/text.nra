import * as Str from "std/string"
import * as Arrays from "std/array"

export const LIMIT = 3

export struct Point {
  x: int
  y: int
}

export enum Shape derives Show {
  Circle(radius: int)
  Empty
}

export trait Named {
  function name(value: Self): string uses alloc
}

export distinct type UserId = int

const SEPARATOR = ", "

export function helper(text: string): int uses alloc {
  const joined = Str.join([text, text], SEPARATOR)
  return Str.length(joined)
}

export function first<T>(items: Array<T>, fallback: T): T {
  if (Arrays.length(items) == 0) {
    return fallback
  }
  return items[0]
}

export function area(shape: Shape): int {
  return match (shape) { Shape.Circle(radius) => 3 * radius * radius, Shape.Empty => 0 }
}

function hidden(): int {
  return LIMIT + helper("x")
}
