// Early returns in a copied body and in a block arrow release what each holds:
// the arrow's own return ends the arrow, not the @inline function.
import * as Arrays from "std/array"
import * as Str from "std/string"

@inline
function findFirst(items: Array<string>, accept: (item: string) => bool): string uses alloc {
  if (Arrays.length(items) == 0) {
    return "none"
  }
  for (const item of Arrays.values(items)) {
    const label = `<${item}>`
    if (accept(item)) {
      return label
    }
  }
  return "no match"
}

@inline
function describe(name: string, check: (text: string) => string uses alloc): string uses alloc {
  const greeting = `hello ${name}`
  if (Str.length(name) > 5) {
    return `${check(greeting)} (long)`
  }
  return check(greeting)
}

export function run(_args: Array<string>): int uses io, alloc {
  const words = ["apple", "banana", "cherry"]
  const prefix = "b"
  print(findFirst(words, (item) => Str.startsWith(item, prefix)))
  print(
    findFirst(words, (item) => {
      // A return inside the arrow answers the arrow's call.
      if (Str.length(item) > 5) {
        return Str.endsWith(item, "y")
      }
      return false
    }),
  )
  print(findFirst([], (item) => Str.length(item) > 0))
  print(findFirst(words, (_item) => false))
  const suffix = "!"
  print(
    describe("ada", (text) => {
      if (Str.startsWith(text, "hello")) {
        const loud = `${text}${suffix}`
        return loud
      }
      return text
    }),
  )
  print(describe("grace hopper", (text) => `${text}${suffix}${suffix}`))
  return 0
}
