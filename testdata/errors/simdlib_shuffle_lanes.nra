// error: a lane of Simd.shuffle must be a constant
import * as Simd from "std/simd"

const REVERSED = 3

function pick(values: F32x4, lane: int): F32x4 {
  return Simd.shuffle(values, [lane, 0, 1, 2])
}

export function run(_args: Array<string>): int {
  const values: F32x4 = [1.0, 2.0, 3.0, 4.0]
  const named = Simd.shuffle(values, [REVERSED, 2, 1, 0])
  const outside = Simd.shuffle(values, [4, 2, 1, 0])
  const short = Simd.shuffle(values, [2, 1, 0])
  const lanes = [3, 2, 1, 0]
  const notLiteral = Simd.shuffle(values, lanes)
  print(Show.show(pick(named, 1)))
  return 0
}
