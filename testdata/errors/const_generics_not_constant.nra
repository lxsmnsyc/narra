// error: constant parameter N takes an integer literal or a constant parameter, found `count`
import * as Arrays from "std/array"

struct Vector<const N: int> {
  values: Array<f64>
}

function wrong<T>(_vector: Vector<T>): int {
  return 0
}

export function run(_args: Array<string>): int {
  const count = 3
  const sized: Vector<count> = Vector { values: [] }
  const typed: Vector<string> = Vector { values: [] }
  return Arrays.length(sized.values) + Arrays.length(typed.values)
}
