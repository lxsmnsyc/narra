import * as Int from "std/int"

struct M<T> {
  m: Option<Box<M<int>>>
  x: T
}

export function run(args: Array<string>): int {
  const inner: M<int> = M { m: None, x: 7 }
  const outer: M<string> = M { m: Some(Box.new(inner)), x: "hi" }
  print(outer.x)
  if (outer.m is Some(b)) {
    print(Int.toString(b.value.x))
  }
  return 0
}
