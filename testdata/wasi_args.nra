// The arguments after the program name, from `run` and from Env.args. Under
// wasmtime, `wasmtime run -W exceptions=y prog.wasm a b` prints 2 twice.
import * as Arrays from "std/array"
import * as Env from "std/env"
import * as Int from "std/int"
import * as Ranges from "std/range"

export function run(args: Array<string>): int uses io, alloc {
  const fromEnv = Env.args()
  print(`run: ${Int.toString(Arrays.length(args) - 1)}`)
  print(`env: ${Int.toString(Arrays.length(fromEnv) - 1)}`)
  for (const index of Ranges.between(1, Arrays.length(args))) {
    print(`arg ${args[index]} ${fromEnv[index]}`)
  }
  return 0
}
