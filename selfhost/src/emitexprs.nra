// Expressions, calls of user functions, the prelude, Array and Box builtins
// and top-level constant reads (emit_expr.go, emit_call.go, emit_const.go
// constRef and staticConst, std_prelude.go, std_array.go, std_box.go).
// The owner is selfhost-emit-bodies. The module has one arm per expression kind
// and one line per dispatch to a feature module (contracts/emitter.md).
//
// Every function that emits code returns a Code: the C text and whether it
// is an owned temporary. Rules from Go: evaluate in source order, hand every
// owned value to consume, and read the emitter's tables before a call that
// passes `mutable emitter` (Narra rejects both in one call).
import { substring } from "narrac/textops"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Char from "std/char"
import { Expr, Stmt, Block, Arg, Pos, FieldInit } from "narrac/ast"
import { Type, isInteger, isSizedInteger } from "narrac/types"
import {
  Checker,
  Ref,
  ProgramFunc,
  getExpressionId,
  findBody,
  getExpressionPos,
  findBodySlot,
  orderArguments,
  findParameterIndexes,
} from "narrac/check"
import { cachedCType, cachedTypeId, cachedFunctionName, cachedDeclName } from "narrac/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  TempVar,
  reportUnsupported,
  writeLine,
  literal,
  where,
  temp,
  ownedTemp,
  consume,
  retainCode,
  beginStatement,
  endStatement,
  needsRc,
  readNodeType,
  readNodeRef,
  findSyntheticCode,
  readLocal,
  localRef,
  isReference,
  passArgument,
  switchBody,
  underlyingType,
  localName,
  declareVariable,
  variableRef,
  buildVariantFieldPath,
  noteReference,
  useHelper,
} from "narrac/emitstate"
import * as Decls from "narrac/emitdecls"
import * as Maps from "narrac/emitmaps"
import * as Closures from "narrac/emitclosures"
import * as Inline from "narrac/emitinline"
import { isInlineFunction } from "narrac/inlining"
import * as StdValues from "narrac/stdvalues"
import * as Traits from "narrac/emittraits"
import * as Dynamic from "narrac/emitdynamic"
import * as Match from "narrac/emitmatch"
import * as Std from "narrac/emitstd"
import * as Options from "narrac/emitoptions"
import * as Fixed from "narrac/emitfixed"
import { emitCopyCall } from "narrac/stdcopy"
import * as StdHelp from "narrac/stdemithelp"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

const NODE = "selfhost-emit-bodies"

function plain(text: string): Code {
  return Code { text: text, owned: false }
}

function unsupportedCode(mutable emitter: Emitter, construct: string): Code uses alloc {
  return plain(reportUnsupported(mutable emitter, construct, NODE))
}

export function emitExpression<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  if (emitter.heldPending > 0) {
    const expressionId = getExpressionId(expression)
    if (emitter.heldArguments[expressionId] is Some(held)) {
      if (held.text != "") {
        emitter.heldArguments[expressionId] = plain("")
        emitter.heldPending--
        return copy(held)
      }
    }
  }
  return match (expression) {
    Expr.IntLit(nodeId, _, text) => plain(typedIntegerCode(emitter, nodeId, text))
    Expr.FloatLit(nodeId, _, text) => plain(floatLiteralCode(emitter, nodeId, text))
    Expr.StringLit(_, _, value, _) => plain(literal(mutable emitter, value))
    Expr.CharLit(_, _, value) => plain(`${Int.toString(Char.code(Str.charAt(value, 0)))}U`)
    Expr.BoolLit(_, _, value) => plain(boolText(value))
    Expr.TemplateLit(_, _, parts) => emitTemplate(walker, mutable emitter, parts)
    Expr.Ident(nodeId, _, _) => emitIdent(walker, mutable emitter, expression, nodeId)
    Expr.FieldExpr(nodeId, _, target, name) => emitFieldRead(
      walker,
      mutable emitter,
      expression,
      nodeId,
      target,
      name,
    )
    Expr.IndexExpr(_, pos, target, index) => emitIndexRead(
      walker,
      mutable emitter,
      expression,
      pos,
      target,
      index,
    )
    Expr.UnaryExpr(nodeId, _, operator, operand) => emitUnary(
      walker,
      mutable emitter,
      nodeId,
      operator,
      operand,
    )
    Expr.BinaryExpr(_, _, operator, left, right) => emitBinary(
      walker,
      mutable emitter,
      expression,
      operator,
      left,
      right,
    )
    Expr.IsExpr(_, _, _, _) => Match.emitIsCondition(walker, mutable emitter, expression)
    Expr.CallExpr(nodeId, pos, _, _, arguments) => emitCall(
      walker,
      mutable emitter,
      expression,
      nodeId,
      pos,
      arguments,
    )
    Expr.StructLit(nodeId, _, _, _, fields, spread) => emitStructLiteral(
      walker,
      mutable emitter,
      expression,
      nodeId,
      fields,
      spread,
    )
    Expr.ArrayLit(nodeId, _, elements, isTuple) => emitArrayLiteral(
      walker,
      mutable emitter,
      expression,
      nodeId,
      elements,
      isTuple,
    )
    Expr.MapLit(_, _, _, _, _) => Maps.emitMapLiteral(walker, mutable emitter, expression)
    Expr.MatchExpr(_, _, _, _) => Match.emitMatchValue(walker, mutable emitter, expression)
    Expr.BlockExpr(nodeId, _, block) => emitBlockExpression(walker, mutable emitter, nodeId, block)
    Expr.ArrowExpr(_, _, _, _, _, _) => Closures.emitArrow(walker, mutable emitter, expression)
  }
}

function emitBlockExpression<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  block: Block,
): Code uses alloc {
  const resultType = copy(readNodeType(emitter, nodeId))
  return Match.emitBlockBody(walker, mutable emitter, block, resultType)
}

function boolText(value: bool): string {
  if (value) {
    return "true"
  }
  return "false"
}

function parseIntegerText(text: string): int uses alloc {
  // Accepts a base prefix (0x, 0b, 0o, or a leading 0 for octal) and `_`
  // between numerals. A text that does not parse gives 0; the checker rejects
  // those.
  let base = 10
  let numerals = text
  if (Str.length(text) >= 1 && Str.startsWith(text, "0")) {
    if (Str.length(text) >= 3 && (Str.startsWith(text, "0x") || Str.startsWith(text, "0X"))) {
      base = 16
      numerals = Str.sliceFrom(text, 2)
    } else if (
      Str.length(text) >= 3 && (Str.startsWith(text, "0b") || Str.startsWith(text, "0B"))
    ) {
      base = 2
      numerals = Str.sliceFrom(text, 2)
    } else if (
      Str.length(text) >= 3 && (Str.startsWith(text, "0o") || Str.startsWith(text, "0O"))
    ) {
      base = 8
      numerals = Str.sliceFrom(text, 2)
    } else {
      base = 8
      numerals = Str.sliceFrom(text, 1)
    }
  }
  const joined = Str.replace(numerals, "_", "")
  if (joined == "") {
    return 0
  }
  const parsed = Int.parse(joined, base)
  if (parsed is Ok(value)) {
    return value
  }
  // A u64 above int's maximum: keep the low 64 bits, so the cast to uint64_t
  // gives the value back.
  let wrapped = 0
  for (const index of Ranges.between(0, Str.length(joined))) {
    if (Int.parse(substring(joined, index, index + 1), base) is Ok(digit)) {
      wrapped = wrapped * base + digit
    }
  }
  return wrapped
}

function typedIntegerCode(emitter: Emitter, nodeId: int, text: string): string uses alloc {
  const type = readNodeType(emitter, nodeId)
  if (isSizedInteger(type)) {
    return `((${cachedCType(emitter.checker, emitter.typeNames, type)})${integerCode(text)})`
  }
  return integerCode(text)
}

function integerCode(text: string): string uses alloc {
  const value = parseIntegerText(text)
  if (value == -9223372036854775807 - 1) {
    return "INT64_MIN"
  }
  return `INT64_C(${Int.toString(value)})`
}

function emitTemplate<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  parts: Array<Expr>,
): Code uses alloc {
  if (Arrays.length(parts) == 0) {
    return plain(literal(mutable emitter, ""))
  }
  // A later part that may assign a variable forces each earlier part into a
  // temporary now, to keep the written order.
  let last = -1
  for (const index of Ranges.between(0, Arrays.length(parts))) {
    if (mayWrite(emitter, parts[index])) {
      last = index
    }
  }
  for (const index of Ranges.between(0, last)) {
    holdArgument(walker, mutable emitter, parts[index])
  }
  const first = EmitWalker.emitExpression(walker, mutable emitter, parts[0])
  if (Arrays.length(parts) == 1) {
    return first
  }
  // Collect every part, then join them in one runtime call
  let texts = first.text
  for (const index of Ranges.between(1, Arrays.length(parts))) {
    const next = EmitWalker.emitExpression(walker, mutable emitter, parts[index])
    texts = `${texts}, ${next.text}`
  }
  const count = Int.toString(Arrays.length(parts))
  const joined = `lstr_concat_n(${count}, (lstr*[]){${texts}})`
  return Code { text: ownedTemp(mutable emitter, Type.TStr, joined), owned: true }
}

function containerStruct(emitter: Emitter, type: Type): string uses alloc {
  const name = cachedCType(emitter.checker, emitter.typeNames, type)
  return substring(name, 0, Str.length(name) - 1)
}

function constructorValue(emitter: Emitter, enumIndex: int, variant: int): string uses alloc {
  const enumName = cachedCType(emitter.checker, emitter.typeNames, Type.TEnum(enumIndex))
  return `((${enumName}){.tag = ${Int.toString(variant)}})`
}

function emitIdent<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  nodeId: int,
): Code uses alloc {
  if (findSyntheticCode(emitter, nodeId) is Some(synthetic)) {
    return plain(synthetic)
  }
  const ref = readNodeRef(emitter, nodeId)
  return match (ref) {
    Ref.Local(index) => plain(localRef(emitter, index))
    Ref.Const(index) => plain(constRef(mutable emitter, index))
    Ref.Constructor(enumIndex, variant) => plain(constructorValue(emitter, enumIndex, variant))
    Ref.Function(_) => Closures.emitFuncValue(walker, mutable emitter, expression)
    Ref.Builtin(index) => StdValues.emitStdFunctionValue(
      walker,
      mutable emitter,
      getExpressionPos(expression),
      nodeId,
      index,
    )
    Ref.ConstantParameter(value, false) => plain(writeConstantParameter(value))
    _ => unsupportedCode(mutable emitter, "name")
  }
}

function writeConstantParameter(value: int): string uses alloc {
  // An instance writes the value of its constant type parameter.
  if (value == -9223372036854775807 - 1) {
    return "INT64_MIN"
  }
  return `INT64_C(${Int.toString(value)})`
}

function emitFieldRead<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  nodeId: int,
  target: Expr,
  name: string,
): Code uses alloc {
  const ref = readNodeRef(emitter, nodeId)
  if (ref is Ref.Const(index)) {
    return plain(constRef(mutable emitter, index))
  }
  if (ref is Ref.Function(_)) {
    return Closures.emitFuncValue(walker, mutable emitter, expression)
  }
  if (ref is Ref.Builtin(index)) {
    return StdValues.emitStdFunctionValue(
      walker,
      mutable emitter,
      getExpressionPos(expression),
      nodeId,
      index,
    )
  }
  if (ref is Ref.Constructor(enumIndex, variant)) {
    return plain(constructorValue(emitter, enumIndex, variant))
  }
  const targetCode = EmitWalker.emitExpression(walker, mutable emitter, target)
  if (ref is Ref.Narrow(enumIndex, variantIndex)) {
    const variantName = emitter.checker.enums[enumIndex].variants[variantIndex].name
    return plain(
      buildVariantFieldPath(emitter, enumIndex, variantName, name, `(${targetCode.text})`),
    )
  }
  if (readNodeType(emitter, getExpressionId(target)) is Type.TBox(_)) {
    return plain(`(${targetCode.text})->f_${name}`)
  }
  return plain(`(${targetCode.text}).f_${name}`)
}

function emitIndexRead<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  pos: Pos,
  target: Expr,
  index: Expr,
): Code uses alloc {
  const targetType = copy(readNodeType(emitter, getExpressionId(target)))
  if (targetType is Type.TMap(_, _)) {
    return Maps.emitMapGet(walker, mutable emitter, expression)
  }
  if (targetType is Type.TFixedArray(_, _)) {
    return Fixed.emitFixedRead(walker, mutable emitter, target, index)
  }
  if (targetType is Type.TArray(element)) {
    const targetCode = EmitWalker.emitExpression(walker, mutable emitter, target)
    const indexCode = EmitWalker.emitExpression(walker, mutable emitter, index)
    const arrayStruct = containerStruct(emitter, targetType)
    const position = where(emitter, pos)
    const getHelper = useHelper(emitter, arrayStruct, "get")
    const read = temp(
      mutable emitter,
      element,
      `${getHelper}(${targetCode.text}, ${indexCode.text}, ${position})`,
    )
    return plain(read)
  }
  return unsupportedCode(mutable emitter, "index")
}

function emitUnary<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  operator: string,
  operand: Expr,
): Code uses alloc {
  const value = EmitWalker.emitExpression(walker, mutable emitter, operand).text
  if (operator == "-") {
    const operandType = copy(readNodeType(emitter, nodeId))
    if (operandType == Type.TInt) {
      return plain(temp(mutable emitter, Type.TInt, `narra_wrap_neg(${value})`))
    }
    if (isSizedInteger(operandType)) {
      const cName = cachedCType(emitter.checker, emitter.typeNames, operandType)
      // A negated literal is written whole, so -128 is a valid i8.
      if (operand is Expr.IntLit(_, _, literalText)) {
        return plain(`((${cName})(-${integerCode(literalText)}))`)
      }
      const suffix = cachedTypeId(emitter.checker, emitter.typeNames, operandType)
      return plain(temp(mutable emitter, operandType, `narra_wrap_neg_${suffix}(${value})`))
    }
    return plain(`(-${value})`)
  }
  if (operator == "!") {
    return plain(`(!${value})`)
  }
  if (operator == "~") {
    const operandType = readNodeType(emitter, nodeId)
    if (isSizedInteger(operandType)) {
      return plain(`((${cachedCType(emitter.checker, emitter.typeNames, operandType)})(~${value}))`)
    }
    return plain(`(~${value})`)
  }
  return unsupportedCode(mutable emitter, "unary operator")
}

function checkedFunction(operator: string): string {
  if (operator == "/") {
    return "narra_div"
  }
  if (operator == "%") {
    return "narra_rem"
  }
  if (operator == "<<") {
    return "narra_shl"
  }
  if (operator == ">>") {
    return "narra_shr"
  }
  return ""
}

function wrappingFunction(operator: string): string {
  if (operator == "+") {
    return "narra_wrap_add"
  }
  if (operator == "-") {
    return "narra_wrap_sub"
  }
  if (operator == "*") {
    return "narra_wrap_mul"
  }
  return ""
}

function isPrimitive(type: Type): bool {
  return match (type) {
    Type.TStruct(_)
      | Type.TEnum(_)
      | Type.TArray(_)
      | Type.TFixedArray(_, _)
      | Type.TBox(_)
      | Type.TMap(_, _)
      | Type.TFunc(_, _, _, _, _) => false
    _ => true
  }
}

function emitBinary<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  operator: string,
  left: Expr,
  right: Expr,
): Code uses alloc {
  // && and || evaluate the right side only when needed.
  if (operator == "&&" || operator == "||") {
    const leftCode = EmitWalker.emitExpression(walker, mutable emitter, left)
    const result = temp(mutable emitter, Type.TBool, leftCode.text)
    if (operator == "&&") {
      writeLine(mutable emitter, `if (${result}) {`)
    } else {
      writeLine(mutable emitter, `if (!${result}) {`)
    }
    emitter.indent++
    beginStatement(mutable emitter)
    const rightCode = EmitWalker.emitExpression(walker, mutable emitter, right)
    writeLine(mutable emitter, `${result} = ${rightCode.text};`)
    endStatement(mutable emitter)
    emitter.indent--
    writeLine(mutable emitter, "}")
    return plain(result)
  }

  // Equality of structs, enums and arrays is the traits module's.
  const leftType = copy(underlyingType(emitter, readNodeType(emitter, getExpressionId(left))))
  if (!isPrimitive(leftType) && (operator == "==" || operator == "!=")) {
    return Traits.emitEquality(walker, mutable emitter, expression)
  }
  const leftCode = EmitWalker.emitExpression(walker, mutable emitter, left)
  const rightCode = EmitWalker.emitExpression(walker, mutable emitter, right)
  const leftText = leftCode.text
  const rightText = rightCode.text
  if (leftType == Type.TStr || leftType == Type.TBytes) {
    if (operator == "==") {
      return plain(`lstr_eq(${leftText}, ${rightText})`)
    }
    if (operator == "!=") {
      return plain(`(!lstr_eq(${leftText}, ${rightText}))`)
    }
    return plain(`(lstr_cmp(${leftText}, ${rightText}) ${operator} 0)`)
  }
  return emitArithmetic(mutable emitter, operator, leftType, leftText, rightText)
}

export function emitArithmetic(
  mutable emitter: Emitter,
  operator: string,
  operandType: Type,
  leftText: string,
  rightText: string,
): Code uses alloc {
  if (isInteger(operandType)) {
    // A sized integer has its own functions, named with the type.
    let suffix = ""
    if (operandType != Type.TInt) {
      suffix = `_${cachedTypeId(emitter.checker, emitter.typeNames, operandType)}`
    }
    const checked = checkedFunction(operator)
    if (checked != "") {
      const call = `${checked}${suffix}(${leftText}, ${rightText})`
      return plain(temp(mutable emitter, operandType, call))
    }
    // Overflow wraps at the type's width in every build.
    const wrapping = wrappingFunction(operator)
    if (wrapping != "") {
      const call = `${wrapping}${suffix}(${leftText}, ${rightText})`
      return plain(temp(mutable emitter, operandType, call))
    }
  }
  if (operandType == Type.TF64 && operator == "%") {
    return plain(`fmod(${leftText}, ${rightText})`)
  }
  if (operandType == Type.TF32 && operator == "%") {
    return plain(`fmodf(${leftText}, ${rightText})`)
  }
  return plain(`(${leftText} ${operator} ${rightText})`)
}

function emitCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  // Named arguments in another order than the parameters are evaluated as
  // written, then passed in parameter order.
  if (emitter.checker.argumentOrders[nodeId] is Some(_)) {
    holdReorderedArguments(walker, mutable emitter, nodeId, arguments)
  } else {
    holdEarlierArguments(walker, mutable emitter, arguments)
  }
  const ordered = orderArguments(emitter.checker, nodeId, arguments)
  const ref = readNodeRef(emitter, nodeId)
  return match (ref) {
    Ref.Distinct(_) => EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
    Ref.Constructor(enumIndex, variant) => emitConstructorCall(
      walker,
      mutable emitter,
      enumIndex,
      variant,
      arguments,
    )
    Ref.TraitFunction(_, _) => Traits.emitTraitCall(walker, mutable emitter, expression)
    Ref.Value => Inline.emitInlineValueCall(walker, mutable emitter, expression)
    Ref.Builtin(index) => emitBuiltinCall(
      walker,
      mutable emitter,
      expression,
      pos,
      arguments,
      index,
    )
    Ref.Implementation(block, index) => emitFunctionCall(
      walker,
      mutable emitter,
      ProgramFunc.ImplFunc(block, index),
      ordered,
    )
    Ref.Function(funcIndex) => emitPlainOrInstanceCall(
      walker,
      mutable emitter,
      nodeId,
      funcIndex,
      ordered,
    )
    Ref.Unresolved => Dynamic.emitDynamicCall(walker, mutable emitter, expression, ordered)
    _ => unsupportedCode(mutable emitter, "call")
  }
}

function floatLiteralCode(emitter: Emitter, nodeId: int, text: string): string uses alloc {
  if (readNodeType(emitter, nodeId) == Type.TF32) {
    return `${text}f`
  }
  return text
}

function mayWrite(emitter: Emitter, expression: Expr): bool uses alloc {
  // Block expressions, matches and calls that run a closure can assign; plain
  // reads, operators, arrows (their body runs later) and calls with
  // side-effect-free arguments cannot.
  return match (expression) {
    Expr.IntLit(_, _, _)
      | Expr.FloatLit(_, _, _)
      | Expr.StringLit(_, _, _, _)
      | Expr.CharLit(_, _, _)
      | Expr.BoolLit(_, _, _)
      | Expr.Ident(_, _, _) => false
    Expr.TemplateLit(_, _, parts) => anyMayWrite(emitter, parts)
    Expr.FieldExpr(_, _, target, _) => mayWrite(emitter, target)
    Expr.IsExpr(_, _, subject, _) => mayWrite(emitter, subject)
    Expr.IndexExpr(_, _, target, index) => mayWrite(emitter, target) || mayWrite(emitter, index)
    Expr.UnaryExpr(_, _, _, operand) => mayWrite(emitter, operand)
    Expr.BinaryExpr(_, _, _, left, right) => mayWrite(emitter, left) || mayWrite(emitter, right)
    Expr.ArrayLit(_, _, elements, _) => anyMayWrite(emitter, elements)
    Expr.MapLit(_, _, _, keys, values) => anyMayWrite(emitter, keys) || anyMayWrite(emitter, values)
    Expr.StructLit(_, _, _, _, fields, spread) => structMayWrite(emitter, fields, spread)
    Expr.CallExpr(nodeId, _, _, _, arguments) => callMayWrite(emitter, nodeId, arguments)
    Expr.ArrowExpr(_, _, _, _, _, _) => false
    _ => true
  }
}

function anyMayWrite(emitter: Emitter, list: Array<Expr>): bool uses alloc {
  for (const item of Arrays.values(list)) {
    if (mayWrite(emitter, item)) {
      return true
    }
  }
  return false
}

function structMayWrite(
  emitter: Emitter,
  fields: Array<FieldInit>,
  spread: Option<Expr>,
): bool uses alloc {
  if (spread is Some(spreadExpression)) {
    if (mayWrite(emitter, spreadExpression)) {
      return true
    }
  }
  for (const field of Arrays.values(fields)) {
    if (mayWrite(emitter, field.value)) {
      return true
    }
  }
  return false
}

function callMayWrite(emitter: Emitter, nodeId: int, arguments: Array<Arg>): bool uses alloc {
  if (readNodeRef(emitter, nodeId) is Ref.Value) {
    return true
  }
  for (const argument of Arrays.values(arguments)) {
    if (mayWrite(emitter, argument.value)) {
      return true
    }
  }
  return false
}

function holdEarlierArguments<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
) uses alloc {
  // A later argument that may assign a variable forces each earlier argument
  // into a temporary now, to keep the written order. Calls without such an
  // argument emit the same code as before.
  let last = -1
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    if (!arguments[index].isMutable && mayWrite(emitter, arguments[index].value)) {
      last = index
    }
  }
  for (const index of Ranges.between(0, last)) {
    if (!arguments[index].isMutable) {
      holdArgument(walker, mutable emitter, arguments[index].value)
    }
  }
}

function holdReorderedArguments<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
) uses alloc {
  // An argument needs a temporary when an argument written after it is passed
  // before it, or when a later argument may assign a variable. Every argument
  // written before the last one that needs a temporary is held too, so it still
  // runs first.
  const count = Arrays.length(arguments)
  const parameterIndexes = findParameterIndexes(emitter.checker, nodeId, count)
  let last = -1
  for (const index of Ranges.between(0, count)) {
    if (!arguments[index].isMutable && mayWrite(emitter, arguments[index].value)) {
      last = index
    }
  }
  // the last written argument that a later-written one is passed before
  for (const index of Ranges.between(0, count)) {
    for (const later of Ranges.between(index + 1, count)) {
      if (parameterIndexes[later] < parameterIndexes[index] && index + 1 > last) {
        last = index + 1
      }
    }
  }
  for (const index of Ranges.between(0, last)) {
    if (!arguments[index].isMutable) {
      holdArgument(walker, mutable emitter, arguments[index].value)
    }
  }
}

function isStableArgument(emitter: Emitter, value: Expr, nodeId: int): bool {
  return match (value) {
    Expr.IntLit(_, _, _)
      | Expr.FloatLit(_, _, _)
      | Expr.StringLit(_, _, _, _)
      | Expr.CharLit(_, _, _)
      | Expr.BoolLit(_, _, _) => true
    Expr.Ident(_, _, _) => !(readNodeRef(emitter, nodeId) is Ref.Local(_))
    _ => false
  }
}

function holdArgument<W: EmitWalker>(walker: W, mutable emitter: Emitter, value: Expr) uses alloc {
  const nodeId = getExpressionId(value)
  if (isStableArgument(emitter, value, nodeId)) {
    return
  }
  const valueType = copy(readNodeType(emitter, nodeId))
  if (valueType is Type.TFunc(_, _, _, _, _)) {
    return
  }
  const code = EmitWalker.emitExpression(walker, mutable emitter, value)
  let held = code
  if (!code.owned) {
    // Keep the value this argument read, even if the variable changes.
    const name = temp(mutable emitter, valueType, code.text)
    held = plain(name)
    if (needsRc(emitter, valueType)) {
      const retainText = retainCode(emitter, valueType, name)
      writeLine(mutable emitter, retainText)
      const top = Arrays.length(emitter.frames) - 1
      Arrays.push(mutable emitter.frames[top], TempVar { name: name, tempType: valueType })
      held = Code { text: name, owned: true }
    }
  }
  emitter.heldArguments[nodeId] = held
  emitter.heldPending++
}

function emitConstructorCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  enumIndex: int,
  variant: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const enumType = Type.TEnum(enumIndex)
  const fields = copy(emitter.checker.enums[enumIndex].variants[variant].fields)
  let parts: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, arguments[index].value)
    const fieldType = fields[index].fieldType
    const consumed = consume(mutable emitter, code.text, code.owned, fieldType)
    Arrays.push(mutable parts, consumed)
  }
  const allocated = Decls.enumAllocation(mutable emitter, enumType, variant, parts)
  const name = ownedTemp(mutable emitter, enumType, allocated.text)
  return Code { text: name, owned: true }
}

function emitPlainOrInstanceCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  funcIndex: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const info = copy(emitter.checker.bodies[emitter.body])
  let program = ProgramFunc.PlainFunc(funcIndex)
  if (info.instanceRefs[nodeId] is Some(instance)) {
    program = ProgramFunc.InstanceFunc(instance)
  } else if (Arrays.length(emitter.checker.functions[funcIndex].typeParameters) > 0) {
    return unsupportedCode(mutable emitter, "generic call without an instance")
  }
  if (isInlineFunction(emitter.checker, funcIndex)) {
    return Inline.emitInlineCall(walker, mutable emitter, program, arguments)
  }
  return emitFunctionCall(walker, mutable emitter, program, arguments)
}

function emitFunctionCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  program: ProgramFunc,
  arguments: Array<Arg>,
): Code uses alloc {
  const checker = copy(emitter.checker)
  let parameterMutable: Array<bool> = []
  let parameterTypes: Array<Type> = []
  let result = Type.TVoid
  match (program) {
    ProgramFunc.PlainFunc(funcIndex) => {
      for (const parameter of Arrays.values(checker.functions[funcIndex].declaration.parameters)) {
        Arrays.push(mutable parameterMutable, parameter.isMutable)
        Arrays.push(mutable parameterTypes, checker.paramTypes[parameter.id])
      }
      result = checker.functions[funcIndex].result
    }
    ProgramFunc.InstanceFunc(instance) => {
      const funcIndex = checker.instanceList[instance].funcIndex
      for (const parameter of Arrays.values(checker.functions[funcIndex].declaration.parameters)) {
        Arrays.push(mutable parameterMutable, parameter.isMutable)
      }
      parameterTypes = copy(checker.instanceList[instance].parameters)
      result = checker.instanceList[instance].result
    }
    ProgramFunc.ImplFunc(block, index) => {
      for (const parameter of Arrays.values(
        checker.implementations[block].functions[index].declaration.parameters,
      )) {
        Arrays.push(mutable parameterMutable, parameter.isMutable)
        Arrays.push(mutable parameterTypes, checker.paramTypes[parameter.id])
      }
      result = checker.implementations[block].functions[index].result
    }
  }
  let texts: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    if (parameterMutable[index]) {
      const pointer = EmitWalker.emitLvaluePointer(walker, mutable emitter, arguments[index].value)
      Arrays.push(mutable texts, pointer)
    } else {
      const code = EmitWalker.emitExpression(walker, mutable emitter, arguments[index].value)
      const text = passArgument(mutable emitter, parameterTypes[index], code.text)
      Arrays.push(mutable texts, text)
    }
  }
  const calleeName = cachedFunctionName(checker, emitter.typeNames, program)
  noteReference(mutable emitter, calleeName)
  const callCode = `${calleeName}(${Str.join(texts, ", ")})`
  if (result == Type.TVoid) {
    return plain(callCode)
  }
  const name = ownedTemp(mutable emitter, result, callCode)
  return Code { text: name, owned: true }
}

function emitBuiltinCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  pos: Pos,
  arguments: Array<Arg>,
  builtinIndex: int,
): Code uses alloc {
  const builtin = copy(emitter.checker.registry.functions[builtinIndex])
  const module = builtin.module
  if (module == "") {
    return emitPreludeCall(walker, mutable emitter, builtin.name, pos, arguments)
  }
  if (module == "std/array") {
    return emitArrayCall(walker, mutable emitter, expression, builtin.name, pos, arguments)
  }
  if (module == "std/box") {
    return emitBoxCall(walker, mutable emitter, expression, arguments)
  }
  if (module == "std/range") {
    // A Range value is its two bounds. A for loop reads the bounds of a direct call itself.
    if (builtin.name == "Range.upTo") {
      const upperBound = EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
      const onlyHigh = temp(mutable emitter, Type.TInt, upperBound.text)
      return plain(`((narra_range){0, ${onlyHigh}, 1})`)
    }
    if (builtin.name == "Range.stepped") {
      return StdHelp.emitOptionOut(
        walker,
        mutable emitter,
        getExpressionId(expression),
        arguments,
        "narra_range_stepped",
        Type.TRange,
        "((narra_range){0})",
      )
    }
    const lowerBound = EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
    const low = temp(mutable emitter, Type.TInt, lowerBound.text)
    const upperEnd = EmitWalker.emitExpression(walker, mutable emitter, arguments[1].value)
    const high = temp(mutable emitter, Type.TInt, upperEnd.text)
    return plain(`((narra_range){${low}, ${high}, 1})`)
  }
  if (module == "std/map") {
    return Maps.emitMapBuiltin(walker, mutable emitter, expression)
  }
  if (module == "std/result" || module == "std/test") {
    return Options.emitOptionCall(walker, mutable emitter, expression)
  }
  return Std.emitStdCall(walker, mutable emitter, expression)
}

function callArguments(expression: Expr): Array<Arg> from expression {
  if (expression is Expr.CallExpr(_, _, _, _, arguments)) {
    return arguments
  }
  return []
}

export function argumentCode<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  number: int,
): string uses alloc {
  const arguments = callArguments(expression)
  const code = EmitWalker.emitExpression(walker, mutable emitter, arguments[number].value)
  return code.text
}

function emitPreludeCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "copy") {
    return emitCopyCall(walker, mutable emitter, arguments)
  }
  const position = where(emitter, pos)
  const value = EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value).text
  if (name == "print") {
    return plain(`narra_print(${value})`)
  }
  if (name == "assert") {
    return plain(`narra_assert(${value}, ${position})`)
  }
  if (name == "panic") {
    return plain(`narra_panic_str(${value}, ${position})`)
  }
  return unsupportedCode(mutable emitter, "prelude function")
}

function emitArrayCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  name: string,
  _pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "Array.length") {
    const value = argumentCode(walker, mutable emitter, expression, 0)
    return plain(`(${value})->len`)
  }
  if (name == "Array.push") {
    const arrayType = copy(readNodeType(emitter, getExpressionId(arguments[0].value)))
    if (arrayType is Type.TArray(element)) {
      const code = EmitWalker.emitExpression(walker, mutable emitter, arguments[1].value)
      const consumed = consume(mutable emitter, code.text, code.owned, element)
      const pointer = EmitWalker.emitLvaluePointer(walker, mutable emitter, arguments[0].value)
      const pushHelper = useHelper(emitter, containerStruct(emitter, arrayType), "push")
      return plain(`${pushHelper}(${pointer}, ${consumed})`)
    }
  }
  if (name == "Array.withCapacity") {
    const arrayType = copy(readNodeType(emitter, getExpressionId(expression)))
    const capacity = argumentCode(walker, mutable emitter, expression, 0)
    const arrayStruct = containerStruct(emitter, arrayType)
    // The capacity is a hint: a negative one reserves nothing and a huge one is cut to 2^20.
    const reserved = temp(mutable emitter, Type.TInt, capacity)
    const newHelper = useHelper(emitter, arrayStruct, "new")
    const created = ownedTemp(
      mutable emitter,
      arrayType,
      `${newHelper}(${reserved} < 0 ? 0 : (${reserved} > 1048576 ? 1048576 : ${reserved}))`,
    )
    return Code { text: created, owned: true }
  }
  if (name == "Array.filled") {
    return emitArrayFilled(walker, mutable emitter, expression)
  }
  return unsupportedCode(mutable emitter, "array function")
}

function emitBoxCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  arguments: Array<Arg>,
): Code uses alloc {
  const boxType = copy(readNodeType(emitter, getExpressionId(expression)))
  if (boxType is Type.TBox(element)) {
    const code = EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
    const consumed = consume(mutable emitter, code.text, code.owned, element)
    const boxStruct = containerStruct(emitter, boxType)
    const newHelper = useHelper(emitter, boxStruct, "new")
    const created = ownedTemp(mutable emitter, boxType, `${newHelper}(${consumed})`)
    return Code { text: created, owned: true }
  }
  return unsupportedCode(mutable emitter, "box function")
}

function qualifiedName(module: string, name: string): string uses alloc {
  if (module != "") {
    return `${module}.${name}`
  }
  return name
}

function defaultBodyKey(checker: Checker, structIndex: int, field: string): string uses alloc {
  // A generic struct has one default body shared by its instances, so the key
  // uses the declaration's module and name only.
  const info = checker.structs[structIndex]
  return `default|${qualifiedName(info.module, info.name)}|${field}`
}

function emitStructLiteral<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  nodeId: int,
  fields: Array<FieldInit>,
  spread: Option<Expr>,
): Code uses alloc {
  if (spread is Some(_)) {
    return Match.emitSpreadLiteral(walker, mutable emitter, expression)
  }
  const structType = copy(readNodeType(emitter, nodeId))
  if (structType is Type.TStruct(structIndex)) {
    let parts: Array<string> = []
    let given: Map<string, bool> = Map {}
    // The fields written in the literal, in source order.
    for (const field of Arrays.values(fields)) {
      const code = EmitWalker.emitExpression(walker, mutable emitter, field.value)
      const fieldType = copy(readNodeType(emitter, getExpressionId(field.value)))
      const consumed = consume(mutable emitter, code.text, code.owned, fieldType)
      Arrays.push(mutable parts, `.f_${field.name} = ${consumed}`)
      given[field.name] = true
    }
    // The rest take their default, which is emitted inside the default's body.
    for (const declared of Arrays.values(copy(emitter.checker.structs[structIndex].fields))) {
      if (given[declared.name] is Some(_)) {
        continue
      }
      if (declared.default is Some(defaultValue)) {
        const key = defaultBodyKey(emitter.checker, structIndex, declared.name)
        const body = findBody(emitter.checker, key)
        if (body < 0) {
          return unsupportedCode(mutable emitter, "field default body")
        }
        const saved = switchBody(mutable emitter, body)
        const code = EmitWalker.emitExpression(walker, mutable emitter, defaultValue)
        const consumed = consume(mutable emitter, code.text, code.owned, declared.fieldType)
        emitter.body = saved
        Arrays.push(mutable parts, `.f_${declared.name} = ${consumed}`)
      }
    }
    const structName = cachedCType(emitter.checker, emitter.typeNames, structType)
    const built = ownedTemp(
      mutable emitter,
      structType,
      `((${structName}){${Str.join(parts, ", ")}})`,
    )
    return Code { text: built, owned: true }
  }
  return unsupportedCode(mutable emitter, "struct literal")
}

function emitArrayLiteral<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
  nodeId: int,
  elements: Array<Expr>,
  isTuple: bool,
): Code uses alloc {
  if (isTuple) {
    return Match.emitTupleLiteral(walker, mutable emitter, expression)
  }
  const arrayType = copy(readNodeType(emitter, nodeId))
  if (arrayType is Type.TFixedArray(_, _)) {
    return Fixed.emitFixedLiteral(walker, mutable emitter, nodeId, elements)
  }
  if (arrayType is Type.TArray(element)) {
    const arrayStruct = containerStruct(emitter, arrayType)
    const newHelper = useHelper(emitter, arrayStruct, "new")
    const array = ownedTemp(
      mutable emitter,
      arrayType,
      `${newHelper}(${Int.toString(Arrays.length(elements))})`,
    )
    for (const item of Arrays.values(elements)) {
      const code = EmitWalker.emitExpression(walker, mutable emitter, item)
      const consumed = consume(mutable emitter, code.text, code.owned, element)
      writeLine(mutable emitter, `${array}->items[${array}->len++] = ${consumed};`)
    }
    return Code { text: array, owned: true }
  }
  return unsupportedCode(mutable emitter, "array literal")
}

export function pointerTemp(mutable emitter: Emitter, type: Type, code: string): string uses alloc {
  emitter.tempCount++
  const name = `t${Int.toString(emitter.tempCount)}`
  const typeName = `${cachedCType(emitter.checker, emitter.typeNames, type)}*`
  const declaration = declareVariable(mutable emitter, typeName, name)
  writeLine(mutable emitter, `${declaration} = ${code};`)
  return variableRef(emitter, name)
}

export function emitLvaluePointer<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): string uses alloc {
  // Arrays on the path are made unique first by `_at`.
  return match (expression) {
    Expr.Ident(nodeId, _, _) => identPointer(mutable emitter, nodeId)
    Expr.FieldExpr(_, _, target, name) => fieldPointer(walker, mutable emitter, target, name)
    Expr.IndexExpr(_, pos, target, index) => indexPointer(
      walker,
      mutable emitter,
      pos,
      target,
      index,
    )
    _ => reportUnsupported(mutable emitter, "lvalue", NODE)
  }
}

function identPointer(mutable emitter: Emitter, nodeId: int): string uses alloc {
  const ref = readNodeRef(emitter, nodeId)
  if (ref is Ref.Local(index)) {
    const local = readLocal(emitter, index)
    // A mutable parameter or a captured let is already a pointer.
    if (isReference(emitter, index)) {
      return localName(local)
    }
    return `&${localRef(emitter, index)}`
  }
  return reportUnsupported(mutable emitter, "lvalue", NODE)
}

function fieldPointer<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  target: Expr,
  name: string,
): string uses alloc {
  const base = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
  const targetType = copy(readNodeType(emitter, getExpressionId(target)))
  // Writing through a box copies a shared cell first.
  if (targetType is Type.TBox(element)) {
    const boxStruct = containerStruct(emitter, targetType)
    const atHelper = useHelper(emitter, boxStruct, "at")
    return pointerTemp(mutable emitter, element, `${atHelper}(${base})`)
  }
  return `&(${base})->f_${name}`
}

function indexPointer<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  pos: Pos,
  target: Expr,
  index: Expr,
): string uses alloc {
  const arrayType = copy(readNodeType(emitter, getExpressionId(target)))
  if (arrayType is Type.TFixedArray(fixedElement, _)) {
    const fixedBase = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
    const fixedIndex = EmitWalker.emitExpression(walker, mutable emitter, index)
    const fixedIndexTemp = temp(mutable emitter, Type.TInt, fixedIndex.text)
    return pointerTemp(
      mutable emitter,
      fixedElement,
      Fixed.buildFixedPointer(fixedBase, fixedIndexTemp),
    )
  }
  if (arrayType is Type.TArray(element)) {
    const base = EmitWalker.emitLvaluePointer(walker, mutable emitter, target)
    const indexCode = EmitWalker.emitExpression(walker, mutable emitter, index)
    const indexTemp = temp(mutable emitter, Type.TInt, indexCode.text)
    const arrayStruct = containerStruct(emitter, arrayType)
    const position = where(emitter, pos)
    // An array made unique before the loop only needs its bounds checked.
    if (isHoistedArray(emitter, target)) {
      writeLine(mutable emitter, `narra_bounds(${indexTemp}, (*${base})->len, ${position});`)
      return pointerTemp(mutable emitter, element, `&(*${base})->items[${indexTemp}]`)
    }
    const atHelper = useHelper(emitter, arrayStruct, "at")
    return pointerTemp(mutable emitter, element, `${atHelper}(${base}, ${indexTemp}, ${position})`)
  }
  return reportUnsupported(mutable emitter, "lvalue", NODE)
}

function isHoistedArray(emitter: Emitter, target: Expr): bool {
  if (target is Expr.Ident(nodeId, _, _)) {
    if (readNodeRef(emitter, nodeId) is Ref.Local(index)) {
      for (const hoisted of Arrays.values(emitter.hoistedArrays)) {
        if (hoisted == index) {
          return true
        }
      }
    }
  }
  return false
}

export function declaredLocal(emitter: Emitter, nodeId: int): int {
  const info = emitter.checker.bodies[emitter.body]
  // Only a parameter, VarStmt or ForStmt node declares a local.
  const slot = findBodySlot(info, nodeId)
  if (slot < 0) {
    return -1
  }
  return info.declared[slot]
}

// Top-level constants. A constant whose value is a literal, an operator on
// constants or a fieldless constructor is emitted at each use (static). Any
// other constant is read through a getter.

function isStaticValue(emitter: Emitter, body: int, value: Expr): bool uses alloc {
  const info = emitter.checker.bodies[body]
  return match (value) {
    Expr.IntLit(_, _, _)
      | Expr.FloatLit(_, _, _)
      | Expr.StringLit(_, _, _, _)
      | Expr.CharLit(_, _, _)
      | Expr.BoolLit(_, _, _) => true
    Expr.TemplateLit(_, _, parts) => Arrays.length(parts) == 0
    Expr.Ident(nodeId, _, _) | Expr.FieldExpr(nodeId, _, _, _) => isStaticName(
      emitter,
      info.refs,
      info.first,
      nodeId,
    )
    Expr.UnaryExpr(_, _, _, operand) => isStaticValue(emitter, body, operand)
    Expr.BinaryExpr(_, _, _, left, right) =>
      isStaticValue(emitter, body, left) && isStaticValue(emitter, body, right)
    _ => false
  }
}

function isStaticName(
  emitter: Emitter,
  refs: Array<Ref>,
  first: int,
  nodeId: int,
): bool uses alloc {
  const slot = nodeId - first
  if (slot < 0 || slot >= Arrays.length(refs)) {
    return false
  }
  return match (refs[slot]) {
    Ref.Constructor(_, _) => true
    Ref.Const(index) => isStaticConstant(emitter, index)
    _ => false
  }
}

export function isStaticConstant(emitter: Emitter, constIndex: int): bool uses alloc {
  const body = findBody(emitter.checker, `const|${Int.toString(constIndex)}`)
  if (body < 0) {
    return false
  }
  return isStaticValue(emitter, body, emitter.checker.consts[constIndex].declaration.value)
}

// ConstWalker emits the expressions of a static constant. They have no
// statements, so only expressions are real.
struct ConstWalker implements EmitWalker {}

implement EmitWalker for ConstWalker {
  function emitExpression(
    walker: ConstWalker,
    mutable emitter: Emitter,
    expression: Expr,
  ): Code uses alloc {
    return emitExpression(walker, mutable emitter, expression)
  }

  function emitStatement(
    _walker: ConstWalker,
    mutable emitter: Emitter,
    _statement: Stmt,
  ) uses alloc {
    const _ = reportUnsupported(mutable emitter, "statement in a constant", NODE)
  }

  function emitBlock(
    _walker: ConstWalker,
    mutable emitter: Emitter,
    _block: Block,
    _loop: bool,
  ) uses alloc {
    const _ = reportUnsupported(mutable emitter, "block in a constant", NODE)
  }

  function emitBlockInScope(
    _walker: ConstWalker,
    mutable emitter: Emitter,
    _block: Block,
  ) uses alloc {
    const _ = reportUnsupported(mutable emitter, "block in a constant", NODE)
  }

  function emitLvaluePointer(
    walker: ConstWalker,
    mutable emitter: Emitter,
    expression: Expr,
  ): string uses alloc {
    return emitLvaluePointer(walker, mutable emitter, expression)
  }
}

export function constRef(mutable emitter: Emitter, constIndex: int): string uses alloc {
  // The value is borrowed. A static constant re-emits its value here, inside
  // its own body.
  const checker = copy(emitter.checker)
  const body = findBody(checker, `const|${Int.toString(constIndex)}`)
  if (body >= 0 && isStaticConstant(emitter, constIndex)) {
    const saved = switchBody(mutable emitter, body)
    const value = checker.consts[constIndex].declaration.value
    const code = EmitWalker.emitExpression(ConstWalker {}, mutable emitter, value)
    emitter.body = saved
    return code.text
  }
  const info = checker.consts[constIndex]
  const getter = cachedDeclName(emitter.typeNames, "g", info.module, info.name)
  noteReference(mutable emitter, getter)
  const constantType = constType(checker, constIndex)
  return temp(mutable emitter, constantType, `${getter}()`)
}

export function constType(checker: Checker, constIndex: int): Type from checker {
  const info = checker.consts[constIndex]
  if (info.valueType is Some(inferred)) {
    return inferred
  }
  if (info.declaredType is Some(declared)) {
    return declared
  }
  return Type.TVoid
}

function emitArrayFilled<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  const optionType = copy(readNodeType(emitter, getExpressionId(expression)))
  const some = StdHelp.findVariant(emitter, optionType, "Some")
  const none = StdHelp.findVariant(emitter, optionType, "None")
  const arrayType = copy(StdHelp.variantFieldType(emitter, optionType, some))
  const value = argumentCode(walker, mutable emitter, expression, 0)
  const count = argumentCode(walker, mutable emitter, expression, 1)
  const arrayStruct = containerStruct(emitter, arrayType)
  // A negative count has no array and the result is None.
  const filled = temp(mutable emitter, arrayType, "NULL")
  writeLine(mutable emitter, `if (${count} >= 0) {`)
  const filledHelper = useHelper(emitter, arrayStruct, "filled")
  writeLine(mutable emitter, `  ${filled} = ${filledHelper}(${value}, ${count});`)
  writeLine(mutable emitter, "}")
  return StdHelp.ioEither(
    mutable emitter,
    optionType,
    `${filled} != NULL`,
    some,
    [filled],
    none,
    [],
  )
}
