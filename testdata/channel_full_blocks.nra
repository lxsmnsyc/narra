// A channel of capacity 1 and a slow receiver: each send waits until the
// receiver has taken the value before, and the values arrive in order.
import * as Channel from "std/channel"
import * as Thread from "std/thread"
import * as Int from "std/int"
import * as Time from "std/time"

export function run(_args: Array<string>): int {
  const #[sender, receiver] = Channel.create<string>(1)
  const sent = Thread.scope((scope) => {
    const producer = Thread.start(scope, () => {
      let count = 0
      for (let i = 0; i < 20; i++) {
        if (Channel.send(sender, `value ${Int.toString(i)}`)) {
          count++
        }
      }
      Channel.close(sender)
      return count
    })
    let received = 0
    for (const value of Channel.values(receiver)) {
      if (received % 5 == 0) {
        Time.sleep(Time.milliseconds(2))
      }
      print(value)
      received++
    }
    print(`received ${Int.toString(received)}`)
    return Thread.join(producer)
  })
  print(`sent ${Int.toString(sent)}`)
  return 0
}
