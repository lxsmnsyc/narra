// A received value is fresh: Channel.receive moves it out of its slot, so a
// write to it does not hold the receiver, and an array that only the result
// holds changes in place (the debug copy check sees no copy).
import * as Channel from "std/channel"
import * as Arrays from "std/array"
import * as Int from "std/int"

export function run(_args: Array<string>): int {
  const #[sender, receiver] = Channel.create<Array<int>>(2)
  Channel.send(sender, [1, 2])
  Channel.send(sender, [3])
  let first: Array<int> = []
  if (Channel.receive(receiver) is Some(items)) {
    first = items
  }
  Arrays.push(mutable first, 9)
  print(Int.toString(Arrays.length(first)))
  if (Channel.receive(receiver) is Some(more)) {
    print(Int.toString(Arrays.length(more)))
  }
  return 0
}
