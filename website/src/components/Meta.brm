<script>
  import { $props } from 'brumate/signals';

  // The title, description and link preview of a page.
  const { title, description, path } = $props<{
    title: string;
    description: string;
    path: string;
  }>();
  const site = import.meta.env.SITE_URL;
  const url = `${site}/${path.replace(/^\//, '')}`;
  const image = `${site}/og.png`;
</script>

#head {
  <title>{title}</title>
  <meta name="description" content=description>
  <link rel="canonical" href=url>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Narra">
  <meta property="og:title" content=title>
  <meta property="og:description" content=description>
  <meta property="og:url" content=url>
  <meta property="og:image" content=image>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Narra">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content=title>
  <meta name="twitter:description" content=description>
  <meta name="twitter:image" content=image>
}
