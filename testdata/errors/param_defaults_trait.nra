trait Shape {
  function area(self: Self, scale: int = 1): int
}

struct Square implements Shape {
  side: int
}

implement Shape for Square {
  function area(self: Square, scale: int = 2): int {
    return self.side * self.side * scale
  }
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Show.show(Shape.area(Square { side: 2 }, 1)))
  return 0
}
