const STD_ARENA = "// std/arena: values in slots, reached through generation-checked handles (D118 item 2).\n//\n// A graph with cycles keeps its nodes in an Arena and refers to them with\n// Handle values. A handle is a slot index and the generation the slot had when\n// the value went in. Removing a value, or clearing the arena, raises the\n// generation, so an old handle finds nothing. A handle from another arena is\n// not detected: it reads whatever that slot of this arena holds.\n\nimport * as Arrays from \"std/array\"\n\nexport opaque struct Handle<T> derives Equatable, Hashable, Show {\n  index: int\n  generation: int\n}\n\nexport opaque struct Arena<T> {\n  slots: Array<Option<T>>\n  generations: Array<int>\n  free: Array<int>\n  freeCount: int\n  count: int\n}\n\nexport function create<T>(): Arena<T> uses alloc {\n  return Arena<T> { slots: [], generations: [], free: [], freeCount: 0, count: 0 }\n}\n\nexport function insert<T>(mutable arena: Arena<T>, value: T): Handle<T> uses alloc {\n  // Reuse the last freed slot, or add a new one.\n  if (arena.freeCount > 0) {\n    arena.freeCount = arena.freeCount - 1\n    const index = arena.free[arena.freeCount]\n    arena.slots[index] = Some(value)\n    arena.count = arena.count + 1\n    return Handle<T> { index: index, generation: arena.generations[index] }\n  }\n  const index = Arrays.length(arena.slots)\n  Arrays.push(mutable arena.slots, Some(value))\n  Arrays.push(mutable arena.generations, 0)\n  arena.count = arena.count + 1\n  return Handle<T> { index: index, generation: 0 }\n}\n\nfunction pushFree<T>(mutable arena: Arena<T>, index: int) uses alloc {\n  // The free list is a stack: freeCount says how many entries are in use.\n  if (arena.freeCount < Arrays.length(arena.free)) {\n    arena.free[arena.freeCount] = index\n  } else {\n    Arrays.push(mutable arena.free, index)\n  }\n  arena.freeCount = arena.freeCount + 1\n}\n\nfunction isLive<T>(arena: Arena<T>, handle: Handle<T>): bool {\n  if (handle.index < 0 || handle.index >= Arrays.length(arena.slots)) {\n    return false\n  }\n  if (arena.generations[handle.index] != handle.generation) {\n    return false\n  }\n  return arena.slots[handle.index] is Some(_)\n}\n\nexport function contains<T>(arena: Arena<T>, handle: Handle<T>): bool {\n  return isLive(arena, handle)\n}\n\nexport function size<T>(arena: Arena<T>): int {\n  return arena.count\n}\n\nexport function get<T>(arena: Arena<T>, handle: Handle<T>): Option<T> from arena {\n  if (!isLive(arena, handle)) {\n    return None\n  }\n  return arena.slots[handle.index]\n}\n\nexport function set<T>(mutable arena: Arena<T>, handle: Handle<T>, value: T): bool {\n  if (!isLive(arena, handle)) {\n    return false\n  }\n  arena.slots[handle.index] = Some(value)\n  return true\n}\n\nexport function update<T, effect E>(\n  mutable arena: Arena<T>,\n  handle: Handle<T>,\n  change: (value: T) => T uses E\n): bool uses E {\n  if (!isLive(arena, handle)) {\n    return false\n  }\n  // Take the value out first, so the change works on a unique value.\n  const old = arena.slots[handle.index]\n  arena.slots[handle.index] = None\n  if (old is Some(value)) {\n    arena.slots[handle.index] = Some(change(value))\n  }\n  return true\n}\n\nexport function remove<T>(mutable arena: Arena<T>, handle: Handle<T>): Option<T> uses alloc {\n  if (!isLive(arena, handle)) {\n    return None\n  }\n  const old = arena.slots[handle.index]\n  arena.slots[handle.index] = None\n  arena.generations[handle.index] = handle.generation + 1\n  pushFree(mutable arena, handle.index)\n  arena.count = arena.count - 1\n  return copy(old)\n}\n\nexport function clear<T>(mutable arena: Arena<T>) uses alloc {\n  // Keep the slots and raise every generation, so no old handle matches.\n  arena.freeCount = 0\n  arena.count = 0\n  for (let index = 0; index < Arrays.length(arena.slots); index = index + 1) {\n    arena.slots[index] = None\n    arena.generations[index] = arena.generations[index] + 1\n    pushFree(mutable arena, index)\n  }\n}\n\nexport function* entries<T>(arena: Arena<T>): Generator<#[Handle<T>, T]> {\n  for (let index = 0; index < Arrays.length(arena.slots); index = index + 1) {\n    if (arena.slots[index] is Some(value)) {\n      yield #[Handle<T> { index: index, generation: arena.generations[index] }, value]\n    }\n  }\n}\n"

const STD_ARGS = "// std/args: a command line as data, parsed in one call (D118 item 4).\n//\n// A Command lists its flags, positionals and subcommands. Args.parse reads the\n// arguments `run` receives (the program name first) into a Parsed, or returns\n// an ArgsError. `-h` and `--help` come back as ArgsError.Help: the caller\n// prints Args.help(command, path) and exits 0.\n\nimport * as Str from \"std/string\"\nimport * as Arrays from \"std/array\"\n\n// A flag. An empty value is a flag without a value; any other text names the\n// value in the help (`--output <path>`). short is one character or empty.\nexport struct Flag derives Show, Equatable {\n  name: string\n  short: string = \"\"\n  value: string = \"\"\n  repeated: bool = false\n  help: string = \"\"\n}\n\n// What a command does with positionals after the declared ones: an error\n// (None), collect them (Positionals, flags after them still parse), or keep\n// everything after the declared positionals as written (Raw).\nexport enum Rest derives Show, Equatable {\n  None\n  Positionals\n  Raw\n}\n\nexport struct Command derives Show, Equatable {\n  name: string\n  summary: string = \"\"\n  flags: Array<Flag> = []\n  positionals: Array<string> = []\n  rest: Rest\n  commands: Array<Command> = []\n}\n\n// One flag or positional as given. A flag without a value has the value \"\".\nexport struct Entry derives Show, Equatable {\n  name: string\n  value: string\n}\n\nexport struct Parsed derives Show, Equatable {\n  path: Array<string>\n  flags: Array<Entry>\n  positionals: Array<Entry>\n  rest: Array<string>\n}\n\n// The ways a parse fails. closest is the nearest known name for a hint, or \"\".\n// UnknownFlag and MissingValue name the flag as it was typed (`-o` or\n// `--output`); UnexpectedValue and Repeated give its long name.\nexport enum ArgsError derives Show, Equatable {\n  UnknownFlag(name: string, closest: string)\n  MissingValue(flag: string)\n  UnexpectedValue(flag: string)\n  Repeated(flag: string)\n  UnknownCommand(name: string, closest: string)\n  MissingCommand(path: Array<string>)\n  MissingPositional(name: string)\n  ExtraPositional(text: string)\n  Help(path: Array<string>)\n  BadSpec(reason: string)\n}\n\nconst HELP_FLAG = Flag { name: \"help\", short: \"h\", help: \"print this help\" }\n\n// A name may be a hint when it is at most this many edits away.\nconst HINT_DISTANCE = 2\n\n// A name needs at least this many bytes to get a hint.\nconst HINT_LENGTH = 3\n\nstruct Walk {\n  command: Command\n  path: Array<string>\n  flags: Array<Entry>\n  positionals: Array<Entry>\n  rest: Array<string>\n  // How many of the command's declared positionals are filled.\n  filled: int\n}\n\nexport function parse(\n  command: Command,\n  arguments: Array<string>,\n): Result<Parsed, ArgsError> uses alloc {\n  const problem = checkSpec(command, [])\n  if (problem != \"\") {\n    return Err(ArgsError.BadSpec(problem))\n  }\n  let walk = Walk {\n    command: copy(command),\n    path: [command.name],\n    flags: [],\n    positionals: [],\n    rest: [],\n    filled: 0,\n  }\n  // The result keeps texts of the arguments, so it reads a copy of its own.\n  const given = copy(arguments)\n  const count = Arrays.length(given)\n  let flagsEnded = false\n  let index = 1\n  while (index < count) {\n    const argument = given[index]\n    index += 1\n    if (!flagsEnded && argument == \"--\") {\n      flagsEnded = true\n      continue\n    }\n    if (!flagsEnded && Str.startsWith(argument, \"--\")) {\n      const next = readLong(mutable walk, argument, given, index)\n      if (next is Err(error)) {\n        return Err(error)\n      }\n      index = next.value\n      continue\n    }\n    if (!flagsEnded && Str.startsWith(argument, \"-\") && argument != \"-\") {\n      const next = readShorts(mutable walk, argument, given, index)\n      if (next is Err(error)) {\n        return Err(error)\n      }\n      index = next.value\n      continue\n    }\n    // A positional: a subcommand name, a declared positional or the rest.\n    if (Arrays.length(walk.command.commands) > 0) {\n      const chosen = enterCommand(mutable walk, argument)\n      if (chosen is Err(error)) {\n        return Err(error)\n      }\n      continue\n    }\n    if (walk.filled < Arrays.length(walk.command.positionals)) {\n      const name = walk.command.positionals[walk.filled]\n      Arrays.push(mutable walk.positionals, Entry { name: name, value: argument })\n      walk.filled += 1\n      if (walk.command.rest == Rest.Raw && walk.filled == Arrays.length(walk.command.positionals)) {\n        // After the last declared positional, everything is kept as written.\n        while (index < count) {\n          Arrays.push(mutable walk.rest, given[index])\n          index += 1\n        }\n      }\n      continue\n    }\n    if (walk.command.rest == Rest.Raw) {\n      // A command with no declared positionals keeps everything from here on.\n      Arrays.push(mutable walk.rest, argument)\n      while (index < count) {\n        Arrays.push(mutable walk.rest, given[index])\n        index += 1\n      }\n      continue\n    }\n    if (walk.command.rest == Rest.Positionals) {\n      Arrays.push(mutable walk.rest, argument)\n      continue\n    }\n    return Err(ArgsError.ExtraPositional(argument))\n  }\n  // Every level with subcommands needs one, and every declared positional a value.\n  if (Arrays.length(walk.command.commands) > 0) {\n    return Err(ArgsError.MissingCommand(copy(walk.path)))\n  }\n  if (walk.filled < Arrays.length(walk.command.positionals)) {\n    return Err(ArgsError.MissingPositional(walk.command.positionals[walk.filled]))\n  }\n  return Ok(Parsed {\n    path: walk.path,\n    flags: walk.flags,\n    positionals: walk.positionals,\n    rest: walk.rest,\n  })\n}\n\n// readLong reads `--name`, `--name=value` or `--name value` and returns the\n// index of the next argument.\nfunction readLong(\n  mutable walk: Walk,\n  argument: string,\n  arguments: Array<string>,\n  index: int,\n): Result<int, ArgsError> uses alloc {\n  const body = Str.sliceFrom(argument, 2)\n  let name = body\n  let inline = \"\"\n  let hasInline = false\n  const equals = Str.indexOf(body, \"=\")\n  if (equals is Some(at)) {\n    name = cutText(body, 0, at)\n    inline = Str.sliceFrom(body, at + 1)\n    hasInline = true\n  }\n  if (name == \"help\" && findLong(walk.command, \"help\") is None) {\n    if (hasInline) {\n      return Err(ArgsError.UnexpectedValue(\"help\"))\n    }\n    return Err(ArgsError.Help(copy(walk.path)))\n  }\n  const found = findLong(walk.command, name)\n  if (found is None) {\n    if (name == \"\") {\n      return Err(ArgsError.UnknownFlag(argument, \"\"))\n    }\n    const closest = closestName(name, longNames(walk.command))\n    if (closest == \"\") {\n      return Err(ArgsError.UnknownFlag(`--\${name}`, \"\"))\n    }\n    return Err(ArgsError.UnknownFlag(`--\${name}`, `--\${closest}`))\n  }\n  const flag = walk.command.flags[found.value]\n  if (flag.value == \"\") {\n    if (hasInline) {\n      return Err(ArgsError.UnexpectedValue(flag.name))\n    }\n    return addFlag(mutable walk, flag, \"\", index)\n  }\n  if (hasInline) {\n    return addFlag(mutable walk, flag, inline, index)\n  }\n  if (index >= Arrays.length(arguments)) {\n    return Err(ArgsError.MissingValue(`--\${flag.name}`))\n  }\n  return addFlag(mutable walk, flag, arguments[index], index + 1)\n}\n\n// readShorts reads `-x`, `-x value`, `-xvalue` and bundled `-abc`, and returns\n// the index of the next argument.\nfunction readShorts(\n  mutable walk: Walk,\n  argument: string,\n  arguments: Array<string>,\n  index: int,\n): Result<int, ArgsError> uses alloc {\n  const length = Str.length(argument)\n  // The byte offset of the next character of the bundle.\n  let offset = 1\n  for (const character of Str.chars(Str.sliceFrom(argument, 1))) {\n    const short = Str.fromChar(character)\n    offset += Str.length(short)\n    const found = findShort(walk.command, short)\n    if (found is None) {\n      if (short == \"h\") {\n        return Err(ArgsError.Help(copy(walk.path)))\n      }\n      return Err(ArgsError.UnknownFlag(`-\${short}`, \"\"))\n    }\n    const flag = walk.command.flags[found.value]\n    if (flag.value == \"\") {\n      const added = addFlag(mutable walk, flag, \"\", index)\n      if (added is Err(error)) {\n        return Err(error)\n      }\n      continue\n    }\n    // A flag with a value takes the rest of the bundle, or the next argument.\n    if (offset < length) {\n      return addFlag(mutable walk, flag, Str.sliceFrom(argument, offset), index)\n    }\n    if (index >= Arrays.length(arguments)) {\n      return Err(ArgsError.MissingValue(`-\${short}`))\n    }\n    return addFlag(mutable walk, flag, arguments[index], index + 1)\n  }\n  return Ok(index)\n}\n\nfunction addFlag(\n  mutable walk: Walk,\n  flag: Flag,\n  value: string,\n  next: int,\n): Result<int, ArgsError> uses alloc {\n  if (!flag.repeated && findEntry(walk.flags, flag.name) is Some(_)) {\n    return Err(ArgsError.Repeated(flag.name))\n  }\n  Arrays.push(mutable walk.flags, Entry { name: flag.name, value: value })\n  return Ok(next)\n}\n\n// enterCommand moves the walk into the subcommand named text.\nfunction enterCommand(mutable walk: Walk, text: string): Result<int, ArgsError> uses alloc {\n  let names: Array<string> = []\n  let position = -1\n  for (const #[index, command] of Arrays.entries(walk.command.commands)) {\n    Arrays.push(mutable names, command.name)\n    if (command.name == text && position < 0) {\n      position = index\n    }\n  }\n  if (position < 0) {\n    return Err(ArgsError.UnknownCommand(text, closestName(text, names)))\n  }\n  const next = copy(walk.command.commands[position])\n  walk.command = next\n  Arrays.push(mutable walk.path, text)\n  walk.filled = 0\n  return Ok(position)\n}\n\nfunction findLong(command: Command, name: string): Option<int> {\n  for (const #[index, flag] of Arrays.entries(command.flags)) {\n    if (flag.name == name) {\n      return Some(index)\n    }\n  }\n  return None\n}\n\nfunction findShort(command: Command, short: string): Option<int> {\n  for (const #[index, flag] of Arrays.entries(command.flags)) {\n    if (flag.short != \"\" && flag.short == short) {\n      return Some(index)\n    }\n  }\n  return None\n}\n\nfunction findEntry(entries: Array<Entry>, name: string): Option<int> {\n  for (const #[index, entry] of Arrays.entries(entries)) {\n    if (entry.name == name) {\n      return Some(index)\n    }\n  }\n  return None\n}\n\n// The long names a command accepts, without their dashes.\nfunction longNames(command: Command): Array<string> uses alloc {\n  let names: Array<string> = []\n  for (const flag of command.flags) {\n    Arrays.push(mutable names, flag.name)\n  }\n  if (findLong(command, \"help\") is None) {\n    Arrays.push(mutable names, \"help\")\n  }\n  return names\n}\n\n// checkSpec returns the first mistake in the spec, or \"\". inherited holds the\n// long names of the enclosing commands: Parsed keeps flags by name, so a\n// subcommand may not reuse one.\nfunction checkSpec(command: Command, inherited: Array<string>): string uses alloc {\n  let longs: Array<string> = []\n  let shorts: Array<string> = []\n  for (const flag of command.flags) {\n    if (flag.name == \"\") {\n      return `command \${command.name} has a flag with an empty name`\n    }\n    if (Arrays.length(longs) > 0 && containsText(longs, flag.name)) {\n      return `command \${command.name} has two flags named --\${flag.name}`\n    }\n    if (containsText(inherited, flag.name)) {\n      return `command \${command.name} reuses --\${flag.name}, a flag of an enclosing command`\n    }\n    Arrays.push(mutable longs, flag.name)\n    if (flag.short != \"\") {\n      if (Str.charCount(flag.short) != 1) {\n        return `flag --\${flag.name} has the short name \"\${flag.short}\", which is not one character`\n      }\n      if (flag.short == \"-\") {\n        return `flag --\${flag.name} has the short name \"-\"`\n      }\n      if (containsText(shorts, flag.short)) {\n        return `command \${command.name} has two flags with the short name -\${flag.short}`\n      }\n      Arrays.push(mutable shorts, flag.short)\n    }\n  }\n  let positionals: Array<string> = []\n  for (const name of command.positionals) {\n    if (containsText(positionals, name)) {\n      return `command \${command.name} has two positionals named <\${name}>`\n    }\n    Arrays.push(mutable positionals, name)\n  }\n  if (Arrays.length(command.commands) > 0 && Arrays.length(command.positionals) > 0) {\n    return `command \${command.name} has both positionals and subcommands`\n  }\n  // The subcommands see the long names of this command and of its parents.\n  let enclosing = copy(inherited)\n  for (const name of longs) {\n    Arrays.push(mutable enclosing, name)\n  }\n  let names: Array<string> = []\n  for (const sub of command.commands) {\n    if (containsText(names, sub.name)) {\n      return `command \${command.name} has two subcommands named \${sub.name}`\n    }\n    Arrays.push(mutable names, sub.name)\n    const problem = checkSpec(sub, enclosing)\n    if (problem != \"\") {\n      return problem\n    }\n  }\n  return \"\"\n}\n\nfunction containsText(items: Array<string>, text: string): bool {\n  for (const item of items) {\n    if (item == text) {\n      return true\n    }\n  }\n  return false\n}\n\nfunction cutText(text: string, start: int, end: int): string uses alloc {\n  if (Str.slice(text, start, end) is Some(piece)) {\n    return piece\n  }\n  return \"\"\n}\n\n// closestName returns the candidate fewest edits from text, at most\n// HINT_DISTANCE away, or \"\". The first one wins a tie. A name shorter than\n// HINT_LENGTH gets no hint, since two edits reach any other short name.\nfunction closestName(text: string, candidates: Array<string>): string uses alloc {\n  if (Str.length(text) < HINT_LENGTH) {\n    return \"\"\n  }\n  let best = \"\"\n  let bestDistance = HINT_DISTANCE + 1\n  for (const candidate of candidates) {\n    const distance = editDistance(text, candidate)\n    if (distance < bestDistance) {\n      best = candidate\n      bestDistance = distance\n    }\n  }\n  return best\n}\n\n// editDistance is the Levenshtein distance over the bytes of two names.\nfunction editDistance(left: string, right: string): int uses alloc {\n  const leftLength = Str.length(left)\n  const rightLength = Str.length(right)\n  let previous: Array<int> = Arrays.withCapacity(rightLength + 1)\n  for (let j = 0; j <= rightLength; j++) {\n    Arrays.push(mutable previous, j)\n  }\n  for (let i = 1; i <= leftLength; i++) {\n    let current: Array<int> = Arrays.withCapacity(rightLength + 1)\n    Arrays.push(mutable current, i)\n    for (let j = 1; j <= rightLength; j++) {\n      let cost = 1\n      if (Str.byteAt(left, i - 1) == Str.byteAt(right, j - 1)) {\n        cost = 0\n      }\n      let best = previous[j - 1] + cost\n      if (previous[j] + 1 < best) {\n        best = previous[j] + 1\n      }\n      if (current[j - 1] + 1 < best) {\n        best = current[j - 1] + 1\n      }\n      Arrays.push(mutable current, best)\n    }\n    previous = current\n  }\n  return previous[rightLength]\n}\n\nexport function has(parsed: Parsed, name: string): bool {\n  return findEntry(parsed.flags, name) is Some(_)\n}\n\n// value returns the last value given for the flag name.\nexport function value(parsed: Parsed, name: string): Option<string> uses alloc {\n  let found: Option<string> = None\n  for (const entry of parsed.flags) {\n    if (entry.name == name) {\n      found = Some(entry.value)\n    }\n  }\n  return found\n}\n\nexport function values(parsed: Parsed, name: string): Array<string> uses alloc {\n  let found: Array<string> = []\n  for (const entry of parsed.flags) {\n    if (entry.name == name) {\n      Arrays.push(mutable found, entry.value)\n    }\n  }\n  return found\n}\n\nexport function positional(parsed: Parsed, name: string): Option<string> uses alloc {\n  for (const entry of parsed.positionals) {\n    if (entry.name == name) {\n      return Some(entry.value)\n    }\n  }\n  return None\n}\n\nexport function rest(parsed: Parsed): Array<string> uses alloc {\n  return copy(parsed.rest)\n}\n\nexport function commandPath(parsed: Parsed): Array<string> uses alloc {\n  return copy(parsed.path)\n}\n\n// help writes the help of the command at path (`[\"narrac\", \"build\"]`): the\n// usage line, the summary, the flags and the subcommands, in aligned columns.\nexport function help(command: Command, path: Array<string>): string uses alloc {\n  let target = copy(command)\n  let names: Array<string> = [command.name]\n  for (const #[index, name] of Arrays.entries(path)) {\n    if (index == 0) {\n      continue\n    }\n    const found = findCommand(target, name)\n    if (found is None) {\n      break\n    }\n    const next = copy(target.commands[found.value])\n    target = next\n    Arrays.push(mutable names, name)\n  }\n  let builder = Str.builder()\n  Str.append(mutable builder, `Usage: \${Str.join(names, \" \")} [flags]`)\n  for (const name of target.positionals) {\n    Str.append(mutable builder, ` <\${name}>`)\n  }\n  if (target.rest == Rest.Positionals) {\n    Str.append(mutable builder, \" [arguments...]\")\n  } else if (target.rest == Rest.Raw) {\n    Str.append(mutable builder, \" [arguments...]\")\n  }\n  if (Arrays.length(target.commands) > 0) {\n    Str.append(mutable builder, \" <command>\")\n  }\n  Str.append(mutable builder, \"\\n\")\n  if (target.summary != \"\") {\n    Str.append(mutable builder, `\\n\${target.summary}\\n`)\n  }\n  // The flag column, with the added help flag last.\n  let flags = copy(target.flags)\n  if (findLong(target, \"help\") is None) {\n    if (findShort(target, \"h\") is None) {\n      Arrays.push(mutable flags, HELP_FLAG)\n    } else {\n      Arrays.push(mutable flags, Flag { name: \"help\", help: \"print this help\" })\n    }\n  }\n  let labels: Array<string> = []\n  let texts: Array<string> = []\n  for (const flag of flags) {\n    Arrays.push(mutable labels, flagLabel(flag))\n    Arrays.push(mutable texts, flag.help)\n  }\n  Str.append(mutable builder, \"\\nFlags:\\n\")\n  writeColumns(mutable builder, labels, texts)\n  if (Arrays.length(target.commands) > 0) {\n    let commandNames: Array<string> = []\n    let summaries: Array<string> = []\n    for (const sub of target.commands) {\n      Arrays.push(mutable commandNames, sub.name)\n      Arrays.push(mutable summaries, sub.summary)\n    }\n    Str.append(mutable builder, \"\\nCommands:\\n\")\n    writeColumns(mutable builder, commandNames, summaries)\n  }\n  return Str.build(builder)\n}\n\nfunction findCommand(command: Command, name: string): Option<int> {\n  for (const #[index, sub] of Arrays.entries(command.commands)) {\n    if (sub.name == name) {\n      return Some(index)\n    }\n  }\n  return None\n}\n\n// flagLabel writes `-o, --output <path>`, or `    --release` without a short name.\nfunction flagLabel(flag: Flag): string uses alloc {\n  let label = \"    \"\n  if (flag.short != \"\") {\n    label = `-\${flag.short}, `\n  }\n  label = `\${label}--\${flag.name}`\n  if (flag.value != \"\") {\n    label = `\${label} <\${flag.value}>`\n  }\n  if (flag.repeated) {\n    label = `\${label}...`\n  }\n  return label\n}\n\n// writeColumns writes one line per label, with the texts lined up after the\n// widest label.\nfunction writeColumns(\n  mutable builder: StringBuilder,\n  labels: Array<string>,\n  texts: Array<string>,\n) uses alloc {\n  let width = 0\n  for (const label of labels) {\n    if (visibleWidth(label) > width) {\n      width = visibleWidth(label)\n    }\n  }\n  for (const #[index, label] of Arrays.entries(labels)) {\n    Str.append(mutable builder, `  \${label}`)\n    if (texts[index] != \"\") {\n      if (Str.repeat(\" \", width - visibleWidth(label) + 2) is Some(padding)) {\n        Str.append(mutable builder, padding)\n      }\n      Str.append(mutable builder, texts[index])\n    }\n    Str.append(mutable builder, \"\\n\")\n  }\n}\n\n// visibleWidth counts the code points of a label, without the escape\n// sequences (`ESC [`, parameters, a final byte) that style it.\nfunction visibleWidth(text: string): int {\n  const length = Str.length(text)\n  let width = 0\n  let index = 0\n  while (index < length) {\n    const byte = Str.byteAt(text, index)\n    if (byte == 27 && index + 1 < length && Str.byteAt(text, index + 1) == 91) {\n      // Skip parameter and intermediate bytes, then the final byte.\n      index += 2\n      while (index < length && Str.byteAt(text, index) >= 32 && Str.byteAt(text, index) <= 63) {\n        index += 1\n      }\n      index += 1\n      continue\n    }\n    // Count the first byte of each code point, not its continuation bytes.\n    if (byte < 128 || byte >= 192) {\n      width += 1\n    }\n    index += 1\n  }\n  return width\n}\n\n// formatError writes the message line of an error, with a hint when a known\n// name is close (`unknown flag --relase; did you mean --release?`).\nexport function formatError(error: ArgsError): string uses alloc {\n  return match (error) {\n    ArgsError.UnknownFlag(name, closest) => withHint(`unknown flag \${name}`, closest)\n    ArgsError.MissingValue(flag) => `flag \${flag} needs a value`\n    ArgsError.UnexpectedValue(flag) => `flag --\${flag} takes no value`\n    ArgsError.Repeated(flag) => `flag --\${flag} is given more than once`\n    ArgsError.UnknownCommand(name, closest) => withHint(`unknown command \${name}`, closest)\n    ArgsError.MissingCommand(path) => `\${Str.join(path, \" \")} needs a command`\n    ArgsError.MissingPositional(name) => `missing argument <\${name}>`\n    ArgsError.ExtraPositional(text) => `unexpected argument \${text}`\n    ArgsError.Help(path) => `help for \${Str.join(path, \" \")}`\n    ArgsError.BadSpec(reason) => `bad command spec: \${reason}`\n  }\n}\n\nfunction withHint(message: string, closest: string): string uses alloc {\n  if (closest == \"\") {\n    return message\n  }\n  return `\${message}; did you mean \${closest}?`\n}\n"

const STD_ASYNC = "// std/async: the functions of task handles (SPEC.md section 8, D109).\n//\n// An Async<T> is the handle of a task; the type is builtin and needs no\n// import. The handle functions go through the primitives of\n// std/internal/async; all and race are async blocks, which the stage 1\n// compiler builds (the committed seed never compiles this module).\n\nimport * as Arrays from \"std/array\"\nimport * as Ranges from \"std/range\"\nimport * as Tasks from \"std/internal/async\"\n\n// The error of every suspending std function.\nexport enum AsyncError {\n  Cancelled\n  Failed(message: string)\n}\n\n// Lets the task run with nobody waiting. The task keeps running to its end, or\n// until the program exits.\nexport function detach<T>(_handle: Async<T>) {}\n\n// A handle that finishes once no other task of the loop can run: none is\n// ready, sleeping or waiting on I/O, counting tasks started while it waits.\n// Idle handles finish one at a time, oldest first. In a cancelled task it\n// finishes at once.\nexport function idle(): Async<void> uses alloc {\n  return Tasks.idle()\n}\n\n// Runs callback with the value when the task finishes, or on the next loop\n// turn if it has. A cancelled task drops the callback without running it. For\n// an Async<void> the callback takes no argument.\nexport function then<T, effect E>(\n  handle: Async<T>,\n  escaping callback: (value: T) => void uses E\n) uses E, alloc {\n  // The runtime calls this only for a task that finished without a cancel.\n  Tasks.then(handle, (finished: Async<T>) => callback(Tasks.value(finished)))\n}\n\n// The value once the task has finished; None before that and after a cancel.\nexport function peek<T>(handle: Async<T>): Option<T> uses alloc {\n  if (Tasks.finished(handle)) {\n    return Some(Tasks.value(handle))\n  }\n  return None\n}\n\n// Cancels the task: its then callbacks are dropped, peek gives None, a sleep\n// or Async.idle it waits in ends at once, and its suspending std calls give\n// Err(AsyncError.Cancelled). A finished task is left as it is.\nexport function cancel<T>(handle: Async<T>) {\n  Tasks.cancel(handle)\n}\n\n// Every value, in the order of the handles, once each task has finished. A\n// cancel of the result does not reach the handles, and neither does a cancel\n// of another task that awaits one of them while the all is unfinished.\nexport function all<T>(handles: Array<Async<T>>): Async<Array<T>> from handles uses alloc {\n  return async {\n    Tasks.keepInputs()\n    // Each handle counts as observed until it is awaited, so a cancel of\n    // another task that awaits it does not cancel it.\n    for (const handle of Arrays.values(handles)) {\n      Tasks.observe(handle)\n    }\n    let values: Array<T> = []\n    for (const handle of Arrays.values(handles)) {\n      Arrays.push(mutable values, await handle)\n      Tasks.unobserve(handle)\n    }\n    return values\n  }\n}\n\n// The value of the first task to finish, or None for no handles. The other\n// tasks keep running.\nexport function race<T>(handles: Array<Async<T>>): Async<Option<T>> from handles uses alloc {\n  return async {\n    if (Arrays.length(handles) == 0) {\n      return None\n    }\n    const winner = Tasks.winner()\n    for (const index of Ranges.between(0, Arrays.length(handles))) {\n      Tasks.watch(winner, handles[index], index)\n    }\n    const first = await winner\n    return Some(await handles[first])\n  }\n}\n"

const STD_ASYNC__FILE = "// std/async/file: whole-file reads and writes for async code (SPEC.md section 8, D109).\n//\n// kqueue and epoll do not wait on regular files, so each call reads or writes\n// in one blocking step, as std/fs does, then lets the other ready tasks run\n// once before it returns. A cancelled task's call gives\n// Err(AsyncError.Cancelled) before it touches the file.\n\nimport * as Fs from \"std/fs\"\nimport * as Tasks from \"std/internal/async\"\nimport * as Handles from \"std/internal/asyncio\"\nimport { AsyncError } from \"std/async\"\n\n// The text of the file at path.\nexport async function readText(path: string): Result<string, AsyncError> uses io, alloc {\n  if (Handles.cancelled()) {\n    return Err(AsyncError.Cancelled)\n  }\n  const result = Fs.readText(path)\n  // A zero timer fires after the ready tasks: one turn for them. The work is\n  // done, so a cancel now changes nothing.\n  const _turn = await Tasks.sleep(0)\n  return match (result) { Ok(text) => Ok(text), Err(message) => Err(AsyncError.Failed(message)) }\n}\n\n// The bytes of the file at path.\nexport async function readBytes(path: string): Result<bytes, AsyncError> uses io, alloc {\n  if (Handles.cancelled()) {\n    return Err(AsyncError.Cancelled)\n  }\n  const result = Fs.readBytes(path)\n  // A zero timer fires after the ready tasks: one turn for them. The work is\n  // done, so a cancel now changes nothing.\n  const _turn = await Tasks.sleep(0)\n  return match (result) { Ok(data) => Ok(data), Err(message) => Err(AsyncError.Failed(message)) }\n}\n\n// Writes text to the file at path, replacing it, and gives the bytes written.\nexport async function writeText(\n  path: string,\n  text: string,\n): Result<int, AsyncError> uses io, alloc {\n  if (Handles.cancelled()) {\n    return Err(AsyncError.Cancelled)\n  }\n  const result = Fs.writeText(path, text)\n  // A zero timer fires after the ready tasks: one turn for them. The work is\n  // done, so a cancel now changes nothing.\n  const _turn = await Tasks.sleep(0)\n  return match (result) { Ok(count) => Ok(count), Err(message) => Err(AsyncError.Failed(message)) }\n}\n\n// Writes data to the file at path, replacing it, and gives the bytes written.\nexport async function writeBytes(\n  path: string,\n  data: bytes,\n): Result<int, AsyncError> uses io, alloc {\n  if (Handles.cancelled()) {\n    return Err(AsyncError.Cancelled)\n  }\n  const result = Fs.writeBytes(path, data)\n  // A zero timer fires after the ready tasks: one turn for them. The work is\n  // done, so a cancel now changes nothing.\n  const _turn = await Tasks.sleep(0)\n  return match (result) { Ok(count) => Ok(count), Err(message) => Err(AsyncError.Failed(message)) }\n}\n"

const STD_ASYNC__NET = "// std/async/net: TCP sockets on the loop of the thread (SPEC.md section 8, D109).\n//\n// listen and localPort do not suspend. accept, connect, read and write wait in\n// the loop until the socket is ready, so the other tasks run meanwhile. A\n// Listener or a Connection is a handle: copies share the socket, and it\n// closes when the last copy is dropped. host is a numeric IPv4 or IPv6\n// address; there is no name lookup.\n\nimport * as Bytes from \"std/bytes\"\nimport * as Handles from \"std/internal/asyncio\"\nimport { AsyncError } from \"std/async\"\n\nexport opaque struct Listener {\n  handle: Handle\n}\n\nexport opaque struct Connection {\n  handle: Handle\n}\n\nfunction failWith(code: int): AsyncError uses alloc {\n  return AsyncError.Failed(Handles.message(code))\n}\n\n// The error of a wait that ended with ready: None when the socket is ready.\n// Each suspending function waits itself, never through a helper task, so a\n// cancel of the task that awaits it reaches the wait. One task at a time may\n// wait in each direction; busy names what the other task already does.\nfunction checkWait(ready: int, busy: string): Option<AsyncError> uses alloc {\n  if (ready < 0) {\n    return Some(AsyncError.Cancelled)\n  }\n  if (Handles.busy(ready)) {\n    return Some(AsyncError.Failed(`another task is already \${busy}`))\n  }\n  if (ready > 0) {\n    return Some(failWith(ready))\n  }\n  return None\n}\n\n// A socket that accepts connections on host and port. Port 0 picks a free\n// port, which localPort gives.\nexport function listen(host: string, port: int): Result<Listener, AsyncError> uses io, alloc {\n  const handle = Handles.listen(host, port)\n  const code = Handles.error()\n  if (code != 0) {\n    return Err(failWith(code))\n  }\n  return Ok(Listener { handle: handle })\n}\n\n// The port the listener is bound to.\nexport function localPort(listener: Listener): int uses io {\n  return Handles.localPort(listener.handle)\n}\n\n// The next connection to the listener.\nexport async function accept(listener: Listener): Result<Connection, AsyncError> uses io, alloc {\n  while (true) {\n    if (Handles.cancelled()) {\n      return Err(AsyncError.Cancelled)\n    }\n    const handle = Handles.accept(listener.handle)\n    const code = Handles.error()\n    if (code == 0) {\n      return Ok(Connection { handle: handle })\n    }\n    // A connection that went before it was taken leaves the others to accept.\n    if (!Handles.acceptAgain(code)) {\n      if (!Handles.retry(code)) {\n        return Err(failWith(code))\n      }\n      const problem = checkWait(\n        await Handles.wait(listener.handle, false),\n        \"accepting on this listener\",\n      )\n      if (problem is Some(error)) {\n        return Err(error)\n      }\n    }\n  }\n  return Err(AsyncError.Cancelled)\n}\n\n// A connection to host and port.\nexport async function connect(\n  host: string,\n  port: int,\n): Result<Connection, AsyncError> uses io, alloc {\n  if (Handles.cancelled()) {\n    return Err(AsyncError.Cancelled)\n  }\n  const handle = Handles.connect(host, port)\n  const code = Handles.error()\n  if (code == 0) {\n    return Ok(Connection { handle: handle })\n  }\n  if (!Handles.pending(code)) {\n    return Err(failWith(code))\n  }\n  const problem = checkWait(await Handles.wait(handle, true), \"connecting this socket\")\n  if (problem is Some(error)) {\n    return Err(error)\n  }\n  const result = Handles.connected(handle)\n  if (result != 0) {\n    return Err(failWith(result))\n  }\n  return Ok(Connection { handle: handle })\n}\n\n// Up to maxBytes bytes from the connection, at most 64 KiB, once some are\n// there. Empty bytes mean the peer has closed its side; a maxBytes of zero or\n// less gives empty bytes at once.\nexport async function read(\n  connection: Connection,\n  maxBytes: int,\n): Result<bytes, AsyncError> uses io, alloc {\n  while (true) {\n    if (Handles.cancelled()) {\n      return Err(AsyncError.Cancelled)\n    }\n    const data = Handles.read(connection.handle, maxBytes)\n    const code = Handles.error()\n    if (code == 0) {\n      return Ok(data)\n    }\n    if (!Handles.retry(code)) {\n      return Err(failWith(code))\n    }\n    const problem = checkWait(\n      await Handles.wait(connection.handle, false),\n      \"reading this connection\",\n    )\n    if (problem is Some(error)) {\n      return Err(error)\n    }\n  }\n  return Err(AsyncError.Cancelled)\n}\n\n// Writes every byte of data and gives the count. A cancel while it waits\n// ends it with Err(AsyncError.Cancelled), whatever part was sent.\nexport async function write(\n  connection: Connection,\n  data: bytes,\n): Result<int, AsyncError> uses io, alloc {\n  if (Handles.cancelled()) {\n    return Err(AsyncError.Cancelled)\n  }\n  let sent = 0\n  const total = Bytes.length(data)\n  // A wait that a cancel ends gives -1, so the loop needs no second check.\n  while (sent < total) {\n    const count = Handles.write(connection.handle, data, sent)\n    const code = Handles.error()\n    if (code == 0) {\n      sent += count\n    } else if (!Handles.retry(code)) {\n      return Err(failWith(code))\n    } else {\n      const problem = checkWait(\n        await Handles.wait(connection.handle, true),\n        \"writing this connection\",\n      )\n      if (problem is Some(error)) {\n        return Err(error)\n      }\n    }\n  }\n  return Ok(sent)\n}\n"

const STD_ASYNC__TIME = "// std/async/time: sleep on the loop of the thread (SPEC.md section 8, D109).\n//\n// sleep suspends the running task until the duration has passed; the other\n// tasks of the loop run meanwhile. Time.sleep of std/time blocks the loop.\n\nimport * as Tasks from \"std/internal/async\"\nimport * as Time from \"std/time\"\nimport { Duration } from \"std/time\"\nimport { AsyncError } from \"std/async\"\n\n// Waits for duration and gives the time slept, or Err(AsyncError.Cancelled)\n// at once when the task is cancelled, before or while it waits.\nexport async function sleep(duration: Duration): Result<Duration, AsyncError> uses io, alloc {\n  const slept = await Tasks.sleep(Time.asNanoseconds(duration))\n  if (slept < 0) {\n    return Err(AsyncError.Cancelled)\n  }\n  return Ok(Time.nanoseconds(slept))\n}\n"

const STD_BUILD = "// std/build: the target a program is built for. The compiler sets os, arch and\n// debug for each build; the values written here are replaced. An `if` that\n// tests only these constants keeps one branch in the output.\n\nimport * as Host from \"std/internal/host\"\n\nexport enum Os derives Show, Equatable {\n  MacOS\n  Linux\n  Windows\n}\n\nexport enum Arch derives Show, Equatable {\n  Arm64\n  X86_64\n}\n\nexport const os: Os = Os.Linux\nexport const arch: Arch = Arch.X86_64\nexport const debug: bool = true\n\nexport struct Target {\n  os: Os\n  arch: Arch\n}\n\nexport function hostTarget(): Option<Target> {\n  const hostOs = Host.os()\n  const hostArch = Host.arch()\n  // The C compiler's predefined macros give the codes; 0 is a machine with no variant here.\n  if (hostOs == 0 || hostArch == 0) {\n    return None\n  }\n  if (hostOs == 1 && hostArch == 1) {\n    return Some(Target { os: Os.MacOS, arch: Arch.Arm64 })\n  }\n  if (hostOs == 1) {\n    return Some(Target { os: Os.MacOS, arch: Arch.X86_64 })\n  }\n  if (hostArch == 1) {\n    return Some(Target { os: Os.Linux, arch: Arch.Arm64 })\n  }\n  return Some(Target { os: Os.Linux, arch: Arch.X86_64 })\n}\n"

const STD_CELL = "// std/cell: Cell<T>, one mutable slot that every copy of the handle shares.\n//\n// A Cell is an identity type: copying it, capturing it in a closure or storing it in a\n// struct copies the handle, and Cell.set through any copy changes what all of them read.\n\nimport * as Boxes from \"std/box\"\nimport * as Slot from \"std/internal/cell\"\n\nexport opaque struct Cell<T> {\n  slot: Box<T>\n}\n\nexport function create<T>(value: T): Cell<T> uses alloc {\n  return Cell { slot: Boxes.new(value) }\n}\n\nexport function get<T>(cell: Cell<T>): T from cell {\n  return cell.slot.value\n}\n\nexport function set<T>(cell: Cell<T>, value: T) {\n  Slot.store(cell.slot, value)\n}\n\nexport function update<T, effect E>(cell: Cell<T>, change: (value: T) => T uses E) uses E {\n  // Hold the old value, so a set inside change cannot free it.\n  const old = get(cell)\n  Slot.store(cell.slot, change(old))\n}\n"

const STD_COROUTINE = "// std/coroutine: Co.resume runs a generator or a coroutine to its next yield.\n//\n// The compiler turns `Co.resume(mutable g)` into resumeGenerator and\n// `Co.resume(mutable g, input)` into resumeCoroutine, by argument count.\n\nimport * as Internal from \"std/internal/coroutine\"\n\nexport enum Step<Out> derives Show, Equatable {\n  Yielded(value: Out)\n  Done\n  Panicked(message: string)\n}\n\nexport function resumeGenerator<T, effect E>(\n  mutable g: Generator<T> uses E\n): Step<T> uses E, alloc {\n  return readStep(Internal.next(mutable g))\n}\n\nexport function resumeCoroutine<In, Out, effect E>(\n  mutable g: Coroutine<In, Out> uses E,\n  input: In,\n): Step<Out> uses E, alloc {\n  return readStep(Internal.resume(mutable g, input))\n}\n\n// readStep reads the outcome of one resume: a value, the end, or a panic.\nfunction readStep<T>(next: Option<T>): Step<T> from next uses alloc {\n  if (next is Some(value)) {\n    return Step.Yielded(value)\n  }\n  if (Internal.panicked()) {\n    return Step.Panicked(Internal.panicMessage())\n  }\n  return Step.Done\n}\n"

const STD_CSTRING = "// std/cstring: CString, a string with no zero byte, which C reads as a zero-terminated string.\n//\n// Pass `CStrings.pointer(text)` to a C function that takes `char*`; the pointer is valid while\n// the CString is. `CStrings.read` copies a zero-terminated string that C returns.\n\nimport * as Bytes from \"std/bytes\"\nimport * as Str from \"std/string\"\nimport * as Ptr from \"std/ptr\"\nimport * as Text from \"std/internal/cstring\"\n\nexport opaque struct CString {\n  text: string\n}\n\nexport function from(text: string): Option<CString> {\n  // C would stop at a zero byte, so a string that holds one has no CString.\n  const length = Str.length(text)\n  for (let index = 0; index < length; index++) {\n    if (Str.byteAt(text, index) == 0) {\n      return None\n    }\n  }\n  return Some(CString { text: text })\n}\n\nexport function toString(value: CString): string from value {\n  return value.text\n}\n\nexport function pointer(value: CString): Ptr<u8> {\n  return Text.pointer(value.text)\n}\n\nexport function read(address: Ptr<u8>): Result<string, string> uses alloc, unsafe {\n  let copied: Result<string, string> = Err(\"\")\n  unsafe {\n    copied = Bytes.toString(Text.read(address))\n  }\n  return copied\n}\n"

const STD_EXT__ARRAY = "// std/array: helpers over Array. The functions that need the compiler are built in.\n\nimport * as Arrays from \"std/array\"\n\nexport function map<T, U, effect E>(\n  items: Array<T>,\n  change: (value: T) => U uses E\n): Array<U> uses alloc, E {\n  let result: Array<U> = Arrays.withCapacity(Arrays.length(items))\n  for (const item of items) {\n    Arrays.push(mutable result, change(item))\n  }\n  return result\n}\n\nexport function slice<T>(items: Array<T>, start: int, finish: int): Option<Array<T>> uses alloc {\n  // A range outside the array has no slice.\n  if (start < 0 || finish > Arrays.length(items) || start > finish) {\n    return None\n  }\n  let result: Array<T> = Arrays.withCapacity(finish - start)\n  for (let index = start; index < finish; index++) {\n    Arrays.push(mutable result, copy(items[index]))\n  }\n  return Some(result)\n}\n"

const STD_EXT__FLOAT = "// std/float: constants of f64. The functions are built into the compiler.\n\nexport const PI: f64 = 3.141592653589793\n"

const STD_EXT__INT = "// std/int: ordering and division of int. The rest of the functions are built into the compiler.\n\nexport function compare(first: int, second: int): Ordering {\n  if (first < second) {\n    return Ordering.Less\n  }\n  if (first > second) {\n    return Ordering.Greater\n  }\n  return Ordering.Equal\n}\n\nexport function divmod(dividend: int, divisor: int): Option<#[int, int]> {\n  // A zero divisor has no quotient.\n  if (divisor == 0) {\n    return None\n  }\n  return Some(#[dividend / divisor, dividend % divisor])\n}\n\nexport function floorDiv(dividend: int, divisor: int): Option<int> {\n  if (divisor == 0) {\n    return None\n  }\n  const quotient = dividend / divisor\n  const remainder = dividend % divisor\n  // Division truncates toward zero; step down when the signs differ and the division is inexact.\n  if (remainder != 0 && (remainder < 0) != (divisor < 0)) {\n    return Some(quotient - 1)\n  }\n  return Some(quotient)\n}\n"

const STD_EXT__STRING = "// std/string: searching. The rest of the functions are built into the compiler.\n\nimport * as Str from \"std/string\"\n\nexport function find(text: string, needle: string): Option<int> uses alloc {\n  return Str.indexOf(text, needle)\n}\n"

const STD_FIXEDARRAY = "// std/fixedarray: helpers over FixedArray. An index written as values[i] must be\n// proven in range; get checks the index and returns None outside it.\n\nexport function get<T, const N: int>(values: FixedArray<T, N>, index: int): Option<T> from values {\n  if (index >= 0 && index < N) {\n    return Some(values[index])\n  }\n  return None\n}\n\nexport function length<T, const N: int>(_values: FixedArray<T, N>): int {\n  return N\n}\n"

const STD_HASH = "// std/hash: hashing. `of` is the hash of a Hashable value and may change between builds.\n// `fnv1a` is FNV-1a 64 over the UTF-8 bytes of a string and never changes.\n\nimport * as Str from \"std/string\"\nimport * as U64 from \"std/u64\"\nimport * as Ranges from \"std/range\"\n\nconst FNV_OFFSET: u64 = 14695981039346656037\nconst FNV_PRIME: u64 = 1099511628211\n\nexport function of<T: Hashable>(value: T): int {\n  return Hashable.hash(value)\n}\n\nexport function fnv1a(text: string): u64 {\n  let state = FNV_OFFSET\n  const length = Str.length(text)\n  for (const index of Ranges.upTo(length)) {\n    state = (state ^ U64.wrap(Str.byteAt(text, index))) * FNV_PRIME\n  }\n  return state\n}\n"

const STD_INTERNAL__UNICODE = "// std/internal/unicode: the Unicode 17.0.0 tables of std/unicode.\n// Generated by scripts/unicode/generate.nra from the Unicode Character Database. Do not edit.\n// Source: https://www.unicode.org/Public/17.0.0/ucd/ (auxiliary/ and emoji/ files flat).\n//\n// Inputs (SHA-256):\n//   UnicodeData.txt 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c\n//   SpecialCasing.txt efc25faf19de21b92c1194c111c932e03d2a5eaf18194e33f1156e96de4c9588\n//   CaseFolding.txt ff8d8fefbf123574205085d6714c36149eb946d717a0c585c27f0f4ef58c4183\n//   GraphemeBreakProperty.txt d6b51d1d2ae5c33b451b7ed994b48f1f4dc62b2272a5831e7fd418514a6bae89\n//   emoji-data.txt 2cb2bb9455cda83e8481541ecf5b6dfda66a3bb89efa3fa7c5297eccf607b72b\n//   EastAsianWidth.txt ea7ce50f3444a050333448dffef1cadd9325af55cbb764b4a2280faf52170a33\n//   DerivedCoreProperties.txt 24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08\n//   CompositionExclusions.txt 2f239196ef3b5b61db5cc476e9bd80f534d15aa1b74e1be1dea5d042a344c85f\n//   DerivedNormalizationProps.txt 71fd6a206a2c0cdd41feb6b7f656aa31091db45e9cedc926985d718397f9e488\n//\n// Numbers are lowercase hex. A range record is start (6), end (6) and a value.\n\nexport const VERSION = \"17.0.0\"\n\n// Grapheme properties (14): range, then 2 digits: Grapheme_Cluster_Break (0 Other, 1 CR, 2 LF, 3 Control, 4 Extend, 5 ZWJ, 6 Regional_Indicator, 7 Prepend, 8 SpacingMark, 9 L, 10 V, 11 T, 12 LV, 13 LVT) + 16 * Indic_Conjunct_Break (1 Consonant, 2 Extend, 3 Linker) + 64 * Extended_Pictographic.\nexport const GRAPHEME = \"\"\n\n// Display width (13): range, then 1 digit: 0 zero width, 1 an emoji with text presentation (2 columns with U+FE0F), 2 wide. Any other code point is 1 column.\nexport const WIDTH = \"\"\n\n// Case context (13): range, then 1 digit: 1 Cased, 2 Case_Ignorable, 3 both.\nexport const CASE_CONTEXT = \"\"\n\n// Case mapping ranges (19): range, stride (1 digit), target of the start (6). A code point start + stride * k maps to target + stride * k.\nexport const UPPER_RANGES = \"\"\nexport const LOWER_RANGES = \"\"\nexport const FOLD_RANGES = \"\"\n\n// Full case mappings (24): code point (6), then three targets (6 each), 000000 for none.\nexport const UPPER_FULL = \"\"\nexport const LOWER_FULL = \"000130000069000307000000\"\nexport const FOLD_FULL = \"\"\n\n// Normalization properties (14): start (5), end (5), then 4 digits: Canonical_Combining_Class + 256 * quick check (1 NFD_QC=N, 2 NFKD_QC=N, 4 NFC_QC=N, 8 NFC_QC=M, 16 NFKC_QC=N, 32 NFKC_QC=M). Any other code point is class 0 and Yes in every quick check.\nexport const NORMAL_PROPERTIES = \"\"\n\n// Canonical decompositions (15), one step: code point (5), then one or two code points (5 each), 00000 for none.\nexport const CANONICAL = \"\"\n\n// Canonical composition (3): the index of each two code point CANONICAL record that composes (not Full_Composition_Exclusion), sorted by its first and then its second code point.\nexport const COMPOSITION = \"\"\n\n// Compatibility decompositions to one code point (15), one step: start (5), end (5), target of the start (5). A code point start + k decomposes to target + k.\nexport const COMPATIBILITY_RANGES = \"\"\n\n// Longer compatibility decompositions (9), one step: code point (5), then the offset (4) of its first code point in COMPATIBILITY_DATA, counted in code points. The next record's offset, or the end of the data, ends it.\nexport const COMPATIBILITY = \"\"\n\n// The code points of COMPATIBILITY (5 each).\nexport const COMPATIBILITY_DATA = \"\"\n"

const STD_ITERATOR = "// std/iterator: lazy and eager operators over generators (D118 item 1).\n//\n// A lazy operator is a generator function: it does no work until the result is\n// resumed, and it keeps its callback, so the callback is `escaping`. An eager\n// operator runs the source to its end or to the first answer, with a callback\n// that is not escaping. Every operator takes its source by value: a loop or a\n// resume inside it works on its own copy, and the caller's generator does not\n// move.\n\nimport * as Co from \"std/coroutine\"\nimport { Step } from \"std/coroutine\"\nimport * as Arrays from \"std/array\"\n\nexport function* map<T, U, effect E>(\n  source: Generator<T> uses E,\n  escaping transform: (value: T) => U uses E\n): Generator<U> uses E {\n  for (const value of source) {\n    yield transform(value)\n  }\n}\n\nexport function* filter<T, effect E>(\n  source: Generator<T> uses E,\n  escaping keep: (value: T) => bool uses E\n): Generator<T> uses E {\n  for (const value of source) {\n    if (keep(value)) {\n      yield value\n    }\n  }\n}\n\nexport function* flatMap<T, U, effect E>(\n  source: Generator<T> uses E,\n  escaping expand: (value: T) => Generator<U> uses E uses E, alloc\n): Generator<U> uses E, alloc {\n  for (const value of source) {\n    for (const inner of expand(value)) {\n      yield inner\n    }\n  }\n}\n\nexport function* take<T, effect E>(source: Generator<T> uses E, count: int): Generator<T> uses E {\n  // A count of 0 or less yields nothing and never resumes the source.\n  if (count <= 0) {\n    return\n  }\n  let taken = 0\n  for (const value of source) {\n    yield value\n    taken = taken + 1\n    if (taken >= count) {\n      return\n    }\n  }\n}\n\nexport function* drop<T, effect E>(source: Generator<T> uses E, count: int): Generator<T> uses E {\n  let skipped = 0\n  for (const value of source) {\n    if (skipped < count) {\n      skipped = skipped + 1\n    } else {\n      yield value\n    }\n  }\n}\n\nexport function* takeWhile<T, effect E>(\n  source: Generator<T> uses E,\n  escaping keep: (value: T) => bool uses E\n): Generator<T> uses E {\n  for (const value of source) {\n    if (!keep(value)) {\n      return\n    }\n    yield value\n  }\n}\n\nexport function* dropWhile<T, effect E>(\n  source: Generator<T> uses E,\n  escaping skip: (value: T) => bool uses E\n): Generator<T> uses E {\n  let dropping = true\n  for (const value of source) {\n    if (dropping && skip(value)) {\n      continue\n    }\n    dropping = false\n    yield value\n  }\n}\n\nexport function* enumerate<T, effect E>(source: Generator<T> uses E): Generator<#[int, T]> uses E {\n  let index = 0\n  for (const value of source) {\n    yield #[index, value]\n    index = index + 1\n  }\n}\n\nexport function* zip<A, B, effect E>(\n  first: Generator<A> uses E,\n  second: Generator<B> uses E\n): Generator<#[A, B]> uses E, alloc {\n  // A generator parameter cannot be `mutable`, so the second source is resumed\n  // through a local copy of its own.\n  let other = copy(second)\n  for (const value of first) {\n    const step = Co.resume(mutable other)\n    if (step is Step.Yielded(otherValue)) {\n      yield #[value, otherValue]\n    } else {\n      return\n    }\n  }\n}\n\nexport function* concat<T, effect E>(\n  first: Generator<T> uses E,\n  second: Generator<T> uses E\n): Generator<T> uses E {\n  for (const value of first) {\n    yield value\n  }\n  for (const value of second) {\n    yield value\n  }\n}\n\nexport function chunk<T>(\n  source: Generator<T> uses alloc,\n  size: int,\n): Option<Generator<Array<T>> uses alloc> uses alloc {\n  // A size below 1 has no chunks to yield. The source has no effect variable: one\n  // inside the Option of the result would not be bound at the call.\n  if (size < 1) {\n    return None\n  }\n  return Some(chunkFrom(source, size))\n}\n\nfunction* chunkFrom<T>(source: Generator<T> uses alloc, size: int): Generator<Array<T>> uses alloc {\n  // The last chunk may be shorter than size; an empty source yields none.\n  let current: Array<T> = []\n  for (const value of source) {\n    Arrays.push(mutable current, value)\n    if (Arrays.length(current) == size) {\n      yield current\n      current = []\n    }\n  }\n  if (Arrays.length(current) > 0) {\n    yield current\n  }\n}\n\nexport function window<T>(\n  source: Generator<T> uses alloc,\n  size: int,\n): Option<Generator<Array<T>> uses alloc> uses alloc {\n  // A size below 1 has no windows to yield.\n  if (size < 1) {\n    return None\n  }\n  return Some(windowFrom(source, size))\n}\n\nfunction* windowFrom<T>(\n  source: Generator<T> uses alloc,\n  size: int,\n): Generator<Array<T>> uses alloc {\n  // Each window is the last size values; a source shorter than size yields none.\n  let recent: Array<T> = []\n  for (const value of source) {\n    Arrays.push(mutable recent, value)\n    if (Arrays.length(recent) > size) {\n      recent = withoutFirst(recent)\n    }\n    if (Arrays.length(recent) == size) {\n      yield recent\n    }\n  }\n}\n\nfunction withoutFirst<T>(values: Array<T>): Array<T> from values uses alloc {\n  let rest: Array<T> = Arrays.withCapacity(Arrays.length(values))\n  let index = 1\n  while (index < Arrays.length(values)) {\n    Arrays.push(mutable rest, values[index])\n    index = index + 1\n  }\n  return rest\n}\n\nexport function reduce<T, U, effect E>(\n  source: Generator<T> uses E,\n  combine: (total: U, value: T) => U uses E,\n  initial: U,\n): U from initial uses E {\n  let total = initial\n  for (const value of source) {\n    total = combine(total, value)\n  }\n  return total\n}\n\nexport function toArray<T, effect E>(\n  source: Generator<T> uses E\n): Array<T> from source uses E, alloc {\n  let values: Array<T> = []\n  for (const value of source) {\n    Arrays.push(mutable values, value)\n  }\n  return values\n}\n\nexport function forEach<T, effect E>(\n  source: Generator<T> uses E,\n  visit: (value: T) => void uses E\n) uses E {\n  for (const value of source) {\n    visit(value)\n  }\n}\n\nexport function some<T, effect E>(\n  source: Generator<T> uses E,\n  predicate: (value: T) => bool uses E\n): bool uses E {\n  for (const value of source) {\n    if (predicate(value)) {\n      return true\n    }\n  }\n  return false\n}\n\nexport function every<T, effect E>(\n  source: Generator<T> uses E,\n  predicate: (value: T) => bool uses E\n): bool uses E {\n  for (const value of source) {\n    if (!predicate(value)) {\n      return false\n    }\n  }\n  return true\n}\n\nexport function find<T, effect E>(\n  source: Generator<T> uses E,\n  predicate: (value: T) => bool uses E\n): Option<T> from source uses E {\n  for (const value of source) {\n    if (predicate(value)) {\n      return Some(value)\n    }\n  }\n  return None\n}\n\nexport function count<T, effect E>(source: Generator<T> uses E): int uses E {\n  let total = 0\n  for (const _value of source) {\n    total = total + 1\n  }\n  return total\n}\n"

const STD_JSON = "// std/json: parse and stringify JSON text (RFC 8259) as a Value of std/shape.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Char from \"std/char\"\nimport * as Float from \"std/float\"\nimport * as Arrays from \"std/array\"\nimport * as Maps from \"std/map\"\nimport * as FloatText from \"std/internal/float\"\nimport { Value, Shape } from \"std/shape\"\n\n// Containers nested deeper than this are an error, so the recursion is bounded.\nconst MAX_DEPTH = 512\n\nstruct Parser {\n  text: string\n  length: int\n  position: int\n}\n\n// parse reads one JSON value. Errors read `<line>:<column>: <reason>`.\nexport function parse(text: string): Result<Value, string> uses alloc {\n  let parser = Parser { text: text, length: Str.length(text), position: 0 }\n  skipSpace(mutable parser)\n  const value = parseValue(mutable parser, 0)\n  if (value is Err(message)) {\n    return Err(message)\n  }\n  skipSpace(mutable parser)\n  if (parser.position < parser.length) {\n    return fail(parser, parser.position, \"unexpected character after the value\")\n  }\n  return Ok(value.value)\n}\n\n// stringify writes a value as compact JSON text. A non-finite Float is null.\nexport function stringify(value: Value): string uses alloc {\n  let builder = Str.builder()\n  writeValue(mutable builder, value)\n  return Str.build(builder)\n}\n\n// fail builds the error for the byte at position, as line:column: reason.\nfunction fail<T>(parser: Parser, position: int, reason: string): Result<T, string> uses alloc {\n  let line = 1\n  let column = 1\n  let index = 0\n  while (index < position && index < parser.length) {\n    const byte = Str.byteAt(parser.text, index)\n    if (byte == 10) {\n      line += 1\n      column = 1\n    } else if (byte < 128 || byte >= 192) {\n      column += 1\n    }\n    index += 1\n  }\n  if (position >= parser.length) {\n    return Err(`\${Int.toString(line)}:\${Int.toString(column)}: unexpected end of input`)\n  }\n  return Err(`\${Int.toString(line)}:\${Int.toString(column)}: \${reason}`)\n}\n\nfunction cutText(text: string, start: int, end: int): string uses alloc {\n  if (Str.slice(text, start, end) is Some(piece)) {\n    return piece\n  }\n  panic(\"cutText: the range is outside the text\")\n}\n\nfunction skipSpace(mutable parser: Parser) {\n  while (parser.position < parser.length) {\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte != 32 && byte != 9 && byte != 10 && byte != 13) {\n      return\n    }\n    parser.position += 1\n  }\n}\n\nfunction parseValue(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (parser.position >= parser.length) {\n    return fail(parser, parser.position, \"expected a value\")\n  }\n  const byte = Str.byteAt(parser.text, parser.position)\n  if (byte == 123) {\n    return parseRecord(mutable parser, depth + 1)\n  }\n  if (byte == 91) {\n    return parseList(mutable parser, depth + 1)\n  }\n  if (byte == 34) {\n    const text = parseString(mutable parser)\n    if (text is Err(message)) {\n      return Err(message)\n    }\n    return Ok(Value.Text(text.value))\n  }\n  if (byte == 45 || (byte >= 48 && byte <= 57)) {\n    return parseNumber(mutable parser)\n  }\n  if (readWord(mutable parser, \"true\")) {\n    return Ok(Value.Bool(true))\n  }\n  if (readWord(mutable parser, \"false\")) {\n    return Ok(Value.Bool(false))\n  }\n  if (readWord(mutable parser, \"null\")) {\n    return Ok(Value.Null)\n  }\n  return fail(parser, parser.position, \"expected a value\")\n}\n\n// readWord consumes word when the text continues with it. It compares bytes,\n// because a slice of the text could end inside a multibyte character.\nfunction readWord(mutable parser: Parser, word: string): bool {\n  const count = Str.length(word)\n  if (parser.position + count > parser.length) {\n    return false\n  }\n  let index = 0\n  while (index < count) {\n    if (Str.byteAt(parser.text, parser.position + index) != Str.byteAt(word, index)) {\n      return false\n    }\n    index += 1\n  }\n  parser.position += count\n  return true\n}\n\nfunction parseList(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return fail(parser, parser.position, \"nesting is deeper than 512\")\n  }\n  // Skip the [.\n  parser.position += 1\n  let items: Array<Value> = []\n  skipSpace(mutable parser)\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 93) {\n    parser.position += 1\n    return Ok(Value.List(items))\n  }\n  while (true) {\n    skipSpace(mutable parser)\n    const item = parseValue(mutable parser, depth)\n    if (item is Err(message)) {\n      return Err(message)\n    }\n    Arrays.push(mutable items, item.value)\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"expected , or ]\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    parser.position += 1\n    if (byte == 93) {\n      return Ok(Value.List(items))\n    }\n    if (byte != 44) {\n      return fail(parser, parser.position - 1, \"expected , or ]\")\n    }\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\nfunction parseRecord(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return fail(parser, parser.position, \"nesting is deeper than 512\")\n  }\n  // Skip the {.\n  parser.position += 1\n  let fields: Map<string, Value> = Map {}\n  skipSpace(mutable parser)\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 125) {\n    parser.position += 1\n    return Ok(Value.Record(fields))\n  }\n  while (true) {\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length || Str.byteAt(parser.text, parser.position) != 34) {\n      return fail(parser, parser.position, \"expected a string key\")\n    }\n    const key = parseString(mutable parser)\n    if (key is Err(message)) {\n      return Err(message)\n    }\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length || Str.byteAt(parser.text, parser.position) != 58) {\n      return fail(parser, parser.position, \"expected :\")\n    }\n    parser.position += 1\n    skipSpace(mutable parser)\n    const field = parseValue(mutable parser, depth)\n    if (field is Err(message)) {\n      return Err(message)\n    }\n    // The last duplicate wins; an existing key keeps its place.\n    fields[key.value] = field.value\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"expected , or }\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    parser.position += 1\n    if (byte == 125) {\n      return Ok(Value.Record(fields))\n    }\n    if (byte != 44) {\n      return fail(parser, parser.position - 1, \"expected , or }\")\n    }\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\nfunction isDigit(byte: int): bool {\n  return byte >= 48 && byte <= 57\n}\n\n// skipDigits moves past a run of digits and says how many there were.\nfunction skipDigits(mutable parser: Parser): int {\n  let count = 0\n  while (parser.position < parser.length && isDigit(Str.byteAt(parser.text, parser.position))) {\n    parser.position += 1\n    count += 1\n  }\n  return count\n}\n\nfunction parseNumber(mutable parser: Parser): Result<Value, string> uses alloc {\n  const start = parser.position\n  let isFloat = false\n  if (Str.byteAt(parser.text, parser.position) == 45) {\n    parser.position += 1\n  }\n  // Integer part: 0, or a nonzero digit and more digits.\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 48) {\n    parser.position += 1\n  } else if (skipDigits(mutable parser) == 0) {\n    return fail(parser, parser.position, \"invalid number\")\n  }\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 46) {\n    isFloat = true\n    parser.position += 1\n    if (skipDigits(mutable parser) == 0) {\n      return fail(parser, parser.position, \"invalid number\")\n    }\n  }\n  if (parser.position < parser.length) {\n    const marker = Str.byteAt(parser.text, parser.position)\n    if (marker == 101 || marker == 69) {\n      isFloat = true\n      parser.position += 1\n      if (parser.position < parser.length) {\n        const sign = Str.byteAt(parser.text, parser.position)\n        if (sign == 43 || sign == 45) {\n          parser.position += 1\n        }\n      }\n      if (skipDigits(mutable parser) == 0) {\n        return fail(parser, parser.position, \"invalid number\")\n      }\n    }\n  }\n  const digits = cutText(parser.text, start, parser.position)\n  if (!isFloat) {\n    // An integer outside int becomes a Float.\n    const whole = Int.parse(digits, 10)\n    if (whole is Ok(number)) {\n      return Ok(Value.Int(number))\n    }\n  }\n  return Ok(Value.Float(FloatText.parse(digits)))\n}\n\n// The value of a hexadecimal digit, or -1.\nfunction hexValue(byte: int): int {\n  if (byte >= 48 && byte <= 57) {\n    return byte - 48\n  }\n  if (byte >= 97 && byte <= 102) {\n    return byte - 87\n  }\n  if (byte >= 65 && byte <= 70) {\n    return byte - 55\n  }\n  return -1\n}\n\n// readHex4 reads the four hex digits at parser.position.\nfunction readHex4(mutable parser: Parser): Result<int, string> uses alloc {\n  let code = 0\n  let count = 0\n  while (count < 4) {\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const digit = hexValue(Str.byteAt(parser.text, parser.position))\n    if (digit < 0) {\n      return fail(parser, parser.position, \"invalid \\\\u escape\")\n    }\n    code = code * 16 + digit\n    parser.position += 1\n    count += 1\n  }\n  return Ok(code)\n}\n\n// parseString reads a string whose opening quote is at parser.position.\nfunction parseString(mutable parser: Parser): Result<string, string> uses alloc {\n  parser.position += 1\n  let builder = Str.builder()\n  // The start of the plain bytes not yet copied.\n  let runStart = parser.position\n  while (true) {\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte == 34) {\n      Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n      parser.position += 1\n      return Ok(Str.build(builder))\n    }\n    if (byte < 32) {\n      return fail(parser, parser.position, \"control character in string\")\n    }\n    if (byte != 92) {\n      parser.position += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n    parser.position += 1\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const escape = Str.byteAt(parser.text, parser.position)\n    const escapeAt = parser.position - 1\n    parser.position += 1\n    if (escape == 117) {\n      const unit = readHex4(mutable parser)\n      if (unit is Err(message)) {\n        return Err(message)\n      }\n      const code = readCodePoint(mutable parser, unit.value, escapeAt)\n      if (code is Err(message)) {\n        return Err(message)\n      }\n      if (Char.fromCode(code.value) is Some(character)) {\n        Str.appendChar(mutable builder, character)\n      }\n    } else {\n      const simple = simpleEscape(escape)\n      if (simple == \"\") {\n        return fail(parser, escapeAt, \"invalid escape\")\n      }\n      Str.append(mutable builder, simple)\n    }\n    runStart = parser.position\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\n// The text for the escape letter after a backslash, or \"\".\nfunction simpleEscape(letter: int): string uses alloc {\n  if (letter == 34) {\n    return \"\\\"\"\n  }\n  if (letter == 92) {\n    return \"\\\\\"\n  }\n  if (letter == 47) {\n    return \"/\"\n  }\n  if (letter == 98) {\n    return controlText(8)\n  }\n  if (letter == 102) {\n    return controlText(12)\n  }\n  if (letter == 110) {\n    return \"\\n\"\n  }\n  if (letter == 114) {\n    return \"\\r\"\n  }\n  if (letter == 116) {\n    return \"\\t\"\n  }\n  return \"\"\n}\n\nfunction controlText(code: int): string uses alloc {\n  if (Char.fromCode(code) is Some(character)) {\n    return Str.fromChar(character)\n  }\n  return \"\"\n}\n\n// readCodePoint joins a surrogate pair; a lone surrogate is an error at escapeAt.\nfunction readCodePoint(\n  mutable parser: Parser,\n  unit: int,\n  escapeAt: int,\n): Result<int, string> uses alloc {\n  if (unit >= 56320 && unit <= 57343) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  if (unit < 55296 || unit > 56319) {\n    return Ok(unit)\n  }\n  // A high surrogate needs \\u and a low surrogate right after it.\n  if (!readWord(mutable parser, \"\\\\u\")) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  const low = readHex4(mutable parser)\n  if (low is Err(message)) {\n    return Err(message)\n  }\n  if (low.value < 56320 || low.value > 57343) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  return Ok(65536 + (unit - 55296) * 1024 + (low.value - 56320))\n}\n\nfunction writeValue(mutable builder: StringBuilder, value: Value) uses alloc {\n  match (value) {\n    Value.Null => Str.append(mutable builder, \"null\")\n    Value.Bool(flag) => {\n      if (flag) {\n        Str.append(mutable builder, \"true\")\n      } else {\n        Str.append(mutable builder, \"false\")\n      }\n    }\n    Value.Int(number) => Str.append(mutable builder, Int.toString(number))\n    Value.Float(number) => {\n      // NaN and infinities have no JSON form; JSON.stringify writes null.\n      if (number - number != 0.0) {\n        Str.append(mutable builder, \"null\")\n      } else {\n        Str.append(mutable builder, floatText(number))\n      }\n    }\n    Value.Text(text) => writeString(mutable builder, text)\n    Value.List(items) => {\n      Str.append(mutable builder, \"[\")\n      let first = true\n      for (const item of Arrays.values(items)) {\n        if (!first) {\n          Str.append(mutable builder, \",\")\n        }\n        first = false\n        writeValue(mutable builder, item)\n      }\n      Str.append(mutable builder, \"]\")\n    }\n    Value.Record(fields) => {\n      Str.append(mutable builder, \"{\")\n      let first = true\n      for (const entry of Maps.entries(fields)) {\n        const #[key, field] = entry\n        if (!first) {\n          Str.append(mutable builder, \",\")\n        }\n        first = false\n        writeString(mutable builder, key)\n        Str.append(mutable builder, \":\")\n        writeValue(mutable builder, field)\n      }\n      Str.append(mutable builder, \"}\")\n    }\n  }\n}\n\n// floatText writes a finite Float. A whole number below 1e15 reads as digits and\n// \".0\" (Float.toString would write 1e+02 for 100.0); the rest keeps its shortest text.\nfunction floatText(number: f64): string uses alloc {\n  if (number > -1000000000000000.0 && number < 1000000000000000.0) {\n    if (Float.truncate(number) is Some(whole)) {\n      if (Float.fromInt(whole) == number) {\n        return `\${Int.toString(whole)}.0`\n      }\n    }\n  }\n  return Float.toString(number)\n}\n\nfunction writeString(mutable builder: StringBuilder, text: string) uses alloc {\n  Str.append(mutable builder, \"\\\"\")\n  const length = Str.length(text)\n  // The start of the bytes that need no escape and are not yet copied.\n  let runStart = 0\n  let index = 0\n  while (index < length) {\n    const byte = Str.byteAt(text, index)\n    if (byte >= 32 && byte != 34 && byte != 92) {\n      index += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(text, runStart, index))\n    Str.append(mutable builder, escapeByte(byte))\n    index += 1\n    runStart = index\n  }\n  Str.append(mutable builder, cutText(text, runStart, length))\n  Str.append(mutable builder, \"\\\"\")\n}\n\n// The JSON escape for a quote, a backslash or a control character.\nfunction escapeByte(byte: int): string uses alloc {\n  if (byte == 34) {\n    return \"\\\\\\\"\"\n  }\n  if (byte == 92) {\n    return \"\\\\\\\\\"\n  }\n  if (byte == 10) {\n    return \"\\\\n\"\n  }\n  if (byte == 13) {\n    return \"\\\\r\"\n  }\n  if (byte == 9) {\n    return \"\\\\t\"\n  }\n  if (byte == 8) {\n    return \"\\\\b\"\n  }\n  if (byte == 12) {\n    return \"\\\\f\"\n  }\n  const hex = Int.toHex(byte)\n  if (Str.repeat(\"0\", 4 - Str.length(hex)) is Some(padding)) {\n    return `\\\\u\${padding}\${hex}`\n  }\n  return `\\\\u\${hex}`\n}\n\n// encode writes any value that implements Shape as compact JSON text.\nexport function encode<T: Shape>(value: T): string uses alloc {\n  return stringify(Shape.toValue(value))\n}\n\n// decode reads JSON text as a T: `Json.decode<User>(text)`. A parse error is\n// passed through; a shape error reads `<path>: <reason>` (see std/shape).\nexport function decode<T: Shape>(text: string): Result<T, string> uses alloc {\n  const value = parse(text)\n  if (value is Err(message)) {\n    return Err(message)\n  }\n  return Shape.fromValue<T>(value.value)\n}\n"

const STD_MATH = "// std/math: the usual number functions. The float functions are the ones of C's math.h.\n\nimport * as Float from \"std/float\"\nimport * as Libm from \"std/internal/math\"\n\nexport const PI: f64 = 3.141592653589793\nexport const E: f64 = 2.718281828459045\n\nexport function abs(value: int): int {\n  if (value < 0) {\n    return 0 - value\n  }\n  return value\n}\n\nexport function absFloat(value: f64): f64 {\n  if (value < 0.0) {\n    return 0.0 - value\n  }\n  return value\n}\n\nexport function min<T: Ordered>(first: T, second: T): T from first {\n  return match (Ordered.compare(second, first)) { Ordering.Less => copy(second), _ => first }\n}\n\nexport function max<T: Ordered>(first: T, second: T): T from first {\n  return match (Ordered.compare(second, first)) { Ordering.Greater => copy(second), _ => first }\n}\n\nexport function clamp<T: Ordered>(value: T, low: T, high: T): Option<T> from value {\n  if (Ordered.compare(low, high) is Ordering.Greater) {\n    return None\n  }\n  return Some(min(max(value, low), high))\n}\n\nexport function pow(base: f64, exponent: f64): f64 {\n  return Libm.pow(base, exponent)\n}\n\nexport function powInt(base: int, exponent: int): Option<int> {\n  if (exponent < 0) {\n    return None\n  }\n  let result = 1\n  let factor = base\n  let remaining = exponent\n  while (remaining > 0) {\n    if (remaining % 2 == 1) {\n      result *= factor\n    }\n    remaining /= 2\n    if (remaining > 0) {\n      factor *= factor\n    }\n  }\n  return Some(result)\n}\n\nexport function sqrt(value: f64): f64 {\n  return Float.sqrt(value)\n}\n\nexport function floor(value: f64): f64 {\n  return Libm.floor(value)\n}\n\nexport function ceil(value: f64): f64 {\n  return Libm.ceil(value)\n}\n\nexport function round(value: f64): f64 {\n  return Libm.round(value)\n}\n\nexport function trunc(value: f64): f64 {\n  return Libm.trunc(value)\n}\n\nexport function sin(value: f64): f64 {\n  return Libm.sin(value)\n}\n\nexport function cos(value: f64): f64 {\n  return Libm.cos(value)\n}\n\nexport function tan(value: f64): f64 {\n  return Libm.tan(value)\n}\n\nexport function atan2(y: f64, x: f64): f64 {\n  return Libm.atan2(y, x)\n}\n\nexport function exp(value: f64): f64 {\n  return Libm.exp(value)\n}\n\nexport function log(value: f64): f64 {\n  return Libm.log(value)\n}\n"

const STD_OPTION = "// std/option: helpers over the prelude Option.\n\n@inline\nexport function map<T, U, effect E>(\n  option: Option<T>,\n  f: (value: T) => U uses E\n): Option<U> uses alloc, E {\n  return match (option) { Some(value) => Some(f(value)), None => None }\n}\n\n@inline\nexport function andThen<T, U, effect E>(\n  option: Option<T>,\n  f: (value: T) => Option<U> uses E\n): Option<U> uses E {\n  return match (option) { Some(value) => f(value), None => None }\n}\n\nexport function withDefault<T>(option: Option<T>, fallback: T): T from option {\n  return match (option) { Some(value) => value, None => copy(fallback) }\n}\n\n@inline\nexport function orElse<T, effect E>(\n  option: Option<T>,\n  f: () => Option<T> uses E\n): Option<T> from option uses E {\n  return match (option) { Some(_) => option, None => f() }\n}\n\nexport function isSome<T>(option: Option<T>): bool {\n  return option is Some(_)\n}\n\nexport function isNone<T>(option: Option<T>): bool {\n  return option is None\n}\n\nexport function okOr<T, F>(option: Option<T>, error: F): Result<T, F> from option uses alloc {\n  return match (option) { Some(value) => Ok(value), None => Err(copy(error)) }\n}\n"

const STD_RANDOM = "// std/random: a seeded generator, SplitMix64. The same seed gives the same numbers on every\n// run and every platform. It is fast and small and it is not for cryptography.\n\nimport * as Arrays from \"std/array\"\nimport * as Int from \"std/int\"\nimport * as Ranges from \"std/range\"\nimport * as U64 from \"std/u64\"\nimport * as Float from \"std/float\"\nimport * as Entropy from \"std/internal/entropy\"\n\nexport struct Random {\n  state: u64\n}\n\nexport function seeded(seed: int): Random {\n  return Random { state: U64.wrap(seed) }\n}\n\nexport function fromSystem(): Random uses io {\n  return seeded(Entropy.seed())\n}\n\nexport function nextBits(mutable random: Random): u64 {\n  random.state += 0x9E3779B97F4A7C15\n  let mixed = random.state\n  mixed = (mixed ^ (mixed >> 30)) * 0xBF58476D1CE4E5B9\n  mixed = (mixed ^ (mixed >> 27)) * 0x94D049BB133111EB\n  return mixed ^ (mixed >> 31)\n}\n\nexport function nextInt(mutable random: Random, low: int, high: int): Option<int> {\n  if (low >= high) {\n    return None\n  }\n  const span = U64.wrap(high) - U64.wrap(low)\n  if (span == 0) {\n    return Some(low)\n  }\n  const limit = (0 - span) % span\n  let bits = nextBits(mutable random)\n  while (bits < limit) {\n    bits = nextBits(mutable random)\n  }\n  return Some(Int.wrap(U64.wrap(low) + bits % span))\n}\n\nexport function nextFloat(mutable random: Random): f64 {\n  const bits = nextBits(mutable random) >> 11\n  return Float.from(bits) / 9007199254740992.0\n}\n\nexport function shuffle<T>(mutable random: Random, mutable items: Array<T>) {\n  const length = Arrays.length(items)\n  for (const step of Ranges.upTo(length - 1)) {\n    const position = length - 1 - step\n    if (nextInt(mutable random, 0, position + 1) is Some(other)) {\n      const held = items[position]\n      items[position] = items[other]\n      items[other] = held\n    }\n  }\n}\n"

const STD_REGEX = "// std/regex: regular expressions with a linear-time engine (D118 item 6).\n//\n// The syntax is JavaScript's without back references and lookaround: literals\n// and escapes, `.`, classes, `\\d`, `\\w`, `\\s` and their negations, `\\u{...}`,\n// anchors `^`, `\$`, `\\b`, `\\B`, groups `(...)`, `(?:...)`, `(?<name>...)`,\n// alternation and the repeats `*`, `+`, `?`, `{n}`, `{n,}`, `{n,m}` (at most\n// 1000) with their lazy forms. Flags are written in the pattern as RE2 does:\n// `(?i)`, `(?m)`, `(?s)`, or `(?i:...)` for one group; `(?i)` folds ASCII\n// letters only. A pattern compiles to a program that a Pike VM runs over the\n// code points of the text, so a search takes time linear in the text times\n// the program, and matches are leftmost-first with captures, as in RE2.\n// Offsets are byte offsets, as `Str.indexOf` returns them.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Arrays from \"std/array\"\nimport * as Char from \"std/char\"\n\n// A repeat count above this is an error.\nconst MAX_REPEAT = 1000\n// A program longer than this is an error.\nconst MAX_PROGRAM = 10000\n// Groups nested deeper than this are an error.\nconst MAX_DEPTH = 1000\n// A program whose length times its slots (two per group, one per repeat) is\n// above this is an error: each thread list holds that many ints.\nconst MAX_THREAD_SLOTS = 1000000\n// The largest code point.\nconst MAX_CODE = 1114111\n\n// The kinds of an Assert instruction.\nconst TEXT_START = 0\nconst TEXT_END = 1\nconst LINE_START = 2\nconst LINE_END = 3\nconst WORD_BOUNDARY = 4\nconst NOT_WORD_BOUNDARY = 5\n\nexport struct RegexError derives Show, Equatable {\n  position: int\n  reason: string\n}\n\nexport struct Match derives Show, Equatable {\n  start: int\n  end: int\n  text: string\n  // groups[0] is the whole match; a group that took no part in it is None.\n  groups: Array<Option<string>>\n  // The name of each group, \"\" for one without a name.\n  names: Array<string>\n}\n\n// The instructions of a program.\nenum Op derives Equatable {\n  // One code point: first is the code, second its other ASCII case or -1.\n  Char\n  // Any code point; first is 1 when line terminators match too.\n  Any\n  // A code point in ranges[first] to ranges[second], pairs of low and high.\n  Class\n  // Go on at first, and at second with lower priority.\n  Split\n  // Go on at first.\n  Jump\n  // Store the position in capture slot first.\n  Save\n  // Go on only when the assertion of kind first holds.\n  Assert\n  // Clear capture slots first up to second, at the start of a repeat's pass.\n  Reset\n  // Go on only when the position moved past the one in slot first: a pass of\n  // a repeat beyond its lower count may not match empty.\n  Progress\n  Match\n}\n\nexport struct Regex {\n  source: string\n  ops: Array<Op>\n  firsts: Array<int>\n  seconds: Array<int>\n  ranges: Array<int>\n  groupCount: int\n  // Capture slots, then one slot per repeat for its Progress check.\n  slotCount: int\n  names: Array<string>\n  // Text every match starts with, searched for before the machine runs.\n  prefix: string\n  // True when every match starts at offset 0.\n  anchored: bool\n}\n\n// The nodes of a parsed pattern.\nenum Kind derives Equatable {\n  Empty\n  Literal\n  AnyChar\n  Set\n  Assertion\n  Group\n  Concat\n  Alternate\n  Repeat\n}\n\n// A node of the pattern tree. Literal: value is the code, limit the other\n// case or -1. AnyChar: value is 1 with (?s). Assertion: value is the kind.\n// Group: value is the capture index. Repeat: value and limit are the counts\n// (limit -1 for no limit), and the groups inside it are groupStart + 1 to\n// groupEnd. Set: ranges holds sorted pairs of low and high.\nstruct Node {\n  kind: Kind\n  value: int\n  limit: int\n  greedy: bool\n  groupStart: int\n  groupEnd: int\n  children: Array<int>\n  ranges: Array<int>\n}\n\nstruct Parser {\n  pattern: string\n  length: int\n  position: int\n  nodes: Array<Node>\n  groupCount: int\n  names: Array<string>\n  ignoreCase: bool\n  multiline: bool\n  dotAll: bool\n  depth: int\n  failed: bool\n  errorPosition: int\n  reason: string\n}\n\nstruct Program {\n  ops: Array<Op>\n  firsts: Array<int>\n  seconds: Array<int>\n  ranges: Array<int>\n  tooLarge: bool\n  // The Progress slot of each repeat node, or -1 before it is compiled.\n  loopSlots: Array<int>\n  slotCount: int\n}\n\n// The state of one search: two thread lists that take turns, each with its\n// program counters and capture slots, and the stack of addThread.\nstruct Machine {\n  size: int\n  slots: int\n  pcs: Array<int>\n  captures: Array<int>\n  counts: Array<int>\n  marks: Array<int>\n  generations: Array<int>\n  generation: int\n  side: int\n  stackPcs: Array<int>\n  stackSlots: Array<int>\n  stackValues: Array<int>\n  stackTop: int\n  working: Array<int>\n  best: Array<int>\n}\n\n// compile parses a pattern into a Regex, or the first error in it.\nexport function compile(pattern: string): Result<Regex, RegexError> uses alloc {\n  let parser = Parser {\n    pattern: pattern,\n    length: Str.length(pattern),\n    position: 0,\n    nodes: [],\n    groupCount: 0,\n    names: [\"\"],\n    ignoreCase: false,\n    multiline: false,\n    dotAll: false,\n    depth: 0,\n    failed: false,\n    errorPosition: 0,\n    reason: \"\",\n  }\n  const root = parseAlternation(mutable parser)\n  if (!parser.failed && parser.position < parser.length) {\n    const position = parser.position\n    fail(mutable parser, position, \"unmatched ')'\")\n  }\n  if (parser.failed) {\n    return Err(RegexError { position: parser.errorPosition, reason: parser.reason })\n  }\n  let program = Program {\n    ops: [],\n    firsts: [],\n    seconds: [],\n    ranges: [],\n    tooLarge: false,\n    loopSlots: filledInts(-1, Arrays.length(parser.nodes)),\n    slotCount: (parser.groupCount + 1) * 2,\n  }\n  emit(mutable program, Op.Save, 0, 0)\n  compileNode(mutable program, parser.nodes, root)\n  emit(mutable program, Op.Save, 1, 0)\n  emit(mutable program, Op.Match, 0, 0)\n  if (program.tooLarge) {\n    return Err(RegexError {\n      position: 0,\n      reason: `the pattern compiles to more than \${Int.toString(MAX_PROGRAM)} instructions`,\n    })\n  }\n  if (Arrays.length(program.ops) * program.slotCount > MAX_THREAD_SLOTS) {\n    return Err(RegexError {\n      position: 0,\n      reason: `the pattern needs more than \${Int.toString(MAX_THREAD_SLOTS)} thread slots (instructions times groups and repeats)`,\n    })\n  }\n  return Ok(Regex {\n    source: pattern,\n    ops: program.ops,\n    firsts: program.firsts,\n    seconds: program.seconds,\n    ranges: program.ranges,\n    groupCount: parser.groupCount,\n    slotCount: program.slotCount,\n    names: parser.names,\n    prefix: findPrefix(parser.nodes, root),\n    anchored: startsAnchored(parser.nodes, root),\n  })\n}\n\n// checked compiles a pattern while the compiler runs. It may only be the\n// value of a top-level const (E1360), where a bad pattern is a compile error.\n@const\nexport function checked(pattern: string): Regex uses alloc {\n  const compiled = compile(pattern)\n  if (compiled is Err(error)) {\n    panic(`bad pattern \"\${shorten(pattern)}\" at \${Int.toString(error.position)}: \${error.reason}`)\n  }\n  return compiled.value\n}\n\n// shorten cuts a pattern longer than 60 bytes to its first 57 and \"...\".\nfunction shorten(pattern: string): string uses alloc {\n  if (Str.length(pattern) <= 60) {\n    return pattern\n  }\n  // Step back to a character boundary.\n  let end = 57\n  while (end > 0) {\n    if (Str.slice(pattern, 0, end) is Some(head)) {\n      return `\${head}...`\n    }\n    end -= 1\n  }\n  return \"...\"\n}\n\n// formatError writes an error as `<position>: <reason>`, the position being\n// the byte offset of the mistake in the pattern.\nexport function formatError(error: RegexError): string uses alloc {\n  return `\${Int.toString(error.position)}: \${error.reason}`\n}\n\n// matches reports whether the regex matches anywhere in the text.\nexport function matches(regex: Regex, text: string): bool uses alloc {\n  let machine = createMachine(regex)\n  return search(regex, mutable machine, text, 0)\n}\n\n// find returns the first match in the text.\nexport function find(regex: Regex, text: string): Option<Match> from regex uses alloc {\n  return findFrom(regex, text, 0)\n}\n\n// findFrom returns the first match that starts at or after the byte offset\n// start. A start inside a character moves to the next character; a start\n// outside the text finds nothing.\nexport function findFrom(\n  regex: Regex,\n  text: string,\n  start: int,\n): Option<Match> from regex uses alloc {\n  if (start < 0 || start > Str.length(text)) {\n    return None\n  }\n  let machine = createMachine(regex)\n  if (!search(regex, mutable machine, text, start)) {\n    return None\n  }\n  return Some(buildMatch(regex, text, machine.best))\n}\n\n// findAll yields every match from left to right, as `matchAll` does. After an\n// empty match the search goes on one character later.\nexport function* findAll(regex: Regex, text: string): Generator<Match> uses alloc {\n  let machine = createMachine(regex)\n  const length = Str.length(text)\n  let position = 0\n  while (position <= length) {\n    if (!search(regex, mutable machine, text, position)) {\n      return\n    }\n    const start = machine.best[0]\n    const end = machine.best[1]\n    yield buildMatch(regex, text, machine.best)\n    position = nextStart(text, start, end)\n  }\n}\n\n// group returns the text of a group; 0 is the whole match. A group that took\n// no part in the match, or one the pattern does not have, is None.\nexport function group(found: Match, index: int): Option<string> {\n  if (index < 0 || index >= Arrays.length(found.groups)) {\n    return None\n  }\n  return found.groups[index]\n}\n\n// namedGroup returns the text of the group written `(?<name>...)`.\nexport function namedGroup(found: Match, name: st