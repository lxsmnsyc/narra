// std/template: the parts type and the tag of tagged templates (SPEC.md section 2, D114).
//
// A tag whose first parameter is Raw gets the source text of each part, with
// no escape decoded; a tag whose first parameter is Array<string> gets the
// parts with their escapes decoded.

import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Str from "std/string"

export distinct type Raw = Array<string>

// TypeScript's String.raw: the parts as written, with the values between them.
@const
export function raw(parts: Raw, values: Array<string>): string uses alloc {
  const texts = Raw.toArray(parts)
  let builder = Str.builder()
  for (const index of Ranges.upTo(Arrays.length(texts))) {
    Str.append(mutable builder, texts[index])
    if (index < Arrays.length(values)) {
      Str.append(mutable builder, values[index])
    }
  }
  return Str.build(builder)
}
