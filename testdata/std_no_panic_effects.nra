import * as Int from "std/int"

// Some, Ok and Err of a small payload are stored inline, so these functions need no `alloc`.
export function wrap(base: int): Option<int> {
  return Some(base)
}

export function succeed(base: int): Result<int, int> {
  if (base < 0) {
    return Err(base)
  }
  return Ok(base)
}

export function run(args: Array<string>): int uses io, alloc {
  if (wrap(4) is Some(found)) {
    print(Int.toString(found))
  }
  if (succeed(-1) is Err(code)) {
    print(Int.toString(code))
  }
  return 0
}
