// std/option is Narra source: a call has the effects of its callback.
// pick declares no effects: orElse with a pure callback, isSome and
// withDefault stay pure (D58).
import * as Options from "std/option"
import * as Int from "std/int"

function half(n: int): Option<int> {
  if (n % 2 == 0) {
    return Some(n / 2)
  }
  return None
}

export function pick(o: Option<int>, other: Option<int>): int {
  const chosen = Options.orElse(o, () => other)
  if (Options.isSome(chosen)) {
    return Options.withDefault(chosen, 0)
  }
  return 0 - 1
}

// step allocates through its callback, which calls half.
export function step(o: Option<int>): Option<int> uses alloc {
  const k = 3
  return Options.andThen(o, (x) => half(x + k))
}

export function run(args: Array<string>): int {
  print(Int.toString(pick(Some(1), None)))
  print(Int.toString(pick(None, Some(2))))
  print(Int.toString(pick(None, None)))
  print(Int.toString(Options.withDefault(step(Some(1)), 0 - 1)))
  print(Int.toString(Options.withDefault(step(Some(2)), 0 - 1)))
  return 0
}
