import * as Int from "std/int"

function describe(count: int): string uses alloc {
  return `<${Int.toString(count)}>`
}

export function run(args: Array<string>): int uses io, alloc {
  const empty = ""
  const word = "héllo wörld ✓"
  const count = 42
  const negative = -7
  print(`${word}`)
  print(`${empty}`)
  print(`one ${Int.toString(count)}`)
  print(`${Int.toString(count)}${Int.toString(negative)}`)
  print(`${empty}${empty}`)
  print(`[${empty}|${word}|${empty}]`)
  print(
    `${Int.toString(count)} and ${Int.toString(negative)} and ${word} and ${describe(count)}${describe(negative)} end ${Int.toString(count + 1)}`,
  )
  print(`${Int.toString(count)}-${word}-${describe(1)}`)
  print(`plain text`)
  let changing = "old"
  print(`${changing}|${{
      changing = "new"
      return changing
    }}`)
  changing = "old"
  print(`${changing}-${changing}|${{
      changing = "new"
      return changing
    }}`)
  return 0
}
