export const INTERNAL_ENTROPY_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Entropy.seed",
    module: "std/internal/entropy",
    key: "seed",
    parameters: [],
    result: "int",
    effects: ["io"],
  },
]

function checkCoResume<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  let count = 1
  if (name == "Co.resume") {
    count = 2
  }
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, count)) {
    return Type.TVoid
  }
  const found = checkExpression(mutable checker, walker, arguments[0].value, None)
  if (found is Type.TGenerator(element, _, _, _, input)) {
    checkMutableArgument(mutable checker, arguments[0].value)
    if (count == 2) {
      checkArgumentAgainst(mutable checker, walker, arguments[1].value, input)
    }
    checkExclusive(mutable checker, arguments, [0])
    return makePreludeEnum(mutable checker, "Option", [element])
  }
  // Only std/coroutine calls these, with the right arguments.
  panic(`internal error: ${name} needs a generator`)
  return Type.TVoid
}

function checkCellStore<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type uses alloc {
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 2)) {
    return Type.TVoid
  }
  const found = checkExpression(mutable checker, walker, arguments[0].value, None)
  if (found is Type.TBox(element)) {
    checkArgumentAgainst(mutable checker, walker, arguments[1].value, element)
    return Type.TVoid
  }
  // Only std/cell calls this, with a box.
  panic(`internal error: ${name} needs a box`)
  return Type.TVoid
}

export function checkInternalCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
): Type uses alloc {
  if (kind == "checkCellStore") {
    return checkCellStore(mutable checker, walker, pos, arguments, name)
  }
  if (kind == "checkCoResume") {
    return checkCoResume(mutable checker, walker, pos, arguments, name)
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
  return Type.TVoid
}

function emitCoResume<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  // Only a test build catches a panic of the coroutine.
  const optionType = readNodeType(emitter, nodeId)
  const generatorType = readNodeType(emitter, getExpressionId(arguments[0].value))
  let inputPointer = "NULL"
  let elementType = Type.TVoid
  if (generatorType is Type.TGenerator(element, _, _, _, input)) {
    elementType = element
    if (input != Type.TVoid) {
      const inputCode = argumentText(walker, mutable emitter, arguments, 1)
      inputPointer = `&${temp(mutable emitter, input, inputCode)}`
    }
  }
  const generator = EmitWalker.emitLvaluePointer(walker, mutable emitter, arguments[0].value)
  const elementName = cType(emitter.checker, elementType)
  emitter.tempCount++
  const outputName = `t${Int.toString(emitter.tempCount)}`
  const output = declareUnset(mutable emitter, elementName, outputName)
  emitter.tempCount++
  const statusName = `t${Int.toString(emitter.tempCount)}`
  const status = declareUnset(mutable emitter, "int", statusName)
  let guard = "false"
  if (emitter.tests) {
    guard = "true"
  }
  writeLine(
    mutable emitter,
    `${status} = narra_co_next(${generator}, &${output}, ${inputPointer}, ${guard});`,
  )
  const some = findVariant(emitter, optionType, "Some")
  const none = findVariant(emitter, optionType, "None")
  return ioEither(mutable emitter, optionType, `${status} > 0`, some, [output], none, [])
}

function emitCellStore<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
): Code uses alloc {
  const boxType = readNodeType(emitter, getExpressionId(arguments[0].value))
  if (boxType is Type.TBox(element)) {
    const boxCode = EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
    const box = temp(mutable emitter, boxType, boxCode.text)
    const valueCode = EmitWalker.emitExpression(walker, mutable emitter, arguments[1].value)
    const consumed = consume(mutable emitter, valueCode.text, valueCode.owned, element)
    // The old value is read after the new one is computed, which may have changed the slot.
    const previous = temp(mutable emitter, element, `${box}->f_value`)
    writeLine(mutable emitter, `${box}->f_value = ${consumed};`)
    const release = releaseCode(emitter, element, previous)
    if (release != "") {
      writeLine(mutable emitter, release)
    }
    return plain("((void)0)")
  }
  return plain(reportUnsupported(mutable emitter, "CellSlot.store needs a box", NODE))
}

export function emitInternalCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "CellSlot.store") {
    return emitCellStore(walker, mutable emitter, arguments)
  }
  if (name == "Co.next" || name == "Co.resume") {
    return emitCoResume(walker, mutable emitter, nodeId, arguments)
  }
  if (name == "Co.panicked") {
    return plain("narra_co_panicked")
  }
  if (name == "Co.panicMessage") {
    return owned(ownedTemp(mutable emitter, Type.TStr, "lstr_from_cstr(narra_panic_text)"))
  }
  if (name == "FloatText.parse") {
    const text = argumentText(walker, mutable emitter, arguments, 0)
    return plain(`strtod((${text})->data, NULL)`)
  }
  if (Str.startsWith(name, "Libm.")) {
    // The C function has the name of the key: Libm.floor calls floor.
    const fixed = FixedCall {
      name: name,
      call: Str.sliceFrom(name, 5),
      withPos: false,
      owned: false,
      temporary: false,
    }
    return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
  }
  if (name == "Clock.monotonicNanos") {
    return plain("narra_clock_monotonic_nanos()")
  }
  if (name == "Clock.wallMillis") {
    return plain("narra_clock_wall_millis()")
  }
  if (name == "Clock.sleepNanos") {
    const nanos = argumentText(walker, mutable emitter, arguments, 0)
    return plain(`narra_clock_sleep_nanos(${nanos})`)
  }
  if (name == "Entropy.seed") {
    return plain("narra_entropy_seed()")
  }
  if (name == "Probe.code") {
    const character = argumentText(walker, mutable emitter, arguments, 0)
    return plain(`((int64_t)${character})`)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
