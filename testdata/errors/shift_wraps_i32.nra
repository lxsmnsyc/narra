// error: shift_wraps_i32.nra:5:19: the shift count must be a constant from 0 to 31 or a name checked against both ends first; this constant is out of range
const WRAPS: i32 = 65536 * 65536 + 40

function shift(value: i32): i32 {
  return value << WRAPS
}

export function run(args: Array<string>): int {
  shift(1)
  return 0
}
