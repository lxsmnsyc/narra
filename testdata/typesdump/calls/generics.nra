struct Pair<A, B> {
  first: A
  second: B
}

function identity<T>(value: T): T from value {
  return value
}

function pair<A, B>(first: A, second: B): Pair<A, B> from first {
  return Pair { first: first, second: copy(second) }
}

function wrap<T>(value: T): Array<T> from value {
  return [identity(value)]
}

// ping and pong call each other's instances, so the order of the instance
// bodies follows discovery.
function ping<T>(value: T, depth: int): T from value {
  if (depth > 0) {
    return pong(value, depth - 1)
  }
  return value
}

function pong<U>(value: U, depth: int): U from value {
  if (depth > 0) {
    return ping(value, depth - 1)
  }
  return identity(value)
}

function swap<A, B>(item: Pair<A, B>): Pair<B, A> from item {
  return pair(item.second, item.first)
}

function first<T>(items: Array<T>): T from items {
  return items[0]
}

export function run(args: Array<string>): int {
  const number = identity(1)
  const word = identity("x")
  const again = identity(2)
  const nested = identity(identity(3))
  const both = pair(number, word)
  const swapped = swap(both)
  const _wrapped = wrap(true)
  const count = ping(4, 2)
  const _text = pong("y", 1)
  const expected: Array<int> = wrap(5)
  const _head = first(args)
  return number + again + nested + swapped.second + count + expected[0]
}
