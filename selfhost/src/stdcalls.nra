// The dispatch of the checks of the std functions. The check of each std module is
// in std<module>.nra. The registry names the check of a builtin in StdFunc.check; a
// name without a case panics, so a std function added without its check fails a
// test.
//
// This module sits above narrac/closures (the callbacks of the Option and Result
// helpers go through checkArrowArgument) and narrac/exprs, which reaches it
// through Walker.checkStdCall.
import { Type } from "narrac/types"
import { Checker, Walker } from "narrac/check"
import { Pos, Arg } from "narrac/ast"
import * as Str from "std/string"
import { checkArrayCall } from "narrac/stdarray"
import { checkBoxCall } from "narrac/stdbox"
import { checkPointerCall } from "narrac/stdptr"
import { checkInternalCall } from "narrac/stdinternal"
import { checkMapCall } from "narrac/stdmap"
import { checkRangeCall } from "narrac/stdrange"
import { checkResultCall } from "narrac/stdresult"
import { checkTestCall } from "narrac/stdtest"
import { checkSizedCall } from "narrac/stdsized"
import { checkF32Call } from "narrac/stdf32"

export function checkStdCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
  kind: string,
  want: Option<Type>,
): Type from want uses alloc {
  // Forward by the module the kind names. A new std module adds one case here.
  if (Str.startsWith(kind, "checkArray")) {
    return checkArrayCall(mutable checker, walker, pos, arguments, name, kind, want)
  }
  if (Str.startsWith(kind, "checkBox")) {
    return checkBoxCall(mutable checker, walker, pos, arguments, name, kind, want)
  }
  if (Str.startsWith(kind, "checkPtr")) {
    return checkPointerCall(mutable checker, walker, pos, arguments, name, kind, want)
  }
  if (Str.startsWith(kind, "checkCell")) {
    return copy(checkInternalCall(mutable checker, walker, pos, arguments, name, kind))
  }
  if (Str.startsWith(kind, "checkCo")) {
    return copy(checkInternalCall(mutable checker, walker, pos, arguments, name, kind))
  }
  if (Str.startsWith(kind, "checkMap")) {
    return copy(checkMapCall(mutable checker, walker, pos, arguments, name, kind))
  }
  if (Str.startsWith(kind, "checkRange")) {
    return checkRangeCall(mutable checker, walker, pos, arguments, name, kind)
  }
  if (Str.startsWith(kind, "checkResult")) {
    return copy(checkResultCall(mutable checker, walker, pos, arguments, name, kind, want))
  }
  if (Str.startsWith(kind, "checkTest")) {
    return checkTestCall(mutable checker, walker, pos, arguments, name, kind)
  }
  if (Str.startsWith(kind, "checkF32")) {
    return checkF32Call(mutable checker, walker, pos, arguments, name, kind)
  }
  if (Str.startsWith(kind, "checkSized")) {
    return copy(checkSizedCall(mutable checker, walker, pos, arguments, name, kind))
  }
  panic(`checkStdCall: no port of the check ${kind} (${name})`)
  return Type.TVoid
}
