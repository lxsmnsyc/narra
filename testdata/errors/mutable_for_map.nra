// error: `for (mutable ...)` changes the elements of an Array in place, found Map<string, Player>
struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players: Map<string, Player> = Map { "a": Player { hp: 3 } }
  for (mutable player of players) {
    player.hp = 0
  }
  return 0
}
