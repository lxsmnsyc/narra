import * as Int from "std/int"

struct Holder {
  action: (x: int) => int
}

function apply(f: (x: int) => int): int {
  return f(1)
}

function useMutable(mutable handlers: Array<(x: int) => int>): int {
  return handlers[0](1)
}

function swap(mutable _handlers: Array<(x: int) => int>): int {
  return 5
}

function reset(mutable _holder: Holder): int {
  return 5
}

function adder(n: int): (x: int) => int {
  return (x) => x + n
}

function generic<T>(value: T, f: (a: T) => T): T {
  return f(value)
}

function arity(): int {
  return apply((a, b) => a + b)
}

function untyped(): int {
  const f = (x) => x
  return 1
}

function captureLet(): int {
  let counter = 0
  const f = (x: int) => x + counter
  return 1
}

function captureMutableParam(mutable holder: Holder): int {
  const f = (x: int) => holder.action(x)
  return 1
}

function captureNoEscape(f: (x: int) => int): int {
  const g = (x: int) => f(x)
  return 1
}

function storeNoEscape(f: (x: int) => int): int {
  const g = f
  return 1
}

function notCallable(): int {
  const n = 3
  return n(1)
}

function callArity(): int {
  const f = adder(1)
  return f(1, 2)
}

function callMutable(): int {
  let f = adder(1)
  return f(mutable f)
}

function wrongArgument(): int {
  const f = adder(1)
  return f("a")
}

function calleeExclusive(): int {
  const handlers = [adder(1)]
  return handlers[0](swap(mutable handlers))
}

function fieldExclusive(): int {
  const holder = Holder { action: adder(1) }
  return holder.action(reset(mutable holder))
}

function returns(): int {
  const f = (x: int) => {
    if (x > 0) {
      return 1
    }
    return "no"
  }
  return 1
}

function mutableValue(): int {
  return apply(useMutable)
}

function badEscaping(escaping n: int): int {
  return n
}

function cannotTell(): int {
  return apply(identityOf)
}

function identityOf<T>(value: T): T from value {
  return value
}

function genericArity(): int {
  return generic(1, (a, b) => a)
}
