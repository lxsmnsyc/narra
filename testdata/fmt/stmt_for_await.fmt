async function* pairs(): AsyncGenerator<#[int, string]> {
  yield #[1, "one"]
}

async function read(): int {
  let total = 0
  for await (const pair of pairs()) {
    total += pair[0]
  }
  outer: for await (const #[index, name] of pairs()) {
    for await (const inner of pairs()) {
      break outer
    }
  }
  for /* before */ await (const pair of pairs()) {
    total += 1
  }
  for // line after for
  await (const pair of pairs()) {
    total += 1
  }
  return total
}
