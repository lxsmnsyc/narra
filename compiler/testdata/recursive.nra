import * as Int from "std/int"
import * as Boxes from "std/box"
import * as Ranges from "std/range"

// A recursive expression tree: enum variants with fields live on the heap.
enum Expr derives Show, Ordered {
  Num(value: int)
  Add(left: Expr, right: Expr)
  Mul(left: Expr, right: Expr)
  Neg(inner: Expr)
}

function eval(e: Expr): int {
  return match (e) {
    Expr.Num(v) => v
    Expr.Add(l, r) => eval(l) + eval(r)
    Expr.Mul(l, r) => eval(l) * eval(r)
    Expr.Neg(i) => -eval(i)
  }
}

function render(e: Expr): string {
  return match (e) {
    Expr.Num(v) => Int.toString(v)
    Expr.Add(l, r) => `(${render(l)} + ${render(r)})`
    Expr.Mul(l, r) => `(${render(l)} * ${render(r)})`
    Expr.Neg(i) => `-${render(i)}`
  }
}

// A linked list made with Box.
struct Node {
  value: int
  next: Option<Box<Node>>
}

function push(head: Option<Box<Node>>, v: int): Option<Box<Node>> {
  return Some(Boxes.new(Node { value: v, next: head }))
}

function sum(head: Option<Box<Node>>): int {
  let total = 0
  let cur = head
  while (true) {
    if (cur is Some(b)) {
      total = total + b.value.value
      cur = b.value.next
    } else {
      return total
    }
  }
  return total
}

// A list as a recursive enum, built deep to check the drop.
enum List {
  Nil
  Cons(head: int, tail: List)
}

function build(n: int): List {
  let l = List.Nil
  for (const i of Ranges.upTo(n)) {
    l = List.Cons(i, l)
  }
  return l
}

function length(l: List): int {
  let n = 0
  let cur = l
  while (true) {
    if (cur is List.Cons(_, t)) {
      n = n + 1
      cur = t
    } else {
      return n
    }
  }
  return n
}

function deep(n: int): Expr {
  let e = Expr.Num(1)
  for (const i of Ranges.upTo(n)) {
    e = Expr.Add(e, Expr.Num(i))
  }
  return e
}

export function run(args: Array<string>): int {
  const e = Expr.Add(Expr.Mul(Expr.Num(2), Expr.Num(3)), Expr.Neg(Expr.Num(4)))
  print(`${render(e)} = ${Int.toString(eval(e))}`)
  print(Show.show(e))
  assert(e == Expr.Add(Expr.Mul(Expr.Num(2), Expr.Num(3)), Expr.Neg(Expr.Num(4))))
  assert(e != Expr.Num(2))
  assert(Ordered.compare(Expr.Num(1), Expr.Num(2)) == Ordering.Less)

  let head: Option<Box<Node>> = None
  for (const i of Ranges.upTo(5)) {
    head = push(head, i + 1)
  }
  print(`sum = ${Int.toString(sum(head))}`)

  const b = Boxes.new(41)
  print(`box = ${Int.toString(b.value + 1)}`)
  const b2 = b
  assert(b == b2)

  print(`list length = ${Int.toString(length(build(1000000)))}`)
  print(`deep = ${Int.toString(eval(deep(2000)))}`)
  return 0
}
