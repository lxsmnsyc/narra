function patterns(s: Shape, o: Option<int>): int {
  const { first, second: sec } = pair
  const #[a, b] = tup
  const Wrap(inner) = w
  const Shape.Circle(r) = s
  let n = match (s) {
    Circle(r) => 1
    Shape.Rect(w, _) => 2
    Empty => 3
    Shape.Empty => 4
    Unit() => 5
    { name, kind: Kind(k) } => 6
    #[0, -1] => 7
    -1.5 => 8
    "str" => 9
    'c' => 10
    true => 11
    x => 12
  }
  return n
}
