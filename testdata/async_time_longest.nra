// The longest sleep: its deadline is past the clock's range, so it ends at the
// end of the range instead of wrapping around to the past. It is still
// sleeping when the entry returns, so the exit cancels it.
import * as Async from "std/async"
import * as AsyncTime from "std/async/time"
import * as Time from "std/time"

async function sleepsLongest(): int uses io, alloc {
  const slept = await AsyncTime.sleep(Time.nanoseconds(9223372036854775807))
  if (slept is Ok(_)) {
    print("longest sleep woke")
    return 1
  }
  print("longest sleep cancelled at exit")
  return 0
}

export async function run(_args: Array<string>): int {
  Async.detach(sleepsLongest())
  const short = await AsyncTime.sleep(Time.milliseconds(20))
  if (short is Ok(_)) {
    print("entry slept")
  }
  return 0
}
