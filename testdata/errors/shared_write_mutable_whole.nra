// error: reset(mutable board, ...) may change board.rows[0], which row still uses at line 17
import * as Arrays from "std/array"

struct Board {
  rows: Array<Array<int>>
}

function reset(mutable board: Board, size: int) uses alloc {
  board.rows = [match (Arrays.filled(size, 0)) { Some(filled) => filled, None => [0] }]
}

export function run(_args: Array<string>): int uses alloc {
  let board = Board { rows: [[1, 2]] }
  const row = board.rows[0]
  // `mutable board` may change board and everything inside it.
  reset(mutable board, 2)
  return row[0] + board.rows[0][0]
}
