// error: peek cannot take an Async<void>: type parameter T would be void outside Async<T>, and a task with no value gives none
import * as Async from "std/async"

async function work() {}

export async function run(_args: Array<string>): int {
  const handle = work()
  const peeked = Async.peek(handle)
  await handle
  return 0
}
