// @inline helpers whose bodies are copied into the calls of another module.
import * as Arrays from "std/array"

@inline
export function countWhere<T>(items: Array<T>, accept: (item: T) => bool): int {
  let count = 0
  for (const item of Arrays.values(items)) {
    if (accept(item)) {
      count++
    }
  }
  return count
}

@inline
export function orElse(value: Option<int>, fallback: () => int): int {
  if (value is Some(found)) {
    return found
  }
  return fallback()
}
