// error: this function's result shares its parameter 1, but the expected type (E1) => E1 has no matching from; add `from` naming that parameter to the expected type
enum E1 {
  A(next: E2)
  Z
}
enum E2 {
  A(next: E3)
  Z
}
enum E3 {
  A(next: E4)
  Z
}
enum E4 {
  A(next: E5)
  Z
}
enum E5 {
  A(next: E6)
  Z
}
enum E6 {
  F(items: Array<int>)
  Z
}

function same(value: E1): E1 from value {
  return value
}

struct Holder {
  pick: (E1) => E1
}

export function run(_args: Array<string>): int {
  const holder = Holder { pick: same }
  if (holder.pick(E1.Z) is E1.Z) {
    return 0
  }
  return 1
}
