// Four threads read a top-level array constant at once, before the main
// thread has. The first reader builds it under a lock and marks it shared;
// the others wait for it and read the same value.
import * as Thread from "std/thread"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Ranges from "std/range"
import * as Str from "std/string"

const NAMES = ["north", "east", "south", "west", "up-down"]

function countLetters(round: int): int {
  let total = round - round
  for (const name of Arrays.values(NAMES)) {
    total += Str.length(name)
  }
  return total
}

export function run(_args: Array<string>): int {
  const totals = Thread.scope((scope) => {
    let threads: Array<Thread.Thread<int>> = []
    for (const round of Ranges.between(0, 4)) {
      Arrays.push(mutable threads, Thread.start(scope, () => countLetters(round)))
    }
    let sum = 0
    for (const thread of Arrays.values(threads)) {
      sum += Thread.join(thread)
    }
    return sum
  })
  print(`letters ${Int.toString(totals)}, first ${NAMES[0]}, last ${NAMES[4]}`)
  return 0
}
