// error: let_narrowing_same_statement_for.nra:15:7: this Option<int> may hold any of its variants; check it with `is` or `match` before reading "value"
import * as Ranges from "std/range"

function clear(change: () => void): int {
  change()
  return 0
}

export function run(args: Array<string>): int {
  let x: Option<int> = Some(1)
  if (x is None) {
    return 0
  }
  for (const i of Ranges.upTo(
    x.value +
      clear(() => {
        x = None
      }),
  )) {
    print("b")
  }
  return 0
}
