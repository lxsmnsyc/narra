// error: "game.players[0].hp" cannot be used inside the loop that changes game.players in place; reach its elements through player, or write an index loop
struct Player {
  hp: int
}

struct Game {
  players: Array<Player>
  round: int
}

export function run(args: Array<string>): int {
  const game = Game { players: [Player { hp: 3 }], round: 1 }
  for (mutable player of game.players) {
    player.hp = game.round
    game.players[0].hp = 2
  }
  return 0
}
