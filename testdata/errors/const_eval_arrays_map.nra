// error: E1052, Arrays.map takes a function
import * as Arrays from "std/array"

@const
export function doubled(items: Array<int>): Array<int> uses alloc {
  return Arrays.map(items, double)
}

function double(value: int): int {
  return value * 2
}

export function run(args: Array<string>): int {
  return 0
}
