// warning: grid.rows[0][0] = ... may change grid, which first still uses at line 15
struct Grid {
  rows: Array<Array<int>>
}

function firstRow(grid: Grid): Array<int> from grid {
  return grid.rows[0]
}

export function run(_args: Array<string>): int uses alloc {
  let grid = Grid { rows: [[1, 2]] }
  // The result of firstRow shares its `from` argument.
  const first = firstRow(grid)
  grid.rows[0][0] = 9
  return first[0] + grid.rows[0][0]
}
