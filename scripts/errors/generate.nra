// Writes docs/reference/errors.md from `narrac explain --list --json`.
//
//   narrac run -release scripts/errors/generate.nra <narrac> > docs/reference/errors.md
//
// The argument is the narrac that lists the codes. The page goes to standard output.
// Each hundred of codes is a `##` group, and each code is a `####` heading, so the page
// outline lists the groups only and `#e0101` still links to a code. Explanation text is
// escaped, so a `<` or `|` in it cannot become markup; code spans stay as written.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Io from "std/io"
import * as Json from "std/json"
import * as Process from "std/process"
import * as Str from "std/string"

struct ErrorCode derives Shape {
  code: string
  messages: Array<string>
  explanation: Option<string>
}

// One name for each hundred of codes, E0000 to E0099 first. A code in a hundred past
// the end of the list stops the generator, so a new area gets a name here.
const AREA_NAMES = [
  "Lexer and parser",
  "Declarations and types",
  "Expressions and statements",
  "Calls and constructors",
  "Modules, packages and narra.toml",
  "Traits",
  "Closures and function values",
  "Patterns and match",
  "Effects",
  "Standard library",
  "C interop and unsafe code",
  "Concurrency",
  "Types and parameters: templates, defaults, refinements, effect lists, SIMD, ranges",
  "Standard library modules for tools",
  "Channels, Shared and Atomic",
  "Unreachable statements and unused let",
  "Build targets",
]

const INTRODUCTION = "# Errors\n\nEvery diagnostic code of `narrac`, with its message and, where there is one, its explanation. `narrac explain CODE` prints the same text. In a message, `%s`, `%q`, `%d`, `%c` and `%v` mark a name, text, number or character that the compiler fills in. A code with several messages is reported in several situations.\n\nThis page is generated by `scripts/errors/generate.nra` from `narrac explain --list --json`. Do not edit it.\n"

function readHundred(code: string): int {
  const digits = Str.slice(code, 1, 3)
  if (digits is Some(text)) {
    const parsed = Int.parse(text, 10)
    if (parsed is Ok(hundred)) {
      return hundred
    }
  }
  return -1
}

function isDigit(character: char): bool {
  return character >= '0' && character <= '9'
}

function isMarkdownPunctuation(character: char): bool {
  return (character == '\\' ||
    character == '<' ||
    character == '>' ||
    character == '&' ||
    character == '|' ||
    character == '*' ||
    character == '_' ||
    character == '[' ||
    character == ']')
}

function countBackticks(characters: Array<char>): int {
  let count = 0
  for (const character of Arrays.values(characters)) {
    if (character == '`') {
      count += 1
    }
  }
  return count
}

function escapeLine(line: string): string uses alloc {
  const characters = Str.chars(line)
  // Backticks pair into code spans only when their count is even; otherwise none is a span.
  const paired = countBackticks(characters) % 2 == 0
  const builder = Str.builder()
  let insideSpan = false
  let onlyDigits = true
  let position = 0
  for (const character of Arrays.values(characters)) {
    if (character == '`') {
      if (paired) {
        insideSpan = !insideSpan
        Str.appendChar(mutable builder, character)
      } else {
        Str.append(mutable builder, "\\`")
      }
    } else if (insideSpan) {
      Str.appendChar(mutable builder, character)
    } else if (isMarkdownPunctuation(character)) {
      Str.appendChar(mutable builder, '\\')
      Str.appendChar(mutable builder, character)
    } else if (position == 0 && (character == '#' || character == '-' || character == '+')) {
      // A line that starts with one of these would open a heading or a list.
      Str.appendChar(mutable builder, '\\')
      Str.appendChar(mutable builder, character)
    } else if (position > 0 && onlyDigits && (character == '.' || character == ')')) {
      // Digits and a dot at the start of a line would open a numbered list.
      Str.appendChar(mutable builder, '\\')
      Str.appendChar(mutable builder, character)
    } else {
      Str.appendChar(mutable builder, character)
    }
    if (!isDigit(character)) {
      onlyDigits = false
    }
    position += 1
  }
  return Str.build(builder)
}

function renderCode(entry: ErrorCode): string uses alloc {
  let text = `#### ${entry.code}\n\n\`\`\`text\n${Str.join(entry.messages, "\n")}\n\`\`\`\n`
  if (entry.explanation is Some(explanation)) {
    let paragraphs: Array<string> = []
    const lines = Str.split(explanation, "\n")
    if (lines is Some(parts)) {
      for (const part of Arrays.values(parts)) {
        Arrays.push(mutable paragraphs, escapeLine(part))
      }
    }
    text += `\n${Str.join(paragraphs, "\n\n")}\n`
  }
  return text
}

function renderPage(entries: Array<ErrorCode>): Result<string, string> uses alloc {
  // Every code needs a named hundred before anything is written.
  for (const entry of Arrays.values(entries)) {
    const known = readHundred(entry.code)
    if (known < 0 || known >= Arrays.length(AREA_NAMES)) {
      return Err(`${entry.code} is in a hundred with no name in AREA_NAMES`)
    }
  }

  // The groups go in order of their hundred, and the codes in each group in table order.
  let page = INTRODUCTION
  let hundred = 0
  for (const area of Arrays.values(AREA_NAMES)) {
    let rendered: Array<string> = []
    for (const entry of Arrays.values(entries)) {
      if (readHundred(entry.code) == hundred) {
        Arrays.push(mutable rendered, renderCode(entry))
      }
    }
    if (Arrays.length(rendered) > 0) {
      let prefix = Int.toString(hundred)
      if (hundred < 10) {
        prefix = `0${prefix}`
      }
      page += `\n## E${prefix}00 to E${prefix}99: ${area}\n\n${Str.join(rendered, "\n")}`
    }
    hundred += 1
  }
  return Ok(page)
}

export function run(args: Array<string>): int uses io, alloc {
  if (Arrays.length(args) != 2) {
    Io.writeError("usage: generate <narrac>\n")
    return 2
  }

  // The compiler lists its own codes.
  const ran = Process.run(args[1], ["explain", "--list", "--json"])
  if (ran is Err(message)) {
    Io.writeError(`generate: cannot run ${args[1]}: ${message}\n`)
    return 1
  }
  const #[code, output, errorOutput] = ran.value
  if (code != 0) {
    Io.writeError(`generate: ${args[1]} explain failed: ${errorOutput}\n`)
    return 1
  }
  const decoded = Json.decode<Array<ErrorCode>>(output)
  if (decoded is Err(message)) {
    Io.writeError(`generate: the list is not valid: ${message}\n`)
    return 1
  }

  const page = renderPage(decoded.value)
  if (page is Err(message)) {
    Io.writeError(`generate: ${message}\n`)
    return 1
  }
  Io.write(page.value)
  return 0
}
