import * as Int from "std/int"

export trait Label {
  function label(item: Self): string
}

export struct Item implements Label {
  count: int
}

implement Label for Item {
  function label(item: Item): string {
    return `u${Int.toString(item.count)}`
  }
}

export const NAME = "util"

export function render(count: int): string uses alloc {
  return Label.label(Item { count })
}

test "util text" {
  assert(false)
}
