// error: closure_borrow_result_map_err.nra:6:30: "r" is assigned by a closure passed to this call
import * as Results from "std/result"

export function run(args: Array<string>): int {
  let r: Result<string, string> = Err("a")
  const out = Results.mapErr(r, (s) => {
    r = Ok("fine")
    return `${s}x`
  })
  return 0
}
