// error: a closure cannot change captured "items" unless it is passed straight to a function parameter that is not escaping
import * as Arrays from "std/array"

function later(escaping action: () => void): () => void {
  return action
}

export function run(args: Array<string>): int {
  const items = [1]
  const action = later(() => {
    Arrays.push(mutable items, 2)
  })
  action()
  return 0
}
