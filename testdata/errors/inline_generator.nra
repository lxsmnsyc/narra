// error: @inline cannot copy generator counter into its calls; remove @inline
@inline
function* counter(limit: int): Generator<int> {
  for (let i = 0; i < limit; i++) {
    yield i
  }
}

export function run(_args: Array<string>): int {
  let total = 0
  for (const value of counter(3)) {
    total += value
  }
  return total - 3
}
