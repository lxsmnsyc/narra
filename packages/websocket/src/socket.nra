// websocket/socket: the public part of an open WebSocket. The state and the tasks are in the
// private session module, which the server and client modules use to make sockets.

import * as Session from "websocket/session"
import { Message, WebSocketError } from "websocket/message"

/// An open WebSocket. Copies share the connection and its state.
export type Socket = Session.Socket

/// The sub-protocol that the handshake chose, if any.
export const protocol = Session.protocol

/// The next message, waiting until one arrives. Messages come in the order they were sent. Once
/// the socket has ended and the queue is empty the result is the reason it ended, and every call
/// after that gives Closed.
export const receive = Session.receive

/// The messages of the socket, each as `receive` gives it. The stream ends after the first error.
export async function* messages(
  socket: Socket,
): AsyncGenerator<Result<Message, WebSocketError>> uses (io, alloc) {
  yield* Session.messages(socket)
}

/// Sends the message. Many tasks may send at once: whole messages go out one after another, and
/// a message over 64 KiB goes out in several frames with the control frames of the socket
/// between them. None means the message was written to the connection. A send that is cancelled
/// or fails while it writes ends the socket, since half a frame may be on the wire.
export const send = Session.send

/// Sends a close frame with the code and reason, then waits for the reply of the peer for up to
/// `closeTimeout`. After it, every call gives Closed. The code must be 1000 to 1003, 1007 to 1011
/// or 3000 to 4999, and the reason at most 123 bytes.
export const close = Session.close
