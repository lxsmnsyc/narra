// JSON helpers of narrac lsp: reading the fields of a request by matching on
// Value (std/shape), and building the messages the server sends. Messages are
// parsed and written with std/json.
import { Value } from "std/shape"

export function getField(value: Value, name: string): Option<Value> from value uses alloc {
  if (value is Value.Record(fields)) {
    return fields[name]
  }
  return None
}

export function getText(value: Value, name: string): Option<string> uses alloc {
  const field = getField(value, name)
  if (field is Some(Value.Text(text))) {
    return Some(text)
  }
  return None
}

export function getList(value: Value, name: string): Option<Array<Value>> from value uses alloc {
  const field = getField(value, name)
  if (field is Some(Value.List(items))) {
    return Some(items)
  }
  return None
}

export function getPath(value: Value, names: Array<string>): Option<Value> from value uses alloc {
  let current = value
  for (const name of names) {
    const next = getField(current, name)
    if (next is Some(found)) {
      current = found
    } else {
      return None
    }
  }
  return Some(current)
}

export function makeRecord(entries: Array<#[string, Value]>): Value uses alloc {
  let fields: Map<string, Value> = Map {}
  for (const entry of entries) {
    const #[key, value] = entry
    fields[key] = value
  }
  return Value.Record(fields)
}

export function makeResponse(id: Value, result: Value): Value uses alloc {
  return makeRecord([#["jsonrpc", Value.Text("2.0")], #["id", id], #["result", result]])
}

export function makeError(id: Value, code: int, message: string): Value uses alloc {
  // A message without an id gets Value.Null as its id.
  return makeRecord([
    #["jsonrpc", Value.Text("2.0")],
    #["id", id],
    #["error", makeRecord([#["code", Value.Int(code)], #["message", Value.Text(message)]])],
  ])
}

export function makeNotification(method: string, params: Value): Value uses alloc {
  return makeRecord([
    #["jsonrpc", Value.Text("2.0")],
    #["method", Value.Text(method)],
    #["params", params],
  ])
}
