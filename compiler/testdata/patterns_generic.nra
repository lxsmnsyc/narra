import * as Int from "std/int"

struct Box<T> {
  item: T
  note: string
}

function unwrapOr<T>(o: Option<Option<T>>, d: T): T {
  return match (o) {
    Some(Some(v)) => v
    _ => d
  }
}

function renote<T>(b: Box<T>, n: string): Box<T> {
  const { item } = b
  return { ...b, note: n, item: item }
}

function biggest<T: Ordered>(a: T, b: T): T {
  return match (Ordered.compare(a, b)) {
    Less => b
    _ => a
  }
}

export function run(args: Array<string>): int {
  print(unwrapOr(Some(Some("x")), "d"))
  print(unwrapOr(Some(None), "d"))
  const b = renote(Box { item: "it", note: "old" }, "new")
  print(`${b.item} ${b.note}`)
  print(biggest("a", "b"))
  const words = ["skip", "keep", "stop", "never"]
  for (const w of Array.values(words)) {
    const pair: Tuple<string, Option<string>> = [w, Some(w)]
    match (pair) {
      ["skip", Some(s)] => {
        print(`skipping ${s}`)
        continue
      }
      ["stop", Some(s)] => {
        print(`stopping ${s}`)
        break
      }
      [x, Some(s)] if (x == "keep") => print(`kept ${s}`)
      _ => print("other")
    }
  }
  let i = 0
  while (Some(i) is Some(0) || i < 2) {
    i = i + 1
  }
  print(Int.toString(i))
  return 0
}
