// The sender is never closed: the thread holds its only copy, and when the
// thread function returns that copy is dropped, which closes the channel and
// ends Channel.values.
import * as Channel from "std/channel"
import * as Thread from "std/thread"
import { Scope } from "std/thread"
import { Receiver } from "std/channel"
import * as Int from "std/int"

function startCounting(scope: Scope, limit: int): Receiver<int> uses io, alloc {
  const #[sender, receiver] = Channel.create<int>(4)
  Thread.start(scope, () => {
    for (let i = 1; i <= limit; i++) {
      Channel.send(sender, i * i)
    }
    return limit
  })
  return receiver
}

export function run(_args: Array<string>): int {
  const total = Thread.scope((scope) => {
    const squares = startCounting(scope, 10)
    let sum = 0
    for (const square of Channel.values(squares)) {
      sum += square
    }
    return sum
  })
  print(`sum ${Int.toString(total)}`)
  return 0
}
