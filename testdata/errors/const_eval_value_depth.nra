// error: E1056, a computed value nested deeper than the C writer goes
import * as Int from "std/int"

enum List {
  Nil
  Cons(head: int, tail: List)
}

@const
function build(count: int): List {
  let list = List.Nil
  for (let index = 0; index < count; index++) {
    list = List.Cons(index, list)
  }
  return list
}

function total(list: List): int {
  let sum = 0
  let rest = list
  let going = true
  while (going) {
    if (rest is List.Cons(head, tail)) {
      sum += head
      rest = tail
    } else {
      going = false
    }
  }
  return sum
}

const LIST = build(8000)

export function run(args: Array<string>): int uses io, alloc {
  const count = 8000
  print(Int.toString(total(LIST)))
  print(Int.toString(total(build(count))))
  return 0
}
