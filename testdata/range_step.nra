// Ranges.stepped: up, down, strides past the end, empty ranges, a run-time
// step of 0, the ends of the int range, and a range through std/iterator.
import * as Ranges from "std/range"
import * as Iterators from "std/iterator"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

function collect(range: Range): string uses alloc {
  let texts: Array<string> = []
  for (const value of range) {
    Arrays.push(mutable texts, Int.toString(value))
  }
  return `[${Str.join(texts, " ")}]`
}

function* values(range: Range): Generator<int> {
  for (const value of range) {
    yield value
  }
}

function intMin(): int {
  return -9223372036854775807 - 1
}

function makeStep(): int {
  return 0
}

export function run(args: Array<string>): int uses io, alloc {
  print(collect(Ranges.stepped(0, 10, 3)))
  print(collect(Ranges.stepped(10, 0, -2)))
  print(collect(Ranges.stepped(1, 20, 7)))
  print(collect(Ranges.stepped(5, 5, 1)))
  print(collect(Ranges.stepped(5, 0, 1)))
  print(collect(Ranges.stepped(0, 5, -1)))
  print(collect(Ranges.stepped(0, 5, makeStep())))
  print(collect(Ranges.stepped(5, 0, makeStep())))
  print(collect(Ranges.stepped(9223372036854775800, 9223372036854775807, 5)))
  print(collect(Ranges.stepped(9223372036854775806, 9223372036854775807, 9223372036854775807)))
  print(collect(Ranges.stepped(-9223372036854775807, intMin(), -3)))
  print(collect(Ranges.stepped(-9223372036854775800, intMin(), -4)))
  const stride = 4
  const range = Ranges.stepped(2, 20, stride)
  print(collect(range))
  for (const value of Ranges.stepped(0, 100, 2)) {
    if (value == 4) {
      continue
    }
    if (value > 8) {
      break
    }
    print(Int.toString(value))
  }
  const doubled = Iterators.map(values(Ranges.stepped(10, 0, -3)), (value: int): int => value * 2)
  let texts: Array<string> = []
  for (const value of doubled) {
    Arrays.push(mutable texts, Int.toString(value))
  }
  print(Str.join(texts, ","))
  return 0
}
