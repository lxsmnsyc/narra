// error: expected (int) => int, found (int) => int uses io
function quiet(v: int): int {
  return v + 1
}

function loud(v: int): int uses io {
  print("loud")
  return v
}

const fns = [quiet, loud]

export function pure(): int {
  return fns[0](2)
}

export function run(args: Array<string>): int uses io {
  return pure()
}
