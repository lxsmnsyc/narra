// file header

/// documented
export function f(/* first */ a: int, b: int): int {
  // before a statement
  const x = 1 // after a statement

  // a comment on its own line
  /* inline */ const y = 2
  const z = 3 /* trailing block */
  if (x == 1) {
    // only a comment
  } else {
    // in else
    print("e")
  } // after if
  // last in the block
}

// between declarations

struct S {
  // leading field comment
  a: int // trailing field comment
  /// doc for b
  b: int
}

enum E {
  // leading variant comment
  A // after A
  B(x: int) // after B
}

struct Commented {
  // nothing here
}

function empty() {
  // empty body
}

trait T {
  // about show
  function show(value: Self): string // trailing
}

implement T for S {
  // inside impl
  function show(value: S): string {
    return "s"
  }
}

test "t" {
  // a test comment
}
// trailing file comment
