// std/json: parse errors carry line:column and a reason.
import * as Json from "std/json"
import * as Str from "std/string"

function check(text: string) uses io, alloc {
  const parsed = Json.parse(text)
  if (parsed is Err(message)) {
    print(message)
  } else {
    print("ok")
  }
}

export function run(args: Array<string>): int uses io, alloc {
  // Truncated input.
  check("")
  check("[1, 2")
  check("{\"a\": ")
  check("\"abc")
  check("tru")
  // Trailing and missing commas, colons and keys.
  check("[1, 2,]")
  check("{\"a\": 1,}")
  check("{\"a\" 1}")
  check("{\"a\": 1 \"b\": 2}")
  check("[1 2]")
  check("{1: 2}")
  // Bad escapes and surrogates.
  check("\"a\\qb\"")
  check("\"\\u12g4\"")
  check("\"\\ud83d\"")
  check("\"\\ud83dx\"")
  check("\"\\ude00\"")
  check("\"\\ud83d\\u0041\"")
  check("\"tab\there\"")
  // Numbers and trailing text.
  check("01")
  check("1.")
  check("-")
  check("1e")
  check(".5")
  check("1 2")
  check("nul")
  // Positions on later lines and after multibyte characters.
  check("{\n  \"a\": 1,\n  \"b\": x\n}")
  check("[\"\u{e9}\u{e9}\", ?]")
  // Nesting: 512 is allowed, 513 is not.
  check(`${Str.repeat("[", 512)}${Str.repeat("]", 512)}`)
  check(`${Str.repeat("[", 513)}${Str.repeat("]", 513)}`)
  const opening = Str.repeat("{\"a\":", 513)
  const closing = Str.repeat("}", 513)
  check(`${opening}1${closing}`)
  check(Str.repeat("[", 100000))
  return 0
}
