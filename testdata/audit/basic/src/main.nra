// A package with both kinds of audited code.
import * as Int from "std/int"
import * as Wrappers from "audited/wrappers"

extern {
  function abs(value: i32): i32
} from "c"

export function run(arguments: Array<string>): int {
  print(Int.toString(Wrappers.computeAbsolute(-5)))
  return 0
}

@trusted
export function absolute(value: i32): i32 {
  unsafe {
    return abs(value)
  }
}

export function absoluteLater(value: i32): i32 uses unsafe {
  const compute = (): i32 => {
    unsafe {
      return abs(value)
    }
  }
  unsafe {
    return compute()
  }
}
