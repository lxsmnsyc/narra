// error: the result shares parameter "item"; write `from item` after the result type
struct Thing {
  value: int
}
struct S1 {
  s: S2
}
struct S2 {
  s: S3
}
struct S3 {
  s: S4
}
struct S4 {
  s: S5
}
struct S5 {
  s: S6
}
struct S6 {
  s: S7
}
struct S7 {
  s: S8
}
struct S8 {
  items: Array<Thing>
}

function stash(mutable root: S1, item: Thing) {
  root.s.s.s.s.s.s.s.items = [item]
}

function build(item: Thing): S1 {
  let root = S1 { s: S2 { s: S3 { s: S4 { s: S5 { s: S6 { s: S7 { s: S8 { items: [] } } } } } } } }
  stash(mutable root, item)
  return root
}

export function run(_args: Array<string>): int {
  return build(Thing { value: 1 }).s.s.s.s.s.s.s.items[0].value - 1
}
