enum Shape {
  Circle(radius: int)
  Rect(width: int, height: int)
  Dot
}

struct Point {
  x: int
  y: int
}

struct Segment {
  start: Point
  finish: Point
}

function area(shape: Shape): int {
  return match (shape) {
    Shape.Circle(radius) => radius * radius
    Shape.Rect(width, height) => width * height
    Shape.Dot => 0
  }
}

function describe(shape: Shape, flag: bool): string {
  return match (shape) {
    Shape.Circle(radius) if (radius > 10) => "big"
    Shape.Circle(_) => "circle"
    Shape.Rect(_, _) => "rect"
    _ => "other"
  }
}

function pick(code: int, letter: char, text: string, ratio: f64): int {
  const a = match (code) {
    0 => 1
    -1 => 2
    _ => 3
  }
  const b = match (letter) {
    'a' => 1
    _ => 2
  }
  const c = match (text) {
    "x" => 1
    other => 2
  }
  const d = match (ratio) {
    1.5 => 1
    _ => 2
  }
  return a + b + c + d
}

function flags(first: bool, second: bool): int {
  return match (#[first, second]) {
    #[true, true] => 1
    #[true, false] => 2
    #[false, _] => 3
  }
}

function nested(maybe: Option<Shape>): int {
  return match (maybe) {
    Some(Shape.Circle(radius)) => radius
    Some(Shape.Rect(width, _)) => width
    Some(Shape.Dot) => 0
    None => 0 - 1
  }
}

function walk(segment: Segment): int {
  return match (segment) {
    { start: { x: 0, y }, finish } => y + finish.x
    { start, finish: { x, y: 0 } } => start.x + x
    { start: { x, y }, finish: _ } => x + y
  }
}

function status(shape: Shape): int {
  match (shape) {
    Shape.Circle(radius) => {
      const doubled = radius * 2
      return doubled
    }
    _ => {}
  }
  return 0
}
