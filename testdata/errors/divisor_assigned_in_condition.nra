// error: a closure in the rest of a condition assigns the divisor after its check
function holdsTrue(action: () => bool): bool {
  return action()
}

function inIf(total: int, start: int): int {
  let divisor = start
  if (
    divisor != 0 &&
      holdsTrue(() => {
        divisor = 0
        return true
      })
  ) {
    return total / divisor
  }
  return 0
}

function inWhile(total: int, start: int): int {
  let divisor = start
  let result = 0
  while (
    divisor != 0 &&
      holdsTrue(() => {
        divisor = 0
        return true
      })
  ) {
    result += total / divisor
  }
  return result
}

function afterExit(total: int, start: int): int {
  let divisor = start
  if (
    divisor == 0 ||
      holdsTrue(() => {
        divisor = 0
        return false
      })
  ) {
    return 0
  }
  return total / divisor
}

export function run(_args: Array<string>): int {
  return inIf(10, 1) + inWhile(10, 1) + afterExit(10, 1)
}
