struct Point {
  x: int
  y: int
}

struct Other {
  x: int
}

struct Pair<A, B> {
  first: A
  second: B
}

function maps(point: Point): int {
  const floats = Map { 1.5: 1 }
  const disagree: Map<string, int> = Map<int, int> { 1: 2 }
  const arity = Map<int> { 1: 2 }
  const unknown = Map {}
  const mixed = Map { 1: "a", "b": "c" }
  const table: Map<string, int> = Map {}
  const wrongKey = table[1]
  return 0
}

function tuples(point: Point): int {
  const single = #[1]
  const wrong: #[int, int] = #[1, "two"]
  return 0
}

function spreads(point: Point, other: Other, pair: Pair<int, string>, count: int): int {
  const notStruct = { ...count, x: 1 }
  const wrongType: Point = { ...other }
  const unknownField = { ...point, z: 1 }
  const twice = { ...point, x: 1, x: 2 }
  const badValue = { ...point, x: "one" }
  const named = Missing { ...point }
  const generic = Pair { ...point }
  const written = Pair<int, int> { ...pair }
  const tuple = { ...#[1, 2] }
  return 0
}
