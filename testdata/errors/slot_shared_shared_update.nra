// error: the arrow function returns a value that shares captured "items"; a from marker can name only a parameter, so return a copy with copy(...)
import * as Arrays from "std/array"
import * as Shareds from "std/shared"
export function run(_args: Array<string>): int uses alloc {
  const box = Shareds.create<Array<int>>([])
  let items = [1, 2, 3]
  Shareds.update(box, (old) => items)
  Arrays.push(mutable items, 4)
  return Arrays.length(items)
}
