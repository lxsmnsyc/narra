import * as Iterators from "std/iterator"

function* lines(): Generator<int> uses io {
  yield 1
}

function quiet(source: Option<Generator<Array<int>> uses io>): int uses io {
  if (source is Some(_)) {
    return 1
  }
  return 0
}

export function run(args: Array<string>): int uses io, alloc {
  const chunks = Iterators.chunk(lines(), 2)
  return quiet(chunks)
}
