import * as Int from "std/int"
import { a, b } from "other/mod"

export const LIMIT: int = 10
const NAME = "narra \"x\"\t"

export struct Pair<A, B> implements Show derives Eq, Hash {
  first: A
  second: B = zero()
}

export opaque struct Secret {
  key: string
}

enum Shape derives Show {
  Circle(radius: float)
  Rect(w: float, h: float)
  Empty
}

export enum Tree<T> {
  Leaf
  Node(left: Tree<T>, value: T, right: Tree<T>)
}

export distinct type UserId = int
export opaque distinct type Token = string

trait Area {
  function area(self: Self): float
  function scale(self: Self, by: float): Self uses io
}

implement Area for Shape {
  function area(self: Shape): float {
    return 0.0
  }
}

export function map<T, U: Show & Eq, effect E>(items: Array<T>, mutable out: Array<U>, f: (item: T, i: int) => U uses E, escaping g: () => void uses io, alloc): Array<U> uses E, alloc {
  return out
}

function tuple(t: #[int, string], m: Map<string, Array<Option<int>>>): #[int, bool] {
  return #[1, true]
}

test "decl test" {
}
