// Declaration signatures for `narrac query interface`, written from the
// syntax as one line each: the types as written (with type parameter
// names), the declared effects, no bodies and no field defaults.
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import {
  TypeExpr,
  FuncDecl,
  Param,
  FieldDecl,
  StructDecl,
  EnumDecl,
  TraitDecl,
  DistinctDecl,
  AliasDecl,
  Expr,
  Arg,
  Pattern,
} from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { writeTypeUses } from "narrac/typeuses"

export function writeType(type: TypeExpr): string uses alloc {
  let text = ""
  if (type.isTuple) {
    text = `#[${writeTypeList(type.arguments)}]`
  } else if (type.isFunc) {
    let result = "void"
    if (type.result is Some(boxed)) {
      result = writeType(boxed.value)
    }
    text = `(${writeParameterTypes(type)}) => ${result}`
  } else if (type.typeofName != "") {
    text = `typeof ${type.typeofName}`
  } else if (Arrays.length(type.arguments) > 0) {
    text = `${type.name}<${writeTypeList(type.arguments)}>`
  } else {
    text = type.name
  }
  if (type.resultFrom != "") {
    text = `${text} from ${type.resultFrom}`
  }
  if (Arrays.length(type.effects) > 0) {
    text = `${text}${writeTypeUses(type.effects)}`
  }
  return text
}

function writeParameterTypes(type: TypeExpr): string uses alloc {
  // The parameter names are written when the result names one with `from`.
  let named = false
  if (type.result is Some(boxed)) {
    named = boxed.value.resultFrom != ""
  }
  if (!named) {
    return writeTypeList(type.arguments)
  }
  let parts: Array<string> = []
  for (const index of Ranges.upTo(Arrays.length(type.arguments))) {
    let name = ""
    if (index < Arrays.length(type.parameterNames)) {
      name = type.parameterNames[index]
    }
    if (name == "") {
      Arrays.push(mutable parts, writeType(type.arguments[index]))
    } else {
      Arrays.push(mutable parts, `${name}: ${writeType(type.arguments[index])}`)
    }
  }
  return Str.join(parts, ", ")
}

function writeTypeList(types: Array<TypeExpr>): string uses alloc {
  let parts: Array<string> = []
  for (const type of Arrays.values(types)) {
    Arrays.push(mutable parts, writeType(type))
  }
  return Str.join(parts, ", ")
}

function writeTraitList(keyword: string, traits: Array<TypeExpr>): string uses alloc {
  if (Arrays.length(traits) == 0) {
    return ""
  }
  return ` ${keyword} ${writeTypeList(traits)}`
}

function writeTypeParameterNames(names: Array<string>): string uses alloc {
  if (Arrays.length(names) == 0) {
    return ""
  }
  return `<${Str.join(names, ", ")}>`
}

function writeBoundedParameters(
  names: Array<string>,
  bounds: Array<Array<TypeExpr>>,
): Array<string> uses alloc {
  let parameters: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(names))) {
    let text = names[index]
    if (index < Arrays.length(bounds) && Arrays.length(bounds[index]) > 0) {
      let traits: Array<string> = []
      for (const bound of Arrays.values(bounds[index])) {
        Arrays.push(mutable traits, writeType(bound))
      }
      text = `${text}: ${Str.join(traits, " & ")}`
    }
    Arrays.push(mutable parameters, text)
  }
  return parameters
}

function writeParameter(parameter: Param): string uses alloc {
  let text = ""
  if (parameter.isMutable) {
    text = "mutable "
  }
  if (parameter.escaping) {
    text = `${text}escaping `
  }
  text = `${text}${parameter.name}`
  if (parameter.type is Some(type)) {
    text = `${text}: ${writeType(type)}`
  }
  if (parameter.default is Some(value)) {
    text = `${text} = ${writeDefaultValue(value)}`
  }
  return text
}

export function writeFunction(funcDecl: FuncDecl): string uses alloc {
  // Type parameters with their bounds, then effect parameters.
  let typeParameters = writeBoundedParameters(funcDecl.typeParameters, funcDecl.bounds)
  for (const name of Arrays.values(funcDecl.effectParameters)) {
    Arrays.push(mutable typeParameters, `effect ${name}`)
  }
  let parameters: Array<string> = []
  for (const parameter of Arrays.values(funcDecl.parameters)) {
    Arrays.push(mutable parameters, writeParameter(parameter))
  }
  let text = "function"
  if (funcDecl.generator) {
    text = "function*"
  }
  if (funcDecl.isAsync) {
    text = `async ${text}`
  }
  text = `${text} ${funcDecl.name}${writeTypeParameterNames(typeParameters)}(${Str.join(parameters, ", ")})`
  if (funcDecl.result is Some(result)) {
    text = `${text}: ${writeType(result)}`
  }
  if (Arrays.length(funcDecl.effects) > 0) {
    text = `${text} uses ${Str.join(funcDecl.effects, ", ")}`
  }
  return text
}

function writeFields(fields: Array<FieldDecl>): string uses alloc {
  let parts: Array<string> = []
  for (const field of Arrays.values(fields)) {
    Arrays.push(mutable parts, `${field.name}: ${writeType(field.type)}`)
  }
  return Str.join(parts, ", ")
}

export function writeStruct(structDecl: StructDecl): string uses alloc {
  // An opaque struct shows no fields.
  const typeParameters = writeBoundedParameters(structDecl.typeParameters, structDecl.bounds)
  let text = `struct ${structDecl.name}${writeTypeParameterNames(typeParameters)}`
  text = `${text}${writeTraitList("implements", structDecl.implementations)}${writeTraitList("derives", structDecl.derived)}`
  if (structDecl.opaque) {
    return `opaque ${text}`
  }
  if (Arrays.length(structDecl.fields) == 0) {
    return `${text} {}`
  }
  return `${text} { ${writeFields(structDecl.fields)} }`
}

export function writeEnum(enumDecl: EnumDecl): string uses alloc {
  let variants: Array<string> = []
  for (const variant of Arrays.values(enumDecl.variants)) {
    if (Arrays.length(variant.fields) == 0) {
      Arrays.push(mutable variants, variant.name)
    } else {
      Arrays.push(mutable variants, `${variant.name}(${writeFields(variant.fields)})`)
    }
  }
  const typeParameters = writeBoundedParameters(enumDecl.typeParameters, enumDecl.bounds)
  let text = `enum ${enumDecl.name}${writeTypeParameterNames(typeParameters)}`
  text = `${text}${writeTraitList("implements", enumDecl.implementations)}${writeTraitList("derives", enumDecl.derived)}`
  if (Arrays.length(variants) == 0) {
    return `${text} {}`
  }
  return `${text} { ${Str.join(variants, ", ")} }`
}

export function writeTrait(traitDecl: TraitDecl): string uses alloc {
  let functions: Array<string> = []
  for (const funcDecl of Arrays.values(traitDecl.functions)) {
    Arrays.push(mutable functions, writeFunction(funcDecl))
  }
  if (Arrays.length(functions) == 0) {
    return `trait ${traitDecl.name} {}`
  }
  return `trait ${traitDecl.name} { ${Str.join(functions, "; ")} }`
}

export function writeAlias(aliasDecl: AliasDecl): string uses alloc {
  return `type ${aliasDecl.name}${writeTypeParameterNames(aliasDecl.typeParameters)} = ${writeType(aliasDecl.body)}`
}

export function writeDistinct(distinctDecl: DistinctDecl): string uses alloc {
  // An opaque one hides its base.
  if (distinctDecl.opaque) {
    return `opaque distinct type ${distinctDecl.name}`
  }
  const base = writeType(distinctDecl.base)
  return `distinct type ${distinctDecl.name} = ${base}${writeTraitList("implements", distinctDecl.implementations)}${writeTraitList("derives", distinctDecl.derived)}${writeRefinement(distinctDecl.refinement)}`
}

function writeRefinement(items: Array<Pattern>): string uses alloc {
  if (Arrays.length(items) == 0) {
    return ""
  }
  return ` requires ${writeRefinementItems(items)}`
}

export function writeRefinementItems(items: Array<Pattern>): string uses alloc {
  // The items of a `requires` list as written: `>= 1 && <= 65535`.
  let texts: Array<string> = []
  for (const item of Arrays.values(items)) {
    Arrays.push(mutable texts, writePattern(item))
  }
  return Str.join(texts, " && ")
}

function writePattern(pattern: Pattern): string uses alloc {
  // A refinement holds comparisons, literals and alternatives of them.
  return match (pattern) {
    Pattern.PatCompare(_, _, operator, bound) => `${operator} ${writeConstant(bound)}`
    Pattern.PatLit(_, _, literal) => writeConstant(literal)
    Pattern.PatOr(_, _, alternatives) => writeAlternatives(alternatives)
    _ => "_"
  }
}

function writeAlternatives(alternatives: Array<Pattern>): string uses alloc {
  let texts: Array<string> = []
  for (const alternative of Arrays.values(alternatives)) {
    Arrays.push(mutable texts, writePattern(alternative))
  }
  return Str.join(texts, " | ")
}

export function quoteString(value: string): string uses alloc {
  // The text as a string literal writes it: `"` and `\` escaped, control characters as escapes.
  let builder = Str.builder()
  Str.appendChar(mutable builder, '"')
  for (const character of Arrays.values(Str.chars(value))) {
    if (character == '"') {
      Str.append(mutable builder, "\\\"")
    } else if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (character == '\n') {
      Str.append(mutable builder, "\\n")
    } else if (character == '\t') {
      Str.append(mutable builder, "\\t")
    } else if (character == '\r') {
      Str.append(mutable builder, "\\r")
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  Str.appendChar(mutable builder, '"')
  return Str.build(builder)
}

function writeConstant(expression: Expr): string uses alloc {
  return match (expression) {
    Expr.IntLit(_, _, text) => text
    Expr.StringLit(_, _, value, _) => quoteString(value)
    Expr.Ident(_, _, name) => name
    Expr.FieldExpr(_, _, Expr.Ident(_, _, alias), name) => `${alias}.${name}`
    Expr.UnaryExpr(_, _, operator, operand) => `${operator}${writeConstant(operand)}`
    _ => "..."
  }
}

export function writeDefaultValue(value: Expr): string uses alloc {
  // The constant forms of a default, as hover and `narrac query` show them.
  return match (value) {
    Expr.IntLit(_, _, text) | Expr.FloatLit(_, _, text) => text
    Expr.StringLit(_, _, text, _) => quoteGo(text)
    Expr.CharLit(_, _, text) => `'${text}'`
    Expr.BoolLit(_, _, flag) => flag ? "true" : "false"
    Expr.Ident(_, _, name) => name
    Expr.FieldExpr(_, _, target, name) => `${writeDefaultValue(target)}.${name}`
    Expr.UnaryExpr(_, _, operator, operand) => `${operator}${writeDefaultValue(operand)}`
    Expr.CallExpr(_, _, callee, _, arguments) => writeDefaultCall(callee, arguments)
    Expr.ArrayLit(_, _, elements, _) => writeDefaultArray(elements)
    _ => "..."
  }
}

function writeDefaultCall(callee: Expr, arguments: Array<Arg>): string uses alloc {
  let parts: Array<string> = []
  for (const argument of Arrays.values(arguments)) {
    Arrays.push(mutable parts, writeDefaultValue(argument.value))
  }
  return `${writeDefaultValue(callee)}(${Str.join(parts, ", ")})`
}

function writeDefaultArray(elements: Array<Expr>): string uses alloc {
  let parts: Array<string> = []
  for (const element of Arrays.values(elements)) {
    Arrays.push(mutable parts, writeDefaultValue(element))
  }
  return `[${Str.join(parts, ", ")}]`
}
