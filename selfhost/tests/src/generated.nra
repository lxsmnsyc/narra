// The generated suite: source files of the compiler are made from other
// files, and a case fails when one of them is stale.
//   one case per file of selfhost/runtime: selfhost/src/runtime<name>.nra
//   stdtext   selfhost/src/stdtext.nra from std/src/*.nra
// With --update the files are rewritten:
//   sh scripts/test.sh --suite generated --update
// Rewriting changes selfhost/src, so run sh scripts/seed-update.sh afterwards.
//
// selfhost/runtime holds the C that the compiler puts in every program. Each
// source has a generated file of its own, so a change to one runtime file
// changes one file of selfhost/src:
//   runtime.h        runtimecore.nra         RUNTIME_H
//   runtime_map.h    runtimemap.nra          RUNTIME_MAP_H
//   closure_env.c    runtimeclosureenv.nra   ENV_RUNTIME
//   test_runner.c    runtimetestrunner.nra   TEST_RUNNER_C
//   std_NAME.c       runtimestdNAME.nra      RUNTIME_STD_NAME
// runtimetext.nra is written by hand: it picks the runtime of a std module
// (runtimeFor), so a new std_NAME.c adds one line there.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Path from "std/path"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { Context, TestCase } from "testrunner/context"
import * as Common from "testrunner/context"
import * as Files from "testrunner/files"

const UPPER_LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  // One case for each runtime source; variant is the source file name.
  const folder = Path.join(context.repository, "selfhost/runtime")
  for (const name of Arrays.values(Files.listNames(folder))) {
    const target = runtimeTarget(name)
    if (target[0] != "") {
      Arrays.push(mutable cases, TestCase {
        suite: "generated",
        name: target[0],
        path: Path.join(context.repository, `selfhost/src/${target[0]}.nra`),
        variant: name,
      })
    }
  }
  Arrays.push(mutable cases, TestCase {
    suite: "generated",
    name: "stdtext",
    path: Path.join(context.repository, "selfhost/src/stdtext.nra"),
    variant: "stdtext",
  })
  return cases
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  let made: Result<string, string> = Err("unknown case")
  if (testCase.variant == "stdtext") {
    made = makeStdText(context)
  } else {
    made = makeRuntimeFile(context, testCase.variant)
  }
  if (made is Err(message)) {
    return Err(message)
  }
  const want = made.value
  if (context.update) {
    const current = Fs.readText(testCase.path)
    if (current is Ok(text)) {
      if (text == want) {
        return Ok(true)
      }
    }
    const written = Fs.writeText(testCase.path, want)
    if (written is Err(message)) {
      return Err(`cannot write ${testCase.path}: ${message}`)
    }
    return Ok(true)
  }
  const got = Common.readExpected(testCase.path)
  if (got is Err(message)) {
    return Err(message)
  }
  const compared = Common.compareText("generated text", want, got.value)
  if (compared is Err(difference)) {
    return Err(
      `${testCase.path} is stale; run sh scripts/test.sh --suite generated --update, then sh scripts/seed-update.sh\n${difference}`,
    )
  }
  return Ok(true)
}

function runtimeTarget(name: string): Array<string> uses alloc {
  if (name == "runtime.h") {
    return ["runtimecore", "RUNTIME_H"]
  }
  if (name == "runtime_map.h") {
    return ["runtimemap", "RUNTIME_MAP_H"]
  }
  if (name == "closure_env.c") {
    return ["runtimeclosureenv", "ENV_RUNTIME"]
  }
  if (name == "test_runner.c") {
    return ["runtimetestrunner", "TEST_RUNNER_C"]
  }
  // std_NAME.c is the runtime of std/NAME.
  if (Str.startsWith(name, "std_") && Str.endsWith(name, ".c")) {
    const stem = Str.slice(name, 0, Str.length(name) - 2)
    const moduleName = Str.replace(stem, "_", "")
    return [`runtime${moduleName}`, `RUNTIME_${upperName(stem)}`]
  }
  return ["", ""]
}

function makeRuntimeFile(context: Context, name: string): Result<string, string> uses io, alloc {
  const target = runtimeTarget(name)
  const text = Fs.readText(Path.join(context.repository, `selfhost/runtime/${name}`))
  if (text is Err(message)) {
    return Err(`cannot read ${name}: ${message}`)
  }
  const literal = makeLiteral(text.value)
  if (literal is Err(message)) {
    return Err(`${name}: ${message}`)
  }
  return Ok(
    `// Generated by the generated suite of selfhost/tests from selfhost/runtime/${name}. Do not edit:\n// sh scripts/test.sh --suite generated --update rewrites it.\n\nexport const ${target[1]} = ${literal.value}\n`,
  )
}

function makeStdText(context: Context): Result<string, string> uses io, alloc {
  const folder = Path.join(context.repository, "std/src")
  let builder = Str.builder()
  Str.append(
    mutable builder,
    "// Generated by the generated suite of selfhost/tests from std/src. Do not edit:\n// sh scripts/test.sh --suite generated --update rewrites it.\n\n",
  )
  let names: Array<string> = []
  for (const name of Arrays.values(Files.listNames(folder))) {
    if (Str.endsWith(name, ".nra")) {
      const stem = Str.slice(name, 0, Str.length(name) - 4)
      const text = Fs.readText(Path.join(folder, name))
      if (text is Err(message)) {
        return Err(`cannot read ${name}: ${message}`)
      }
      const literal = makeLiteral(text.value)
      if (literal is Err(message)) {
        return Err(`${name}: ${message}`)
      }
      Str.append(mutable builder, `const STD_${upperName(stem)} = ${literal.value}\n\n`)
      Arrays.push(mutable names, stem)
    }
  }
  Str.append(mutable builder, "export function stdSourceFor(path: string): string {\n")
  for (const stem of Arrays.values(names)) {
    Str.append(
      mutable builder,
      `  if (path == "std/${Str.replace(stem, "__", "/")}") {\n    return STD_${upperName(stem)}\n  }\n`,
    )
  }
  Str.append(mutable builder, "  return \"\"\n}\n")
  return Ok(Str.build(builder))
}

function upperName(stem: string): string uses alloc {
  let builder = Str.builder()
  for (const index of Ranges.between(0, Str.length(stem))) {
    const byte = Str.byteAt(stem, index)
    if (byte >= 97 && byte <= 122) {
      Str.append(mutable builder, Str.slice(UPPER_LETTERS, byte - 97, byte - 96))
    } else {
      Str.append(mutable builder, Str.slice(stem, index, index + 1))
    }
  }
  return Str.build(builder)
}

function makeLiteral(text: string): Result<string, string> uses alloc {
  // The texts are ASCII; any other byte is an error. A dollar sign is escaped so no interpolation starts.
  let builder = Str.builder()
  Str.append(mutable builder, "\"")
  const length = Str.length(text)
  // First byte of the plain run that is not copied yet.
  let runStart = 0
  for (const index of Ranges.between(0, length)) {
    const byte = Str.byteAt(text, index)
    let escape = ""
    if (byte == 92) {
      escape = "\\\\"
    } else if (byte == 34) {
      escape = "\\\""
    } else if (byte == 36) {
      escape = "\\$"
    } else if (byte == 10) {
      escape = "\\n"
    } else if (byte == 9) {
      escape = "\\t"
    } else if (byte == 13) {
      escape = "\\r"
    } else if (byte < 32 || byte >= 127) {
      return Err(
        `byte ${Int.toString(byte)} at ${Int.toString(index)} is not escaped by the generator`,
      )
    }
    if (escape != "") {
      Str.append(mutable builder, Str.slice(text, runStart, index))
      Str.append(mutable builder, escape)
      runStart = index + 1
    }
  }
  Str.append(mutable builder, Str.slice(text, runStart, length))
  Str.append(mutable builder, "\"")
  return Ok(Str.build(builder))
}
