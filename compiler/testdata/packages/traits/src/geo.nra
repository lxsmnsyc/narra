import { Area } from "tp/shape"
import * as Float from "std/float"

export struct Square implements Area, Show {
  side: f64
}

implement Area for Square {
  function area(shape: Square): f64 {
    return shape.side * shape.side
  }

  function name(shape: Square): string {
    return "square"
  }
}

implement Show for Square {
  function show(value: Square): string {
    return `geo square ${Float.toString(value.side)}`
  }
}

export struct Circle implements Area derives Show, Ordered {
  radius: f64
}

implement Area for Circle {
  function area(shape: Circle): f64 {
    return 3.0 * shape.radius * shape.radius
  }

  function name(shape: Circle): string {
    return "circle"
  }
}

export function unitSquare(): Square {
  return Square { side: 1.0 }
}
