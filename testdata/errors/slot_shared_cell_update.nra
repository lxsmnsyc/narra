// error: the arrow function returns a value that shares captured "items"; a from marker can name only a parameter, so return a copy with copy(...)
import * as Arrays from "std/array"
import * as Cells from "std/cell"
export function run(_args: Array<string>): int {
  const cell = Cells.create<Array<int>>([])
  let items = [1, 2, 3]
  Cells.update(cell, (old) => items)
  Arrays.push(mutable items, 4)
  return Arrays.length(Cells.get(cell))
}
