// narrac query (SPEC.md section 14, contracts/query-output.md): answers
// questions about a package from the checked program.
//
//     narrac query [--package DIR] [--json] type-of FILE:LINE:COL
//     narrac query [--package DIR] [--json] def NAME
//     narrac query [--package DIR] [--json] refs NAME
//     narrac query [--package DIR] [--json] refs FUNCTION.PARAMETER
//     narrac query [--package DIR] [--json] callers FUNCTION
//     narrac query [--package DIR] [--json] interface MODULE
//     narrac query [--package DIR] [--json] recursion MODULE
//     narrac query [--package DIR] [--json] hovers FILE
//
// The package is loaded and checked as `narrac types` does (every check
// pass and the effect pass). Results come from the checker's side tables:
// a node's type and ref from the open body that checked it (the body
// without type arguments, so a generic function shows its type parameter
// names), and calls from the call graph the effect pass records
// (EffectState.calls). Positions come from the site index (querysites.nra).
// Only the package's own modules are searched; interface also answers for a
// std module (querystd.nra).
//
// Text output is for people. With --json each command prints one JSON
// object and a newline. An error prints `error <message>` to stderr (with
// --json: `{"error": ...}` to stdout) and exits 1; a usage error exits 2.
import { splitString, substring } from "narrac/driver/textops"
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import { Pos, Decl, FuncDecl, Expr, TypeExpr } from "narrac/syntax/ast"
import { Token, TokenKind, formatLexError, lex } from "narrac/syntax/lexer"
import * as Modules from "narrac/driver/modules"
import { Package, SourceModule } from "narrac/driver/modules"
import { LoadError } from "narrac/driver/manifest"
import { Member } from "narrac/driver/workspace"
import { selectMembers } from "narrac/driver/workspaceselect"
import {
  Checker,
  BodyRoot,
  Ref,
  CheckError,
  typeString,
  findBodySlot,
  errorText,
  findSharedParameter,
} from "narrac/check/check"
import { Type } from "narrac/check/types"
import { writeTypeUses } from "narrac/check/typeuses"
import * as Body from "narrac/check/body"
import * as Effects from "narrac/check/effects"
import { EffectState } from "narrac/check/effects"
import { checkConstants } from "narrac/check/consteval"
import { reportSharedWrites } from "narrac/check/sharedwrites"
import { Site, SiteKind, collectSites, isBefore } from "narrac/tools/querysites"
import {
  InterfaceEntry,
  Location,
  findDocComment,
  quoteJson,
  splitLines,
  writeStringList,
  writeLocation,
  writeLocationText,
  writeDiagnostic,
  writeInterface,
} from "narrac/tools/queryjson"
import * as Signature from "narrac/tools/querysignature"
import { findCycles } from "narrac/tools/querygraph"
import { isStdModulePath, queryStdInterface } from "narrac/tools/querystd"
import * as Sets from "std/set"

const USAGE = "usage: narrac query [--package DIR] [--json] type-of FILE:LINE:COL | def NAME | refs NAME | callers FUNCTION | interface MODULE | recursion MODULE | hovers FILE"

const COMMANDS = ["type-of", "def", "refs", "callers", "interface", "recursion", "hovers"]

// One module of the package with its text, tokens, position index and the
// open bodies checked in it.
export struct ModuleView {
  path: string
  file: string
  module: SourceModule
  text: string
  tokens: Array<Token>
  sites: Array<Site>
  bodies: Array<int> // Checker.bodies without type arguments, in checking order
}

export struct Query {
  json: bool
  views: Array<ModuleView> // sorted by file
}

// A top-level declaration (or enum variant) that def and refs can name.
export struct Declared {
  qualified: string // "app/text.helper", "app/shape.Shape.Circle"
  kind: string
  names: Array<string> // the spellings that find it
  location: Location
  view: int
  declaration: int // File.declarations
  member: int // the variant index, or -1
}

// What refs looks for in the refs of the bodies.
export enum Target {
  FunctionTarget(index: int) // Checker.functions
  ConstTarget(index: int) // Checker.consts
  VariantTarget(module: string, enumName: string, variant: int)
}

// A reported place: a use for refs, a call for callers.
export struct Use {
  view: int
  location: Location
  name: string // the function or other body the place is in
}

export function runQuery(arguments: Array<string>): int uses io, alloc {
  // Options, then the command and its operand.
  let directory = "."
  let json = false
  let index = 2
  while (index < Arrays.length(arguments)) {
    if (arguments[index] == "--package" && index + 1 < Arrays.length(arguments)) {
      directory = arguments[index + 1]
      index += 2
    } else if (arguments[index] == "--json") {
      json = true
      index++
    } else {
      break
    }
  }
  if (Arrays.length(arguments) - index != 2 || !isCommand(arguments[index])) {
    printError(USAGE)
    return 2
  }
  const command = arguments[index]
  const operand = arguments[index + 1]

  if (command == "hovers") {
    return runHovers(directory, json, operand)
  }

  if (command == "interface" && isStdModulePath(operand)) {
    return reportAnswer(json, queryStdInterface(json, operand))
  }

  const selected = selectMembers(directory, false, false, false)
  if (selected is Err(errors)) {
    return reportLoadErrors(json, errors)
  }
  if (selected.value is Some(members)) {
    return runQueryOnMembers(json, command, operand, members)
  }
  const answered = answerQuery(directory, "", json, command, operand)
  if (answered is Err(failure)) {
    return reportFailure(failure)
  }
  return writeStdout(answered.value)
}

// An answer that did not come out: the text for stdout and for stderr, and whether the package
// loaded and checked but had no answer to the question.
struct Failure {
  output: string
  errorOutput: string
  isLookup: bool
}

function reportFailure(failure: Failure): int uses io, alloc {
  if (failure.output != "") {
    const _ = writeStdout(failure.output)
  }
  if (failure.errorOutput != "") {
    const _ = Fs.writeText("/dev/stderr", failure.errorOutput)
  }
  return 1
}

function runQueryOnMembers(
  json: bool,
  command: string,
  operand: string,
  members: Array<Member>,
): int uses io, alloc {
  // Every member answers on its own. A member that has no answer is skipped while another has one;
  // a member that does not load or check fails the query.
  let answers = ""
  let answerTexts: Array<string> = []
  let hasAnswer = false
  let lookupFailure: Option<Failure> = None
  for (const member of Arrays.values(members)) {
    const answered = answerQuery(member.directory, member.directory, json, command, operand)
    if (answered is Ok(text)) {
      answers = `${answers}${text}`
      Arrays.push(mutable answerTexts, text)
      hasAnswer = true
    } else if (answered is Err(failure)) {
      if (!failure.isLookup) {
        return reportFailure(failure)
      }
      if (lookupFailure is None) {
        lookupFailure = Some(failure)
      }
    }
  }
  if (!hasAnswer) {
    if (lookupFailure is Some(failure)) {
      return reportFailure(failure)
    }
    return 1
  }
  if (json) {
    return writeStdout(mergeJsonAnswers(command, answerTexts))
  }
  return writeStdout(answers)
}

function mergeJsonAnswers(command: string, answers: Array<string>): string uses alloc {
  // The answers of several members become one object: the list of the first answer, extended by the
  // lists of the others. A command that answers with one place keeps the first answer.
  let key = ""
  if (command == "def") {
    key = "matches"
  } else if (command == "refs") {
    key = "uses"
  } else if (command == "callers") {
    key = "callers"
  } else if (command == "interface") {
    key = "declarations"
  } else if (command == "recursion") {
    key = "groups"
  }
  const marker = `"${key}": [`
  if (key == "" || Arrays.length(answers) == 1) {
    return answers[0]
  }
  let prefix = ""
  let items: Array<string> = []
  for (const answer of Arrays.values(answers)) {
    const at = Str.indexOf(answer, marker)
    if (at is None) {
      return answers[0]
    }
    const start = at.value + Str.length(marker)
    // The list ends before the closing `]}` and the newline.
    const inner = substring(answer, start, Str.length(answer) - 3)
    if (prefix == "") {
      prefix = substring(answer, 0, start)
    }
    if (inner != "") {
      Arrays.push(mutable items, inner)
    }
  }
  return `${prefix}${Str.join(items, ", ")}]}\n`
}

function answerQuery(
  directory: string,
  filePrefix: string,
  json: bool,
  command: string,
  operand: string,
): Result<string, Failure> uses io, alloc {
  // Load and check the package as `narrac types` does.
  const loaded = Modules.load(directory)
  if (loaded is Err(loadErrors)) {
    return Err(describeLoadFailure(json, filePrefix, loadErrors))
  }
  const package = loaded.value
  let checker = copy(Body.checkPackage(package))
  if (Arrays.length(checker.errors) > 0) {
    return Err(describeCheckFailure(json, filePrefix, checker.errors))
  }
  let effects = Effects.checkEffects(mutable checker)
  if (Arrays.length(checker.errors) > 0) {
    return Err(describeCheckFailure(json, filePrefix, checker.errors))
  }
  const views = buildViews(checker, package, Map {})
  if (views is Err(message)) {
    return Err(describeAnswerFailure(json, message))
  }
  // At a workspace root each location names its member folder.
  let namedViews = copy(views.value)
  if (filePrefix != "" && filePrefix != ".") {
    for (const index of Ranges.between(0, Arrays.length(namedViews))) {
      namedViews[index].file = `${filePrefix}/${namedViews[index].file}`
    }
  }
  const query = Query { json, views: namedViews }

  // Answer.
  let answer: Result<string, string> = Err("")
  if (command == "type-of") {
    answer = queryType(mutable checker, mutable effects, query, operand)
  } else if (command == "def") {
    answer = queryDef(query, operand)
  } else if (command == "refs") {
    answer = queryRefs(checker, query, operand)
  } else if (command == "callers") {
    answer = queryCallers(checker, effects, query, operand)
  } else if (command == "interface") {
    answer = queryInterface(checker, query, operand)
  } else {
    answer = queryRecursion(checker, effects, query, operand)
  }
  if (answer is Err(message)) {
    let failure = describeAnswerFailure(json, message)
    failure.isLookup = true
    return Err(failure)
  }
  return Ok(answer.value)
}

// One identifier of a file and the text the language server shows for it.
struct Hover {
  line: int
  column: int
  length: int
  text: string
}

function runHovers(directory: string, json: bool, file: string): int uses io, alloc {
  // A package that does not load answers with the errors of the file, or fails when none
  // is in it.
  const loaded = Modules.load(directory)
  if (loaded is Err(loadErrors)) {
    let fileErrors: Array<LoadError> = []
    for (const error of Arrays.values(loadErrors)) {
      if (error.file == file) {
        Arrays.push(mutable fileErrors, error)
      }
    }
    if (Arrays.length(fileErrors) == 0) {
      return reportLoadErrors(json, loadErrors)
    }
    let diagnostics: Array<HoverDiagnostic> = []
    for (const error of Arrays.values(fileErrors)) {
      Arrays.push(mutable diagnostics, HoverDiagnostic {
        line: error.line,
        column: error.column,
        length: 1,
        code: error.code,
        message: error.message,
      })
    }
    return writeStdout(writeHovers(json, file, [], diagnostics))
  }
  const package = loaded.value

  // Check the package with the passes narrac check runs. The effect pass needs bodies without
  // errors; shared writes are checked always.
  let checker = copy(Body.checkPackage(package))
  const effectsKnown = Arrays.length(checker.errors) == 0
  let effects = EffectState {
    bodyIndex: Map {},
    functions: Map {},
    locals: Map {},
    valuesAt: Map {},
    sources: Map {},
    arrows: Map {},
    entries: Sets.create(),
    report: false,
    changed: false,
    body: -1,
  }
  if (effectsKnown) {
    effects = Effects.checkEffects(mutable checker)
    checkConstants(mutable checker, effects)
  }
  reportSharedWrites(mutable checker)
  const views = buildViews(checker, package, Map {})
  if (views is Err(message)) {
    return reportAnswer(json, Err(message))
  }
  let found: Option<ModuleView> = None
  for (const view of Arrays.values(views.value)) {
    if (view.file == file) {
      found = Some(view)
    }
  }
  if (found is None) {
    return reportAnswer(json, Err(`no module has the file "${file}"`))
  }
  const view = found.value

  // Hovers from the sites of the file, then the diagnostics reported in it.
  const hovers = collectHovers(mutable checker, mutable effects, effectsKnown, view)
  let diagnostics: Array<HoverDiagnostic> = []
  for (const error of Arrays.values(checker.errors)) {
    if (error.file == file) {
      Arrays.push(mutable diagnostics, HoverDiagnostic {
        line: error.pos.line,
        column: error.pos.column,
        length: findTokenLength(view, error.pos),
        code: error.code,
        message: error.message,
      })
    }
  }
  return writeStdout(writeHovers(json, file, hovers, diagnostics))
}

struct HoverDiagnostic {
  line: int
  column: int
  length: int
  code: string
  message: string
}

function collectHovers(
  mutable checker: Checker,
  mutable effects: EffectState,
  effectsKnown: bool,
  view: ModuleView,
): Array<Hover> uses alloc {
  let hovers: Array<Hover> = []
  let slots: Map<string, int> = Map {}
  for (const site of Arrays.values(view.sites)) {
    // Only named places on one line; a later site at the same place is the innermost.
    if (site.name == "" || site.kind == SiteKind.LabelSite || site.start.line != site.end.line) {
      continue
    }
    const length = site.end.column - site.start.column

    // A variant shows its fields, and the enum name before it shows the enum.
    const ref = findSiteRef(checker, view, site)
    if (ref is Ref.Constructor(enumIndex, variantIndex)) {
      putHover(
        mutable hovers,
        mutable slots,
        site.start,
        length,
        describeVariant(checker, enumIndex, variantIndex),
      )
      for (const qualifier of Arrays.values(findQualifierHovers(checker, view, site, enumIndex))) {
        putHover(
          mutable hovers,
          mutable slots,
          Pos { line: qualifier.line, column: qualifier.column },
          qualifier.length,
          qualifier.text,
        )
      }
      continue
    }

    const described = describeSite(mutable checker, mutable effects, effectsKnown, view, site)
    if (described is None) {
      continue
    }
    const #[typeText, names] = described.value
    let text = typeText
    if (Arrays.length(names) > 0) {
      text = `${text}\nuses ${Str.join(names, ", ")}`
    }
    putHover(mutable hovers, mutable slots, site.start, length, text)
  }
  collectImportHovers(mutable checker, mutable effects, view, mutable hovers, mutable slots)
  collectStructHovers(checker, view, mutable hovers, mutable slots)

  // Leave out a hover with no text, then sort: sites are nearly in source order already.
  let kept: Array<Hover> = []
  for (const hover of Arrays.values(hovers)) {
    if (hover.text != "") {
      Arrays.push(mutable kept, hover)
    }
  }
  Arrays.sortBy(mutable kept, compareHovers)
  return kept
}

function putHover(
  mutable hovers: Array<Hover>,
  mutable slots: Map<string, int>,
  start: Pos,
  length: int,
  text: string,
) uses alloc {
  // One entry per place: a later one replaces an earlier one.
  const hover = Hover { line: start.line, column: start.column, length, text }
  const key = `${Int.toString(hover.line)}:${Int.toString(hover.column)}`
  if (slots[key] is Some(slot)) {
    hovers[slot] = hover
  } else {
    slots[key] = Arrays.length(hovers)
    Arrays.push(mutable hovers, hover)
  }
}

function describeVariant(checker: Checker, enumIndex: int, variantIndex: int): string uses alloc {
  const variant = checker.enums[enumIndex].variants[variantIndex]
  const head = `${typeString(checker, Type.TEnum(enumIndex))}.${variant.name}`
  if (Arrays.length(variant.fields) == 0) {
    return head
  }
  let fields: Array<string> = []
  for (const field of Arrays.values(variant.fields)) {
    Arrays.push(mutable fields, `${field.name}: ${typeString(checker, field.fieldType)}`)
  }
  return `${head}(${Str.join(fields, ", ")})`
}

function describeMember(
  checker: Checker,
  effects: EffectState,
  path: string,
  name: string,
): string uses alloc {
  // The text for a name a module exports, or "" when it has none to show.
  let functionIndex = 0
  for (const info of Arrays.values(checker.functions)) {
    if (info.module == path && info.name == name && info.selfType is None) {
      if (describeCallable(checker, effects, Ref.Function(functionIndex)) is Some(found)) {
        return found[0]
      }
    }
    functionIndex++
  }
  let constIndex = 0
  for (const info of Arrays.values(checker.consts)) {
    if (info.module == path && info.name == name) {
      return findConstType(checker, constIndex)
    }
    constIndex++
  }
  for (const info of Arrays.values(checker.structs)) {
    if (info.module == path && info.name == name && !info.tuple) {
      return `struct ${name}`
    }
  }
  for (const info of Arrays.values(checker.enums)) {
    if (info.module == path && info.name == name) {
      return `enum ${name}`
    }
  }
  return describeBuiltin(checker, path, name)
}

function describeBuiltin(checker: Checker, path: string, name: string): string uses alloc {
  // The signature of a function the registry holds, or "" when it has none to show.
  let builtinIndex = -1
  if (path == "") {
    if (checker.registry.prelude[name] is Some(found)) {
      builtinIndex = found
    }
  } else if (checker.registry.modules[path] is Some(module)) {
    if (module.functions[name] is Some(found)) {
      builtinIndex = found
    }
  }
  if (builtinIndex < 0) {
    return ""
  }
  const builtin = checker.registry.functions[builtinIndex]
  if (builtin.result == "") {
    return ""
  }
  let used = copy(builtin.effects)
  Arrays.sort(mutable used)
  return `(${Str.join(builtin.parameters, ", ")}) => ${builtin.result}${writeTypeUses(used)}`
}

function findBuiltinCallee(checker: Checker, view: ModuleView, name: string): string uses alloc {
  // A builtin called by name: a prelude function, or a name imported from a std module.
  for (const declaration of Arrays.values(view.module.ast.imports)) {
    for (const imported of Arrays.values(declaration.names)) {
      if (imported.local == name) {
        return describeBuiltin(checker, declaration.path, imported.name)
      }
    }
  }
  return describeBuiltin(checker, "", name)
}

function collectImportNames(
  checker: Checker,
  effects: EffectState,
  view: ModuleView,
  cursor: Option<Pos>,
  mutable hovers: Array<Hover>,
  mutable slots: Map<string, int>,
) uses alloc {
  // The aliases of `import * as Alias`, and each imported name with the local name it gets.
  // With a cursor, only the names on its line are described.
  for (const declaration of Arrays.values(view.module.ast.imports)) {
    if (declaration.alias != "") {
      putHover(
        mutable hovers,
        mutable slots,
        declaration.aliasPos,
        Str.charCount(declaration.alias),
        `module ${declaration.path}`,
      )
    }
    for (const imported of Arrays.values(declaration.names)) {
      if (cursor is Some(at)) {
        if (at.line != imported.pos.line) {
          continue
        }
      }
      const text = describeMember(checker, effects, declaration.path, imported.name)
      putHover(mutable hovers, mutable slots, imported.pos, Str.charCount(imported.name), text)
      // `name as local`: the local name follows the `as`.
      const tokenIndex = findTokenIndex(view, imported.pos)
      if (imported.local != imported.name && tokenIndex >= 0) {
        if (tokenIndex + 2 < Arrays.length(view.tokens)) {
          const localToken = view.tokens[tokenIndex + 2]
          if (localToken.text == imported.local) {
            const localPos = Pos { line: localToken.line, column: localToken.column }
            putHover(mutable hovers, mutable slots, localPos, Str.charCount(imported.local), text)
          }
        }
      }
    }
  }
}

function collectImportHovers(
  mutable checker: Checker,
  mutable effects: EffectState,
  view: ModuleView,
  mutable hovers: Array<Hover>,
  mutable slots: Map<string, int>,
) uses alloc {
  collectImportNames(checker, effects, view, None, mutable hovers, mutable slots)
  // Each use of an alias, `Alias.member`, shows the module and the member. A member with no
  // text to show loses the hover its call gave. The sites also cover template parts.
  for (const site of Arrays.values(view.sites)) {
    if (site.kind != SiteKind.ExpressionSite) {
      continue
    }
    if (
      site.expression is Some(
        Expr.FieldExpr(_, memberPos, Expr.Ident(identId, aliasPos, alias), member),
      )
    ) {
      const path = findAliasUsePath(checker, view, identId, alias)
      if (path != "") {
        putHover(mutable hovers, mutable slots, aliasPos, Str.charCount(alias), `module ${path}`)
        const text = describeMember(checker, effects, path, member)
        putHover(mutable hovers, mutable slots, memberPos, Str.charCount(member), text)
      }
    }
  }
}

function collectStructHovers(
  checker: Checker,
  view: ModuleView,
  mutable hovers: Array<Hover>,
  mutable slots: Map<string, int>,
) uses alloc {
  // A struct literal shows its struct at the type name and each written field with its type.
  for (const site of Arrays.values(view.sites)) {
    if (site.kind != SiteKind.ExpressionSite) {
      continue
    }
    if (site.expression is Some(Expr.StructLit(_, pos, typeName, _, fields, _))) {
      const structIndex = findStructLiteralIndex(checker, view, site)
      if (structIndex < 0) {
        continue
      }
      if (typeName != "") {
        putHover(
          mutable hovers,
          mutable slots,
          pos,
          Str.charCount(typeName),
          describeStructLiteral(checker, structIndex, typeName),
        )
      }
      for (const field of Arrays.values(fields)) {
        // A shorthand field is also a use of the local of that name, which answers.
        if (!field.isShorthand) {
          const text = describeStructField(checker, structIndex, field.name)
          putHover(mutable hovers, mutable slots, field.pos, Str.charCount(field.name), text)
        }
      }
    }
  }
}

function findStructLiteralIndex(checker: Checker, view: ModuleView, site: Site): int {
  const bodyIndex = findNodeBody(checker, view, site.nodeId)
  if (bodyIndex < 0) {
    return -1
  }
  const body = checker.bodies[bodyIndex]
  const literalType = body.types[findBodySlot(body, site.nodeId)]
  if (literalType is Some(Type.TStruct(structIndex))) {
    return structIndex
  }
  return -1
}

function describeStructLiteral(
  checker: Checker,
  structIndex: int,
  writtenName: string,
): string uses alloc {
  const declaredName = typeString(checker, Type.TStruct(structIndex))
  if (writtenName != declaredName) {
    return `struct ${declaredName} as ${writtenName}`
  }
  return `struct ${declaredName}`
}

function describeStructField(checker: Checker, structIndex: int, name: string): string uses alloc {
  for (const declared of Arrays.values(checker.structs[structIndex].fields)) {
    if (declared.name == name) {
      return `${name}: ${typeString(checker, declared.fieldType)}`
    }
  }
  return ""
}

function findTokenIndex(view: ModuleView, pos: Pos): int {
  // The tokens are in source order.
  let low = 0
  let high = Arrays.length(view.tokens)
  while (low < high) {
    const middle = (low + high) / 2
    const token = view.tokens[middle]
    if (token.line == pos.line && token.column == pos.column) {
      return middle
    }
    if (token.line < pos.line || (token.line == pos.line && token.column < pos.column)) {
      low = middle + 1
    } else {
      high = middle
    }
  }
  return -1
}

function findModuleAliasPath(view: ModuleView, name: string): string {
  for (const declaration of Arrays.values(view.module.ast.imports)) {
    if (declaration.alias == name) {
      return declaration.path
    }
  }
  return ""
}

function findAliasUsePath(checker: Checker, view: ModuleView, identId: int, name: string): string {
  // A local with the alias's name hides the module.
  const bodyIndex = findNodeBody(checker, view, identId)
  if (bodyIndex >= 0) {
    const body = checker.bodies[bodyIndex]
    if (body.refs[findBodySlot(body, identId)] is Ref.Local(_)) {
      return ""
    }
  }
  return findModuleAliasPath(view, name)
}

function findQualifierHovers(
  checker: Checker,
  view: ModuleView,
  site: Site,
  enumIndex: int,
): Array<Hover> uses alloc {
  let found: Array<Hover> = []
  const index = findTokenIndex(view, site.start)
  if (index < 2) {
    return found
  }
  const enumToken = view.tokens[index - 2]
  if (view.tokens[index - 1].text != "." || enumToken.kind != TokenKind.TokIdent) {
    return found
  }
  // The declared name, and the name the source wrote when it differs.
  const info = checker.enums[enumIndex]
  let declaredName = info.name
  if (info.generic >= 0) {
    declaredName = checker.generics[info.generic].name
  }
  let enumText = `enum ${declaredName}`
  if (enumToken.text != declaredName) {
    enumText = `${enumText} as ${enumToken.text}`
  }
  Arrays.push(mutable found, Hover {
    line: enumToken.line,
    column: enumToken.column,
    length: Str.charCount(enumToken.text),
    text: enumText,
  })
  if (
    index >= 4 &&
      view.tokens[index - 3].text == "." &&
      view.tokens[index - 4].kind == TokenKind.TokIdent
  ) {
    const moduleToken = view.tokens[index - 4]
    const path = findModuleAliasPath(view, moduleToken.text)
    if (path != "") {
      Arrays.push(mutable found, Hover {
        line: moduleToken.line,
        column: moduleToken.column,
        length: Str.charCount(moduleToken.text),
        text: `module ${path}`,
      })
    }
  }
  return found
}

function describeModuleUse(
  checker: Checker,
  effects: EffectState,
  view: ModuleView,
  site: Site,
): Option<string> uses alloc {
  if (site.expression is Some(Expr.Ident(identId, _, name))) {
    if (site.kind == SiteKind.ExpressionSite) {
      const path = findAliasUsePath(checker, view, identId, name)
      if (path != "") {
        return Some(`module ${path}`)
      }
    }
    return None
  }
  let target: Option<Expr> = None
  if (site.expression is Some(Expr.FieldExpr(_, _, fieldTarget, _))) {
    if (site.kind == SiteKind.ExpressionSite) {
      target = Some(fieldTarget)
    }
  }
  if (site.expression is Some(Expr.CallExpr(_, _, Expr.FieldExpr(_, _, callTarget, _), _, _))) {
    if (site.kind == SiteKind.CalleeSite) {
      target = Some(callTarget)
    }
  }
  // `Alias.member` shows the member's text, nothing when the member has none.
  if (target is Some(Expr.Ident(identId, _, alias))) {
    const path = findAliasUsePath(checker, view, identId, alias)
    if (path != "") {
      const text = describeMember(checker, effects, path, site.name)
      if (text != "") {
        return Some(text)
      }
    }
  }
  return None
}

function isHoverAt(hover: Hover, cursor: Pos): bool {
  return (hover.line == cursor.line &&
    cursor.column >= hover.column &&
    cursor.column < hover.column + hover.length)
}

function findDetachedHover(
  checker: Checker,
  effects: EffectState,
  view: ModuleView,
  cursor: Pos,
): Option<Hover> uses alloc {
  let imports: Array<Hover> = []
  let importSlots: Map<string, int> = Map {}
  collectImportNames(checker, effects, view, Some(cursor), mutable imports, mutable importSlots)
  for (const hover of Arrays.values(imports)) {
    if (isHoverAt(hover, cursor)) {
      return Some(hover)
    }
  }
  for (const site of Arrays.values(view.sites)) {
    // The qualifiers of a variant are written before it, on its line.
    if (site.name != "" && site.start.line == cursor.line && isBefore(cursor, site.start)) {
      const ref = findSiteRef(checker, view, site)
      if (ref is Ref.Constructor(enumIndex, _)) {
        for (const qualifier of Arrays.values(
          findQualifierHovers(checker, view, site, enumIndex),
        )) {
          if (isHoverAt(qualifier, cursor)) {
            return Some(qualifier)
          }
        }
      }
    }
    // The fields of a struct literal.
    if (site.kind == SiteKind.ExpressionSite) {
      if (site.expression is Some(Expr.StructLit(_, _, _, _, fields, _))) {
        for (const field of Arrays.values(fields)) {
          const fieldHover = Hover {
            line: field.pos.line,
            column: field.pos.column,
            length: Str.charCount(field.name),
            text: "",
          }
          if (!field.isShorthand && isHoverAt(fieldHover, cursor)) {
            const structIndex = findStructLiteralIndex(checker, view, site)
            if (structIndex >= 0) {
              return Some(Hover {
                line: fieldHover.line,
                column: fieldHover.column,
                length: fieldHover.length,
                text: describeStructField(checker, structIndex, field.name),
              })
            }
          }
        }
      }
    }
  }
  return None
}

function compareHovers(left: Hover, right: Hover): Ordering {
  if (left.line != right.line) {
    return Int.compare(left.line, right.line)
  }
  return Int.compare(left.column, right.column)
}

function findTokenLength(view: ModuleView, pos: Pos): int {
  for (const token of Arrays.values(view.tokens)) {
    if (token.line == pos.line && token.column == pos.column && token.endLine == token.line) {
      return token.endColumn - token.column
    }
  }
  return 1
}

function writeHovers(
  json: bool,
  file: string,
  hovers: Array<Hover>,
  diagnostics: Array<HoverDiagnostic>,
): string uses alloc {
  let hoverParts: Array<string> = []
  let diagnosticParts: Array<string> = []
  let lines: Array<string> = []
  for (const hover of Arrays.values(hovers)) {
    const place = `"line": ${Int.toString(hover.line)}, "column": ${Int.toString(hover.column)}, "length": ${Int.toString(hover.length)}`
    Arrays.push(mutable hoverParts, `{${place}, "text": ${quoteJson(hover.text)}}`)
    const flat = Str.join(splitString(hover.text, "\n"), " | ")
    Arrays.push(
      mutable lines,
      `${file}:${Int.toString(hover.line)}:${Int.toString(hover.column)} ${flat}\n`,
    )
  }
  for (const diagnostic of Arrays.values(diagnostics)) {
    let code = diagnostic.code
    if (code == "") {
      code = "E0000"
    }
    const place = `"line": ${Int.toString(diagnostic.line)}, "column": ${Int.toString(diagnostic.column)}, "length": ${Int.toString(diagnostic.length)}`
    Arrays.push(
      mutable diagnosticParts,
      `{${place}, "code": ${quoteJson(code)}, "message": ${quoteJson(diagnostic.message)}}`,
    )
    Arrays.push(
      mutable lines,
      `${file}:${Int.toString(diagnostic.line)}:${Int.toString(diagnostic.column)} ${code} ${diagnostic.message}\n`,
    )
  }
  if (!json) {
    return Str.join(lines, "")
  }
  return `{"query": "hovers", "file": ${quoteJson(file)}, "hovers": [${Str.join(hoverParts, ", ")}], "diagnostics": [${Str.join(diagnosticParts, ", ")}]}\n`
}

function isCommand(name: string): bool {
  for (const command of Arrays.values(COMMANDS)) {
    if (command == name) {
      return true
    }
  }
  return false
}

function printError(text: string) uses io, alloc {
  const _ = Fs.writeText("/dev/stderr", `${text}\n`)
}

function writeStdout(text: string): int uses io, alloc {
  const written = Fs.writeText("/dev/stdout", text)
  if (written is Err(message)) {
    printError(message)
    return 1
  }
  return 0
}

function describeAnswerFailure(json: bool, message: string): Failure uses alloc {
  if (json) {
    return Failure {
      output: `{"error": ${quoteJson(message)}}\n`,
      errorOutput: "",
      isLookup: false,
    }
  }
  return Failure { output: "", errorOutput: `error ${message}\n`, isLookup: false }
}

function reportAnswer(json: bool, answer: Result<string, string>): int uses io, alloc {
  if (answer is Err(message)) {
    return reportFailure(describeAnswerFailure(json, message))
  }
  return writeStdout(answer.value)
}

function prefixMemberFile(filePrefix: string, file: string): string uses alloc {
  // A file of the member itself is `src/...` or `narra.toml`; the file of a dependency starts with
  // the dependency's name and stays as it is.
  if (filePrefix == "" || filePrefix == ".") {
    return file
  }
  if (file == "narra.toml" || Str.startsWith(file, "src/")) {
    return Path.join(filePrefix, file)
  }
  return file
}

function describeLoadFailure(
  json: bool,
  filePrefix: string,
  errors: Array<LoadError>,
): Failure uses alloc {
  let named: Array<LoadError> = []
  for (const error of Arrays.values(errors)) {
    Arrays.push(mutable named, LoadError {
      ...error,
      file: prefixMemberFile(filePrefix, error.file),
    })
  }
  if (!json) {
    return Failure { output: "", errorOutput: Modules.errorText(named), isLookup: false }
  }
  let parts: Array<string> = []
  for (const error of Arrays.values(named)) {
    const pos = Pos { line: error.line, column: error.column }
    Arrays.push(mutable parts, writeDiagnostic(error.file, pos, error.code, error.message))
  }
  return Failure {
    output: `{"errors": [${Str.join(parts, ", ")}]}\n`,
    errorOutput: "",
    isLookup: false,
  }
}

function reportLoadErrors(json: bool, errors: Array<LoadError>): int uses io, alloc {
  return reportFailure(describeLoadFailure(json, "", errors))
}

function describeCheckFailure(
  json: bool,
  filePrefix: string,
  errors: Array<CheckError>,
): Failure uses alloc {
  let named: Array<CheckError> = []
  for (const error of Arrays.values(errors)) {
    Arrays.push(mutable named, CheckError {
      ...error,
      file: prefixMemberFile(filePrefix, error.file),
    })
  }
  if (!json) {
    return Failure { output: "", errorOutput: errorText(named), isLookup: false }
  }
  let parts: Array<string> = []
  for (const error of Arrays.values(named)) {
    Arrays.push(mutable parts, writeDiagnostic(error.file, error.pos, error.code, error.message))
  }
  return Failure {
    output: `{"errors": [${Str.join(parts, ", ")}]}\n`,
    errorOutput: "",
    isLookup: false,
  }
}

export function buildViews(
  checker: Checker,
  package: Package,
  overrides: Map<string, string>,
): Result<Array<ModuleView>, string> from package uses io, alloc {
  let views: Array<ModuleView> = []
  let order: Array<int> = []
  for (const index of Ranges.between(0, Arrays.length(package.modules))) {
    if (!Str.startsWith(package.modules[index].path, "std/")) {
      Arrays.push(mutable order, index)
    }
  }
  Arrays.sortBy(mutable order, (left: int, right: int) => Ordered.compare(
    package.modules[left].file,
    package.modules[right].file,
  ))
  for (const moduleIndex of Arrays.values(order)) {
    const module = package.modules[moduleIndex]
    let text = ""
    // A file whose path is a key of overrides is read from the map, as Modules.loadWith reads
    // it.
    if (overrides[module.source] is Some(open)) {
      text = open
    } else {
      const read = Fs.readText(module.source)
      if (read is Err(message)) {
        return Err(message)
      }
      text = read.value
    }
    const tokens = lex(text)
    if (tokens is Err(message)) {
      return Err(`${module.file}:${formatLexError(message)}`)
    }
    let bodies: Array<int> = []
    for (const bodyIndex of Ranges.between(0, Arrays.length(checker.bodies))) {
      const body = checker.bodies[bodyIndex]
      if (body.module == module.path && Arrays.length(body.typeArguments) == 0) {
        Arrays.push(mutable bodies, bodyIndex)
      }
    }
    const view = ModuleView {
      path: module.path,
      file: module.file,
      module,
      text,
      tokens: tokens.value,
      sites: collectSites(module.ast, tokens.value),
      bodies,
    }
    Arrays.push(mutable views, view)
  }
  return Ok(views)
}

function findView(query: Query, path: string): int {
  let index = 0
  for (const view of Arrays.values(query.views)) {
    if (view.path == path) {
      return index
    }
    index++
  }
  return -1
}

export function findNodeBody(checker: Checker, view: ModuleView, nodeId: int): int {
  for (const bodyIndex of Arrays.values(view.bodies)) {
    if (findBodySlot(checker.bodies[bodyIndex], nodeId) >= 0) {
      return bodyIndex
    }
  }
  return -1
}

function findSiteRef(checker: Checker, view: ModuleView, site: Site): Ref {
  const bodyIndex = findNodeBody(checker, view, site.nodeId)
  if (bodyIndex < 0) {
    return Ref.Unresolved
  }
  const body = checker.bodies[bodyIndex]
  return body.refs[findBodySlot(body, site.nodeId)]
}

export function siteLocation(view: ModuleView, site: Site): Location {
  return Location { file: view.file, start: copy(site.start), end: copy(site.end) }
}

function findFunctionIndex(checker: Checker, module: string, pos: Pos): int {
  let index = 0
  for (const info of Arrays.values(checker.functions)) {
    if (info.module == module && info.declaration.pos == pos) {
      return index
    }
    index++
  }
  return -1
}

function findConstIndex(checker: Checker, module: string, pos: Pos): int {
  let index = 0
  for (const info of Arrays.values(checker.consts)) {
    if (info.module == module && info.declaration.pos == pos) {
      return index
    }
    index++
  }
  return -1
}

function findConstType(checker: Checker, index: int): string uses alloc {
  if (checker.consts[index].valueType is Some(valueType)) {
    return typeString(checker, valueType)
  }
  if (checker.consts[index].declaredType is Some(declaredType)) {
    return typeString(checker, declaredType)
  }
  return "void"
}

function writeFunctionType(
  checker: Checker,
  declaration: FuncDecl,
  result: Type,
): string uses alloc {
  // Each part from the checker, or as written when it lists effects. The
  // parameter a `from` names keeps its name.
  const shared = findSharedParameter(declaration)
  let parts: Array<string> = []
  for (const index of Ranges.upTo(Arrays.length(declaration.parameters))) {
    const parameter = declaration.parameters[index]
    const written = writeLocalType(checker, checker.paramTypes[parameter.id], parameter.type)
    if (parameter.default is Some(value)) {
      // A default is part of the interface, so it is shown with its name (D115).
      Arrays.push(
        mutable parts,
        `${parameter.name}: ${written} = ${Signature.writeDefaultValue(value)}`,
      )
    } else if (index == shared) {
      Arrays.push(mutable parts, `${parameter.name}: ${written}`)
    } else {
      Arrays.push(mutable parts, written)
    }
  }
  let resultText = writeLocalType(checker, result, declaration.result)
  if (shared >= 0) {
    const marker = ` from ${declaration.parameters[shared].name}`
    if (!Str.endsWith(resultText, marker)) {
      resultText = `${resultText}${marker}`
    }
  }
  return `(${Str.join(parts, ", ")}) => ${resultText}`
}

function findEffectNames(
  checker: Checker,
  effects: EffectState,
  ref: Ref,
  declaration: FuncDecl,
): Array<string> uses alloc {
  // An exported function shows its declared effects, a private one the inferred ones. Naming a
  // function has no effects of its own.
  if (declaration.exported && !declaration.generator) {
    let names = copy(declaration.effects)
    Arrays.sort(mutable names)
    return names
  }
  // Without the effect pass (a package with errors) a private function shows no effects.
  if (Arrays.length(effects.functionKeys) > 0) {
    if (Effects.findRefEffects(checker, effects, ref) is Some(found)) {
      return found
    }
  }
  return []
}

function describeCallable(checker: Checker, effects: EffectState, ref: Ref): Option<#[
  string,
  Array<string>,
]> uses alloc {
  let declaration = FuncDecl {
    pos: Pos { line: 0, column: 0 },
    name: "",
    typeParameters: [],
    bounds: [],
    exported: false,
    parameters: [],
    result: None,
    effects: [],
    effectParameters: [],
    body: None,
  }
  let result = Type.TVoid
  match (ref) {
    Ref.Function(index) => {
      declaration = checker.functions[index].declaration
      result = checker.functions[index].result
    }
    Ref.Implementation(block, index) => {
      declaration = checker.implementations[block].functions[index].declaration
      result = checker.implementations[block].functions[index].result
    }
    _ => {
      return None
    }
  }
  const names = findEffectNames(checker, effects, ref, declaration)
  return Some(#[`${writeFunctionType(checker, declaration, result)}${writeTypeUses(names)}`, []])
}

function needsWrittenType(type: TypeExpr): bool {
  // The checker's function types do not keep effects or parameter names, so look in the
  // written type for effects and `from` markers.
  if (Arrays.length(type.effects) > 0 || type.resultFrom != "") {
    return true
  }
  for (const argument of Arrays.values(type.arguments)) {
    if (needsWrittenType(argument)) {
      return true
    }
  }
  if (type.result is Some(boxed)) {
    return needsWrittenType(boxed.value)
  }
  return false
}

function writeLocalType(
  checker: Checker,
  type: Type,
  annotation: Option<TypeExpr>,
): string uses alloc {
  // Function types keep their `uses` only as written, so use the annotation when it lists
  // effects.
  if (annotation is Some(written)) {
    if (needsWrittenType(written)) {
      return Signature.writeType(written)
    }
  }
  return typeString(checker, type)
}

function findLocalAnnotation(
  checker: Checker,
  view: ModuleView,
  bodyIndex: int,
  localIndex: int,
): Option<TypeExpr> from view {
  const body = checker.bodies[bodyIndex]
  for (const site of Arrays.values(view.sites)) {
    if (site.kind != SiteKind.LocalSite || site.annotation is None) {
      continue
    }
    const slot = findBodySlot(body, site.nodeId)
    if (slot >= 0 && body.declared[slot] == localIndex) {
      return site.annotation
    }
  }
  return None
}

function describeSite(
  mutable checker: Checker,
  mutable effects: EffectState,
  effectsKnown: bool,
  view: ModuleView,
  site: Site,
): Option<#[string, Array<string>]> uses alloc {
  if (site.kind == SiteKind.DeclarationSite) {
    return describeDeclaration(checker, effects, view, site)
  }
  // A module alias, or a member reached through one.
  if (describeModuleUse(checker, effects, view, site) is Some(moduleText)) {
    return Some(#[moduleText, []])
  }
  // Without effectsKnown the effects of expressions are left out.
  const bodyIndex = findNodeBody(checker, view, site.nodeId)
  if (bodyIndex < 0) {
    return None
  }
  const body = copy(checker.bodies[bodyIndex])
  const slot = findBodySlot(body, site.nodeId)
  const ref = body.refs[slot]
  const nodeType = body.types[slot]
  // A variant shows its fields.
  if (ref is Ref.Constructor(enumIndex, variantIndex)) {
    if (site.name != "") {
      return Some(#[describeVariant(checker, enumIndex, variantIndex), []])
    }
  }
  // A struct literal shows its struct at the type name.
  if (site.expression is Some(Expr.StructLit(_, _, typeName, _, _, _))) {
    if (site.kind == SiteKind.ExpressionSite && typeName != "") {
      const structIndex = findStructLiteralIndex(checker, view, site)
      if (structIndex >= 0) {
        return Some(#[describeStructLiteral(checker, structIndex, typeName), []])
      }
    }
  }
  match (site.kind) {
    SiteKind.ExpressionSite => {
      if (nodeType is Some(found)) {
        // A function or local named here: the type of the name. A call
        // records the callee's ref too, but answers with its result.
        if (site.name != "") {
          if (describeCallable(checker, effects, ref) is Some(callable)) {
            return Some(callable)
          }
        }
        let typeText = typeString(checker, found)
        if (ref is Ref.Local(localIndex)) {
          const annotation = findLocalAnnotation(checker, view, bodyIndex, localIndex)
          typeText = writeLocalType(checker, found, annotation)
        }
        // An arrow function's type carries the effects of its body.
        if (site.expression is Some(Expr.ArrowExpr(arrowId, _, _, _, _, _))) {
          if (Effects.findArrowEffects(effects, arrowId) is Some(arrowEffects)) {
            typeText = `${typeText}${writeTypeUses(arrowEffects)}`
          }
        }
        let names: Array<string> = []
        if (site.expression is Some(expression)) {
          if (effectsKnown) {
            names = Effects.findExpressionEffects(
              mutable checker,
              mutable effects,
              bodyIndex,
              expression,
            )
          }
        }
        return Some(#[typeText, names])
      }
    }
    SiteKind.CalleeSite => {
      if (describeCallable(checker, effects, ref) is Some(callable)) {
        return Some(callable)
      }
      // A call through a local: the callee's own expression site answers.
      if (ref is Ref.Value) {
        return None
      }
      // A builtin shows its signature.
      if (site.expression is Some(Expr.CallExpr(_, _, Expr.Ident(_, _, _), _, _))) {
        const signature = findBuiltinCallee(checker, view, site.name)
        if (signature != "") {
          return Some(#[signature, []])
        }
      }
      // A constructor: the checker records nothing for the name, so the name
      // answers for the call (its type and effects).
      if (nodeType is Some(found)) {
        let names: Array<string> = []
        if (site.expression is Some(expression)) {
          if (effectsKnown) {
            names = Effects.findExpressionEffects(
              mutable checker,
              mutable effects,
              bodyIndex,
              expression,
            )
          }
        }
        return Some(#[typeString(checker, found), names])
      }
    }
    SiteKind.LocalSite => {
      const local = body.declared[slot]
      if (local >= 0) {
        const localType = body.locals[local].localType
        return Some(#[writeLocalType(checker, localType, site.annotation), []])
      }
    }
    SiteKind.VariantPatternSite => {
      if (ref is Ref.Constructor(_, _)) {
        if (nodeType is Some(found)) {
          return Some(#[typeString(checker, found), []])
        }
      }
    }
    SiteKind.DeclarationSite | SiteKind.LabelSite => {}
  }
  return None
}

function describeDeclaration(
  checker: Checker,
  effects: EffectState,
  view: ModuleView,
  site: Site,
): Option<#[string, Array<string>]> uses alloc {
  const declaration = view.module.ast.declarations[site.declaration]
  if (declaration is Decl.Func(funcDecl)) {
    const index = findFunctionIndex(checker, view.path, funcDecl.pos)
    if (index >= 0) {
      return describeCallable(checker, effects, Ref.Function(index))
    }
  }
  if (declaration is Decl.Const(constDecl)) {
    const index = findConstIndex(checker, view.path, constDecl.pos)
    if (index >= 0) {
      return Some(#[findConstType(checker, index), []])
    }
  }
  return None
}

function queryType(
  mutable checker: Checker,
  mutable effects: EffectState,
  query: Query,
  operand: string,
): Result<string, string> uses alloc {
  // FILE:LINE:COL, the file possibly holding colons.
  const parts = splitString(operand, ":")
  const count = Arrays.length(parts)
  if (count < 3) {
    return Err(`expected FILE:LINE:COL, found "${operand}"`)
  }
  const line = Int.parse(parts[count - 2], 10)
  const column = Int.parse(parts[count - 1], 10)
  let lineNumber = 0
  let columnNumber = 0
  if (line is Ok(parsedLine)) {
    lineNumber = parsedLine
  } else {
    return Err(`expected FILE:LINE:COL, found "${operand}"`)
  }
  if (column is Ok(parsedColumn)) {
    columnNumber = parsedColumn
  } else {
    return Err(`expected FILE:LINE:COL, found "${operand}"`)
  }
  let fileParts: Array<string> = []
  for (const index of Ranges.between(0, count - 2)) {
    Arrays.push(mutable fileParts, parts[index])
  }
  const file = Str.join(fileParts, ":")
  let viewIndex = -1
  for (const index of Ranges.between(0, Arrays.length(query.views))) {
    if (query.views[index].file == file) {
      viewIndex = index
    }
  }
  if (viewIndex < 0) {
    return Err(`no module has the file "${file}"`)
  }
  const cursor = Pos { line: lineNumber, column: columnNumber }
  match (findTypeAt(mutable checker, mutable effects, true, query.views[viewIndex], cursor)) {
    TypeAt.Found(answer) => {
      if (query.json) {
        return Ok(
          `{"query": "type-of", "location": ${writeLocation(answer.location)}, "type": ${quoteJson(answer.typeText)}, "effects": ${writeStringList(answer.effects)}}\n`,
        )
      }
      if (Arrays.length(answer.effects) == 0) {
        return Ok(`${answer.typeText}\n`)
      }
      return Ok(`${answer.typeText}\neffects: ${Str.join(answer.effects, ", ")}\n`)
    }
    TypeAt.Nothing => {
      return Err(`no expression at ${operand}`)
    }
  }
}

// The type-of answer at a position: the type text and effects of a site.
export struct TypeAnswer {
  location: Location
  typeText: string
  effects: Array<string>
}

// What findTypeAt finds: an answer or nothing.
export enum TypeAt {
  Found(answer: TypeAnswer)
  Nothing
}

export function findTypeAt(
  mutable checker: Checker,
  mutable effects: EffectState,
  effectsKnown: bool,
  view: ModuleView,
  cursor: Pos,
): TypeAt from view uses alloc {
  // Without effectsKnown (the effect pass did not run) the effects of expressions are left
  // out.
  // Names that are no site: imports, struct fields, the qualifiers of a variant.
  if (findDetachedHover(checker, effects, view, cursor) is Some(hover)) {
    return TypeAt.Found(TypeAnswer {
      location: Location {
        file: view.file,
        start: Pos { line: hover.line, column: hover.column },
        end: Pos { line: hover.line, column: hover.column + hover.length },
      },
      typeText: hover.text,
      effects: [],
    })
  }
  // Sites are listed outer first: try the last one that covers the cursor.
  for (let index = Arrays.length(view.sites) - 1; index >= 0; index--) {
    const site = view.sites[index]
    const covers = !isBefore(cursor, site.start) && isBefore(cursor, site.end)
    if (covers) {
      const described = describeSite(mutable checker, mutable effects, effectsKnown, view, site)
      if (described is Some(found)) {
        const #[typeText, names] = found
        return TypeAt.Found(TypeAnswer {
          location: siteLocation(view, site),
          typeText,
          effects: names,
        })
      }
    }
  }
  return TypeAt.Nothing
}

export function listDeclarations(query: Query): Array<Declared> from query uses alloc {
  let declared: Array<Declared> = []
  for (const viewIndex of Ranges.between(0, Arrays.length(query.views))) {
    const view = query.views[viewIndex]
    for (const site of Arrays.values(view.sites)) {
      if (site.kind != SiteKind.DeclarationSite) {
        continue
      }
      const declaration = view.module.ast.declarations[site.declaration]
      let kind = Signature.describeDeclarationKind(declaration)
      let names = [site.name]
      // An enum member site is a variant, also found by its qualified name.
      if (declaration is Decl.Enum(enumDecl)) {
        if (site.member >= 0) {
          kind = "variant"
          names = [`${enumDecl.name}.${site.name}`, site.name]
        }
      }
      const qualified = `${view.path}.${names[0]}`
      Arrays.push(mutable names, qualified)
      Arrays.push(mutable declared, Declared {
        qualified,
        kind,
        names,
        location: siteLocation(view, site),
        view: viewIndex,
        declaration: site.declaration,
        member: site.member,
      })
    }
  }
  return declared
}

function findDeclared(query: Query, name: string): Array<Declared> from query uses alloc {
  // A name is qualified (`app/text.helper`, `app/shape.Shape.Circle`) or bare (`helper`,
  // `Shape.Circle`, `Circle`).
  let matches: Array<Declared> = []
  for (const candidate of Arrays.values(listDeclarations(query))) {
    for (const spelling of Arrays.values(candidate.names)) {
      if (spelling == name) {
        Arrays.push(mutable matches, candidate)
        break
      }
    }
  }
  return matches
}

function findOneDeclared(
  query: Query,
  name: string,
): Result<Declared, string> from query uses alloc {
  const matches = findDeclared(query, name)
  if (Arrays.length(matches) == 0) {
    return Err(`unknown name "${name}"`)
  }
  if (Arrays.length(matches) > 1) {
    let names: Array<string> = []
    for (const candidate of Arrays.values(matches)) {
      Arrays.push(mutable names, candidate.qualified)
    }
    return Err(`"${name}" names ${Str.join(names, ", ")}; write a qualified name`)
  }
  return Ok(matches[0])
}

function queryDef(query: Query, name: string): Result<string, string> uses alloc {
  const matches = findDeclared(query, name)
  if (Arrays.length(matches) == 0) {
    return Err(`unknown name "${name}"`)
  }
  let lines: Array<string> = []
  for (const found of Arrays.values(matches)) {
    if (query.json) {
      Arrays.push(
        mutable lines,
        `{"name": ${quoteJson(found.qualified)}, "kind": ${quoteJson(found.kind)}, "location": ${writeLocation(found.location)}}`,
      )
    } else {
      Arrays.push(
        mutable lines,
        `${found.qualified} ${found.kind} ${writeLocationText(found.location)}\n`,
      )
    }
  }
  if (query.json) {
    return Ok(`{"query": "def", "matches": [${Str.join(lines, ", ")}]}\n`)
  }
  return Ok(Str.join(lines, ""))
}

function describeImplementation(
  checker: Checker,
  module: string,
  declaration: FuncDecl,
): string uses alloc {
  for (const impl of Arrays.values(checker.implementations)) {
    if (checker.scopes[impl.scope].path != module) {
      continue
    }
    for (const implFunc of Arrays.values(impl.functions)) {
      if (implFunc.declaration.pos == declaration.pos) {
        return `${typeString(checker, impl.forType)}.${checker.traits[impl.traitIndex].name}.${implFunc.name}`
      }
    }
  }
  // A declaration in no checked block keeps its own name.
  return declaration.name
}

function describeBody(checker: Checker, bodyIndex: int): string uses alloc {
  // A test is named `app/text.test "name"`; a constant or field default by its qualified name.
  const body = checker.bodies[bodyIndex]
  if (body.kind == "impl") {
    if (body.root is BodyRoot.RootFunc(declaration)) {
      return `${body.module}.${describeImplementation(checker, body.module, declaration)}`
    }
  }
  if (body.kind == "test") {
    return `${body.module}.test ${body.name}`
  }
  if (body.kind == "default") {
    return body.name
  }
  return `${body.module}.${body.name}`
}

export function findTarget(
  checker: Checker,
  query: Query,
  declared: Declared,
): Result<Target, string> uses alloc {
  const view = query.views[declared.view]
  match (view.module.ast.declarations[declared.declaration]) {
    Decl.Func(funcDecl) => {
      const index = findFunctionIndex(checker, view.path, funcDecl.pos)
      if (index >= 0) {
        return Ok(Target.FunctionTarget(index))
      }
    }
    Decl.Const(constDecl) => {
      const index = findConstIndex(checker, view.path, constDecl.pos)
      if (index >= 0) {
        return Ok(Target.ConstTarget(index))
      }
    }
    Decl.Enum(enumDecl) => {
      if (declared.member >= 0) {
        return Ok(Target.VariantTarget(view.path, enumDecl.name, declared.member))
      }
    }
    _ => {}
  }
  return Err(
    `refs finds uses of functions, constants and enum variants; ${declared.qualified} is a ${declared.kind}`,
  )
}

function isFunctionRef(ref: Ref, wanted: int): bool {
  if (ref is Ref.Function(index)) {
    return index == wanted
  }
  return false
}

function isTargetRef(checker: Checker, ref: Ref, target: Target): bool {
  return match (target) {
    Target.FunctionTarget(wanted) => isFunctionRef(ref, wanted)
    Target.ConstTarget(wanted) => {
      if (ref is Ref.Const(index)) {
        return index == wanted
      }
      return false
    }
    Target.VariantTarget(module, enumName, variant) => {
      if (ref is Ref.Constructor(enumIndex, found)) {
        const info = checker.enums[enumIndex]
        return info.module == module && info.name == enumName && found == variant
      }
      return false
    }
  }
}

function insertUse(mutable places: Array<Use>, use: Use) uses alloc {
  // A second use at the same place (a call's callee and its name) is dropped.
  for (const other of Arrays.values(places)) {
    const samePlace = other.view == use.view && other.location.start == use.location.start
    if (samePlace) {
      return
    }
  }
  Arrays.push(mutable places, use)
  for (
    let index = Arrays.length(places) - 1;
    index > 0 && isUseBefore(places[index], places[index - 1]);
    index--
  ) {
    const swap = places[index]
    places[index] = places[index - 1]
    places[index - 1] = swap
  }
}

function isUseBefore(left: Use, right: Use): bool {
  return left.view < right.view ||
    (left.view == right.view && isBefore(left.location.start, right.location.start))
}

function writeUses(query: Query, places: Array<Use>, nameFirst: bool): string uses alloc {
  let parts: Array<string> = []
  for (const use of Arrays.values(places)) {
    if (query.json && nameFirst) {
      Arrays.push(
        mutable parts,
        `{"name": ${quoteJson(use.name)}, "location": ${writeLocation(use.location)}}`,
      )
    } else if (query.json) {
      Arrays.push(
        mutable parts,
        `{"location": ${writeLocation(use.location)}, "in": ${quoteJson(use.name)}}`,
      )
    } else {
      Arrays.push(mutable parts, `${writeLocationText(use.location)} ${use.name}\n`)
    }
  }
  if (query.json) {
    return `[${Str.join(parts, ", ")}]`
  }
  if (Arrays.length(parts) == 0) {
    return "(none)\n"
  }
  return Str.join(parts, "")
}

function queryParameterRefs(
  checker: Checker,
  query: Query,
  functionName: string,
  parameterName: string,
): Result<string, string> uses alloc {
  const declared = findOneDeclared(query, functionName)
  if (declared is Err(message)) {
    return Err(message)
  }
  const target = findTarget(checker, query, declared.value)
  let wanted = -1
  if (target is Ok(found)) {
    if (found is Target.FunctionTarget(index)) {
      wanted = index
    }
  }
  if (wanted < 0) {
    return Err(`${declared.value.qualified} is a ${declared.value.kind}, not a function`)
  }
  // The parameter must exist.
  let hasParameter = false
  for (const parameter of Arrays.values(checker.functions[wanted].declaration.parameters)) {
    if (parameter.name == parameterName) {
      hasParameter = true
    }
  }
  if (!hasParameter) {
    return Err(`${declared.value.qualified} has no parameter "${parameterName}"`)
  }
  // A label names the parameter of the function its call resolves to.
  let places: Array<Use> = []
  for (const viewIndex of Ranges.between(0, Arrays.length(query.views))) {
    const view = query.views[viewIndex]
    for (const site of Arrays.values(view.sites)) {
      if (site.kind != SiteKind.LabelSite || site.name != parameterName) {
        continue
      }
      if (!isFunctionRef(findSiteRef(checker, view, site), wanted)) {
        continue
      }
      const bodyIndex = findNodeBody(checker, view, site.nodeId)
      insertUse(mutable places, Use {
        view: viewIndex,
        location: siteLocation(view, site),
        name: describeBody(checker, bodyIndex),
      })
    }
  }
  if (query.json) {
    const qualifiedParameter = `${declared.value.qualified}.${parameterName}`
    return Ok(
      `{"query": "refs", "name": ${quoteJson(qualifiedParameter)}, "uses": ${writeUses(query, places, false)}}\n`,
    )
  }
  return Ok(writeUses(query, places, false))
}

function queryRefs(
  checker: Checker,
  query: Query,
  name: string,
): Result<string, string> uses alloc {
  if (Arrays.length(findDeclared(query, name)) == 0) {
    const parts = splitString(name, ".")
    if (Arrays.length(parts) > 1) {
      const parameterName = parts[Arrays.length(parts) - 1]
      const functionName = substring(name, 0, Str.length(name) - Str.length(parameterName) - 1)
      if (Arrays.length(findDeclared(query, functionName)) > 0) {
        return queryParameterRefs(checker, query, functionName, parameterName)
      }
    }
  }
  const declared = findOneDeclared(query, name)
  if (declared is Err(message)) {
    return Err(message)
  }
  const target = findTarget(checker, query, declared.value)
  if (target is Err(message)) {
    return Err(message)
  }
  const places = findUses(checker, query, target.value)
  if (query.json) {
    return Ok(
      `{"query": "refs", "name": ${quoteJson(declared.value.qualified)}, "uses": ${writeUses(query, places, false)}}\n`,
    )
  }
  return Ok(writeUses(query, places, false))
}

export function findUses(
  checker: Checker,
  query: Query,
  target: Target,
): Array<Use> from query uses alloc {
  let places: Array<Use> = []
  for (const viewIndex of Ranges.between(0, Arrays.length(query.views))) {
    const view = query.views[viewIndex]
    for (const site of Arrays.values(view.sites)) {
      // A callee's name is reported through the call's CalleeSite.
      const isName = site.kind == SiteKind.ExpressionSite && site.name != "" && !site.isCallee
      if (!isName && site.kind != SiteKind.CalleeSite && site.kind != SiteKind.VariantPatternSite) {
        continue
      }
      if (!isTargetRef(checker, findSiteRef(checker, view, site), target)) {
        continue
      }
      const bodyIndex = findNodeBody(checker, view, site.nodeId)
      insertUse(mutable places, Use {
        view: viewIndex,
        location: siteLocation(view, site),
        name: describeBody(checker, bodyIndex),
      })
    }
  }
  return places
}

function queryCallers(
  checker: Checker,
  effects: EffectState,
  query: Query,
  name: string,
): Result<string, string> uses alloc {
  const declared = findOneDeclared(query, name)
  if (declared is Err(message)) {
    return Err(message)
  }
  const target = findTarget(checker, query, declared.value)
  let wanted = -1
  if (target is Ok(found)) {
    if (found is Target.FunctionTarget(index)) {
      wanted = index
    }
  }
  if (wanted < 0) {
    return Err(`${declared.value.qualified} is a ${declared.value.kind}, not a function`)
  }
  const functionName = checker.functions[wanted].declaration.name
  let places: Array<Use> = []
  for (const call of Arrays.values(effects.calls)) {
    if (!isFunctionRef(call.callee, wanted)) {
      continue
    }
    const viewIndex = findView(query, checker.bodies[call.body].module)
    if (viewIndex < 0) {
      continue
    }
    // The callee's name, from the call's site.
    let location = Location {
      file: query.views[viewIndex].file,
      start: call.pos,
      end: Pos { line: call.pos.line, column: call.pos.column + Str.charCount(functionName) },
    }
    for (const site of Arrays.values(query.views[viewIndex].sites)) {
      if (site.kind == SiteKind.CalleeSite && site.nodeId == call.callId) {
        location = siteLocation(query.views[viewIndex], site)
        break
      }
    }
    insertUse(mutable places, Use {
      view: viewIndex,
      location,
      name: describeBody(checker, call.body),
    })
  }
  if (query.json) {
    return Ok(
      `{"query": "callers", "name": ${quoteJson(declared.value.qualified)}, "callers": ${writeUses(query, places, true)}}\n`,
    )
  }
  return Ok(
    `${writeUses(query, places, true)}note: calls through function values are not counted\n`,
  )
}

function findSignature(checker: Checker, view: ModuleView, declaration: Decl): string uses alloc {
  // A const shows the type the checker gave it.
  let constType = ""
  if (declaration is Decl.Const(constDecl)) {
    const index = findConstIndex(checker, view.path, constDecl.pos)
    if (index >= 0) {
      constType = findConstType(checker, index)
    } else if (constDecl.type is None) {
      constType = "void"
    }
  }
  return Signature.writeDeclaration(declaration, constType)
}

function queryInterface(
  checker: Checker,
  query: Query,
  path: string,
): Result<string, string> uses alloc {
  const viewIndex = findView(query, path)
  if (viewIndex < 0) {
    return Err(`unknown module "${path}"`)
  }
  const view = query.views[viewIndex]
  const declared = listDeclarations(query)
  const lines = splitLines(view.text)
  let entries: Array<InterfaceEntry> = []
  for (const entry of Arrays.values(declared)) {
    if (entry.view != viewIndex || entry.member >= 0) {
      continue
    }
    const signature = findSignature(checker, view, view.module.ast.declarations[entry.declaration])
    if (signature == "") {
      continue
    }
    Arrays.push(mutable entries, InterfaceEntry {
      name: entry.names[0],
      kind: entry.kind,
      signature,
      doc: findDocComment(lines, entry.location.start.line),
      location: Some(entry.location),
    })
  }
  return Ok(writeInterface(query.json, path, entries))
}

function writePosKey(pos: Pos): string uses alloc {
  return `${Int.toString(pos.line)}:${Int.toString(pos.column)}`
}

function findCalleeDeclaration(checker: Checker, ref: Ref): #[string, Pos] from checker {
  return match (ref) {
    Ref.Function(index) => #[
      checker.functions[index].module,
      checker.functions[index].declaration.pos,
    ]
    Ref.Implementation(block, index) => #[
      checker.scopes[checker.implementations[block].scope].path,
      checker.implementations[block].functions[index].declaration.pos,
    ]
    _ => #["", Pos { line: 0, column: 0 }]
  }
}

function queryRecursion(
  checker: Checker,
  effects: EffectState,
  query: Query,
  path: string,
): Result<string, string> uses alloc {
  // Only direct calls inside the module count.
  const viewIndex = findView(query, path)
  if (viewIndex < 0) {
    return Err(`unknown module "${path}"`)
  }

  // One node per function and implement block function of the module.
  let nodeNames: Array<string> = []
  let nodeIndex: Map<string, int> = Map {}
  let bodyNodes: Map<int, int> = Map {}
  for (const bodyIndex of Arrays.values(query.views[viewIndex].bodies)) {
    const body = checker.bodies[bodyIndex]
    if (body.kind != "func" && body.kind != "impl") {
      continue
    }
    if (body.root is BodyRoot.RootFunc(declaration)) {
      bodyNodes[bodyIndex] = Arrays.length(nodeNames)
      nodeIndex[writePosKey(declaration.pos)] = Arrays.length(nodeNames)
      Arrays.push(mutable nodeNames, describeBody(checker, bodyIndex))
    }
  }
  // Each node gets a list of its own, so a push changes only that list.
  let edges: Array<Array<int>> = Arrays.withCapacity(Arrays.length(nodeNames))
  for (const _ of Ranges.upTo(Arrays.length(nodeNames))) {
    Arrays.push(mutable edges, [])
  }
  for (const call of Arrays.values(effects.calls)) {
    if (bodyNodes[call.body] is Some(caller)) {
      const #[module, pos] = findCalleeDeclaration(checker, call.callee)
      if (module == path) {
        if (nodeIndex[writePosKey(pos)] is Some(to)) {
          Arrays.push(mutable edges[caller], to)
        }
      }
    }
  }

  // Name each cycle, sorted inside and by first name.
  let groups: Array<Array<string>> = []
  for (const cycle of Arrays.values(findCycles(edges))) {
    let names: Array<string> = []
    for (const node of Arrays.values(cycle)) {
      Arrays.push(mutable names, nodeNames[node])
    }
    Arrays.sort(mutable names)
    Arrays.push(mutable groups, names)
  }
  Arrays.sortBy(mutable groups, (left: Array<string>, right: Array<string>) => Ordered.compare(
    left[0],
    right[0],
  ))
  let parts: Array<string> = []
  for (const group of Arrays.values(groups)) {
    if (query.json) {
      Arrays.push(mutable parts, writeStringList(group))
    } else {
      Arrays.push(mutable parts, `${Str.join(group, ", ")}\n`)
    }
  }
  if (query.json) {
    return Ok(
      `{"query": "recursion", "module": ${quoteJson(path)}, "groups": [${Str.join(parts, ", ")}]}\n`,
    )
  }
  if (Arrays.length(parts) == 0) {
    return Ok("(none)\n")
  }
  return Ok(Str.join(parts, ""))
}
