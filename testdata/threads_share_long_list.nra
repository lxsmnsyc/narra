// A list of 1,000,000 cells crosses to a thread. Marking it shared queues the
// parts of each cell on a worklist, as a drop does, instead of recursing.
import * as Thread from "std/thread"
import * as Int from "std/int"

enum List {
  Cons(head: int, tail: List)
  Nil
}

function build(count: int): List {
  let list = List.Nil
  let index = count
  while (index > 0) {
    list = List.Cons(index, list)
    index--
  }
  return list
}

function total(list: List): int {
  let sum = 0
  let at = list
  let going = true
  while (going) {
    match (at) {
      List.Cons(head, tail) => {
        sum += head
        at = tail
      }
      List.Nil => {
        going = false
      }
    }
  }
  return sum
}

export function run(args: Array<string>): int {
  const list = build(1000000)
  const result = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => total(list))
    return Thread.join(worker)
  })
  print(`sum ${Int.toString(result)}`)
  return 0
}
