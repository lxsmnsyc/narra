// A user enum's constructors hide the prelude's: `Less` here is Rank.Less,
// never Ordering.Less, even with no expected type.
enum Rank derives Show {
  Less
  Equal
  Greater
  Top(score: int)
}

function label(r: Rank): string {
  return match (r) {
    Rank.Less => "rank less"
    Rank.Equal => "rank equal"
    Rank.Greater => "rank greater"
    Rank.Top(s) => "rank top"
  }
}

export function run(args: Array<string>): int {
  const a = Rank.Less
  const b = Rank.Greater
  print(label(a))
  print(label(b))
  print(Show.show(Rank.Equal))
  print(Show.show(Rank.Top(3)))
  if (a == Rank.Less && a != Rank.Greater) {
    print("rank compare")
  }
  // Ordering's constructors are still reachable through the expected type
  // or the enum name.
  const o: Ordering = Ordering.Less
  print(Show.show(o))
  print(Show.show(Ordering.Greater))
  print(Show.show(Ordered.compare(1, 2)))
  return 0
}
