import * as Arrays from "std/array"

export function addAll(mutable items: Array<int>, extra: Array<int>) uses alloc {
  for (const number of extra) {
    Arrays.push(mutable items, number)
  }
}

export function firstOr(items: Array<int>, fallback: int): int {
  if (Arrays.length(items) == 0) {
    return fallback
  }
  return items[0]
}
