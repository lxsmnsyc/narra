import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

struct Entry derives Equatable {
  group: int
  name: string
}

struct Version derives Ordered, Equatable {
  major: int
  minor: int
}

function join(items: Array<int>): string uses alloc {
  let parts: Array<string> = []
  for (const item of items) {
    Arrays.push(mutable parts, Int.toString(item))
  }
  return Str.join(parts, ",")
}

function joinEntries(items: Array<Entry>): string uses alloc {
  let parts: Array<string> = []
  for (const item of items) {
    Arrays.push(mutable parts, `${Int.toString(item.group)}${item.name}`)
  }
  return Str.join(parts, " ")
}

export function run(args: Array<string>): int uses io, alloc {
  let numbers = [5, 3, 9, 1, 3, 7, 2, 8, 6, 4, 0]
  Arrays.sort(mutable numbers)
  print(`sort ${join(numbers)}`)

  let empty: Array<int> = []
  Arrays.sort(mutable empty)
  print(`sort empty ${Int.toString(Arrays.length(empty))}`)
  let single = [4]
  Arrays.sort(mutable single)
  print(`sort single ${join(single)}`)

  let words = ["pear", "apple", "fig", "banana", "cherry"]
  Arrays.sort(mutable words)
  print(`sort words ${Str.join(words, " ")}`)

  let versions = [
    Version { major: 1, minor: 5 },
    Version { major: 0, minor: 9 },
    Version { major: 1, minor: 2 },
  ]
  Arrays.sort(mutable versions)
  print(
    `sort structs ${Int.toString(versions[0].major)}.${Int.toString(versions[0].minor)} ${Int.toString(versions[2].major)}.${Int.toString(versions[2].minor)}`,
  )

  let entries = [
    Entry { group: 2, name: "a" },
    Entry { group: 1, name: "b" },
    Entry { group: 2, name: "c" },
    Entry { group: 1, name: "d" },
    Entry { group: 2, name: "e" },
    Entry { group: 1, name: "f" },
    Entry { group: 3, name: "g" },
  ]
  Arrays.sortBy(mutable entries, (first, second) => Int.compare(first.group, second.group))
  print(`sortBy stable ${joinEntries(entries)}`)
  Arrays.sortBy(mutable entries, (first, second) => Int.compare(second.group, first.group))
  print(`sortBy descending ${joinEntries(entries)}`)

  const original = [3, 1, 2]
  let sorted = copy(original)
  Arrays.sort(mutable sorted)
  print(`sort leaves the other copy ${join(original)} ${join(sorted)}`)

  let stack = [1, 2, 3]
  const alias = copy(stack)
  const popped = Arrays.pop(mutable stack)
  print(`pop ${Show.show(popped)} ${join(stack)} ${join(alias)}`)
  Arrays.pop(mutable stack)
  Arrays.pop(mutable stack)
  const missing = Arrays.pop(mutable stack)
  print(`pop empty ${Show.show(missing)} ${Int.toString(Arrays.length(stack))}`)

  let names = ["ann", "bob", "cy"]
  const last = Arrays.pop(mutable names)
  print(`pop string ${Show.show(last)} ${Str.join(names, " ")}`)

  let long = [1, 2, 3, 4, 5]
  const before = copy(long)
  Arrays.truncate(mutable long, 3)
  print(`truncate ${join(long)} ${join(before)}`)
  Arrays.truncate(mutable long, 10)
  print(`truncate past end ${join(long)}`)
  Arrays.truncate(mutable long, -1)
  print(`truncate negative ${Int.toString(Arrays.length(long))}`)
  Arrays.push(mutable long, 9)
  print(`push after truncate ${join(long)}`)

  const items = [10, 20, 30, 20]
  print(`indexOf ${Show.show(Arrays.indexOf(items, 20))} ${Show.show(Arrays.indexOf(items, 99))}`)
  print(
    `contains ${Show.show(Arrays.contains(items, 30))} ${Show.show(Arrays.contains(items, 31))}`,
  )
  print(`contains empty ${Show.show(Arrays.contains(empty, 1))}`)

  let odd = [1, 2, 3, 4, 5]
  Arrays.reverse(mutable odd)
  print(`reverse ${join(odd)}`)
  let even = [1, 2, 3, 4]
  Arrays.reverse(mutable even)
  print(`reverse even ${join(even)}`)
  let none: Array<int> = []
  Arrays.reverse(mutable none)
  print(`reverse empty ${Int.toString(Arrays.length(none))}`)
  return 0
}
