// error: this Async handle is not used; await it, keep it, pass it on, or let the task run with Async.detach(handle)
struct Job {
  handle: Async<int>
}

async function one(): int {
  return 1
}

async function outer(): Async<int> {
  return one()
}

export async function run(_args: Array<string>): int {
  await outer()
  #[one(), 1]
  const _ = #[one(), 1]
  const _ = [one()]
  let _ = Some(one())
  const _job = Job { handle: one() }
  const #[_, count] = #[one(), 2]
  const #[_first, total] = #[one(), 3]
  return count + total
}
