// A cancel of an Async.all handle does not reach the handles it was given:
// they keep running, and their then callbacks run when they finish. The all
// task itself still awaits them, so its await gives every value.
import * as Int from "std/int"
import * as Async from "std/async"
import * as AsyncTime from "std/async/time"
import * as Arrays from "std/array"
import * as Time from "std/time"

async function sleeper(label: string, value: int): int uses io, alloc {
  const slept = await AsyncTime.sleep(Time.milliseconds(1))
  if (slept is Err(_)) {
    print(`${label} cancelled`)
    return 0
  }
  print(`${label} slept`)
  return value
}

export async function run(_args: Array<string>): int {
  const first = sleeper("first", 1)
  const second = sleeper("second", 2)
  Async.then(first, (value) => print(`then first ${Int.toString(value)}`))
  const both = Async.all([first, second])
  Async.cancel(both)
  print(`first gives ${Int.toString(await first)}`)
  print(`second gives ${Int.toString(await second)}`)
  const values = await both
  print(`all gives ${Int.toString(Arrays.length(values))} values`)
  await Async.idle()
  return 0
}
