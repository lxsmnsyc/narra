// Helpers shared by the emitters of the std modules (stdstring, stdfs, stdio, ...).
// emitstd.nra dispatches to the modules, so the helpers live here and not there.
import { Type } from "narrac/types"
import { Pos, Arg } from "narrac/ast"
import { cachedCType } from "narrac/cnames"
import {
  Emitter,
  Code,
  EmitWalker,
  writeLine,
  where,
  temp,
  ownedTemp,
  readNodeType,
  underlyingType,
} from "narrac/emitstate"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Decls from "narrac/emitdecls"

export const NODE = "selfhost-emit-std"

// FixedCall is a builtin whose C is one runtime call. withPos adds the panic
// position as the last argument. A result is owned (an owned temporary),
// temporary (a plain temporary) or neither (the call text itself).
export struct FixedCall {
  name: string
  call: string
  withPos: bool
  owned: bool
  temporary: bool
}

export function plain(text: string): Code {
  return Code { text: text, owned: false }
}

export function owned(text: string): Code {
  return Code { text: text, owned: true }
}

export function emitFixedCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  fixed: FixedCall,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  let texts: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(arguments))) {
    Arrays.push(mutable texts, argumentText(walker, mutable emitter, arguments, index))
  }
  if (fixed.withPos) {
    Arrays.push(mutable texts, where(emitter, pos))
  }
  const callText = `${fixed.call}(${Str.join(texts, ", ")})`
  const resultType = readNodeType(emitter, nodeId)
  if (fixed.owned) {
    return owned(ownedTemp(mutable emitter, resultType, callText))
  }
  if (fixed.temporary) {
    return plain(temp(mutable emitter, resultType, callText))
  }
  return plain(callText)
}

export function argumentText<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  arguments: Array<Arg>,
  number: int,
): string uses alloc {
  const code = EmitWalker.emitExpression(walker, mutable emitter, arguments[number].value)
  return code.text
}

export function stringOut(mutable emitter: Emitter): string uses alloc {
  return temp(mutable emitter, Type.TStr, "NULL")
}

export function arrayStruct(emitter: Emitter, type: Type): string uses alloc {
  const name = cachedCType(emitter.checker, emitter.typeNames, type)
  return Str.slice(name, 0, Str.length(name) - 1)
}

export function findVariant(emitter: Emitter, enumType: Type, name: string): int {
  const baseType = underlyingType(emitter, enumType)
  if (baseType is Type.TEnum(enumIndex)) {
    for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
      if (variant.name == name) {
        return variant.index
      }
    }
  }
  return 0 - 1
}

export function variantFieldType(emitter: Emitter, enumType: Type, variant: int): Type {
  const baseType = underlyingType(emitter, enumType)
  if (baseType is Type.TEnum(enumIndex)) {
    return emitter.checker.enums[enumIndex].variants[variant].fields[0].fieldType
  }
  return Type.TVoid
}

export function ioEither(
  mutable emitter: Emitter,
  enumType: Type,
  condition: string,
  first: int,
  firstValues: Array<string>,
  second: int,
  secondValues: Array<string>,
): Code uses alloc {
  const enumName = cachedCType(emitter.checker, emitter.typeNames, enumType)
  const result = ownedTemp(mutable emitter, enumType, `((${enumName}){0})`)
  writeLine(mutable emitter, `if (${condition}) {`)
  emitter.indent++
  // Each payload is allocated only in the branch taken.
  const firstCode = Decls.enumAllocation(mutable emitter, enumType, first, firstValues)
  writeLine(mutable emitter, `${result} = ${firstCode.text};`)
  emitter.indent--
  writeLine(mutable emitter, "} else {")
  emitter.indent++
  const secondCode = Decls.enumAllocation(mutable emitter, enumType, second, secondValues)
  writeLine(mutable emitter, `${result} = ${secondCode.text};`)
  emitter.indent--
  writeLine(mutable emitter, "}")
  return owned(result)
}

export function ioResult(
  mutable emitter: Emitter,
  resultType: Type,
  success: string,
  okValue: string,
  errorValue: string,
): Code uses alloc {
  const okVariant = findVariant(emitter, resultType, "Ok")
  const errorVariant = findVariant(emitter, resultType, "Err")
  return ioEither(
    mutable emitter,
    resultType,
    success,
    okVariant,
    [okValue],
    errorVariant,
    [errorValue],
  )
}
