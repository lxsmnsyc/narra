const short = match (x) {
  A => 1
  B => 2
}
const empty = match (x) {}
const long = match (value) {
  Shape.Circle(radius) =>
    radius * radius * 3
  Shape.Square(side) if (side > 0) =>
    side * side
  _ => 0
}
const blockArm = match (value) {
  Some(inner) => {
    return inner
  }
  None => 0
}
const blank = match (value) {
  A => 1

  B => 2
}
const bodies = match (value) {
  A => Point { x: 1, y: 2 }
  B => [1, 2, 3]
  C => someFunction(
    firstArgument,
    secondArgument,
    thirdArgument,
    fourthArgument,
  )
  D =>
    firstOperandName +
    secondOperandName +
    thirdOperandName +
    fourthOperandName
}
const nestedMatch = match (a) {
  A => match (b) { X => 1, Y => 2 }
  B => 2
}
