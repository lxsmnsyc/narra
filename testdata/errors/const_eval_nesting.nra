// error: E1056, calls with deeply nested blocks reach the nesting limit before the call limit
@const
function depth(count: int): int {
  if (count > 0) {
    if (count > 0) {
      if (count > 0) {
        if (count > 0) {
          if (count > 0) {
            if (count > 0) {
              if (count > 0) {
                if (count > 0) {
                  if (count > 0) {
                    if (count > 0) {
                      return 1 + (1 + (1 + (1 + depth(count - 1))))
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  return 0
}

const DEEP = depth(990)

export function run(args: Array<string>): int {
  return DEEP - 990
}
