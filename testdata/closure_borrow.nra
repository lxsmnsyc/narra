// Non-escaping closures capture `let` variables and mutable parameters by
// reference.
import * as Int from "std/int"
import * as Arrays from "std/array"

function each(items: Array<int>, f: (item: int) => void) {
  for (const item of Arrays.values(items)) {
    f(item)
  }
}

function twice(f: () => void) {
  f()
  f()
}

function both(f: () => int, g: () => int): int {
  return f() + g()
}

struct Total {
  sum: int
}

function sumInto(items: Array<int>, mutable total: Total) {
  each(items, (item) => {
    total.sum = total.sum + item
  })
}

function nested(items: Array<int>): int {
  let count = 0
  each(items, (item) => {
    twice(() => {
      count = count + item
    })
  })
  return count
}

export function run(args: Array<string>): int {
  const numbers = [1, 2, 3, 4]

  // A counter written by a closure; the caller reads it after the call.
  let total = 0
  each(numbers, (item) => {
    total = total + item
  })
  print(Int.toString(total))

  // A string and an array are reassigned and pushed; old values are released.
  let text = "a"
  let seen: Array<int> = []
  each(numbers, (item) => {
    text = `${text}${Int.toString(item)}`
    Arrays.push(mutable seen, item * 10)
  })
  twice(() => {
    seen = [Arrays.length(seen)]
  })
  print(text)
  print(Int.toString(seen[0]))

  // A mutable parameter written by a closure.
  const grand = Total { sum: 100 }
  sumInto(numbers, mutable grand)
  print(Int.toString(grand.sum))

  // Two nested stack closures write the same outer variable.
  print(Int.toString(nested(numbers)))

  // Two closures of one call that only read the same variable.
  let base = 7
  print(Int.toString(both(() => base, () => base * 2)))

  // A closure that reads a variable sees later writes.
  let live = 1
  twice(() => {
    live = live * 3
  })
  print(Int.toString(both(() => live, () => live)))
  return 0
}
