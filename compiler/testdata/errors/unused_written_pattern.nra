// error: unused_written_pattern.nra:9:9: "host" is never read; remove it, or name it "_host" to mark it as unused on purpose
struct Config {
  host: string
  port: int
}

export function run(args: Array<string>): int {
  const config = Config { host: "a", port: 1 }
  let { host, port } = config
  host = "x"
  return port
}
