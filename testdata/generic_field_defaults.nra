import * as Arrays from "std/array"

struct Point {
  x: int
  y: int
}

struct Bag<T> {
  items: Array<T> = []
  value: Option<T> = None
  slots: Array<Option<T>> = [None, None]
  count: int = 0
}

struct Counted<T: Show> {
  label: Option<T> = None
  seen: Array<T> = []
}

function countSlots<T>(): int uses alloc {
  const bag: Bag<T> = { count: 7 }
  return Arrays.length(bag.items) + Arrays.length(bag.slots) + bag.count
}

function describe<T>(bag: Bag<T>): string uses alloc {
  return `${Show.show(Arrays.length(bag.items))} ${Show.show(Arrays.length(bag.slots))} ${Show.show(bag.value is None)} ${Show.show(bag.count)}`
}

export function run(_args: Array<string>): int uses io, alloc {
  const ints: Bag<int> = { count: 1 }
  print(describe(ints))
  const words: Bag<string> = {}
  print(describe(words))
  const points: Bag<Point> = { count: 3 }
  print(describe(points))
  const nested: Bag<Bag<int>> = {}
  print(describe(nested))
  print(Show.show(countSlots<string>()))
  print(Show.show(countSlots<Point>()))
  const spread: Bag<string> = { ...words, count: 2 }
  print(describe(spread))
  const counted: Counted<int> = {}
  print(Show.show(counted.label is None))
  print(Show.show(Arrays.length(counted.seen)))
  const named: Counted<string> = { seen: ["a"] }
  print(Show.show(named.seen))
  return 0
}
