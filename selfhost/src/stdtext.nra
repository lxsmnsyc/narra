const next = parseConcat(mutable parser)\n    Arrays.push(mutable children, next)\n  }\n  return addNode(mutable parser, Kind.Alternate, 0, 0, children, [])\n}\n\nfunction parseConcat(mutable parser: Parser): int uses alloc {\n  let children: Array<int> = []\n  while (!parser.failed && parser.position < parser.length) {\n    const byte = peekByte(parser, parser.position)\n    // `|` and `)` end the sequence.\n    if (byte == 124 || byte == 41) {\n      break\n    }\n    const groupStart = parser.groupCount\n    const atom = parseAtom(mutable parser)\n    // A flag group such as `(?i)` builds no node.\n    if (atom >= 0) {\n      const repeated = parseRepeat(mutable parser, atom, groupStart)\n      Arrays.push(mutable children, repeated)\n    }\n  }\n  if (Arrays.length(children) == 1) {\n    return children[0]\n  }\n  if (Arrays.length(children) == 0) {\n    return addEmpty(mutable parser)\n  }\n  return addNode(mutable parser, Kind.Concat, 0, 0, children, [])\n}\n\n// Reads `{n}`, `{n,}` or `{n,m}` at position. Returns the end of the\n// quantifier and its counts (-1 for no upper count), or end -1 when the text\n// is not a quantifier, which makes `{` a literal as in JavaScript.\nstruct Counts {\n  end: int\n  low: int\n  high: int\n}\n\nfunction readCounts(parser: Parser, position: int): Counts {\n  const none = Counts { end: -1, low: 0, high: 0 }\n  let index = position + 1\n  const low = readNumber(parser, index)\n  if (low.end == index) {\n    return none\n  }\n  index = low.end\n  if (peekByte(parser, index) == 125) {\n    return Counts { end: index + 1, low: low.low, high: low.low }\n  }\n  if (peekByte(parser, index) != 44) {\n    return none\n  }\n  index += 1\n  if (peekByte(parser, index) == 125) {\n    return Counts { end: index + 1, low: low.low, high: -1 }\n  }\n  const high = readNumber(parser, index)\n  if (high.end == index || peekByte(parser, high.end) != 125) {\n    return none\n  }\n  return Counts { end: high.end + 1, low: low.low, high: high.lo