import * as Int from "std/int"

function afterStatement(): int {
  const panic = (text: string) => {
    print(text)
  }
  panic("statement")
  return 1
}

function inBranches(flag: bool): int {
  const panic = (text: string) => {
    print(text)
  }
  let total = 0
  if (flag) {
    panic("then")
    total += 1
  } else {
    panic("else")
    total += 2
  }
  return total
}

function inLoop(): int {
  const panic = (text: string) => {
    print(text)
  }
  let total = 0
  for (const number of [1, 2]) {
    panic("loop")
    total += number
  }
  return total
}

function inParameter(panic: (string) => void): int {
  let seen = 0
  while (seen < 2) {
    panic("parameter")
    seen += 1
  }
  return seen
}

function quiet(text: string) {
  print(text)
}

export function run(args: Array<string>): int {
  print(Int.toString(afterStatement()))
  print(Int.toString(inBranches(true)))
  print(Int.toString(inBranches(false)))
  print(Int.toString(inLoop()))
  print(Int.toString(inParameter(quiet)))
  return 0
}
