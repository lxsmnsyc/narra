// The registry rows of std/unicode.
import { StdFunc } from "narrac/builtins"

export const UNICODE_FUNCS: Array<StdFunc> = [
  // std/unicode is Narra source (std/src/unicode.nra): a module row with no function.
  StdFunc { name: "std/unicode", module: "std/unicode", key: "", check: "source" },
  // Its tables, generated by scripts/unicode/generate.nra (std/src/internal__unicode.nra).
  StdFunc {
    name: "std/internal/unicode",
    module: "std/internal/unicode",
    key: "",
    check: "source",
  },
]
