// The registry rows, checks and emitters of std/thread and its primitives,
// std/internal/thread (D111 item 4). std/thread is Narra source
// (std/src/thread.nra); the runtime is selfhost/runtime/std_thread.c.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Checker, Walker, getExpressionId } from "narrac/check"
import { Pos, Arg } from "narrac/ast"
import {
  Emitter,
  Code,
  EmitWalker,
  noteHelper,
  readNodeType,
  temp,
  writeLine,
  consume,
  reportUnsupported,
} from "narrac/emitstate"
import { checkArgumentCount, checkArgumentAgainst } from "narrac/stdcheckhelp"
import { NODE, plain, argumentText } from "narrac/stdemithelp"

export const THREAD_FUNCS: Array<StdFunc> = [
  // std/thread is Narra source: a module row with no function.
  StdFunc { name: "std/thread", module: "std/thread", key: "", check: "source" },
]

export const INTERNAL_THREAD_FUNCS: Array<StdFunc> = [
  // Marks the captures of the function shared and runs it on a new thread;
  // the number is the thread for Threads.join.
  StdFunc {
    name: "Threads.start",
    module: "std/internal/thread",
    key: "start",
    effects: ["alloc"],
    check: "checkThreads",
  },
  // Waits until the thread has ended. Each thread is joined once.
  StdFunc {
    name: "Threads.join",
    module: "std/internal/thread",
    key: "join",
    parameters: ["int"],
    result: "void",
  },
]

export function checkThreadsCall<W: Walker>(
  mutable checker: Checker,
  walker: W,
  pos: Pos,
  arguments: Array<Arg>,
  name: string,
): Type from checker uses alloc {
  // Threads.start takes a function of no parameters; only std/thread calls it.
  if (!checkArgumentCount(mutable checker, walker, pos, arguments, name, 1)) {
    return Type.TInt
  }
  checkArgumentAgainst(
    mutable checker,
    walker,
    arguments[0].value,
    Type.TFunc([], Type.TVoid, [], -1, -1),
  )
  return Type.TInt
}

export function emitThreadsCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  arguments: Array<Arg>,
): Code uses alloc {
  noteHelper(emitter, "std/internal/thread")
  if (name == "Threads.start") {
    const workType = copy(readNodeType(emitter, getExpressionId(arguments[0].value)))
    const workCode = EmitWalker.emitExpression(walker, mutable emitter, arguments[0].value)
    // The new thread takes the closure's reference to its environment.
    const work = consume(mutable emitter, workCode.text, workCode.owned, workType)
    const started = `narra_thread_start((void (*)(struct narra_env*))(${work}).fn, (${work}).env, narra_env_share, narra_env_release)`
    return plain(temp(mutable emitter, Type.TInt, started))
  }
  if (name == "Threads.join") {
    const thread = argumentText(walker, mutable emitter, arguments, 0)
    writeLine(mutable emitter, `narra_thread_join(${thread});`)
    return plain("((void)0)")
  }
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
