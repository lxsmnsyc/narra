// A tail self-call that leaves out a default is still a jump: without it the
// 50,000,000 calls below would overflow the stack.
function down(count: int, step: int = 1, total: int = 0): int {
  if (count <= 0) {
    return total
  }
  if (count % 2 == 0) {
    return down(count - step, total: total + 1)
  }
  return down(count - step, step, total + 1)
}

function label(count: int, text: string = "done"): string {
  if (count == 0) {
    return text
  }
  return label(count - 1)
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Show.show(down(50000000)))
  print(label(50000000, "skipped"))
  return 0
}
