# The C files of c_mini come from the upstream repository at its tag. The build compiles the sources
# the manifest lists (not example.c), gives the include folder of c_mini to the C file of app, and
# keeps the defines of c_mini to c_mini: mini_secret sees MINI_SECRET, the glue file of app does not.
0 :: run -sanitize app :: add 5 && scale 3 && twice 14 && own secret 1 && glue 8 && app secret 0 && version 1.0.0 && compiled c_mini/src/mini.c && compiled c_mini/src/extra.c && compiled app/glue/glue.c && !example.c
# The lock records the upstream commit and tree beside the package.
has :: app/narra.lock :: name = "c_mini" && c_tag = "v1.0.0" && c_git = "file://
locked :: app/narra.lock :: upstream_mini v1.0.0
# A second build compiles nothing and fetches nothing: the repositories are gone.
delete :: ../../repos
0 :: run -sanitize app :: add 5 && !compiled
# The language service loads the package from the lock and the cache.
0 :: pkg --locked app :: c_mini
