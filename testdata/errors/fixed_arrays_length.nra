// error: the length of a FixedArray cannot be negative
const SIZE = 3

struct Holder<const N: int> {
  values: FixedArray<int, N>
}

function build<const N: int>(): FixedArray<int, N> {
  return [1, 2]
}

export function run(_args: Array<string>): int {
  const negative: FixedArray<int, -1> = []
  const missing: FixedArray<int> = [1]
  const named: FixedArray<int, SIZE> = [1, 2, 3]
  const short: FixedArray<int, 3> = [1, 2]
  const long: FixedArray<int, 2> = [1, 2, 3]
  const wrong: FixedArray<int, 2> = [1, "two"]
  const holder = Holder<2> { values: [4, 5] }
  const built: FixedArray<int, 2> = build()
  return 0
}
