// error: uses_list_argument_hint.nra:13:15: the argument for `f` of `apply` uses `alloc`, `io`, but its function type does not declare it; write `uses (alloc, io)` in the type, or `uses E` with `<effect E>` on `apply`
import * as Int from "std/int"

export function apply(f: (x: int) => string, x: int): string {
  return f(x)
}

export function run(args: Array<string>): int {
  const noisy = (x: int): string => {
    print("hi")
    return Int.toString(x)
  }
  print(apply(noisy, 1))
  return 0
}
