// Long float literals in @const evaluation read as the correctly rounded double.
import * as Float from "std/float"

@const
function twice(value: f64): f64 {
  return value * 2.0
}

@const
function tiny(): f64 {
  return 5e-324
}

@const
function huge(): f64 {
  return 1.5e300
}

@const
function long(): f64 {
  return 3.14159265358979323846264338327950288
}

const HALF_BELOW = twice(0.49999999999999994)
const LARGE = twice(1e300)
const SMALLEST = twice(5e-324)
const TINY = tiny()
const HUGE = huge()
const LONG = long()

function report(name: string, folded: f64, computed: f64): string uses alloc {
  const same = folded == computed ? "same" : "different"
  return `${name} ${Float.toString(folded)} ${same}`
}

export function run(args: Array<string>): int uses io, alloc {
  print(report("half-below", HALF_BELOW, twice(0.49999999999999994)))
  print(report("large", LARGE, twice(1e300)))
  print(report("smallest", SMALLEST, twice(5e-324)))
  print(report("tiny", TINY, 5e-324))
  print(report("huge", HUGE, 1.5e300))
  print(report("long", LONG, 3.14159265358979323846264338327950288))
  return 0
}
