import * as Ranges from "std/range"

struct Counter {
  hits: int
  label: string
  scores: Array<int>
}

function next(mutable calls: Counter): int uses alloc {
  calls.hits += 1
  return 1
}

function bump(mutable counter: Counter, amount: int) {
  counter.hits += amount
  counter.scores[0] *= 2
}

export function run(args: Array<string>): int uses io, alloc {
  // Every operator on int.
  let value = 10
  value += 5
  print(`+= ${Show.show(value)}`)
  value -= 3
  print(`-= ${Show.show(value)}`)
  value *= 4
  print(`*= ${Show.show(value)}`)
  value /= 5
  print(`/= ${Show.show(value)}`)
  value %= 7
  print(`%= ${Show.show(value)}`)
  value |= 8
  print(`|= ${Show.show(value)}`)
  value &= 12
  print(`&= ${Show.show(value)}`)
  value ^= 5
  print(`^= ${Show.show(value)}`)
  value <<= 3
  print(`<<= ${Show.show(value)}`)
  value >>= 2
  print(`>>= ${Show.show(value)}`)
  value += 1
  print(`wrapped += ${Show.show(value)}`)

  // A sized type.
  let small: u8 = 250
  small += 5
  print(`u8 ${Show.show(small)}`)
  small -= 55
  small /= 2
  small <<= 1
  print(`u8 ${Show.show(small)}`)
  let wide: i32 = 100
  wide *= 3
  wide %= 7
  wide ^= 1
  print(`i32 ${Show.show(wide)}`)
  let ratio = 1.5
  ratio *= 4.0
  ratio -= 0.5
  ratio /= 2.0
  print(`f64 ${Show.show(ratio)}`)

  // Strings join in a loop and release the old value.
  let text = ""
  for (const index of Ranges.upTo(5)) {
    text += `${Show.show(index)},`
  }
  text += "end"
  print(text)

  // Fields and elements.
  const counter = Counter { hits: 1, label: "a", scores: [1, 2, 3] }
  counter.hits += 10
  counter.label += "bc"
  counter.scores[1] += 40
  counter.scores[2] -= 1
  bump(mutable counter, 5)
  print(`${Show.show(counter.hits)} ${counter.label} ${Show.show(counter.scores)}`)

  // The target place is evaluated once.
  const calls = Counter { hits: 0, label: "", scores: [] }
  const items = [0, 0, 0]
  items[next(mutable calls)] += 7
  items[next(mutable calls)]++
  items[next(mutable calls) - 1]--
  print(`${Show.show(items)} calls=${Show.show(calls.hits)}`)

  // Increment and decrement.
  let step = 0
  step++
  step++
  step--
  print(`step ${Show.show(step)}`)
  let tiny: i8 = 126
  tiny++
  print(`i8 ${Show.show(tiny)}`)
  tiny--
  tiny--
  print(`i8 ${Show.show(tiny)}`)
  counter.hits++
  print(`hits ${Show.show(counter.hits)}`)

  // A Map index target.
  const counts = Map<string, int> { "a": 1 }
  counts["a"] += 2
  counts["a"]++
  print(`a ${Show.show(counts["a"])}`)
  const names = Map<int, string> { 1: "x" }
  names[1] += "yz"
  print(`names ${Show.show(names[1])}`)
  return 0
}
