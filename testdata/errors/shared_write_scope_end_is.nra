// error: Arrays.push(mutable list, ...) may change list, which found still holds until its block ends at line 16
// A binding of an `is` on a fresh value holds that value until the block
// ends, so the push would copy the array.
import * as Arrays from "std/array"
import * as Int from "std/int"

function makeList(): Option<Array<int>> uses alloc {
  return Some([1, 2])
}

export function run(_args: Array<string>): int uses io, alloc {
  if (makeList() is Some(found)) {
    let list = found
    Arrays.push(mutable list, 3)
    print(Int.toString(Arrays.length(list)))
  }
  return 0
}
