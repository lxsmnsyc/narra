// error: Source.next is unsafe; call it inside an `unsafe { }` block
import * as Ptr from "std/ptr"

// The trait function declares the effect, so a call through a bound has it.
trait Source {
  function next(self: Self): int uses unsafe
}

struct Counter implements Source {
  data: Ptr<int>
}

implement Source for Counter {
  function next(self: Counter): int uses unsafe {
    let value = 0
    unsafe {
      value = Ptr.read(self.data)
    }
    return value
  }
}

function takeOne<T: Source>(source: T): int {
  return Source.next(source)
}

export function run(_args: Array<string>): int uses unsafe {
  let total = 0
  unsafe {
    total = takeOne(Counter { data: Ptr.null() })
  }
  return total
}
