// The body driver of the checker, ported from compiler/internal/narra:
// checkBodies and funcBody (check.go, check_stmt.go), checkDefaults
// (check_types.go), funcParam (check_closure.go) and the module loop of
// checkPackageBodies (modules_check.go).
//
// checkPackage interleaves as Go does: each module is declared, then its
// field defaults (the last step of Go's declareModule), then its bodies.
// After all modules come the pending generic function instances (queued by
// calls.nra, checked by checkPending), the Map keys, the entry functions and
// finish. Every checked body gets its own side tables (BodyInfo).
//
// BodyWalker is the Walker (check.nra) that the modules below narrac/exprs
// use to reach the expression and block checkers.
import {
  Pos,
  File,
  Decl,
  FuncDecl,
  ConstDecl,
  TestDecl,
  ImplDecl,
  Expr,
  Block,
  Param,
  Arg,
  FieldInit,
} from "narrac/ast"
import { quoteDump } from "narrac/modules"
import { Package } from "narrac/modules"
import { BuildTarget, createUnknownTarget } from "narrac/buildtarget"
import { applyBuildTarget, reportUnsupportedHost } from "narrac/buildconditions"
import { Type, Field } from "narrac/types"
import {
  Checker,
  BodyRoot,
  Ref,
  Walker,
  reportError,
  enter,
  startBody,
  finishBody,
  keyBody,
  declareLocal,
  getExpressionPos,
  finish,
  setRef,
} from "narrac/check"
import { newPackageChecker, declareSourceModule } from "narrac/declare"
import { checkEntries, recordEntryTargets } from "narrac/scopes"
import { reportUnusedTopLevel } from "narrac/unused"
import { flushMapKeys, shapeDeriveHolds } from "narrac/traits"
import { derivedShapeType } from "narrac/deriveshape"
import { makeEnv } from "narrac/generics"
import { resolveOpt } from "narrac/resolve"
import { dumpTypeString } from "narrac/declsdump"
import * as Exprs from "narrac/exprs"
import * as Stmts from "narrac/stmts"
import { checkEveryPathReturns } from "narrac/pathends"
import { checkSharedResults, checkSharedResultsIn } from "narrac/sharedresults"
import * as Match from "narrac/match"
import * as Literals from "narrac/literals"
import * as Calls from "narrac/calls"
import * as Ctors from "narrac/ctors"
import * as Closures from "narrac/closures"
import * as StdCalls from "narrac/stdcalls"
import { isNonEscaping } from "narrac/funcvalues"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

struct BodyWalker implements Walker {}

implement Walker for BodyWalker {
  function checkExpression(
    walker: BodyWalker,
    mutable checker: Checker,
    expression: Expr,
    want: Option<Type>,
  ): Type from want uses alloc {
    return Exprs.checkExpression(mutable checker, walker, expression, want)
  }

  function checkBlock(walker: BodyWalker, mutable checker: Checker, block: Block) uses alloc {
    Stmts.checkBlock(mutable checker, walker, block)
  }

  function checkPatterns(
    walker: BodyWalker,
    mutable checker: Checker,
    expression: Expr,
    want: Option<Type>,
  ): Type from want uses alloc {
    return Match.checkPatternExpression(mutable checker, walker, expression, want)
  }

  function checkMapLiteral(
    walker: BodyWalker,
    mutable checker: Checker,
    expression: Expr,
    want: Option<Type>,
  ): Type from want uses alloc {
    return Literals.checkMapLiteral(mutable checker, walker, expression, want)
  }

  function checkTuple(
    walker: BodyWalker,
    mutable checker: Checker,
    pos: Pos,
    elements: Array<Expr>,
    want: Option<Type>,
  ): Type from checker uses alloc {
    return Literals.checkTuple(mutable checker, walker, pos, elements, want)
  }

  function checkSpread(
    walker: BodyWalker,
    mutable checker: Checker,
    pos: Pos,
    typeName: string,
    fields: Array<FieldInit>,
    spread: Expr,
    want: Option<Type>,
  ): Type from want uses alloc {
    return Literals.checkSpread(mutable checker, walker, pos, typeName, fields, spread, want)
  }

  function checkMapIndex(
    walker: BodyWalker,
    mutable checker: Checker,
    nodeId: int,
    index: Expr,
    mapKey: Type,
    mapValue: Type,
  ): Type from mapValue uses alloc {
    return Literals.checkMapIndex(mutable checker, walker, nodeId, index, mapKey, mapValue)
  }

  function checkCall(
    walker: BodyWalker,
    mutable checker: Checker,
    nodeId: int,
    pos: Pos,
    callee: Expr,
    arguments: Array<Arg>,
    want: Option<Type>,
  ): Type from checker uses alloc {
    return Calls.checkCall(mutable checker, walker, nodeId, pos, callee, arguments, want)
  }

  function checkConstructorName(
    walker: BodyWalker,
    mutable checker: Checker,
    nodeId: int,
    pos: Pos,
    enumName: string,
    name: string,
    want: Option<Type>,
  ): Option<Type> from checker uses alloc {
    if (
      Ctors.checkConstructor(mutable checker, walker, pos, enumName, name, [], want) is Some(result)
    ) {
      if (result.enumIndex >= 0) {
        setRef(mutable checker, nodeId, Ref.Constructor(result.enumIndex, result.variant))
      }
      return Some(result.constructorType)
    }
    return None
  }

  function checkBlockExpression(
    walker: BodyWalker,
    mutable checker: Checker,
    expression: Expr,
    want: Option<Type>,
  ): Type from checker uses alloc {
    return Stmts.checkBlockExpression(mutable checker, walker, expression, want)
  }

  function checkBlockBody(
    walker: BodyWalker,
    mutable checker: Checker,
    pos: Pos,
    block: Block,
    want: Option<Type>,
  ): Type from checker uses alloc {
    return Stmts.checkBlockBody(mutable checker, walker, pos, block, want)
  }

  function checkArrow(
    walker: BodyWalker,
    mutable checker: Checker,
    expression: Expr,
    want: Option<Type>,
  ): Type from checker uses alloc {
    return Closures.checkArrow(mutable checker, walker, expression, want)
  }

  function checkStdCall(
    walker: BodyWalker,
    mutable checker: Checker,
    pos: Pos,
    arguments: Array<Arg>,
    name: string,
    kind: string,
    want: Option<Type>,
  ): Type from want uses alloc {
    return StdCalls.checkStdCall(mutable checker, walker, pos, arguments, name, kind, want)
  }
}

export function checkPackage(package: Package): Checker from package uses alloc {
  return checkModules(package, Map {}, createUnknownTarget(true)).checker
}

export function checkPackageFor(
  package: Package,
  target: BuildTarget,
): Checker from package uses alloc {
  return checkModules(package, Map {}, target).checker
}

// The result of checkModules. The errors before unusedStart come from the
// passes before the unused check. queuedErrors counts the errors of the
// generic struct defaults and the generic function instances, which the
// bodies of other modules queue.
export struct ModulesCheck {
  checker: Checker
  unusedStart: int
  queuedErrors: int
}

export function checkModules(
  package: Package,
  skipped: Map<string, bool>,
  target: BuildTarget,
): ModulesCheck from package uses alloc {
  let checker = newPackageChecker(package)
  checker.buildTarget = copy(target)
  reportUnsupportedHost(mutable checker, package)
  if (Arrays.length(checker.errors) > 0 && Arrays.length(checker.scopes) == 0) {
    const count = Arrays.length(checker.errors)
    return ModulesCheck { checker: checker, unusedStart: count, queuedErrors: 0 }
  }
  checker.checkingBodies = true
  recordEntryTargets(mutable checker, package)
  const walker = BodyWalker {}
  let queuedErrors = 0

  // Each module: declarations, field defaults, bodies.
  for (const sourceModule of Arrays.values(package.modules)) {
    const module = applyBuildTarget(sourceModule, target)
    declareSourceModule(mutable checker, module)
    const beforeDefaults = Arrays.length(checker.errors)
    checkQueuedDefaults(mutable checker, walker)
    queuedErrors = queuedErrors + Arrays.length(checker.errors) - beforeDefaults
    // narrac lsp reuses the results of the modules in skipped; with it empty this is checkPackage.
    if (skipped[module.path] is None) {
      checkDefaults(mutable checker, walker, module.ast)
      checkModuleBodies(mutable checker, walker, module.ast)
    }
  }

  // Then the checks that need every module.
  const beforePending = Arrays.length(checker.errors)
  checkPending(mutable checker, walker)
  queuedErrors = queuedErrors + Arrays.length(checker.errors) - beforePending
  flushMapKeys(mutable checker)
  checkEntries(mutable checker, package)
  const concrete = checker.concrete
  finish(mutable checker, concrete)
  const unusedStart = Arrays.length(checker.errors)
  // The unused check leaves out the skipped modules: with their bodies
  // unchecked, their private functions would look unused.
  let hidden: Array<int> = []
  for (const module of Arrays.values(package.modules)) {
    if (skipped[module.path] is Some(_)) {
      if (checker.scopeIndex[module.path] is Some(scope)) {
        if (checker.scopes[scope].isSource) {
          checker.scopes[scope].isSource = false
          Arrays.push(mutable hidden, scope)
        }
      }
    }
  }
  reportUnusedTopLevel(mutable checker)
  for (const scope of Arrays.values(hidden)) {
    checker.scopes[scope].isSource = true
  }
  return ModulesCheck { checker: checker, unusedStart: unusedStart, queuedErrors: queuedErrors }
}

function checkQueuedDefaults(mutable checker: Checker, walker: BodyWalker) uses alloc {
  const generics = checker.pendingDefaults
  checker.pendingDefaults = []
  for (const generic of Arrays.values(generics)) {
    checkGenericDefaults(mutable checker, walker, generic)
  }
}

function checkDefaults(mutable checker: Checker, walker: BodyWalker, file: File) uses alloc {
  const scope = checker.current
  for (const declaration of Arrays.values(file.declarations)) {
    if (declaration is Decl.Struct(structDecl)) {
      if (Arrays.length(structDecl.typeParameters) > 0) {
        continue
      }
      const structIndex = findStruct(checker, scope, structDecl.name, structDecl.pos)
      if (structIndex >= 0) {
        const owner = dumpTypeString(checker, Type.TStruct(structIndex))
        const fields = checker.structs[structIndex].fields
        const ownerKey = qualifiedName(
          checker.structs[structIndex].module,
          checker.structs[structIndex].name,
        )
        checkFieldDefaults(mutable checker, walker, owner, ownerKey, fields, Map {})
      }
    }
  }
}

function checkGenericDefaults(
  mutable checker: Checker,
  walker: BodyWalker,
  generic: int,
) uses alloc {
  const info = copy(checker.generics[generic])
  const saved = enter(mutable checker, info.scope)
  let owner = info.name
  if (info.module != "") {
    owner = `${info.module}.${info.name}`
  }
  const environment = makeEnv(checker, info.parameters)
  checkFieldDefaults(
    mutable checker,
    walker,
    owner,
    qualifiedName(info.module, info.name),
    info.fields,
    environment,
  )
  enter(mutable checker, saved)
}

function qualifiedName(module: string, name: string): string uses alloc {
  // The owner part of a "default|<owner>|<field>" body key.
  if (module == "") {
    return name
  }
  return `${module}.${name}`
}

function findStruct(checker: Checker, scope: int, name: string, pos: Pos): int {
  // The scope's type table has it, unless the name is declared twice.
  if (checker.scopes[scope].types[name] is Some(Type.TStruct(found))) {
    if (checker.structs[found].scope == scope && checker.structs[found].pos == pos) {
      return found
    }
  }
  let index = 0
  for (const info of Arrays.values(checker.structs)) {
    if (info.scope == scope && info.pos == pos && info.generic < 0 && !info.tuple) {
      return index
    }
    index++
  }
  return -1
}

function checkFieldDefaults(
  mutable checker: Checker,
  walker: BodyWalker,
  owner: string,
  ownerKey: string,
  fields: Array<Field>,
  environment: Map<string, Type>,
) uses alloc {
  for (const field of Arrays.values(fields)) {
    if (field.default is Some(value)) {
      // Each default is a body of its own, outside any function.
      const saved = startBody(
        mutable checker,
        "default",
        `${owner}.${field.name}`,
        [],
        BodyRoot.RootExpr(value),
        Type.TVoid,
        environment,
      )
      keyBody(mutable checker, `default|${ownerKey}|${field.name}`)
      const found = Exprs.checkExpression(mutable checker, walker, value, Some(field.fieldType))
      Exprs.expectType(mutable checker, getExpressionPos(value), Some(field.fieldType), found)
      if (!Exprs.isConstantValue(checker, value)) {
        reportError(
          mutable checker,
          getExpressionPos(value),
          "E0106",
          "a field default must be a constant",
        )
      }
      finishBody(mutable checker, saved)
    }
  }
}

function checkModuleBodies(mutable checker: Checker, walker: BodyWalker, file: File) uses alloc {
  // A `typeof` in a body reads the type of a constant, so the constants come first.
  if (file.facts.hasTypeof) {
    for (const declaration of Arrays.values(file.declarations)) {
      if (declaration is Decl.Const(constDecl)) {
        checkConstDecl(mutable checker, walker, constDecl)
      }
    }
  }
  for (const declaration of Arrays.values(file.declarations)) {
    match (declaration) {
      Decl.Func(funcDecl) => {
        // The functions written for a `derives Shape` in error are skipped,
        // so the error is reported once.
        const derivedType = derivedShapeType(funcDecl.name)
        if (derivedType == "" || shapeDeriveHolds(mutable checker, derivedType)) {
          checkFunction(mutable checker, walker, funcDecl)
        }
      }
      Decl.Const(constDecl) => checkConstDecl(mutable checker, walker, constDecl)
      Decl.Impl(implDecl) => checkImplBodies(mutable checker, walker, implDecl)
      Decl.Test(testDecl) => checkTest(mutable checker, walker, testDecl)
      _ => {}
    }
  }
}

function findFunction(checker: Checker, funcDecl: FuncDecl): int {
  const scope = checker.current
  if (checker.scopes[scope].functions[funcDecl.name] is Some(index)) {
    if (
      checker.functions[index].declaration.pos == funcDecl.pos &&
        checker.functions[index].scope == scope
    ) {
      return index
    }
  }
  // A function declared twice is no longer in the scope's map.
  let index = 0
  for (const info of Arrays.values(checker.functions)) {
    if (info.scope == scope && info.declaration.pos == funcDecl.pos) {
      return index
    }
    index++
  }
  return -1
}

function checkFunction(
  mutable checker: Checker,
  walker: BodyWalker,
  funcDecl: FuncDecl,
) uses alloc {
  // A generic function is checked once with its type parameters left open, so errors point at the declaration.
  const funcIndex = findFunction(checker, funcDecl)
  if (funcIndex < 0) {
    return
  }
  const typeParameters = checker.functions[funcIndex].typeParameters
  const environment = makeEnv(checker, typeParameters)
  const result = checker.functions[funcIndex].result
  let paramTypes: Array<Type> = []
  for (const param of Arrays.values(funcDecl.parameters)) {
    Arrays.push(mutable paramTypes, checker.paramTypes[param.id])
  }
  let key = ""
  if (Arrays.length(typeParameters) == 0) {
    key = `func|${Int.toString(funcIndex)}`
  }
  checkFunctionBody(
    mutable checker,
    walker,
    "func",
    funcDecl.name,
    [],
    funcDecl,
    paramTypes,
    result,
    environment,
    key,
    funcIndex,
  )
}

function checkFunctionBody(
  mutable checker: Checker,
  walker: BodyWalker,
  kind: string,
  name: string,
  typeArguments: Array<Type>,
  funcDecl: FuncDecl,
  paramTypes: Array<Type>,
  result: Type,
  environment: Map<string, Type>,
  key: string,
  funcIndex: int,
) uses alloc {
  const saved = startBody(
    mutable checker,
    kind,
    name,
    typeArguments,
    BodyRoot.RootFunc(funcDecl),
    result,
    environment,
  )
  checker.functionIndex = funcIndex
  checker.generator = funcDecl.generator
  if (key != "") {
    keyBody(mutable checker, key)
  }
  declareParams(mutable checker, funcDecl.parameters, paramTypes)
  if (funcDecl.body is Some(block)) {
    Stmts.checkBlock(mutable checker, walker, block)
    // An instance of a generic function repeats what its declaration was checked for.
    if (!funcDecl.generator && Arrays.length(typeArguments) == 0) {
      checkEveryPathReturns(mutable checker, block, result, false)
    }
    if (Arrays.length(typeArguments) == 0 && !skipsSharedResults(checker)) {
      checkSharedResults(mutable checker, funcDecl)
    }
  }
  finishBody(mutable checker, saved)
}

function checkPending(mutable checker: Checker, walker: BodyWalker) uses alloc {
  // Checking one instance can queue more.
  while (checker.pendingNext < Arrays.length(checker.pending)) {
    const instanceIndex = checker.pending[checker.pendingNext]
    const instance = copy(checker.instanceList[instanceIndex])
    checker.pendingNext++
    const saved = enter(mutable checker, instance.scope)
    const funcDecl = checker.functions[instance.funcIndex].declaration
    checkFunctionBody(
      mutable checker,
      walker,
      "func",
      funcDecl.name,
      instance.typeArguments,
      funcDecl,
      instance.parameters,
      instance.result,
      instance.environment,
      `inst|${Int.toString(instanceIndex)}`,
      instance.funcIndex,
    )
    enter(mutable checker, saved)
  }
}

function declareParams(
  mutable checker: Checker,
  parameters: Array<Param>,
  paramTypes: Array<Type>,
) uses alloc {
  for (const index of Ranges.between(0, Arrays.length(parameters))) {
    const param = parameters[index]
    const paramType = paramTypes[index]
    const local = declareLocal(
      mutable checker,
      param.id,
      param.pos,
      param.name,
      paramType,
      param.isMutable,
      true,
    )
    let isFuncType = false
    if (param.type is Some(typeExpression)) {
      isFuncType = typeExpression.isFunc
    }
    if (param.escaping && !isFuncType) {
      reportError(
        mutable checker,
        param.pos,
        "E0600",
        "only a parameter with a function type can be escaping",
      )
    }
    const body = checker.body
    checker.bodies[body].locals[local].noEscape = isNonEscaping(param)
  }
}

function checkConstDecl(
  mutable checker: Checker,
  walker: BodyWalker,
  constDecl: ConstDecl,
) uses alloc {
  // A duplicate declaration, which declare.nra rejected, is checked too.
  const scope = checker.current
  const index = Exprs.findConstInfo(mutable checker, scope, constDecl)
  Exprs.checkConstType(mutable checker, walker, index, constDecl.pos)
}

function checkImplBodies(
  mutable checker: Checker,
  walker: BodyWalker,
  implDecl: ImplDecl,
) uses alloc {
  // A block that failed its checks is not in Checker.implementations and is skipped.
  const scope = checker.current
  let block = -1
  for (const index of Ranges.between(0, Arrays.length(checker.implementations))) {
    if (
      checker.implementations[index].scope == scope &&
        checker.implementations[index].declaration.pos == implDecl.pos
    ) {
      block = index
    }
  }
  if (block < 0) {
    return
  }
  const impl = checker.implementations[block]
  const traitName = checker.traits[impl.traitIndex].name
  const typeText = dumpTypeString(checker, impl.forType)
  const environment: Map<string, Type> = Map { "Self": impl.forType }
  for (const funcDecl of Arrays.values(implDecl.functions)) {
    let paramTypes: Array<Type> = []
    for (const param of Arrays.values(funcDecl.parameters)) {
      Arrays.push(mutable paramTypes, checker.paramTypes[param.id])
    }
    const result = findImplResult(mutable checker, block, funcDecl, environment)
    let key = ""
    const implIndex = findImplIndex(checker, block, funcDecl)
    if (implIndex >= 0) {
      key = `impl|${Int.toString(block)}|${Int.toString(implIndex)}`
    }
    checkFunctionBody(
      mutable checker,
      walker,
      "impl",
      `${traitName} ${typeText}.${funcDecl.name}`,
      [],
      funcDecl,
      paramTypes,
      result,
      environment,
      key,
      -1,
    )
  }
}

function findImplIndex(checker: Checker, block: int, funcDecl: FuncDecl): int {
  let index = 0
  for (const implFunc of Arrays.values(checker.implementations[block].functions)) {
    if (implFunc.declaration.pos == funcDecl.pos) {
      return index
    }
    index++
  }
  return -1
}

function findImplResult(
  mutable checker: Checker,
  block: int,
  funcDecl: FuncDecl,
  environment: Map<string, Type>,
): Type from checker uses alloc {
  // The result type is the one resolveImpl recorded, or resolved again for a function it rejected.
  for (const implFunc of Arrays.values(checker.implementations[block].functions)) {
    if (implFunc.declaration.pos == funcDecl.pos) {
      return implFunc.result
    }
  }
  const savedEnv = checker.environment
  checker.environment = copy(environment)
  const result = resolveOpt(mutable checker, funcDecl.result)
  checker.environment = savedEnv
  return result
}

function checkTest(mutable checker: Checker, walker: BodyWalker, testDecl: TestDecl) uses alloc {
  const saved = startBody(
    mutable checker,
    "test",
    quoteDump(testDecl.name),
    [],
    BodyRoot.RootBlock(testDecl.body),
    Type.TVoid,
    Map {},
  )
  let testNumber = 0
  const module = checker.scopes[checker.current].path
  for (const other of Arrays.values(checker.bodies)) {
    if (other.kind == "test" && other.module == module) {
      testNumber++
    }
  }
  keyBody(mutable checker, `test|${module}|${Int.toString(testNumber - 1)}`)
  checker.inTest = true
  Stmts.checkBlock(mutable checker, walker, testDecl.body)
  checker.inTest = false
  if (!skipsSharedResults(checker)) {
    checkSharedResultsIn(mutable checker, testDecl.body)
  }
  finishBody(mutable checker, saved)
}

function skipsSharedResults(checker: Checker): bool {
  // Results are checked for sharing only in a body whose types are all known.
  return Arrays.length(checker.errors) > checker.bodies[checker.body].errorCount
}
