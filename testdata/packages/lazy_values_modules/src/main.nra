import * as Lazies from "std/lazy"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as T from "lzv/tables"

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(Arrays.length(Lazies.force(T.PRIMES))))
  print(Int.toString(Lazies.force(T.PRIMES)[3]))
  return 0
}
