// The debug copy check reports each copy on write that no copy(...) explains.
// The shared-write rule does not follow a value into a `mutable` argument of a
// user function, so these copies stay hidden from it: one array kept by a bag
// and then written, and one whose copy(...) ended before the write, so its
// credit no longer counts.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Bag {
  items: Array<int>
}

function keep(mutable bag: Bag, items: Array<int>) {
  bag.items = items
}

function total(values: Array<int>): int {
  let sum = 0
  for (const value of values) {
    sum += value
  }
  return sum
}

export function run(_args: Array<string>): int {
  const first = [1, 2, 3]
  let second = Bag { items: [] }
  keep(mutable second, first)
  second.items[0] = 10
  print(`${Int.toString(total(first))} ${Int.toString(total(second.items))}`)

  const third = [4, 5]
  print(Int.toString(total(copy(third))))
  let fourth = Bag { items: [] }
  keep(mutable fourth, third)
  Arrays.push(mutable fourth.items, 6)
  print(`${Int.toString(total(third))} ${Int.toString(total(fourth.items))}`)
  return 0
}
