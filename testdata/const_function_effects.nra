import * as Int from "std/int"

function describe(count: int): string uses alloc {
  return `n=${Int.toString(count)}`
}

function other(count: int): string uses alloc {
  return `m=${Int.toString(count)}`
}

struct Holder {
  show: (int) => string uses alloc
}

const shown = describe

function pickBoth(): Array<(int) => string uses alloc> uses alloc {
  const both = [describe, other]
  return both
}

export function run(args: Array<string>): int uses io, alloc {
  print(shown(3))
  let local = describe
  local = other
  print(local(1))
  const holder = Holder { show: describe }
  print(holder.show(2))
  for (const each of pickBoth()) {
    print(each(4))
  }
  return 0
}
