// error: moved.line = ... may change moved, which pos still uses at line 14
struct Pos {
  line: int
  column: int
}

export function run(_args: Array<string>): int {
  let positions = [Pos { line: 1, column: 2 }]
  let total = 0
  for (const pos of positions) {
    // A `for (const ...)` binding shares the element of positions.
    let moved = pos
    moved.line = 9
    total += pos.line + moved.line
  }
  return total
}
