import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

enum ParseError {
  Empty
  BadDigit(at: int)
}

function digit(c: char): Option<int> {
  if (c == '0') {
    return Some(0)
  }
  if (c == '1') {
    return Some(1)
  }
  if (c == '2') {
    return Some(2)
  }
  return None
}

function parse(chars: Array<char>): Result<int, ParseError> {
  if (Arrays.length(chars) == 0) {
    return Err(Empty)
  }
  let total = 0
  for (const i of Ranges.upTo(Arrays.length(chars))) {
    const d = digit(chars[i])
    if (d is None) {
      return Err(BadDigit(i))
    }
    total = total * 10 + d.value
  }
  return Ok(total)
}

function report(r: Result<int, ParseError>): string {
  if (r is Err(e)) {
    return match (e) {
      Empty => "error: empty"
      BadDigit(at) => `error: bad digit at ${Int.toString(at)}`
    }
  }
  return `ok ${Int.toString(r.value)}`
}

function doubled(chars: Array<char>): Result<int, ParseError> {
  const r = parse(chars)
  if (r is Err(_)) {
    return r
  }
  return Ok(r.value * 2)
}

export function run(args: Array<string>): int {
  print(report(parse(['1', '2', '0'])))
  print(report(parse([])))
  print(report(parse(['1', 'x'])))
  print(report(doubled(['2', '1'])))
  const missing: Option<string> = None
  if (missing is None) {
    print("missing")
  }
  const name: Option<string> = Some("Ana")
  if (name is Some(n)) {
    print(`hello ${n}`)
  } else {
    print("nobody")
  }
  return 0
}
