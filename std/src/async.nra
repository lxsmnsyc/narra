// std/async: the functions of task handles (SPEC.md section 8, D109).
//
// An Async<T> is the handle of a task; the type is builtin and needs no
// import. The handle functions go through the primitives of
// std/internal/async; all and race are async blocks, which the stage 1
// compiler builds (the committed seed never compiles this module).

import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Tasks from "std/internal/async"

// The error of every suspending std function.
export enum AsyncError {
  Cancelled
  Failed(message: string)
}

// Lets the task run with nobody waiting. The task keeps running to its end, or
// until the program exits.
export function detach<T>(_handle: Async<T>) {}

// A handle that finishes once no other task of the loop can run: none is
// ready, sleeping or waiting on I/O, counting tasks started while it waits.
// Idle handles finish one at a time, oldest first. In a cancelled task it
// finishes at once.
export function idle(): Async<void> uses alloc {
  return Tasks.idle()
}

// Runs callback with the value when the task finishes, or on the next loop
// turn if it has. A cancelled task drops the callback without running it. For
// an Async<void> the callback takes no argument.
export function then<T, effect E>(
  handle: Async<T>,
  escaping callback: (value: T) => void uses E
) uses E, alloc {
  // The runtime calls this only for a task that finished without a cancel.
  Tasks.then(handle, (finished: Async<T>) => callback(Tasks.value(finished)))
}

// The value once the task has finished; None before that and after a cancel.
export function peek<T>(handle: Async<T>): Option<T> uses alloc {
  if (Tasks.finished(handle)) {
    return Some(Tasks.value(handle))
  }
  return None
}

// Cancels the task: its then callbacks are dropped, peek gives None, a sleep
// or Async.idle it waits in ends at once, and its suspending std calls give
// Err(AsyncError.Cancelled). A finished task is left as it is.
export function cancel<T>(handle: Async<T>) {
  Tasks.cancel(handle)
}

// Every value, in the order of the handles, once each task has finished.
export function all<T>(handles: Array<Async<T>>): Async<Array<T>> from handles uses alloc {
  return async {
    let values: Array<T> = []
    for (const handle of Arrays.values(handles)) {
      Arrays.push(mutable values, await handle)
    }
    return values
  }
}

// The value of the first task to finish, or None for no handles. The other
// tasks keep running.
export function race<T>(handles: Array<Async<T>>): Async<Option<T>> from handles uses alloc {
  return async {
    if (Arrays.length(handles) == 0) {
      return None
    }
    const winner = Tasks.winner()
    for (const index of Ranges.between(0, Arrays.length(handles))) {
      Tasks.watch(winner, handles[index], index)
    }
    const first = await winner
    return Some(await handles[first])
  }
}
