// error: Function `pure` uses `io` but its signature does not declare it; write `uses io`
function loud(v: int): int uses io {
  print("loud")
  return v
}

struct Table {
  step: (v: int) => int
}

const steps = [loud]
const table = Table { step: loud }

export function pure(): int {
  const xs = share(steps)
  const t = share(table)
  return xs[0](2) + t.step(2)
}

export function run(args: Array<string>): int uses io {
  return pure()
}

function share<T>(value: T): T from value {
  return value
}
