import { parsePort } from "task/port"
import * as Test from "std/test"

function isFailure(result: Result<int, string>): bool {
  return result is Err
}

test "a valid port" {
  Test.eq(parsePort("8080"), Ok(8080))
}

test "the edges" {
  Test.eq(parsePort("1"), Ok(1))
  Test.eq(parsePort("65535"), Ok(65535))
}

test "out of range" {
  Test.eq(isFailure(parsePort("0")), true)
  Test.eq(isFailure(parsePort("65536")), true)
  Test.eq(isFailure(parsePort("-5")), true)
}

test "not a number" {
  Test.eq(isFailure(parsePort("abc")), true)
  Test.eq(isFailure(parsePort("")), true)
}
