import * as Api from "p/api"
import * as Text from "p/text"
import { Token, Pair } from "p/api"

function show(token: Token): string {
  return match (token) { Token.Word(text) => text, Token.Eof => "eof" }
}

function first(pair: Pair<string>): string {
  const #[head, _] = pair
  return head
}

export function run(args: Array<string>): int {
  const token: Text.Token = Token.Word("hello")
  const other: Api.Token = Api.Token.Eof
  const line: Api.Line = [token, other]
  const words: Text.Words = ["x"]
  print(show(token))
  print(show(other))
  print(first(#["a", "b"]))
  print(show(line[0]))
  print(words[0])
  return 0
}
