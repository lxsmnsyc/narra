import * as Arrays from "std/array"
import * as Str from "std/string"

const LIMIT = 100
const SMALLEST = 1

function share(total: int, divisor: int): int
  requires divisor != 0
{
  return total / divisor
}

function pick(index: int, count: int): int
  requires index >= 0 && index < LIMIT
  requires 0 < count
{
  return index % count
}

function exact(value: int): int
  requires value == 7
{
  return value * 2
}

function shiftBy(value: u32, count: u32): u32
  requires count < 32
{
  return value << count
}

function average(total: int, count: int): int
  requires count >= SMALLEST
{
  // The caller's own requires proves the call below.
  return share(total, count)
}

function parse(text: string, base: int): int
  requires base >= 2 && base <= 36
{
  return Str.length(text) + base
}

function maybeShare(total: int, divisor: int): int {
  if (divisor != 0) {
    return share(total, divisor)
  }
  return 0
}

function boundedPick(index: int): int {
  if (index < 0 || index >= 50) {
    return -1
  }
  return pick(index, 5)
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Show.show(share(10, 3)))
  print(Show.show(share(10, -2)))
  print(Show.show(pick(42, 5)))
  print(Show.show(exact(7)))
  print(Show.show(shiftBy(1, 31)))
  print(Show.show(average(9, 2)))
  print(Show.show(maybeShare(8, 0)))
  print(Show.show(maybeShare(8, 4)))
  print(Show.show(boundedPick(12)))
  print(Show.show(boundedPick(70)))
  print(Show.show(parse("ff", 16)))
  const divisor = 4
  print(Show.show(share(12, divisor)))
  print(Show.show(pick(index: 3, count: LIMIT)))
  print(Show.show(countDown(3)))
  print(Show.show(firstAt([4, 5, 6], 2)))
  print(Show.show(divideWide(18446744073709551615, 18446744073709551615)))
  print(Show.show(divideWide(18446744073709551615, 3)))
  for (const step of countTo(2)) {
    print(Show.show(step))
  }
  return 0
}

// Declared after its caller, and calling itself with a checked argument.
function countDown(steps: int): int
  requires steps >= 0
{
  const next = steps - 1
  if (next < 0) {
    return 0
  }
  return 1 + countDown(next)
}

// A result type that ends in `>` is followed by no line break token.
function firstAt(items: Array<int>, index: int): Option<int>
  requires index >= 0
{
  if (index < Arrays.length(items)) {
    return Some(items[index])
  }
  return None
}

function* countTo(limit: int): Generator<int>
  requires limit >= 0
{
  for (let i = 0; i < limit; i++) {
    yield i
  }
}

// A u64 constant from 2^63 up is above every bound and not zero.
function divideWide(value: u64, divisor: u64): u64
  requires divisor > 2
{
  return value / divisor + value / 18446744073709551615
}
