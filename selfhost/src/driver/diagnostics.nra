  Explanation {
    code: "E0217",
    text: "Arithmetic needs two numbers of the same type. An `int` and an `f64` are not mixed, and neither side is converted on its own.\nFix: convert one side, as in `Float.from(count) * 0.5`.",
  },
  Explanation {
    code: "E0218",
    text: "`&`, `|`, `^`, `<<` and `>>` need two integers of the same type.\nFix: use integer operands of one type, and convert a float or a different integer type first.",
  },
  Explanation {
    code: "E0219",
    text: "This error means the compiler reached a case it does not handle. It is a bug in narrac, not in your code.\nFix: report it at https://github.com/lxsmnsyc/narra/issues with the smallest program that shows it.",
  },
  Explanation {
    code: "E0220",
    text: "The compiler cannot work out a type parameter or constant parameter of a generic function or type from the arguments or from the expected type.\nFix: write the type arguments, as in `none<int>()`, or annotate the variable that receives the value.",
  },
  Explanation {
    code: "E0221",
    text: "A literal `Name { ... }` builds a struct, and this name is not a struct type.\nFix: use the name of a struct, or build the value with a constructor or a function of its type.",
  },
  Explanation {
    code: "E0222",
    text: "A struct literal without a type name works only where the expected type is a struct, such as an annotated variable or a parameter.\nFix: write the type name, as in `Point { x: 1, y: 2 }`.",
  },
  Explanation {
    code: "E0223",
    text: "A struct literal gives the same field twice.\nFix: delete one of the two.",
  },
  Explanation {
    code: "E0224",
    text: "A struct literal must give every field that has no default.\nFix: add the missing field, or give the field a default in the struct declaration.",
  },
  Explanation {
    code: "E0225",
    text: "The expression gives no value, for example a call to a function that returns nothing, so it cannot be stored.\nFix: call the function as a statement of its own, or make the function return a value.",
  },
  Explanation {
    code: "E0226",
    text: "Only a variable, a field or an array element can be assigned. A map entry takes `=` but not a compound assignment such as `+=`.\nFix: assign to a variable, field or element. For a map entry, compute the new value and write `m[key] = value`.",
  },
  Explanation {
    code: "E0227",
    text: "A `const` cannot be reassigned, and a parameter is read-only unless it is declared `mutable`.\nFix: declare the variable with `let`. For a parameter, declare it as `mutable name` to change the caller's value, or change a `copy(name)`.",
  },
  Explanation {
    code: "E0228",
    text: "This expression on its own line has no effect, such as `x + 1` or a bare name, so its value would be lost.\nFix: assign the value, return it, or delete the line.",
  },
  Explanation {
    code: "E0229",
    text: "This call returns a `Result`, and the code ignores it, so a failure would go unnoticed.\nFix: handle the `Result` with `match` or `is`, or discard it on purpose with `const _ = ...`.",
  },
  Explanation {
    code: "E0230",
    text: "The function declares a result type, so every `return` gives a value of that type.\nFix: write the value after `return`.",
  },
  Explanation {
    code: "E0231",
    text: "The function declares no result type, so `return` cannot give a value.\nFix: add a result type, as in `function f(): int`, or write `return` alone.",
  },
  Explanation {
    code: "E0232",
    text: "`for ... of` goes over a Range, an Array, a Generator, `Str.chars`, `Array.entries`, `Map.keys` or `Map.entries`. Other values cannot be looped over directly.\nFix: loop over one of these, for example `Map.keys` for the keys of a map.",
  },
  Explanation {
    code: "E0233",
    text: "`break` leaves a loop, so it must be inside one.\nFix: delete the `break`, or use `return` to leave the function.",
  },
  Explanation {
    code: "E0234",
    text: "`continue` goes to the next turn of a loop, so it must be inside one.\nFix: delete the `continue`, or use `return` to leave the function.",
  },
  Explanation {
    code: "E0235",
    text: "An opaque struct hides its fields from other modules. Only the module that declares it can read them.\nFix: call a function of that module that returns the field.",
  },
  Explanation {
    code: "E0236",
    text: "Spreading a struct with `...` reads all of its fields, and an opaque struct hides its fields outside its module.\nFix: build the value with the functions of the declaring module.",
  },
  Explanation {
    code: "E0237",
    text: "The type arguments written on a struct or map literal make a type that differs from the type expected here.\nFix: change the type arguments to match, or delete them and let the expected type decide.",
  },
  Explanation {
    code: "E0290",
    text: "A top-level constant cannot be changed, not even one field or element of it.\nFix: copy it into a local first, as in `let table = copy(TABLE)`, and change the local.",
  },
  Explanation {
    code: "E0291",
    text: "`yield` and `yield*` work only directly in a `function*` body, not inside an arrow function or a block expression. `yield*` takes a generator with the same element type.\nFix: move the `yield` into the generator body, or pass `yield*` a generator of the right type.",
  },
  Explanation {
    code: "E0292",
    text: "A `return` in a generator ends it and takes no value. Values leave a generator through `yield`.\nFix: `return value` becomes `yield value` followed by `return`.",
  },
  Explanation {
    code: "E0293",
    text: "A coroutine is a generator that takes an input on each resume. Only a coroutine can receive a value from `yield`. A coroutine cannot use `yield*`, and `for ... of` cannot loop over it. Resuming changes the generator, so it is passed as `mutable`.\nFix: follow the message, for example `Co.resume(g)` becomes `Co.resume(mutable g)`.",
  },
  Explanation {
    code: "E0294",
    text: "An integer literal must fit in the sized type it has here, for example 0 to 255 for `u8`.\nFix: use a value in range, or a larger type.",
  },
  Explanation {
    code: "E0295",
    text: "Integers of different sizes are not mixed in one operation, and neither are `f32` and `f64`. Neither side is converted on its own.\nFix: convert one side with the function the message names.",
  },
  Explanation {
    code: "E0296",
    text: "An unsigned integer or vector has no negative values, so unary `-` is not allowed on it.\nFix: use a signed type, or subtract the value from another one.",
  },
  Explanation {
    code: "E0297",
    text: "A float literal of type `f32` must be finite in `f32`, and this value is too large.\nFix: use a smaller value, or the type `f64`.",
  },
  Explanation {
    code: "E0301",
    text: "An enum constructor takes one value for each of its fields. The call or pattern gives a different number.\nFix: pass one value per field. For `Rect(width: f64, height: f64)`, write `Shape.Rect(2.0, 3.0)`.",
  },
  Explanation {
    code: "E0302",
    text: "The compiler cannot work out the type arguments of a generic constructor or function here. A bare `None` with no expected type is one case.\nFix: annotate the variable, as in `const first: Option<int> = None`.",
  },
  Explanation {
    code: "E0303",
    text: "A constructor stores its field values, so a constructor argument cannot be `mutable`.\nFix: remove `mutable` before the argument.",
  },
  Explanation {
    code: "E0304",
    text: "The enum has no constructor with this name.\nFix: check the spelling against the enum declaration.",
  },
  Explanation {
    code: "E0305",
    text: "No function with this name is declared or imported in this module.\nFix: check the spelling, declare the function, or import it.",
  },
  Explanation {
    code: "E0306",
    text: "The module has no function with this name.\nFix: check the spelling against the module's exports.",
  },
  Explanation {
    code: "E0308",
    text: "The name before the `.` is not an imported module.\nFix: import the module first, as in `import * as Arrays from \"std/array\"`.",
  },
  Explanation {
    code: "E0309",
    text: "Narra has no method calls. Functions belong to modules.\nFix: `xs.push(v)` becomes `Arrays.push(mutable xs, v)`.",
  },
  Explanation {
    code: "E0310",
    text: "Each use of a generic function with new type arguments makes a new copy of it. This function calls itself with ever larger type arguments, so the copies would never end.\nFix: make the recursive calls use the same type arguments.",
  },
  Explanation {
    code: "E0311",
    text: "A built-in function was called with a different number of arguments from the number it takes.\nFix: pass the number of arguments the message gives.",
  },
  Explanation {
    code: "E0312",
    text: "This built-in function changes its argument, so the call marks the argument with `mutable`.\nFix: write `mutable` before the argument.",
  },
  Explanation {
    code: "E0313",
    text: "This built-in function does not change its arguments, so no argument takes `mutable`.\nFix: remove `mutable`.",
  },
  Explanation {
    code: "E0314",
    text: "A `mutable` argument is changed in place, so it must be a variable, a field or an array element. A literal or a call result is not.\nFix: store the value in a `let` variable first, and pass that variable.",
  },
  Explanation {
    code: "E0315",
    text: "A parameter without `mutable` is read-only, so the function cannot pass it on as `mutable`.\nFix: declare the parameter as `mutable name`, or pass a copy.",
  },
  Explanation {
    code: "E0316",
    text: "The call passes a different number of arguments from the number the function takes. A range such as `1 to 3` means the last parameters have defaults.\nFix: pass one argument for each parameter without a default.",
  },
  Explanation {
    code: "E0317",
    text: "This parameter is declared `mutable`, so the call marks its argument with `mutable` too.\nFix: write `mutable` before the argument.",
  },
  Explanation {
    code: "E0318",
    text: "This parameter is not declared `mutable`, so its argument takes no `mutable`.\nFix: remove `mutable`, or declare the parameter `mutable` if the function changes it.",
  },
  Explanation {
    code: "E0319",
    text: "A value passed as `mutable` can change during the call, so no other argument of the same call may use it.\nFix: read the value into a local first, then pass the local.\nExample: `set(mutable xs, xs[0])` becomes `const first = xs[0]` and `set(mutable xs, first)`.",
  },
  Explanation {
    code: "E0320",
    text: "Only the module that declares an opaque struct can build it with a literal.\nFix: call a function of that module that creates the value.",
  },
  Explanation {
    code: "E0321",
    text: "An opaque distinct type keeps `from`, and `check` for a refined type, to its own module. Only that module can create values.\nFix: call a function of the declaring module that creates the value.",
  },
  Explanation {
    code: "E0322",
    text: "A distinct type has only its generated functions, `from` and the unwrap function such as `toInt`, plus `check` when it is refined.\nFix: call one of those functions, or a function of the declaring module.",
  },
  Explanation {
    code: "E0323",
    text: "A constructor of a user enum is always written with its enum, in expressions and in patterns. Some, None, Ok and Err stay bare.\nFix: `Circle(1.0)` becomes `Shape.Circle(1.0)`.",
  },
  Explanation {
    code: "E0324",
    text: "Two enums visible here have this constructor, so the compiler cannot pick one.\nFix: write Enum.Name for the one you mean, for example `Level.Low`.",
  },
  Explanation {
    code: "E0325",
    text: "A generic function was called with an argument that cannot match its parameter, for example an int where Option<T> is expected.\nFix: pass a value of the shape the parameter asks for.",
  },
  Explanation {
    code: "E0326",
    text: "Explicit type arguments, as in f<int>(x), only go with a generic function or a trait function.\nFix: delete the type arguments, or call a generic function.",
  },
  Explanation {
    code: "E0327",
    text: "A generic function takes one type argument per type parameter, all or none. A trait call takes one, the type that Self stands for.\nFix: write every type argument, or none and let the arguments decide.",
  },
  Explanation {
    code: "E0328",
    text: "The named argument matches no parameter of the function.\nFix: use the parameter's name. When the message suggests a close name, the fix renames the argument.",
  },
  Explanation {
    code: "E0329",
    text: "The call gives the same parameter twice, by position and by name, or by name twice.\nFix: pass each parameter once.",
  },
  Explanation {
    code: "E0330",
    text: "Positional arguments come first. After a named argument, every argument is named.\nFix: name the argument, or move it before the named arguments.",
  },
  Explanation {
    code: "E0331",
    text: "Each parameter without a default needs an argument.\nFix: pass the argument, by position or by name.",
  },
  Explanation {
    code: "E0332",
    text: "Only a declared function takes named arguments. A function value, a built-in function, a constructor and the function of a distinct type take arguments by position.\nFix: remove the names, and pass the arguments in order.",
  },
  Explanation {
    code: "E0400",
    text: "The entry function starts the program. It takes the command-line arguments as one `Array<string>` and returns the exit code as an `int`. It may be `async`.\nFix: write it as `export function run(args: Array<string>): int`.",
  },
  Explanation {
    code: "E0401",
    text: "An import path that starts with the package name points at a file under `src/`. The path `app/util` is the file `src/util.nra`, and that file does not exist.\nFix: correct the path, or create the file.",
  },
  Explanation {
    code: "E0402",
    text: "Other modules can use only the declarations marked `export`.\nFix: add `export` before the declaration, or stop importing the name.",
  },
  Explanation {
    code: "E0403",
    text: "A type written as `Name.Type` must start with the alias of an imported module. No import in this file has that alias.\nFix: import the module with `import * as Name from \"...\"`, or correct the alias.",
  },
  Explanation {
    code: "E0404",
    text: "The module exports this name, but it is a function or a constant. Only a struct, enum, distinct type or type alias can be used as a type.\nFix: use the name of a type that the module exports.",
  },
  Explanation {
    code: "E0405",
    text: "In `narra.toml`, a line that starts with `[[` opens an array of tables, such as `[[binary]]`, and must end with `]]`.\nFix: end the line with `]]`.",
  },
  Explanation {
    code: "E0406",
    text: "In `narra.toml`, a line that starts with `[` names a table, such as `[package]`, and must end with `]`.\nFix: end the line with `]`.",
  },
  Explanation {
    code: "E0408",
    text: "In a known table of `narra.toml`, every line that is not a table header or a comment must be `key = value`.\nFix: add the `=` and the value, or delete the line.",
  },
  Explanation {
    code: "E0409",
    text: "A value in `narra.toml` could not be read. A value is a quoted string, an array of strings, or an inline table in `[dependencies]` and `[overrides]`. The message says what is wrong, for example a string that is not closed.\nFix: write the value in one of these forms, such as `version = \"1.0.0\"`.",
  },
  Explanation {
    code: "E0410",
    text: "The package name is the first part of every import path of the package. It must be letters, digits and `_`, and start with a letter.\nFix: `name = \"my-app\"` becomes `name = \"my_app\"`.",
  },
  Explanation {
    code: "E0411",
    text: "Import paths that start with `std` name the standard library, so a package cannot have that name.\nFix: choose another `name` in `[package]`.",
  },
  Explanation {
    code: "E0412",
    text: "This key takes one string. The `version` of `[package]` and the `name` and `entry` of a `[[binary]]` are strings.\nFix: `entry = [\"main.run\"]` becomes `entry = \"main.run\"`.",
  },
  Explanation {
    code: "E0413",
    text: "The `search` key of `[link]` takes an array of strings, even for one folder.\nFix: `search = \"/opt/lib\"` becomes `search = [\"/opt/lib\"]`.",
  },
  Explanation {
    code: "E0414",
    text: "Every package needs a name in its `[package]` table. Only a workspace root without a `[package]` table can leave it out.\nFix: add `name = \"app\"` under `[package]`.",
  },
  Explanation {
    code: "E0415",
    text: "Each `[[binary]]` table makes one program. It needs the `name` of the executable and the `entry`, the function that starts it, written as `\"module.function\"` with the module path relative to `src/`.\nFix: add both keys, for example `name = \"app\"` and `entry = \"main.run\"`.",
  },
  Explanation {
    code: "E0416",
    text: "Each `[[binary]]` builds an executable named by its `name`, so two tables with one name would write the same file.\nFix: rename one of the binaries.",
  },
  Explanation {
    code: "E0417",
    text: "Each module gets a short hash that is part of its names in the generated C code. Two modules of the build got the same hash, so their names would clash.\nFix: rename one of the two files.",
  },
  Explanation {
    code: "E0418",
    text: "Modules cannot import each other in a cycle. The message lists the modules in the cycle.\nFix: move the shared declarations into a new module that both import, or merge the modules.",
  },
  Explanation {
    code: "E0419",
    text: "A program built from one file starts at an exported function `run`, and the file has none.\nFix: add `export function run(args: Array<string>): int`. Its result is the exit code.",
  },
  Explanation {
    code: "E0420",
    text: "The `entry` of a `[[binary]]` names a module and a function, as in `\"main.run\"`. That module has no exported function with that name.\nFix: declare `export function start(args: Array<string>): int` in the module, or correct the `entry`.",
  },
  Explanation {
    code: "E0421",
    text: "An import alias has the name of a type of this module. Both are written before a `.`, as in `Shape.Circle`, so the compiler could not tell them apart.\nFix: rename the alias, for example `import * as Shapes from \"...\"`. The compiler offers this fix.",
  },
  Explanation {
    code: "E0422",
    text: "Each alias in a file names one module. Two imports with one alias would make `Alias.name` ambiguous.\nFix: give one of the imports another alias.",
  },
  Explanation {
    code: "E0423",
    text: "A name imported with `import { name }` has the name of a function, constant or alias of this module.\nFix: rename the import with `as`, as in `import { length as textLength } from \"std/string\"`.",
  },
  Explanation {
    code: "E0424",
    text: "Two imports bring in the same name from different modules, so a call to that name would be ambiguous.\nFix: rename one of them with `as`, as in `import { parse as parseJson } from \"...\"`.",
  },
  Explanation {
    code: "E0425",
    text: "Importing a constructor by name is not allowed. Import the enum; its constructors come with it.\nFix: `import { Teacher }` becomes `import { SchoolPerson }`, and uses become `SchoolPerson.Teacher`.",
  },
  Explanation {
    code: "E0430",
    text: "A dependency is downloaded from a git repository at a tagged version, so its inline table needs both `git` and `version`.\nExample: `json = { git = \"https://example.com/narra-json\", version = \"1.2.0\" }`.",
  },
  Explanation {
    code: "E0431",
    text: "A version has three numbers, `MAJOR.MINOR.PATCH`.\nFix: `\"1.0\"` becomes `\"1.0.0\"`.",
  },
  Explanation {
    code: "E0432",
    text: "The inline table of a dependency takes `git` and `version`, each once. A member of the same workspace takes `workspace = true` alone.\nFix: remove the unknown or repeated key.",
  },
  Explanation {
    code: "E0433",
    text: "`std` is the standard library, which every package can import, and a package cannot depend on itself.\nFix: remove the entry from `[dependencies]` or `[overrides]`.",
  },
  Explanation {
    code: "E0434",
    text: "The name of a dependency is the first part of its import paths, so it can stand for one package only.\nFix: delete one of the two entries.",
  },
  Explanation {
    code: "E0435",
    text: "A dependency is an inline table of quoted strings, such as `{ git = \"...\", version = \"1.2.0\" }`, or `{ workspace = true }`. The value could not be read as one. A trailing comma or an unquoted value also causes this error.\nFix: write the table in that form.",
  },
  Explanation {
    code: "E0436",
    text: "The name of a dependency is the first part of its import paths. It must be letters, digits and `_`, and start with a letter.\nFix: use the `name` from the `[package]` table of the dependency.",
  },
  Explanation {
    code: "E0437",
    text: "A line of `narra.lock` is not `[[package]]` or `key = \"value\"`, or a value has the wrong form. `narrac build` writes this file, and it is not meant to be edited by hand.\nFix: undo the edit, or delete `narra.lock` and run `narrac build` to write it again.",
  },
  Explanation {
    code: "E0438",
    text: "An entry of `narra.lock` has an unknown, missing or repeated key, or a `tag` that does not belong to its `version`. `narrac build` writes this file.\nFix: undo the edit, or delete `narra.lock` and run `narrac build` to write it again.",
  },
  Explanation {
    code: "E0439",
    text: "Two entries of `narra.lock` have the same name and the same compatibility line. A package has one entry for each line in the build.\nFix: undo the edit, or delete `narra.lock` and run `narrac build` to write it again.",
  },
  Explanation {
    code: "E0440",
    text: "`narrac` runs `git` to fetch dependencies, and found no `git` program on `PATH`.\nFix: install git, or add its folder to `PATH`.",
  },
  Explanation {
    code: "E0441",
    text: "`narrac` could not list the tags of the repository with `git ls-remote`. The URL or path may be wrong, the network may be down, or the repository may need access rights. The message shows the first line of the git error.\nFix: check the `git` value of the dependency, and that git can reach the repository.",
  },
  Explanation {
    code: "E0442",
    text: "A version is fetched by its tag, and the repository has no tag with that name. The tag is `v1.2.0` for version `1.2.0`, or `json/v1.2.0` in a repository that holds several packages.\nFix: check the version, or push the tag to the repository.",
  },
  Explanation {
    code: "E0443",
    text: "A version in the cache has a `.hash` file next to it that records its commit and tree hashes. That file is missing or damaged, or the tree hash differs from the one `narra.lock` records.\nFix: delete the cached folder and its `.hash` file, then run `narrac build` to fetch it again.",
  },
  Explanation {
    code: "E0444",
    text: "Dependencies are cached in `$NARRA_CACHE`, or in `$HOME/.cache/narra` when that variable is not set. Neither variable is set.\nFix: set `NARRA_CACHE` or `HOME`.",
  },
  Explanation {
    code: "E0445",
    text: "Fetching a version into the cache failed while creating a folder, cloning the repository or checking out the tag. The message gives the step and the error.\nFix: check the free disk space and the permissions of the cache folder, then build again.",
  },
  Explanation {
    code: "E0450",
    text: "A package name stands for one source in a build. Here two packages require it from different repositories, or a workspace member has the name and a git dependency asks for it too.\nFix: add an entry for the package to `[overrides]` in the root `narra.toml`, or depend on the member with `{ workspace = true }`.",
  },
  Explanation {
    code: "E0451",
    text: "The repository has no tag for the version asked for, neither `v1.2.0` nor `json/v1.2.0` for version `1.2.0` of `json`.\nFix: check the `version` of the dependency, or tag that version in the repository.",
  },
  Explanation {
    code: "E0452",
    text: "`narra.lock` records the commit and tree hash of each version. The repository now has other hashes for the same tag, for example because the tag was moved. The build stops so that changed code is not used without notice.\nFix: find out why the tag changed. If the new code is trusted, delete `narra.lock` and run `narrac build` to record the new hashes.",
  },
  Explanation {
    code: "E0453",
    text: "The `narra.toml` of the fetched version has a `[package]` name that differs from the key in `[dependencies]`.\nFix: use the name of the package as the key, or check the `git` URL.",
  },
  Explanation {
    code: "E0454",
    text: "Only the root `narra.toml` of a build may replace repositories with `[overrides]`. A dependency or a workspace member cannot.\nFix: move the entries to the `narra.toml` of the root.",
  },
  Explanation {
    code: "E0455",
    text: "An entry of `[overrides]` names a package that no package in the build requires.\nFix: delete the entry, or correct its name.",
  },
  Explanation {
    code: "E0456",
    text: "The version that an override names has no tag in the repository of the override.\nFix: change the version, or tag it in that repository.",
  },
  Explanation {
    code: "E0457",
    text: "The fetched version has no `narra.toml` where the package should be, so it is not a Narra package.\nFix: check the `git` URL and the `version` of the dependency.",
  },
  Explanation {
    code: "E0458",
    text: "`narrac` could not read or write `narra.toml` or `narra.lock`. The message gives the path and the system error.\nFix: check that the file exists and that you may read and write it.",
  },
  Explanation {
    code: "E0459",
    text: "Two packages in the build require versions of a package with C sources on different compatibility lines. A build can hold two lines of a Narra package, but the C files of a package compile and link once, so a package with `[c]` tables has one version in a build. The line is the major version from 1.0.0 up, `0.MINOR` below it, and the whole version for `0.0.PATCH`.\nFix: update the package that requires the older line, or force one version with `[overrides]` in the root manifest.",
  },
  Explanation {
    code: "E0460",
    text: "`narra.lock` names a version that is not in the cache. Tools that read the cache without fetching, such as `narrac lsp`, report this.\nFix: run `narrac build` to fetch it.",
  },
  Explanation {
    code: "E0461",
    text: "A dependency has no matching entry in `narra.lock`, often after `[dependencies]` changed. Tools that do not fetch, such as `narrac lsp`, report this.\nFix: run `narrac build` to update the lock.",
  },
  Explanation {
    code: "E0462",
    text: "A dependency must hold Narra code, at least one `.nra` file under `src/`.\nFix: check the `git` URL and the `version` of the dependency.",
  },
  Explanation {
    code: "E0463",
    text: "A package may import only itself, `std` and the packages in its own `[dependencies]`. A package that another dependency brings in does not count.\nFix: add the package to `[dependencies]` of the importing package.",
  },
  Explanation {
    code: "E0470",
    text: "A key of `[exports]` is the import path that other packages write. It must be the package name, or start with the package name and `/`.\nFix: in package `json`, `\"stream\" = \"src/stream.nra\"` becomes `\"json/stream\" = \"src/stream.nra\"`.",
  },
  Explanation {
    code: "E0471",
    text: "A value of `[exports]` is the module file, a string that starts with `src/` and ends with `.nra`. The file must exist.\nFix: write the path of an existing module, such as `\"src/index.nra\"`.",
  },
  Explanation {
    code: "E0472",
    text: "Two keys of `[exports]` are the same import path.\nFix: delete or rename one of them.",
  },
  Explanation {
    code: "E0473",
    text: "The package has an `[exports]` table, so other packages may import only the paths it lists. The message shows them.\nFix: import one of the listed paths, or add the module to `[exports]` of that package.",
  },
  Explanation {
    code: "E0474",
    text: "Modules under `std/internal/` and `std/ext/` are parts of the standard library that only the library itself imports. The message lists the modules you can import.\nFix: import one of those modules instead.",
  },
  Explanation {
    code: "E0480",
    text: "`[workspace]` takes one key, `members`, an array of folders relative to the root. `*` may stand for one whole folder name, and `..` is not allowed.\nExample: `members = [\"packages/*\", \"tools/lint\"]`.",
  },
  Explanation {
    code: "E0481",
    text: "Each member folder needs a `narra.toml` with a `[package]` table. A member cannot have a `[workspace]` of its own.\nFix: add the `narra.toml`, remove the inner `[workspace]`, or remove the folder from `members`.",
  },
  Explanation {
    code: "E0482",
    text: "Members are known by the name in their `[package]` table, and two members have the same name.\nFix: rename one of the packages.",
  },
  Explanation {
    code: "E0483",
    text: "`workspace = true` names a member of the same workspace, so it takes no other key and no value but `true`. `[overrides]` takes `git` and `version` only.\nFix: write `core = { workspace = true }`, or `git` and `version` for an override.",
  },
  Explanation {
    code: "E0484",
    text: "`workspace = true` must name a member of the workspace that holds this package. Here no member has that name, or the package is not in a workspace.\nFix: correct the name, add the folder to `members`, or depend on the package with `git` and `version`.",
  },
  Explanation {
    code: "E0485",
    text: "A workspace keeps one `narra.lock`, at its root, and a member has a lock file of its own.\nFix: delete the `narra.lock` of the member.",
  },
  Explanation {
    code: "E0486",
    text: "The fetched repository is a workspace, and no package in it has the name asked for.\nFix: check the name and the `git` URL of the dependency.",
  },
  Explanation {
    code: "E0487",
    text: "A fetched package depends on another member of its own workspace with `workspace = true`. That member has no `version` in its `narra.toml`, or the repository has no tag for its version.\nFix: the problem is in the repository of the dependency. Use another version, or ask its authors to set and tag the version.",
  },
  Explanation {
    code: "E0488",
    text: "Two members of the workspace have a `[[binary]]` with the same name, so a build of both would write two executables with one name.\nFix: rename one of the binaries.",
  },
  Explanation {
    code: "E0489",
    text: "`-dependents` and `-dependencies` start from one member, so they need the folder of a member. The path given is not a member, or it is the workspace root, which already covers every member.\nFix: pass the folder of a member.",
  },
  Explanation {
    code: "E0490",
    text: "Members depend on each other in a cycle through `workspace = true`, so no member can be built first.\nFix: move the code they share into a member that the others depend on.",
  },
  Explanation {
    code: "E0500",
    text: "A trait has the name of another trait or a type of this module, or of an imported trait.\nFix: rename one of them.",
  },
  Explanation {
    code: "E0501",
    text: "A trait appears twice in the `implements` list of a type.\nFix: delete the second one.",
  },
  Explanation {
    code: "E0503",
    text: "Only Equatable, Hashable, Ordered, Show and Shape can be derived. The compiler writes them from the fields. Any other trait needs its functions written by hand.\nFix: move the trait from `derives` to `implements` and write an `implement T for A` block.",
  },
  Explanation {
    code: "E0504",
    text: "A trait appears twice in the `derives` list of a type.\nFix: delete the second one.",
  },
  Explanation {
    code: "E0505",
    text: "No trait with this name is visible here. It is not a standard trait, not declared in this module and not imported.\nFix: correct the name, or import the trait from its module.",
  },
  Explanation {
    code: "E0506",
    text: "A trait appears twice in the constraint of one type parameter, as in `<T: Show & Show>`.\nFix: delete the second one.",
  },
  Explanation {
    code: "E0507",
    text: "`implements T` in a declaration needs an `implement T for A` block in the same module, and the block is missing.\nFix: write the block. For Equatable, Hashable, Ordered, Show and Shape, `derives T` also works.",
  },
  Explanation {
    code: "E0508",
    text: "A type gets each trait one way, derived from its fields or written in an `implement` block.\nFix: remove the trait from `derives`, or delete the `implement` block.",
  },
  Explanation {
    code: "E0509",
    text: "A derived trait applies the trait to each field, so every field type must implement it. A function type does not implement Equatable, for example.\nFix: change the field type, write an `implement` block, or remove the trait from `derives`.",
  },
  Explanation {
    code: "E0510",
    text: "A function declared in a trait cannot have type parameters of its own. This compiler does not support them there.\nFix: remove the type parameters and use concrete types.",
  },
  Explanation {
    code: "E0511",
    text: "A trait declares each function name once.\nFix: rename or delete one of the two functions.",
  },
  Explanation {
    code: "E0512",
    text: "A call such as `T.f(x)` picks the implementation from the type that `Self` stands for. A trait function that does not mention `Self` gives the call nothing to pick with.\nFix: use `Self` in a parameter or the result, as in `function f(x: Self): int`.",
  },
  Explanation {
    code: "E0513",
    text: "An `implement` block must be in the module that declares the type. A type of another module, or a built-in type such as `string`, cannot get one here.\nFix: wrap the value in a struct of this module and implement the trait for that struct.\nExample: `struct Name implements T { text: string }`.",
  },
  Explanation {
    code: "E0515",
    text: "An `implement T for A` block needs `implements T` in the declaration of `A`.\nFix: add `implements T` to the declaration, as in `struct A implements T { ... }`.",
  },
  Explanation {
    code: "E0516",
    text: "A type has one `implement` block for each trait.\nFix: merge the two blocks into one.",
  },
  Explanation {
    code: "E0517",
    text: "A function in an `implement` block cannot have type parameters of its own. This compiler does not support them there.\nFix: remove the type parameters and use concrete types.",
  },
  Explanation {
    code: "E0518",
    text: "An `implement` block or a call `T.name(...)` names a function that the trait does not declare.\nFix: correct the name, or add the function to the trait.",
  },
  Explanation {
    code: "E0519",
    text: "An `implement` block defines each function of the trait once.\nFix: delete one of the two definitions.",
  },
  Explanation {
    code: "E0520",
    text: "Each function of an `implement` block has the signature of the trait function, with `Self` replaced by the type. The message shows the signature it must have.\nFix: change the parameters or the result to match.",
  },
  Explanation {
    code: "E0521",
    text: "An `implement` block must define every function that the trait declares.\nFix: add the missing function.",
  },
  Explanation {
    code: "E0522",
    text: "A call `T.f(...)` picks the implementation from the type that `Self` stands for. The arguments here do not show that type, for example an empty array literal.\nFix: give the argument a type, or name the type as in `T.f<A>(...)`.",
  },
  Explanation {
    code: "E0523",
    text: "Inside a generic function, a type parameter implements a trait only when its declaration says so.\nFix: `function g<X>(x: X)` becomes `function g<X: T>(x: X)`.",
  },
  Explanation {
    code: "E0524",
    text: "The type of the value does not implement the trait that the call needs.\nFix: implement the trait for the type, or pass a value of a type that implements it. A standard trait can be derived with `derives`.",
  },
  Explanation {
    code: "E0525",
    text: "The generic function requires this type parameter to implement a trait, and the type passed for it does not.\nFix: implement the trait for that type, or call the function with a type that implements it.",
  },
  Explanation {
    code: "E0526",
    text: "Functions cannot be compared, so a value that holds a function has no `==`.\nFix: compare the fields that are not functions.",
  },
  Explanation {
    code: "E0527",
    text: "`==` on a value of a type parameter needs the parameter to be Equatable.\nFix: `<T>` becomes `<T: Equatable>`.",
  },
  Explanation {
    code: "E0528",
    text: "This type has no `==`. A struct or enum is Equatable when all its fields are, but a Map, a Range, a Generator and a Dynamic value are not.\nFix: compare the parts by hand, for example the entries of a Map.",
  },
  Explanation {
    code: "E0529",
    text: "No parameter of this trait function mentions Self, so the call alone cannot tell which implementation to use.\nFix: name the type: `Shape.fromValue<User>(value)`.",
  },
  Explanation {
    code: "E0530",
    text: "Shape converts a type to and from a Value tree. The compiler provides it for bool, int, f64, char, string, Array<T>, Map<string, V>, Option<T> and tuples of two to four items whose contents implement it. A struct or enum needs an `implement Shape` block. A Map with keys other than string, a function and a sized integer have no Value form.\nFix: use a Map<string, V>, or wrap the type in a struct that implements Shape.",
  },
  Explanation {
    code: "E0531",
    text: "`derives Shape` writes toValue and fromValue from the fields, so every field type must implement Shape itself.\nFix: give the field a type that implements Shape, or write an `implement Shape` block for the type instead of deriving it.",
  },
  Explanation {
    code: "E0532",
    text: "A derived Shape writes an enum value as a Record whose \"type\" entry names the constructor. A constructor field named type would take the same key.\nFix: rename the field, or write an `implement Shape` block for the enum.",
  },
  Explanation {
    code: "E0533",
    text: "Other modules cannot build an opaque struct or read its fields, and a derived Shape does both, so only the struct's own module may use it.\nFix: convert the value in the declaring module, or write an `implement Shape` block that keeps the struct's rules.",
  },
  Explanation {
    code: "E0600",
    text: "`escaping` applies only to a parameter with a function type.\nFix: remove `escaping`.",
  },
  Explanation {
    code: "E0601",
    text: "A function parameter that is not `escaping` can only be called, or passed on to a function parameter that is not escaping. It cannot be stored, returned or captured, because the function it holds may be gone after the call.\nFix: declare it as `escaping rule: (x: int) => int`.",
  },
  Explanation {
    code: "E0602",
    text: "A closure can outlive the call, so it cannot capture a function parameter that is not `escaping`.\nFix: declare the parameter as `escaping`.",
  },
  Explanation {
    code: "E0605",
    text: "A function with a `mutable` parameter changes its argument in place, and a function value cannot take `mutable` arguments.\nFix: call the function directly, or write a version that returns the new value.",
  },
  Explanation {
    code: "E0606",
    text: "Only a function can be called, and this name holds a value that is not a function. When the `<` after the name is a comparison, it was read as the start of type arguments.\nFix: remove the call, or put the comparison in parentheses, as in `(a < b)`.",
  },
  Explanation {
    code: "E0607",
    text: "This expression is not a function, so it cannot be called.\nFix: call a function, or a value whose type is a function type.",
  },
  Explanation {
    code: "E0608",
    text: "A function value cannot take `mutable` arguments.\nFix: remove `mutable` from the argument.",
  },
  Explanation {
    code: "E0609",
    text: "A `mutable` argument could change or free the variable that holds the function being called, while the call runs.\nFix: make the two steps separate statements, as in `const n = change(mutable h)` followed by `h.f(n)`.",
  },
  Explanation {
    code: "E0610",
    text: "An arrow function passed where a function type is expected takes as many parameters as that type.\nFix: add or remove parameters to match.",
  },
  Explanation {
    code: "E0611",
    text: "An arrow function takes its parameter types from the function type it is passed to. With no expected type, each parameter needs a written type.\nFix: `(x) => x + 1` becomes `(x: int) => x + 1`.",
  },
  Explanation {
    code: "E0612",
    text: "A closure can capture a `let` variable only when it is passed straight to a function parameter that is not escaping. A stored or returned closure may run after the variable is gone.\nFix: capture a `const` copy of the value, or keep the changing value in a `Cell` from `std/cell`.",
  },
  Explanation {
    code: "E0613",
    text: "A closure can capture a `mutable` parameter only when it is passed straight to a function parameter that is not escaping. The same holds for a loop element changed in place.\nFix: copy the value first with `copy(name)` and capture the copy.",
  },
  Explanation {
    code: "E0614",
    text: "A closure passed to this call assigns the variable while the call runs. The other arguments are passed by reference, so the function could read the variable while the closure changes it.\nFix: read the variable into a `const` before the call and pass that.",
  },
  Explanation {
    code: "E0615",
    text: "A generator runs its body each time it is resumed, after the call that created it has returned. So a function parameter of a generator must be `escaping`.\nFix: `function* g(f: () => int)` becomes `function* g(escaping f: () => int)`.",
  },
  Explanation {
    code: "E0700",
    text: "In a pattern, a name that starts with a capital letter is a constructor, and a lowercase name binds the value. The value here has no constructor with this name.\nFix: write the binding in lowercase, or match a value of the enum that has this constructor.",
  },
  Explanation {
    code: "E0701",
    text: "A pattern binds each name once.\nFix: rename one of them, or write `_` for a value you do not need.",
  },
  Explanation {
    code: "E0702",
    text: "A constructor pattern such as `Shape.Circle(r)` matches an enum value, and the value here is not an enum.\nFix: match the value with a pattern of its own type.",
  },
  Explanation {
    code: "E0703",
    text: "The constructor belongs to another enum than the type of the value.\nFix: use a constructor of the value's enum.",
  },
  Explanation {
    code: "E0704",
    text: "A constructor pattern lists one pattern for each field of the constructor.\nFix: add or remove patterns. Write `_` for a field you do not need.",
  },
  Explanation {
    code: "E0705",
    text: "A struct pattern such as `{ name, quantity }` matches a struct value, and the value here is not a struct.\nFix: match the value with a pattern of its own type.",
  },
  Explanation {
    code: "E0706",
    text: "A struct pattern lists each field once.\nFix: delete the second one.",
  },
  Explanation {
    code: "E0707",
    text: "A tuple pattern such as `#[a, b]` matches a tuple value, and the value here is not a tuple.\nFix: match the value with a pattern of its own type.",
  },
  Explanation {
    code: "E0708",
    text: "A tuple pattern lists one pattern for each element of the tuple.\nFix: add or remove patterns. Write `_` for an element you do not need.",
  },
  Explanation {
    code: "E0709",
    text: "A literal pattern such as `1` or `\"add\"` matches a number, `bool`, `char` or `string` value.\nFix: match the value with a pattern of its own type.",
  },
  Explanation {
    code: "E0710",
    text: "A name bound by `x is Some(v)` can be used only where the test is known to have passed. The test must be the whole condition of an `if` or of `? :`.\nFix: write `if (x is Some(v)) { ... }` or `x is Some(v) ? v : 0`, or use `match`.",
  },
  Explanation {
    code: "E0711",
    text: "The value after `match` is an expression with no value, such as a call to a function that returns nothing.\nFix: match a value.",
  },
  Explanation {
    code: "E0713",
    text: "A `match` must handle every value of its subject, and the arms do not cover every value of this type, for example every `int`.\nFix: add a `_` arm.",
  },
  Explanation {
    code: "E0714",
    text: "A `match` must handle every value of its subject. The arms miss the cases in the message.\nFix: add arms for them, or a `_` arm.",
  },
  Explanation {
    code: "E0715",
    text: "A destructuring declaration such as `const [a] = xs` has no other branch, so its pattern must match every value of the type. This pattern can fail, for example on an array of another length.\nFix: use `match`, or test with `if (xs is [a]) { ... }`.",
  },
  Explanation {
    code: "E0716",
    text: "The spread `...value` in a struct literal copies the fields of a struct, and the value here is not a struct.\nFix: spread a struct value, or write the fields one by one.",
  },
  Explanation {
    code: "E0717",
    text: "The spread in a struct literal must have the type of the literal.\nFix: spread a value of the literal's type, or write the fields one by one.",
  },
  Explanation {
    code: "E0718",
    text: "A tuple type has at least two element types. For one value, use its type directly.\nFix: `#[int]` becomes `int`.",
  },
  Explanation {
    code: "E0719",
    text: "A tuple has at least two elements. For one value, use the value directly.\nFix: `#[x]` becomes `x`.",
  },
  Explanation {
    code: "E0720",
    text: "An opaque struct hides its fields from other modules, so a struct pattern cannot read them there.\nFix: read the value with the functions that its module exports.",
  },
  Explanation {
    code: "E0722",
    text: "`...` in an array pattern matches the elements left at the end, so it comes last and once.\nFix: match the start, as in `[first, ...rest]`, and read later elements by index.",
  },
  Explanation {
    code: "E0723",
    text: "A FixedArray has a known length, and the pattern matches another number of elements. When the length is a constant parameter, only `[..._]` matches every value.\nFix: list one pattern for each element, use `match` or `is` to test the length, or end the pattern with `..._`.",
  },
  Explanation {
    code: "E0724",
    text: "The rest of a FixedArray pattern would have the length N minus the elements before it, so it cannot get a name.\nFix: write `..._` and read the elements by index.",
  },
  Explanation {
    code: "E0726",
    text: "An array pattern such as `[first, ...rest]` matches an Array or FixedArray value, and the value here is neither.\nFix: match the value with a pattern of its own type.",
  },
  Explanation {
    code: "E0800",
    text: "An exported function declares its effects with `uses`, and so does a private function that writes a `uses` list. The body has an effect that the list leaves out. The message names the call that causes it. An implementation of a trait function may use only the effects that the trait function declares.\nFix: add the effect, as in `uses io`. For an implementation, add it to the trait function.",
  },
  Explanation {
    code: "E0801",
    text: "The effects are `alloc`, `io` and `unsafe`. Any other name in a `uses` list must be an effect variable declared with the type parameters, as in `<effect E>`.\nFix: correct the name, or declare the variable.",
  },
  Explanation {
    code: "E0802",
    text: "An effect variable stands for the effects of a function the caller passes in. It must appear in the `uses` of a parameter's function type.\nExample: `function each<effect E>(xs: Array<int>, visit: (x: int) => void uses E) uses E`.",
  },
  Explanation {
    code: "E0803",
    text: "A parameter whose function type has no `uses` accepts only functions without effects. The argument has the effects in the message.\nFix: add them to the parameter type, as in `uses io`. Or use an effect variable: `<effect E>` on the function, and `uses E` on the parameter type and the function.",
  },
  Explanation {
    code: "E0900",
    text: "A map compares and hashes its keys by value. Floats, void, functions, maps, ranges, generators, pointers, Dynamic values and Cells cannot be keys, and neither can a struct, tuple or enum that holds one. A type that implements only one of Equatable and Hashable cannot be a key either.\nFix: key the map by a type that can be hashed, such as an int, a string or a struct of them.",
  },
  Explanation {
    code: "E0901",
    text: "An empty `Map {}` has no entries to take the key and value types from.\nFix: annotate the target, as in `const ages: Map<string, int> = Map {}`.",
  },
  Explanation {
    code: "E0902",
    text: "This std/map function takes a map as this argument, and the value passed is not one.\nFix: pass a `Map<K, V>`.",
  },
  Explanation {
    code: "E0903",
    text: "`Maps.remove` and `Maps.update` change the map they are given, so the call marks it `mutable`.\nFix: `Maps.remove(ages, key)` becomes `Maps.remove(mutable ages, key)`.",
  },
  Explanation {
    code: "E0904",
    text: "`Arrays.length`, `Arrays.values` and `Arrays.entries` take an array, and the value passed is not one.\nFix: pass an `Array<T>`.",
  },
  Explanation {
    code: "E0905",
    text: "`Arrays.push` and `Arrays.truncate` change the array they are given, so the call marks it `mutable`.\nFix: `Arrays.push(items, 3)` becomes `Arrays.push(mutable items, 3)`.",
  },
  Explanation {
    code: "E0906",
    text: "The first argument of `Arrays.push` or `Arrays.truncate` is the array to change, and the value passed is not an array.\nFix: pass an `Array<T>`, marked `mutable`.",
  },
  Explanation {
    code: "E0907",
    text: "The functions of std/test, such as `Test.eq`, are assertions for test blocks. A call outside a `test` block is an error. The import itself may stay in a file that is also built as a program.\nFix: move the call into a `test \"name\" { ... }` block.",
  },
  Explanation {
    code: "E0908",
    text: "`Array`, `Map`, `Box`, `Option`, `Range` and `Result` are types, not modules. Their functions live in a std module that must be imported.\nFix: add `import * as Arrays from \"std/array\"` and call `Arrays.length(items)`. `narrac apply-fix` adds the import.",
  },
  Explanation {
    code: "E0910",
    text: "The std/result functions, such as `Results.map` and `Results.withDefault`, take a `Result<T, E>` as their first argument, and the value passed is not one.\nFix: pass a Result.",
  },
  Explanation {
    code: "E0911",
    text: "This argument of a std/result or std/map function is called as a function, so it must be one.\nFix: pass an arrow function or a function name, as in `Results.map(result, (value: int) => value + 1)`.",
  },
  Explanation {
    code: "E0912",
    text: "The callback of `Results.andThen` returns the next Result. A callback that returns a plain value fits `Results.map`.\nFix: return a Result from the callback, as in `(value: int): Result<int, string> => Ok(value + 1)`, or call `Results.map`.",
  },
  Explanation {
    code: "E0913",
    text: "The value the callback returns goes into the result of the call, so a callback that returns nothing has no value to give.\nFix: return a value from the callback.",
  },
  Explanation {
    code: "E0914",
    text: "A type name is not a module. The std module for this type is already imported, under another name.\nFix: call the function through that import's name, as in `Arrays.length(items)`. `narrac apply-fix` makes the change.",
  },
  Explanation {
    code: "E0915",
    text: "A `mutable` parameter and a `for (mutable ...)` loop element refer to a value that the caller or the loop owns. Returning one or storing it in another value would keep that reference after the call or loop ends.\nFix: return or store `copy(name)`.",
  },
  Explanation {
    code: "E0916",
    text: "A labeled `break` or `continue` names a loop around it, and no enclosing loop has this label.\nFix: correct the label, or put it on the loop, as in `outer: for (...)`.",
  },
  Explanation {
    code: "E0917",
    text: "Each label names one loop, so an inner loop cannot reuse the label of a loop around it.\nFix: give the inner loop another label.",
  },
  Explanation {
    code: "E0918",
    text: "Only a `for` or `while` loop can carry a label, because only loops are left with `break label` and `continue label`.\nFix: remove the label, or move it to a loop.",
  },
  Explanation {
    code: "E0920",
    text: "`Arrays.values(items)` and `Arrays.entries(items)` can only be the source of a `for ... of` loop.\nFix: anywhere else, pass `items` itself, as in `Arrays.length(items)`.",
  },
  Explanation {
    code: "E0921",
    text: "A local whose value is never read is dead code or a mistake. A name that starts with `_` is exempt.\nFix: remove the local, or rename it to `_name` when it is unused on purpose. `narrac apply-fix` renames it.",
  },
  Explanation {
    code: "E0922",
    text: "A parameter whose value is never read is dead code or a mistake. A name that starts with `_` is exempt.\nFix: remove the parameter, or rename it to `_name` when a function type requires it. `narrac apply-fix` renames it.",
  },
  Explanation {
    code: "E0923",
    text: "Narra has no classes. Data goes in a struct and behavior in functions of the module.\nFix: `class A {}` becomes `struct A {}`.",
  },
  Explanation {
    code: "E0924",
    text: "Narra has no interfaces. Use a struct for a data shape and a trait for behavior.\nFix: `interface A {}` becomes `struct A {}`.",
  },
  Explanation {
    code: "E0925",
    text: "Narra has no `new`. A struct is built with a literal, other values with a function call.\nFix: `new A()` becomes `A {}` when A is a struct without fields.",
  },
  Explanation {
    code: "E0926",
    text: "Narra has no exceptions. A function that can fail returns `Result<T, E>`; the caller checks it with `is Err` or `match`.",
  },
  Explanation {
    code: "E0927",
    text: "Narra has no `throw`. Return `Err(value)` from a function that returns a Result.\nFix: `throw \"x\"` becomes `return Err(\"x\")`.",
  },
  Explanation {
    code: "E0928",
    text: "Narra has no `this`. A function gets the value as a parameter.",
  },
  Explanation {
    code: "E0929",
    text: "A call that takes a name as `mutable` may change it, so the rest of the same expression cannot read or pass that name.\nFix: read what you need into a local first, then make the call. `narrac apply-fix` does this when it can.\nExample: `const total = x.n + bump(mutable x)` becomes `const before = x.n` and `const total = before + bump(mutable x)`.",
  },
  Explanation {
    code: "E0930",
    text: "Narra has no function declarations inside a function. Declare the function at module level as a private function and pass the enclosing values as arguments.\nThere is no automatic fix: moving it changes the meaning when its body reads a name that a local shadows, and breaks helpers that use the enclosing type parameters.\nFor a helper that captures, bind an arrow function: `const helper = (x: int): int => x + offset`.\nExample: `function run() { function add(a: int): int { return a + 1 } }` becomes `function add(a: int): int { return a + 1 }` followed by `function run() { ... }`.",
  },
  Explanation {
    code: "E0931",
    text: "A block expression gives its value with `return`, so every path through it ends in `return value`. A bare `return` gives no value.\nFix: end each path with `return value`, also after an `if` without an `else`.",
  },
  Explanation {
    code: "E0932",
    text: "`break` and `continue` cannot jump from a block expression to a loop outside it. A loop inside the block can still be left.\nFix: move the `break` or `continue` out of the block expression, into the loop body.",
  },
  Explanation {
    code: "E0933",
    text: "A `{ ... }` in value position is a block expression, and it gives its value with `return`. `{ a }` does not build a value from `a`.\nFix: write a struct literal, such as `Point { x: 1 }`, or end the block with `return value`.",
  },
  Explanation {
    code: "E0934",
    text: "A conditional expression is `cond ? a : b`. It needs the `:` and both values, and its value must be used. A line that starts with `?` or `:` begins a new statement, so a conditional expression that spans lines is wrapped in parentheses.\nFix: write `(cond ? a : b)` across lines, and an `if` statement when no value is used.",
  },
  Explanation {
    code: "E0940",
    text: "`from` converts only when every value of the source type fits the target type. `u32` to `i32` and `i8` to `u8` can lose a value.\nFix: call `tryFrom`, which returns an Option, or `wrap`, which keeps the low bits, as in `I32.tryFrom(big)`.",
  },
  Explanation {
    code: "E0941",
    text: "The integer conversion functions, such as `I32.from` and `U8.wrap`, take an integer. `F32.from` and `Float.from` also take the other float type.\nFix: pass an integer. Parse a string into a number first.",
  },
  Explanation {
    code: "E0946",
    text: "An import that nothing uses is dead code. A name that starts with `_` is exempt.\nFix: remove the import, or the unused name from it. `narrac apply-fix` removes it.",
  },
  Explanation {
    code: "E0947",
    text: "A private function that nothing calls is dead code. A name that starts with `_` is exempt.\nFix: remove the function, export it, or rename it to `_name`. `narrac apply-fix` renames it.",
  },
  Explanation {
    code: "E0948",
    text: "`mutable` lets a function change the contents of the caller's value in place. Only a struct, Array, Map, Box, StringBuilder or Generator has such contents. An int, a string or an enum has none.\nFix: take the value as a plain parameter and return the new value.",
  },
  Explanation {
    code: "E0949",
    text: "A `mutable` parameter lets the function change the fields and elements of the caller's value. It cannot replace the whole value.\nFix: assign the fields one by one, as in `p.x = 0`, or return the new value and let the caller assign it.",
  },
  Explanation {
    code: "E0950",
    text: "A `const` loop element, a name bound by a pattern and a destructured name each hold a copy. A change to the copy would not reach the original, so it is an error.\nFix: loop with `for (mutable item of items)`, write through the source, as in `items[index].x = 2`, or change a `copy(item)` held in a `let`.",
  },
  Explanation {
    code: "E0951",
    text: "A closure that is stored, returned or passed to an `escaping` parameter captures a copy of each value. A change it makes would not reach the captured variable, so it is an error.\nFix: pass the arrow function straight to a parameter that is not `escaping`, or keep the changing state in a Cell from std/cell.",
  },
  Explanation {
    code: "E0952",
    text: "A trait function that takes `mutable Self` changes the value in place. Only a struct, Array, Map, Box, StringBuilder or Generator has contents that change in place, so other types cannot implement the trait.\nFix: implement the trait for a struct that holds the value.",
  },
  Explanation {
    code: "E0954",
    text: "`for (mutable item of items)` changes the elements of an Array in place. The source must be an Array held in a variable, a field or an element. The index form `#[index, mutable item]` takes `Arrays.entries(items)` as its source, and `Arrays.entries` takes only that form.\nFix: write `for (mutable item of items)`, or `for (const #[index, mutable item] of Arrays.entries(items))`. Store a computed array in a local first.",
  },
  Explanation {
    code: "E0955",
    text: "`for (mutable ...)` changes the contents of each element. Ints, strings, enums and other plain values have no contents to change in place.\nFix: assign through an index, as in `for (let index = 0; index < Arrays.length(items); index++) { items[index] = items[index] + 1 }`.",
  },
  Explanation {
    code: "E0956",
    text: "While `for (mutable item of items)` runs, the loop element is the only way to reach the elements of `items`. Any other use of `items` in the body is an error.\nFix: reach the element through the loop element, or write an index loop.",
  },
  Explanation {
    code: "E0957",
    text: "`for (mutable ...)` is not supported in a `function*` body yet.\nFix: change the elements through an index, as in `items[index].field = value`.",
  },
  Explanation {
    code: "E0958",
    text: "A `for (mutable item of items)` element can change its fields and elements, but it cannot be replaced whole.\nFix: assign the fields, or write an index loop and assign `items[index] = value`.",
  },
  Explanation {
    code: "E0959",
    text: "The condition of a `for` loop must be a `bool`. A number or a string is not a condition.\nFix: write a comparison, as in `i < count`.",
  },
  Explanation {
    code: "E0960",
    text: "The step of a three-part `for` loop changes the counter, so the counter is declared with `let`.\nFix: `for (const i = 0; i < n; i++)` becomes `for (let i = 0; i < n; i++)`.",
  },
  Explanation {
    code: "E0961",
    text: "The last part of a three-part `for` loop runs after each pass, so it must change something: an assignment, `i++` or a call.\nFix: `i + 1` becomes `i++` or `i += 1`.",
  },
  Explanation {
    code: "E0962",
    text: "A compound assignment needs a value of the same type as its target, with no conversion. `+=` works on numbers and strings, `-=`, `*=`, `/=` and `%=` on numbers, and the bit and shift operators on integers.\nFix: convert the value to the target's type first, or use the operator the type supports.",
  },
  Explanation {
    code: "E0963",
    text: "`++` and `--` add or subtract 1 from an integer variable.\nFix: for a float, write `x += 1.0`.",
  },
  Explanation {
    code: "E0964",
    text: "`+=`, `++` and the other compound assignments are statements. They have no value, so they cannot be part of an expression. There is no prefix `++x`.\nFix: write `x++` on its own line, then use `x`.",
  },
  Explanation {
    code: "E0965",
    text: "A Cell is shared by identity: every copy reads and writes the same slot. `==` would compare the slots, not the values.\nFix: compare the values, as in `Cells.get(a) == Cells.get(b)`.",
  },
  Explanation {
    code: "E0967",
    text: "The arm body runs whichever alternative of an or-pattern matched, so every alternative binds the same names.\nFix: bind the name in each alternative, as in `Shape.Circle(size) | Shape.Square(size) => size`, or split them into separate arms.",
  },
  Explanation {
    code: "E0968",
    text: "A name bound in several alternatives must have the same type in each, so the arm body sees one type.\nFix: split the alternatives into separate arms.",
  },
  Explanation {
    code: "E0969",
    text: "A function with a result type must end every path with `return value`. The message names a path that can reach the end without one.\nFix: add a `return` on that path, such as an `else` branch or a final `return` after the `if`.",
  },
  Explanation {
    code: "E0970",
    text: "An arrow function with a result type must end every path with `return value`. The message names a path that can reach the end without one.\nFix: add a `return` on that path, such as an `else` branch or a final `return` after the `if`.",
  },
  Explanation {
    code: "E0971",
    text: "Binding a struct, Array, Map, FixedArray, Box, StringBuilder or generator to a second bare name would name one value twice. A write through one name would not show in the other.\nFix: use the original name, or `copy(name)` for a value of its own. `narrac apply-fix` adds the copy.",
  },
  Explanation {
    code: "E0972",
    text: "A type alias is another name for a type, so it cannot contain itself.\nFix: declare an enum for a recursive type.",
  },
  Explanation {
    code: "E0973",
    text: "A generic type alias takes one type argument for each type parameter it declares.\nFix: give the right number of type arguments, as in `Pair<int>` for `type Pair<T> = Array<T>`.",
  },
  Explanation {
    code: "E0974",
    text: "An alternative that the earlier arms and alternatives already match never runs. An `is` test and a destructuring take one pattern, not alternatives.\nFix: remove the unreachable alternative. To test several patterns, use `match`.",
  },
  Explanation {
    code: "E0975",
    text: "`copy` takes one value whose contents can change in place, such as a struct or an Array, and returns a copy of its own. A value that never changes in place, such as an int or a string, needs no copy. `copy` never changes its argument.\nFix: remove the call, or remove `mutable` from the argument. `narrac apply-fix` removes the call.",
  },
  Explanation {
    code: "E0976",
    text: "A function whose result shares a parameter says so with `from` after the result type, so callers see it in the signature. A result that shares a parameter without the marker, and a `from` that names no parameter, are errors.\nFix: add `from name`, as in `function cells(row: Row): Array<int> from row`, or return `copy(value)`. `narrac apply-fix` does this.",
  },
  Explanation {
    code: "E0977",
    text: "A function whose result shares a parameter fits a function type only when that type also names the parameter with `from`.\nFix: add `from` to the expected function type, as in `(grid: Grid) => Array<int> from grid`. `narrac apply-fix` adds it.",
  },
  Explanation {
    code: "E0978",
    text: "While another name that is still used shares a place, a write to that place is an error. The write would copy the value, and the other name would not see the change. Sharing starts where a value is read into a second name and ends after that name's last use.\nFix: write after the last use of the other name, or take `copy(...)` where a separate value is meant.",
  },
  Explanation {
    code: "E0979",
    text: "Integer `/` and `%` compile only when the divisor is proven not to be zero. It must be a non-zero constant, or a local checked first in the same function.\nFix: check the divisor, as in `if (count != 0) { return total / count }`.",
  },
  Explanation {
    code: "E0980",
    text: "A shift count must be proven in range. It must be a constant from 0 to the bit width minus 1, or a local checked against both ends first.\nFix: check the count, as in `if (n >= 0 && n < 64) { return 1 << n }`, or use a constant in range.",
  },
  Explanation {
    code: "E0981",
    text: "`typeof name` takes the type of a declaration, so it cannot name the declaration it is part of, directly or through a cycle.\nFix: write the type out, as in `const count: int = 1`.",
  },
  Explanation {
    code: "E0982",
    text: "`typeof` takes the type of a value: a const, let, parameter or function. A type or a module is not a value. A generic function, one with effect variables, one with a `mutable` parameter and one with `requires` have no function type to write.\nFix: write the type itself, or name a value.",
  },
  Explanation {
    code: "E0983",
    text: "An arm that the unguarded arms before it already match never runs, such as an arm after `_` or a repeated constructor.\nFix: remove the arm, or move it before the arm that covers it. `narrac apply-fix` removes it.",
  },
  Explanation {
    code: "E0984",
    text: "A `requires` condition compares integer parameters with integer constants or with each other, joined by `&&` and `||`. It needs a function body, and a function of an implement block cannot have one, because a call through the trait cannot prove it.\nFix: rewrite the condition in that form, as in `requires index >= 0 && index < 64`.",
  },
  Explanation {
    code: "E0985",
    text: "Each call of a function with `requires` proves the condition from its arguments. An argument proves it when it is a constant, or a name checked first by an `if`, a `while` or an early return.\nFix: check the argument before the call, as in `if (n >= 0) { return slot(n) }`.",
  },
  Explanation {
    code: "E0986",
    text: "A function type carries no condition, so a call through a function value could pass an argument that was never proven. A function with `requires` cannot be used as a value.\nFix: call the function directly.",
  },
  Explanation {
    code: "E0987",
    text: "An `ensures` line is a pattern that every result must match. A comparison such as `>= 0` needs an integer place and an integer constant that fits its type. `ensures` needs a function body and a result, binds no names, and takes no array patterns.\nFix: write `_` for any value and a constant bound, as in `ensures Ok(> 0) | Err(_)`.",
  },
  Explanation {
    code: "E0988",
    text: "Every returned value is proven against each `ensures` line. A value is proven when it is a constant, a constructor or literal written in place, or a name narrowed by a check. The result of a call is not proven, and neither are the values of `yield*`.\nFix: check the value with an `if` before returning it, and yield each value of a `yield*` after a check.",
  },
  Explanation {
    code: "E0989",
    text: "std/build describes the target the program is built for, so the host must be one of the supported targets.\nFix: build on a supported host. `narrac targets` lists them.",
  },
  Explanation {
    code: "E0990",
    text: "The attributes are `@target`, `@trusted`, `@extern` and `@const`. Each is written once, on the lines before a function declaration, and an implement block allows only `@trusted`. `@target` takes `os`, `arch` or both, each a variant of `Os` or `Arch` from std/build.\nFix: use a known attribute in that place, as in `@target(os = Os.Windows)`.",
  },
  Explanation {
    code: "E0991",
    text: "A `@target` function exists only on its target, so a use must sit where only that target compiles it: inside an `if` on `Build.os` or `Build.arch` that the other targets drop, or inside a `@target` function with the same or a narrower target. An ordinary `if`, a `match` and an early `return` do not count.\n`narrac check` checks the host only; `narrac check --all-targets` checks every supported target.\nExample: `print(linuxName())` becomes `if (Build.os == Os.Linux) { print(linuxName()) }`.",
  },
  Explanation {
    code: "E0992",
    text: "A constant type parameter is written `const N: int` in the type parameters of a function or a struct. Its kind is `int`; enums, type aliases and other integer kinds do not take one. A type argument is a type, an integer literal or a constant parameter in scope; it never computes.\nExample: `Vector<N + 1>` is rejected; pass the length as its own constant parameter, `function grow<const N: int, const M: int>(vector: Vector<N>): Vector<M>`.",
  },
  Explanation {
    code: "E0993",
    text: "A constant parameter takes an integer literal or a constant parameter in scope, and a type parameter takes a type; the two do not mix. A local, a type or a top-level constant cannot stand for a constant parameter, and a constant cannot stand for a type.\nExample: `Vector<count>` becomes `Vector<3>`, and `value: N` becomes `value: int` with `N` read in the body.",
  },
  Explanation {
    code: "E0994",
    text: "Indexing a FixedArray has no runtime check, so every index is proven at compile time. A constant index must be from 0 to N - 1. Any other index must be a plain name that a check puts in that range: an `if` or `while` condition such as `i >= 0 && i < 4`, the condition of `for (let i = 0; i < N; i++)`, or `for (const i of Ranges.upTo(N))`. An assignment to the name ends what the check proved. `FixedArrays.get(values, i)` returns an Option for any index.\nExample: `values[i]` becomes `if (i >= 0 && i < 4) { use(values[i]) }`.",
  },
  Explanation {
    code: "E0995",
    text: "`FixedArray<T, N>` takes an element type and a length. The length is an integer literal or a constant type parameter, and never negative. One FixedArray value takes at most 1048576 bytes (1 MiB); use an Array for more. A literal builds a FixedArray when the expected type is one, and gives every element.\nExample: `const point: FixedArray<f64, 3> = [1.0, 2.0, 3.0]`.",
  },
  Explanation {
    code: "E0996",
    text: "A call of a std/ptr function or of a function with the unsafe effect may break memory safety, so it is allowed only inside an `unsafe { ... }` block. The function that holds the block gets the unsafe effect, unless it is marked `@trusted`.\nExample: `const value = Ptr.read(items)` becomes `let value = 0` followed by `unsafe { value = Ptr.read(items) }`.",
  },
  Explanation {
    code: "E0997",
    text: "`@trusted` states that a function's `unsafe` blocks were checked by hand, and stops the unsafe effect there: callers need no `unsafe` block. A function without an `unsafe` block has nothing to trust, and a `@trusted` function does not declare `uses unsafe`.\nExample: remove `@trusted` from a function that has no `unsafe` block.",
  },
  Explanation {
    code: "E0998",
    text: "A `Ptr<T>` is a raw pointer with no reference count. It may point at numbers, `bool`, `char`, another `Ptr` and structs whose fields are all such values, because a pointer to a string, array, map, box, enum or closure would bypass reference counting. The std/ptr functions take a `Ptr`; `Ptr.alloc`, `Ptr.null` and `Ptr.cast` take the element type from where the result goes.\nExample: `Ptr<string>` is rejected; `const items: Ptr<int> = Ptr.alloc(4)` works.",
  },
  Explanation {
    code: "E1000",
    text: "C functions are declared in a block that names their library: `extern { function sqrt(value: f64): f64 } from \"m\"`. A member is a signature with no type parameters, no `uses` and no body; it has the unsafe effect. Only `@extern(\"name\")` may stand before a member. The libraries come from `from`, so `[link]` in narra.toml takes only `search`.\nExample: `[link] libraries = [\"m\"]` is removed; write `from \"m\"` after the extern block.",
  },
  Explanation {
    code: "E1001",
    text: "A C function is linked by its C name, the member's name or the one `@extern` gives. That name must be a C identifier and must not be one the compiler writes itself: `main`, names starting with `narra_` or `lstr_`, string literal names such as `L1`, and the generated names of the program's functions and types, alone or with a helper's operation before or a suffix after (`release_E_Option_e088c655`).\nExample: `@extern(\"narra_alloc\")` is rejected; call the C function by its own name.",
  },
  Explanation {
    code: "E1002",
    text: "A C function takes and returns values C can pass: the number types, `bool` and `Ptr<T>`, and may return nothing. Strings, arrays and other counted values have no C form; pass a `Ptr<u8>`, for a string `CStrings.pointer` of a CString.\nExample: `function strlen(text: string): u64` becomes `function strlen(text: Ptr<u8>): u64`.",
  },
  Explanation {
    code: "E1003",
    text: "`typeof` of a constant needs the constant's type, and a constant without a written type has its type only after its value is checked. In a declaration of the same module (a signature, a field, an alias) that type is not known yet, so write it.\nExample: `const limit = 3` becomes `const limit: int = 3`.",
  },
  Explanation {
    code: "E1004",
    text: "The compiler tracks a position as a line and a column below 1048576 each. A token past either limit is rejected, since it would share a record with another position. Split the file, or break the long line.",
  },
  Explanation {
    code: "E1010",
    text: "A tuple element is read with a constant index, `pair[0]`, so the read is a field read and cannot fail. An index that is a `let`, a parameter or any other computed value is rejected, because the element type would depend on it. A top-level `const` works. To read every element, destructure the tuple.\nExample: `pair[count]` becomes `const #[first, second] = pair`.",
  },
  Explanation {
    code: "E1011",
    text: "A tuple has a fixed number of elements, and a constant index must name one of them, counting from 0. Tuple elements are read-only, so `pair[0] = 2` is E0226.\nExample: for `#[int, string]`, the indexes are 0 and 1; `pair[2]` and `pair[-1]` are rejected.",
  },
  Explanation {
    code: "E1012",
    text: "A distinct type has the representation of its base type, so a derived trait is the base type's: `distinct type UserId = int derives Show` prints as an int. The derive needs the base type to implement the trait.\nExample: `distinct type Handle = Ptr<int> derives Show` is rejected, since a pointer has no Show; write an `implement Show for Handle` block and list `implements Show`.",
  },
  Explanation {
    code: "E1013",
    text: "A standard function is a value when its signature is fixed: `Int.toString`, `Str.length`, `Fs.readText`. A function whose types depend on the call (`Arrays.length`, `Maps.size`), one with a `mutable` parameter and one that takes a function argument have no single signature, so they are not values.\nExample: write the arrow function `(items) => Arrays.length(items)` instead of `Arrays.length`.",
  },
  Explanation {
    code: "E1014",
    text: "`==`, `!=` and map keys on a distinct type compare and hash the base value, so an `implement Equatable` or `implement Hashable` block for it would never run and is rejected. Write the comparison as a function of the declaring module, or wrap the value in a struct.\nExample: `implement Equatable for UserId` is rejected for `distinct type UserId = int`.",
  },
  Explanation {
    code: "E1020",
    text: "A struct or enum can require traits of its type parameters, as in `struct Labeled<T: Show>`. Every use of the type with arguments must meet them: a written type, a struct literal and an enum constructor. A type parameter of the enclosing function or type meets a constraint only when it declares the same trait; constraints are not implied.\nExample: `function first<T>(pair: Labeled<T>)` is rejected; write `function first<T: Show>(pair: Labeled<T>)`.",
  },
  Explanation {
    code: "E1021",
    text: "An implement block for a generic struct or enum names the type with the type parameters of its declaration, by the same names and in the same order. The block adds no constraints of its own: the members see the constraints the declaration gives, and the block holds for every instance.\nExample: for `struct Pair<T>`, `implement Show for Pair<int>` and `implement Show for Pair` are rejected; write `implement Show for Pair<T>`.",
  },
  Explanation {
    code: "E1022",
    text: "`Dynamic<Trait>` holds a value of any type that implements one trait, so its one type argument is a trait name. `Dynamic<int>`, `Dynamic` alone and `Dynamic<Show, Ordered>` are rejected.\nExample: write `Dynamic<Show>`.",
  },
  Explanation {
    code: "E1023",
    text: "A call through a `Dynamic<Trait>` passes the Dynamic where the trait writes `Self`, and the table of the stored type does the rest. That works only when every function of the trait takes `Self` as its first parameter, once and not inside another type, and mentions `Self` nowhere else, the result included. `Equatable` and `Ordered` take two values, and `Shape.fromValue` returns `Self`.\nExample: `trait Drawable { function draw(value: Self): string }` can be used as `Dynamic<Drawable>`.",
  },
  Explanation {
    code: "E1024",
    text: "`Dynamic.of(value)` takes the trait from the expected type: an annotation, a parameter type, a field type or a result type. It takes one value and is the only function of `Dynamic`.\nExample: `const item: Dynamic<Show> = Dynamic.of(42)`.",
  },
  Explanation {
    code: "E1025",
    text: "Every copy of a Dynamic shares one stored value, so a trait function that takes `mutable value: Self` cannot be called through a Dynamic: the change would reach the other copies.\nExample: call the function on the concrete value before wrapping it with `Dynamic.of`.",
  },
  Explanation {
    code: "E1050",
    text: "The compiler runs an @const function while it compiles and writes the result into the C, so its parameters and result hold only values the compiler can build and write: numbers, bool, char, string, bytes, Array, Map, FixedArray, Option, Result, tuples, and structs, enums and distinct types made of these. A function value, Cell, Ptr, Shared, a generator, a trait-constrained type parameter or an effect parameter has no compile-time value.\nFix: remove @const, or change the signature.",
  },
  Explanation {
    code: "E1051",
    text: "An @const function runs inside the compiler, where nothing outside it can observe what it does. It may allocate, and nothing else: no io and no unsafe code.\nFix: move the effect out of the function, or remove @const.",
  },
  Explanation {
    code: "E1052",
    text: "An @const function calls other @const functions, constructors and the std functions of std/string, std/array, std/map, std/int, std/float, std/range, std/char, std/option, std/result, std/regex, std/math, std/bytes, std/fixedarray, std/f32 and the sized number modules that take no function. It cannot use an arrow function, call through a function value or run a user implement block (through ==, a map key or a direct call).\nFix: mark the called function @const, compute the value another way, or remove @const.",
  },
  Explanation {
    code: "E1053",
    text: "The compiler computes a constant that calls an @const function while it compiles. A panic, a failed assert, an index out of range or a std function that would panic stops the computation, and the error shows the chain of calls from the constant to where it stopped.\nFix: change the arguments or the function so it does not panic.",
  },
  Explanation {
    code: "E1054",
    text: "A constant may take 10 million evaluation steps (one per expression, statement and loop turn, plus one per 8 bytes or elements a std call goes through), so a mistake such as an endless loop cannot hang the compiler.\nFix: compute a table this large at run time in a function, or generate a source file; for Regexes.checked, compile the pattern at run time with Regexes.compile.",
  },
  Explanation {
    code: "E1055",
    text: "The values a constant builds while it is computed may take 64 MiB, counted as 8 bytes per number, element, field and entry, string lengths rounded up to 8, and 16 per array and map; `copy(...)` and storing a value read from a place count its outer level again. A std call whose result would pass the limit is stopped before it runs.\nFix: compute a table this large at run time in a function, or generate a source file; for Regexes.checked, compile the pattern at run time with Regexes.compile.",
  },
  Explanation {
    code: "E1056",
    text: "A constant may make 1000 nested calls while it is computed, nest calls, blocks, loops and expressions 5000 deep, and build values nested 1000 levels deep, which keeps the compiler stack safe. A function that calls itself as its last step (`return f(...)`) runs as a loop and does not count.\nFix: write the recursion as a loop or as a tail call.",
  },
  Explanation {
    code: "E1057",
    text: "An @const function may read top-level constants. A constant whose computation reads the constant itself has no value to start from.\nFix: break the cycle, for example by passing the value as an argument.",
  },
  Explanation {
    code: "E1100",
    text: "`await` waits for a task, so it can stand only where the body is itself a task: an async function, an async arrow or an async block. A `function*` body and an arrow that is not async are bodies of their own, also inside an async body.\nFix: make the function or arrow async, or pass the handle on and await it in an async body.",
  },
  Explanation {
    code: "E1102",
    text: "`await` takes the handle of a task, an Async<T>, and gives its value.\nFix: await the call that returns the handle, or use the value without await.",
  },
  Explanation {
    code: "E1103",
    text: "A call of an async function, an async arrow or an `async { ... }` block starts a task and gives its handle. A handle that nobody uses hides a task that keeps running; `const _ =` does not let it go.\nFix: await the handle, keep it in a name, pass it on, or call Async.detach(handle) to let the task run with nobody waiting.",
  },
  Explanation {
    code: "E1104",
    text: "A task outlives the call that starts it, so it cannot keep a pointer into the caller's variable.\nFix: take the value as a plain parameter and return the new value from the task.",
  },
  Explanation {
    code: "E1105",
    text: "A `for (mutable ...)` loop holds a pointer to the element it changes, which cannot be kept in a task frame across an await. `for await (mutable ...)` is rejected too: the values of a stream are not elements of a place.\nFix: change the elements through an index; read a stream with `for await (const x of stream)`.",
  },
  Explanation {
    code: "E1106",
    text: "A handle is an identity type: copies share one task, so == and a map key would compare tasks, not values.\nFix: await the handles and compare or key by the values.",
  },
  Explanation {
    code: "E1108",
    text: "`async` starts an async function, an async arrow or an async block.\nFix: write `async function`, `async (x) => ...` or `async { ... }`.",
  },
  Explanation {
    code: "E1109",
    text: "Async<T> takes the type of the task's value as its one type argument.\nFix: write Async<T>, with Async<void> for a task that gives no value.",
  },
  Explanation {
    code: "E1110",
    text: "An async arrow or block copies what it captures when its task starts, so a `let`, a `mutable` parameter or a captured value it changes would no longer be shared with the code around it.\nFix: keep state that changes in a Cell from std/cell, or pass the value in and return the new one.",
  },
  Explanation {
    code: "E1111",
    text: "An async function keeps its parameters in its task, which outlives the call, so a function parameter must be one that may be stored.\nFix: declare the parameter as `escaping`.",
  },
  Explanation {
    code: "E1112",
    text: "An `async function*` produces a stream of values that may wait between them, read with `Async.next` or `for await`. Its result names that stream, with the effects of the body on it.\nFix: write the result as `AsyncGenerator<T>`, as in `async function* lines(): AsyncGenerator<string> uses io`.",
  },
  Explanation {
    code: "E1113",
    text: "An AsyncGenerator<T> body may wait between its values, so only an async generator can return one from its own body. A plain or async function may still return a stream it got elsewhere.\nFix: write `async function*`, or return a Generator<T>.",
  },
  Explanation {
    code: "E1114",
    text: "AsyncGenerator<T> takes the type of the values the stream yields as its one type argument.\nFix: write AsyncGenerator<T>.",
  },
  Explanation {
    code: "E1115",
    text: "An async generator yields values to its readers and gets nothing back: there is no async coroutine.\nFix: write `yield value` as a statement, and pass input to the stream through its arguments or a Cell.",
  },
  Explanation {
    code: "E1116",
    text: "`yield*` in an async generator passes on every value of another AsyncGenerator<T> with the same T, one per step of the outer stream.\nFix: delegate to an AsyncGenerator<T>; for a Generator<T>, write `for (const x of g) { yield x }`.",
  },
  Explanation {
    code: "E1122",
    text: "`for await` waits for each value of a stream, so it can stand only where the body is itself a task: an async function, an async arrow, an async block or an async generator. A `function*` body and an arrow that is not async are bodies of their own, also inside an async body.\nFix: make the function or arrow async, or read the stream with Async.next in an async body.",
  },
  Explanation {
    code: "E1123",
    text: "`for await` reads an AsyncGenerator<T>, the stream an `async function*` gives, one step at a time.\nFix: for a Generator<T> or an array, write `for (const x of items)`, which works in an async body; for an Array<Async<T>>, loop over the handles and `await` each one.",
  },
  Explanation {
    code: "E1124",
    text: "The values of an AsyncGenerator<T> may wait, so a plain `for ... of` cannot read them.\nFix: write `for await (const x of stream)` in an async body, or read one step with `await Async.next(stream)`.",
  },
  Explanation {
    code: "E1150",
    text: "An Async<void> handle binds the type parameter of its Async<T> to void. A generic function whose signature also uses that parameter as a value, such as Async.peek (Option<T>), Async.all (Array<T>) or Async.race (Option<T>), would need a void value, which does not exist.\nFix: await the handles one by one, or give the task a value, such as a bool.",
  },
  Explanation {
    code: "E1190",
    text: "A value that crosses to another thread (a capture or the result of a thread function, the items of Parallel.map) must be Sendable. Sendable is automatic: a type is Sendable when nothing in it, at any depth, is a function, a Dynamic, a Ptr, a Cell, an Async, a generator or coroutine, a Scope, a Thread or a socket handle. These hold state that one thread changes in place without a lock.\nFix: share changing state through Shared from std/shared, send plain data, and declare a type parameter that crosses as <T: Sendable>.",
  },
  Explanation {
    code: "E1191",
    text: "A Scope joins its threads when its Thread.scope returns, so it must not outlive that call. It can be passed to functions, but not stored in a field, element, tuple or constructor, returned, captured by an escaping closure such as a thread function, or kept in the frame of a generator, coroutine, stream or task (a parameter or a capture), which can run after Thread.scope returns.\nFix: pass the Scope as a parameter to the function that starts threads, or open a new Thread.scope where it is needed.",
  },
  Explanation {
    code: "E1192",
    text: "Thread.start calls its function and keeps what it returns. An async function returns an Async handle, which belongs to the event loop of the thread that made it. Thread.startAsync runs the task on the new thread's own event loop and keeps the value the task gives.\nFix: write `Thread.startAsync(scope, async () => work())`, or pass a plain function to Thread.start.",
  },
  Explanation {
    code: "E1193",
    text: "The checker must see what a thread function captures, and a function value does not show its captures in its type. So the function passed to Thread.start or Parallel.map is an arrow function written at the call or the name of a top-level function.\nFix: write the arrow at the call, as in `Thread.start(scope, () => work(input))`.",
  },
  Explanation {
    code: "E1194",
    text: "Sendable is only automatic: the compiler implements it for every type whose parts can cross a thread, so a type cannot list, derive or implement it.\nFix: remove the `implement Sendable`, `implements Sendable` or `derives Sendable`.",
  },
  Explanation {
    code: "E1195",
    text: "A Thread, a Scope, a Sender, a Receiver, a Shared or an Atomic is a handle shared by identity, so `==`, `!=` and map keys on it are errors, as for a Cell and an Async.\nFix: compare the values the handles give, for example the results of Thread.join or Shared.get.",
  },
  Explanation {
    code: "E1200",
    text: "A template right after a name is a tagged template: `tag`a${x}b`` calls `tag([\"a\", \"b\"], [x])`. Only a name or a dotted name can be the tag, so the function called is named where it is used.\nFix: put the tag in a constant first (`const tag = make()`, then `tag`...``), or write a space-free name before the template.",
  },
  Explanation {
    code: "E1201",
    text: "A tag is a function of two parameters: the parts, `Array<string>` (escapes decoded) or `Template.Raw` from std/template (the source text), and the values, `Array<T>`. Neither parameter can be `mutable`.\nFix: give the tag that signature, for example `function tag(parts: Array<string>, values: Array<string>): string`.",
  },
  Explanation {
    code: "E1202",
    text: "Every `${}` value of a tagged template has the tag's value type T, the element type of its second parameter. A generic tag takes T from the first value.\nFix: convert the value inside the `${}`, for example `${Int.toString(count)}`.",
  },
  Explanation {
    code: "E1203",
    text: "A line break ends the statement, so a template at the start of a line is not tagged by the name at the end of the line before.\nFix: write the tag and the template on one line, `const x = tag`a``, or remove the template.",
  },
  Explanation {
    code: "E1210",
    text: "Parameters with defaults come last, so a call can leave them out from the end.\nFix: give the parameter a default, or move it before the first parameter with one.",
  },
  Explanation {
    code: "E1211",
    text: "A `mutable` parameter refers to a value that the caller passes, so it cannot have a default.\nFix: remove the default.",
  },
  Explanation {
    code: "E1212",
    text: "A parameter default is a compile-time constant: a literal, a unary operator on a constant, a constructor with constant arguments, or an array of constants. It cannot read another parameter, a local, a top-level constant or a function.\nFix: write the value as a literal, or take `Option<T> = None` and compute the value in the body.",
  },
  Explanation {
    code: "E1213",
    text: "Only declared functions take parameter defaults. An arrow function parameter and a function type parameter have none.\nFix: remove the default and pass the value at each call.",
  },
  Explanation {
    code: "E1214",
    text: "A trait function and the functions of its implement blocks cannot have parameter defaults.\nFix: remove the default and pass the value at each call.",
  },
  Explanation {
    code: "E1215",
    text: "The functions of an `extern` block cannot have parameter defaults.\nFix: remove the default and pass the value at each call.",
  },
  Explanation {
    code: "E1216",
    text: "An optional parameter is written with a default, not with `?`. An arrow function parameter cannot be optional.\nFix: `name?: string` becomes `name: Option<string> = None`. In an arrow function, write `name: Option<string>`.",
  },
  Explanation {
    code: "E1220",
    text: "A distinct type takes one `requires` list of patterns joined by `&&`, after its `implements` and `derives` lists.\nFix: write it as in `distinct type Port = int derives Show requires >= 1 && <= 65535`.",
  },
  Explanation {
    code: "E1221",
    text: "Only a distinct type over an integer type or `string` can have a `requires` list.\nFix: remove the list, or base the type on an integer type or `string`.",
  },
  Explanation {
    code: "E1222",
    text: "The patterns of a distinct type's `requires` fit its base. An integer base takes comparisons with a constant bound that fits the type, and integer literals. A `string` base takes string literals only.\nFix: write patterns such as `>= 1 && <= 65535` or `\"GET\" | \"POST\"`.",
  },
  Explanation {
    code: "E1223",
    text: "`T.from(value)` is proven at compile time against the type's `requires` patterns. Nothing is checked at run time.\nFix: pass a constant that matches, check the value first with an `if`, or call `T.check(value)`, which returns an Option and tests at run time.",
  },
  Explanation {
    code: "E1240",
    text: "In a type, `uses` takes one effect, or a comma list in parentheses: `() => int uses io`, `Generator<int> uses (io, alloc)`. A `,` after the one effect ends the type, so the type can stand in a list of types or parameters. A function's own list, after its result type, is a bare comma list.\nFix: put the type's effects in parentheses, `Generator<string> uses (io, alloc)`. A function that makes a generator writes its own list after it: `(): Generator<string> uses (io, alloc) uses alloc`.",
  },
  Explanation {
    code: "E1241",
    text: "`io`, `alloc`, `unsafe` and effect variables name effects, which only a `uses` list holds; they are not types. In a list of types such as `Map<Generator<int> uses io, alloc>`, the `,` ends the generator's one effect, so `alloc` stands where a type belongs.\nFix: write the effects in parentheses, `Map<Generator<int> uses (io, alloc), int>`, or move the name into a `uses` list.",
  },
  Explanation {
    code: "E1242",
    text: "A `uses` list names each effect once, in a type and in a function's own list.\nFix: delete the repeated name: `uses (io, io)` in a type and `uses io, io` on a function both become `uses io`.",
  },
  Explanation {
    code: "E1250",
    text: "Vector operators work lane by lane, and some have no lane form. These are `<` and the other ordered comparisons, integer `/` and `%`, `<<` and `>>`, and the bit operators on float lanes.\nFix: call the std/simd function the message names, such as `Simd.shiftLeft`.",
  },
  Explanation {
    code: "E1251",
    text: "Both operands of a vector operator have the same vector type. A scalar is not a vector.\nFix: `v * 2.0` becomes `v * Simd.splat(2.0)`.",
  },
  Explanation {
    code: "E1252",
    text: "A vector is a value, so one lane cannot be assigned.\nFix: `v[i] = x` becomes `v = Simd.withLane(v, i, x)`.",
  },
  Explanation {
    code: "E1253",
    text: "An array literal for a vector gives exactly one value per lane.\nFix: give as many values as the vector has lanes, as in `const unit: F32x4 = [1.0, 0.0, 0.0, 0.0]`.",
  },
  Explanation {
    code: "E1254",
    text: "`Simd.splat` and `Simd.load` cannot tell from their arguments which vector type to build.\nFix: annotate the target, as in `const ones: F32x4 = Simd.splat(1.0)`, or pass a type argument, as in `Simd.splat<F32x4>(1.0)`.",
  },
  Explanation {
    code: "E1255",
    text: "A vector holds 16 or 32 bytes of i8 to u64, f32 or f64 lanes. `Simd.fromFixed` needs a FixedArray of known length whose element type and length make such a vector.\nFix: pass a matching FixedArray, such as `FixedArray<f32, 4>` for F32x4.",
  },
  Explanation {
    code: "E1256",
    text: "This std/simd function takes a vector, such as an F32x4, and the value passed is not one.\nFix: pass a vector, or build one with `Simd.splat`.",
  },
  Explanation {
    code: "E1260",
    text: "`Simd.shuffle` takes the lane order as a list literal of constants, one per lane, each a lane of the vector.\nFix: write it as in `Simd.shuffle(v, [3, 2, 1, 0])`.",
  },
  Explanation {
    code: "E1261",
    text: "Some std/simd functions take only some vector types: integer vectors only, or signed and float vectors only. A mask must match the vector, and a store writes into an Array of the lane type.\nFix: pass the vector, mask or array type that the message names.",
  },
  Explanation {
    code: "E1270",
    text: "`Ranges.stepped` with a step of 0 never produces a value.\nFix: use a positive step to count up, or a negative step to count down.",
  },
  Explanation {
    code: "E1360",
    text: "Regexes.checked compiles its pattern while the compiler runs, so a bad pattern is a compile error (E1053) instead of a panic. That works only where the compiler computes the value: the value of a top-level const. Anywhere else, including a function body or a use as a function value, the call would run in the program and could panic.\nFix: move the call into a top-level const, or call Regexes.compile and handle its RegexError.",
  },
  Explanation {
    code: "E1410",
    text: "Shared.update and Shared.read hold the lock while their callback runs. An async callback would give an Async whose task runs later, after the lock is released, or suspend while other threads wait for the lock.\nFix: pass a plain function, and await the work before or after the call.",
  },
  Explanation {
    code: "E1411",
    text: "An Atomic<T> uses the processor's atomic operations, which work on bool and the integer types up to 64 bits (int, i8 to i32, u8 to u64). A type parameter is not allowed either, since no bound says \"an integer type\".\nFix: use an integer type, or keep the value in a Shared from std/shared.",
  },
  Explanation {
    code: "E1412",
    text: "Atomic.add adds to an integer. An Atomic<bool> has no sum.\nFix: use Atomic.store, Atomic.exchange or Atomic.compareExchange to change a flag.",
  },
  Explanation {
    code: "E1500",
    text: "A statement after `return`, `break`, `continue`, a call to `panic` or `Process.exit`, an `if` and `else` that both leave, a `match` whose arms all leave, or a `while (true)` loop without a `break` never runs.\nFix: delete the statements from the first dead one to the end of the block, or move the code before the statement that leaves.",
  },
  Explanation {
    code: "E1510",
    text: "A `let` tells the reader that the name gets a new value later. A name that is never assigned, never changed with `+=` or `++`, and never has a field, an element or a `mutable` argument written is a `const`.\nFix: write `const` instead of `let`.",
  },
  Explanation {
    code: "E1600",
    text: "`--target` takes a name from the target table.\nFix: use one of the names in the message. `narrac targets` prints them.",
  },
  Explanation {
    code: "E1601",
    text: "The sanitizer runtimes do not link into a build for another target.\nFix: build without `-sanitize`, or build on the target itself.",
  },
  Explanation {
    code: "E1660",
    text: "A C file named by `from \"./file.c\"` or listed in `[c] sources` is not in the package folder, or a file named by `from \"<package>/<path>\"` is not in the C package.\nFix: create the file, or correct the path.",
  },
  Explanation {
    code: "E1661",
    text: "A C path of a package (`from \"./file.c\"`, `from \"<package>/<path>\"`, or `sources` and `include` in `[c]`) points outside the package folder, or outside the upstream checkout of a C package, through `..` or an absolute path.\nFix: keep the C files and folders inside the package.",
  },
  Explanation {
    code: "E1662",
    text: "The C compiler rejected a C file of a package. The message shows the first error line of the compiler.\nFix: correct the C file, then build again.",
  },
  Explanation {
    code: "E1663",
    text: "A `from \"<package>/<path>\"` names a file of a C package, but the package that writes it does not list that package in `[dependencies]`.\nFix: add the C package to `[dependencies]` of the package with the extern block.",
  },
  Explanation {
    code: "E1664",
    text: "A `from \"<package>/<path>\"` names a package that has no `[c]` table, so it has no C files to bind.\nFix: name a C package, a package whose `narra.toml` has a `[c]` table.",
  },
  Explanation {
    code: "E1665",
    text: "`git` and `tag` in `[c]` fetch the C files from an upstream repository. Only a package fetched as a dependency can have them: the package being built, and the members of a workspace, are not fetched.\nFix: remove `git` and `tag`, or build the package as a dependency of another one.",
  },
]

export function getCodeRows(): Array<CodeRow> {
  return CODE_ROWS
}

export function isKnownCode(code: string): bool {
  for (const row of Arrays.values(CODE_ROWS)) {
    if (row.code == code) {
      return true
    }
  }
  return false
}

function upperAscii(text: string): string uses alloc {
  let builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    const code = Char.code(character)
    let shown = character
    if (code >= 97 && code <= 122) {
      if (Char.fromCode(code - 32) is Some(upper)) {
        shown = upper
      }
    }
    Str.appendChar(mutable builder, shown)
  }
  return Str.build(builder)
}

export function explainCode(input: string): Result<string, string> uses alloc {
  // Codes are case-insensitive: `explain e0001` works like `explain E0001`.
  const code = upperAscii(input)
  let format = ""
  // A code with several formats prints the last one.
  for (const row of Arrays.values(CODE_ROWS)) {
    if (row.code == code) {
      format = row.format
    }
  }
  if (format == "") {
    return Err(`unknown diagnostic code ${quoteGo(code)}`)
  }
  let text = `${code}: ${format}\n`
  for (const explanation of Arrays.values(EXPLANATIONS)) {
    if (explanation.code == code) {
      text = `${text}\n${explanation.text}\n`
    }
  }
  return Ok(text)
}

export function writeCodeListJson(): string uses alloc {
  let entries: Array<string> = []
  let current = ""
  let messages: Array<string> = []
  for (const row of Arrays.values(CODE_ROWS)) {
    // A code with several formats has several rows, side by side.
    if (row.code != current) {
      if (current != "") {
        Arrays.push(mutable entries, writeCodeEntryJson(current, messages))
      }
      current = row.code
      messages = []
    }
    Arrays.push(mutable messages, quoteJson(row.format))
  }
  if (current != "") {
    Arrays.push(mutable entries, writeCodeEntryJson(current, messages))
  }
  return `[\n${Str.join(entries, ",\n")}\n]\n`
}

function writeCodeEntryJson(code: string, messages: Array<string>): string uses alloc {
  let explanation = "null"
  for (const candidate of Arrays.values(EXPLANATIONS)) {
    if (candidate.code == code) {
      explanation = quoteJson(candidate.text)
    }
  }
  return `{"code":${quoteJson(code)},"messages":[${Str.join(messages, ",")}],"explanation":${explanation}}`
}

function writePair(pos: Pos): string uses alloc {
  return `[${Int.toString(pos.line)},${Int.toString(pos.column)}]`
}

export function writeDiagnosticJson(
  file: string,
  pos: Pos,
  code: string,
  message: string,
  fixes: Array<Fix>,
): string uses alloc {
  // The range is empty (start equals end) because a diagnostic records a position, not an extent. Every edit names the file of the diagnostic.
  const pair = writePair(pos)
  let fixTexts: Array<string> = []
  for (const fix of Arrays.values(fixes)) {
    let editTexts: Array<string> = []
    for (const edit of Arrays.values(fix.edits)) {
      Arrays.push(
        mutable editTexts,
        `{"file":${quoteJson(file)},"range":{"start":${writePair(edit.start)},"end":${writePair(edit.end)}},"text":${quoteJson(edit.text)}}`,
      )
    }
    Arrays.push(
      mutable fixTexts,
      `{"title":${quoteJson(fix.title)},"edits":[${Str.join(editTexts, ",")}]}`,
    )
  }
  return `{"code":${quoteJson(code)},"severity":"error","message":${quoteJson(message)},"file":${quoteJson(file)},"range":{"start":${pair},"end":${pair}},"fixes":[${Str.join(fixTexts, ",")}]}`
}
