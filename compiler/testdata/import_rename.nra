import * as Int from "std/int"
import { length as count, values } from "std/array"
import { map as mapOption } from "std/option"
import { map as mapResult } from "std/result"

export function run(args: Array<string>): int {
  const xs = [1, 2, 3]
  const o = mapOption(Some(4), (x) => x + 1)
  const start: Result<int, string> = Ok(5)
  const r = mapResult(start, (x: int) => x * 2)
  print(`${Int.toString(count(xs))}`)
  match (o) {
    Some(v) => print(`${Int.toString(v)}`)
    None => print("none")
  }
  match (r) {
    Ok(v) => print(`${Int.toString(v)}`)
    Err(e) => print(e)
  }
  let total = 0
  for (const x of values(xs)) {
    total = total + x
  }
  print(`${Int.toString(total)}`)
  return 0
}
