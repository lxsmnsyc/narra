trait module="" std Equatable
  function equals
    param a Self
    param b Self
    result bool
trait module="" std Hashable
  function hash
    param value Self
    result int
trait module="" std Ordered
  function compare
    param a Self
    param b Self
    result Ordering
trait module="" std Show
  function show
    param value Self
    result string
type enum module="" Ordering
  variant Less
  variant Equal
  variant Greater
impl module="" derived Show Ordering
impl module="" derived Ordered Ordering
generic enum module="" params=T Option
  variant Some
    field value T
  variant None
impl module="" derived Show Option
impl module="" derived Ordered Option
generic enum module="" params=T,E Result
  variant Ok
    field value T
  variant Err
    field error E
impl module="" derived Show Result
impl module="" derived Ordered Result
type struct module="q/a" q/a.T
  field x int
module "q/a"
  scope type T q/a.T
type struct module="q/b" q/b.T
  field y string
module "q/b"
  scope type T q/b.T
func module="q/main" pick
  param t q/b.T
  result q/b.T
func module="q/main" run
  param args Array<string>
  result int
module "q/main"
  import "q/a" package alias=L
  import "q/b" package alias=L
  import "std/string" std alias=Str
  import "std/int" std alias=Str
  scope type StringBuilder StringBuilder
  scope func pick q/main.pick
  scope func run q/main.run
  scope alias L "q/b"
  scope alias Str "std/int"
entry "q" q/main.run
order module="" Ordering
order module="q/a" q/a.T
order module="q/b" q/b.T
impl module="" holds=true Equatable Ordering
impl module="" holds=true Hashable Ordering
impl module="" holds=true Ordered Ordering
impl module="" holds=true Show Ordering
impl module="q/a" holds=true Equatable q/a.T
impl module="q/a" holds=true Hashable q/a.T
impl module="q/a" holds=false Ordered q/a.T
impl module="q/a" holds=false Show q/a.T
impl module="q/b" holds=true Equatable q/b.T
impl module="q/b" holds=true Hashable q/b.T
impl module="q/b" holds=false Ordered q/b.T
impl module="q/b" holds=false Show q/b.T
