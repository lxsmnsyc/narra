// A lazy value nobody forces is never built.
import * as Lazies from "std/lazy"
import * as Int from "std/int"

function buildUnused(): Array<int> uses alloc {
  return [7, 8, 9]
}

function buildUsed(): int {
  return 41 + 1
}

const unused = lazy buildUnused()
const used = lazy buildUsed()

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(Lazies.force(used)))
  return 0
}
