// error: block_expressions_break_nested.nra:8:9: break cannot leave a block expression; it can only leave a loop inside the block
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  outer: for (const i of Ranges.upTo(3)) {
    const v = {
      const w = {
        break outer
        return 1
      }
      return w + i
    }
    print(`${v}`)
  }
  return 0
}
