// A library is linked only when reached code calls a function of its block: the
// Windows branch is dropped on macOS and Linux, so the missing library is never
// passed to cc, while libm is.
import * as Float from "std/float"
import * as Int from "std/int"
import * as Build from "std/build"
import { Os } from "std/build"

extern {
  function sqrt(value: f64): f64
} from "m"

extern {
  function narraMissingFunction(): int
} from "narra_no_such_library"

export function run(_args: Array<string>): int uses unsafe {
  unsafe {
    print(Float.toString(sqrt(9.0)))
  }
  if (Build.os == Os.Windows) {
    unsafe {
      print(Int.toString(narraMissingFunction()))
    }
  }
  return 0
}
