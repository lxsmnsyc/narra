// The syntax tree, one type for each node of compiler/internal/narra/ast.go.
//
// Differences from the Go tree:
// - Nothing is written back into the tree. The Go checker fills `T`, `Local`,
//   `Func`, `Ctor` and similar fields; here every expression, pattern, parameter,
//   `VarStmt` and `ForStmt` carries `id: int`, and the checker keeps its results
//   in side tables indexed by id. The parser numbers them from one
//   counter, from the first id the caller passes, in the order it builds
//   them; ids are unique but can have gaps (header of parser.nra). Ids are
//   not part of the AST dump.
// - Go interfaces (Decl, Stmt, Expr) are enums. Go's `Pattern` with a `Kind`
//   field is an enum with one variant per kind.
// - Optional children are `Option<...>`. Where Go tells a nil slice from an
//   empty one (`Pattern.Args`), a flag says it (`PatCtor.bare`).
// - Keywords cannot be field names: `exported` (export), `isMutable` (mutable),
//   `effects` (uses), `implementations` (implements), `derived` (derives), `orElse` (else),
//   `traitType` (trait).
// - `CharLit.value` is a string with one character, so the dump does not
//   depend on char to code conversion.
// - Not mirrored, because only the checker uses them: `Param.T/Local`,
//   `FuncDecl.Origin/ResultT/Module`, `ConstDecl.T/Module/state`,
//   `StructDecl.T`, `DistinctDecl.T`, `EnumDecl.T`, `TestDecl.Module`,
//   `TraitDecl.T`, the checker fields of `Ident`, `FieldExpr`, `CallExpr`,
//   `StructLit`, `ArrayLit`, `Pattern`, `ArrowExpr`, `IndexExpr.MapSet`,
//   `MatchExpr.IsValue` and `ForStmt.Kind`.

// A source position. Lines and columns start at 1.
// YieldBinding is the local of `const input = yield value`. It has a node id,
// like a VarStmt.
export struct YieldBinding {
  id: int
  isMutable: bool
  name: string
  pos: Pos
}

export struct Pos {
  line: int
  column: int
}

export struct File {
  imports: Array<ImportDecl>
  declarations: Array<Decl>
  // What the fix builders need from the source (fixes.nra).
  facts: SourceFacts
}

// An identifier written before a `.` and not after one, with the name after
// the dot. A fix that renames an import alias edits these.
export struct DotUse {
  pos: Pos
  member: string
}

// Facts about the source text for fixes, filled by the parser (Go keeps them
// in File and in AST fields). They are not part of the AST dump.
// - source: the text; header: the line after the leading comment block
//   where a fix adds the first import.
// - inTemplate: names written before a `.` inside a template string.
// - dotUses: by name, see DotUse.
// - namePositions: where the name of a Param, VarStmt or ForStmt is written,
//   by node id; shorthandIds: the PatName ids written as `{ host }`.
// - callEnds: the position just after the closing `)` of a call, by node id.
// - referenced: the names written outside the imports and not after a `.`,
//   including those inside `${}` of templates, for the unused-import check.
// - templateTokenEnds: where each token inside a `${}` of a template ends,
//   keyed by `t` and its start line:column (the module's token list has only
//   the template token).
export struct SourceFacts {
  source: string
  header: int
  inTemplate: Map<string, bool>
  dotUses: Map<string, Array<DotUse>>
  namePositions: Map<int, Pos>
  shorthandIds: Map<int, bool>
  callEnds: Map<int, Pos>
  templateTokenEnds: Map<string, Pos>
  referenced: Map<string, bool>
  // resultEnds: where a result type ends, by getPosKey("r", its pos), for the
  // fix that adds `from`; fromNames: where the name after a result type's
  // `from` is written, by the same key; valueEnds: where a returned value or an arrow
  // function's expression body ends, by node id, for the fix that wraps it in
  // copy(...).
  resultEnds: Map<string, Pos>
  fromNames: Map<string, Pos>
  valueEnds: Map<int, Pos>
  // True when the file writes `typeof` in a type.
  hasTypeof: bool = false
}

export function createEmptyFacts(): SourceFacts uses alloc {
  return SourceFacts {
    source: "",
    header: 1,
    inTemplate: Map {},
    dotUses: Map {},
    namePositions: Map {},
    shorthandIds: Map {},
    callEnds: Map {},
    templateTokenEnds: Map {},
    referenced: Map {},
    resultEnds: Map {},
    fromNames: Map {},
    valueEnds: Map {},
  }
}

export struct ImportDecl {
  pos: Pos
  alias: string // import * as alias from "path"; empty otherwise
  aliasPos: Pos // where alias is written, for fixes
  names: Array<ImportName>
  path: string
}

// One name of \`import { name as local } from "path"\`. local is name when the
// import does not rename it.
export struct ImportName {
  pos: Pos // where the name is written
  name: string
  local: string
  end: Pos // just after the last name written, for fixes
}

// A type as written. A function type `(a: A) => R uses E` has isFunc, `arguments`
// are the parameter types, `result` the result type. A tuple type `#[A, B]`
// has isTuple; `arguments` are the element types. `name` is empty for both.
export struct TypeExpr {
  pos: Pos
  name: string
  arguments: Array<TypeExpr>
  isFunc: bool
  result: Option<Box<TypeExpr>>
  effects: Array<string>
  isTuple: bool
  // `from items` after the result type of a function, an arrow function or a
  // function type: the parameter the result shares, or "". Only result types
  // carry it.
  resultFrom: string = ""
  // The parameter names a function type writes, "" for an unnamed one.
  parameterNames: Array<string> = []
  // `typeof name`: the value whose type this stands for, or "". `name` is empty then.
  typeofName: string = ""
}

export struct Param {
  id: int
  pos: Pos
  name: string
  isMutable: bool
  type: Option<TypeExpr> // None in an arrow function when it comes from context
  escaping: bool
}

export struct FuncDecl {
  pos: Pos
  name: string
  typeParameters: Array<string>
  bounds: Array<Array<TypeExpr>> // trait constraints, one list per type parameter
  exported: bool
  // `function* name(...)`: the result type is Generator<T> and the body
  // may yield (SPEC.md section 8).
  generator: bool = false
  parameters: Array<Param>
  result: Option<TypeExpr>
  effects: Array<string>
  effectParameters: Array<string> // the E of `<T, effect E>`
  // The conditions of the `requires` lines between the signature and the body.
  requires: Array<Expr> = []
  // The patterns of the `ensures` lines after them, which every result must match.
  ensures: Array<Pattern> = []
  body: Option<Block> // None for a trait function
  // `@target(os = Os.Windows)` written before a top-level function.
  target: Option<TargetAttribute> = None
}

// `@target(name = Enum.Variant, ...)`: pos is where `@` is written.
export struct TargetAttribute {
  pos: Pos
  arguments: Array<TargetArgument>
}

// One `os = Os.Windows` of a TargetAttribute. typeName is the enum as
// written (`Os`, `Build.Os`) and variant the name after its last dot.
export struct TargetArgument {
  pos: Pos
  name: string
  typeName: string
  typePos: Pos
  variant: string
}

// A top-level `const NAME: T = value`.
export struct ConstDecl {
  pos: Pos
  name: string
  exported: bool
  type: Option<TypeExpr>
  value: Expr
}

export struct FieldDecl {
  pos: Pos
  name: string
  type: TypeExpr
  default: Option<Expr>
}

export struct StructDecl {
  pos: Pos
  name: string
  typeParameters: Array<string>
  exported: bool
  implementations: Array<TypeExpr>
  derived: Array<TypeExpr>
  fields: Array<FieldDecl>
  opaque: bool
}

// `distinct type A = B`.
export struct DistinctDecl {
  pos: Pos
  name: string
  exported: bool
  opaque: bool
  base: TypeExpr
}

// `type Name<T> = Type`, a transparent alias.
export struct AliasDecl {
  pos: Pos
  name: string
  typeParameters: Array<string>
  exported: bool
  body: TypeExpr
}

export struct VariantDecl {
  pos: Pos
  name: string
  fields: Array<FieldDecl>
}

export struct EnumDecl {
  pos: Pos
  name: string
  typeParameters: Array<string>
  exported: bool
  implementations: Array<TypeExpr>
  derived: Array<TypeExpr>
  variants: Array<VariantDecl>
}

export struct TestDecl {
  pos: Pos
  name: string
  body: Block
}

// `trait Name { function f(a: Self): R ... }`. The functions have no body.
export struct TraitDecl {
  pos: Pos
  name: string
  exported: bool
  functions: Array<FuncDecl>
}

// `implement Trait for Type { ... }`.
export struct ImplDecl {
  pos: Pos
  traitType: TypeExpr
  type: TypeExpr
  functions: Array<FuncDecl>
}

export enum Decl {
  Func(declaration: FuncDecl)
  Const(declaration: ConstDecl)
  Struct(declaration: StructDecl)
  Enum(declaration: EnumDecl)
  Distinct(declaration: DistinctDecl)
  Alias(declaration: AliasDecl)
  Test(declaration: TestDecl)
  Trait(declaration: TraitDecl)
  Impl(declaration: ImplDecl)
}

export struct Block {
  pos: Pos
  // The closing brace.
  end: Pos
  statements: Array<Stmt>
}

export struct Arg {
  pos: Pos // the first token of the argument: its name, `mutable`, or its value
  name: Option<string> // Some for `name: value`, None for a positional argument
  isMutable: bool
  value: Expr
}

export struct FieldInit {
  pos: Pos
  name: string
  value: Expr
}

export struct FieldPattern {
  pos: Pos
  name: string
  pattern: Pattern
}

export struct MatchArm {
  pos: Pos
  pattern: Pattern
  guard: Option<Expr>
  body: Option<Expr> // set when the arm is a single expression
  block: Option<Block> // set when the arm is a block
  next: Pos // where the next arm, or the closing brace, starts
}

export enum Stmt {
  BlockStmt(block: Block)
  // `const` or `let`. A destructuring declaration has a pattern and an empty name.
  VarStmt(
    id: int,
    pos: Pos,
    isMutable: bool,
    name: string,
    pattern: Option<Pattern>,
    type: Option<TypeExpr>,
    value: Expr,
  )
  AssignStmt(pos: Pos, target: Expr, value: Expr)
  // `target += value` and the other compound forms; operator is the written
  // text (`+=`, `<<=`). `x++` and `x--` have operator `++` or `--` and an
  // IntLit 1 as value.
  CompoundAssignStmt(pos: Pos, target: Expr, operator: string, value: Expr)
  ExprStmt(pos: Pos, expression: Expr)
  ReturnStmt(pos: Pos, value: Option<Expr>)
  // The else branch: a BlockStmt or an IfStmt.
  IfStmt(pos: Pos, condition: Expr, then: Block, orElse: Option<Stmt>)
  WhileStmt(pos: Pos, label: string, condition: Expr, body: Block)
  // `for (init; condition; step) body`. init is a VarStmt, step an AssignStmt or
  // an ExprStmt; each is absent when left empty.
  CForStmt(
    pos: Pos,
    label: string,
    init: Option<Stmt>,
    condition: Option<Expr>,
    step: Option<Stmt>,
    body: Block,
  )
  // Set for the `mutable` marker.
  ForStmt(
    id: int,
    pos: Pos,
    label: string,
    name: string,
    iterable: Expr,
    body: Block,
    reference: Option<LoopReference>,
  )
  // `yield value`, or `yield* other` when delegate is set. `const input = yield
  // value` in a coroutine also has a binding; the statement's pos is the
  // `yield` and the binding's pos is the `const`.
  YieldStmt(pos: Pos, value: Expr, delegate: bool, binding: Option<YieldBinding>)
  BreakStmt(pos: Pos, label: string)
  ContinueStmt(pos: Pos, label: string)
}

// The `mutable` marker of a `for` head: `for (mutable item of items)`
// binds the loop's name to each element in place. In `for (const #[index,
// mutable item] of Arrays.entries(items))` the loop's name is item, and
// indexName and indexId are the name and node id of index; indexName is ""
// without one.
export struct LoopReference {
  indexId: int
  indexName: string
}

// Every expression carries an id and the position the Go parser records.
export enum Expr {
  IntLit(id: int, pos: Pos, text: string)
  FloatLit(id: int, pos: Pos, text: string)
  StringLit(id: int, pos: Pos, value: string, end: Pos)
  CharLit(id: int, pos: Pos, value: string)
  BoolLit(id: int, pos: Pos, value: bool)
  // parts are StringLit pieces and string expressions, in order.
  TemplateLit(id: int, pos: Pos, parts: Array<Expr>)
  Ident(id: int, pos: Pos, name: string)
  FieldExpr(id: int, pos: Pos, target: Expr, name: string)
  // `subject is Pattern`.
  IsExpr(id: int, pos: Pos, subject: Expr, pattern: Pattern)
  IndexExpr(id: int, pos: Pos, target: Expr, index: Expr)
  // `Map { "a": 1, [key]: 2 }` or `Map<K, V> { ... }`; keys and values have
  // the same length. typeArguments is empty when no type arguments are written.
  MapLit(id: int, pos: Pos, typeArguments: Array<TypeExpr>, keys: Array<Expr>, values: Array<Expr>)
  // typeArguments holds the `<int>` of `f<int>(x)` and `Trait.f<T>(x)`, or is
  // empty when none are written.
  CallExpr(id: int, pos: Pos, callee: Expr, typeArguments: Array<TypeExpr>, arguments: Array<Arg>)
  UnaryExpr(id: int, pos: Pos, operator: string, operand: Expr)
  BinaryExpr(id: int, pos: Pos, operator: string, left: Expr, right: Expr)
  // The type name is empty when the type comes from context. typeArguments holds the
  // `<A, B>` of `Pair<A, B> { ... }`, or is empty.
  StructLit(
    id: int,
    pos: Pos,
    typeName: string,
    typeArguments: Array<TypeExpr>,
    fields: Array<FieldInit>,
    spread: Option<Expr>,
  )
  ArrayLit(id: int, pos: Pos, elements: Array<Expr>, isTuple: bool)
  MatchExpr(id: int, pos: Pos, subject: Expr, arms: Array<MatchArm>)
  // A block in value position; its value comes from `return`. An
  // `if` as a value is a BlockExpr holding one IfStmt whose branches each return a
  // BlockExpr.
  BlockExpr(id: int, pos: Pos, block: Block)
  // `(x: int): int => x + 1` or `(x) => { ... }`; body or block is set.
  ArrowExpr(
    id: int,
    pos: Pos,
    parameters: Array<Param>,
    result: Option<TypeExpr>,
    body: Option<Expr>,
    block: Option<Block>,
  )
}

// The syntax of a pattern. The checker decides what a PatName means: a
// constructor without fields when the value is an enum with that variant,
// otherwise a binding.
export enum Pattern {
  PatWildcard(id: int, pos: Pos)
  PatName(id: int, pos: Pos, name: string)
  // `Name(p, ...)` or `Enum.Name`. enumName is the qualifier of Shape.Circle,
  // empty if none. bare is true without parentheses (Go: Args is nil).
  PatCtor(id: int, pos: Pos, enumName: string, name: string, arguments: Array<Pattern>, bare: bool)
  // `{ field, field: p }`; a shorthand field holds a PatName.
  PatStruct(id: int, pos: Pos, fields: Array<FieldPattern>)
  PatTuple(id: int, pos: Pos, arguments: Array<Pattern>)
  // 0, -1, 1.5, "a", 'c', true; lit is a literal expression, or a UnaryExpr
  // `-` over a number.
  PatLit(id: int, pos: Pos, literal: Expr)
  // `A | B`; at least two alternatives, which bind the same names.
  PatOr(id: int, pos: Pos, alternatives: Array<Pattern>)
  // `>= 0` or `!= 0`: an integer compared with a constant; only in an `ensures` line.
  PatCompare(id: int, pos: Pos, operator: string, bound: Expr)
}
