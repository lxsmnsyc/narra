const STD_COROUTINE = "// std/coroutine: Co.resume runs a generator or a coroutine to its next yield.\n//\n// The compiler turns `Co.resume(mutable g)` into resumeGenerator and\n// `Co.resume(mutable g, input)` into resumeCoroutine, by argument count.\n\nimport * as Internal from \"std/internal/coroutine\"\n\nexport enum Step<Out> derives Show, Equatable {\n  Yielded(value: Out)\n  Done\n  Panicked(message: string)\n}\n\nexport function resumeGenerator<T, effect E>(mutable g: Generator<T> uses E): Step<T> uses E, alloc {\n  return stepOf(Internal.next(mutable g))\n}\n\nexport function resumeCoroutine<In, Out, effect E>(mutable g: Coroutine<In, Out> uses E, input: In): Step<Out> uses E, alloc {\n  return stepOf(Internal.resume(mutable g, input))\n}\n\n// stepOf reads the outcome of one resume: a value, the end, or a panic.\nfunction stepOf<T>(next: Option<T>): Step<T> uses alloc {\n  if (next is Some(value)) {\n    return Step.Yielded(value)\n  }\n  if (Internal.panicked()) {\n    return Step.Panicked(Internal.panicMessage())\n  }\n  return Step.Done\n}\n"

const STD_JSON = "// std/json: parse and stringify JSON text (RFC 8259) as a Value of std/shape.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Char from \"std/char\"\nimport * as Float from \"std/float\"\nimport * as Arrays from \"std/array\"\nimport * as Maps from \"std/map\"\nimport * as FloatText from \"std/internal/float\"\nimport { Value } from \"std/shape\"\n\n// Containers nested deeper than this are an error, so the recursion is bounded.\nconst MAX_DEPTH = 512\n\nstruct Parser {\n  text: string\n  length: int\n  position: int\n}\n\n// parse reads one JSON value. Errors read `<line>:<column>: <reason>`.\nexport function parse(text: string): Result<Value, string> uses alloc {\n  let parser = Parser { text: text, length: Str.length(text), position: 0 }\n  skipSpace(mutable parser)\n  const value = parseValue(mutable parser, 0)\n  if (value is Err(message)) {\n    return Err(message)\n  }\n  skipSpace(mutable parser)\n  if (parser.position < parser.length) {\n    return fail(parser, parser.position, \"unexpected character after the value\")\n  }\n  return Ok(value.value)\n}\n\n// stringify writes a value as compact JSON text. A non-finite Float is null.\nexport function stringify(value: Value): string uses alloc {\n  let builder = Str.builder()\n  writeValue(mutable builder, value)\n  return Str.build(builder)\n}\n\n// fail builds the error for the byte at position, as line:column: reason.\nfunction fail<T>(parser: Parser, position: int, reason: string): Result<T, string> uses alloc {\n  let line = 1\n  let column = 1\n  let index = 0\n  while (index < position && index < parser.length) {\n    const byte = Str.byteAt(parser.text, index)\n    if (byte == 10) {\n      line = line + 1\n      column = 1\n    } else if (byte < 128 || byte >= 192) {\n      column = column + 1\n    }\n    index = index + 1\n  }\n  if (position >= parser.length) {\n    return Err(`\${Int.toString(line)}:\${Int.toString(column)}: unexpected end of input`)\n  }\n  return Err(`\${Int.toString(line)}:\${Int.toString(column)}: \${reason}`)\n}\n\nfunction skipSpace(mutable parser: Parser) {\n  while (parser.position < parser.length) {\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte != 32 && byte != 9 && byte != 10 && byte != 13) {\n      return\n    }\n    parser.position = parser.position + 1\n  }\n}\n\nfunction parseValue(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (parser.position >= parser.length) {\n    return fail(parser, parser.position, \"expected a value\")\n  }\n  const byte = Str.byteAt(parser.text, parser.position)\n  if (byte == 123) {\n    return parseRecord(mutable parser, depth + 1)\n  }\n  if (byte == 91) {\n    return parseList(mutable parser, depth + 1)\n  }\n  if (byte == 34) {\n    const text = parseString(mutable parser)\n    if (text is Err(message)) {\n      return Err(message)\n    }\n    return Ok(Value.Text(text.value))\n  }\n  if (byte == 45 || (byte >= 48 && byte <= 57)) {\n    return parseNumber(mutable parser)\n  }\n  if (readWord(mutable parser, \"true\")) {\n    return Ok(Value.Bool(true))\n  }\n  if (readWord(mutable parser, \"false\")) {\n    return Ok(Value.Bool(false))\n  }\n  if (readWord(mutable parser, \"null\")) {\n    return Ok(Value.Null)\n  }\n  return fail(parser, parser.position, \"expected a value\")\n}\n\n// readWord consumes word when the text continues with it.\nfunction readWord(mutable parser: Parser, word: string): bool {\n  const end = parser.position + Str.length(word)\n  if (end <= parser.length && Str.slice(parser.text, parser.position, end) == word) {\n    parser.position = end\n    return true\n  }\n  return false\n}\n\nfunction parseList(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return fail(parser, parser.position, \"nesting is deeper than 512\")\n  }\n  // Skip the [.\n  parser.position = parser.position + 1\n  let items: Array<Value> = []\n  skipSpace(mutable parser)\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 93) {\n    parser.position = parser.position + 1\n    return Ok(Value.List(items))\n  }\n  while (true) {\n    skipSpace(mutable parser)\n    const item = parseValue(mutable parser, depth)\n    if (item is Err(message)) {\n      return Err(message)\n    }\n    Arrays.push(mutable items, item.value)\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"expected , or ]\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    parser.position = parser.position + 1\n    if (byte == 93) {\n      return Ok(Value.List(items))\n    }\n    if (byte != 44) {\n      return fail(parser, parser.position - 1, \"expected , or ]\")\n    }\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\nfunction parseRecord(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return fail(parser, parser.position, \"nesting is deeper than 512\")\n  }\n  // Skip the {.\n  parser.position = parser.position + 1\n  let fields: Map<string, Value> = Map {}\n  skipSpace(mutable parser)\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 125) {\n    parser.position = parser.position + 1\n    return Ok(Value.Record(fields))\n  }\n  while (true) {\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length || Str.byteAt(parser.text, parser.position) != 34) {\n      return fail(parser, parser.position, \"expected a string key\")\n    }\n    const key = parseString(mutable parser)\n    if (key is Err(message)) {\n      return Err(message)\n    }\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length || Str.byteAt(parser.text, parser.position) != 58) {\n      return fail(parser, parser.position, \"expected :\")\n    }\n    parser.position = parser.position + 1\n    skipSpace(mutable parser)\n    const field = parseValue(mutable parser, depth)\n    if (field is Err(message)) {\n      return Err(message)\n    }\n    // The last duplicate wins; an existing key keeps its place (D64).\n    fields[key.value] = field.value\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"expected , or }\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    parser.position = parser.position + 1\n    if (byte == 125) {\n      return Ok(Value.Record(fields))\n    }\n    if (byte != 44) {\n      return fail(parser, parser.position - 1, \"expected , or }\")\n    }\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\nfunction isDigit(byte: int): bool {\n  return byte >= 48 && byte <= 57\n}\n\n// skipDigits moves past a run of digits and says how many there were.\nfunction skipDigits(mutable parser: Parser): int {\n  let count = 0\n  while (parser.position < parser.length && isDigit(Str.byteAt(parser.text, parser.position))) {\n    parser.position = parser.position + 1\n    count = count + 1\n  }\n  return count\n}\n\nfunction parseNumber(mutable parser: Parser): Result<Value, string> uses alloc {\n  const start = parser.position\n  let isFloat = false\n  if (Str.byteAt(parser.text, parser.position) == 45) {\n    parser.position = parser.position + 1\n  }\n  // Integer part: 0, or a nonzero digit and more digits.\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 48) {\n    parser.position = parser.position + 1\n  } else if (skipDigits(mutable parser) == 0) {\n    return fail(parser, parser.position, \"invalid number\")\n  }\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 46) {\n    isFloat = true\n    parser.position = parser.position + 1\n    if (skipDigits(mutable parser) == 0) {\n      return fail(parser, parser.position, \"invalid number\")\n    }\n  }\n  if (parser.position < parser.length) {\n    const marker = Str.byteAt(parser.text, parser.position)\n    if (marker == 101 || marker == 69) {\n      isFloat = true\n      parser.position = parser.position + 1\n      if (parser.position < parser.length) {\n        const sign = Str.byteAt(parser.text, parser.position)\n        if (sign == 43 || sign == 45) {\n          parser.position = parser.position + 1\n        }\n      }\n      if (skipDigits(mutable parser) == 0) {\n        return fail(parser, parser.position, \"invalid number\")\n      }\n    }\n  }\n  const digits = Str.slice(parser.text, start, parser.position)\n  if (!isFloat) {\n    // An integer outside int becomes a Float.\n    const whole = Int.parse(digits, 10)\n    if (whole is Ok(number)) {\n      return Ok(Value.Int(number))\n    }\n  }\n  return Ok(Value.Float(FloatText.parse(digits)))\n}\n\n// hexValue is the value of a hexadecimal digit, or -1.\nfunction hexValue(byte: int): int {\n  if (byte >= 48 && byte <= 57) {\n    return byte - 48\n  }\n  if (byte >= 97 && byte <= 102) {\n    return byte - 87\n  }\n  if (byte >= 65 && byte <= 70) {\n    return byte - 55\n  }\n  return -1\n}\n\n// readHex4 reads the four hex digits at parser.position.\nfunction readHex4(mutable parser: Parser): Result<int, string> uses alloc {\n  let code = 0\n  let count = 0\n  while (count < 4) {\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const digit = hexValue(Str.byteAt(parser.text, parser.position))\n    if (digit < 0) {\n      return fail(parser, parser.position, \"invalid \\\\u escape\")\n    }\n    code = code * 16 + digit\n    parser.position = parser.position + 1\n    count = count + 1\n  }\n  return Ok(code)\n}\n\n// parseString reads a string whose opening quote is at parser.position.\nfunction parseString(mutable parser: Parser): Result<string, string> uses alloc {\n  parser.position = parser.position + 1\n  let builder = Str.builder()\n  // runStart is the start of the plain bytes not yet copied.\n  let runStart = parser.position\n  while (true) {\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte == 34) {\n      Str.append(mutable builder, Str.slice(parser.text, runStart, parser.position))\n      parser.position = parser.position + 1\n      return Ok(Str.build(builder))\n    }\n    if (byte < 32) {\n      return fail(parser, parser.position, \"control character in string\")\n    }\n    if (byte != 92) {\n      parser.position = parser.position + 1\n      continue\n    }\n    Str.append(mutable builder, Str.slice(parser.text, runStart, parser.position))\n    parser.position = parser.position + 1\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const escape = Str.byteAt(parser.text, parser.position)\n    const escapeAt = parser.position - 1\n    parser.position = parser.position + 1\n    if (escape == 117) {\n      const unit = readHex4(mutable parser)\n      if (unit is Err(message)) {\n        return Err(message)\n      }\n      const code = readCodePoint(mutable parser, unit.value, escapeAt)\n      if (code is Err(message)) {\n        return Err(message)\n      }\n      if (Char.fromCode(code.value) is Some(character)) {\n        Str.appendChar(mutable builder, character)\n      }\n    } else {\n      const simple = simpleEscape(escape)\n      if (simple == \"\") {\n        return fail(parser, escapeAt, \"invalid escape\")\n      }\n      Str.append(mutable builder, simple)\n    }\n    runStart = parser.position\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\n// simpleEscape is the text for the escape letter after a backslash, or \"\".\nfunction simpleEscape(letter: int): string uses alloc {\n  if (letter == 34) {\n    return \"\\\"\"\n  }\n  if (letter == 92) {\n    return \"\\\\\"\n  }\n  if (letter == 47) {\n    return \"/\"\n  }\n  if (letter == 98) {\n    return controlText(8)\n  }\n  if (letter == 102) {\n    return controlText(12)\n  }\n  if (letter == 110) {\n    return \"\\n\"\n  }\n  if (letter == 114) {\n    return \"\\r\"\n  }\n  if (letter == 116) {\n    return \"\\t\"\n  }\n  return \"\"\n}\n\nfunction controlText(code: int): string uses alloc {\n  if (Char.fromCode(code) is Some(character)) {\n    return Str.fromChar(character)\n  }\n  return \"\"\n}\n\n// readCodePoint joins a surrogate pair; a lone surrogate is an error at escapeAt.\nfunction readCodePoint(\n  mutable parser: Parser,\n  unit: int,\n  escapeAt: int,\n): Result<int, string> uses alloc {\n  if (unit >= 56320 && unit <= 57343) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  if (unit < 55296 || unit > 56319) {\n    return Ok(unit)\n  }\n  // A high surrogate needs \\u and a low surrogate right after it.\n  if (!readWord(mutable parser, \"\\\\u\")) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  const low = readHex4(mutable parser)\n  if (low is Err(message)) {\n    return Err(message)\n  }\n  if (low.value < 56320 || low.value > 57343) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  return Ok(65536 + (unit - 55296) * 1024 + (low.value - 56320))\n}\n\nfunction writeValue(mutable builder: StringBuilder, value: Value) uses alloc {\n  match (value) {\n    Value.Null => Str.append(mutable builder, \"null\")\n    Value.Bool(flag) => {\n      if (flag) {\n        Str.append(mutable builder, \"true\")\n      } else {\n        Str.append(mutable builder, \"false\")\n      }\n    }\n    Value.Int(number) => Str.append(mutable builder, Int.toString(number))\n    Value.Float(number) => {\n      // NaN and infinities have no JSON form; JSON.stringify writes null.\n      if (number - number != 0.0) {\n        Str.append(mutable builder, \"null\")\n      } else {\n        Str.append(mutable builder, floatText(number))\n      }\n    }\n    Value.Text(text) => writeString(mutable builder, text)\n    Value.List(items) => {\n      Str.append(mutable builder, \"[\")\n      let first = true\n      for (const item of Arrays.values(items)) {\n        if (!first) {\n          Str.append(mutable builder, \",\")\n        }\n        first = false\n        writeValue(mutable builder, item)\n      }\n      Str.append(mutable builder, \"]\")\n    }\n    Value.Record(fields) => {\n      Str.append(mutable builder, \"{\")\n      let first = true\n      for (const entry of Maps.entries(fields)) {\n        const #[key, field] = entry\n        if (!first) {\n          Str.append(mutable builder, \",\")\n        }\n        first = false\n        writeString(mutable builder, key)\n        Str.append(mutable builder, \":\")\n        writeValue(mutable builder, field)\n      }\n      Str.append(mutable builder, \"}\")\n    }\n  }\n}\n\n// floatText writes a finite Float. A whole number below 1e15 reads as digits and\n// \".0\" (Float.toString would write 1e+02 for 100.0); the rest keeps its shortest text.\nfunction floatText(number: f64): string uses alloc {\n  if (number > -1000000000000000.0 && number < 1000000000000000.0) {\n    const whole = Float.truncate(number)\n    if (Float.fromInt(whole) == number) {\n      return `\${Int.toString(whole)}.0`\n    }\n  }\n  return Float.toString(number)\n}\n\nfunction writeString(mutable builder: StringBuilder, text: string) uses alloc {\n  Str.append(mutable builder, \"\\\"\")\n  const length = Str.length(text)\n  // runStart is the start of the bytes that need no escape and are not yet copied.\n  let runStart = 0\n  let index = 0\n  while (index < length) {\n    const byte = Str.byteAt(text, index)\n    if (byte >= 32 && byte != 34 && byte != 92) {\n      index = index + 1\n      continue\n    }\n    Str.append(mutable builder, Str.slice(text, runStart, index))\n    Str.append(mutable builder, escapeByte(byte))\n    index = index + 1\n    runStart = index\n  }\n  Str.append(mutable builder, Str.slice(text, runStart, length))\n  Str.append(mutable builder, \"\\\"\")\n}\n\n// escapeByte is the JSON escape for a quote, a backslash or a control character.\nfunction escapeByte(byte: int): string uses alloc {\n  if (byte == 34) {\n    return \"\\\\\\\"\"\n  }\n  if (byte == 92) {\n    return \"\\\\\\\\\"\n  }\n  if (byte == 10) {\n    return \"\\\\n\"\n  }\n  if (byte == 13) {\n    return \"\\\\r\"\n  }\n  if (byte == 9) {\n    return \"\\\\t\"\n  }\n  if (byte == 8) {\n    return \"\\\\b\"\n  }\n  if (byte == 12) {\n    return \"\\\\f\"\n  }\n  const hex = Int.toHex(byte)\n  return `\\\\u\${Str.repeat(\"0\", 4 - Str.length(hex))}\${hex}`\n}\n"

const STD_OPTION = "// std/option: helpers over the prelude Option.\n\nexport function map<T, U, effect E>(option: Option<T>, f: (value: T) => U uses E): Option<U> uses alloc, E {\n  return match (option) {\n    Some(value) => Some(f(value))\n    None => None\n  }\n}\n\nexport function andThen<T, U, effect E>(option: Option<T>, f: (value: T) => Option<U> uses E): Option<U> uses E {\n  return match (option) {\n    Some(value) => f(value)\n    None => None\n  }\n}\n\nexport function withDefault<T>(option: Option<T>, fallback: T): T {\n  return match (option) {\n    Some(value) => value\n    None => fallback\n  }\n}\n\nexport function orElse<T, effect E>(option: Option<T>, f: () => Option<T> uses E): Option<T> uses E {\n  return match (option) {\n    Some(_) => option\n    None => f()\n  }\n}\n\nexport function isSome<T>(option: Option<T>): bool {\n  return option is Some(_)\n}\n\nexport function isNone<T>(option: Option<T>): bool {\n  return option is None\n}\n\nexport function okOr<T, F>(option: Option<T>, error: F): Result<T, F> uses alloc {\n  return match (option) {\n    Some(value) => Ok(value)\n    None => Err(error)\n  }\n}\n"

const STD_SHAPE = "// std/shape: Value, a dynamic tree for structured data.\n//\n// Formats such as std/json read and write it. Int and Float are separate\n// because a 64-bit integer must survive a round trip, which an f64 cannot hold.\n// Record keeps its fields in insertion order (D64).\n\nexport enum Value {\n  Null\n  Bool(value: bool)\n  Int(value: int)\n  Float(value: f64)\n  Text(value: string)\n  List(items: Array<Value>)\n  Record(fields: Map<string, Value>)\n}\n"

// stdSourceFor is the Narra text of a std source module, or "" when the
// module is a builtin one.
export function stdSourceFor(path: string): string {
  if (path == "std/coroutine") {
    return STD_COROUTINE
  }
  if (path == "std/json") {
    return STD_JSON
  }
  if (path == "std/option") {
    return STD_OPTION
  }
  if (path == "std/shape") {
    return STD_SHAPE
  }
  return ""
}
