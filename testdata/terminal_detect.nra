// Detection in std/terminal. The parent runs this program again with chosen
// variables and standard output on a pipe, so no stream is a terminal.
import * as Terminal from "std/terminal"
import { Stream } from "std/terminal"
import * as Process from "std/process"
import * as Env from "std/env"
import * as Str from "std/string"
import * as Arrays from "std/array"

function report() uses io, alloc {
  print(`stdout terminal: ${Show.show(Terminal.isTerminal(Stream.Stdout))}`)
  print(`stdout columns: ${Show.show(Terminal.columns(Stream.Stdout))}`)
  print(`stdout color: ${Show.show(Terminal.useColor(Stream.Stdout))}`)
}

function runChild(program: string, variables: Array<string>) uses io, alloc {
  let arguments = ["-u", "NO_COLOR", "-u", "FORCE_COLOR", "-u", "TERM"]
  for (const variable of Arrays.values(variables)) {
    Arrays.push(mutable arguments, variable)
  }
  Arrays.push(mutable arguments, program)
  Arrays.push(mutable arguments, "child")
  const ran = Process.run("env", arguments)
  if (ran is Ok(#[code, output, _])) {
    print(`[${Str.join(variables, " ")}] exit ${Show.show(code)}`)
    print(Str.trim(output))
  } else {
    print("could not start the child")
  }
}

export function run(args: Array<string>): int uses io, alloc {
  if (Arrays.length(args) > 0 && args[Arrays.length(args) - 1] == "child") {
    report()
    return 0
  }
  const program = Env.args()[0]
  runChild(program, [])
  runChild(program, ["FORCE_COLOR=1"])
  runChild(program, ["FORCE_COLOR=0"])
  runChild(program, ["FORCE_COLOR="])
  runChild(program, ["NO_COLOR=1", "FORCE_COLOR=1"])
  runChild(program, ["NO_COLOR=", "FORCE_COLOR=1"])
  runChild(program, ["TERM=dumb", "FORCE_COLOR=1"])
  runChild(program, ["TERM=dumb"])
  return 0
}
