// error: Arrays.push(mutable items, ...) may change items, which bag.items still uses at line 13
import * as Arrays from "std/array"

struct Bag {
  items: Array<int>
}

export function run(_args: Array<string>): int uses alloc {
  let bag = Bag { items: [1, 2] }
  let items = bag.items
  // A write through items conflicts with the later use of bag.items.
  Arrays.push(mutable items, 3)
  return Arrays.length(items) + Arrays.length(bag.items)
}
