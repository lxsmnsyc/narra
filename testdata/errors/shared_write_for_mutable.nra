// warning: item.count = ... may change items, which saved still uses at line 19
struct Counter {
  count: int
}

export function run(_args: Array<string>): int uses alloc {
  let items = [Counter { count: 1 }]
  const saved = items
  // `for (mutable item of items)` writes the elements of items in place, so
  // the write copies items while saved shares it.
  for (mutable item of items) {
    item.count = 2
  }
  // A loop over an array that nothing else shares is clean.
  let fresh = [Counter { count: 3 }]
  for (mutable counter of fresh) {
    counter.count = 4
  }
  return saved[0].count + items[0].count + fresh[0].count
}
