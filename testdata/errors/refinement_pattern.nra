// error: Name refines string, so its patterns are string literals; `>=` compares integers
// Each item must fit the base: string literals on string, integer constants that fit.
distinct type Name = string requires >= 1

function limit(): int {
  return 3
}

distinct type Count = int requires <= limit()
distinct type Level = u8 requires <= 300
distinct type Huge = u64 requires <= 9223372036854775808
distinct type Maybe = int requires Some(_)
distinct type Anything = int requires _
distinct type Named = int requires value
distinct type Mixed = int requires "one"

export function run(_args: Array<string>): int {
  return limit()
}
