// leading comment of the first declaration
const a = 1 // trailing comment

const b = f(
  // before first argument
  x,
  y, // after second argument
  z,
)

const c = Point {
  // before field
  x: 1, // trailing field
  y: 2,
}

const d = [
  1, // one
  2,
]

const e = match (value) {
  // before arm
  A => 1 // after arm
  B => 2
}

const g = /* before */ x + /* middle */ y /* after */

const h = {
  // only a comment
}

const i = (a) => /* body */ a
