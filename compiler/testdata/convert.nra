import * as Int from "std/int"
import * as Char from "std/char"
import * as Str from "std/string"

function showCode(n: int): string {
  if (Char.fromCode(n) is Some(c)) {
    return `Some(${Int.toString(Char.code(c))})`
  }
  return "None"
}

function showParse(s: string, base: int): string {
  const r = Int.parse(s, base)
  if (r is Ok(v)) {
    return `Ok(${Int.toString(v)})`
  }
  if (r is Err(m)) {
    return `Err(${m})`
  }
  return "?"
}

export function run(args: Array<string>): int {
  print(Int.toString(Char.code('A')))
  print(Int.toString(Char.code('λ')))
  print(Int.toString(Char.code('\0')))
  print(showCode(65))
  print(showCode(0))
  print(showCode(0xD7FF))
  print(showCode(0xD800))
  print(showCode(0xDFFF))
  print(showCode(0xE000))
  print(showCode(0x10FFFF))
  print(showCode(0x110000))
  print(showCode(-1))

  print(showParse("101", 2))
  print(showParse("102", 2))
  print(showParse("-42", 10))
  print(showParse("12x", 10))
  print(showParse("", 10))
  print(showParse("-", 10))
  print(showParse("ff", 16))
  print(showParse("FF", 16))
  print(showParse("fg", 16))
  print(showParse("zz", 36))
  print(showParse("z", 36))
  print(showParse("9223372036854775807", 10))
  print(showParse("9223372036854775808", 10))
  print(showParse("-9223372036854775808", 10))
  print(showParse("-9223372036854775809", 10))
  print(showParse("7fffffffffffffff", 16))
  print(showParse("8000000000000000", 16))
  print(showParse("-8000000000000000", 16))
  print(showParse("99999999999999999999999", 10))
  print(showParse("1", 1))
  print(showParse("1", 37))
  print(showParse("0x10", 16))

  print(Int.toHex(0))
  print(Int.toHex(255))
  print(Int.toHex(-255))
  print(Int.toHex(9223372036854775807))
  print(Int.toHex(-9223372036854775807 - 1))

  print(Int.toString(Str.length(Str.fromChar('\0'))))
  let sb = Str.builder()
  Str.append(mutable sb, "a")
  Str.appendChar(mutable sb, '\0')
  Str.appendChar(mutable sb, 'b')
  print(Int.toString(Str.length(Str.build(sb))))

  if (Str.endsWith("narra", "rra") && !Str.endsWith("rra", "narra") && Str.endsWith("x", "")) { print("ends ok") }
  if (Str.contains("narra", "arr") && !Str.contains("narra", "z") && Str.contains("", "")) { print("contains ok") }

  print(Str.replace("aaaa", "aa", "b"))
  print(Str.replace("aaa", "aa", "b"))
  print(Str.replace("abcabc", "bc", ""))
  print(Str.replace("abc", "", "x"))
  print(Str.replace("a.b.c", ".", "::"))
  print(Str.replace("abab", "ab", "ab"))
  print(Str.replace("", "a", "b"))

  const none: Array<string> = []
  print(`[${Str.join(none, ",")}]`)
  print(Str.join(["a"], ", "))
  print(Str.join(["a", "b", "c"], ", "))
  print(Str.join(["a", "", "c"], ""))
  return 0
}
