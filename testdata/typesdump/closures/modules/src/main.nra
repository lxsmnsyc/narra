import * as Ops from "p/ops"
import { double } from "p/ops"

function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

export function run(args: Array<string>): int {
  const base = 4
  const viaImport = apply(double, 2)
  const viaAlias = apply(Ops.double, 3)
  const generic: (x: int) => int = Ops.same
  const tripled = Ops.triple(base)
  const held = Ops.triple
  const nested = Ops.applyTo((x) => x + base, tripled)
  return viaImport + viaAlias + generic(held(nested))
}
