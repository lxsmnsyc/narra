// error: 5 does not satisfy `requires count < 0 || count > 10` of outside
function outside(count: int): int
  requires count < 0 || count > 10
{
  return count
}

function either(first: int, second: int): int
  requires first != 0 || second != 0
{
  return first + second
}

function ordered(x: int, y: int): int
  requires y > x || x == 0
{
  return x + y
}

export function run(_args: Array<string>): int {
  return outside(5) + either(0, 0) + ordered(5, 1)
}
