import * as Int from "std/int"
import * as I8 from "std/i8"
import * as I16 from "std/i16"
import * as I32 from "std/i32"
import * as U8 from "std/u8"
import * as U16 from "std/u16"
import * as U32 from "std/u32"
import * as U64 from "std/u64"

function show<T: Show>(value: T) uses alloc {
  print(Show.show(value))
}

function showChecked<T: Show>(value: Option<T>) uses alloc {
  if (value is Some(found)) {
    print(`Some(${Show.show(found)})`)
  } else {
    print("None")
  }
}

function negate(value: int): int {
  return -value
}

function negateSmall(value: i8): i8 {
  return -value
}

export function run(args: Array<string>): int uses io, alloc {
  // int wraps in add, subtract, multiply and negate.
  const maxInt = 9223372036854775807
  const minInt = -maxInt - 1
  show(maxInt + 1)
  show(minInt - 1)
  show(maxInt * 2)
  show(negate(minInt))
  show(negate(5))
  let counter = maxInt
  counter += 2
  show(counter)
  counter -= 3
  show(counter)
  counter *= 3
  show(counter)

  // The smallest value divided by -1.
  const minusOne = -1
  show(minInt / minusOne)
  show(minInt % minusOne)
  show(Int.abs(minInt))

  // Each sized type wraps at its own width.
  const maxI8: i8 = 127
  const minI8: i8 = -128
  const maxI16: i16 = 32767
  const maxI32: i32 = 2147483647
  const maxU8: u8 = 255
  const maxU16: u16 = 65535
  const maxU32: u32 = 4294967295
  const maxU64: u64 = 18446744073709551615
  const zeroU8: u8 = 0
  const zeroU64: u64 = 0
  const minusOneI8: i8 = -1
  show(maxI8 + 1)
  show(minI8 - 1)
  show(maxI8 * 2)
  show(negateSmall(minI8))
  show(minI8 / minusOneI8)
  show(minI8 % minusOneI8)
  show(maxI16 + 1)
  show(maxI32 + 1)
  show(maxU8 + 1)
  show(zeroU8 - 1)
  show(maxU16 * 2)
  show(maxU32 + 1)
  show(maxU64 + 2)
  show(zeroU64 - 1)

  // The checked functions return None on overflow.
  showChecked(Int.addChecked(maxInt, 1))
  showChecked(Int.addChecked(maxInt, -1))
  showChecked(Int.subChecked(minInt, 1))
  showChecked(Int.subChecked(minInt, -1))
  showChecked(Int.mulChecked(maxInt, 2))
  showChecked(Int.mulChecked(3000000, 3000000))
  showChecked(I8.addChecked(maxI8, 1))
  showChecked(I8.subChecked(minI8, 1))
  showChecked(I8.mulChecked(minI8, minusOneI8))
  showChecked(I8.mulChecked(11, 11))
  showChecked(I16.addChecked(maxI16, 1))
  showChecked(I32.mulChecked(maxI32, 2))
  showChecked(I32.subChecked(0, maxI32))
  showChecked(U8.addChecked(maxU8, 1))
  showChecked(U8.subChecked(zeroU8, 1))
  showChecked(U8.mulChecked(16, 16))
  showChecked(U8.mulChecked(15, 17))
  showChecked(U16.addChecked(maxU16, 1))
  showChecked(U32.subChecked(0, 1))
  showChecked(U64.addChecked(maxU64, 1))
  showChecked(U64.subChecked(maxU64, 1))
  showChecked(U64.mulChecked(maxU64, 2))
  return 0
}
