// The shared-write check (error E0978). A write to a place copies it on
// write while another live name still shares that place or a place that
// contains it. The error names the write, the shared place, the name that
// shares it and that name's next use, and offers to take a copy(...) where
// the sharing starts.
//
// One forward walk over a body keeps, at each point, the pairs of places that
// share a value, and the writes that hit a pair and wait for a later use of
// its other side. A place is a local or a constant with the fields after it,
// and "[]" for any element ("[=2]" for the element at a literal index).
// Branches are walked from the same state and merged; a loop body is walked again until its state stops growing. An
// arrow function is walked on its own state: its parameters and the locals it
// captures stay live after it, like the parameters of a function. Places and
// their message texts have integer ids (PlaceTable), so comparing two places
// compares integers.
import { substring, filledArray } from "narrac/textops"
import { Pos, Expr, Stmt, Block, Arg, FieldInit, Param, Pattern } from "narrac/ast"
import { Type } from "narrac/types"
import {
  Checker,
  BodyRoot,
  Ref,
  getRef,
  getNodeType,
  findBodySlot,
  reportErrorFix,
  getExpressionId,
} from "narrac/check"
import { Fix, createFix, insertAt } from "narrac/fixes"
import { collectPatternLocals } from "narrac/patterns"
import { isCopyTracked, isCopyCall, canShareType } from "narrac/stdcopy"
import { findSharedArgument, findExpressionStart } from "narrac/sharedresults"
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import * as Str from "std/string"

// A local or a constant and the parts after it. root is the BodyInfo.locals
// index, or -2 - index for a constant; id is the place's PlaceTable id and
// text the id of how messages write it (writeText).
struct Place {
  root: int
  id: int
  text: int
}

// The places of one body. Each id is a root or a parent id and one part
// (".items", "[]" for any element, "[=2]" for a literal index), so two
// places with the same parts have the same id.
struct PlaceTable {
  roots: Array<int>
  parents: Array<int>
  parts: Array<int>
  depths: Array<int>
  // Locals have the ids 0 to their count - 1; constants are added when named.
  constantPlaces: Map<int, int>
  // By parent id * PART_STRIDE + part id.
  childPlaces: Map<int, int>
  partTable: PartTable
  // Message texts: a parent text (-1 for none) and a piece, such as a name,
  // ".items" or "[index]". By (parent + 1) * PART_STRIDE + piece. Like the
  // places, the texts 0 to the local count - 1 are the locals' names (piece -1).
  textParents: Array<int>
  textPieces: Array<int>
  textChildren: Map<int, int>
}

// What does not depend on the body: the parts and pieces of places, and
// which enums can share. It stays from one body to the next.
struct PartTable {
  partIds: Map<string, int>
  fieldParts: Map<string, int>
  partKinds: Array<int>
  // The piece a part adds to a message: "[=2]" reads "[2]".
  partPieces: Array<int>
  pieceIds: Map<string, int>
  pieceTexts: Array<string>
  // The piece of each index, by the index as written.
  indexPieces: Map<string, int>
  // Whether a value of the enum with this index can hold a tracked value.
  shareAnswers: Map<int, bool>
}

// A value shares place; suffix is where inside the value (".items", "[]").
struct ValueShare {
  suffix: string
  place: Place
  // Whether the part at suffix is changed in place by a write (isCopyTracked).
  tracked: bool = true
}

// Two places that hold the same value. origin is the value of the statement
// that made the pair, which the fix wraps in copy(...).
struct SharePair {
  first: Place
  second: Place
  // An index of WriteWalk.origins, or -1.
  origin: int
  // Whether the shared value is changed in place by a write (isCopyTracked).
  tracked: bool
}

// A write that hit a pair: it is reported at the next use of other.
struct PendingWrite {
  site: int
  hit: Place
  other: Place
  origin: int
}

struct FlowState {
  pairs: Array<SharePair>
  // The pairs by the ids of their places (makePairKey).
  pairKeys: Map<int, bool>
  pending: Array<PendingWrite>
  reachable: bool
}

// A write, by its kind and the text of the place it writes (writeSiteText).
struct WriteSite {
  pos: Pos
  // Where the written place ends.
  end: Pos
  kind: int
  place: int
  // The operator of a compound assignment.
  operator: string = ""
  // The function a `mutable` argument is passed to, and whether it takes more arguments.
  callee: Option<Expr> = None
  more: bool = false
}

// Why the other side was live at the write.
enum LiveReason {
  LaterUse(line: int)
  // A `const` or `let` holds its value until its block ends at line.
  ScopeEnd(line: int)
  Parameter
  Captured
  Cell
  Constant
  Loop
}

struct FoundWrite {
  site: int
  hit: Place
  other: Place
  reason: LiveReason
  origin: int
}

struct WriteWalk {
  places: PlaceTable
  // The values that started a sharing, which the fix wraps in copy(...).
  origins: Array<Expr>
  state: FlowState
  sites: Array<WriteSite>
  // The site of each write, by its position, place text and kind.
  siteIndex: Map<int, int>
  reported: Map<int, bool>
  found: Array<FoundWrite>
  // The states that leave the innermost loop or `continue` it.
  breakState: FlowState
  continueState: FlowState
  // Inside a block expression, `return` gives its value: these shares and
  // the states that reach its end.
  inBlockValue: bool
  blockShares: Array<ValueShare>
  blockExit: FlowState
  // The arrow function depth each local is declared at.
  arrowDepth: int
  localDepths: Map<int, int>
  // The hidden local of `for (const <pattern> of xs)`: what each element shares.
  hiddenLoops: Map<int, Array<ValueShare>>
  // `for (mutable item of xs)`: item stands for an element of xs.
  references: Map<int, Place>
  // The places the `for ... of` loops around the current statement iterate:
  // the loop's iterator holds each of them until the loop ends.
  loopHeld: Array<Place>
  // The line where each `const` or `let` local's block ends while the block
  // runs, else -1.
  scopeEnds: Array<int>
  // Writes that hit a local before its block ends. Each is reported unless
  // a later use reports its site first.
  heldWrites: Array<FoundWrite>
}

// How a write reaches a place: an assignment copies the places above it; a
// std function's `mutable` argument changes the container itself; any other
// `mutable` argument may change the place and everything inside it.
const WRITE_ASSIGN = 0
const WRITE_CONTAINER = 1
const WRITE_DEEP = 2

// The kinds of writes: `x = ...`, `x += ...`, `f(mutable x)`, an arrow function that changes x.
const SITE_ASSIGN = 0
const SITE_COMPOUND = 1
const SITE_CALL = 2
const SITE_ARROW = 3
const SITE_KINDS = 4

// The most pairs a body keeps; the rest are dropped.
const PAIR_LIMIT = 4000

// The kinds of a place's parts: a field, any element, an element at a literal index.
const PART_FIELD = 0
const PART_ANY = 1
const PART_INDEX = 2

// Keys of PlaceTable.childPlaces, FlowState.pairKeys and WriteWalk.siteIndex.
const PART_STRIDE = 1048576
const POSITION_STRIDE = 1048576
const PAIR_STRIDE = 4294967296

export function reportSharedWrites(mutable checker: Checker) uses alloc {
  // Runs once every body is checked, also when other errors were found. Each
  // body of a source module is walked with its side tables current; generic
  // instances repeat their declaration and are skipped.
  const savedBody = checker.body
  const savedScope = checker.current
  // A write that another error already points inside is not reported again.
  let errorPlaces: Map<string, Array<Pos>> = Map {}
  for (const error of Arrays.values(checker.errors)) {
    let positions: Array<Pos> = []
    if (errorPlaces[error.file] is Some(known)) {
      positions = copy(known)
    }
    Arrays.push(mutable positions, copy(error.pos))
    errorPlaces[error.file] = positions
  }
  let walk = createWalk()
  // The bodies of a module come one after another: the scope of the last
  // module looked up is kept.
  let lastModule = ""
  let lastScope = -1
  let hasLastModule = false
  for (const index of Ranges.upTo(Arrays.length(checker.bodies))) {
    if (Arrays.length(checker.bodies[index].typeArguments) > 0) {
      continue
    }
    const kind = checker.bodies[index].kind
    const root = checker.bodies[index].root
    let parameters: Array<Param> = []
    let walked: Option<Block> = None
    if (root is BodyRoot.RootFunc(declaration)) {
      if (kind == "func" || kind == "impl") {
        parameters = copy(declaration.parameters)
        walked = declaration.body
      }
    } else if (root is BodyRoot.RootBlock(block)) {
      if (kind == "test") {
        walked = Some(block)
      }
    }
    // A body with no write that can hit a pair cannot report anything.
    if (walked is Some(body)) {
      if (!canWriteInBlock(body)) {
        continue
      }
      const module = checker.bodies[index].module
      if (!hasLastModule || module != lastModule) {
        lastModule = module
        hasLastModule = true
        lastScope = -1
        if (checker.scopeIndex[module] is Some(scope)) {
          lastScope = scope
        }
      }
      if (lastScope < 0 || !checker.scopes[lastScope].isSource) {
        continue
      }
      checker.body = index
      checker.current = lastScope
      startBody(checker, mutable walk)
      for (const parameter of Arrays.values(parameters)) {
        noteDeclared(checker, mutable walk, parameter.id)
      }
      walkBlock(checker, mutable walk, body)
      reportFound(mutable checker, walk, errorPlaces)
    }
  }
  checker.body = savedBody
  checker.current = savedScope
}

function hasErrorInside(
  errorPlaces: Map<string, Array<Pos>>,
  file: string,
  site: WriteSite,
): bool uses alloc {
  if (errorPlaces[file] is Some(positions)) {
    for (const pos of Arrays.values(positions)) {
      if (isInsideSite(site, pos)) {
        return true
      }
    }
  }
  return false
}

function isInsideSite(site: WriteSite, pos: Pos): bool {
  // Whether pos is between the start of the written place and its end.
  if (pos.line < site.pos.line || (pos.line == site.pos.line && pos.column < site.pos.column)) {
    return false
  }
  return pos.line < site.end.line || (pos.line == site.end.line && pos.column <= site.end.column)
}

function findPlaceEnd(expression: Expr): Pos {
  // Where a written place ends, for the names, fields and indexes a place is made of.
  return match (expression) {
    Expr.Ident(_, pos, name) => Pos { line: pos.line, column: pos.column + Str.length(name) }
    Expr.IntLit(_, pos, text) => Pos { line: pos.line, column: pos.column + Str.length(text) }
    Expr.FieldExpr(_, _, target, name) => {
      const targetEnd = findPlaceEnd(target)
      return Pos { line: targetEnd.line, column: targetEnd.column + 1 + Str.length(name) }
    }
    Expr.IndexExpr(_, _, _, index) => {
      const indexEnd = findPlaceEnd(index)
      return Pos { line: indexEnd.line, column: indexEnd.column + 1 }
    }
    _ => findExpressionStart(expression)
  }
}

function createDeadState(): FlowState uses alloc {
  return FlowState { pairs: [], pairKeys: Map {}, pending: [], reachable: false }
}

function createLiveState(): FlowState uses alloc {
  return FlowState { pairs: [], pairKeys: Map {}, pending: [], reachable: true }
}

function createWalk(): WriteWalk uses alloc {
  return WriteWalk {
    places: PlaceTable {
      roots: [],
      parents: [],
      parts: [],
      depths: [],
      constantPlaces: Map {},
      childPlaces: Map {},
      partTable: PartTable {
        partIds: Map {},
        fieldParts: Map {},
        partKinds: [],
        partPieces: [],
        pieceIds: Map {},
        pieceTexts: [],
        indexPieces: Map {},
        shareAnswers: Map {},
      },
      textParents: [],
      textPieces: [],
      textChildren: Map {},
    },
    origins: [],
    state: createLiveState(),
    sites: [],
    siteIndex: Map {},
    reported: Map {},
    found: [],
    breakState: createDeadState(),
    continueState: createDeadState(),
    inBlockValue: false,
    blockShares: [],
    blockExit: createDeadState(),
    arrowDepth: 0,
    localDepths: Map {},
    hiddenLoops: Map {},
    references: Map {},
    loopHeld: [],
    scopeEnds: [],
    heldWrites: [],
  }
}

function startBody(checker: Checker, mutable walk: WriteWalk) uses alloc {
  // Each body starts with the place and the text of each local, whose ids
  // are the local's index; the part table stays.
  const localCount = Arrays.length(checker.bodies[checker.body].locals)
  let roots: Array<int> = Arrays.withCapacity(localCount)
  for (const local of Ranges.upTo(localCount)) {
    Arrays.push(mutable roots, local)
  }
  walk.places.roots = roots
  walk.places.parents = filledArray(-1, localCount)
  walk.places.parts = filledArray(-1, localCount)
  walk.places.depths = filledArray(0, localCount)
  walk.places.textParents = filledArray(-1, localCount)
  walk.places.textPieces = filledArray(-1, localCount)
  walk.scopeEnds = filledArray(-1, localCount)
  walk.state = createLiveState()
  walk.inBlockValue = false
  walk.arrowDepth = 0
  // Most bodies leave most tables empty; those are kept as they are.
  if (Maps.size(walk.places.constantPlaces) > 0) {
    walk.places.constantPlaces = Map {}
  }
  if (Maps.size(walk.places.childPlaces) > 0) {
    walk.places.childPlaces = Map {}
  }
  if (Maps.size(walk.places.textChildren) > 0) {
    walk.places.textChildren = Map {}
  }
  if (Arrays.length(walk.origins) > 0) {
    walk.origins = []
  }
  if (Arrays.length(walk.sites) > 0) {
    walk.sites = []
    walk.siteIndex = Map {}
  }
  if (Maps.size(walk.reported) > 0) {
    walk.reported = Map {}
  }
  if (Arrays.length(walk.found) > 0) {
    walk.found = []
  }
  if (Arrays.length(walk.heldWrites) > 0) {
    walk.heldWrites = []
  }
  if (!isEmptyDeadState(walk.breakState)) {
    walk.breakState = createDeadState()
  }
  if (!isEmptyDeadState(walk.continueState)) {
    walk.continueState = createDeadState()
  }
  if (!isEmptyDeadState(walk.blockExit)) {
    walk.blockExit = createDeadState()
  }
  if (Arrays.length(walk.blockShares) > 0) {
    walk.blockShares = []
  }
  if (Maps.size(walk.localDepths) > 0) {
    walk.localDepths = Map {}
  }
  if (Maps.size(walk.hiddenLoops) > 0) {
    walk.hiddenLoops = Map {}
  }
  if (Maps.size(walk.references) > 0) {
    walk.references = Map {}
  }
  if (Arrays.length(walk.loopHeld) > 0) {
    walk.loopHeld = []
  }
}

function isEmptyDeadState(state: FlowState): bool {
  return !state.reachable &&
    Arrays.length(state.pairs) == 0 &&
    Arrays.length(state.pending) == 0 &&
    Maps.size(state.pairKeys) == 0
}

// ---- Places

function findPart(mutable places: PlaceTable, key: string): int uses alloc {
  // The id of a part, by its key text (".items", "[]", "[=2]").
  if (places.partTable.partIds[key] is Some(known)) {
    return known
  }
  let kind = PART_FIELD
  let text = key
  if (key == "[]") {
    kind = PART_ANY
  } else if (Str.startsWith(key, "[=")) {
    kind = PART_INDEX
    text = `[${Str.sliceFrom(key, 2)}`
  }
  const part = Arrays.length(places.partTable.partKinds)
  const piece = findPiece(mutable places, text)
  Arrays.push(mutable places.partTable.partKinds, kind)
  Arrays.push(mutable places.partTable.partPieces, piece)
  places.partTable.partIds[key] = part
  return part
}

function findFieldPart(mutable places: PlaceTable, name: string): int uses alloc {
  if (places.partTable.fieldParts[name] is Some(known)) {
    return known
  }
  const part = findPart(mutable places, `.${name}`)
  places.partTable.fieldParts[name] = part
  return part
}

function findConstantPlace(mutable places: PlaceTable, root: int): int uses alloc {
  if (places.constantPlaces[root] is Some(known)) {
    return known
  }
  const id = Arrays.length(places.roots)
  Arrays.push(mutable places.roots, root)
  Arrays.push(mutable places.parents, -1)
  Arrays.push(mutable places.parts, -1)
  Arrays.push(mutable places.depths, 0)
  places.constantPlaces[root] = id
  return id
}

function findChildPlace(mutable places: PlaceTable, parent: int, part: int): int uses alloc {
  const key = parent * PART_STRIDE + part
  if (places.childPlaces[key] is Some(known)) {
    return known
  }
  const id = Arrays.length(places.roots)
  const root = places.roots[parent]
  const depth = places.depths[parent] + 1
  Arrays.push(mutable places.roots, root)
  Arrays.push(mutable places.parents, parent)
  Arrays.push(mutable places.parts, part)
  Arrays.push(mutable places.depths, depth)
  places.childPlaces[key] = id
  return id
}

function findPiece(mutable places: PlaceTable, text: string): int uses alloc {
  if (places.partTable.pieceIds[text] is Some(known)) {
    return known
  }
  const piece = Arrays.length(places.partTable.pieceTexts)
  Arrays.push(mutable places.partTable.pieceTexts, text)
  places.partTable.pieceIds[text] = piece
  return piece
}

function findText(mutable places: PlaceTable, parent: int, piece: int): int uses alloc {
  // The id of a message text: parent's text (-1 for none) and one piece after it.
  const key = (parent + 1) * PART_STRIDE + piece
  if (places.textChildren[key] is Some(known)) {
    return known
  }
  const text = Arrays.length(places.textParents)
  Arrays.push(mutable places.textParents, parent)
  Arrays.push(mutable places.textPieces, piece)
  places.textChildren[key] = text
  return text
}

function findNameText(mutable places: PlaceTable, name: string): int uses alloc {
  const piece = findPiece(mutable places, name)
  return findText(mutable places, -1, piece)
}

function writeText(checker: Checker, places: PlaceTable, text: int): string uses alloc {
  // The pieces from the root name to text, joined. A text without a piece
  // is the name of the local with its index.
  let chain: Array<int> = []
  let current = text
  while (current >= 0) {
    Arrays.push(mutable chain, current)
    current = places.textParents[current]
  }
  let builder = Str.builder()
  let index = Arrays.length(chain) - 1
  while (index >= 0) {
    const piece = places.textPieces[chain[index]]
    if (piece < 0) {
      Str.append(mutable builder, checker.bodies[checker.body].locals[chain[index]].name)
    } else {
      Str.append(mutable builder, places.partTable.pieceTexts[piece])
    }
    index--
  }
  return Str.build(builder)
}

function isUnder(places: PlaceTable, key: int, base: int): bool {
  // key names base or a place inside it.
  if (key == base) {
    return true
  }
  if (places.roots[key] != places.roots[base]) {
    return false
  }
  const baseDepth = places.depths[base]
  if (places.depths[key] < baseDepth) {
    return false
  }
  // Climb key to base's depth, then compare the parts of both up to the
  // first place they have in common.
  let keyPlace = key
  while (places.depths[keyPlace] > baseDepth) {
    keyPlace = places.parents[keyPlace]
  }
  let basePlace = base
  while (keyPlace != basePlace) {
    if (!isSamePart(places, places.parts[keyPlace], places.parts[basePlace])) {
      return false
    }
    keyPlace = places.parents[keyPlace]
    basePlace = places.parents[basePlace]
  }
  return true
}

function isStrictlyUnder(places: PlaceTable, key: int, base: int): bool {
  return places.depths[key] > places.depths[base] && isUnder(places, key, base)
}

function isSamePart(places: PlaceTable, left: int, right: int): bool {
  if (left == right) {
    return true
  }
  // Any element matches an element at a literal index; two different
  // literal indexes never match.
  const leftKind = places.partTable.partKinds[left]
  const rightKind = places.partTable.partKinds[right]
  if (leftKind == PART_ANY) {
    return rightKind != PART_FIELD
  }
  if (rightKind == PART_ANY) {
    return leftKind != PART_FIELD
  }
  return false
}

function overlaps(places: PlaceTable, left: int, right: int): bool {
  return isUnder(places, left, right) || isUnder(places, right, left)
}

function extendByPart(mutable places: PlaceTable, place: Place, part: int): Place uses alloc {
  const id = findChildPlace(mutable places, place.id, part)
  const piece = places.partTable.partPieces[part]
  const text = findText(mutable places, place.text, piece)
  return Place { root: place.root, id: id, text: text }
}

function extendPlace(
  mutable places: PlaceTable,
  place: Place,
  suffix: string,
): Place from place uses alloc {
  // suffix is a run of parts: ".items[]", "[=0].name".
  if (suffix == "") {
    return place
  }
  let extended = place
  let start = 0
  for (const i of Ranges.between(1, Str.length(suffix) + 1)) {
    if (i < Str.length(suffix)) {
      const character = substring(suffix, i, i + 1)
      if (character != "." && character != "[") {
        continue
      }
    }
    const part = findPart(mutable places, substring(suffix, start, i))
    extended = extendByPart(mutable places, extended, part)
    start = i
  }
  return extended
}

function extendPlaceByRest(
  mutable places: PlaceTable,
  place: Place,
  key: int,
  base: int,
): Place from place uses alloc {
  // place with the parts of key after base's depth (key is under base).
  let rest: Array<int> = []
  let current = key
  while (places.depths[current] > places.depths[base]) {
    Arrays.push(mutable rest, places.parts[current])
    current = places.parents[current]
  }
  let extended = place
  let index = Arrays.length(rest) - 1
  while (index >= 0) {
    extended = extendByPart(mutable places, extended, rest[index])
    index--
  }
  return extended
}

function createLocalPlace(local: int): Place {
  return Place { root: local, id: local, text: local }
}

function findLocalRef(checker: Checker, nodeId: int): int {
  if (getRef(checker, nodeId) is Ref.Local(local)) {
    return local
  }
  return -1
}

function findNamedPlace(mutable walk: WriteWalk, ref: Ref, name: string): Option<Place> uses alloc {
  match (ref) {
    Ref.Local(local) => {
      if (walk.references[local] is Some(element)) {
        // The name stands for the element, and messages say the name.
        return Some(Place { root: element.root, id: element.id, text: local })
      }
      if (walk.hiddenLoops[local] is Some(_)) {
        return None
      }
      return Some(createLocalPlace(local))
    }
    Ref.Const(index) => {
      const root = -2 - index
      const id = findConstantPlace(mutable walk.places, root)
      // The text is the name the body wrote, so two aliases of one constant keep their own names.
      const text = findNameText(mutable walk.places, name)
      return Some(Place { root: root, id: id, text: text })
    }
    _ => {
      return None
    }
  }
}

function findPlace(
  checker: Checker,
  mutable walk: WriteWalk,
  expression: Expr,
): Option<Place> uses alloc {
  // The place an expression names: a local or a constant, then fields and elements.
  match (expression) {
    Expr.Ident(nodeId, _, name) => {
      return findNamedPlace(mutable walk, getRef(checker, nodeId), name)
    }
    Expr.FieldExpr(_, _, target, name) => {
      if (findPlace(checker, mutable walk, target) is Some(base)) {
        const part = findFieldPart(mutable walk.places, name)
        return Some(extendByPart(mutable walk.places, base, part))
      }
      return None
    }
    Expr.IndexExpr(_, _, target, index) => {
      if (findPlace(checker, mutable walk, target) is Some(container)) {
        // The text says the index as written; the part says only whether it is a literal.
        const part = findPart(mutable walk.places, writeIndexKey(index))
        const piece = findIndexPiece(mutable walk.places, index)
        const id = findChildPlace(mutable walk.places, container.id, part)
        const text = findText(mutable walk.places, container.text, piece)
        return Some(Place { root: container.root, id: id, text: text })
      }
      return None
    }
    _ => {
      return None
    }
  }
}

function findIndexPiece(mutable places: PlaceTable, index: Expr): int uses alloc {
  const written = writeIndexText(index)
  if (places.partTable.indexPieces[written] is Some(known)) {
    return known
  }
  const piece = findPiece(mutable places, `[${written}]`)
  places.partTable.indexPieces[written] = piece
  return piece
}

function writeIndexKey(index: Expr): string uses alloc {
  // An integer literal names one element; any other index may name any.
  if (index is Expr.IntLit(_, _, text)) {
    if (Int.parse(text, 10) is Ok(value)) {
      return `[=${Int.toString(value)}]`
    }
  }
  return "[]"
}

function writeIndexText(index: Expr): string uses alloc {
  return match (index) {
    Expr.Ident(_, _, name) => name
    Expr.IntLit(_, _, text) => text
    Expr.StringLit(_, _, value, _) => `"${value}"`
    Expr.FieldExpr(_, _, target, name) => `${writeIndexText(target)}.${name}`
    _ => "..."
  }
}

function writeCalleeText(callee: Expr): string uses alloc {
  return match (callee) {
    Expr.Ident(_, _, name) => name
    Expr.FieldExpr(_, _, target, name) => `${writeCalleeText(target)}.${name}`
    _ => "the call"
  }
}

// ---- The state

function makePairKey(first: int, second: int): int {
  // The same key for both orders of a pair's places.
  if (first < second) {
    return first * PAIR_STRIDE + second
  }
  return second * PAIR_STRIDE + first
}

function hasPending(pending: Array<PendingWrite>, site: int, other: int): bool {
  for (const write of Arrays.values(pending)) {
    if (write.site == site && write.other.id == other) {
      return true
    }
  }
  return false
}

function mergeInto(mutable into: FlowState, other: FlowState) uses alloc {
  // into becomes the merge of both states: its pairs and pending writes, then
  // the ones only other has.
  if (!other.reachable) {
    return
  }
  if (!into.reachable) {
    // The caller keeps other, so into takes copies.
    into.pairs = copy(other.pairs)
    into.pairKeys = copy(other.pairKeys)
    into.pending = copy(other.pending)
    into.reachable = true
    return
  }
  for (const pair of Arrays.values(other.pairs)) {
    const key = makePairKey(pair.first.id, pair.second.id)
    if (into.pairKeys[key] is None) {
      Arrays.push(mutable into.pairs, pair)
      into.pairKeys[key] = true
    }
  }
  for (const write of Arrays.values(other.pending)) {
    if (!hasPending(into.pending, write.site, write.other.id)) {
      Arrays.push(mutable into.pending, write)
    }
  }
}

function measureState(state: FlowState): int {
  return Arrays.length(state.pairs) + Arrays.length(state.pending)
}

function addOrigin(mutable walk: WriteWalk, origin: Option<Expr>): int uses alloc {
  if (origin is Some(value)) {
    Arrays.push(mutable walk.origins, value)
    return Arrays.length(walk.origins) - 1
  }
  return -1
}

function pushPair(
  mutable walk: WriteWalk,
  first: Place,
  second: Place,
  origin: int,
  tracked: bool,
) uses alloc {
  if (first.root == second.root || Arrays.length(walk.state.pairs) >= PAIR_LIMIT) {
    return
  }
  const key = makePairKey(first.id, second.id)
  if (walk.state.pairKeys[key] is Some(_)) {
    return
  }
  walk.state.pairKeys[key] = true
  Arrays.push(mutable walk.state.pairs, SharePair {
    first: first,
    second: second,
    origin: origin,
    tracked: tracked,
  })
}

function addPair(
  mutable walk: WriteWalk,
  name: Place,
  source: Place,
  origin: int,
  tracked: bool,
) uses alloc {
  // Sharing goes through chains: after `const b = a; const c = b` all three
  // share, and `const items = a.items` shares with whatever shares `a`.
  const count = Arrays.length(walk.state.pairs)
  for (const index of Ranges.upTo(count)) {
    // A pair with no side on the source's root reaches nothing here.
    const pair = copy(walk.state.pairs[index])
    if (pair.first.root != source.root && pair.second.root != source.root) {
      continue
    }
    addChained(mutable walk, name, source, pair.first, pair.second, origin, tracked, pair.tracked)
    addChained(mutable walk, name, source, pair.second, pair.first, origin, tracked, pair.tracked)
  }
  pushPair(mutable walk, name, source, origin, tracked)
}

function addChained(
  mutable walk: WriteWalk,
  name: Place,
  source: Place,
  side: Place,
  other: Place,
  origin: int,
  tracked: bool,
  sideTracked: bool,
) uses alloc {
  if (isUnder(walk.places, source.id, side.id)) {
    // The source is inside a place that shares other.
    const extended = extendPlaceByRest(mutable walk.places, other, source.id, side.id)
    pushPair(mutable walk, name, extended, origin, tracked)
  } else if (isStrictlyUnder(walk.places, side.id, source.id)) {
    // A part of the source shares other.
    const extended = extendPlaceByRest(mutable walk.places, name, side.id, source.id)
    pushPair(mutable walk, extended, other, origin, sideTracked)
  }
}

function hasRootPair(pairs: Array<SharePair>, root: int): bool {
  for (const pair of Arrays.values(pairs)) {
    if (pair.first.root == root || pair.second.root == root) {
      return true
    }
  }
  return false
}

function hasRootPending(pending: Array<PendingWrite>, root: int): bool {
  for (const write of Arrays.values(pending)) {
    if (write.other.root == root) {
      return true
    }
  }
  return false
}

function forgetRoot(mutable walk: WriteWalk, local: int) uses alloc {
  // A name bound again starts with no pairs, and earlier writes no longer wait for it.
  if (hasRootPair(walk.state.pairs, local)) {
    let pairs: Array<SharePair> = Arrays.withCapacity(Arrays.length(walk.state.pairs))
    for (const pair of Arrays.values(walk.state.pairs)) {
      if (pair.first.root != local && pair.second.root != local) {
        Arrays.push(mutable pairs, pair)
      } else {
        const _ = Maps.remove(
          mutable walk.state.pairKeys,
          makePairKey(pair.first.id, pair.second.id),
        )
      }
    }
    walk.state.pairs = pairs
  }
  if (!hasRootPending(walk.state.pending, local)) {
    return
  }
  let pending: Array<PendingWrite> = Arrays.withCapacity(Arrays.length(walk.state.pending))
  for (const write of Arrays.values(walk.state.pending)) {
    if (write.other.root != local) {
      Arrays.push(mutable pending, write)
    }
  }
  walk.state.pending = pending
}

function noteDeclared(checker: Checker, mutable walk: WriteWalk, nodeId: int) uses alloc {
  const body = checker.bodies[checker.body]
  const slot = findBodySlot(body, nodeId)
  if (slot >= 0 && body.declared[slot] >= 0) {
    declareLocal(mutable walk, body.declared[slot])
  }
}

function findDeclared(checker: Checker, nodeId: int): int {
  const body = checker.bodies[checker.body]
  const slot = findBodySlot(body, nodeId)
  if (slot < 0) {
    return -1
  }
  return body.declared[slot]
}

function declareLocal(mutable walk: WriteWalk, local: int) uses alloc {
  walk.localDepths[local] = walk.arrowDepth
  forgetRoot(mutable walk, local)
}

function canHoldShared(checker: Checker, mutable walk: WriteWalk, type: Type): bool uses alloc {
  // A function value holds what its arrow function captured, so a call of it
  // uses those values.
  if (type is Type.TFunc(_, _, _, _, _)) {
    return true
  }
  return canShareKnown(checker, mutable walk, type)
}

function canShareKnown(checker: Checker, mutable walk: WriteWalk, type: Type): bool uses alloc {
  // canShareType, keeping the answer for each enum; any other type can share
  // when it is tracked.
  if (type is Type.TEnum(index)) {
    if (walk.places.partTable.shareAnswers[index] is Some(known)) {
      return known
    }
    const answer = canShareType(checker, type)
    walk.places.partTable.shareAnswers[index] = answer
    return answer
  }
  return isCopyTracked(checker, type)
}

function bindShares(
  checker: Checker,
  mutable walk: WriteWalk,
  local: int,
  shares: Array<ValueShare>,
  origin: Option<Expr>,
) uses alloc {
  // Only a name whose type can hold a tracked value shares anything.
  if (Arrays.length(shares) == 0) {
    return
  }
  const localType = checker.bodies[checker.body].locals[local].localType
  if (!canHoldShared(checker, mutable walk, localType)) {
    return
  }
  const name = createLocalPlace(local)
  const originIndex = addOrigin(mutable walk, origin)
  const isTracked = isCopyTracked(checker, localType)
  for (const share of Arrays.values(shares)) {
    let tracked = share.tracked
    if (share.suffix == "") {
      tracked = isTracked
    }
    const extended = extendPlace(mutable walk.places, name, share.suffix)
    addPair(mutable walk, extended, share.place, originIndex, tracked)
  }
}

function bindPattern(
  checker: Checker,
  mutable walk: WriteWalk,
  pattern: Pattern,
  shares: Array<ValueShare>,
  origin: Option<Expr>,
) uses alloc {
  let locals: Array<int> = []
  collectPatternLocals(checker, pattern, mutable locals)
  for (const local of Arrays.values(locals)) {
    declareLocal(mutable walk, local)
    let whole: Array<ValueShare> = []
    for (const share of Arrays.values(shares)) {
      Arrays.push(mutable whole, ValueShare { suffix: "", place: share.place })
    }
    bindShares(checker, mutable walk, local, whole, origin)
  }
}

// ---- Liveness

function isCellType(checker: Checker, type: Type): bool {
  if (type is Type.TStruct(index)) {
    return checker.structs[index].name == "Cell" && checker.structs[index].module == "std/cell"
  }
  return false
}

function findLiveReason(checker: Checker, walk: WriteWalk, root: int): Option<LiveReason> {
  // The places that stay live whatever the body does next.
  if (root < 0) {
    return Some(LiveReason.Constant)
  }
  const info = checker.bodies[checker.body].locals[root]
  if (info.param) {
    return Some(LiveReason.Parameter)
  }
  let depth = 0
  if (walk.localDepths[root] is Some(known)) {
    depth = known
  }
  if (depth < walk.arrowDepth) {
    return Some(LiveReason.Captured)
  }
  if (isCellType(checker, info.localType)) {
    return Some(LiveReason.Cell)
  }
  return None
}

function addSite(mutable walk: WriteWalk, site: WriteSite): int uses alloc {
  // A write keeps one site however often a loop walks it, so the loop's state
  // stops growing once nothing new is shared.
  const position = site.pos.line * POSITION_STRIDE + site.pos.column
  const key = (position * PART_STRIDE + site.place) * SITE_KINDS + site.kind
  if (walk.siteIndex[key] is Some(known)) {
    return known
  }
  Arrays.push(mutable walk.sites, site)
  const index = Arrays.length(walk.sites) - 1
  walk.siteIndex[key] = index
  return index
}

function recordFound(
  mutable walk: WriteWalk,
  site: int,
  hit: Place,
  other: Place,
  reason: LiveReason,
  origin: int,
) uses alloc {
  if (walk.reported[site] is Some(_)) {
    return
  }
  walk.reported[site] = true
  Arrays.push(mutable walk.found, FoundWrite {
    site: site,
    hit: hit,
    other: other,
    reason: reason,
    origin: origin,
  })
}

function noteWrite(
  checker: Checker,
  mutable walk: WriteWalk,
  target: Place,
  mode: int,
  site: int,
) uses alloc {
  // Every pair the write reaches is separated by it. A pair with no side on
  // the target's root is out of its reach.
  if (hasRootPair(walk.state.pairs, target.root)) {
    let kept: Array<SharePair> = Arrays.withCapacity(Arrays.length(walk.state.pairs))
    for (const pair of Arrays.values(copy(walk.state.pairs))) {
      if (
        !isReached(walk.places, pair.first, target, mode) &&
          !isReached(walk.places, pair.second, target, mode)
      ) {
        Arrays.push(mutable kept, pair)
        continue
      }
      const _ = Maps.remove(mutable walk.state.pairKeys, makePairKey(pair.first.id, pair.second.id))
      checkHit(checker, mutable walk, target, mode, site, pair, pair.first, pair.second)
      checkHit(checker, mutable walk, target, mode, site, pair, pair.second, pair.first)
    }
    walk.state.pairs = kept
  }
  // The iterator of a running loop holds the place it walks.
  for (const held of Arrays.values(copy(walk.loopHeld))) {
    if (isHit(walk.places, target, mode, true, held)) {
      recordFound(mutable walk, site, held, held, LiveReason.Loop, -1)
    }
  }
}

function isElementTarget(places: PlaceTable, target: Place, mode: int): bool {
  // `items[i] = v` replaces one element: the other elements keep their sharing.
  return mode == WRITE_ASSIGN &&
    places.depths[target.id] > 0 &&
    places.partTable.partKinds[places.parts[target.id]] != PART_FIELD
}

function isHit(places: PlaceTable, target: Place, mode: int, tracked: bool, side: Place): bool {
  // The write copies side when side contains the target (an assignment
  // replaces the target itself), or when a deep write reaches inside side and
  // the shared value is changed in place.
  if (mode == WRITE_ASSIGN) {
    return isStrictlyUnder(places, target.id, side.id)
  }
  if (mode == WRITE_DEEP && tracked && isUnder(places, side.id, target.id)) {
    return true
  }
  return isUnder(places, target.id, side.id)
}

function checkHit(
  checker: Checker,
  mutable walk: WriteWalk,
  target: Place,
  mode: int,
  site: int,
  pair: SharePair,
  side: Place,
  other: Place,
) uses alloc {
  if (!isHit(walk.places, target, mode, pair.tracked, side)) {
    return
  }
  const origin = pair.origin
  if (findLiveReason(checker, walk, other.root) is Some(reason)) {
    recordFound(mutable walk, site, side, other, reason, origin)
    return
  }
  // A local holds the value until its block ends, so the write copies even
  // when no later use follows.
  const scopeEnd = walk.scopeEnds[other.root]
  if (scopeEnd >= 0 && canWriteCopy(checker, walk, target, mode, side, other, origin)) {
    Arrays.push(mutable walk.heldWrites, FoundWrite {
      site: site,
      hit: side,
      other: other,
      reason: LiveReason.ScopeEnd(scopeEnd),
      origin: origin,
    })
  }
  if (!hasPending(walk.state.pending, site, other.id)) {
    Arrays.push(mutable walk.state.pending, PendingWrite {
      site: site,
      hit: side,
      other: other,
      origin: origin,
    })
  }
}

function canWriteCopy(
  checker: Checker,
  walk: WriteWalk,
  target: Place,
  mode: int,
  side: Place,
  other: Place,
  origin: int,
): bool uses alloc {
  // A write copies the heap objects that side shares on its way to the
  // target: the arrays, maps and boxes on the path from side down to the
  // target, and for a `mutable` argument, the target and what it holds.
  // The shared value is at most what other holds and the value that
  // started the sharing.
  if (!canOriginCopy(checker, walk, origin)) {
    return false
  }
  const places = walk.places
  if (findPlaceType(checker, places, other.id) is Some(otherType)) {
    if (!holdsHeapValue(checker, otherType)) {
      return false
    }
  }
  if (isStrictlyUnder(places, target.id, side.id)) {
    let place = places.parents[target.id]
    while (place >= 0 && places.depths[place] >= places.depths[side.id]) {
      const placeType = findPlaceType(checker, places, place)
      if (placeType is None) {
        return true
      }
      if (isHeapObject(checker, placeType.value)) {
        return true
      }
      place = places.parents[place]
    }
    if (mode == WRITE_ASSIGN) {
      return false
    }
    const targetType = findPlaceType(checker, places, target.id)
    if (targetType is None) {
      return true
    }
    return holdsHeapValue(checker, targetType.value)
  }
  // The target holds side: a `mutable` argument may change anything inside it.
  const sideType = findPlaceType(checker, places, side.id)
  if (sideType is None) {
    return true
  }
  return holdsHeapValue(checker, sideType.value)
}

function findPlaceType(
  checker: Checker,
  places: PlaceTable,
  place: int,
): Option<Type> from checker uses alloc {
  // The type of a local's place, by its parts; None when a part is not a
  // struct field, an element or a map value.
  const parent = places.parents[place]
  const locals = checker.bodies[checker.body].locals
  if (parent < 0) {
    const root = places.roots[place]
    if (root < 0 || root >= Arrays.length(locals)) {
      return None
    }
    return Some(locals[root].localType)
  }
  const parentType = findPlaceType(checker, places, parent)
  if (parentType is None) {
    return None
  }
  const part = places.parts[place]
  if (places.partTable.partKinds[part] == PART_FIELD) {
    const text = places.partTable.pieceTexts[places.partTable.partPieces[part]]
    if (parentType.value is Type.TStruct(index)) {
      for (const field of Arrays.values(checker.structs[index].fields)) {
        if (`.${field.name}` == text) {
          return Some(field.fieldType)
        }
      }
    }
    return None
  }
  return match (parentType.value) {
    Type.TArray(element) => Some(element)
    Type.TFixedArray(element, _) => Some(element)
    Type.TMap(_, valueType) => Some(valueType)
    _ => None
  }
}

function isHeapObject(checker: Checker, type: Type): bool {
  // The values a write copies when they are shared.
  if (type is Type.TDistinct(index)) {
    if (checker.distincts[index].base is Some(base)) {
      return isHeapObject(checker, base)
    }
    return true
  }
  return match (type) {
    Type.TArray(_)
      | Type.TBox(_)
      | Type.TMap(_, _)
      | Type.TStringBuilder
      | Type.TGenerator(_, _, _, _, _)
      | Type.TParam(_) => true
    _ => false
  }
}

function canOriginCopy(checker: Checker, walk: WriteWalk, origin: int): bool uses alloc {
  // A write never copies a value with no array, map or box inside, such as
  // a struct of numbers. Holding one until the block ends costs nothing.
  if (origin < 0) {
    return true
  }
  if (getNodeType(checker, getExpressionId(walk.origins[origin])) is Some(originType)) {
    return holdsHeapValue(checker, originType)
  }
  return true
}

function holdsHeapValue(checker: Checker, type: Type): bool uses alloc {
  let visited: Map<int, bool> = Map {}
  return searchHeapValue(checker, type, mutable visited)
}

function searchHeapValue(
  checker: Checker,
  type: Type,
  mutable visited: Map<int, bool>,
): bool uses alloc {
  // An enum holds what its payloads hold: `Some(bag.items)` keeps the array
  // that bag.items names. An enum already visited adds nothing new.
  match (type) {
    Type.TArray(_)
      | Type.TBox(_)
      | Type.TMap(_, _)
      | Type.TStringBuilder
      | Type.TGenerator(_, _, _, _, _)
      | Type.TParam(_) => {
      return true
    }
    Type.TFixedArray(element, _) => {
      return searchHeapValue(checker, element, mutable visited)
    }
    Type.TDistinct(index) => {
      if (checker.distincts[index].base is Some(base)) {
        return searchHeapValue(checker, base, mutable visited)
      }
      return true
    }
    Type.TStruct(index) => {
      for (const field of Arrays.values(checker.structs[index].fields)) {
        if (searchHeapValue(checker, field.fieldType, mutable visited)) {
          return true
        }
      }
      for (const argument of Arrays.values(checker.structs[index].arguments)) {
        if (searchHeapValue(checker, argument, mutable visited)) {
          return true
        }
      }
      return false
    }
    Type.TEnum(index) => {
      if (visited[index] is Some(_)) {
        return false
      }
      visited[index] = true
      for (const variant of Arrays.values(checker.enums[index].variants)) {
        for (const field of Arrays.values(variant.fields)) {
          if (searchHeapValue(checker, field.fieldType, mutable visited)) {
            return true
          }
        }
      }
      return false
    }
    _ => {
      return false
    }
  }
}

function isReached(places: PlaceTable, side: Place, target: Place, mode: int): bool {
  if (mode == WRITE_CONTAINER) {
    return isUnder(places, target.id, side.id)
  }
  if (isElementTarget(places, target, mode)) {
    return isStrictlyUnder(places, target.id, side.id)
  }
  return overlaps(places, side.id, target.id)
}

function isUsedBy(places: PlaceTable, place: Place, inside: bool, write: PendingWrite): bool {
  if (inside) {
    return isStrictlyUnder(places, place.id, write.other.id)
  }
  return overlaps(places, place.id, write.other.id)
}

function isAnyPendingDone(walk: WriteWalk, place: Place, inside: bool): bool {
  // Whether a pending write is used by place now, or was reported since.
  for (const write of Arrays.values(walk.state.pending)) {
    if (isUsedBy(walk.places, place, inside, write) || walk.reported[write.site] is Some(_)) {
      return true
    }
  }
  return false
}

function noteUse(mutable walk: WriteWalk, place: Place, pos: Pos, inside: bool) uses alloc {
  // A read of a place that overlaps the other side of a pending write makes
  // it a shared write. A write inside the other side counts too (inside).
  if (Arrays.length(walk.state.pending) == 0) {
    return
  }
  if (!isAnyPendingDone(walk, place, inside)) {
    return
  }
  let kept: Array<PendingWrite> = []
  for (const write of Arrays.values(copy(walk.state.pending))) {
    if (isUsedBy(walk.places, place, inside, write)) {
      recordFound(
        mutable walk,
        write.site,
        write.hit,
        write.other,
        LiveReason.LaterUse(pos.line),
        write.origin,
      )
    } else if (walk.reported[write.site] is None) {
      Arrays.push(mutable kept, write)
    }
  }
  walk.state.pending = kept
}

function forgetPendingUnder(mutable walk: WriteWalk, target: Place) uses alloc {
  // A place assigned whole no longer holds the value an earlier write waited on.
  let kept: Array<PendingWrite> = []
  for (const write of Arrays.values(walk.state.pending)) {
    if (!isUnder(walk.places, write.other.id, target.id)) {
      Arrays.push(mutable kept, write)
    }
  }
  walk.state.pending = kept
}

// ---- Bodies that cannot report

function canWriteInBlock(block: Block): bool {
  for (const statement of Arrays.values(block.statements)) {
    if (canWriteInStatement(statement)) {
      return true
    }
  }
  return false
}

function canWriteInStatement(statement: Stmt): bool {
  // Whether the walk could note a write that hits a pair: an assignment to a
  // field or an element, a `mutable` argument, an arrow function, or a
  // `for (mutable ...)` loop, whose name stands for an element. It looks
  // where the walk looks.
  // A plain local assigned whole is skipped: its place has depth 0, and a
  // depth-0 place never satisfies isStrictlyUnder. A change to isHit or to
  // the references of `for (mutable ...)` must update this skip.
  return match (statement) {
    Stmt.BlockStmt(block) => canWriteInBlock(block)
    Stmt.VarStmt(_, _, _, _, _, _, value) => canWriteInExpression(value)
    Stmt.AssignStmt(_, target, value) =>
      isPartTarget(target) || canWriteInExpression(target) || canWriteInExpression(value)
    Stmt.CompoundAssignStmt(_, target, _, value) =>
      isPartTarget(target) || canWriteInExpression(target) || canWriteInExpression(value)
    Stmt.ExprStmt(_, expression) => canWriteInExpression(expression)
    Stmt.ReturnStmt(_, value) => canWriteInOptionalExpression(value)
    Stmt.IfStmt(_, condition, then, orElse) =>
      canWriteInExpression(condition) ||
      canWriteInBlock(then) ||
      canWriteInOptionalStatement(orElse)
    Stmt.WhileStmt(_, _, condition, body) =>
      canWriteInExpression(condition) || canWriteInBlock(body)
    Stmt.CForStmt(_, _, init, condition, step, body) =>
      canWriteInOptionalStatement(init) ||
      canWriteInOptionalExpression(condition) ||
      canWriteInOptionalStatement(step) ||
      canWriteInBlock(body)
    Stmt.ForStmt(_, _, _, _, iterable, body, reference) =>
      reference is Some(_) || canWriteInExpression(iterable) || canWriteInBlock(body)
    Stmt.YieldStmt(_, value, _, _) => canWriteInExpression(value)
    Stmt.BreakStmt(_, _) => false
    Stmt.ContinueStmt(_, _) => false
  }
}

function canWriteInOptionalStatement(statement: Option<Stmt>): bool {
  if (statement is Some(present)) {
    return canWriteInStatement(present)
  }
  return false
}

function canWriteInOptionalExpression(expression: Option<Expr>): bool {
  if (expression is Some(present)) {
    return canWriteInExpression(present)
  }
  return false
}

function isPartTarget(target: Expr): bool {
  return target is Expr.FieldExpr(_, _, _, _) || target is Expr.IndexExpr(_, _, _, _)
}

function canWriteInExpression(expression: Expr): bool {
  match (expression) {
    Expr.FieldExpr(_, _, target, _) => {
      return canWriteInExpression(target)
    }
    Expr.IndexExpr(_, _, target, index) => {
      return canWriteInExpression(target) || canWriteInExpression(index)
    }
    Expr.TemplateLit(_, _, parts) => {
      return canWriteInExpressions(parts)
    }
    Expr.IsExpr(_, _, subject, _) => {
      return canWriteInExpression(subject)
    }
    Expr.MapLit(_, _, _, keys, values) => {
      return canWriteInExpressions(keys) || canWriteInExpressions(values)
    }
    Expr.CallExpr(_, _, callee, _, arguments) => {
      if (canWriteInExpression(callee)) {
        return true
      }
      for (const argument of Arrays.values(arguments)) {
        if (argument.isMutable || canWriteInExpression(argument.value)) {
          return true
        }
      }
      return false
    }
    Expr.UnaryExpr(_, _, _, operand) => {
      return canWriteInExpression(operand)
    }
    Expr.BinaryExpr(_, _, _, left, right) => {
      return canWriteInExpression(left) || canWriteInExpression(right)
    }
    Expr.StructLit(_, _, _, _, fields, spread) => {
      for (const field of Arrays.values(fields)) {
        if (canWriteInExpression(field.value)) {
          return true
        }
      }
      return canWriteInOptionalExpression(spread)
    }
    Expr.ArrayLit(_, _, elements, _) => {
      return canWriteInExpressions(elements)
    }
    Expr.MatchExpr(_, _, subject, arms) => {
      if (canWriteInExpression(subject)) {
        return true
      }
      for (const arm of Arrays.values(arms)) {
        if (canWriteInOptionalExpression(arm.guard) || canWriteInOptionalExpression(arm.body)) {
          return true
        }
        if (arm.block is Some(armBlock)) {
          if (canWriteInBlock(armBlock)) {
            return true
          }
        }
      }
      return false
    }
    Expr.BlockExpr(_, _, block) => {
      return canWriteInBlock(block)
    }
    Expr.ArrowExpr(_, _, _, _, _, _) => {
      return true
    }
    _ => {
      return false
    }
  }
}

function canWriteInExpressions(expressions: Array<Expr>): bool {
  for (const expression of Arrays.values(expressions)) {
    if (canWriteInExpression(expression)) {
      return true
    }
  }
  return false
}

// ---- Statements

function walkBlock(checker: Checker, mutable walk: WriteWalk, block: Block) uses alloc {
  let scoped: Array<int> = []
  for (const statement of Arrays.values(block.statements)) {
    walkStatement(checker, mutable walk, statement)
    // A `const` or `let` holds its value until the block ends.
    if (statement is Stmt.VarStmt(_, _, _, _, _, _, _)) {
      const first = Arrays.length(scoped)
      collectScopedLocals(checker, statement, mutable scoped)
      for (const index of Ranges.between(first, Arrays.length(scoped))) {
        walk.scopeEnds[scoped[index]] = block.end.line
      }
    }
  }
  // The block's locals are released at its end, and their sharing with them.
  for (const local of Arrays.values(scoped)) {
    walk.scopeEnds[local] = -1
    forgetRoot(mutable walk, local)
  }
}

function collectConditionLocals(
  checker: Checker,
  condition: Expr,
  mutable locals: Array<int>,
) uses alloc {
  // The names an `is` binds where the condition is true, when its subject
  // is a fresh value. A place keeps its value itself.
  if (condition is Expr.IsExpr(_, _, subject, pattern)) {
    if (!isPlaceExpression(subject)) {
      collectPatternLocals(checker, pattern, mutable locals)
    }
  } else if (condition is Expr.BinaryExpr(_, _, operator, left, right)) {
    if (operator == "&&") {
      collectConditionLocals(checker, left, mutable locals)
      collectConditionLocals(checker, right, mutable locals)
    }
  }
}

function isPlaceExpression(expression: Expr): bool {
  return match (expression) {
    Expr.Ident(_, _, _) => true
    Expr.FieldExpr(_, _, target, _) => isPlaceExpression(target)
    Expr.IndexExpr(_, _, target, _) => isPlaceExpression(target)
    _ => false
  }
}

function holdBindings(mutable walk: WriteWalk, locals: Array<int>, line: int) {
  for (const local of Arrays.values(locals)) {
    walk.scopeEnds[local] = line
  }
}

function releaseBindings(mutable walk: WriteWalk, locals: Array<int>) {
  for (const local of Arrays.values(locals)) {
    walk.scopeEnds[local] = -1
  }
}

function collectScopedLocals(
  checker: Checker,
  statement: Stmt,
  mutable locals: Array<int>,
) uses alloc {
  if (statement is Stmt.VarStmt(nodeId, _, _, _, pattern, _, _)) {
    if (pattern is Some(bound)) {
      collectPatternLocals(checker, bound, mutable locals)
    } else {
      const local = findDeclared(checker, nodeId)
      if (local >= 0) {
        Arrays.push(mutable locals, local)
      }
    }
  }
}

function walkStatement(checker: Checker, mutable walk: WriteWalk, statement: Stmt) uses alloc {
  match (statement) {
    Stmt.BlockStmt(block) => walkBlock(checker, mutable walk, block)
    Stmt.VarStmt(nodeId, _, _, _, pattern, _, value) => {
      const shares = evaluateBound(checker, mutable walk, value)
      if (pattern is Some(bound)) {
        bindPattern(checker, mutable walk, bound, shares, Some(value))
      } else {
        const local = findDeclared(checker, nodeId)
        if (local >= 0) {
          declareLocal(mutable walk, local)
          bindShares(checker, mutable walk, local, shares, Some(value))
        }
      }
    }
    Stmt.AssignStmt(_, target, value) => walkAssign(checker, mutable walk, target, value)
    Stmt.CompoundAssignStmt(_, target, operator, value) => {
      evaluateIgnored(checker, mutable walk, value)
      evaluatePlaceParts(checker, mutable walk, target)
      if (findPlace(checker, mutable walk, target) is Some(place)) {
        noteUse(mutable walk, place, findExpressionStart(target), false)
        const site = addSite(mutable walk, WriteSite {
          pos: findExpressionStart(target),
          end: findPlaceEnd(target),
          kind: SITE_COMPOUND,
          place: place.text,
          operator: operator,
        })
        noteWrite(checker, mutable walk, place, WRITE_ASSIGN, site)
      }
    }
    Stmt.ExprStmt(_, expression) => {
      evaluateIgnored(checker, mutable walk, expression)
    }
    Stmt.ReturnStmt(_, value) => {
      if (value is Some(returned)) {
        const shares = evaluate(checker, mutable walk, returned)
        if (walk.inBlockValue) {
          for (const share of Arrays.values(shares)) {
            Arrays.push(mutable walk.blockShares, share)
          }
        }
      }
      const returning = walk.state
      walk.state = createDeadState()
      if (walk.inBlockValue) {
        mergeInto(mutable walk.blockExit, returning)
      }
    }
    Stmt.IfStmt(_, condition, then, orElse) => {
      evaluateIgnored(checker, mutable walk, condition)
      // The bindings of an `is` on a fresh value hold it until the block ends.
      let bound: Array<int> = []
      collectConditionLocals(checker, condition, mutable bound)
      holdBindings(mutable walk, bound, then.end.line)
      const start = copy(walk.state)
      walkBlock(checker, mutable walk, then)
      releaseBindings(mutable walk, bound)
      let afterThen = walk.state
      walk.state = copy(start)
      if (orElse is Some(other)) {
        walkStatement(checker, mutable walk, other)
      }
      mergeInto(mutable afterThen, walk.state)
      walk.state = afterThen
    }
    Stmt.WhileStmt(_, _, condition, body) => walkLoop(
      checker,
      mutable walk,
      Some(condition),
      None,
      body,
      -1,
      [],
    )
    Stmt.CForStmt(_, _, init, condition, step, body) => {
      if (init is Some(first)) {
        walkStatement(checker, mutable walk, first)
      }
      walkLoop(checker, mutable walk, condition, step, body, -1, [])
    }
    Stmt.ForStmt(nodeId, _, _, name, iterable, body, reference) => {
      const shares = evaluateIterable(checker, mutable walk, iterable)
      const local = findDeclared(checker, nodeId)
      const outerHeld = copy(walk.loopHeld)
      // A `for (mutable ...)` loop writes its elements in place; any other
      // loop's iterator holds what it walks while the body runs.
      if (reference is None) {
        let held = copy(outerHeld)
        for (const share of Arrays.values(shares)) {
          if (share.suffix == "[]") {
            Arrays.push(mutable held, removeElement(walk.places, share.place))
          }
        }
        walk.loopHeld = held
      }
      if (local < 0) {
        walkLoop(checker, mutable walk, None, None, body, -1, [])
      } else if (reference is Some(_)) {
        // The name is the element itself: a write through it writes the element.
        declareLocal(mutable walk, local)
        if (Arrays.length(shares) > 0 && shares[0].suffix == "[]") {
          walk.references[local] = shares[0].place
        }
        walkLoop(checker, mutable walk, None, None, body, -1, [])
      } else if (Str.startsWith(name, "__for_")) {
        declareLocal(mutable walk, local)
        walk.hiddenLoops[local] = copy(shares)
        walkLoop(checker, mutable walk, None, None, body, -1, [])
      } else {
        walkLoop(checker, mutable walk, None, None, body, local, shares)
      }
      walk.loopHeld = outerHeld
    }
    Stmt.YieldStmt(_, value, _, binding) => {
      evaluateIgnored(checker, mutable walk, value)
      if (binding is Some(input)) {
        noteDeclared(checker, mutable walk, input.id)
      }
    }
    Stmt.BreakStmt(_, _) => {
      const leaving = walk.state
      walk.state = createDeadState()
      mergeInto(mutable walk.breakState, leaving)
    }
    Stmt.ContinueStmt(_, _) => {
      const continuing = walk.state
      walk.state = createDeadState()
      mergeInto(mutable walk.continueState, continuing)
    }
  }
}

function walkAssign(
  checker: Checker,
  mutable walk: WriteWalk,
  target: Expr,
  value: Expr,
) uses alloc {
  const shares = evaluate(checker, mutable walk, value)
  evaluatePlaceParts(checker, mutable walk, target)
  if (findPlace(checker, mutable walk, target) is Some(place)) {
    const start = findExpressionStart(target)
    // A write inside a name that a pending write waits on keeps that name live.
    noteUse(mutable walk, place, start, true)
    const site = addSite(mutable walk, WriteSite {
      pos: start,
      end: findPlaceEnd(target),
      kind: SITE_ASSIGN,
      place: place.text,
    })
    noteWrite(checker, mutable walk, place, WRITE_ASSIGN, site)
    // The place now holds the new value: the old sharing ends, the new one
    // starts. One element of many keeps the others' sharing.
    if (!isElementTarget(walk.places, place, WRITE_ASSIGN)) {
      forgetPendingUnder(mutable walk, place)
    }
    let isTracked = true
    if (getNodeType(checker, getExpressionId(value)) is Some(valueType)) {
      if (!canHoldShared(checker, mutable walk, valueType)) {
        return
      }
      isTracked = isCopyTracked(checker, valueType)
    }
    if (Arrays.length(shares) == 0) {
      return
    }
    const originIndex = addOrigin(mutable walk, Some(value))
    for (const share of Arrays.values(shares)) {
      let tracked = share.tracked
      if (share.suffix == "") {
        tracked = isTracked
      }
      const extended = extendPlace(mutable walk.places, place, share.suffix)
      addPair(mutable walk, extended, share.place, originIndex, tracked)
    }
    return
  }
  evaluateIgnored(checker, mutable walk, target)
}

function walkLoop(
  checker: Checker,
  mutable walk: WriteWalk,
  condition: Option<Expr>,
  step: Option<Stmt>,
  body: Block,
  local: int,
  shares: Array<ValueShare>,
) uses alloc {
  // The body runs again with what its last run left, until nothing new is
  // shared or pending. The loop ends at its head or at a `break`.
  const outerBreak = walk.breakState
  const outerContinue = walk.continueState
  let head = walk.state
  let exits = createDeadState()
  // Each round can carry a sharing one assignment further, so a chain through
  // every local of the body settles within that many rounds.
  const rounds = Arrays.length(checker.bodies[checker.body].locals) + 1
  let round = 0
  while (round < rounds) {
    walk.state = copy(head)
    walk.breakState = createDeadState()
    walk.continueState = createDeadState()
    if (condition is Some(loopCondition)) {
      evaluateIgnored(checker, mutable walk, loopCondition)
    }
    mergeInto(mutable exits, walk.state)
    if (local >= 0) {
      declareLocal(mutable walk, local)
      let elements: Array<ValueShare> = []
      for (const share of Arrays.values(shares)) {
        Arrays.push(mutable elements, ValueShare { suffix: "", place: share.place })
      }
      bindShares(checker, mutable walk, local, elements, None)
      // A loop over a fresh value: the binding holds its element until the body ends.
      if (Arrays.length(shares) == 0) {
        holdBindings(mutable walk, [local], body.end.line)
      }
    }
    walkBlock(checker, mutable walk, body)
    if (local >= 0) {
      releaseBindings(mutable walk, [local])
    }
    const continued = copy(walk.continueState)
    mergeInto(mutable walk.state, continued)
    if (step is Some(next)) {
      walkStatement(checker, mutable walk, next)
    }
    mergeInto(mutable exits, walk.breakState)
    const before = measureState(head)
    mergeInto(mutable head, walk.state)
    if (measureState(head) == before) {
      round = rounds
    } else {
      round++
    }
  }
  walk.state = exits
  walk.breakState = outerBreak
  walk.continueState = outerContinue
}

// ---- Expressions

function evaluateBound(
  checker: Checker,
  mutable walk: WriteWalk,
  value: Expr,
): Array<ValueShare> from walk uses alloc {
  // The element a `for (const <pattern> of xs)` loop binds through its hidden local.
  if (value is Expr.Ident(nodeId, _, _)) {
    const local = findLocalRef(checker, nodeId)
    if (local >= 0) {
      if (walk.hiddenLoops[local] is Some(shares)) {
        return shares
      }
    }
  }
  return evaluate(checker, mutable walk, value)
}

function evaluateIterable(
  checker: Checker,
  mutable walk: WriteWalk,
  iterable: Expr,
): Array<ValueShare> from walk uses alloc {
  // A loop over copy(items) walks a value nothing else shares.
  if (isCopyCall(checker, iterable)) {
    evaluateIgnored(checker, mutable walk, iterable)
    return []
  }
  // The elements of `Arrays.values(items)` and the other std iterators share
  // the elements of what they walk; a generator's values share the generator.
  if (iterable is Expr.CallExpr(nodeId, _, _, _, arguments)) {
    if (getRef(checker, nodeId) is Ref.Builtin(_)) {
      let shares: Array<ValueShare> = []
      for (const argument of Arrays.values(arguments)) {
        for (const share of Arrays.values(evaluate(checker, mutable walk, argument.value))) {
          if (share.suffix == "") {
            Arrays.push(mutable shares, ValueShare {
              suffix: "[]",
              place: extendPlace(mutable walk.places, share.place, "[]"),
            })
          }
        }
      }
      return shares
    }
  }
  // An array or a map walked directly gives its elements; a generator's
  // values share the generator.
  let walksElements = false
  if (getNodeType(checker, getExpressionId(iterable)) is Some(iterableType)) {
    walksElements =
      iterableType is Type.TArray(_) ||
        iterableType is Type.TFixedArray(_, _) ||
        iterableType is Type.TMap(_, _)
  }
  let elements: Array<ValueShare> = []
  for (const share of Arrays.values(evaluate(checker, mutable walk, iterable))) {
    if (!walksElements) {
      Arrays.push(mutable elements, ValueShare { suffix: "", place: share.place })
    } else if (share.suffix == "") {
      Arrays.push(mutable elements, ValueShare {
        suffix: "[]",
        place: extendPlace(mutable walk.places, share.place, "[]"),
      })
    }
  }
  return elements
}

function removeElement(places: PlaceTable, place: Place): Place {
  // `items[]` back to `items`.
  return Place {
    root: place.root,
    id: places.parents[place.id],
    text: places.textParents[place.text],
  }
}

function evaluatePlaceParts(
  checker: Checker,
  mutable walk: WriteWalk,
  expression: Expr,
) uses alloc {
  // The indexes inside a place are read before the place.
  match (expression) {
    Expr.FieldExpr(_, _, target, _) => evaluatePlaceParts(checker, mutable walk, target)
    Expr.IndexExpr(_, _, target, index) => {
      evaluatePlaceParts(checker, mutable walk, target)
      evaluateIgnored(checker, mutable walk, index)
    }
    _ => {}
  }
}

function extendShares(
  mutable places: PlaceTable,
  shares: Array<ValueShare>,
  suffix: string,
): Array<ValueShare> from shares uses alloc {
  // A part of a value: the places the value shares, one level down.
  let parts: Array<ValueShare> = []
  for (const share of Arrays.values(shares)) {
    if (share.suffix == "") {
      Arrays.push(mutable parts, ValueShare {
        suffix: "",
        place: extendPlace(mutable places, share.place, suffix),
      })
    } else {
      Arrays.push(mutable parts, ValueShare { suffix: "", place: share.place })
    }
  }
  return parts
}

function nestShares(
  shares: Array<ValueShare>,
  suffix: string,
): Array<ValueShare> from shares uses alloc {
  // The shares of a part placed inside a new value at suffix.
  let nested: Array<ValueShare> = []
  for (const share of Arrays.values(shares)) {
    Arrays.push(mutable nested, ValueShare {
      suffix: `${suffix}${share.suffix}`,
      place: share.place,
      tracked: share.tracked,
    })
  }
  return nested
}

function appendShares(mutable shares: Array<ValueShare>, more: Array<ValueShare>) uses alloc {
  for (const share of Arrays.values(more)) {
    Arrays.push(mutable shares, share)
  }
}

function evaluate(
  checker: Checker,
  mutable walk: WriteWalk,
  expression: Expr,
): Array<ValueShare> from walk uses alloc {
  // Walks an expression in evaluation order and returns the places its value
  // shares. A value whose type holds no tracked value shares nothing.
  const nodeId = getExpressionId(expression)
  const shares = evaluateParts(checker, mutable walk, expression)
  if (Arrays.length(shares) == 0) {
    return shares
  }
  if (getNodeType(checker, nodeId) is Some(type)) {
    if (!canHoldShared(checker, mutable walk, type)) {
      return []
    }
    // The value itself is what shares a place without a suffix.
    const tracked = isCopyTracked(checker, type)
    if (isMarked(shares, tracked)) {
      return shares
    }
    let marked: Array<ValueShare> = []
    for (const share of Arrays.values(shares)) {
      if (share.suffix == "") {
        Arrays.push(mutable marked, ValueShare { suffix: "", place: share.place, tracked: tracked })
      } else {
        Arrays.push(mutable marked, share)
      }
    }
    return marked
  }
  return shares
}

function isMarked(shares: Array<ValueShare>, tracked: bool): bool {
  for (const share of Arrays.values(shares)) {
    if (share.suffix == "" && share.tracked != tracked) {
      return false
    }
  }
  return true
}

function evaluateIgnored(checker: Checker, mutable walk: WriteWalk, expression: Expr) uses alloc {
  // Like evaluate, for a value nobody keeps: a place read is only a use.
  match (expression) {
    Expr.Ident(nodeId, pos, name) => {
      const ref = getRef(checker, nodeId)
      if (ref is Ref.Local(local)) {
        if (walk.hiddenLoops[local] is Some(_)) {
          return
        }
      }
      if (findNamedPlace(mutable walk, ref, name) is Some(place)) {
        noteUse(mutable walk, place, pos, false)
      }
    }
    Expr.FieldExpr(_, _, _, _) | Expr.IndexExpr(_, _, _, _) => {
      if (findPlace(checker, mutable walk, expression) is Some(place)) {
        evaluatePlaceParts(checker, mutable walk, expression)
        noteUse(mutable walk, place, findExpressionStart(expression), false)
      } else {
        const _ = evaluate(checker, mutable walk, expression)
      }
    }
    Expr.UnaryExpr(_, _, _, operand) => evaluateIgnored(checker, mutable walk, operand)
    Expr.BinaryExpr(_, _, _, left, right) => {
      evaluateIgnored(checker, mutable walk, left)
      evaluateIgnored(checker, mutable walk, right)
    }
    _ => {
      const _ = evaluate(checker, mutable walk, expression)
    }
  }
}

function evaluateParts(
  checker: Checker,
  mutable walk: WriteWalk,
  expression: Expr,
): Array<ValueShare> from walk uses alloc {
  match (expression) {
    Expr.Ident(nodeId, pos, name) => {
      const ref = getRef(checker, nodeId)
      if (ref is Ref.Local(local)) {
        if (walk.hiddenLoops[local] is Some(elements)) {
          return elements
        }
      }
      if (findNamedPlace(mutable walk, ref, name) is Some(place)) {
        noteUse(mutable walk, place, pos, false)
        return [ValueShare { suffix: "", place: place }]
      }
      return []
    }
    Expr.FieldExpr(_, _, target, name) => {
      if (findPlace(checker, mutable walk, expression) is Some(place)) {
        evaluatePlaceParts(checker, mutable walk, expression)
        noteUse(mutable walk, place, findExpressionStart(expression), false)
        return [ValueShare { suffix: "", place: place }]
      }
      const targetShares = evaluate(checker, mutable walk, target)
      return extendShares(mutable walk.places, targetShares, `.${name}`)
    }
    Expr.IndexExpr(_, _, target, index) => {
      if (findPlace(checker, mutable walk, expression) is Some(place)) {
        evaluatePlaceParts(checker, mutable walk, expression)
        noteUse(mutable walk, place, findExpressionStart(expression), false)
        return [ValueShare { suffix: "", place: place }]
      }
      const containerShares = evaluate(checker, mutable walk, target)
      evaluateIgnored(checker, mutable walk, index)
      return extendShares(mutable walk.places, containerShares, "[]")
    }
    Expr.TemplateLit(_, _, parts) => {
      for (const part of Arrays.values(parts)) {
        evaluateIgnored(checker, mutable walk, part)
      }
      return []
    }
    Expr.IsExpr(_, _, subject, pattern) => {
      const subjectShares = evaluate(checker, mutable walk, subject)
      bindPattern(checker, mutable walk, pattern, subjectShares, Some(subject))
      return []
    }
    Expr.MapLit(_, _, _, keys, values) => {
      for (const key of Arrays.values(keys)) {
        evaluateIgnored(checker, mutable walk, key)
      }
      let shares: Array<ValueShare> = []
      for (const value of Arrays.values(values)) {
        appendShares(mutable shares, nestShares(evaluate(checker, mutable walk, value), "[]"))
      }
      return shares
    }
    Expr.CallExpr(nodeId, _, callee, _, arguments) => {
      return evaluateCall(checker, mutable walk, expression, nodeId, callee, arguments)
    }
    Expr.UnaryExpr(_, _, _, operand) => {
      return evaluate(checker, mutable walk, operand)
    }
    Expr.BinaryExpr(nodeId, _, _, left, right) => {
      // Comparisons and arithmetic give values that share nothing.
      if (getNodeType(checker, nodeId) is Some(binaryType)) {
        if (!canHoldShared(checker, mutable walk, binaryType)) {
          evaluateIgnored(checker, mutable walk, left)
          evaluateIgnored(checker, mutable walk, right)
          return []
        }
      }
      let operandShares = evaluate(checker, mutable walk, left)
      appendShares(mutable operandShares, evaluate(checker, mutable walk, right))
      return operandShares
    }
    Expr.StructLit(nodeId, _, _, _, fields, spread) => {
      let shares: Array<ValueShare> = []
      for (const field of Arrays.values(fields)) {
        appendShares(
          mutable shares,
          nestShares(evaluate(checker, mutable walk, field.value), `.${field.name}`),
        )
      }
      if (spread is Some(base)) {
        appendShares(mutable shares, evaluateSpread(checker, mutable walk, nodeId, fields, base))
      }
      return shares
    }
    Expr.ArrayLit(_, _, elements, _) => {
      let shares: Array<ValueShare> = []
      for (const element of Arrays.values(elements)) {
        appendShares(mutable shares, nestShares(evaluate(checker, mutable walk, element), "[]"))
      }
      return shares
    }
    Expr.MatchExpr(_, _, subject, arms) => {
      const subjectShares = evaluate(checker, mutable walk, subject)
      const start = walk.state
      let end = createDeadState()
      let shares: Array<ValueShare> = []
      for (const arm of Arrays.values(arms)) {
        walk.state = copy(start)
        bindPattern(checker, mutable walk, arm.pattern, subjectShares, Some(subject))
        // The bindings of a fresh subject hold it until the arm ends.
        let bound: Array<int> = []
        if (!isPlaceExpression(subject)) {
          collectPatternLocals(checker, arm.pattern, mutable bound)
        }
        holdBindings(mutable walk, bound, arm.next.line)
        if (arm.guard is Some(guard)) {
          evaluateIgnored(checker, mutable walk, guard)
        }
        if (arm.body is Some(armBody)) {
          appendShares(mutable shares, evaluate(checker, mutable walk, armBody))
        }
        if (arm.block is Some(armBlock)) {
          walkBlock(checker, mutable walk, armBlock)
        }
        releaseBindings(mutable walk, bound)
        mergeInto(mutable end, walk.state)
      }
      walk.state = end
      return shares
    }
    Expr.BlockExpr(_, _, block) => {
      const outerInside = walk.inBlockValue
      const outerShares = walk.blockShares
      const outerExit = walk.blockExit
      walk.inBlockValue = true
      walk.blockShares = []
      walk.blockExit = createDeadState()
      walkBlock(checker, mutable walk, block)
      const exited = walk.blockExit
      mergeInto(mutable walk.state, exited)
      const shares = walk.blockShares
      walk.inBlockValue = outerInside
      walk.blockShares = outerShares
      walk.blockExit = outerExit
      return shares
    }
    Expr.ArrowExpr(nodeId, pos, parameters, _, body, block) => {
      return walkArrow(checker, mutable walk, nodeId, pos, parameters, body, block)
    }
    _ => {
      return []
    }
  }
}

function evaluateSpread(
  checker: Checker,
  mutable walk: WriteWalk,
  nodeId: int,
  fields: Array<FieldInit>,
  base: Expr,
): Array<ValueShare> from walk uses alloc {
  // `{ ...base, a: 1 }` copies the fields it does not write, and each of
  // those shares the same field of base.
  const baseShares = evaluate(checker, mutable walk, base)
  let shares: Array<ValueShare> = []
  if (getNodeType(checker, nodeId) is Some(Type.TStruct(index))) {
    for (const field of Arrays.values(checker.structs[index].fields)) {
      if (
        isFieldWritten(fields, field.name) || !canShareKnown(checker, mutable walk, field.fieldType)
      ) {
        continue
      }
      for (const share of Arrays.values(baseShares)) {
        if (share.suffix == "") {
          Arrays.push(mutable shares, ValueShare {
            suffix: `.${field.name}`,
            place: extendPlace(mutable walk.places, share.place, `.${field.name}`),
          })
        }
      }
    }
  }
  return shares
}

function isFieldWritten(written: Array<FieldInit>, name: string): bool {
  for (const field of Arrays.values(written)) {
    if (field.name == name) {
      return true
    }
  }
  return false
}

function evaluateCall(
  checker: Checker,
  mutable walk: WriteWalk,
  call: Expr,
  nodeId: int,
  callee: Expr,
  arguments: Array<Arg>,
): Array<ValueShare> from walk uses alloc {
  const ref = getRef(checker, nodeId)
  if (ref is Ref.Value) {
    evaluateIgnored(checker, mutable walk, callee)
  }
  // The shares of the arguments are kept only when the result can share, or
  // a std function's `mutable` argument can take them.
  let resultShares = true
  if (getNodeType(checker, nodeId) is Some(resultType)) {
    resultShares = canHoldShared(checker, mutable walk, resultType)
  }
  const keepsShares = resultShares || ref is Ref.Builtin(_)
  // The arguments are read first, in order; a `mutable` one is used too.
  let argumentShares: Array<Array<ValueShare>> = []
  let hasWritten = false
  for (const argument of Arrays.values(arguments)) {
    if (argument.isMutable) {
      evaluatePlaceParts(checker, mutable walk, argument.value)
      if (findPlace(checker, mutable walk, argument.value) is Some(place)) {
        noteUse(mutable walk, place, argument.pos, false)
        hasWritten = true
      }
      if (keepsShares) {
        Arrays.push(mutable argumentShares, [])
      }
    } else if (keepsShares) {
      Arrays.push(mutable argumentShares, evaluate(checker, mutable walk, argument.value))
    } else {
      evaluateIgnored(checker, mutable walk, argument.value)
    }
  }
  // Then each `mutable` argument is written as a whole.
  if (hasWritten) {
    for (const argument of Arrays.values(arguments)) {
      if (!argument.isMutable) {
        continue
      }
      if (findPlace(checker, mutable walk, argument.value) is Some(place)) {
        const site = addSite(mutable walk, WriteSite {
          pos: argument.pos,
          end: findPlaceEnd(argument.value),
          kind: SITE_CALL,
          place: place.text,
          callee: Some(callee),
          more: Arrays.length(arguments) > 1,
        })
        let mode = WRITE_DEEP
        if (ref is Ref.Builtin(_)) {
          mode = WRITE_CONTAINER
        }
        noteWrite(checker, mutable walk, place, mode, site)
        if (ref is Ref.Builtin(_)) {
          keepArguments(checker, mutable walk, place, arguments, argumentShares)
        }
      }
    }
  }
  // The places the result shares.
  if (!resultShares) {
    return []
  }
  if (ref is Ref.Builtin(_) && isCopyCall(checker, call)) {
    return []
  }
  if (ref is Ref.Constructor(_, _)) {
    let payload: Array<ValueShare> = []
    for (const shares of Arrays.values(argumentShares)) {
      appendShares(mutable payload, shares)
    }
    return payload
  }
  if (findSharedArgument(checker, call) is Some(sharedArgument)) {
    const sharedId = getExpressionId(sharedArgument)
    for (const index of Ranges.upTo(Arrays.length(arguments))) {
      if (getExpressionId(arguments[index].value) == sharedId) {
        return argumentShares[index]
      }
    }
  }
  return []
}

function keepArguments(
  checker: Checker,
  mutable walk: WriteWalk,
  container: Place,
  arguments: Array<Arg>,
  argumentShares: Array<Array<ValueShare>>,
) uses alloc {
  // `Arrays.push(mutable items, item)` keeps item as an element of items.
  for (const index of Ranges.upTo(Arrays.length(arguments))) {
    if (arguments[index].isMutable) {
      continue
    }
    if (getNodeType(checker, getExpressionId(arguments[index].value)) is Some(valueType)) {
      if (!canShareKnown(checker, mutable walk, valueType)) {
        continue
      }
    }
    for (const share of Arrays.values(argumentShares[index])) {
      const element = extendPlace(mutable walk.places, container, `[]${share.suffix}`)
      addPair(mutable walk, element, share.place, -1, share.tracked)
    }
  }
}

function walkArrow(
  checker: Checker,
  mutable walk: WriteWalk,
  nodeId: int,
  pos: Pos,
  parameters: Array<Param>,
  body: Option<Expr>,
  block: Option<Block>,
): Array<ValueShare> uses alloc {
  // The body runs later, on its own state.
  const outerState = walk.state
  const outerInside = walk.inBlockValue
  walk.state = createLiveState()
  walk.inBlockValue = false
  walk.arrowDepth += 1
  for (const parameter of Arrays.values(parameters)) {
    noteDeclared(checker, mutable walk, parameter.id)
  }
  if (body is Some(value)) {
    evaluateIgnored(checker, mutable walk, value)
  }
  if (block is Some(arrowBlock)) {
    walkBlock(checker, mutable walk, arrowBlock)
  }
  walk.arrowDepth -= 1
  walk.state = copy(outerState)
  walk.inBlockValue = outerInside
  // Where the arrow function is written, it uses what it captures, and the
  // captured `const`s it changes are written. A value made from it shares
  // the rest of its captures.
  const info = checker.bodies[checker.body]
  let shares: Array<ValueShare> = []
  if (info.closureIndex[nodeId] is Some(closure)) {
    const captures = info.closures[closure].captures
    const changed = info.closures[closure].refCaptures
    for (const captured of Arrays.values(captures)) {
      const place = createLocalPlace(captured)
      noteUse(mutable walk, place, pos, false)
      if (!containsLocal(changed, captured)) {
        Arrays.push(mutable shares, ValueShare { suffix: "", place: place })
      }
    }
    for (const captured of Arrays.values(changed)) {
      const place = createLocalPlace(captured)
      const site = addSite(mutable walk, WriteSite {
        pos: pos,
        end: pos,
        kind: SITE_ARROW,
        place: place.text,
      })
      noteWrite(checker, mutable walk, place, WRITE_DEEP, site)
    }
  }
  return shares
}

function containsLocal(locals: Array<int>, local: int): bool {
  for (const known of Arrays.values(locals)) {
    if (known == local) {
      return true
    }
  }
  return false
}

// ---- Reporting

function reportFound(
  mutable checker: Checker,
  walk: WriteWalk,
  errorPlaces: Map<string, Array<Pos>>,
) uses alloc {
  // In the order of the writes; most bodies found none.
  if (Arrays.length(walk.found) == 0 && Arrays.length(walk.heldWrites) == 0) {
    return
  }
  let bySite: Map<int, FoundWrite> = Map {}
  for (const write of Arrays.values(walk.found)) {
    bySite[write.site] = write
  }
  for (const write of Arrays.values(walk.heldWrites)) {
    if (bySite[write.site] is None) {
      bySite[write.site] = write
    }
  }
  const file = checker.scopes[checker.current].file
  const checkPlaces = Maps.size(errorPlaces) > 0
  for (const index of Ranges.upTo(Arrays.length(walk.sites))) {
    if (bySite[index] is Some(found)) {
      if (checkPlaces && hasErrorInside(errorPlaces, file, walk.sites[index])) {
        continue
      }
      reportSharedWrite(mutable checker, walk, walk.sites[index], found)
    }
  }
}

function writeSiteText(checker: Checker, places: PlaceTable, site: WriteSite): string uses alloc {
  const text = writeText(checker, places, site.place)
  if (site.kind == SITE_COMPOUND) {
    if (site.operator == "++" || site.operator == "--") {
      return `${text}${site.operator}`
    }
    return `${text} ${site.operator} ...`
  }
  if (site.kind == SITE_CALL) {
    let callee = "the call"
    if (site.callee is Some(called)) {
      callee = writeCalleeText(called)
    }
    let more = ""
    if (site.more) {
      more = ", ..."
    }
    return `${callee}(mutable ${text}${more})`
  }
  if (site.kind == SITE_ARROW) {
    return `the arrow function at line ${Int.toString(site.pos.line)}, which changes ${text},`
  }
  return `${text} = ...`
}

function reportSharedWrite(
  mutable checker: Checker,
  walk: WriteWalk,
  site: WriteSite,
  found: FoundWrite,
) uses alloc {
  let origin: Option<Expr> = None
  if (found.origin >= 0) {
    origin = Some(walk.origins[found.origin])
  }
  const fixes = copy(buildCopyFix(checker, origin))
  const other = writeText(checker, walk.places, found.other.text)
  const start = `${writeSiteText(checker, walk.places, site)} may change ${writeText(checker, walk.places, found.hit.text)}`
  let advice = "; take a copy where it is shared, with copy(...)"
  if (Arrays.length(fixes) == 0) {
    advice = "; no fix is offered here: copy the value by hand where the sharing starts, or end the sharing before the write"
  }
  match (found.reason) {
    LiveReason.LaterUse(line) => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which ${other} still uses at line ${Int.toString(line)}${advice}`,
    )
    LiveReason.ScopeEnd(line) => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which ${other} still holds until its block ends at line ${Int.toString(line)}${advice}`,
    )
    LiveReason.Parameter => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which ${other} still holds for the caller${advice}`,
    )
    LiveReason.Captured => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which captured ${other} still holds${advice}`,
    )
    LiveReason.Cell => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which the cell ${other} still holds${advice}`,
    )
    LiveReason.Constant => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which constant ${other} still holds${advice}`,
    )
    LiveReason.Loop => reportErrorFix(
      mutable checker,
      site.pos,
      "E0978",
      fixes,
      `${start}, which the loop over ${other} still holds; change it after the loop, or loop over a copy(...)`,
    )
  }
}

function buildCopyFix(checker: Checker, origin: Option<Expr>): Array<Fix> from checker uses alloc {
  // Wraps the value that started the sharing in copy(...), when the parser
  // noted where it ends and copy accepts its type.
  if (origin is Some(value)) {
    if (isCopyCall(checker, value)) {
      return []
    }
    if (getNodeType(checker, getExpressionId(value)) is Some(valueType)) {
      if (!canShareType(checker, valueType)) {
        return []
      }
    }
    const scope = checker.scopes[checker.current]
    if (scope.facts.valueEnds[getExpressionId(value)] is Some(end)) {
      const start = findExpressionStart(value)
      return [createFix("copy the shared value", [insertAt(start, "copy("), insertAt(end, ")")])]
    }
  }
  return []
}
