// http/response: the response type that the server sends and the client reads.

import * as Bodies from "http/body"
import * as Fields from "http/headers"
import * as Int from "std/int"
import * as Json from "std/json"
import * as Str from "std/string"
import { Body, BodyStream } from "http/body"
import { Connection } from "std/net"
import { Headers } from "http/headers"
import { HttpError } from "http/error"
import { Value } from "std/shape"

/// What a server does with the connection once the 101 head of a response is written: run gets
/// the connection and the bytes that the client sent after its request. The connection closes
/// when run finishes and every copy of it is gone.
export struct Upgrade {
  run: (connection: Connection, leftover: bytes) => Async<void> uses (io, alloc)
}

/// The connection of a client request that was answered with 101, and the bytes the server sent
/// after the head of its response.
export struct Upgraded {
  connection: Connection
  leftover: bytes
}

/// A response. upgrade is for a server: a handler sets it on a 101 response. upgraded is for a
/// client: send fills it when the status is 101, and the body is empty then.
export struct Response {
  status: int
  headers: Headers
  body: Body
  upgrade: Option<Upgrade>
  upgraded: Option<Upgraded>
}

/// A response with the status, no headers and no body.
export function create(status: int): Response uses alloc {
  return Response {
    status,
    headers: Fields.empty(),
    body: Bodies.empty(),
    upgrade: None,
    upgraded: None,
  }
}

/// A response of plain text, with a Content-Type of text/plain in UTF-8.
export function text(status: int, content: string): Response uses alloc {
  let headers = Fields.empty()
  Fields.add(mutable headers, "Content-Type", "text/plain; charset=utf-8")
  return Response {
    status,
    headers,
    body: Bodies.fromText(content),
    upgrade: None,
    upgraded: None,
  }
}

/// A response of a JSON value, with a Content-Type of application/json.
export function json(status: int, value: Value): Response uses alloc {
  let headers = Fields.empty()
  Fields.add(mutable headers, "Content-Type", "application/json")
  return Response {
    status,
    headers,
    body: Bodies.fromText(Json.stringify(value)),
    upgrade: None,
    upgraded: None,
  }
}

/// A response with the body and no headers. The body may hold bytes or a stream; the server
/// sends a stream chunked.
export function withBody(status: int, body: Body): Response from body uses alloc {
  return Response { status, headers: Fields.empty(), body, upgrade: None, upgraded: None }
}

/// A response that sends each piece of the stream as it comes, chunked. An Err from the stream
/// ends the response early.
export function stream(status: int, pieces: BodyStream): Response from pieces uses alloc {
  return withBody(status, Bodies.fromStream(pieces))
}

/// A response of the bytes, with a Content-Type of application/octet-stream.
export function binary(status: int, data: bytes): Response uses alloc {
  let response = withBody(status, Bodies.fromBytes(data))
  Fields.add(mutable response.headers, "Content-Type", "application/octet-stream")
  return response
}

/// A response that sends the client to the url, with the Location header set. The status must
/// be 301, 302, 303, 307 or 308, and the url must not be empty or hold a line break or a NUL;
/// otherwise the result is Malformed.
export function redirect(url: string, status: int): Result<Response, HttpError> uses alloc {
  if (status != 301 && status != 302 && status != 303 && status != 307 && status != 308) {
    return Err(HttpError.Malformed(`not a redirect status: ${Int.toString(status)}`))
  }
  if (url == "" || Str.contains(url, "\r") || Str.contains(url, "\n") || Str.contains(url, "\0")) {
    return Err(HttpError.Malformed("the redirect url is empty or has a control character"))
  }
  let response = create(status)
  Fields.add(mutable response.headers, "Location", url)
  return Ok(response)
}

/// Whether the status of the response is from 200 to 299.
export function isOk(response: Response): bool {
  return response.status >= 200 && response.status <= 299
}

/// The standard reason phrase of a status, or an empty text for a status with none.
export function reasonPhrase(status: int): string {
  if (status == 100) {
    return "Continue"
  }
  if (status == 101) {
    return "Switching Protocols"
  }
  if (status == 200) {
    return "OK"
  }
  if (status == 201) {
    return "Created"
  }
  if (status == 202) {
    return "Accepted"
  }
  if (status == 204) {
    return "No Content"
  }
  if (status == 206) {
    return "Partial Content"
  }
  if (status == 301) {
    return "Moved Permanently"
  }
  if (status == 302) {
    return "Found"
  }
  if (status == 303) {
    return "See Other"
  }
  if (status == 304) {
    return "Not Modified"
  }
  if (status == 307) {
    return "Temporary Redirect"
  }
  if (status == 308) {
    return "Permanent Redirect"
  }
  if (status == 400) {
    return "Bad Request"
  }
  if (status == 401) {
    return "Unauthorized"
  }
  if (status == 403) {
    return "Forbidden"
  }
  if (status == 404) {
    return "Not Found"
  }
  if (status == 405) {
    return "Method Not Allowed"
  }
  if (status == 408) {
    return "Request Timeout"
  }
  if (status == 409) {
    return "Conflict"
  }
  if (status == 411) {
    return "Length Required"
  }
  if (status == 413) {
    return "Content Too Large"
  }
  if (status == 414) {
    return "URI Too Long"
  }
  if (status == 415) {
    return "Unsupported Media Type"
  }
  if (status == 422) {
    return "Unprocessable Content"
  }
  if (status == 429) {
    return "Too Many Requests"
  }
  if (status == 431) {
    return "Request Header Fields Too Large"
  }
  if (status == 500) {
    return "Internal Server Error"
  }
  if (status == 501) {
    return "Not Implemented"
  }
  if (status == 502) {
    return "Bad Gateway"
  }
  if (status == 503) {
    return "Service Unavailable"
  }
  if (status == 504) {
    return "Gateway Timeout"
  }
  if (status == 505) {
    return "HTTP Version Not Supported"
  }
  return ""
}
