// error: index 4 is out of range for FixedArray<u8, 4>
import * as Ptr from "std/ptr"

@trusted
function address(buffer: Ptr<FixedArray<u8, 4>>, index: int): Ptr<u8> {
  unsafe {
    const inside = Ptr.element(buffer, 3)
    const past = Ptr.element(buffer, 4)
    const negative = Ptr.element(buffer, -1)
    const unproven = Ptr.element(buffer, index)
    return past
  }
}

export function run(_args: Array<string>): int {
  return 0
}
