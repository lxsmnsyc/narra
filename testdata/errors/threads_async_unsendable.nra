// error: is not Sendable
import * as Cells from "std/cell"
import * as Thread from "std/thread"
import { Cell } from "std/cell"

async function makeCell(): Cell<int> uses alloc {
  return Cells.create(1)
}

export function run(_args: Array<string>): int {
  const visits = Cells.create(0)
  Thread.scope((scope) => {
    Thread.startAsync(scope, async () => Cells.get(visits))
    Thread.startAsync(scope, makeCell)
    Thread.startAsync(scope, async () => Cells.create(2))
  })
  return 0
}
