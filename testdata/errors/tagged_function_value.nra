// error: function j has a mutable parameter, so it cannot be used as a value
import * as Str from "std/string"

function j(mutable parts: Array<string>, values: Array<string>): string {
  return Str.join(parts, Str.join(values, ""))
}

export function run(_args: Array<string>): int {
  const f = j
  print(f`x`)
  return 0
}
