// error: a closure cannot capture loop element "player", which is changed in place, unless it is passed straight to a function parameter that is not escaping; copy it first with `copy(player)`
struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  let read = () => 0
  for (mutable player of players) {
    read = () => player.hp
  }
  return read()
}
