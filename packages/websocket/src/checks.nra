// The test program of the package: `narrac run -sanitize packages/websocket`. It prints a line for
// each failed check and then the counts, and exits with 1 when any failed.

import * as Async from "std/async"
import * as Cells from "std/cell"
import * as Net from "std/net"
import * as Process from "std/process"
import * as Server from "http/server"
import * as Time from "std/time"
import { Request } from "http/request"
import { createProbe, route } from "websocket/checkserver"
import { createReport, describeCount, expect } from "websocket/checkkit"
import { runEchoChecks } from "websocket/checkecho"
import { runRawChecks } from "websocket/checkraw"

async function watchdog() uses io, alloc {
  // Ends the program when the checks hang, so no run waits forever.
  const slept = await Time.sleep(Time.seconds(180))
  if (slept is Ok(_)) {
    print("FAIL - the checks did not finish in 180 seconds")
    Process.exit(1)
  }
}

export async function run(_args: Array<string>): int uses io, alloc {
  const report = createReport()
  Async.detach(watchdog())
  const listener = Net.listen("127.0.0.1", 0)
  if (listener is Err(_)) {
    expect(report, "the test server listens", false)
    print(describeCount(report))
    return 1
  }
  const port = Net.localPort(listener.value)
  const probe = createProbe()
  const server = Server.serve(
    listener.value,
    Server.defaultOptions(),
    (request: Request) => route(request, probe),
  )
  await runRawChecks(report, port, probe)
  await runEchoChecks(report, port, probe)
  Async.cancel(server)
  print(describeCount(report))
  if (Cells.get(report.failed) > 0) {
    return 1
  }
  return 0
}
