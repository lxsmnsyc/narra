import * as Int from "std/int"

function firstBig(pair: #[Option<int>, Option<int>]): string {
  return match (pair) {
    #[Some(x), _] | #[_, Some(x)] if (x > 5) => `big ${Int.toString(x)}`
    _ => "none"
  }
}

function describe(pair: #[Option<int>, Option<int>]): string {
  match (pair) {
    #[Some(x), _] | #[_, Some(x)] if (x > 5) => {
      return `big ${Int.toString(x)}`
    }
    #[Some(x), _] | #[_, Some(x)] => {
      return `small ${Int.toString(x)}`
    }
    _ => {}
  }
  return "none"
}

function longWord(pair: #[Option<string>, Option<string>]): string {
  return match (pair) { #[Some(word), _] | #[_, Some(word)] if (word == "long") => word, _ => "no" }
}

export function run(args: Array<string>): int {
  print(longWord(#[Some("short"), Some("long")]))
  print(longWord(#[Some("short"), None]))
  print(firstBig(#[Some(1), Some(10)]))
  print(firstBig(#[Some(7), Some(10)]))
  print(firstBig(#[None, Some(10)]))
  print(firstBig(#[Some(1), Some(2)]))
  print(firstBig(#[Some(1), None]))
  print(describe(#[Some(1), Some(10)]))
  print(describe(#[Some(1), Some(2)]))
  print(describe(#[None, None]))
  return 0
}
