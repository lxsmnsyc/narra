// A generic helper that starts a thread states <T: Sendable> (D111 item 1),
// and every call passes a type whose parts can cross a thread.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Thread from "std/thread"

struct Labeled<T> {
  label: string
  value: T
}

function sendBack<T: Sendable>(value: T): T uses alloc {
  return Thread.scope((scope) => {
    const worker = Thread.start(scope, () => copy(value))
    return Thread.join(worker)
  })
}

function describe(labeled: Labeled<Array<int>>): string uses alloc {
  let text = labeled.label
  for (const number of labeled.value) {
    text = `${text} ${Int.toString(number)}`
  }
  return text
}

export function run(_args: Array<string>): int {
  print(Int.toString(sendBack(41) + 1))
  print(sendBack("text from a thread"))
  print(describe(sendBack(Labeled { label: "labeled", value: [1, 2, 3] })))
  const words = sendBack(["a", "b", "c"])
  print(Str.join(words, ","))
  return 0
}
