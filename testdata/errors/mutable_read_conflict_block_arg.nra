// error: mutable_read_conflict_block_arg.nra:16:14: "x" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function bump(mutable counter: Counter, other: int): int {
  counter.n = 10
  return other
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  const total = bump(
    mutable x,
    {
      return x.n
    },
  )
  return total
}
