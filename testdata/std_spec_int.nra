import * as Int from "std/int"

function showPair(label: string, result: Option<#[int, int]>) uses alloc, io {
  match (result) {
    Some(#[quotient, remainder]) => print(
      `${label} ${Int.toString(quotient)} ${Int.toString(remainder)}`,
    )
    None => print(`${label} none`)
  }
}

function showInt(label: string, result: Option<int>) uses alloc, io {
  match (result) {
    Some(value) => print(`${label} ${Int.toString(value)}`)
    None => print(`${label} none`)
  }
}

function showOrder(label: string, order: Ordering) {
  match (order) {
    Ordering.Less => print(`${label} less`)
    Ordering.Equal => print(`${label} equal`)
    Ordering.Greater => print(`${label} greater`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  showPair("divmod 7 2", Int.divmod(7, 2))
  showPair("divmod -7 2", Int.divmod(-7, 2))
  showPair("divmod 7 0", Int.divmod(7, 0))
  showInt("floorDiv 7 2", Int.floorDiv(7, 2))
  showInt("floorDiv -7 2", Int.floorDiv(-7, 2))
  showInt("floorDiv 7 -2", Int.floorDiv(7, -2))
  showInt("floorDiv -8 2", Int.floorDiv(-8, 2))
  showInt("floorDiv 1 0", Int.floorDiv(1, 0))
  showOrder("compare 1 2", Int.compare(1, 2))
  showOrder("compare 2 2", Int.compare(2, 2))
  showOrder("compare 3 2", Int.compare(3, 2))
  return 0
}
