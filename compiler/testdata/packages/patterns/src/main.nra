import { User, Message, Level, split } from "pp/model"
import * as Model from "pp/model"
import * as Int from "std/int"

function read(m: Model.Message): string {
  return match (m) {
    Message.Hello({ name: "root" }) => "hello admin"
    Message.Hello({ name, age }) if (age < 18) => `hello young ${name}`
    Message.Hello({ name }) => `hello ${name}`
    Message.Text({ name }, "") => `${name} sent nothing`
    Message.Text({ name: author }, body) => `${author}: ${body}`
    Message.Quit => "quit"
  }
}

function compare(a: int, b: int): string {
  return match (Ordered.compare(a, b)) {
    Ordering.Less => "less"
    Ordering.Equal => "equal"
    Ordering.Greater => "greater"
  }
}

function level(l: Level): string {
  return match (l) {
    Level.Less => "level less"
    Level.More => "level more"
  }
}

export function run(args: Array<string>): int {
  const ana = User { name: "Ana", age: 30, tags: ["admin"] }
  print(read(Message.Hello(User { name: "root", age: 40 })))
  print(read(Message.Hello(User { name: "Kim", age: 12 })))
  print(read(Message.Hello(ana)))
  print(read(Message.Text(ana, "")))
  print(read(Message.Text(ana, "hi")))
  print(read(Message.Quit))

  const { name, tags } = ana
  print(`${name} ${tags[0]}`)
  const older = { ...ana, age: 31 }
  const { age } = older
  print(`${older.name} ${Int.toString(age)} ${older.tags[0]}`)

  const #[who, years] = split(older)
  print(`${who} ${Int.toString(years)}`)

  print(compare(1, 2))
  print(compare(2, 2))
  print(level(Level.Less))
  return 0
}
