// error: trait name "T_" cannot start or end with "_" or contain "__"
trait T_ {
  function f(x: Self): int
}

trait T {
  function _f(x: Self): int
}

struct X implements T_, T {
  a: int
}

implement T_ for X {
  function f(x: X): int {
    return 1
  }
}

implement T for X {
  function _f(x: X): int {
    return 2
  }
}

export function run(args: Array<string>): int {
  return 0
}
