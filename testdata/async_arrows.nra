// Async arrows: a handle for each call, and Arrays.map with an async arrow,
// whose handles are awaited in a loop.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Async from "std/async"

async function square(value: int): int {
  return value * value
}

export async function run(_args: Array<string>): int {
  const offset = 100
  const shifted = async (value: int): int => value + offset
  print(Int.toString(await shifted(5)))
  const names = ["ab", "cde"]
  const greet = async (name: string) => {
    await Async.idle()
    return `hello ${name}`
  }
  print(await greet(names[0]))
  const items = [1, 2, 3, 4]
  const handles = Arrays.map(items, async (item) => (await square(item)) + offset)
  let total = 0
  for (const handle of handles) {
    total += await handle
  }
  print(Int.toString(total))
  return 0
}
