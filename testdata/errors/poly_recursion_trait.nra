// error: poly_recursion_trait.nra:7:3: too many instances of generic functions; show may recurse with ever larger types
struct Grow<T: Show> implements Show {
  value: T
}

implement Show for Grow<T> {
  function show(self: Self): string {
    return Show.show(Grow { value: self })
  }
}

export function run(args: Array<string>): int {
  Show.show(Grow { value: 1 })
  return 0
}
