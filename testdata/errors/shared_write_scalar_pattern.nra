// error: node.pos.column = ... may change node, which pos still uses at line 17
struct Pos {
  line: int
  column: int
}

struct Node {
  name: string
  pos: Pos
}

export function run(_args: Array<string>): int {
  let node = Node { name: "a", pos: Pos { line: 1, column: 2 } }
  // A destructured binding shares the value it was matched from.
  const { pos } = node
  node.pos.column = 7
  return pos.column + node.pos.column
}
