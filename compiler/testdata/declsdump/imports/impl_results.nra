trait Make {
  function make(self: Self): (int) => Option<int>
  function arr(self: Self): Option<Array<int>>
  function next(self: Self): Option<Self>
  function pair(self: Self): #[Self, int]
}

struct K implements Make {
  n: int
}

implement Make for K {
  function make(self: K): (int) => Option<int> {
    return (x: int) => Some(x)
  }
  function arr(self: K): Option<Array<int>> {
    return None
  }
  function next(self: K): Option<K> {
    return None
  }
  function pair(self: K): #[K, int] {
    return #[self, 1]
  }
}

function g(): (int) => #[int, bool] {
  return (x: int) => #[x, true]
}

export function run(args: Array<string>): int {
  return 0
}
