import * as Int from "std/int"
import * as Float from "std/float"

trait Area {
  function area(shape: Self): f64
  function name(shape: Self): string
}

struct Square implements Area {
  side: f64
}

struct Rect implements Area, Show {
  width: f64
  height: f64
}

implement Area for Square {
  function area(shape: Square): f64 {
    return shape.side * shape.side
  }

  function name(shape: Self): string {
    return "square"
  }
}

implement Area for Rect {
  function area(shape: Rect): f64 {
    return shape.width * shape.height
  }

  function name(shape: Rect): string {
    return "rect"
  }
}

implement Show for Rect {
  function show(value: Rect): string {
    return `${Float.toString(value.width)}x${Float.toString(value.height)}`
  }
}

struct Money implements Ordered, Show {
  cents: int
}

implement Ordered for Money {
  function compare(a: Money, b: Money): Ordering {
    return Ordered.compare(a.cents, b.cents)
  }
}

implement Show for Money {
  function show(value: Money): string {
    return `${Int.toString(value.cents)}c`
  }
}

function describe<T: Area>(shape: T): string {
  return `${Area.name(shape)} with area ${Float.toString(Area.area(shape))}`
}

function largest<T: Ordered & Show>(items: Array<T>, first: T): string {
  let best = first
  for (const item of Array.values(items)) {
    if (Ordered.compare(item, best) is Greater) {
      best = item
    }
  }
  return Show.show(best)
}

function contains<T: Equatable>(items: Array<T>, wanted: T): bool {
  for (const item of Array.values(items)) {
    if (item == wanted) {
      return true
    }
  }
  return false
}

function joined<T: Show>(items: Array<T>): string {
  let out = ""
  for (const item of Array.values(items)) {
    out = `${out}${Show.show(item)};`
  }
  return out
}

export function run(args: Array<string>): int {
  print(describe(Square { side: 3.0 }))
  print(describe(Rect { width: 2.0, height: 5.0 }))
  print(Show.show(Rect { width: 1.5, height: 2.0 }))
  const prices: Array<Money> = [Money { cents: 250 }, Money { cents: 1999 }, Money { cents: 5 }]
  print(largest(prices, Money { cents: 0 }))
  print(largest([3, 9, 4], 0))
  print(largest(["pear", "apple", "zoo"], ""))
  print(joined(prices))
  print(joined([true, false]))
  print(joined(['a', 'b']))
  print(Show.show(1.5))
  print(Show.show("say \"hi\""))
  print(Show.show("tab\there\nnew line\r\\"))
  print(Show.show(['\n', '\t', '\'', '"']))
  if (contains(["a", "b"], "b")) {
    print("contains b")
  }
  if (!contains([1, 2], 3)) {
    print("no 3")
  }
  if (contains(prices, Money { cents: 5 })) {
    print("contains 5 cents")
  }
  const order = Ordered.compare(Money { cents: 1 }, Money { cents: 2 })
  print(Show.show(order))
  print(Show.show(Ordered.compare("b", "a")))
  print(Show.show(Ordered.compare(2, 2)))
  if (Equatable.equals(Square { side: 1.0 }, Square { side: 1.0 })) {
    print("squares equal")
  }
  if (Hashable.hash("abc") == Hashable.hash("abc")) {
    print("hash stable")
  }
  return 0
}
