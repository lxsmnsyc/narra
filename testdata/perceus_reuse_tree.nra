// A tree rewrite that builds a node of the same shape in each arm, over a
// fresh tree and over a tree that another name and a map still hold.
import * as Int from "std/int"
import * as Str from "std/string"

enum Tree {
  Node(left: Tree, value: int, right: Tree)
  Leaf
}

function insert(tree: Tree, value: int): Tree {
  if (tree is Tree.Node(left, current, right)) {
    if (value < current) {
      return Tree.Node(insert(left, value), current, right)
    }
    return Tree.Node(left, current, insert(right, value))
  }
  return Tree.Node(Tree.Leaf, value, Tree.Leaf)
}

function mirror(tree: Tree): Tree {
  return match (tree) {
    Tree.Node(left, value, right) => Tree.Node(mirror(right), value * 10, mirror(left))
    Tree.Leaf => Tree.Leaf
  }
}

function render(tree: Tree): string {
  return match (tree) {
    Tree.Node(left, value, right) => `(${render(left)} ${Int.toString(value)} ${render(right)})`
    Tree.Leaf => "."
  }
}

function build(values: Array<int>): Tree {
  let tree = Tree.Leaf
  for (const value of values) {
    tree = insert(tree, value)
  }
  return tree
}

export function run(args: Array<string>): int {
  // A fresh tree, rewritten as it is built.
  print(render(mirror(build([4, 2, 6, 1, 3]))))

  // A tree that two names and a map hold, rewritten twice.
  const shared = build([5, 3, 8])
  const other = shared
  let byName: Map<string, Tree> = Map {}
  byName["kept"] = shared
  const grown = insert(shared, 7)
  const flipped = mirror(shared)
  print(render(grown))
  print(render(flipped))
  print(render(shared))
  print(render(other))
  if (byName["kept"] is Some(kept)) {
    print(render(kept))
  }

  // A long chain, so freeing the old tree walks many nodes.
  let chain = Tree.Leaf
  for (let i = 0; i < 2000; i++) {
    chain = insert(chain, i)
  }
  const doubled = mirror(chain)
  print(Int.toString(Str.length(render(doubled))))
  return 0
}
