// error: match_block_values_mutable_conflict.nra:14:10: "x" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = counter.n + 1
  return 1
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  const o: Option<int> = Some(2)
  return x.n +
    match (o) {
      Some(v) => {
        return bump(mutable x)
      }
      None => 0
    }
}
