// The dispatch of the calls of the std modules other than array, range, box, map,
// option, result and test. The emitters of each module are in std<module>.nra.
// The owner is selfhost-emit-std.
import { Pos, Expr, Arg } from "narrac/ast"
import { Ref } from "narrac/check"
import {
  Emitter,
  Code,
  EmitWalker,
  reportUnsupported,
  readNodeRef,
  noteHelper,
} from "narrac/emitstate"
import { NODE, plain } from "narrac/stdemithelp"
import * as Str from "std/string"
import * as Arrays from "std/array"
import { emitIntCall } from "narrac/stdint"
import { emitSizedCall, isSizedName } from "narrac/stdsized"
import { emitF32Call, isF32Name } from "narrac/stdf32"
import { emitFloatCall } from "narrac/stdfloat"
import { emitStringCall } from "narrac/stdstring"
import { emitCharCall } from "narrac/stdchar"
import { emitInternalCall } from "narrac/stdinternal"
import { emitEnvCall } from "narrac/stdenv"
import { emitHostCall } from "narrac/stdbuild"
import { emitFsCall } from "narrac/stdfs"
import { emitIoCall } from "narrac/stdio"
import { emitPathCall } from "narrac/stdpath"
import { emitProcessCall } from "narrac/stdprocess"
import { emitBytesCall } from "narrac/stdbytes"
import { emitPointerCall } from "narrac/emitpointers"
import { emitCStringCall } from "narrac/emitexterns"
import { emitLazyCall } from "narrac/stdlazy"
import { emitAsyncCall } from "narrac/stdasync"

export function emitStdCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  expression: Expr,
): Code uses alloc {
  if (expression is Expr.CallExpr(nodeId, pos, _, _, arguments)) {
    const ref = readNodeRef(emitter, nodeId)
    if (ref is Ref.Builtin(index)) {
      const name = emitter.checker.registry.functions[index].name
      return emitNamedCall(walker, mutable emitter, name, nodeId, pos, arguments)
    }
  }
  return plain(reportUnsupported(mutable emitter, "std call without a builtin", NODE))
}

function emitNamedCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  // The C runtime section of the module stays in the program.
  const runtimeModule = findRuntimeModule(name)
  if (runtimeModule != "") {
    noteHelper(emitter, runtimeModule)
  }
  // A call goes to the module its name starts with (Str.slice goes to
  // stdstring). A new std module adds one case here.
  if (isF32Name(name)) {
    return emitF32Call(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (isSizedName(name)) {
    return emitSizedCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Lazies.")) {
    return emitLazyCall(walker, mutable emitter, arguments)
  }
  if (Str.startsWith(name, "Str.")) {
    return emitStringCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Char.")) {
    return emitCharCall(walker, mutable emitter, name, nodeId, arguments)
  }
  if (Str.startsWith(name, "Int.")) {
    return emitIntCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Float.")) {
    return emitFloatCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Env.")) {
    return emitEnvCall(walker, mutable emitter, name, nodeId, arguments)
  }
  if (Str.startsWith(name, "Fs.")) {
    return emitFsCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Io.")) {
    return emitIoCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Process.")) {
    return emitProcessCall(walker, mutable emitter, name, nodeId, arguments)
  }
  if (Str.startsWith(name, "Bytes.")) {
    return emitBytesCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Ptr.")) {
    return emitPointerCall(walker, mutable emitter, name, nodeId, arguments)
  }
  if (Str.startsWith(name, "CText.")) {
    return emitCStringCall(walker, mutable emitter, name, arguments)
  }
  if (Str.startsWith(name, "Path.")) {
    return emitPathCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "FloatText.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Probe.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "CellSlot.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Co.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Libm.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Clock.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Entropy.")) {
    return emitInternalCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  if (Str.startsWith(name, "Host.")) {
    return emitHostCall(mutable emitter, name)
  }
  if (Str.startsWith(name, "Tasks.")) {
    return emitAsyncCall(mutable emitter, name, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}

const RUNTIME_PREFIXES = [
  #["Str.", "std/string"],
  #["Int.", "std/int"],
  #["Env.", "std/env"],
  #["Fs.", "std/fs"],
  #["Io.", "std/io"],
  #["Process.", "std/process"],
  #["Bytes.", "std/bytes"],
  #["Path.", "std/path"],
  #["Clock.", "std/internal/clock"],
  #["Entropy.", "std/internal/entropy"],
  #["Host.", "std/internal/host"],
]

function findRuntimeModule(name: string): string uses alloc {
  // Sized integers parse with the std/int runtime.
  if (isSizedName(name)) {
    return "std/int"
  }
  for (const entry of Arrays.values(RUNTIME_PREFIXES)) {
    const #[prefix, module] = entry
    if (Str.startsWith(name, prefix)) {
      return module
    }
  }
  return ""
}
