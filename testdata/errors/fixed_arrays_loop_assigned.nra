// error: the index of FixedArray<int, 4> must be proven to be 0 to 3
function assignedAfter(values: FixedArray<int, 4>): int {
  let total = 0
  for (let i = 0; i < 4; i++) {
    total += values[i]
    i = i - 2
  }
  return total
}

function assignedBefore(values: FixedArray<int, 4>): int {
  let total = 0
  for (let i = 0; i < 4; i++) {
    i = i - 2
    total += values[i]
  }
  return total
}

function stepDown(values: FixedArray<int, 4>): int {
  let total = 0
  for (let i = 3; i < 4; i--) {
    total += values[i]
  }
  return total
}

function wideStep(values: FixedArray<int, 4>, count: int): int {
  // i += 2 could pass the largest int and wrap to a negative value below count.
  let total = 0
  for (let i = 0; i < count; i += 2) {
    if (i < 4) {
      total += values[i]
    }
  }
  return total
}

function inclusiveBound(values: FixedArray<int, 4>, count: int): int {
  // With count the largest int, i <= count holds when i++ wraps.
  let total = 0
  for (let i = 0; i <= count; i++) {
    if (i < 4) {
      total += values[i]
    }
  }
  return total
}

function startUnknown(values: FixedArray<int, 4>, start: int): int {
  let total = 0
  for (let i = start; i < 4; i++) {
    total += values[i]
  }
  return total
}

function apply(action: () => void) {
  action()
}

function closureAssigns(values: FixedArray<int, 4>): int {
  let total = 0
  for (let i = 0; i < 4; i++) {
    total += values[i]
    apply(() => {
      i = -3
    })
  }
  return total
}

export function run(_args: Array<string>): int {
  const values: FixedArray<int, 4> = [1, 2, 3, 4]
  return assignedAfter(values) +
    assignedBefore(values) +
    stepDown(values) +
    wideStep(values, 4) +
    inclusiveBound(values, 4) +
    startUnknown(values, 0) +
    closureAssigns(values)
}
