// Generators as values: a generic generator, a generator passed to a
// function, copies, generators dropped before they finish, and an arrow
// function that captures a frame local.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

function* repeat<T>(value: T, times: int): Generator<T> {
  for (const _i of Ranges.upTo(times)) {
    yield value
  }
}

function* naturals(): Generator<int> {
  let n = 0
  while (true) {
    yield n
    n = n + 1
  }
}

function* labeled(names: Array<string>): Generator<string> {
  const suffix = Str.repeat("!", 2)
  const decorate = (name: string): string => `${name}${suffix}`
  for (const name of names) {
    yield decorate(name)
  }
}

function* pairs(n: int): Generator<#[int, string]> {
  for (const i of Ranges.upTo(n)) {
    yield #[i, Int.toString(i * 10)]
  }
}

function total(numbers: Generator<int>): int {
  let sum = 0
  for (const n of numbers) {
    sum = sum + n
  }
  return sum
}

function joinAll<effect E>(texts: Generator<string> uses E): string uses alloc, E {
  let parts: Array<string> = []
  for (const text of texts) {
    Arrays.push(mutable parts, text)
  }
  return Str.join(parts, ",")
}

struct Holder {
  name: string
  source: Generator<string> uses alloc
}

export function run(args: Array<string>): int {
  for (const word of repeat("hey", 2)) {
    print(word)
  }
  print(Int.toString(total(repeat(5, 3))))

  // Iterating the same generator twice runs it twice: each loop resumes a copy.
  const words = labeled(["a", "b"])
  print(joinAll(words))
  print(joinAll(words))
  for (const word of words) {
    print(word)
  }

  // An endless generator, left with break.
  for (const n of naturals()) {
    if (n == 3) {
      break
    }
    print(Int.toString(n))
  }

  // Generators that are never iterated, or dropped half way.
  const _unused = labeled(["never"])
  const holder = Holder { name: "h", source: labeled(["x", "y", "z"]) }
  for (const text of holder.source) {
    print(`${holder.name} ${text}`)
    if (text == "y!!") {
      break
    }
  }
  let generators = [repeat("p", 2), repeat("q", 1)]
  Arrays.push(mutable generators, repeat("r", 3))
  for (const generator of generators) {
    print(joinAll(generator))
  }

  for (const pair of pairs(3)) {
    const #[number, text] = pair
    print(`${Int.toString(number)} ${text}`)
  }
  return 0
}
