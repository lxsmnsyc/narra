// The std/char, std/option and std/result functions that @const bodies may
// call since std/regex runs while compiling. Each constant is computed by the
// compiler and again at run time, and both results are printed.
import * as Char from "std/char"
import * as Options from "std/option"
import * as Results from "std/result"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

@const
function codes(text: string): Array<int> uses alloc {
  let found: Array<int> = []
  for (const character of Str.chars(text)) {
    Arrays.push(mutable found, Char.code(character))
  }
  return found
}

@const
function decode(numbers: Array<int>): string uses alloc {
  let builder = Str.builder()
  for (const number of numbers) {
    const character = Options.withDefault(Char.fromCode(number), '?')
    Str.appendChar(mutable builder, character)
  }
  return Str.build(builder)
}

@const
function half(value: int): Result<int, string> uses alloc {
  if (value % 2 != 0) {
    return Err(`${Int.toString(value)} is odd`)
  }
  return Ok(value / 2)
}

@const
function halves(values: Array<int>): Array<int> uses alloc {
  let found: Array<int> = []
  for (const value of values) {
    const result = half(value)
    if (Results.ok(result) is Some(halved)) {
      Arrays.push(mutable found, halved)
    }
    Arrays.push(mutable found, Results.withDefault(result, -1))
  }
  return found
}

@const
function errors(values: Array<int>): Array<string> uses alloc {
  let found: Array<string> = []
  for (const value of values) {
    if (Results.err(half(value)) is Some(message)) {
      Arrays.push(mutable found, message)
    }
    const present = Options.isSome(Results.ok(half(value)))
    Arrays.push(mutable found, present ? "even" : "odd")
  }
  return found
}

const CODES = codes("Añ€😀")
const DECODED = decode([72, 105, 55296, 1114112, 128512, -1])
const HALVES = halves([4, 7, 10])
const ERRORS = errors([3, 8])

function showInts(values: Array<int>): string uses alloc {
  let parts: Array<string> = []
  for (const value of values) {
    Arrays.push(mutable parts, Int.toString(value))
  }
  return Str.join(parts, " ")
}

export function run(_args: Array<string>): int uses io, alloc {
  print(`${showInts(CODES)} | ${showInts(codes("Añ€😀"))}`)
  print(`${DECODED} | ${decode([72, 105, 55296, 1114112, 128512, -1])}`)
  print(`${showInts(HALVES)} | ${showInts(halves([4, 7, 10]))}`)
  print(`${Str.join(ERRORS, ", ")} | ${Str.join(errors([3, 8]), ", ")}`)
  return 0
}
