// error: does not implement Sendable
import * as Arrays from "std/array"
import * as Cells from "std/cell"
import * as Thread from "std/thread"

function each<T: Sendable>(items: Array<T>): int uses alloc {
  return Thread.scope((scope) => {
    const worker = Thread.start(scope, () => copy(items))
    return Arrays.length(Thread.join(worker))
  })
}

export function run(_args: Array<string>): int {
  return each([Cells.create(0)])
}
