import * as Int from "std/int"

struct Block {
  a: int
  b: int
  c: int
  d: int
  e: int
  f: int
  g: int
  h: int
}

export async function run(_args: Array<string>): int {
  const probe = async (block: Block): int => block.a + block.h
  print(Int.toString(await probe(Block { a: 1, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8 })))
  return 0
}
