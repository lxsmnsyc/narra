// error: this argument is not proven to meet `requires low <= high` of span; pass a constant, or a name checked first with an `if`
function span(low: int, high: int): int
  requires low <= high
{
  return high - low
}

function overlapping(first: int, second: int): int {
  if (first >= 0 && first <= 10 && second >= 5 && second <= 20) {
    return span(first, second)
  }
  return 0
}

export function run(_args: Array<string>): int {
  return overlapping(1, 6)
}
