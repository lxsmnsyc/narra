// What the standard traits hold for, by type.
struct Plain {
  n: int
  s: string
}

struct Floaty {
  x: f64
}

struct Handler {
  run: (x: int) => int
}

struct Tree {
  kids: Array<Tree>
  label: string
}

struct Bag {
  inner: Box<Plain>
  pairs: Array<#[int, string]>
}

distinct type Meters = int

struct Dist {
  m: Meters
}

struct Holder<T> {
  value: T
}

struct Uses {
  a: Holder<int>
  b: Holder<f64>
  c: Option<Plain>
  d: Result<int, string>
  e: Ordering
  f: #[int, f64]
}
