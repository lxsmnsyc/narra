import * as Async from "std/async"

export async function* numbers(limit: int): AsyncGenerator<int> uses alloc {
  for (let count = 0; count < limit; count++) {
    yield count
  }
}

async function* doubled(): AsyncGenerator<int> {
  yield* numbers(2)
}

export async function run(_args: Array<string>): int {
  const stream = doubled()
  const step = Async.next(stream)
  const first = await step
  if (first is Some(value)) {
    return value
  }
  return 0
}
