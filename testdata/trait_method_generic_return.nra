import * as Int from "std/int"

trait Stepper {
  function next(self: Self): Option<Self>
  function pair(self: Self): #[Self, int]
  function value(self: Self): int
  function done(self: Self): bool
}

struct Counter implements Stepper {
  n: int
}

implement Stepper for Counter {
  function next(self: Counter): Option<Counter> {
    if (self.n >= 3) {
      return None
    }
    return Some(Counter { n: self.n + 1 })
  }
  function pair(self: Counter): #[Counter, int] {
    return #[self, self.n * 10]
  }
  function value(self: Counter): int {
    return self.n
  }
  function done(self: Counter): bool {
    return self.n >= 3
  }
}

function advance(c: Counter): Option<Counter> {
  return Stepper.next(c)
}

function split(c: Counter): #[Counter, int] {
  return Stepper.pair(c)
}

export function run(args: Array<string>): int {
  const c = Counter { n: 1 }
  if (advance(c) is Some(d)) {
    print(Int.toString(Stepper.value(d)))
  }
  const #[e, ten] = split(c)
  print(Int.toString(Stepper.value(e)))
  print(Int.toString(ten))
  if (Stepper.done(Counter { n: 3 })) {
    print("done")
  }
  return 0
}
