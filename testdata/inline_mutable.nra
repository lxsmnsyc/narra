// A mutable parameter of an @inline function points at the caller's place, so
// the copied body writes the caller's struct, field or array.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

struct Counter {
  count: int
  names: Array<string>
}

struct Totals {
  counter: Counter
  rounds: int
}

@inline
function record(mutable counter: Counter, name: string, accept: (name: string) => bool) {
  if (!accept(name)) {
    return
  }
  counter.count++
  Arrays.push(mutable counter.names, name)
}

@inline
function swapEnds(mutable items: Array<int>): int {
  const last = Arrays.length(items) - 1
  const first = items[0]
  items[0] = items[last]
  items[last] = first
  return first
}

export function run(_args: Array<string>): int uses io, alloc {
  let counter = Counter { count: 0, names: [] }
  const minimum = 3
  for (const name of Arrays.values(["al", "bea", "cyd", "di"])) {
    record(mutable counter, name, (candidate) => Str.length(candidate) >= minimum)
  }
  print(`${Int.toString(counter.count)} ${Str.join(counter.names, ",")}`)

  // A field of a field is a place too.
  let totals = Totals { counter: Counter { count: 5, names: [] }, rounds: 1 }
  record(mutable totals.counter, "eve", (_name) => true)
  print(`${Int.toString(totals.counter.count)} ${Str.join(totals.counter.names, ",")}`)

  let numbers = [1, 2, 3]
  const moved = swapEnds(mutable numbers)
  print(`${Int.toString(moved)} ${Int.toString(numbers[0])} ${Int.toString(numbers[2])}`)
  return 0
}
