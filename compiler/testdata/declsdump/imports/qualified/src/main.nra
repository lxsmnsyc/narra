import * as L from "q/lib"
import { Pair, Named, LIMIT, make, Kind } from "q/lib"
import * as Str from "std/string"
import { slice, trim } from "std/string"

struct Token implements Named {
  own: L.Token
  kind: Kind
}
implement Named for Token {
  function name(self: Token): string {
    return self.own.text
  }
}
struct Holder {
  pair: Pair<L.Token, Token>
  qual: L.Pair<int, L.Id>
  ids: Array<L.Id>
  sb: StringBuilder
}
const COPY: int = 4
function use(t: L.Token, k: L.Kind, f: (L.Token) => Option<L.Kind>): #[Token, L.Token] {
  return #[Token { own: t, kind: k }, t]
}

export function run(args: Array<string>): int {
  return 0
}
