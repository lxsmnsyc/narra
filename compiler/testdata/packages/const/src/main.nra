import * as Int from "std/int"
import * as T from "cst/tables"
import { LIMIT, KEYWORDS, Kind, Keyword } from "cst/tables"

const DOUBLE = LIMIT * 2

function describe(k: Kind): string {
  return match (k) {
    Word => "word"
    Op(s) => `op ${s}`
  }
}

export function run(args: Array<string>): int {
  print(Int.toString(LIMIT))
  print(Int.toString(DOUBLE))
  print(T.GREETING)
  print(describe(T.DEFAULT_KIND))
  for (const kw of Array.values(KEYWORDS)) {
    print(`${kw.text}: ${describe(kw.kind)}`)
  }
  print(Int.toString(Array.length(T.KEYWORDS)))
  return 0
}
