// error: cannot use == on Sender<int>
import * as Channel from "std/channel"

export function run(_args: Array<string>): int {
  const #[sender, receiver] = Channel.create<int>(1)
  const #[otherSender, otherReceiver] = Channel.create<int>(1)
  if (sender == otherSender || receiver != otherReceiver) {
    return 1
  }
  const _byReceiver: Map<Channel.Receiver<int>, int> = Map {}
  return 0
}
