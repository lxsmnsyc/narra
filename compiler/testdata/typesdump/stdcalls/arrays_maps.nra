import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Boxes from "std/box"
import * as Ranges from "std/range"

struct Counter {
  items: Array<int>
}

function arrays(): int {
  let items = Arrays.filled(0, 3)
  Arrays.push(mutable items, 4)
  let counter = Counter { items: [1, 2] }
  Arrays.push(mutable counter.items, 5)
  const hinted: Array<string> = Arrays.filled("x", 2)
  let total = 0
  for (const value of Arrays.values(items)) {
    total = total + value
  }
  for (const index of Ranges.upTo(Arrays.length(hinted))) {
    total = total + index
  }
  for (const index of Ranges.between(1, 4)) {
    total = total + index
  }
  return total + Arrays.length(counter.items)
}

function maps(): int {
  let table: Map<string, int> = Map {}
  table["a"] = 1
  table["b"] = 2
  const removed = Maps.remove(mutable table, "a")
  let total = Maps.size(table)
  for (const key of Maps.keys(table)) {
    total = total + Arrays.length(Arrays.values([key]))
  }
  for (const entry of Maps.entries(table)) {
    total = total + Arrays.length(Arrays.values([entry]))
  }
  if (removed) {
    total = total + 1
  }
  return total
}

function boxes(): int {
  const boxed = Boxes.new(7)
  const hinted: Box<string> = Boxes.new("s")
  return 1
}
