import * as Str from "std/string"

struct Out {
  buf: StringBuilder
}

function add(sb: StringBuilder, s: string): StringBuilder {
  let copy = sb
  Str.append(mutable copy, s)
  return copy
}

export function run(args: Array<string>): int {
  let o = Out { buf: Str.builder() }
  Str.append(mutable o.buf, "a")
  const more = add(o.buf, "b")
  print(Str.build(o.buf))
  print(Str.build(more))
  return 0
}
