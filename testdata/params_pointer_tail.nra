// Self tail calls with large parameters: two arguments swapped on every jump,
// a parameter passed on unchanged, a new value built from the old one, and a
// caller whose value must stay as it was after the loop.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

struct Big {
  name: string
  tags: Array<string>
  count: int
  weight: int
}

function makeBig(name: string, count: int): Big {
  return Big { name: repeatString(name, 2), tags: [name, `${name}-tag`], count: count, weight: 1 }
}

function alternate(first: Big, second: Big, steps: int, log: string): string {
  if (steps == 0) {
    return log
  }
  // Each jump swaps the two large parameters.
  return alternate(second, first, steps - 1, `${log} ${first.name}:${first.tags[1]}`)
}

function grow(big: Big, context: Big, steps: int): Big from big {
  if (steps == 0) {
    return big
  }
  // context is passed on as it is; big is rebuilt from itself.
  let tags = big.tags
  Arrays.push(mutable tags, `${context.name}${Int.toString(steps)}`)
  return grow(Big { ...big, tags: tags, count: big.count + context.count }, context, steps - 1)
}

function rotate(first: Big, second: Big, third: Big, steps: int): string {
  if (steps == 0) {
    return `${first.name} ${second.name} ${third.name}`
  }
  return rotate(third, first, second, steps - 1)
}

export function run(args: Array<string>): int {
  const left = makeBig("l", 1)
  const right = makeBig("r", 2)
  print(alternate(left, right, 5, "start"))
  // The caller's values are unchanged by the jumps.
  print(`${left.name} ${left.tags[1]} ${right.name} ${right.tags[1]}`)

  const grown = grow(makeBig("g", 0), makeBig("c", 2), 4)
  print(`${grown.name} ${Int.toString(grown.count)} ${Str.join(grown.tags, ",")}`)

  print(rotate(makeBig("a", 0), makeBig("b", 0), makeBig("c", 0), 4))
  print(alternate(makeBig("x", 0), makeBig("y", 0), 3, "temporaries"))
  return 0
}

function repeatString(text: string, count: int): string uses alloc {
  return match (Str.repeat(text, count)) { Some(repeated) => repeated, None => "" }
}
