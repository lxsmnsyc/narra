// error: block_expressions_label_reused.nra:7:7: label "outer" is already used by an enclosing loop
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  outer: for (const i of Ranges.upTo(3)) {
    const v = {
      outer: for (const j of Ranges.upTo(2)) {
        print(`${j}`)
      }
      return i
    }
    print(`${v}`)
  }
  return 0
}
