// error: E1052, == runs a user implement block
struct Name implements Equatable {
  text: string
}

implement Equatable for Name {
  function equals(first: Name, second: Name): bool {
    return first.text == second.text
  }
}

@const
export function same(first: Name, second: Name): bool {
  return first == second
}

export function run(args: Array<string>): int {
  return 0
}
