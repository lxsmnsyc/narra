// error: this argument is not proven to meet `requires count < 0 || count > 10` of outside; pass a constant, or a name checked first with an `if`
function outside(count: int): int
  requires count < 0 || count > 10
{
  return count
}

function either(first: int, second: int): int
  requires first != 0 || second != 0
{
  return first + second
}

function hull(count: int): int {
  // The hull of the check is every int but zero, which proves neither side.
  if (count < 0 || count > 10) {
    return outside(count)
  }
  return 0
}

export function run(_args: Array<string>): int {
  return hull(3) + either(hull(1), 2) + either(hull(1), hull(2))
}
