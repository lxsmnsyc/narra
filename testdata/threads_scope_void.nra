// A scope whose body returns nothing starts threads and lets the scope join them.
import * as Thread from "std/thread"
import * as Shared from "std/shared"
import * as Int from "std/int"

export function run(args: Array<string>): int uses io, alloc {
  const total = Shared.create(0)
  Thread.scope((scope) => {
    const _first = Thread.start(scope, () => Shared.update(total, (value) => value + 1))
    const _second = Thread.start(scope, () => Shared.update(total, (value) => value + 2))
  })
  print(`total ${Int.toString(Shared.get(total))}`)
  Thread.scope((scope) => {
    const _worker = Thread.start(scope, () => 1)
  })
  print("done")
  return 0
}
