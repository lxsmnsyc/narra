// The test program of the package: `narrac run -sanitize -bin changesets-tests packages/changesets`.
// It prints a line for each failed check and then the counts, and exits with 1 when any failed. An
// argument names the folder of the fixtures; it defaults to packages/changesets/fixtures, so run
// it from the repository root.

import * as Arrays from "std/array"
import * as Cells from "std/cell"
import { createReport, describeCount } from "changesets/checkkit"
import { runCommandChecks } from "changesets/checkcommands"
import { runParseChecks } from "changesets/checkparse"

export function run(args: Array<string>): int uses io, alloc {
  const report = createReport()
  let fixtures = "packages/changesets/fixtures"
  if (Arrays.length(args) > 1) {
    fixtures = args[1]
  }
  runParseChecks(report)
  runCommandChecks(report, fixtures)
  print(describeCount(report))
  if (Cells.get(report.failed) > 0) {
    return 1
  }
  return 0
}
