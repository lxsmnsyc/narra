// error: a tag must be a function of (Array<string> or Template.Raw, Array<T>) with no mutable parameter, found (Array<string>) => string
import * as Str from "std/string"

function tag(parts: Array<string>): string {
  return Str.join(parts, "")
}

export function run(_args: Array<string>): int {
  print(tag`x`)
  return 0
}
