import * as Int from "std/int"

function twice(x: int): int {
  return x + x
}

function outer(): int {
  // called before and after its declaration
  const before = triple(2)
  function triple(x: int): int {
    return x * 3
  }
  const after = triple(3)
  return before + after
}

function other(): int {
  // same name as a local function of another function
  function triple(x: int): int {
    return x * 30
  }
  return triple(1)
}

function factorial(n: int): int {
  function go(k: int, acc: int): int {
    if (k <= 1) {
      return acc
    }
    return go(k - 1, acc * k)
  }
  return go(n, 1)
}

function parity(n: int): bool {
  function isEven(k: int): bool {
    if (k == 0) {
      return true
    }
    return isOdd(k - 1)
  }
  function isOdd(k: int): bool {
    if (k == 0) {
      return false
    }
    return isEven(k - 1)
  }
  return isEven(n)
}

function apply(f: (x: int) => int, x: int): int {
  return f(x)
}

export function run(args: Array<string>): int {
  print(Int.toString(outer()))
  print(Int.toString(other()))
  print(Int.toString(factorial(5)))
  print(Int.toString(twice(4)))
  if (parity(10) && !parity(7)) {
    print("parity ok")
  }
  // a local function used as a value, inside a block and inside an arrow
  if (true) {
    function inc(x: int): int {
      return x + 1
    }
    print(Int.toString(apply(inc, 1)))
    print(Int.toString(apply((x) => inc(x) * 2, 1)))
  }
  return 0
}
