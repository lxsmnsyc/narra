import * as Arrays from "std/array"

export function total(prices: Array<int>): int {
  let sum = 0
  let count = Arrays.length(prices)
  for (const price of prices) {
    sum = sum + price
  }
  return sum
}

export function discounted(price: int, percent: int): int {
  let rate = percent
  if (percent > 100) {
    const rate = 100
    return price - price * rate / 100
  }
  return price - price * rate / 100
}
