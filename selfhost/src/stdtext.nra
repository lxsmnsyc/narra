// The other case of an ASCII letter, or -1.\nfunction otherCase(code: int): int {\n  if (code >= 65 && code <= 90) {\n    return code + 32\n  }\n  if (code >= 97 && code <= 122) {\n    return code - 32\n  }\n  return -1\n}\n\nfunction parseGroup(mutable parser: Parser): int uses alloc {\n  const open = parser.position\n  parser.position += 1\n  let capture = -1\n  if (peekByte(parser, parser.position) == 63) {\n    const kind = peekByte(parser, parser.position + 1)\n    if (kind == 58) {\n      parser.position += 2\n      capture = 0\n    } else if (kind == 61 || kind == 33) {\n      fail(mutable parser, open, \"lookahead is not supported: the engine is linear-time\")\n      return addEmpty(mutable parser)\n    } else if (kind == 60) {\n      const after = peekByte(parser, parser.position + 2)\n      if (after == 61 || after == 33) {\n        fail(mutable parser, open, \"lookbehind is not supported: the engine is linear-time\")\n        return addEmpty(mutable parser)\n      }\n      parser.position += 2\n      const name = readGroupName(mutable parser, open)\n      if (parser.failed) {\n        return addEmpty(mutable parser)\n      }\n      parser.groupCount += 1\n      capture = parser.groupCount\n      Arrays.push(mutable parser.names, name)\n    } else {\n      return parseFlags(mutable parser, open)\n    }\n  } else {\n    parser.groupCount += 1\n    capture = parser.groupCount\n    Arrays.push(mutable parser.names, \"\")\n  }\n  return parseGroupBody(mutable parser, open, capture)\n}\n\n// Parses up to the `)` of the group that opened at open. A capture of 0 is a\n// group that does not capture. The flags set inside the group end with it.\nfunction parseGroupBody(mutable parser: Parser, open: int, capture: int): int uses alloc {\n  if (parser.depth >= MAX_DEPTH) {\n    fail(mutable parser, open, `groups nested deeper than \${Int.toString(MAX_DEPTH)}`)\n    return addEmpty(mutable parser)\n  }\n  const ignoreCase = parser.ignoreCase\n  const multiline = parse