import * as Arrays from "std/array"
import * as Ranges from "std/range"

enum Mode {
  Plain
  Loud(level: int)
}

function render(
  name: string,
  depth: int = 0,
  indent: string = "  ",
  last: bool = false,
): string uses alloc {
  let prefix = ""
  for (const _ of Ranges.upTo(depth)) {
    prefix = `${prefix}${indent}`
  }
  if (last) {
    return `${prefix}${name}.`
  }
  return `${prefix}${name}`
}

function describe(
  count: Option<int> = None,
  extra: Option<int> = Some(1),
  mode: Mode = Mode.Loud(2),
  items: Array<int> = [],
  sign: int = -1,
): string uses alloc {
  const countText = match (count) { Some(value) => Show.show(value), None => "none" }
  const extraText = match (extra) { Some(value) => Show.show(value), None => "none" }
  const modeText = match (mode) {
    Mode.Plain => "plain"
    Mode.Loud(level) => `loud ${Show.show(level)}`
  }
  return `${countText} ${extraText} ${modeText} ${Show.show(Arrays.length(items))} ${Show.show(sign)}`
}

function pick<T>(
  values: Array<T>,
  index: int,
  fallback: Option<T> = None,
): Option<T> from fallback {
  if (index < Arrays.length(values)) {
    return Some(copy(values[index]))
  }
  return fallback
}

function showPicked(picked: Option<int>): string uses alloc {
  return match (picked) { Some(value) => Show.show(value), None => "none" }
}

function halve(value: int, steps: int = 0): int {
  if (value <= 1) {
    return steps
  }
  if (value % 2 == 1) {
    // Leaving out steps starts the count again.
    return halve(value + 1)
  }
  return halve(value / 2, steps + 1)
}

function share(total: int, people: int = 2): int
  requires people > 0
{
  return total / people
}

function scale(value: int, factor: int = 10): int {
  return value * factor
}

@const
function power(base: int, exponent: int = 3): int {
  let result = 1
  for (const _ of Ranges.upTo(exponent)) {
    result = result * base
  }
  return result
}

const CUBED = power(2)

function* countTo(limit: int, step: int = 1): Generator<int> {
  let value = 0
  while (value < limit) {
    yield value
    value = value + step
  }
}

export function run(_args: Array<string>): int uses io, alloc {
  // Positional calls that leave out one, two and three defaults.
  print(render("a", 1, "--", true))
  print(render("b", 1, "--"))
  print(render("c", 2))
  print(render("d"))
  // A named call that skips a middle default, and a reordered named call.
  print(render("e", indent: "..", depth: 2))
  print(render("f", last: true))
  print(render(last: true, name: "g", depth: 1))
  // Option, constructor, array and unary defaults.
  print(describe())
  print(describe(Some(3), None, Mode.Plain, [1, 2], 5))
  print(describe(mode: Mode.Plain, sign: 7))
  // A generic default, with and without the argument.
  print(showPicked(pick([1, 2], 5)))
  print(showPicked(pick([1, 2], 5, Some(9))))
  print(showPicked(pick([1, 2], 1)))
  // A plain function and a generator.
  print(Show.show(scale(4)))
  print(Show.show(scale(4, 3)))
  // An @const function, at compile time and at run time.
  print(Show.show(CUBED))
  print(Show.show(power(3, 2)))
  print(Show.show(power(3)))
  let total = 0
  for (const value of countTo(4)) {
    total = total + value
  }
  for (const value of countTo(10, 5)) {
    total = total + value
  }
  print(Show.show(total))
  // Two instances of one generic default in one body, a call nested in an
  // argument that fills the same default, and a self-call that fills one.
  const word = match (pick(["x"], 3)) { Some(value) => value, None => "none" }
  print(`${showPicked(pick([4], 3))} ${word}`)
  print(render(render("i", 1), 1))
  print(Show.show(halve(5)))
  // A requires pattern holds for the filled default.
  print(Show.show(share(10) + share(10, 5)))
  // A function value takes every argument.
  const draw = render
  print(draw("h", 1, "__", false))
  return 0
}
