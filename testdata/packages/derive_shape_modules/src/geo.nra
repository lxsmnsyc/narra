// Types that derive Shape, used from another module.
import * as Json from "std/json"

export struct Point derives Shape {
  x: int
  y: int
}

export enum Labeled<T> derives Shape {
  Plain(value: T)
  Named(name: string, value: T)
}

// An opaque struct uses its derived Shape in its own module only.
export opaque struct Span derives Shape {
  start: int
  finish: int
}

export function span(start: int, finish: int): Span {
  return Span { start: start, finish: finish }
}

export function saveSpan(span: Span): string uses alloc {
  return Json.encode(span)
}

export function loadSpan(text: string): Result<Span, string> uses alloc {
  const decoded = Json.decode<Span>(text)
  if (decoded is Err(message)) {
    return Err(message)
  }
  if (decoded.value.start > decoded.value.finish) {
    return Err("start is after finish")
  }
  return Ok(decoded.value)
}
