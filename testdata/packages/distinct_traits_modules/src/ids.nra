import * as Int from "std/int"

export trait Label {
  function label(value: Self): string
}

export distinct type OrderId = int implements Label derives Ordered, Show

export opaque distinct type Secret = string derives Show

implement Label for OrderId {
  function label(value: OrderId): string {
    return `order-${Int.toString(OrderId.toInt(value))}`
  }
}

export function makeSecret(text: string): Secret {
  return Secret.from(text)
}
