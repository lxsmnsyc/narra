// error: Vector<4>
struct Vector<const N: int> {
  values: Array<f64>
}

function zeros<const N: int>(): Vector<N> uses alloc {
  return Vector { values: [] }
}

function size<const N: int>(_vector: Vector<N>): int {
  return N
}

export function run(_args: Array<string>): int {
  const plane: Vector<3> = zeros<4>()
  const line: Vector<1> = Vector<2> { values: [] }
  return size(plane) + size(line)
}
