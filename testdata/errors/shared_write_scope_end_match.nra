// error: Arrays.push(mutable list, ...) may change list, which bag.items still holds until its block ends at line 21
// A match arm's binding of a fresh subject holds it until the arm ends.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Bag {
  items: Array<int>
}

function make(): Bag uses alloc {
  return Bag { items: [1, 2] }
}

export function run(_args: Array<string>): int uses io, alloc {
  match (Some(make())) {
    Some(bag) => {
      let list = bag.items
      Arrays.push(mutable list, 1)
      print(Int.toString(Arrays.length(list)))
    }
    None => {}
  }
  return 0
}
