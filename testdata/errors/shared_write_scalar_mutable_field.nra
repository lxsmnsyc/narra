// error: moveRight(mutable node.pos) may change node.pos, which start still uses at line 21
struct Pos {
  line: int
  column: int
}

struct Node {
  name: string
  pos: Pos
}

function moveRight(mutable pos: Pos) {
  pos.column += 1
}

export function run(_args: Array<string>): int {
  let node = Node { name: "a", pos: Pos { line: 1, column: 2 } }
  const start = node.pos
  // `mutable node.pos` writes node.pos and what is inside it.
  moveRight(mutable node.pos)
  return start.column + node.pos.column
}
