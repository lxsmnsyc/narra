import * as Io from "std/io"
import * as Str from "std/string"
import * as Int from "std/int"

function yesNo(value: bool): string {
  if (value) {
    return "yes"
  }
  return "no"
}

function show(label: string, result: Result<Option<string>, string>) {
  if (result is Ok(maybe)) {
    if (maybe is Some(line)) {
      const cr = yesNo(Str.endsWith(line, "\r"))
      print(`${label}: ${Int.toString(Str.length(line))} bytes, ends with CR: ${cr}`)
    } else {
      print(`${label}: end of input`)
    }
  } else if (result is Err(message)) {
    print(`${label}: error ${message}`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  show("line 1", Io.readLine())
  show("line 2", Io.readLine())
  show("line 3", Io.readLine())
  // A framed message: header, blank line, then exactly the counted bytes.
  const header = Io.readLine()
  if (header is Ok(Some(text))) {
    print(`header: ${substring(text, 0, 14)}`)
  }
  show("blank", Io.readLine())
  const body = Io.readBytes(10)
  if (body is Ok(text)) {
    print(`body: ${text} (${Int.toString(Str.length(text))} bytes)`)
  }
  show("last", Io.readLine())
  show("after", Io.readLine())
  const rest = Io.readAll()
  if (rest is Ok(text)) {
    print(`rest: ${Int.toString(Str.length(text))} bytes`)
  }
  const past = Io.readBytes(1)
  if (past is Err(message)) {
    print(`past the end: ${message}`)
  }
  const negative = Io.readBytes(0 - 1)
  if (negative is Err(message)) {
    print(`negative: ${message}`)
  }
  return 0
}

function substring(text: string, start: int, end: int): string uses alloc {
  return match (Str.slice(text, start, end)) { Some(piece) => piece, None => "" }
}
