// error: closure_borrow_mutable_arg.nra:8:16: "items" is assigned by a closure passed to this call
function each(mutable _items: Array<int>, f: () => void) {
  f()
}

export function run(args: Array<string>): int {
  let items = [1, 2]
  each(mutable items, () => {
    items = []
  })
  return 0
}
