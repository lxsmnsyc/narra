// Panicked: in a test build, a panic inside a coroutine comes back from
// Co.resume as a value, and the coroutine is finished afterwards.
import * as Co from "std/coroutine"
import { Step } from "std/coroutine"
import * as Int from "std/int"
import * as Test from "std/test"

// divider yields 100 / input for each input.
function* divider(): Coroutine<int, int> {
  let result = 0
  while (true) {
    const divisor = yield result
    result = 100 / divisor
  }
}

function* upTo(limit: int): Generator<int> {
  let n = 0
  while (n < limit) {
    yield n
    n = n + 1
    if (n == 2) {
      panic("generator gave up")
    }
  }
}

test "a division by zero is Panicked" {
  let divide = divider()
  Test.eq(Co.resume(mutable divide, 1), Step.Yielded(0))
  Test.eq(Co.resume(mutable divide, 4), Step.Yielded(25))
  Test.eq(Co.resume(mutable divide, 0), Step.Panicked("division by zero"))
  Test.eq(Co.resume(mutable divide, 5), Step.Done)
}

test "a generator can panic too" {
  let numbers = upTo(5)
  Test.eq(Co.resume(mutable numbers), Step.Yielded(0))
  Test.eq(Co.resume(mutable numbers), Step.Yielded(1))
  Test.eq(Co.resume(mutable numbers), Step.Panicked("generator gave up"))
  Test.eq(Co.resume(mutable numbers), Step.Done)
}

test "a coroutine that does not panic is unaffected" {
  let divide = divider()
  Test.eq(Co.resume(mutable divide, 0), Step.Yielded(0))
  Test.eq(Co.resume(mutable divide, 10), Step.Yielded(10))
  Test.eq(Co.resume(mutable divide, 3), Step.Yielded(33))
  Test.eq(Int.toString(1), "1")
}
