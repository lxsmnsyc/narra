// Tags of another module: one with decoded parts and one with raw parts.
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { Raw } from "std/template"

export function escape(parts: Array<string>, values: Array<string>): string uses alloc {
  let builder = Str.builder()
  for (const index of Ranges.upTo(Arrays.length(parts))) {
    Str.append(mutable builder, parts[index])
    if (index < Arrays.length(values)) {
      Str.append(mutable builder, Str.replace(values[index], "<", "&lt;"))
    }
  }
  return Str.build(builder)
}

export function source(parts: Raw, _values: Array<int>): string uses alloc {
  return Str.join(Raw.toArray(parts), "|")
}
