// A self call, a two-function cycle and a function outside any cycle.
export function countdown(count: int): int {
  if (count <= 0) {
    return 0
  }
  return countdown(count - 1)
}

export function isEven(count: int): bool {
  if (count == 0) {
    return true
  }
  return isOdd(count - 1)
}

function isOdd(count: int): bool {
  if (count == 0) {
    return false
  }
  return isEven(count - 1)
}

export function both(count: int): bool {
  return isEven(countdown(count))
}
