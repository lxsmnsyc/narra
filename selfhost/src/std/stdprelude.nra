// The registry rows of the prelude (assert, copy, panic, print). copy is checked
// and emitted by narrac/std/stdcopy.
import { StdFunc } from "narrac/std/builtins"

export const PRELUDE_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "assert",
    module: "",
    key: "assert",
    parameters: ["bool"],
    parameterNames: ["condition"],
    result: "void",
  },
  StdFunc {
    name: "copy",
    module: "",
    key: "copy",
    check: "checkCopy",
    signature: "<T>(value: T): T",
  },
  StdFunc {
    name: "panic",
    module: "",
    key: "panic",
    parameters: ["string"],
    parameterNames: ["message"],
    result: "void",
  },
  StdFunc {
    name: "print",
    module: "",
    key: "print",
    parameters: ["string"],
    parameterNames: ["text"],
    result: "void",
    effects: ["io"],
  },
]
