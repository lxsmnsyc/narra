// error: Function `begin` uses `alloc` (through `compute`) but its signature does not declare it; write `uses alloc`
import * as Async from "std/async"

async function compute(): int {
  return 1
}

export function begin(): Async<int> {
  return compute()
}

export function block(): Async<int> {
  return async {
    return 2
  }
}

export async function run(_args: Array<string>): int {
  Async.detach(begin())
  return await block()
}
