// std/json: a JSON-RPC request picked apart with match, and a response built and written.
import * as Json from "std/json"
import * as Int from "std/int"
import { Value } from "std/shape"

function describe(request: Value): string uses alloc {
  if (request is Value.Record(fields)) {
    let method = "?"
    if (fields["method"] is Some(Value.Text(name))) {
      method = name
    }
    let identifier = "none"
    if (fields["id"] is Some(Value.Int(number))) {
      identifier = Int.toString(number)
    } else if (fields["id"] is Some(Value.Text(text))) {
      identifier = text
    }
    let count = 0
    if (fields["params"] is Some(Value.List(items))) {
      for (const _ of items) {
        count = count + 1
      }
    }
    return `${method} id=${identifier} params=${Int.toString(count)}`
  }
  return "not an object"
}

function reply(identifier: int, result: Value): string uses alloc {
  let fields: Map<string, Value> = Map {}
  fields["jsonrpc"] = Value.Text("2.0")
  fields["id"] = Value.Int(identifier)
  fields["result"] = result
  return Json.stringify(Value.Record(fields))
}

export function run(args: Array<string>): int uses io, alloc {
  const requests = [
    "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"textDocument/hover\",\"params\":[1,2]}",
    "{\"jsonrpc\": \"2.0\", \"method\": \"initialized\"}",
    "{\"id\": \"abc\", \"method\": \"shutdown\", \"params\": []}",
    "[1, 2]",
  ]
  for (const request of requests) {
    const parsed = Json.parse(request)
    if (parsed is Ok(value)) {
      print(describe(value))
    }
  }
  print(reply(7, Value.Text("contents")))
  print(reply(8, Value.Null))
  return 0
}
