// std/regex: each bad pattern returns a RegexError with the byte offset of the
// mistake and a reason.
import * as Regexes from "std/regex"
import * as Int from "std/int"
import * as Str from "std/string"

function check(pattern: string) uses io, alloc {
  const compiled = Regexes.compile(pattern)
  if (compiled is Err(error)) {
    print(`/${pattern}/: ${Int.toString(error.position)}: ${error.reason}`)
    return
  }
  print(`/${pattern}/: compiled, but it should not`)
}

// A pattern too long to print, named instead.
function checkLong(name: string, pattern: string) uses io, alloc {
  const compiled = Regexes.compile(pattern)
  if (compiled is Err(error)) {
    print(`${name}: ${Int.toString(error.position)}: ${error.reason}`)
    return
  }
  print(`${name}: compiled, but it should not`)
}

function repeatText(text: string, count: int): string uses alloc {
  if (Str.repeat(text, count) is Some(repeated)) {
    return repeated
  }
  return ""
}

export function run(_args: Array<string>): int {
  check("(abc")
  check("a(b(c)")
  check("abc)")
  check("[abc")
  check("[z-a]")
  check("[a-\\d]")
  check("[\\w-z]")
  check("(a)\\1")
  check("(?<x>a)\\k<x>")
  check("a(?=b)")
  check("a(?!b)")
  check("(?<=a)b")
  check("(?<!a)b")
  check("a{2000}")
  check("a{1,2000}")
  check("a{3,2}")
  check("(?:a{1000}){20}")
  check("*a")
  check("a**")
  check("a{2}+")
  check("^*")
  check("\\b+")
  check("abc\\")
  check("\\q")
  check("\\p{L}")
  check("\\x4")
  check("\\u12")
  check("\\u{110000}")
  check("\\u{}")
  check("\\c1")
  check("(?<1a>x)")
  check("(?<>x)")
  check("(?<a>x)(?<a>y)")
  check("(?x)")
  check("(?)")
  check("(?i")
  checkLong("3,000 groups", repeatText("(a)", 3000))
  return 0
}
