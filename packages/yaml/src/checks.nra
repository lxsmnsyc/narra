// The test program of the package: `narrac run -sanitize packages/yaml`. It prints a line for each
// failed check and then the counts, and exits with 1 when any failed. An argument names the folder of
// the yaml-test-suite data; it defaults to packages/yaml/suite, so run it from the repository root.

import * as Arrays from "std/array"
import * as Cells from "std/cell"
import * as Int from "std/int"
import { createReport, describeCount } from "yaml/checkkit"
import { runReaderChecks } from "yaml/checkreader"
import { runRoundChecks } from "yaml/checkround"
import { runSuite } from "yaml/checksuite"

export function run(args: Array<string>): int uses io, alloc {
  const report = createReport()
  let directory = "packages/yaml/suite"
  if (Arrays.length(args) > 1) {
    directory = args[1]
  }
  runReaderChecks(report)
  runRoundChecks(report)
  const counts = runSuite(report, directory)
  print(
    `yaml-test-suite: ${Int.toString(counts.passed)} passed, ${Int.toString(counts.skipped)} skipped, ${Int.toString(counts.failed)} failed`,
  )
  print(describeCount(report))
  if (Cells.get(report.failed) > 0) {
    return 1
  }
  return 0
}
