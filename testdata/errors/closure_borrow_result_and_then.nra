// error: closure_borrow_result_and_then.nra:6:31: "r" is assigned by a closure passed to this call
import * as Results from "std/result"

export function run(args: Array<string>): int {
  let r: Result<string, string> = Ok("a")
  const out = Results.andThen(r, (s) => {
    r = Err("boom")
    const next: Result<string, string> = Ok(s)
    return next
  })
  return 0
}
