function scan(items: Array<int>, limit: int): int {
  let total = 0
  for (let i = 0; i < limit; i = i + 1) {
    total = total + i
  }
  for (;;) {
    break
  }
  for (let n = 0; n < limit; ) {
    n = n + 2
  }
  for (; total < limit; total = total + 1) {
    continue
  }
  // a comment before the loop
  outer: for (let row = 0; row < limit; row = row + 1) {
    for (let column = 0; column < limit; column = column + 1) {
      continue outer
    }
  }
  for (
    let veryLongCounterNameForTheLoop = 0;
    veryLongCounterNameForTheLoop < limit;
    veryLongCounterNameForTheLoop = veryLongCounterNameForTheLoop + 1
  ) {
    total = total + 1
  }
  return total
}
