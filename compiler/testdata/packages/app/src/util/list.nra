import * as Int from "std/int"

// A private helper type, used inside the exported generic struct.
struct Count {
  n: int
}

export struct Bag<T> {
  items: Array<T>
  count: Count
}

export function bagOf<T>(items: Array<T>): Bag<T> {
  return Bag { items: items, count: Count { n: Array.length(items) } }
}

export function size<T>(b: Bag<T>): int {
  return b.count.n
}

export function lastOr<T>(items: Array<T>, fallback: T): T {
  const n = Array.length(items)
  if (n == 0) {
    return fallback
  }
  return items[n - 1]
}

// Private, and the same name as a function in app/text.
function label(n: int): string {
  return `#${Int.toString(n)}`
}

export function numbered(n: int): string uses alloc {
  return label(n)
}
