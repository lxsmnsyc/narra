// error: mutable_read_conflict_match.nra:13:17: "x" is passed as mutable in one call, so the rest of the expression cannot use it
struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = 10
  return 0
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  return match (x.n + bump(mutable x)) { 0 => 1, _ => 2 }
}
