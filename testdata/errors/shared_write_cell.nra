// error: value[0] = ... may change value, which the cell counter still holds
import * as Cells from "std/cell"

export function run(_args: Array<string>): int uses alloc {
  const counter = Cells.create([1, 2])
  // A value read from a cell shares it with the cell.
  let value = Cells.get(counter)
  value[0] = 3
  return value[0]
}
