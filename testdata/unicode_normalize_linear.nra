// std/unicode: canonical ordering of a long run of marks takes time linear in
// its length times its logarithm, not its square. The time is printed only as
// a pass or fail against a eight second bound, so the output is stable.
import * as Unicode from "std/unicode"
import { NormalForm } from "std/unicode"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Time from "std/time"

function repeatText(text: string, count: int): string uses alloc {
  if (Str.repeat(text, count) is Some(repeated)) {
    return repeated
  }
  return ""
}

function check(name: string, text: string, form: NormalForm, want: string) uses io, alloc {
  const started = Time.now()
  const normal = Unicode.normalize(text, form)
  const elapsed = Time.elapsed(started)
  let answer = "wrong"
  if (normal == want) {
    answer = "right"
  }
  let speed = "under 8 s"
  if (elapsed.nanos > 8000000000) {
    speed = "over 8 s"
  }
  print(`${name}: ${answer}, ${Int.toString(Str.length(normal))} bytes, ${speed}`)
}

export function run(_args: Array<string>): int uses io, alloc {
  // Acute (class 230) and grave below (class 220) alternate; the sort moves every grave below first.
  const count = 40000
  const marks = `a${repeatText("\u{301}\u{316}", count)}`
  const ordered = `a${repeatText("\u{316}", count)}${repeatText("\u{301}", count)}`
  check("nfd of 80,000 alternating marks", marks, NormalForm.NFD, ordered)
  // In NFC the first acute joins the a; the rest stay in order.
  const composed = `\u{e1}${repeatText("\u{316}", count)}${repeatText("\u{301}", count - 1)}`
  check("nfc of 80,000 alternating marks", marks, NormalForm.NFC, composed)
  return 0
}
