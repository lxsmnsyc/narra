// An async block that returns a captured value returns a copy(...) of it, as
// an arrow function does, so a write to what await gave copies where the
// source says so.
import * as Arrays from "std/array"
import * as Int from "std/int"

export async function run(_args: Array<string>): int {
  const items = [1, 2]
  let got = await async {
    return copy(items)
  }
  Arrays.push(mutable got, 3)
  print(`${Int.toString(Arrays.length(items))} ${Int.toString(Arrays.length(got))}`)
  return 0
}
