// await inside expressions: call arguments, conditions, operators, `&&`, a
// template, a struct literal and a block expression. Each task prints when it
// starts and ends, so the output shows the operands run left to right, and the
// right side of `&&` runs only when the left side is true.
import * as Int from "std/int"
import * as Async from "std/async"

struct Pair {
  name: string
  value: int
}

async function step(name: string, value: int): int uses io, alloc {
  print(`start ${name}`)
  await Async.idle()
  print(`end ${name}`)
  return value
}

async function ready(): bool uses io, alloc {
  print("ready?")
  await Async.idle()
  return true
}

async function word(text: string): string {
  await Async.idle()
  return text
}

function add(left: int, right: int): int {
  return left + right
}

function loud(text: string, value: int): int uses io {
  print(text)
  return value
}

function check(text: string, value: bool): bool uses io {
  print(text)
  return value
}

export async function run(_args: Array<string>): int {
  print(Int.toString(add(await step("a", 1), await step("b", 2))))
  print(Int.toString(add(loud("first", 10), await step("c", 20))))
  if (await ready()) {
    print("ready")
  }
  print(Int.toString(await step("d", 3) + await step("e", 4)))
  print(Int.toString(loud("left", 5) * await step("f", 6)))
  if (check("false side", false) && await ready()) {
    print("never")
  }
  if (check("true side", true) && await ready()) {
    print("both")
  }
  print(`template ${await word("x")} and ${await word("y")}`)
  const pair = Pair { name: Int.toString(loud("name", 7)), value: await step("g", 8) }
  print(`${pair.name} ${Int.toString(pair.value)}`)
  const value = {
    const inner = await step("h", 9)
    return inner * 2
  }
  print(Int.toString(value))
  return 0
}
