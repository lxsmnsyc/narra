// error: cannot use == on Thread<int>
import * as Thread from "std/thread"

export function run(_args: Array<string>): int {
  return Thread.scope((scope) => {
    const first = Thread.start(scope, () => 1)
    const second = Thread.start(scope, () => 2)
    if (first == second || first != second) {
      return 1
    }
    const _byThread: Map<Thread.Thread<int>, int> = Map {}
    return 0
  })
}
