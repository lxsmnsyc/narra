// error: Function `pure` uses `io` (through `print`) but its signature does not declare it
function loud(value: int): int uses io {
  print("side effect")
  return value + 1
}

function twice<effect E>(callback: (value: int) => int uses E, value: int): int uses E {
  return callback(callback(value))
}

const apply = twice

export function pure(): int {
  return apply(loud, 1)
}

export function run(args: Array<string>): int uses io {
  return pure()
}
