// C functions from libc and libm through extern blocks, and CString.
import * as Ptr from "std/ptr"
import * as U64 from "std/u64"
import * as I32 from "std/i32"
import * as Float from "std/float"
import * as CStrings from "std/cstring"
import { CString } from "std/cstring"

// The string.h and stdlib.h prototypes have other C types (size_t, char*); the
// generated prototypes do not clash with them.
extern {
  function strlen(text: Ptr<u8>): u64
  function strchr(text: Ptr<u8>, character: i32): Ptr<u8>

  // A C name of its own.
  @extern("abs")
  function absolute(value: i32): i32
} from "c"

extern {
  function sqrt(value: f64): f64
  function pow(base: f64, exponent: f64): f64
} from "m"

@trusted
function measure(text: CString): u64 {
  let length: u64 = 0
  unsafe {
    length = strlen(CStrings.pointer(text))
  }
  return length
}

@trusted
function findTail(text: CString, character: i32): string uses alloc {
  // The pointer strchr returns points into the CString, which outlives the read.
  let tail = ""
  unsafe {
    const found = strchr(CStrings.pointer(text), character)
    if (!Ptr.isNull(found)) {
      if (CStrings.read(found) is Ok(copied)) {
        tail = copied
      }
    }
  }
  return tail
}

export function run(_args: Array<string>): int uses unsafe {
  if (CStrings.from("hello") is Some(text)) {
    print(U64.toString(measure(text)))
    print(CStrings.toString(text))
    print(findTail(text, 108))
    print(`[${findTail(text, 122)}]`)
  }
  if (CStrings.from("a\0b") is None) {
    print("a zero byte has no CString")
  }
  if (CStrings.from("") is Some(empty)) {
    print(U64.toString(measure(empty)))
  }
  unsafe {
    print(Float.toString(sqrt(2.0)))
    print(Float.toString(pow(2.0, 10.0)))
    print(I32.toString(absolute(-5)))
  }
  return 0
}
