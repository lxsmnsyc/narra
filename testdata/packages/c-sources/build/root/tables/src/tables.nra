// Functions over the C files listed in the [c] table of narra.toml.
import * as Build from "std/build"
import { Os } from "std/build"

// The block names a file that [c] sources lists as well; it compiles once.
extern {
  function tables_limit(): i32
  function tables_system(): i32
} from "../c/lib/api.c"

@trusted
export function readLimit(): i32 {
  unsafe {
    return tables_limit()
  }
}

@trusted
export function systemMatches(): bool {
  // The code the C file reports for the system of the build, from its [c.os.*] define.
  let want: i32 = 0
  if (Build.os == Os.MacOS) {
    want = 1
  }
  if (Build.os == Os.Linux) {
    want = 2
  }
  unsafe {
    return tables_system() == want
  }
}
