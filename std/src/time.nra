// std/time: a monotonic clock for measuring, the wall clock, and sleep. Reading a clock or sleeping is `io`.

import * as Clock from "std/internal/clock"

export struct Instant {
  nanos: int
}

export struct Duration {
  nanos: int
}

export function now(): Instant uses io {
  return Instant { nanos: Clock.monotonicNanos() }
}

export function elapsed(since: Instant): Duration uses io {
  return Duration { nanos: Clock.monotonicNanos() - since.nanos }
}

export function between(earlier: Instant, later: Instant): Duration {
  return Duration { nanos: later.nanos - earlier.nanos }
}

export function unixMillis(): int uses io {
  return Clock.wallMillis()
}

export function sleep(duration: Duration) uses io {
  Clock.sleepNanos(duration.nanos)
}

export function nanoseconds(count: int): Duration {
  return Duration { nanos: count }
}

export function milliseconds(count: int): Duration {
  return Duration { nanos: count * 1000000 }
}

export function seconds(count: int): Duration {
  return Duration { nanos: count * 1000000000 }
}

export function asNanoseconds(duration: Duration): int {
  return duration.nanos
}

export function asMilliseconds(duration: Duration): int {
  return duration.nanos / 1000000
}
