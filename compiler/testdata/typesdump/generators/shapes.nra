import * as Ranges from "std/range"
import * as Arrays from "std/array"

enum Shape {
  Circle(radius: int)
  Square(side: int)
}

struct Source {
  numbers: Generator<int> uses io
}

// yield inside if, while, labeled for and match statement arms.
function* sides(shapes: Array<Shape>): Generator<int> {
  for (const shape of shapes) {
    match (shape) {
      Shape.Circle(radius) => {
        yield radius
      }
      Shape.Square(side) => {
        let count = 0
        while (count < 4) {
          yield side
          count = count + 1
        }
      }
    }
  }
  outer: for (const i of Ranges.upTo(2)) {
    if (i == 1) {
      break outer
    }
    yield i
  }
}

function* noisy(): Generator<int> {
  print("noisy")
  yield 1
}

// A private generator that delegates to an io one gets io through it.
function* relay(): Generator<int> {
  yield* noisy()
  yield* sides([Shape.Circle(1)])
}

export function* pairs<T>(first: Generator<T> uses io, alloc, escaping pick: (value: T) => T): Generator<#[T, T]> uses io, alloc {
  for (const value of first) {
    yield #[value, pick(value)]
  }
}

export function total<effect E>(numbers: Generator<int> uses E): int uses E {
  let sum = 0
  for (const n of numbers) {
    sum = sum + n
  }
  return sum
}

// An effect variable passes on to another generic call.
export function twice<effect F>(numbers: Generator<int> uses F): int uses F {
  return total(numbers) * 2
}

function useSource(source: Source): int {
  return total(source.numbers)
}

export function run(args: Array<string>): int {
  const relayed: Generator<int> uses io, alloc = relay()
  const source = Source { numbers: noisy() }
  const keep = (value: int): int => value
  let count = 0
  for (const pair of pairs(relayed, keep)) {
    count = count + 1
  }
  return total(sides([Shape.Square(2)])) + twice(relay()) + useSource(source) + count + Arrays.length([1])
}
