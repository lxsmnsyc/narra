import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Boxes from "std/box"
import * as Ranges from "std/range"

function bad(): int {
  const frozen = [1, 2]
  let items = [1, 2]
  let table: Map<string, int> = Map {}
  Arrays.length(1)
  Arrays.length(items, items)
  Arrays.push(items, 3)
  Arrays.push(mutable frozen, 3)
  Arrays.push(mutable items, "x")
  Arrays.push(mutable items)
  Arrays.push(mutable 4, 5)
  Arrays.filled(1)
  Arrays.filled(1, "n")
  Maps.size(items)
  Maps.size(table, table)
  Maps.remove(table, "a")
  Maps.remove(mutable table, 1)
  Maps.remove(mutable items, 1)
  Maps.keys(items)
  Maps.entries(table, table)
  Boxes.new()
  Boxes.new(1, 2)
  Ranges.upTo("a")
  Ranges.upTo(1, 2)
  Ranges.between(1)
  Ranges.between(1, "b")
  Arrays.push(mutable items, Arrays.length(items))
  return 0
}
