import * as Int from "std/int"
import * as Float from "std/float"

struct Config {
  host: string
  port: int = 8080
  tags: Array<string> = []
}

struct Point {
  x: f64
  y: f64
}

struct Line {
  start: Point
  finish: Point
  name: string
}

struct Entry<K, V> {
  key: K
  value: V
}

enum Event {
  Click(at: Point)
  Key(code: int, name: string)
}

function where(p: Point): string {
  return match (p) {
    { x: 0.0, y: 0.0 } => "origin"
    { x: 0.0, y } => `on the y axis at ${Float.toString(y)}`
    { x, y } => `${Float.toString(x)}, ${Float.toString(y)}`
  }
}

function event(e: Event): string {
  return match (e) {
    Click({ x: 0.0, y: _ }) => "click on the y axis"
    Click({ x, y: py }) => `click at ${Float.toString(x)}, ${Float.toString(py)}`
    Key(13, _) => "enter"
    Key(_, name) => `key ${name}`
  }
}

function makeConfig(host: string): Config {
  return Config { host: host, tags: [host] }
}

function bump(e: Entry<string, int>): Entry<string, int> {
  return { ...e, value: e.value + 1 }
}

export function run(args: Array<string>): int {
  print(where(Point { x: 0.0, y: 0.0 }))
  print(where(Point { x: 0.0, y: 2.5 }))
  print(where(Point { x: 1.0, y: 2.0 }))
  print(event(Click(Point { x: 0.0, y: 1.0 })))
  print(event(Click(Point { x: 3.0, y: 1.0 })))
  print(event(Key(13, "enter")))
  print(event(Key(65, "a")))

  const config = makeConfig("localhost")
  const { host, port: serverPort } = config
  print(`${host}:${Int.toString(serverPort)}`)

  const moved = { ...config, port: 9000 }
  const renamed = Config { ...makeConfig("example.org"), host: "other" }
  print(`${moved.host}:${Int.toString(moved.port)} ${moved.tags[0]}`)
  print(`${renamed.host} ${renamed.tags[0]} ${Int.toString(renamed.port)}`)
  print(`${config.host}:${Int.toString(config.port)}`)

  let current = { ...config, tags: ["a", "b"] }
  current.tags[0] = "primary"
  current = { ...current, host: "changed" }
  print(`${current.host} ${current.tags[0]} ${current.tags[1]} ${config.tags[0]}`)

  const line = Line { start: Point { x: 1.0, y: 2.0 }, finish: Point { x: 3.0, y: 4.0 }, name: "diagonal" }
  const { start: { x: x1, y: y1 }, finish: { x: x2 }, name } = line
  print(`${name} ${Float.toString(x1)} ${Float.toString(y1)} ${Float.toString(x2)}`)

  const e = bump(Entry { key: "count", value: 1 })
  const { key, value } = bump(e)
  print(`${key} ${Int.toString(value)}`)

  match (line) {
    { name: "diagonal", start: { x: 1.0 } } => print("diagonal from x 1")
    _ => print("other line")
  }
  return 0
}
