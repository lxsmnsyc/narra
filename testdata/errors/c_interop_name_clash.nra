// error: the C name narra_alloc clashes with the runtime's narra_ names that the compiler writes; give the function another name with @extern
import * as Ptr from "std/ptr"
import * as CStrings from "std/cstring"

extern {
  @extern("narra_alloc")
  function allocate(size: u64): Ptr<u8>
  @extern("main")
  function startProgram(): i32
  @extern("L1")
  function firstLiteral(): int
  @extern("f_0123abcd_helper")
  function hashedHelper(): int
  @extern("E_Ordering")
  function orderingType(): int
  @extern("release_E_Option_e088c655")
  function releaseHelper(): i32
  @extern("not a name")
  function spaced(): int
} from "c"

export function run(_args: Array<string>): int uses unsafe {
  // Option<CString> is E_Option_e088c655, whose release helper is release_E_Option_e088c655.
  if (CStrings.from("abc") is Some(text)) {
    print(CStrings.toString(text))
  }
  unsafe {
    const _ = allocate(4)
    const _ = startProgram()
    const _ = firstLiteral()
    const _ = hashedHelper()
    const _ = orderingType()
    const _ = releaseHelper()
    const _ = spaced()
  }
  return 0
}
