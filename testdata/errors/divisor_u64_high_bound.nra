// error: divisor_u64_high_bound.nra:9:20: the divisor must be a non-zero constant or a name checked against zero first; check the name first, as in `if (d != 0) { ... }`
import * as U64 from "std/u64"

const HIGH_BIT: u64 = 9223372036854775807 + 2

function share(total: u64): u64 {
  const divisor: u64 = U64.wrap(0)
  if (divisor < HIGH_BIT) {
    return total / divisor
  }
  return 0
}

export function run(args: Array<string>): int {
  share(10)
  return 0
}
