// The credits a copy(...) gives the parts of a recursive enum end only when
// that copy ends. A short-lived reference to a nested payload does not end
// them, and the end of another copy takes back only its own credit. The copy
// check reports nothing here.
import * as Int from "std/int"

enum Tree {
  Leaf(cells: Array<int>)
  Node(left: Tree, right: Tree)
}

function findCells(tree: Tree): Array<int> from tree {
  return match (tree) { Tree.Node(Tree.Leaf(cells), _) => cells, _ => [] }
}

function findLeft(tree: Tree): Tree from tree {
  return match (tree) { Tree.Node(left, _) => left, _ => tree }
}

function readLeft(tree: Tree): int {
  const left = findLeft(tree)
  return match (left) { Tree.Leaf(cells) => cells[1], _ => 0 }
}

function readCopy(tree: Tree): int {
  const other = copy(tree)
  return match (other) { Tree.Leaf(cells) => cells[0], Tree.Node(_, _) => 0 }
}

export function run(args: Array<string>): int {
  // A nested payload held for a moment while the copy lives.
  const tree = Tree.Node(Tree.Leaf([1, 2]), Tree.Leaf([3]))
  const copied = copy(tree)
  print(`left ${Int.toString(readLeft(copied))}`)
  let cells = findCells(copied)
  cells[0] = 7
  print(`cells ${Int.toString(cells[0])}`)

  // A copy of the array itself outlives a copy of the enum that holds it.
  let row = [1, 2]
  const leaf = Tree.Leaf(row)
  let held = copy(row)
  print(`copy ${Int.toString(readCopy(leaf))}`)
  held[0] = 9
  print(`held ${Int.toString(held[0])}`)
  return 0
}
