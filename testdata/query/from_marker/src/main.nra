export struct Grid {
  rows: Array<Array<int>>
}

export function firstRow(grid: Grid): Array<int> from grid {
  return grid.rows[0]
}

export function applyPick(
  pick: (grid: Grid) => Array<int> from grid,
  grid: Grid,
): Array<int> from grid {
  return pick(grid)
}

export function run(_args: Array<string>): int {
  const grid = Grid { rows: [[1]] }
  const picked = applyPick(firstRow, grid)
  const pick = firstRow
  return picked[0] + pick(grid)[0]
}
