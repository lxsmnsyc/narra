import * as Int from "std/int"

struct Inner {
  v: int
}

struct Outer {
  inner: Inner
}

function repeat(count: int, action: (int) => void) {
  for (let index = 0; index < count; index++) {
    action(index)
  }
}

function raise(mutable inner: Inner) {
  inner.v = inner.v + 10
}

function writeInClosure(): int {
  let total = 0
  repeat(4, (index) => {
    total = total + index
  })
  return total
}

function writeThroughArgument(): int {
  let outer = Outer { inner: Inner { v: 1 } }
  raise(mutable outer.inner)
  return outer.inner.v
}

function writeDeepField(): int {
  let outer = Outer { inner: Inner { v: 1 } }
  outer.inner.v = 2
  return outer.inner.v
}

function writeInOneBranch(flag: bool): int {
  let value = 0
  if (flag) {
    value = 7
  }
  return value
}

export function run(args: Array<string>): int {
  print(Int.toString(writeInClosure()))
  print(Int.toString(writeThroughArgument()))
  print(Int.toString(writeDeepField()))
  print(Int.toString(writeInOneBranch(true)))
  print(Int.toString(writeInOneBranch(false)))
  return 0
}
