import * as Arrays from "std/array"

function grab(mutable items: Array<int>): int uses alloc {
  Arrays.push(mutable items, 9)
  return 1
}

export function run(args: Array<string>): int uses io, alloc {
  let items = [1, 2]
  items[0] += grab(mutable items)
  print(Show.show(items))
  return 0
}
