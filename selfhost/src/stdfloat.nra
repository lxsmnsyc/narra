// The registry rows and emitters of std/float.
import { StdFunc } from "narrac/builtins"
import { Pos, Arg } from "narrac/ast"
import { Type } from "narrac/types"
import { Emitter, Code, EmitWalker, reportUnsupported } from "narrac/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  emitOptionOut,
} from "narrac/stdemithelp"
import * as Arrays from "std/array"

export const FLOAT_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Float.fromInt",
    module: "std/float",
    key: "fromInt",
    parameters: ["int"],
    result: "f64",
  },
  StdFunc {
    name: "Float.sqrt",
    module: "std/float",
    key: "sqrt",
    parameters: ["f64"],
    result: "f64",
  },
  StdFunc {
    name: "Float.toString",
    module: "std/float",
    key: "toString",
    parameters: ["f64"],
    result: "string",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Float.truncate",
    module: "std/float",
    key: "truncate",
    parameters: ["f64"],
    result: "Option<int>",
  },
]

const FLOAT_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Float.toString",
    call: "lstr_from_f64",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall { name: "Float.sqrt", call: "sqrt", withPos: false, owned: false, temporary: false },
]

export function emitFloatCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(FLOAT_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Float.truncate") {
    return emitOptionOut(
      walker,
      mutable emitter,
      nodeId,
      arguments,
      "narra_float_truncate",
      Type.TInt,
      "0",
    )
  }
  if (name == "Float.fromInt") {
    const number = argumentText(walker, mutable emitter, arguments, 0)
    return plain(`((double)${number})`)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
