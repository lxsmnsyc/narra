import * as Int from "std/int"

enum Shape {
  Dot
  Line(length: int)
}

function size(shape: Shape): int {
  match (shape) {
    Shape.Dot => {
      return 0
    }
    Shape.Line(length) => {
      print(Int.toString(length))
    }
  }
}

export function run(args: Array<string>): int {
  return size(Shape.Dot)
}
