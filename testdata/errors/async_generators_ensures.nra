// error: this value is not proven to match `ensures >= 1`; write a constant, a constructor, or a name checked first with an `if`
async function* countUp(limit: int): AsyncGenerator<int>
  ensures >= 1
{
  let current = 0
  while (current < limit) {
    yield current
    current = current + 1
  }
  if (current >= 1) {
    yield current
  }
}

async function* delegated(limit: int): AsyncGenerator<int>
  ensures >= 1
{
  yield* countUp(limit)
}

export function main() {}
