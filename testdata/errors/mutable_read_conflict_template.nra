// error: mutable_read_conflict_template.nra:15:16: "x" is passed as mutable in one call, so the rest of the expression cannot use it
import * as Int from "std/int"

struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = 10
  return 0
}

export function run(args: Array<string>): int {
  const x = Counter { n: 1 }
  const text = `${Int.toString(x.n)} ${Int.toString(bump(mutable x))}`
  return 0
}
