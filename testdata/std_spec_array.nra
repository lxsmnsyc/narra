import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Float from "std/float"

function join(items: Array<int>): string uses alloc {
  let parts: Array<string> = []
  for (const item of items) {
    Arrays.push(mutable parts, Int.toString(item))
  }
  return Str.join(parts, ",")
}

export function run(args: Array<string>): int uses io, alloc {
  const prices = [1, 2, 3]
  const rate = 10
  print(`map ${join(Arrays.map(prices, (price) => price * rate))}`)
  print(`map words ${Str.join(Arrays.map(prices, (price) => Int.toString(price)), "+")}`)
  const none: Array<int> = []
  print(`map empty ${join(Arrays.map(none, (price) => price))}`)

  const items = [10, 20, 30, 40, 50]
  match (Arrays.slice(items, 1, 4)) {
    Some(part) => print(`slice ${join(part)}`)
    None => print("slice none")
  }
  match (Arrays.slice(items, 2, 2)) {
    Some(part) => print(`slice empty ${Int.toString(Arrays.length(part))}`)
    None => print("slice none")
  }
  print(`slice past end ${Show.show(Arrays.slice(items, 3, 9) is None)}`)
  print(`slice backwards ${Show.show(Arrays.slice(items, 4, 2) is None)}`)
  print(`slice negative ${Show.show(Arrays.slice(items, -1, 2) is None)}`)

  let reserved: Array<int> = Arrays.withCapacity(100)
  print(`reserved length ${Int.toString(Arrays.length(reserved))}`)
  Arrays.push(mutable reserved, 7)
  Arrays.push(mutable reserved, 8)
  print(`reserved ${join(reserved)}`)
  let negative: Array<int> = Arrays.withCapacity(-5)
  Arrays.push(mutable negative, 1)
  print(`negative capacity ${join(negative)}`)

  let huge: Array<int> = Arrays.withCapacity(4000000000000000000)
  Arrays.push(mutable huge, 3)
  print(`huge capacity ${join(huge)}`)

  print(`pi ${Float.toString(Float.PI)}`)
  const area = Float.PI * 2.0 * 2.0
  print(`area ${Float.toString(area)}`)
  print(`sqrt ${Float.toString(Float.sqrt(16.0))}`)
  return 0
}
