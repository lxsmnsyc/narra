enum Shape {
  Circle(radius: int, filled: bool)
  Square(side: int)
  Dot
}

function missingVariant(shape: Shape): int {
  return match (shape) {
    Shape.Circle(radius, _) => radius
    Shape.Dot => 0
  }
}

function missingNested(maybe: Option<Shape>): int {
  return match (maybe) {
    None => 0
    Some(Shape.Circle(radius, true)) => radius
  }
}

function missingInt(code: int): int {
  return match (code) {
    0 => 1
    1 => 2
  }
}

function missingBool(first: bool, second: bool): int {
  return match (#[first, second]) {
    #[true, true] => 1
  }
}

function guardOnly(shape: Shape): int {
  return match (shape) {
    Shape.Circle(radius, _) if (radius > 1) => radius
    Shape.Square(_) => 0
    Shape.Dot => 0
  }
}

function blockInValue(shape: Shape): int {
  return match (shape) {
    Shape.Dot => {
      return 1
    }
    _ => 0
  }
}

function armTypes(code: int): int {
  return match (code) {
    0 => 1
    _ => "no"
  }
}

function guardType(code: int): int {
  return match (code) {
    _ if (code) => 1
    _ => 2
  }
}
