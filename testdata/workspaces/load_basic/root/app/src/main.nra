import * as Own from "app/json/parse"
import * as Text from "app/text"
import * as JsonText from "json/text"
import * as Parse from "json/parse"

export function run(args: Array<string>): int uses io, alloc {
  print(Parse.parse())
  print(Own.label())
  print(Text.render())
  print(JsonText.render())
  return 0
}
