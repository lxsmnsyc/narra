import * as Ranges from "std/range"

trait Named {
  function name(value: Self): string
}

struct Cat implements Named {
  lives: int
}

implement Named for Cat {
  function name(value: Cat): string {
    return "cat"
  }
}

function identity<T>(value: T): T {
  return value
}

export function run(args: Array<string>): int {
  let total = identity(1)
  const word = identity("x")
  for (const k of Ranges.upTo(3)) {
    total = total + k
  }
  return total
}
