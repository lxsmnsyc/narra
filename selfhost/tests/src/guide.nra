// The guide suite: the fenced code of docs/guide/*.md. The format is in
// roadmaps/selfhost/contracts/guide-samples.md. A block with the info string
//   narra           is a program; the `text` block right after it holds its
//                   stdout. It runs in debug (sanitizers, leak check) and
//                   release mode.
//   narra error     must not compile; its first line is `// error: TEXT` and
//                   `narrac check` must report TEXT.
//   narra fragment  is not run.
//   narra file PACKAGE PATH
//                   is one file of a multi-file package. Blocks with the same
//                   PACKAGE in a chapter add up, and a later block with the
//                   same PATH replaces the earlier one. A file block that the
//                   `text` block follows builds the package so far and runs it
//                   like a program. A package without a narra.toml file block
//                   gets one whose entry is main.run.
// Any other info string that starts with `narra` in any case is a typo and
// fails. The `extractor` case checks the fence parser on a text with typos and
// on an unclosed fence.
import { splitString, substring } from "testrunner/textops"
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Path from "std/path"
import * as Ranges from "std/range"
import * as Str from "std/string"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"
import * as Files from "testrunner/files"
import * as Scratch from "testrunner/scratch"

// A fenced block of a chapter. line is the line of the opening fence and end
// the line of the closing one, both 1-based.
struct Fence {
  info: string
  line: int
  end: int
  body: string
}

// One file of a multi-file package sample, with its path inside the package.
struct PackageFile {
  package: string
  path: string
  code: string
}

// A narra block of a chapter. want is the stdout from the `text` block that
// directly follows a narra block; hasWant is false when there is none.
struct Sample {
  line: int
  kind: string
  info: string
  code: string
  want: string
  hasWant: bool
  package: string
  files: Array<PackageFile>
}

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  Arrays.push(mutable cases, TestCase {
    suite: "guide",
    name: "extractor",
    path: "",
    variant: "extractor",
  })
  const folder = Path.join(Path.join(context.repository, "docs"), "guide")
  for (const path of Arrays.values(Files.listPaths(folder, ".md"))) {
    const read = Fs.readText(path)
    const file = Path.basename(path)
    if (read is Err(message)) {
      Arrays.push(mutable cases, brokenCase(file, path, message))
      continue
    }
    const extracted = extractSamples(read.value)
    if (extracted is Err(message)) {
      Arrays.push(mutable cases, brokenCase(file, path, message))
      continue
    }
    for (const sample of Arrays.values(extracted.value)) {
      addSampleCases(mutable cases, file, path, sample)
    }
  }
  return cases
}

function brokenCase(file: string, path: string, reason: string): TestCase uses alloc {
  return TestCase { suite: "guide", name: file, path: path, variant: `broken ${reason}` }
}

function addSampleCases(
  mutable cases: Array<TestCase>,
  file: string,
  path: string,
  sample: Sample,
) uses alloc {
  const label = `${file}:${Int.toString(sample.line)}`
  if (sample.kind == "narra" || sample.kind == "narra file") {
    for (const mode of Arrays.values(["debug", "release"])) {
      Arrays.push(mutable cases, TestCase {
        suite: "guide",
        name: `${label}/${mode}`,
        path: path,
        variant: mode,
      })
    }
    return
  }
  Arrays.push(mutable cases, TestCase {
    suite: "guide",
    name: label,
    path: path,
    variant: sample.kind,
  })
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  if (testCase.variant == "extractor") {
    return checkExtractor()
  }
  if (Str.startsWith(testCase.variant, "broken ")) {
    return Err(Str.sliceFrom(testCase.variant, 7))
  }
  // The name is FILE:LINE or FILE:LINE/MODE.
  const colon = lastIndexOf(testCase.name, ":")
  let lineText = Str.sliceFrom(testCase.name, colon + 1)
  const slash = Str.indexOf(lineText, "/")
  if (slash is Some(position)) {
    lineText = substring(lineText, 0, position)
  }
  const line = Int.parse(lineText, 10)
  if (line is Err(_)) {
    return Err(`bad case name ${testCase.name}`)
  }
  const read = Fs.readText(testCase.path)
  if (read is Err(message)) {
    return Err(message)
  }
  const extracted = extractSamples(read.value)
  if (extracted is Err(message)) {
    return Err(message)
  }
  for (const sample of Arrays.values(extracted.value)) {
    if (sample.line == line.value) {
      return runSample(context, sample, testCase.variant)
    }
  }
  return Err(`no sample at line ${lineText}`)
}

function lastIndexOf(text: string, piece: string): int uses alloc {
  let found = -1
  for (let position = 0; position + Str.length(piece) <= Str.length(text); position++) {
    if (substring(text, position, position + Str.length(piece)) == piece) {
      found = position
    }
  }
  return found
}

function runSample(
  context: Context,
  sample: Sample,
  variant: string,
): Result<bool, string> uses io, alloc {
  if (sample.kind == "invalid") {
    return Err(
      `the info string "${sample.info}" is not narra, narra error, narra fragment or narra file`,
    )
  }
  if (sample.kind == "narra fragment") {
    return Ok(true)
  }
  if (sample.kind == "dangling") {
    return Err(
      `the files of package ${sample.package} need a text block with the output right after the last one`,
    )
  }
  const made = Scratch.makeScratch()
  if (made is Err(message)) {
    return Err(message)
  }
  const scratch = made.value
  if (sample.kind == "narra file") {
    const packageOutcome = runPackageSample(context, sample, scratch.work, variant)
    Scratch.removeScratch(scratch)
    return packageOutcome
  }
  const path = Path.join(scratch.work, "sample.nra")
  let outcome: Result<bool, string> = Ok(true)
  const written = Scratch.writeFile(path, sample.code)
  if (written is Err(message)) {
    outcome = Err(message)
  } else if (sample.kind == "narra error") {
    outcome = runErrorSample(context, sample, path)
  } else {
    outcome = runProgramSample(context, sample, path, variant)
  }
  Scratch.removeScratch(scratch)
  return outcome
}

function runPackageSample(
  context: Context,
  sample: Sample,
  work: string,
  variant: string,
): Result<bool, string> uses io, alloc {
  const folder = Path.join(work, sample.package)
  let hasManifest = false
  // Step 1: write every file of the package under its own folder.
  for (const file of Arrays.values(sample.files)) {
    if (file.path == "narra.toml") {
      hasManifest = true
    }
    const written = Scratch.writeFile(Path.join(folder, file.path), file.code)
    if (written is Err(message)) {
      return Err(message)
    }
  }
  // Step 2: a package without a manifest block starts at main.run.
  if (!hasManifest) {
    const manifest = `[package]\nname = "${sample.package}"\n\n[[binary]]\nname = "${sample.package}"\nentry = "main.run"\n`
    const written = Scratch.writeFile(Path.join(folder, "narra.toml"), manifest)
    if (written is Err(message)) {
      return Err(message)
    }
  }
  // Step 3: build and run the package folder in the sample's mode.
  let flag = "-sanitize"
  if (variant == "release") {
    flag = "-release"
  }
  const result = Common.runNarrac(context, ["run", flag, folder])
  return Common.expectRun(result, 0, sample.want)
}

function runErrorSample(
  context: Context,
  sample: Sample,
  path: string,
): Result<bool, string> uses io, alloc {
  const first = splitString(sample.code, "\n")[0]
  if (!Str.startsWith(first, "// error:")) {
    return Err("an error sample starts with a `// error:` comment")
  }
  const want = Str.trim(Str.sliceFrom(first, 9))
  const result = Common.runNarrac(context, ["check", path])
  if (result.code == 0) {
    return Err(`expected an error containing "${want}"`)
  }
  const message = Str.replace(result.errorOutput, "sample.nra:", "")
  if (!Str.contains(message, want)) {
    return Err(`want error containing "${want}", got:\n${result.errorOutput}`)
  }
  return Ok(true)
}

function runProgramSample(
  context: Context,
  sample: Sample,
  path: string,
  variant: string,
): Result<bool, string> uses io, alloc {
  if (!sample.hasWant) {
    return Err("a `narra` block needs a `text` block with its output right after it")
  }
  let flag = "-sanitize"
  if (variant == "release") {
    flag = "-release"
  }
  const result = Common.runNarrac(context, ["run", flag, path])
  return Common.expectRun(result, 0, sample.want)
}

function readFences(text: string): Result<Array<Fence>, string> uses alloc {
  let fences: Array<Fence> = []
  const lines = splitString(text, "\n")
  let index = 0
  while (index < Arrays.length(lines)) {
    if (!Str.startsWith(lines[index], "```")) {
      index++
      continue
    }
    const start = index
    const info = Str.trim(trimBackticks(lines[index]))
    let body: Array<string> = []
    index++
    while (index < Arrays.length(lines) && !Str.startsWith(lines[index], "```")) {
      Arrays.push(mutable body, lines[index])
      index++
    }
    if (index >= Arrays.length(lines)) {
      return Err(`line ${Int.toString(start + 1)}: the fence is never closed`)
    }
    Arrays.push(mutable fences, Fence {
      info: info,
      line: start + 1,
      end: index + 1,
      body: `${Str.join(body, "\n")}\n`,
    })
    index++
  }
  return Ok(fences)
}

function trimBackticks(line: string): string uses alloc {
  let start = 0
  while (start < Str.length(line) && Str.byteAt(line, start) == 96) {
    start++
  }
  return Str.sliceFrom(line, start)
}

function startsWithNarra(text: string): bool uses alloc {
  const word = "narra"
  if (Str.length(text) < Str.length(word)) {
    return false
  }
  for (const position of Ranges.between(0, Str.length(word))) {
    // Setting bit 5 turns an ASCII capital into its small letter.
    const lowered = Str.byteAt(text, position) | 32
    if (lowered != Str.byteAt(word, position)) {
      return false
    }
  }
  return true
}

function extractSamples(text: string): Result<Array<Sample>, string> uses alloc {
  const read = readFences(text)
  if (read is Err(message)) {
    return Err(message)
  }
  const fences = read.value
  const lines = splitString(text, "\n")
  let samples: Array<Sample> = []
  // The files of the packages seen so far, with the package of each, and the
  // packages that have files since their last run point.
  let accumulated: Array<PackageFile> = []
  let pending: Array<Sample> = []
  for (const index of Ranges.between(0, Arrays.length(fences))) {
    const fence = fences[index]
    let kind = fence.info
    const parts = splitString(fence.info, " ")
    let package = ""
    let filePath = ""
    if (Arrays.length(parts) == 4 && parts[0] == "narra" && parts[1] == "file") {
      kind = "narra file"
      package = parts[2]
      filePath = parts[3]
    } else if (kind != "narra" && kind != "narra error" && kind != "narra fragment") {
      if (!startsWithNarra(kind)) {
        continue
      }
      // A typo in the kind fails the chapter instead of going untested.
      kind = "invalid"
    }
    let want = ""
    let hasWant = false
    if (
      (fence.info == "narra" || kind == "narra file") &&
        index + 1 < Arrays.length(fences) &&
        fences[index + 1].info == "text"
    ) {
      // Only blank lines may sit between the two blocks.
      const next = fences[index + 1]
      let between = ""
      for (const position of Ranges.between(fence.end, next.line - 1)) {
        between = `${between}${lines[position]}`
      }
      if (Str.trim(between) == "") {
        want = next.body
        hasWant = true
      }
    }
    let files: Array<PackageFile> = []
    if (kind == "narra file") {
      // The file replaces an earlier block of the same package and path.
      let replaced = false
      for (const position of Ranges.between(0, Arrays.length(accumulated))) {
        if (accumulated[position].package == package && accumulated[position].path == filePath) {
          accumulated[position] = PackageFile { package: package, path: filePath, code: fence.body }
          replaced = true
        }
      }
      if (!replaced) {
        Arrays.push(mutable accumulated, PackageFile {
          package: package,
          path: filePath,
          code: fence.body,
        })
      }
      for (const position of Ranges.between(0, Arrays.length(accumulated))) {
        if (accumulated[position].package == package) {
          Arrays.push(mutable files, accumulated[position])
        }
      }
      // A file block without output is not a sample until the package is run.
      let kept: Array<Sample> = []
      for (const waiting of Arrays.values(pending)) {
        if (waiting.package != package) {
          Arrays.push(mutable kept, waiting)
        }
      }
      pending = kept
      if (!hasWant) {
        Arrays.push(mutable pending, Sample {
          line: fence.line,
          kind: "dangling",
          info: fence.info,
          code: "",
          want: "",
          hasWant: false,
          package: package,
          files: [],
        })
        continue
      }
    }
    Arrays.push(mutable samples, Sample {
      line: fence.line,
      kind: kind,
      info: fence.info,
      code: fence.body,
      want: want,
      hasWant: hasWant,
      package: package,
      files: files,
    })
  }
  for (const waiting of Arrays.values(pending)) {
    Arrays.push(mutable samples, waiting)
  }
  return Ok(samples)
}

function checkExtractor(): Result<bool, string> uses alloc {
  const bad = "```narra errror\nx\n```\n\n```Narra\nx\n```\n\n```narra,\nx\n```\n\n```sh\nx\n```\n"
  const extracted = extractSamples(bad)
  if (extracted is Err(message)) {
    return Err(message)
  }
  if (Arrays.length(extracted.value) != 3) {
    return Err(`want 3 samples, got ${Int.toString(Arrays.length(extracted.value))}`)
  }
  for (const sample of Arrays.values(extracted.value)) {
    if (sample.kind != "invalid") {
      return Err(`line ${Int.toString(sample.line)}: want kind invalid, got ${sample.kind}`)
    }
  }
  const open = extractSamples("text\n\n```narra\nx\n")
  if (open is Ok(_)) {
    return Err("want an unclosed fence error")
  }
  if (!Str.contains(open.error, "line 3")) {
    return Err(`want an unclosed fence error for line 3, got ${open.error}`)
  }
  return checkPackageExtractor()
}

function checkPackageExtractor(): Result<bool, string> uses alloc {
  const first = "```narra file one x.nra\nA\n```\n\n```text\na\n```\n\n"
  const second = "```narra file two x.nra\nB\n```\n\n```text\nb\n```\n\n"
  const third = "```narra file one x.nra\nC\n```\n\n```text\nc\n```\n\n"
  const last = "```narra file one y.nra\nD\n```\n\n```narra file x\nE\n```\n"
  const text = `${first}${second}${third}${last}`
  const extracted = extractSamples(text)
  if (extracted is Err(message)) {
    return Err(message)
  }
  const samples = extracted.value
  if (Arrays.length(samples) != 5) {
    return Err(`want 5 package samples, got ${Int.toString(Arrays.length(samples))}`)
  }
  const wantKinds = ["narra file", "narra file", "narra file", "invalid", "dangling"]
  for (const index of Ranges.between(0, 5)) {
    if (samples[index].kind != wantKinds[index]) {
      return Err(
        `package sample ${Int.toString(index)}: want kind ${wantKinds[index]}, got ${samples[index].kind}`,
      )
    }
  }
  // Each run point holds one file: packages stay apart and a replaced path
  // changes only the later run points.
  const wantPackages = ["one", "two", "one"]
  const wantCodes = ["A\n", "B\n", "C\n"]
  for (const index of Ranges.between(0, 3)) {
    const files = samples[index].files
    if (
      Arrays.length(files) != 1 ||
        files[0].package != wantPackages[index] ||
        files[0].code != wantCodes[index]
    ) {
      return Err(`package sample ${Int.toString(index)}: wrong files`)
    }
  }
  return Ok(true)
}
