// error: "player" is a copy of an element of game.players, so changing it would not change game.players; write through the source, `game.players[index].hp`
import * as Arrays from "std/array"

struct Player {
  hp: int
}

struct Game {
  players: Array<Player>
}

export function run(args: Array<string>): int {
  const game = Game { players: [Player { hp: 3 }] }
  for (const #[index, player] of Arrays.entries(game.players)) {
    player.hp = index
  }
  return 0
}
