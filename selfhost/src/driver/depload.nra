// The dependencies of one build. A build resolves the manifests, checks the result against
// narra.lock, writes the lock when it changed, and returns the folder of each dependency's
// checkout. The language service takes the lock as it is and never fetches. Every step that
// needs git runs in depresolve.nra and depcache.nra. A package selected on one compatibility line
// keeps its name; each line of a package selected on several is a package of its own, named
// `name@line`, and the imports of each package are renamed to the line it requires.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Ranges from "std/range"
import * as Str from "std/string"
import { hasName, substring } from "narrac/driver/textops"
import { ImportDecl } from "narrac/syntax/ast"
import { checkTree, checkoutPath, isVersionBefore, readRecorded } from "narrac/driver/depcache"
import {
  checkAgainstLock,
  findCheckoutPackage,
  findLineKey,
  resolveDependencies,
} from "narrac/driver/depresolve"
import { LockEntry, formatLock, parseLock } from "narrac/driver/lockfile"
import {
  CTable,
  Dependency,
  ExportEntry,
  LoadError,
  Manifest,
  findCompatibilityLine,
  findUpstream,
} from "narrac/driver/manifest"
import {
  Member,
  Workspace,
  findWorkspace,
  listMembers,
  readManifestAt,
} from "narrac/driver/workspace"

export struct DependencyPackage {
  name: string // the package name, or `name@line` when the build has several lines of it
  version: string
  directory: string // the checkout of the version
  git: string // the URL it was fetched from; empty for a member of the workspace
  declared: Array<string> // its [dependencies], each by the name it has in this build
  exports: Array<ExportEntry> // its [exports] table; empty when every module is exposed
  cTables: Array<CTable> // its [c] and [c.os.*] tables
  upstream: string = "" // the checkout of its `[c] git` and `tag`; empty when the C files are in the package
}

export struct PreparedDependencies {
  packages: Array<DependencyPackage>
  declared: Array<string> // the [dependencies] of the package being built, by their names in the build
}

function createDependencyError(code: string, message: string): LoadError {
  return LoadError { code, file: "", line: 0, column: 1, message }
}

function buildLineNames(entries: Array<LockEntry>): Map<string, string> uses alloc {
  // The key is `name@line`; the value is the name the line has in this build.
  let counts: Map<string, int> = Map {}
  for (const entry of Arrays.values(entries)) {
    if (counts[entry.name] is Some(count)) {
      counts[entry.name] = count + 1
    } else {
      counts[entry.name] = 1
    }
  }
  let names: Map<string, string> = Map {}
  for (const entry of Arrays.values(entries)) {
    const key = findLineKey(entry.name, entry.version)
    names[key] = entry.name
    if (counts[entry.name] is Some(count)) {
      if (count > 1) {
        names[key] = key
      }
    }
  }
  return names
}

function findBuildName(
  lineNames: Map<string, string>,
  name: string,
  version: string,
): string uses alloc {
  // An override leaves one line, so a requirement on any other line keeps the plain name.
  if (lineNames[findLineKey(name, version)] is Some(buildName)) {
    return buildName
  }
  return name
}

function listDeclaredNames(
  lineNames: Map<string, string>,
  manifest: Manifest,
): Array<string> uses alloc {
  let declared: Array<string> = []
  for (const dependency of Arrays.values(manifest.dependencies)) {
    if (dependency.workspace) {
      Arrays.push(mutable declared, dependency.name)
    } else {
      Arrays.push(mutable declared, findBuildName(lineNames, dependency.name, dependency.version))
    }
  }
  return declared
}

export function findPackageName(buildName: string): string uses alloc {
  if (Str.indexOf(buildName, "@") is Some(position)) {
    return substring(buildName, 0, position)
  }
  return buildName
}

export function renameLineImports(
  imports: Array<ImportDecl>,
  ownName: string,
  declared: Array<string>,
): Array<ImportDecl> from imports uses alloc {
  // An import of `http/...` goes to the line of http that this package requires, and a package on
  // one of several lines imports its own modules on its line.
  let renamed: Array<ImportDecl> = []
  for (const importDecl of Arrays.values(imports)) {
    let segment = importDecl.path
    let rest = ""
    if (Str.indexOf(importDecl.path, "/") is Some(position)) {
      segment = substring(importDecl.path, 0, position)
      rest = Str.sliceFrom(importDecl.path, position)
    }
    let path = importDecl.path
    if (ownName != segment && findPackageName(ownName) == segment) {
      path = `${ownName}${rest}`
    }
    for (const buildName of Arrays.values(declared)) {
      if (buildName != segment && findPackageName(buildName) == segment) {
        path = `${buildName}${rest}`
      }
    }
    Arrays.push(mutable renamed, ImportDecl { ...importDecl, path })
  }
  return renamed
}

function readLock(lockPath: string): Result<Array<LockEntry>, LoadError> uses io, alloc {
  if (!Fs.exists(lockPath)) {
    return Ok([])
  }
  const text = Fs.readText(lockPath)
  if (text is Err(message)) {
    return Err(createDependencyError("E0458", `cannot read or write ${lockPath}: ${message}`))
  }
  return parseLock(text.value)
}

function findUpstreamFolder(
  entry: LockEntry,
  manifest: Manifest,
): Result<string, LoadError> uses io, alloc {
  // The checkout of the C source of a package, taken from the cache the lock names.
  const upstream = findUpstream(manifest.cTables)
  if (upstream.git == "") {
    return Ok("")
  }
  if (entry.cGit != upstream.git || entry.cTag != upstream.tag) {
    return Err(
      createDependencyError(
        "E0461",
        `narra.lock has no entry for the C source of ${entry.name} ${entry.version} (tag ${upstream.tag} of ${upstream.git}); run narrac build to update it`,
      ),
    )
  }
  const folder = checkoutPath(upstream.git, upstream.tag)
  if (!Fs.isDir(folder)) {
    return Err(
      createDependencyError(
        "E0460",
        `the C source of ${entry.name} ${entry.version} (tag ${upstream.tag} of ${upstream.git}) is not in the cache; run narrac build to fetch it`,
      ),
    )
  }
  const recorded = readRecorded(folder)
  if (recorded is Err(error)) {
    return Err(error)
  }
  const matched = checkTree(recorded.value, entry.cContent)
  if (matched is Err(error)) {
    return Err(error)
  }
  return Ok(folder)
}

function listPackages(
  entries: Array<LockEntry>,
): Result<Array<DependencyPackage>, LoadError> uses io, alloc {
  const lineNames = buildLineNames(entries)
  let packages: Array<DependencyPackage> = []
  for (const entry of Arrays.values(entries)) {
    const folder = checkoutPath(entry.git, entry.tag)
    if (!Fs.isDir(folder)) {
      return Err(
        createDependencyError(
          "E0460",
          `${entry.name} ${entry.version} is not in the cache; run narrac build to fetch it`,
        ),
      )
    }
    // The package is the checkout itself, or a member of the workspace the checkout holds.
    const found = findCheckoutPackage(folder, entry.name, entry.version)
    if (found is Err(error)) {
      return Err(error)
    }
    const manifest = found.value.manifest
    let declared: Array<string> = []
    const recorded = readRecorded(folder)
    if (recorded is Err(error)) {
      return Err(error)
    }
    const matched = checkTree(recorded.value, entry.content)
    if (matched is Err(error)) {
      return Err(error)
    }
    for (const dependency of Arrays.values(manifest.dependencies)) {
      if (!dependency.workspace) {
        Arrays.push(mutable declared, findBuildName(lineNames, dependency.name, dependency.version))
        continue
      }
      // A sibling in the fetched workspace is required at the version its manifest has here.
      let siblingVersion = ""
      for (const member of Arrays.values(found.value.members)) {
        if (member.name == dependency.name) {
          const sibling = readManifestAt(member.directory)
          if (sibling is Ok(siblingManifest)) {
            siblingVersion = siblingManifest.version
          }
        }
      }
      Arrays.push(mutable declared, findBuildName(lineNames, dependency.name, siblingVersion))
    }
    const upstream = findUpstreamFolder(entry, manifest)
    if (upstream is Err(error)) {
      return Err(error)
    }
    Arrays.push(mutable packages, DependencyPackage {
      name: findBuildName(lineNames, entry.name, entry.version),
      version: entry.version,
      git: entry.git,
      directory: found.value.directory,
      declared,
      exports: manifest.exports,
      cTables: manifest.cTables,
      upstream: upstream.value,
    })
  }
  return Ok(packages)
}

function checkLockCovers(
  manifest: Manifest,
  overrides: Array<Dependency>,
  locked: Array<LockEntry>,
): Result<bool, LoadError> uses alloc {
  for (const dependency of Arrays.values(manifest.dependencies)) {
    let wanted = copy(dependency)
    for (const override of Arrays.values(overrides)) {
      if (override.name == dependency.name) {
        wanted = copy(override)
      }
    }
    let covered = false
    for (const entry of Arrays.values(locked)) {
      if (
        entry.name == wanted.name &&
          entry.git == wanted.git &&
          findCompatibilityLine(entry.version) == findCompatibilityLine(wanted.version) &&
          !isVersionBefore(entry.version, wanted.version)
      ) {
        covered = true
      }
    }
    if (!covered) {
      return Err(
        createDependencyError(
          "E0461",
          `narra.lock has no entry for ${wanted.name} ${wanted.version} from ${wanted.git}; run narrac build to update it`,
        ),
      )
    }
  }
  return Ok(true)
}

function checkPackagesLocked(
  packages: Array<DependencyPackage>,
): Result<bool, LoadError> uses alloc {
  let names: Array<string> = []
  for (const dependencyPackage of Arrays.values(packages)) {
    Arrays.push(mutable names, dependencyPackage.name)
  }
  for (const dependencyPackage of Arrays.values(packages)) {
    for (const declaredName of Arrays.values(dependencyPackage.declared)) {
      if (!hasName(names, declaredName)) {
        return Err(
          createDependencyError(
            "E0461",
            `narra.lock has no entry for ${declaredName}, which ${dependencyPackage.name} needs; run narrac build to update it`,
          ),
        )
      }
    }
  }
  return Ok(true)
}

struct GitPackages {
  packages: Array<DependencyPackage>
  lineNames: Map<string, string> // from buildLineNames
}

function prepareGitPackages(
  lockPath: string,
  roots: Array<Manifest>,
  overrides: Array<Dependency>,
  fetch: bool,
): Result<GitPackages, LoadError> uses io, alloc {
  let hasRequirements = Arrays.length(overrides) > 0
  for (const root of Arrays.values(roots)) {
    if (Arrays.length(root.dependencies) > 0) {
      hasRequirements = true
    }
  }
  if (!hasRequirements) {
    if (!fetch || !Fs.exists(lockPath)) {
      return Ok(GitPackages { packages: [], lineNames: Map {} })
    }
    // A lock that lists packages the manifests no longer name is emptied.
    const stale = readLock(lockPath)
    if (stale is Err(error)) {
      return Err(error)
    }
    if (Arrays.length(stale.value) > 0) {
      const emptied = writeLockIfChanged(lockPath, formatLock([]))
      if (emptied is Err(error)) {
        return Err(error)
      }
    }
    return Ok(GitPackages { packages: [], lineNames: Map {} })
  }
  const locked = readLock(lockPath)
  if (locked is Err(error)) {
    return Err(error)
  }
  if (!fetch) {
    // The language service reads the lock and the cache as they are.
    for (const root of Arrays.values(roots)) {
      const covered = checkLockCovers(root, overrides, locked.value)
      if (covered is Err(error)) {
        return Err(error)
      }
    }
    const listed = listPackages(locked.value)
    if (listed is Err(error)) {
      return Err(error)
    }
    const complete = checkPackagesLocked(listed.value)
    if (complete is Err(error)) {
      return Err(error)
    }
    return Ok(GitPackages { packages: listed.value, lineNames: buildLineNames(locked.value) })
  }
  const resolved = resolveDependencies(roots, overrides, locked.value)
  if (resolved is Err(error)) {
    return Err(error)
  }
  const checked = checkAgainstLock(resolved.value, locked.value)
  if (checked is Err(error)) {
    return Err(error)
  }
  // The lock is written only when its text changes, so a second build writes nothing.
  const text = formatLock(resolved.value)
  const written = writeLockIfChanged(lockPath, text)
  if (written is Err(error)) {
    return Err(error)
  }
  const listed = listPackages(resolved.value)
  if (listed is Err(error)) {
    return Err(error)
  }
  return Ok(GitPackages { packages: listed.value, lineNames: buildLineNames(resolved.value) })
}

function findMemberIndex(members: Array<Member>, name: string): int {
  for (const index of Ranges.between(0, Arrays.length(members))) {
    if (members[index].name == name) {
      return index
    }
  }
  return -1
}

function keepGitDependencies(
  manifest: Manifest,
  overrides: Array<Dependency>,
): Manifest from manifest uses alloc {
  let kept: Array<Dependency> = []
  for (const dependency of Arrays.values(manifest.dependencies)) {
    if (!dependency.workspace) {
      Arrays.push(mutable kept, copy(dependency))
    }
  }
  return Manifest { ...manifest, dependencies: kept, overrides: copy(overrides) }
}

function checkMembers(
  workspace: Workspace,
  members: Array<Member>,
  manifests: Array<Manifest>,
): Result<bool, LoadError> uses io, alloc {
  for (const index of Ranges.between(0, Arrays.length(members))) {
    const member = members[index]
    const manifest = manifests[index]
    const isRoot = member.directory == workspace.root
    if (!isRoot && Fs.exists(`${member.directory}/narra.lock`)) {
      return Err(
        createDependencyError(
          "E0485",
          `${member.directory}/narra.lock is inside the member ${member.name}; the workspace keeps one lock at ${workspace.root}/narra.lock`,
        ),
      )
    }
    if (!isRoot && Arrays.length(manifest.overrides) > 0) {
      return Err(
        createDependencyError(
          "E0454",
          `[overrides] is allowed in the root manifest of a build only, not in the member ${member.name}`,
        ),
      )
    }
    for (const dependency of Arrays.values(manifest.dependencies)) {
      const found = findMemberIndex(members, dependency.name)
      if (dependency.workspace && found < 0) {
        return Err(
          createDependencyError(
            "E0484",
            `${member.name} depends on ${dependency.name} with workspace = true, but the workspace has no member named ${dependency.name}`,
          ),
        )
      }
      if (!dependency.workspace && found >= 0) {
        return Err(
          createDependencyError(
            "E0450",
            `package ${dependency.name} is a member of the workspace and is also required from ${dependency.git}`,
          ),
        )
      }
    }
  }
  return Ok(true)
}

function pickReachablePackages(
  gitPackages: Array<DependencyPackage>,
  startNames: Array<string>,
): Array<DependencyPackage> uses alloc {
  let queue: Array<string> = []
  for (const name of Arrays.values(startNames)) {
    if (!hasName(queue, name)) {
      Arrays.push(mutable queue, name)
    }
  }
  let picked: Array<DependencyPackage> = []
  let position = 0
  while (position < Arrays.length(queue)) {
    const name = queue[position]
    position++
    for (const gitPackage of Arrays.values(gitPackages)) {
      if (gitPackage.name != name) {
        continue
      }
      Arrays.push(mutable picked, copy(gitPackage))
      for (const declaredName of Arrays.values(gitPackage.declared)) {
        if (!hasName(queue, declaredName)) {
          Arrays.push(mutable queue, declaredName)
        }
      }
    }
  }
  return picked
}

function prepareWorkspaceDependencies(
  workspace: Workspace,
  manifest: Manifest,
  fetch: bool,
): Result<PreparedDependencies, LoadError> uses io, alloc {
  const listed = listMembers(workspace)
  if (listed is Err(errors)) {
    return Err(errors[0])
  }
  const members = listed.value
  let manifests: Array<Manifest> = []
  for (const member of Arrays.values(members)) {
    const read = readManifestAt(member.directory)
    if (read is Err(error)) {
      return Err(error)
    }
    Arrays.push(mutable manifests, read.value)
  }
  const checkedMembers = checkMembers(workspace, members, manifests)
  if (checkedMembers is Err(error)) {
    return Err(error)
  }
  // The versions come from every member, so a member built alone selects what the root build does.
  const overrides = workspace.manifest.overrides
  let roots: Array<Manifest> = []
  for (const memberManifest of Arrays.values(manifests)) {
    Arrays.push(mutable roots, keepGitDependencies(memberManifest, overrides))
  }
  const gitPackages = prepareGitPackages(`${workspace.root}/narra.lock`, roots, overrides, fetch)
  if (gitPackages is Err(error)) {
    return Err(error)
  }
  // A package deeper in the git graph, or an override, may also take a member's name.
  const lineNames = gitPackages.value.lineNames
  for (const gitPackage of Arrays.values(gitPackages.value.packages)) {
    if (findMemberIndex(members, findPackageName(gitPackage.name)) >= 0) {
      return Err(
        createDependencyError(
          "E0450",
          `package ${gitPackage.name} is a member of the workspace and is also required from ${gitPackage.git}`,
        ),
      )
    }
  }
  // The members the built package depends on, directly or not.
  let startNames: Array<string> = []
  let reachable: Array<string> = []
  let pending: Array<Manifest> = [copy(manifest)]
  let position = 0
  while (position < Arrays.length(pending)) {
    const current = copy(pending[position])
    position++
    for (const dependency of Arrays.values(current.dependencies)) {
      if (!dependency.workspace) {
        Arrays.push(
          mutable startNames,
          findBuildName(lineNames, dependency.name, dependency.version),
        )
        continue
      }
      const found = findMemberIndex(members, dependency.name)
      if (found < 0 || dependency.name == manifest.name || hasName(reachable, dependency.name)) {
        continue
      }
      Arrays.push(mutable reachable, dependency.name)
      Arrays.push(mutable pending, copy(manifests[found]))
    }
  }
  let packages: Array<DependencyPackage> = []
  for (const name of Arrays.values(reachable)) {
    const found = findMemberIndex(members, name)
    const declared = listDeclaredNames(lineNames, manifests[found])
    Arrays.push(mutable packages, DependencyPackage {
      name,
      version: manifests[found].version,
      git: "",
      directory: members[found].directory,
      declared,
      exports: copy(manifests[found].exports),
      cTables: copy(manifests[found].cTables),
    })
  }
  for (const gitPackage of Arrays.values(
    pickReachablePackages(gitPackages.value.packages, startNames),
  )) {
    Arrays.push(mutable packages, copy(gitPackage))
  }
  return Ok(PreparedDependencies { packages, declared: listDeclaredNames(lineNames, manifest) })
}

export function prepareDependencies(
  directory: string,
  manifest: Manifest,
  fetch: bool,
): Result<PreparedDependencies, LoadError> uses io, alloc {
  const found = findWorkspace(directory)
  if (found is Some(workspace)) {
    return prepareWorkspaceDependencies(workspace, manifest, fetch)
  }
  for (const dependency of Arrays.values(manifest.dependencies)) {
    if (dependency.workspace) {
      return Err(
        createDependencyError(
          "E0484",
          `${manifest.name} depends on ${dependency.name} with workspace = true, but it is not a member of a workspace`,
        ),
      )
    }
  }
  const gitPackages = prepareGitPackages(
    `${directory}/narra.lock`,
    [manifest],
    manifest.overrides,
    fetch,
  )
  if (gitPackages is Err(error)) {
    return Err(error)
  }
  return Ok(PreparedDependencies {
    packages: copy(gitPackages.value.packages),
    declared: listDeclaredNames(gitPackages.value.lineNames, manifest),
  })
}

function writeLockIfChanged(
  lockPath: string,
  text: string,
): Result<bool, LoadError> uses io, alloc {
  if (Fs.exists(lockPath)) {
    const old = Fs.readText(lockPath)
    if (old is Ok(oldText)) {
      if (oldText == text) {
        return Ok(true)
      }
    }
  }
  const written = Fs.writeText(lockPath, text)
  if (written is Err(message)) {
    return Err(createDependencyError("E0458", `cannot read or write ${lockPath}: ${message}`))
  }
  return Ok(true)
}

export function findUndeclaredImports(
  file: string,
  imports: Array<ImportDecl>,
  ownName: string,
  declared: Array<string>,
  loadedNames: Array<string>,
): Array<LoadError> uses alloc {
  let errors: Array<LoadError> = []
  for (const importDecl of Arrays.values(imports)) {
    // Only the package itself, std and the packages its manifest lists may be imported.
    const slash = Str.indexOf(importDecl.path, "/")
    if (slash is None) {
      continue
    }
    const segment = substring(importDecl.path, 0, slash.value)
    if (segment == ownName || !hasName(loadedNames, segment) || hasName(declared, segment)) {
      continue
    }
    Arrays.push(mutable errors, LoadError {
      code: "E0463",
      file,
      line: importDecl.pos.line,
      column: importDecl.pos.column,
      message: `package ${ownName} imports ${segment}, but its narra.toml has no [dependencies] entry for it`,
    })
  }
  return errors
}

export function isDependencyPath(dependencyNames: Array<string>, path: string): bool uses alloc {
  const slash = Str.indexOf(path, "/")
  if (slash is None) {
    return false
  }
  return hasName(dependencyNames, substring(path, 0, slash.value))
}
