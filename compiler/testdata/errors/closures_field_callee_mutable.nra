// error: "h" is passed as mutable inside this call, so it cannot also hold the function being called
struct Handler {
  run: (x: int) => int
}

function adder(n: int): (x: int) => int {
  return (x) => x + n
}

function reset(mutable h: Handler): int {
  h = Handler { run: adder(1000) }
  return 5
}

export function run(args: Array<string>): int {
  let h = Handler { run: adder(1) }
  return h.run(reset(mutable h))
}
