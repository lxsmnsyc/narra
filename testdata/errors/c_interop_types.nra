// error: text of C function puts has type string; a C function takes numbers, bool and Ptr<T>
extern {
  function puts(text: string): i32
  function fill(mutable items: Array<int>)
  function names(): Array<string>
} from "c"

export function run(_args: Array<string>): int uses unsafe {
  let items = [1]
  unsafe {
    const _ = puts("x")
    fill(mutable items)
    const _ = names()
  }
  return items[0]
}
