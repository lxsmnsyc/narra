// Two @inline calls in one expression, one inside another's arrow, the same
// function inside its own arrow argument, and an arrow that assigns a captured let.
import * as Arrays from "std/array"
import * as Int from "std/int"

@inline
function twice(value: int, transform: (item: int) => int): int {
  return transform(transform(value))
}

@inline
function each(items: Array<int>, visit: (item: int) => void) {
  for (const item of Arrays.values(items)) {
    if (item < 0) {
      continue
    }
    visit(item)
  }
}

@inline
function sumWith(items: Array<int>, weigh: (item: int) => int): int {
  let total = 0
  let count = 0
  each(items, (_item) => {
    count++
  })
  for (const item of Arrays.values(items)) {
    total += weigh(item)
  }
  return total * count
}

export function run(_args: Array<string>): int uses io, alloc {
  const step = 2
  // Two calls in one expression.
  print(Int.toString(twice(1, (item) => item + step) * twice(3, (item) => item * step)))
  // A call inside the arrow of another, and the same function inside its own arrow.
  print(Int.toString(twice(1, (outer) => twice(outer, (inner) => inner + outer))))
  // An arrow that assigns a captured let, through two copied bodies.
  let seen = 0
  let largest = 0
  each(
    [3, -1, 7, 5],
    (item) => {
      seen++
      if (item > largest) {
        largest = item
      }
    },
  )
  print(`${Int.toString(seen)} ${Int.toString(largest)}`)
  print(Int.toString(sumWith([1, 2, -3, 4], (item) => item * step)))
  // Loops of two copies of one body in the same function keep their own labels.
  each(
    [1],
    (item) => {
      each(
        [item, item + 1],
        (inner) => {
          seen += inner
        },
      )
    },
  )
  print(Int.toString(seen))
  return 0
}
