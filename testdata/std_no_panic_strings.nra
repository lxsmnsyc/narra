import * as Str from "std/string"
import * as Bytes from "std/bytes"
import * as Arrays from "std/array"
import * as Float from "std/float"
import * as Int from "std/int"
import * as F32 from "std/f32"

function describe(label: string, text: Option<string>) uses alloc {
  if (text is Some(found)) {
    print(`${label}: Some("${found}")`)
  } else {
    print(`${label}: None`)
  }
}

function describeNumber(label: string, number: Option<int>) uses alloc {
  if (number is Some(found)) {
    print(`${label}: Some(${Int.toString(found)})`)
  } else {
    print(`${label}: None`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  // Str.slice: None for a position past the end, a start after the end, or the inside of a character.
  describe("slice inside", Str.slice("abcdef", 1, 4))
  describe("slice empty", Str.slice("abc", 3, 3))
  describe("slice past the end", Str.slice("abc", 1, 9))
  describe("slice before the start", Str.slice("abc", -1, 2))
  describe("slice start after end", Str.slice("abc", 2, 1))
  describe("slice inside a character", Str.slice("é", 0, 1))

  // Str.split: None for an empty separator.
  if (Str.split("a,b,c", ",") is Some(pieces)) {
    print(`split pieces: ${Int.toString(Arrays.length(pieces))}`)
  }
  if (Str.split("ab", "") is None) {
    print("split empty separator: None")
  }

  // Str.repeat: None for a negative count.
  describe("repeat", Str.repeat("ab", 3))
  describe("repeat zero", Str.repeat("ab", 0))
  describe("repeat negative", Str.repeat("ab", -1))
  describe("repeat empty text, huge count", Str.repeat("", 9223372036854775807))

  // Bytes.at and Bytes.slice: None outside the bytes.
  const data = Bytes.fromString("hey")
  if (Bytes.at(data, 1) is Some(second)) {
    print(`at: ${Int.toString(Int.from(second))}`)
  }
  if (Bytes.at(data, 3) is None) {
    print("at end: None")
  }
  if (Bytes.at(data, -1) is None) {
    print("at negative: None")
  }
  if (Bytes.slice(data, 1, 3) is Some(part)) {
    print(`slice length: ${Int.toString(Bytes.length(part))}`)
  }
  if (Bytes.slice(data, 2, 9) is None) {
    print("slice past the end: None")
  }
  if (Bytes.slice(data, 2, 1) is None) {
    print("slice start after end: None")
  }

  // Float.truncate: None for NaN and for a value outside int.
  describeNumber("truncate", Float.truncate(-2.7))
  describeNumber("truncate huge", Float.truncate(1.0e30))
  describeNumber("truncate nan", Float.truncate(Float.sqrt(-1.0)))
  describeNumber("f32 truncate", F32.truncate(F32.from(2.5)))
  describeNumber("f32 truncate huge", F32.truncate(F32.from(1.0e30)))
  return 0
}
