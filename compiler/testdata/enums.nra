import * as Int from "std/int"
import * as Float from "std/float"
import * as Arrays from "std/array"

enum Shape {
  Circle(radius: f64)
  Rect(width: f64, height: f64)
  Dot
}

enum Token {
  Word(text: string)
  Number(value: int)
  Space
}

function area(s: Shape): f64 {
  return match (s) {
    Shape.Circle(r) => 3.0 * r * r
    Shape.Rect(w, h) => w * h
    Shape.Dot => 0.0
  }
}

function show(t: Token): string {
  return match (t) {
    Token.Word(text) => `word ${text}`
    Token.Number(n) if (n < 0) => "negative"
    Token.Number(n) => `number ${Int.toString(n)}`
    Token.Space => "space"
  }
}

export function run(args: Array<string>): int {
  print(Float.toString(area(Shape.Circle(2.0))))
  print(Float.toString(area(Shape.Rect(2.0, 3.0))))
  print(Float.toString(area(Shape.Dot)))
  const tokens: Array<Token> = [Token.Word("hi"), Token.Number(-3), Token.Number(42), Token.Space]
  for (const t of Arrays.values(tokens)) {
    print(show(t))
  }
  match (tokens[0]) {
    Token.Word(text) => {
      print(`first is ${text}`)
    }
    _ => print("other")
  }
  return 0
}
