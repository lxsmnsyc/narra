// error: the source of `for (mutable ...)` must be a variable, a field or an element, so the loop can change it in place; store the array in a local first
struct Player {
  hp: int
}

function makePlayers(): Array<Player> {
  return [Player { hp: 3 }]
}

export function run(args: Array<string>): int {
  for (mutable player of makePlayers()) {
    player.hp = 0
  }
  return 0
}
