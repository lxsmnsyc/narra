import * as Int from "std/int"

enum Tree {
  Leaf
  Node(label: string, weight: int)
}

enum Shape {
  Circle(radius: int)
  Square(side: int)
}

enum Wrapped {
  One(inner: Option<Tree>)
  Two(first: Shape, second: Option<Shape>)
}

function describe(t: Option<Tree>): string {
  return match (t) {
    None => "nothing"
    Some(Leaf) => "a leaf"
    Some(Node("root", _)) => "the root"
    Some(Node(label, w)) if (w > 10) => `heavy ${label}`
    Some(Node(label, 0)) => `empty ${label}`
    Some(Node(label, w)) => `${label} weighs ${Int.toString(w)}`
  }
}

function pair(w: Wrapped): string {
  return match (w) {
    One(None) => "one: none"
    One(Some(tree)) => `one: ${describe(Some(tree))}`
    Two(Circle(r), None) => `circle ${Int.toString(r)} alone`
    Two(Circle(_), Some(Circle(_))) => "two circles"
    Two(Square(s), Some(Square(t))) if (s == t) => "equal squares"
    Two(_, Some(other)) => match (other) {
      Circle(r) => `then circle ${Int.toString(r)}`
      Square(s) => `then square ${Int.toString(s)}`
    }
    Two(Square(_), None) => "square alone"
  }
}

function order(a: int, b: int): string {
  return match (Ordered.compare(a, b)) {
    Less => "less"
    Ordering.Equal => "equal"
    Greater => "greater"
  }
}

function word(n: int, loud: bool): string {
  return match (n) {
    0 => "zero"
    -1 => "minus one"
    _ => match (loud) {
      true => "MANY"
      false => "many"
    }
  }
}

function greet(name: string): string {
  return match (name) {
    "" => "nobody"
    "Ana" => "hi Ana"
    other => `hello ${other}`
  }
}

export function run(args: Array<string>): int {
  print(describe(None))
  print(describe(Some(Leaf)))
  print(describe(Some(Node("root", 3))))
  print(describe(Some(Node("big", 20))))
  print(describe(Some(Node("box", 0))))
  print(describe(Some(Node("cup", 4))))
  print(pair(One(None)))
  print(pair(One(Some(Node("x", 1)))))
  print(pair(Two(Circle(2), None)))
  print(pair(Two(Circle(2), Some(Circle(3)))))
  print(pair(Two(Square(2), Some(Square(2)))))
  print(pair(Two(Square(2), Some(Square(5)))))
  print(pair(Two(Square(2), Some(Circle(7)))))
  print(pair(Two(Square(1), None)))
  print(order(1, 2))
  print(order(2, 2))
  print(order(3, 2))
  print(word(0, false))
  print(word(-1, false))
  print(word(5, true))
  print(word(5, false))
  print(greet(""))
  print(greet("Ana"))
  print(greet("Bo"))
  const t: Option<Tree> = Some(Node("deep", 1))
  if (t is Some(Node(label, 1))) {
    print(`is: ${label}`)
  }
  if (t is Some(Leaf)) {
    print("leaf")
  } else {
    print("not a leaf")
  }
  const leafy = t is Some(Leaf) || t is None
  if (!leafy) {
    print("has a node")
  }
  return 0
}
