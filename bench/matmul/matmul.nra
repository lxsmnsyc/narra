import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

function multiply(a: Array<int>, b: Array<int>, n: int): Array<int> {
  let c = filledArray(0, n * n)
  for (const i of Ranges.upTo(n)) {
    for (const j of Ranges.upTo(n)) {
      let sum = 0
      for (const k of Ranges.upTo(n)) {
        sum = sum + a[i * n + k] * b[k * n + j]
      }
      c[i * n + j] = sum
    }
  }
  return c
}

export function run(args: Array<string>): int {
  const n = 600
  let a = filledArray(0, n * n)
  let b = filledArray(0, n * n)
  for (const i of Ranges.upTo(n)) {
    for (const j of Ranges.upTo(n)) {
      a[i * n + j] = (i + j) % 10
      b[i * n + j] = (i * j) % 10
    }
  }
  const c = multiply(a, b, n)
  let total = 0
  for (const x of Arrays.values(c)) {
    total = total + x
  }
  print(Int.toString(total))
  return 0
}

function filledArray<T>(value: T, count: int): Array<T> uses alloc {
  return match (Arrays.filled(value, count)) { Some(items) => items, None => [] }
}
