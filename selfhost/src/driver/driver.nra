// The user commands of narrac: `build`, `run`, `test` and `check`. main.nra
// only dispatches here.
//
//   narrac build [flags] file.nra|dir
//   narrac run [flags] file.nra|dir [args...]
//   narrac test [flags] file.nra|dir [args...]
//   narrac check [--json] [--all-targets] [--target name] file.nra|dir
//   narrac targets
//   narrac explain CODE
//   narrac explain --list --json
//
// Flags of build, run and test (-name, --name, -name=value, -name value; the
// first argument that is not a flag ends the flags):
//   -release        optimize (-O2 -DNARRA_RELEASE)
//   -o path         the executable (build: for a package, one binary only)
//   -emit-c path    also keep the generated C in this file
//   -bin name       the package binary to build or run
//   -filter text    test only: run the tests whose name contains text
//   -time           test only: print the time of each test
//   -target name    build for a target of `narrac targets`, not the host (build only)
//   -sanitize       compile with -fsanitize=address,undefined
//   -stdin path     run and test: the program reads this file as its stdin;
//                   without it stdin is closed
//
// The C compiler is the program named by $CC, else cc. $CC must name a single
// program: it is not split into words, so `CC="ccache cc"` does not work.
//
// run and test capture the program's output and write it when the program
// ends: all of stdout, then all of stderr. Nothing is shown while it runs, and
// the two streams are not interleaved.
//
// Exit codes: 0 success, 1 a load, check or C compiler error (or the exit code
// of the program for run and test), 2 usage.
import { substring } from "narrac/driver/textops"
import * as Env from "std/env"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Io from "std/io"
import * as Path from "std/path"
import * as Process from "std/process"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Random from "std/random"
import { Pos } from "narrac/syntax/ast"
import { quoteGo } from "narrac/syntax/parser"
import * as Modules from "narrac/driver/modules"
import { Package } from "narrac/driver/modules"
import { LoadError } from "narrac/driver/manifest"
import { Member } from "narrac/driver/workspace"
import {
  checkBinaryNames,
  findBinaryOwners,
  listMemberBinaries,
  selectMembers,
} from "narrac/driver/workspaceselect"
import * as Body from "narrac/check/body"
import * as Effects from "narrac/check/effects"
import { Checker } from "narrac/check/check"
import { chooseTarget, importsBuildModule } from "narrac/check/buildconditions"
import {
  BuildTarget,
  TargetRow,
  listTargets,
  describeTarget,
  describeRow,
  detectHostTarget,
  findTargetRow,
  createTarget,
  describeUnknownTarget,
  describeSanitizeError,
  createUnknownTarget,
  targetCompilerArguments,
  targetLinkArguments,
  TARGETS,
} from "narrac/driver/buildtarget"
import { reportSharedWrites } from "narrac/check/sharedwrites"
import { checkConstants } from "narrac/check/consteval"
import { explainCode, writeCodeListJson, writeDiagnosticJson } from "narrac/driver/diagnostics"
import { Fix, applyFix } from "narrac/driver/fixes"
import { emitProgram } from "narrac/emit/emit"
import { findEntry, exitWithoutRelease } from "narrac/emit/emitter"

// A problem found while loading or checking: file is empty and line is 0 for
// a problem that is not a diagnostic (an unreadable file).
struct Diagnostic {
  code: string // "" for a problem that is not a diagnostic
  file: string
  line: int
  column: int
  message: string
  fixes: Array<Fix> = []
}

struct DriverOptions {
  release: bool
  sanitize: bool
  showTime: bool
  output: string
  emitC: string
  binaryName: string
  filter: string
  stdinPath: string
  targetName: string
  dependents: bool
  dependencies: bool
  path: string
  programArguments: Array<string>
}

export function isDriverCommand(name: string): bool {
  return name == "build" ||
    name == "run" ||
    name == "test" ||
    name == "check" ||
    name == "explain" ||
    name == "targets" ||
    name == "apply-fix"
}

export function runDriver(arguments: Array<string>): int uses io, alloc {
  const command = arguments[1]
  if (command == "check") {
    return runCheck(arguments)
  }
  if (command == "explain") {
    return runExplain(arguments)
  }
  if (command == "targets") {
    return runTargets()
  }
  if (command == "apply-fix") {
    return runApplyFix(arguments)
  }
  const parsed = parseOptions(arguments)
  if (parsed is Err(message)) {
    if (message != "") {
      printError(message)
    }
    printError(usageText())
    return 2
  }
  const options = parsed.value
  if (options.path == "") {
    printError(usageText())
    return 2
  }
  if (command != "test" && (options.filter != "" || options.showTime)) {
    printError("-filter and -time are for `narrac test`")
    return 2
  }
  if (command != "build" && options.targetName != "") {
    printError("-target is for `narrac build` and `narrac check`")
    return 2
  }
  if (command == "run" && (options.dependents || options.dependencies)) {
    printError("-dependents and -dependencies are for `narrac build`, `test` and `check`")
    return 2
  }
  const rejected = checkTargetOptions(options)
  if (rejected != "") {
    printError(rejected)
    return 2
  }
  const selected = selectMembers(options.path, options.dependents, options.dependencies, true)
  if (selected is Err(errors)) {
    printError(formatDiagnostics(convertLoadErrors(errors)))
    return exitWithoutRelease(1)
  }
  if (selected.value is Some(members)) {
    return exitWithoutRelease(runMembers(options, command, members))
  }
  if (command == "build") {
    return runBuild(options)
  }
  return runProgram(options, command == "test")
}

export function usageText(): string uses alloc {
  const lines = [
    "usage:",
    "  narrac build [-release] [-sanitize] [-target name] [-bin name] [-o output] [-emit-c file.c] [-dependents] [-dependencies] file.nra|dir",
    "                                            build the executables of a package or file",
    "  narrac run [-release] [-sanitize] [-bin name] [-stdin file] file.nra|dir [args...]",
    "                                            build and run a program",
    "  narrac test [-filter text] [-time] [-release] [-sanitize] [-stdin file] [-dependents] [-dependencies] file.nra|dir",
    "                                            run the test blocks",
    "  narrac check [--json] [--all-targets] [--target name] [-dependents] [-dependencies] file.nra|dir",
    "                                            report errors, on every target with --all-targets",
    "  narrac explain CODE                       explain a diagnostic code",
    "  narrac explain --list --json              list every code as JSON",
    "  narrac apply-fix [--diagnostic N] [--fix M] file.nra|dir",
    "                                            print the file with a fix of an error applied",
    "  narrac fmt [--check] [--stdin] [path...]  format .nra files",
    "  narrac query [--package dir] [--json] question operand",
    "                                            answer a question about a package; the questions are",
    "                                            type-of, def, refs, callers, interface, recursion, hovers",
    "  narrac emit [--tests] [--bin name] file.nra|dir",
    "                                            print the C code of a debug build",
    "  narrac audit [dir]                        list the unsafe blocks and @trusted functions",
    "  narrac lsp [--full] [--trace]             run the language server on stdin and stdout",
    "  narrac targets                            list the systems that -target accepts",
    "  narrac --version                          print the version",
    "  narrac --help                             print this text",
    "",
    "A dir is a package: a directory with narra.toml and src/. Without -bin,",
    "build makes every [[binary]] of the package; run needs the package to have",
    "one binary. The root of a workspace stands for every member: build makes",
    "every binary, run finds -bin across members, test and check cover each",
    "member. A member directory with -dependents or -dependencies adds the",
    "members that depend on it or that it depends on.",
    "",
    "run and test show the program's output when it ends: all of stdout, then",
    "all of stderr. Without -stdin, the program's stdin is closed.",
    "The C compiler is $CC, else cc. CC must name a single program.",
  ]
  return Str.join(lines, "\n")
}

function printError(text: string) uses io, alloc {
  Io.writeError(`${text}\n`)
}

function writeStandardOutput(text: string) uses io {
  // Write as is to the real stdout, without reopening it, so a shell redirect such as `> out 2>&1`
  // keeps both streams.
  Io.write(text)
  Io.flush()
}

function writeStandardError(text: string) uses io {
  Io.writeError(text)
}

// --- flags -----------------------------------------------------------------

function parseOptions(arguments: Array<string>): Result<DriverOptions, string> uses alloc {
  let options = DriverOptions {
    release: false,
    sanitize: false,
    showTime: false,
    output: "",
    emitC: "",
    binaryName: "",
    filter: "",
    stdinPath: "",
    targetName: "",
    dependents: false,
    dependencies: false,
    path: "",
    programArguments: [],
  }
  // arguments[0] is the program name and arguments[1] the command. An Err holds the message to
  // print before the usage (empty for -h).
  let index = 2
  let parsingFlags = true
  while (parsingFlags && index < Arrays.length(arguments)) {
    const argument = arguments[index]
    if (argument == "--") {
      // The marker ends the flags and is not an argument.
      index++
      parsingFlags = false
    } else if (Str.length(argument) < 2 || !Str.startsWith(argument, "-")) {
      parsingFlags = false
    } else {
      index++
      let name = Str.sliceFrom(argument, 1)
      if (Str.startsWith(name, "-")) {
        name = Str.sliceFrom(name, 1)
      }
      if (name == "" || Str.startsWith(name, "-") || Str.startsWith(name, "=")) {
        return Err(`bad flag syntax: ${argument}`)
      }
      // -name=value carries its value; otherwise a flag with a value takes the next argument.
      let hasValue = false
      let value = ""
      if (Str.indexOf(name, "=") is Some(at)) {
        value = Str.sliceFrom(name, at + 1)
        name = substring(name, 0, at)
        hasValue = true
      }
      if (name == "h" || name == "help") {
        return Err("")
      }
      if (isBoolFlag(name)) {
        const flagValue = parseBool(name, hasValue, value)
        if (flagValue is Err(message)) {
          return Err(message)
        }
        setBoolFlag(mutable options, name, flagValue.value)
      } else if (isValueFlag(name)) {
        if (!hasValue) {
          if (index >= Arrays.length(arguments)) {
            return Err(`flag needs an argument: -${name}`)
          }
          value = arguments[index]
          index++
        }
        setValueFlag(mutable options, name, value)
      } else {
        return Err(`flag provided but not defined: -${name}`)
      }
    }
  }
  if (index < Arrays.length(arguments)) {
    options.path = arguments[index]
    index++
    while (index < Arrays.length(arguments)) {
      // After the path, build and test also take the member selection flags.
      const trailing = arguments[index]
      if (arguments[1] != "run" && (trailing == "-dependents" || trailing == "--dependents")) {
        options.dependents = true
      } else if (
        arguments[1] != "run" && (trailing == "-dependencies" || trailing == "--dependencies")
      ) {
        options.dependencies = true
      } else {
        Arrays.push(mutable options.programArguments, trailing)
      }
      index++
    }
  }
  return Ok(options)
}

function isBoolFlag(name: string): bool {
  return name == "release" ||
    name == "time" ||
    name == "sanitize" ||
    name == "dependents" ||
    name == "dependencies"
}

function isValueFlag(name: string): bool {
  return name == "o" ||
    name == "emit-c" ||
    name == "bin" ||
    name == "filter" ||
    name == "stdin" ||
    name == "target"
}

function parseBool(name: string, hasValue: bool, value: string): Result<bool, string> uses alloc {
  // Like the standard flag syntax, a flag without a value is true.
  if (!hasValue) {
    return Ok(true)
  }
  if (
    value == "1" ||
      value == "t" ||
      value == "T" ||
      value == "true" ||
      value == "TRUE" ||
      value == "True"
  ) {
    return Ok(true)
  }
  if (
    value == "0" ||
      value == "f" ||
      value == "F" ||
      value == "false" ||
      value == "FALSE" ||
      value == "False"
  ) {
    return Ok(false)
  }
  return Err(`invalid boolean value ${quoteGo(value)} for -${name}: parse error`)
}

function setBoolFlag(mutable options: DriverOptions, name: string, value: bool) {
  if (name == "release") {
    options.release = value
  } else if (name == "time") {
    options.showTime = value
  } else if (name == "dependents") {
    options.dependents = value
  } else if (name == "dependencies") {
    options.dependencies = value
  } else {
    options.sanitize = value
  }
}

function setValueFlag(mutable options: DriverOptions, name: string, value: string) {
  if (name == "o") {
    options.output = value
  } else if (name == "emit-c") {
    options.emitC = value
  } else if (name == "bin") {
    options.binaryName = value
  } else if (name == "filter") {
    options.filter = value
  } else if (name == "target") {
    options.targetName = value
  } else {
    options.stdinPath = value
  }
}

// --- load, check, emit -------------------------------------------------------

function formatDiagnostic(diagnostic: Diagnostic): string uses alloc {
  if (diagnostic.file == "" && diagnostic.line == 0) {
    return diagnostic.message
  }
  const position = `${Int.toString(diagnostic.line)}:${Int.toString(diagnostic.column)}`
  if (diagnostic.file == "") {
    return `${position}: ${diagnostic.message}`
  }
  return `${diagnostic.file}:${position}: ${diagnostic.message}`
}

function formatDiagnostics(diagnostics: Array<Diagnostic>): string uses alloc {
  let lines: Array<string> = []
  for (const diagnostic of Arrays.values(diagnostics)) {
    Arrays.push(mutable lines, formatDiagnostic(diagnostic))
  }
  return Str.join(lines, "\n")
}

function convertLoadErrors(errors: Array<LoadError>): Array<Diagnostic> from errors uses alloc {
  let diagnostics: Array<Diagnostic> = []
  for (const error of Arrays.values(errors)) {
    // A syntax error arrives as one message that starts with `error `.
    let message = error.message
    if (error.file == "" && Str.startsWith(message, "error ")) {
      message = Str.sliceFrom(message, 6)
    }
    Arrays.push(mutable diagnostics, Diagnostic {
      code: error.code,
      file: error.file,
      line: error.line,
      column: error.column,
      message,
      fixes: error.fixes,
    })
  }
  return diagnostics
}

function loadAndCheck(path: string, release: bool, targetName: string): Result<#[
  Package,
  Checker,
], Array<Diagnostic>> uses io, alloc {
  const loaded = Modules.load(path)
  if (loaded is Err(errors)) {
    return Err(convertLoadErrors(errors))
  }
  return checkForTarget(loaded.value, chooseNamedTarget(loaded.value, release, targetName))
}

function checkForTarget(package: Package, target: BuildTarget): Result<#[
  Package,
  Checker,
], Array<Diagnostic>> from package uses alloc {
  let checker = copy(Body.checkPackageFor(package, target))
  // The effects are checked only when the bodies have no errors; shared writes always.
  if (Arrays.length(checker.errors) == 0) {
    const effects = Effects.checkEffects(mutable checker)
    reportSharedWrites(mutable checker)
    // Constants are computed only for a program that passed every other check.
    checkConstants(mutable checker, effects)
  } else {
    reportSharedWrites(mutable checker)
  }
  if (Arrays.length(checker.errors) > 0) {
    let diagnostics: Array<Diagnostic> = []
    for (const error of Arrays.values(checker.errors)) {
      Arrays.push(mutable diagnostics, Diagnostic {
        code: error.code,
        file: error.file,
        line: error.pos.line,
        column: error.pos.column,
        message: error.message,
        fixes: error.fixes,
      })
    }
    return Err(diagnostics)
  }
  return Ok(#[package, checker])
}

function findTargetDiagnostics(
  package: Package,
  target: BuildTarget,
): Array<Diagnostic> from package uses alloc {
  const checked = checkForTarget(package, target)
  if (checked is Err(errors)) {
    return errors
  }
  const #[_, checker] = checked.value
  return findMissingEntries(package, checker)
}

function findPathDiagnostics(path: string, targetName: string): Array<Diagnostic> uses io, alloc {
  const checked = loadAndCheck(path, false, targetName)
  if (checked is Err(found)) {
    return found
  }
  const #[package, checker] = checked.value
  return findMissingEntries(package, checker)
}

function checkEveryTarget(path: string): Array<Diagnostic> uses io, alloc {
  const loaded = Modules.load(path)
  if (loaded is Err(errors)) {
    return convertLoadErrors(errors)
  }
  const package = loaded.value
  // Without std/build the package is the same on every target; with it, each
  // row of the table is checked as a debug and as a release build.
  let targets = [chooseTarget(package, false)]
  if (importsBuildModule(package)) {
    targets = listTargets(true)
    for (const target of Arrays.values(listTargets(false))) {
      Arrays.push(mutable targets, target)
    }
  } else if (findTargetRow("Wasi-Wasm32") is Some(wasiRow)) {
    // Wasi leaves std out even for a program that has no build conditions.
    Arrays.push(mutable targets, createTarget(wasiRow, true))
  }
  // A diagnostic found on several targets is reported once. An E0991 names the
  // target, so its key leaves the name out and the message gets every target it fails on.
  let diagnostics: Array<Diagnostic> = []
  let seen: Map<string, bool> = Map {}
  let runs: Map<string, Array<TargetRun>> = Map {}
  let firstNames: Array<string> = []
  let useKeys: Array<string> = []
  for (const target of Arrays.values(targets)) {
    const found = findTargetDiagnostics(package, target)
    const targetName = describeTarget(target)
    for (const diagnostic of Arrays.values(found)) {
      let message = diagnostic.message
      if (diagnostic.code == "E0991") {
        message = Str.replace(message, `compiled for ${targetName};`, "compiled for ;")
      }
      const key = `${diagnostic.file}:${Int.toString(diagnostic.line)}:${Int.toString(diagnostic.column)}:${diagnostic.code}:${message}`
      if (seen[key] is None) {
        seen[key] = true
        Arrays.push(mutable diagnostics, diagnostic)
        Arrays.push(mutable firstNames, targetName)
        Arrays.push(mutable useKeys, key)
        runs[key] = []
      }
      if (diagnostic.code == "E0991") {
        let targetRuns: Array<TargetRun> = []
        if (runs[key] is Some(earlier)) {
          targetRuns = copy(earlier)
        }
        Arrays.push(mutable targetRuns, TargetRun { name: targetName, debug: target.debug })
        runs[key] = targetRuns
      }
    }
  }
  // Each E0991 lists its targets, then the diagnostics go in source order.
  for (const index of Ranges.between(0, Arrays.length(diagnostics))) {
    if (diagnostics[index].code == "E0991") {
      if (runs[useKeys[index]] is Some(targetRuns)) {
        diagnostics[index].message = Str.replace(
          diagnostics[index].message,
          `compiled for ${firstNames[index]};`,
          `compiled for ${describeTargetRuns(targetRuns)};`,
        )
      }
    }
  }
  return sortDiagnostics(diagnostics)
}

// One target an E0991 was found on, for its message.
struct TargetRun {
  name: string
  debug: bool
}

function describeTargetRuns(targetRuns: Array<TargetRun>): string uses alloc {
  // A target found in both builds is named plainly; in one only, with that build.
  let names: Array<string> = []
  for (const run of Arrays.values(targetRuns)) {
    let known = false
    for (const name of Arrays.values(names)) {
      if (name == run.name) {
        known = true
      }
    }
    if (!known) {
      Arrays.push(mutable names, run.name)
    }
  }
  let parts: Array<string> = []
  for (const name of Arrays.values(names)) {
    let inDebug = false
    let inRelease = false
    for (const run of Arrays.values(targetRuns)) {
      if (run.name == name) {
        if (run.debug) {
          inDebug = true
        } else {
          inRelease = true
        }
      }
    }
    if (inDebug && inRelease) {
      Arrays.push(mutable parts, name)
    } else if (inDebug) {
      Arrays.push(mutable parts, `${name} (debug)`)
    } else {
      Arrays.push(mutable parts, `${name} (release)`)
    }
  }
  return Str.join(parts, ", ")
}

function sortDiagnostics(
  diagnostics: Array<Diagnostic>,
): Array<Diagnostic> from diagnostics uses alloc {
  // An insertion sort by file, line and column keeps equal positions in report order.
  let sorted: Array<Diagnostic> = []
  for (const diagnostic of Arrays.values(diagnostics)) {
    let position = Arrays.length(sorted)
    while (position > 0 && isDiagnosticBefore(diagnostic, sorted[position - 1])) {
      position--
    }
    let next: Array<Diagnostic> = []
    for (const index of Ranges.between(0, Arrays.length(sorted))) {
      if (index == position) {
        Arrays.push(mutable next, diagnostic)
      }
      Arrays.push(mutable next, sorted[index])
    }
    if (position == Arrays.length(sorted)) {
      Arrays.push(mutable next, diagnostic)
    }
    sorted = copy(next)
  }
  return sorted
}

function isDiagnosticBefore(left: Diagnostic, right: Diagnostic): bool {
  if (left.file != right.file) {
    return left.file < right.file
  }
  if (left.line != right.line) {
    return left.line < right.line
  }
  return left.column < right.column
}

// The C text of a program, the libraries its reached extern blocks name, and the
// `[link] search` directories of its package. The package and the checker stay
// live until the command exits, so the process exit frees them.
struct CompiledProgram {
  text: string
  libraries: Array<string>
  search: Array<string>
  package: Package
  checker: Checker
}

function compileToC(
  path: string,
  binaryName: string,
  tests: bool,
  release: bool,
  targetName: string,
): Result<CompiledProgram, string> uses io, alloc {
  const checked = loadAndCheck(path, release, targetName)
  if (checked is Err(diagnostics)) {
    return Err(formatDiagnostics(diagnostics))
  }
  const #[package, checker] = checked.value
  // A test build has no entry function.
  let entry = -1
  if (!tests) {
    const found = findEntry(checker, package, binaryName)
    if (found is Err(message)) {
      return Err(message)
    }
    entry = found.value
  }
  const result = emitProgram(checker, entry, tests)
  if (Arrays.length(result.unsupported) > 0) {
    let lines: Array<string> = []
    for (const construct of Arrays.values(result.unsupported)) {
      Arrays.push(mutable lines, `unsupported: ${construct}`)
    }
    return Err(Str.join(lines, "\n"))
  }
  return Ok(CompiledProgram {
    text: result.text,
    libraries: result.libraries,
    search: findSearchDirectories(package),
    package,
    checker,
  })
}

function findSearchDirectories(package: Package): Array<string> uses alloc {
  // A relative directory is relative to the package, not to where narrac runs.
  let directories: Array<string> = []
  for (const directory of Arrays.values(package.search)) {
    if (Str.startsWith(directory, "/")) {
      Arrays.push(mutable directories, directory)
    } else {
      Arrays.push(mutable directories, Path.join(package.directory, directory))
    }
  }
  return directories
}

// --- the C compiler ---------------------------------------------------------

function makeTempDirectory(): Result<string, string> uses io, alloc {
  // The folder comes from the environment, as mktemp would pick it, but the
  // compiler makes it itself: a Windows compiler started from a POSIX shell
  // would get a path from mktemp that it cannot open.
  const parent = findTempParent()
  let random = Random.fromSystem()
  for (const _ of Ranges.upTo(100)) {
    let number = 0
    if (Random.nextInt(mutable random, 0, 1 << 60) is Some(drawn)) {
      number = drawn
    }
    const directory = Path.join(parent, `narrac-${Int.toHex(number)}`)
    if (Fs.exists(directory)) {
      continue
    }
    const created = Fs.createDir(directory)
    if (created is Err(message)) {
      return Err(`cannot create a temporary folder in ${parent}: ${message}`)
    }
    return Ok(directory)
  }
  return Err(`cannot create a temporary folder in ${parent}`)
}

function findTempParent(): string uses io, alloc {
  // TMPDIR first, then the Windows names, then the POSIX default.
  for (const name of ["TMPDIR", "TEMP", "TMP"]) {
    if (Env.get(name) is Some(value)) {
      if (value != "") {
        return value
      }
    }
  }
  return "/tmp"
}

function chooseNamedTarget(
  package: Package,
  release: bool,
  targetName: string,
): BuildTarget uses io, alloc {
  // A named target replaces the host for the build conditions.
  if (findTargetRow(targetName) is Some(row)) {
    // Wasi always has a known target, since E0991 on its left-out std needs it.
    if (importsBuildModule(package) || row.os == "Wasi") {
      return createTarget(row, !release)
    }
    return createUnknownTarget(!release)
  }
  return chooseTarget(package, release)
}

function findTargetOs(targetName: string): string uses io, alloc {
  // The system a build runs on: the named cross target, else the host.
  if (findCrossTarget(targetName) is Some(row)) {
    return row.os
  }
  return detectHostTarget(true).os
}

function findCrossTarget(targetName: string): Option<TargetRow> uses io, alloc {
  // The row of a named target that is not the host; none for the host itself.
  if (targetName == "") {
    return None
  }
  const found = findTargetRow(targetName)
  if (found is Some(row)) {
    const host = detectHostTarget(true)
    if (host.os == "" || describeTarget(host) != targetName) {
      return Some(row)
    }
  }
  return None
}

function checkTargetOptions(options: DriverOptions): string uses io, alloc {
  // An unknown name (E1600) or -sanitize for another target (E1601) is a usage error.
  if (options.targetName == "") {
    return ""
  }
  if (findTargetRow(options.targetName) is None) {
    return describeUnknownTarget(options.targetName)
  }
  if (options.sanitize) {
    if (findCrossTarget(options.targetName) is Some(row)) {
      return describeSanitizeError(row)
    }
  }
  return ""
}

function runTargets(): int uses io, alloc {
  let lines = Str.builder()
  for (const row of Arrays.values(TARGETS)) {
    Str.append(mutable lines, `${describeRow(row)} ${row.triple}\n`)
  }
  writeStandardOutput(Str.build(lines))
  return 0
}

function cCompilerName(): string uses io, alloc {
  // $CC is one program name or path; it is never split into words.
  const configured = Env.get("CC")
  if (configured is Some(name)) {
    if (name != "") {
      return name
    }
  }
  return "cc"
}

function cCompilerArguments(
  options: DriverOptions,
  cPath: string,
  output: string,
  compiled: CompiledProgram,
): Array<string> uses io, alloc {
  let arguments: Array<string> = []
  // A target other than the host goes first, so the C compiler knows it before the other flags.
  if (findCrossTarget(options.targetName) is Some(row)) {
    Arrays.push(mutable arguments, "-target")
    Arrays.push(mutable arguments, row.triple)
    for (const flag of Arrays.values(targetCompilerArguments(row))) {
      Arrays.push(mutable arguments, flag)
    }
  }
  if (options.release) {
    Arrays.push(mutable arguments, "-O2")
    Arrays.push(mutable arguments, "-DNARRA_RELEASE")
  } else {
    Arrays.push(mutable arguments, "-O0")
    Arrays.push(mutable arguments, "-g")
  }
  Arrays.push(mutable arguments, "-std=c11")
  Arrays.push(mutable arguments, "-w")
  if (options.sanitize) {
    Arrays.push(mutable arguments, "-fsanitize=address,undefined")
    Arrays.push(mutable arguments, "-fno-omit-frame-pointer")
  }
  // Thread mode (D111 item 2) links the POSIX threads library.
  for (const path of Arrays.values(compiled.checker.used)) {
    if (path == "std/internal/thread") {
      Arrays.push(mutable arguments, "-pthread")
    }
  }
  Arrays.push(mutable arguments, "-o")
  Arrays.push(mutable arguments, output)
  for (const directory of Arrays.values(compiled.search)) {
    Arrays.push(mutable arguments, `-L${directory}`)
  }
  Arrays.push(mutable arguments, cPath)
  // The libraries go after the C file that uses them; libm is always linked.
  for (const library of Arrays.values(compiled.libraries)) {
    if (library != "m") {
      Arrays.push(mutable arguments, `-l${library}`)
    }
  }
  Arrays.push(mutable arguments, "-lm")
  // The system libraries of the target, after the C file that needs them.
  for (const flag of Arrays.values(targetLinkArguments(findTargetOs(options.targetName)))) {
    Arrays.push(mutable arguments, flag)
  }
  return arguments
}

function buildExecutable(
  options: DriverOptions,
  binaryName: string,
  tests: bool,
  output: string,
): Result<CompiledProgram, string> uses io, alloc {
  const compiled = compileToC(options.path, binaryName, tests, options.release, options.targetName)
  if (compiled is Err(message)) {
    return Err(message)
  }
  // The C goes to -emit-c, else to a file in a temporary directory.
  const directory = makeTempDirectory()
  if (directory is Err(message)) {
    return Err(message)
  }
  let cPath = Path.join(directory.value, "out.c")
  if (options.emitC != "") {
    cPath = options.emitC
  }
  const written = Fs.writeText(cPath, compiled.value.text)
  if (written is Err(message)) {
    removeTempDirectory(directory.value, options.emitC == "")
    return Err(message)
  }
  const ran = Process.run(
    cCompilerName(),
    cCompilerArguments(options, cPath, output, compiled.value),
  )
  removeTempDirectory(directory.value, options.emitC == "")
  if (ran is Err(message)) {
    return Err(message)
  }
  const #[code, standardOutput, standardError] = ran.value
  // The compiler's output goes to stderr.
  writeStandardError(standardOutput)
  writeStandardError(standardError)
  if (code != 0) {
    return Err(`C compiler failed: exit status ${Int.toString(code)}`)
  }
  return compiled
}

function removeTempDirectory(directory: string, removeC: bool) uses io, alloc {
  if (removeC) {
    const _ = Fs.removeFile(Path.join(directory, "out.c"))
  }
  const _ = Fs.removeDir(directory)
}

// --- build ------------------------------------------------------------------

function runBuild(options: DriverOptions): int uses io, alloc {
  return exitWithoutRelease(buildPath(options))
}

function buildPath(options: DriverOptions): int uses io, alloc {
  if (!Fs.isDir(options.path)) {
    // A file: the executable is named after it. A missing or broken file is
    // reported by buildExecutable.
    let output = options.output
    if (output == "") {
      output = Str.replace(Path.basename(options.path), ".nra", "")
    }
    const built = buildExecutable(options, options.binaryName, false, output)
    return finishBuild(built)
  }
  const loaded = Modules.load(options.path)
  if (loaded is Err(errors)) {
    printError(formatDiagnostics(convertLoadErrors(errors)))
    return 1
  }
  const package = loaded.value
  // A package: the selected binary, or every binary.
  let names: Array<string> = []
  if (options.binaryName != "") {
    Arrays.push(mutable names, options.binaryName)
  } else {
    for (const binary of Arrays.values(package.binaries)) {
      Arrays.push(mutable names, binary.name)
    }
  }
  if (Arrays.length(names) == 0) {
    printError(`narra.toml: package ${package.name} has no [[binary]]; it is a library`)
    return 1
  }
  if (options.output != "" && Arrays.length(names) > 1) {
    printError(
      `-o needs one binary; the package has ${Str.join(names, ", ")}, choose one with -bin`,
    )
    return 1
  }
  let builds: Array<Result<CompiledProgram, string>> = []
  for (const name of Arrays.values(names)) {
    let output = options.output
    if (output == "") {
      output = name
    }
    Arrays.push(mutable builds, buildExecutable(options, name, false, output))
    if (finishBuild(builds[Arrays.length(builds) - 1]) != 0) {
      return 1
    }
  }
  return 0
}

function finishBuild(built: Result<CompiledProgram, string>): int uses io, alloc {
  if (built is Err(message)) {
    printError(message)
    return 1
  }
  return 0
}

// --- workspace members --------------------------------------------------------

function createMemberOptions(
  options: DriverOptions,
  member: Member,
): DriverOptions from options uses alloc {
  return DriverOptions { ...options, path: member.directory }
}

function runMembers(
  options: DriverOptions,
  command: string,
  members: Array<Member>,
): int uses io, alloc {
  if (Arrays.length(members) == 0) {
    printError("the workspace has no members")
    return 1
  }
  if (command == "build") {
    return buildMembers(options, members)
  }
  if (command == "run") {
    return runMemberBinary(options, members)
  }
  // Each member's tests run as one program, in the order of the members. The exit code is 1 when
  // any member fails. With a filter, a member that has no matching test is skipped; the command
  // fails only when no member matched.
  let status = 0
  let matched = 0
  const skipsUnmatched = options.filter != "" && Arrays.length(members) > 1
  for (const member of Arrays.values(members)) {
    let header = ""
    if (Arrays.length(members) > 1) {
      header = `== ${member.name} (${member.directory}) ==\n`
    }
    const code = runProgramWith(createMemberOptions(options, member), true, header, skipsUnmatched)
    if (code == -1) {
      continue
    }
    matched++
    if (code != 0) {
      status = 1
    }
  }
  if (matched == 0 && skipsUnmatched) {
    printError(`no tests match "${options.filter}"`)
    return 1
  }
  return status
}

function buildMembers(options: DriverOptions, members: Array<Member>): int uses io, alloc {
  // Every binary of every member goes to one directory, so a name must belong to one member.
  const unique = checkBinaryNames(members)
  if (unique is Err(error)) {
    printError(formatDiagnostics(convertLoadErrors([error])))
    return 1
  }
  let selected: Array<Member> = []
  let binaryCount = 0
  for (const member of Arrays.values(members)) {
    const names = listMemberBinaries(member)
    if (options.binaryName == "" && Arrays.length(names) > 0) {
      Arrays.push(mutable selected, copy(member))
      binaryCount += Arrays.length(names)
    }
    for (const name of Arrays.values(names)) {
      if (options.binaryName != "" && name == options.binaryName) {
        Arrays.push(mutable selected, copy(member))
        binaryCount++
      }
    }
  }
  if (binaryCount == 0) {
    if (options.binaryName != "") {
      printError(`no member has a binary named ${options.binaryName}`)
    } else {
      printError("no member has a [[binary]]; the members are libraries")
    }
    return 1
  }
  if (options.output != "" && binaryCount > 1) {
    printError("-o needs one binary; choose one with -bin")
    return 1
  }
  for (const member of Arrays.values(selected)) {
    if (buildPath(createMemberOptions(options, member)) != 0) {
      return 1
    }
  }
  return 0
}

function runMemberBinary(options: DriverOptions, members: Array<Member>): int uses io, alloc {
  let binaryName = options.binaryName
  if (binaryName == "") {
    // A name that two members share is E0488, before any count is made.
    const unique = checkBinaryNames(members)
    if (unique is Err(error)) {
      printError(formatDiagnostics(convertLoadErrors([error])))
      return 1
    }
    // Without -bin the workspace must have exactly one binary.
    let names: Array<string> = []
    for (const member of Arrays.values(members)) {
      for (const name of Arrays.values(listMemberBinaries(member))) {
        Arrays.push(mutable names, name)
      }
    }
    if (Arrays.length(names) != 1) {
      printError(
        `the workspace has ${Int.toString(Arrays.length(names))} binaries; choose one with -bin`,
      )
      return 1
    }
    binaryName = names[0]
  }
  const owners = findBinaryOwners(members, binaryName)
  if (owners is Err(error)) {
    printError(formatDiagnostics(convertLoadErrors([error])))
    return 1
  }
  if (Arrays.length(owners.value) == 0) {
    printError(`no member has a binary named ${binaryName}`)
    return 1
  }
  let memberOptions = copy(createMemberOptions(options, owners.value[0]))
  memberOptions.binaryName = binaryName
  return runProgramCode(memberOptions, false)
}

// --- run and test -----------------------------------------------------------

function runProgram(options: DriverOptions, tests: bool): int uses io, alloc {
  return exitWithoutRelease(runProgramCode(options, tests))
}

function runProgramCode(options: DriverOptions, tests: bool): int uses io, alloc {
  return runProgramWith(options, tests, "", false)
}

function runProgramWith(
  options: DriverOptions,
  tests: bool,
  header: string,
  skipsUnmatched: bool,
): int uses io, alloc {
  let programArguments = options.programArguments
  if (tests) {
    // In test mode it is the test program, with the arguments of testArguments in front.
    programArguments = testArguments(options)
    for (const argument of Arrays.values(options.programArguments)) {
      Arrays.push(mutable programArguments, argument)
    }
  }
  // The executable: -o, else a temporary one.
  let output = options.output
  let directory = ""
  if (output == "") {
    const made = makeTempDirectory()
    if (made is Err(message)) {
      printError(message)
      return 1
    }
    directory = made.value
    output = Path.join(directory, "program")
  }
  const built = buildExecutable(options, options.binaryName, tests, output)
  if (built is Err(message)) {
    printError(message)
    removeProgramDirectory(directory, output)
    return 1
  }
  const ran = startProgram(output, programArguments, options.stdinPath)
  removeProgramDirectory(directory, output)
  if (ran is Err(message)) {
    printError(message)
    return 1
  }
  // The program's stdout and stderr are captured and written once it ends, stdout first.
  const #[code, standardOutput, standardError] = ran.value
  // A member of several that has no test with the filter's text is skipped, with no output.
  if (skipsUnmatched && code == 1 && Str.startsWith(standardOutput, "no tests match")) {
    return -1
  }
  if (header != "") {
    writeStandardOutput(header)
  }
  writeStandardOutput(standardOutput)
  writeStandardError(standardError)
  return code
}

function removeProgramDirectory(directory: string, output: string) uses io, alloc {
  if (directory != "") {
    const _ = Fs.removeFile(output)
    const _ = Fs.removeDir(directory)
  }
}

function startProgram(
  executable: string,
  programArguments: Array<string>,
  stdinPath: string,
): Result<#[int, string, string], string> uses io, alloc {
  // Without a stdin file it runs directly (stdin is closed); with one it goes through `sh -c 'exec
  // "$@" < file'`.
  if (stdinPath == "") {
    return Process.run(absoluteIfBare(executable), programArguments)
  }
  let shellArguments = [
    "-c",
    "input=$1; shift; exec \"$@\" < \"$input\"",
    "narrac",
    stdinPath,
    absoluteIfBare(executable),
  ]
  for (const argument of Arrays.values(programArguments)) {
    Arrays.push(mutable shellArguments, argument)
  }
  return Process.run("sh", shellArguments)
}

function absoluteIfBare(executable: string): string {
  // Process.run searches PATH for a name without a slash.
  if (Str.contains(executable, "/")) {
    return executable
  }
  return `./${executable}`
}

function testArguments(options: DriverOptions): Array<string> uses io, alloc {
  let arguments: Array<string> = []
  if (options.filter != "") {
    Arrays.push(mutable arguments, "--filter")
    Arrays.push(mutable arguments, options.filter)
  }
  if (options.showTime) {
    Arrays.push(mutable arguments, "--time")
  }
  Arrays.push(mutable arguments, "--golden-dir")
  Arrays.push(mutable arguments, findGoldenDirectory(options.path))
  return arguments
}

function findGoldenDirectory(path: string): string uses io, alloc {
  // Test.golden looks for `<name>.golden` in the directory of the file, or in testdata/ of a
  // package, as an absolute path.
  let directory = Path.dirname(path)
  if (Fs.isDir(path)) {
    directory = Path.join(trimTrailingSlashes(path), "testdata")
  }
  if (Str.startsWith(directory, "/")) {
    return directory
  }
  let currentDirectory = "."
  if (Env.get("PWD") is Some(working)) {
    currentDirectory = working
  }
  if (directory == "." || directory == "") {
    return currentDirectory
  }
  if (Str.startsWith(directory, "./")) {
    directory = Str.sliceFrom(directory, 2)
  }
  return Path.join(currentDirectory, directory)
}

function trimTrailingSlashes(path: string): string {
  let result = path
  while (Str.length(result) > 1 && Str.endsWith(result, "/")) {
    result = substring(result, 0, Str.length(result) - 1)
  }
  return result
}

// --- check ------------------------------------------------------------------

function runCheck(arguments: Array<string>): int uses io, alloc {
  let asJson = false
  let allTargets = false
  let targetName = ""
  let takesTarget = false
  let dependents = false
  let dependencies = false
  let paths: Array<string> = []
  for (const index of Ranges.between(2, Arrays.length(arguments))) {
    const argument = arguments[index]
    if (takesTarget) {
      targetName = argument
      takesTarget = false
    } else if (argument == "--target" || argument == "-target") {
      takesTarget = true
    } else if (argument == "--json" || argument == "-json") {
      asJson = true
    } else if (argument == "--all-targets" || argument == "-all-targets") {
      allTargets = true
    } else if (argument == "--dependents" || argument == "-dependents") {
      dependents = true
    } else if (argument == "--dependencies" || argument == "-dependencies") {
      dependencies = true
    } else {
      Arrays.push(mutable paths, argument)
    }
  }
  if (
    Arrays.length(paths) != 1 ||
      Str.startsWith(paths[0], "-") ||
      takesTarget ||
      (allTargets && targetName != "")
  ) {
    printError(
      "usage: narrac check [--json] [--all-targets | --target name] [-dependents] [-dependencies] file.nra|dir",
    )
    return 2
  }
  if (targetName != "" && findTargetRow(targetName) is None) {
    printError(describeUnknownTarget(targetName))
    return 2
  }
  let diagnostics: Array<Diagnostic> = []
  const selected = selectMembers(paths[0], dependents, dependencies, true)
  if (selected is Err(errors)) {
    diagnostics = convertLoadErrors(errors)
  } else if (selected.value is Some(members)) {
    diagnostics = findMemberDiagnostics(members, allTargets, targetName)
  } else if (allTargets) {
    diagnostics = checkEveryTarget(paths[0])
  } else {
    diagnostics = findPathDiagnostics(paths[0], targetName)
  }
  // Exit 0: no diagnostics. Exit 1: errors or an unreadable path. Exit 2: usage.
  if (Arrays.length(diagnostics) == 0) {
    return 0
  }
  // With --json, stdout has one JSON object per diagnostic; otherwise the text form is one
  // `file:line:col: message` line each on stderr. A problem that is not a diagnostic (an unreadable
  // file) is text on stderr.
  if (asJson && diagnostics[0].code != "") {
    let lines = Str.builder()
    for (const diagnostic of Arrays.values(diagnostics)) {
      const pos = Pos { line: diagnostic.line, column: diagnostic.column }
      Str.append(
        mutable lines,
        `${writeDiagnosticJson(diagnostic.file, pos, diagnostic.code, diagnostic.message, diagnostic.fixes)}\n`,
      )
    }
    writeStandardOutput(Str.build(lines))
  } else {
    printError(formatDiagnostics(diagnostics))
  }
  return 1
}

function findMemberDiagnostics(
  members: Array<Member>,
  allTargets: bool,
  targetName: string,
): Array<Diagnostic> uses io, alloc {
  // Each member is checked as its own program; a file is named from the member's directory so
  // diagnostics of two members stay apart.
  let diagnostics: Array<Diagnostic> = []
  for (const member of Arrays.values(members)) {
    let found: Array<Diagnostic> = []
    if (allTargets) {
      found = checkEveryTarget(member.directory)
    } else {
      found = findPathDiagnostics(member.directory, targetName)
    }
    for (const diagnostic of Arrays.values(found)) {
      // A file of the member itself is `src/...` or `narra.toml`; a file of a dependency starts
      // with the dependency's name, and a member's own run reports it.
      let file = diagnostic.file
      if (file == "narra.toml" || Str.startsWith(file, "src/")) {
        file = Path.join(member.directory, file)
      } else if (isMemberFile(members, file)) {
        continue
      }
      // A dependency that is not selected is reported by each member that uses it; once is enough.
      let isRepeated = false
      for (const known of Arrays.values(diagnostics)) {
        if (
          known.file == file &&
            known.line == diagnostic.line &&
            known.column == diagnostic.column &&
            known.code == diagnostic.code &&
            known.message == diagnostic.message
        ) {
          isRepeated = true
        }
      }
      if (!isRepeated) {
        Arrays.push(mutable diagnostics, Diagnostic { ...diagnostic, file })
      }
    }
  }
  return sortDiagnostics(diagnostics)
}

function isMemberFile(members: Array<Member>, file: string): bool uses alloc {
  for (const member of Arrays.values(members)) {
    if (Str.startsWith(file, `${member.name}/src/`)) {
      return true
    }
  }
  return false
}

function runApplyFix(arguments: Array<string>): int uses io, alloc {
  // --diagnostic N is the index of a diagnostic in report order (the first one with a fix when
  // omitted) and --fix M the index of its fix (0 when omitted). Exit 1: no diagnostics, or no such
  // fix. Exit 2: usage.
  let diagnosticIndex = -1
  let fixIndex = 0
  let paths: Array<string> = []
  let index = 2
  while (index < Arrays.length(arguments)) {
    const argument = arguments[index]
    if (argument == "--diagnostic" || argument == "--fix") {
      if (index + 1 >= Arrays.length(arguments)) {
        printError(usageApplyFix())
        return 2
      }
      const number = Int.parse(arguments[index + 1], 10)
      if (number is Err(_)) {
        printError(usageApplyFix())
        return 2
      }
      if (argument == "--fix") {
        fixIndex = number.value
      } else {
        diagnosticIndex = number.value
      }
      index += 2
    } else {
      Arrays.push(mutable paths, argument)
      index++
    }
  }
  if (Arrays.length(paths) != 1 || Str.startsWith(paths[0], "-")) {
    printError(usageApplyFix())
    return 2
  }
  const checked = loadAndCheck(paths[0], false, "")
  const diagnostics = (checked is Err(found) ? found : [])
  if (Arrays.length(diagnostics) == 0) {
    printError("no diagnostics")
    return 1
  }
  // Pick the diagnostic: the one asked for, else the first that has a fix.
  if (diagnosticIndex < 0) {
    for (const position of Ranges.upTo(Arrays.length(diagnostics))) {
      if (diagnosticIndex < 0 && Arrays.length(diagnostics[position].fixes) > 0) {
        diagnosticIndex = position
      }
    }
  }
  if (diagnosticIndex < 0 || diagnosticIndex >= Arrays.length(diagnostics)) {
    printError("no such diagnostic")
    return 1
  }
  const diagnostic = diagnostics[diagnosticIndex]
  if (fixIndex < 0 || fixIndex >= Arrays.length(diagnostic.fixes)) {
    printError("no such fix")
    return 1
  }
  // The edits belong to the file of the diagnostic: the file itself, or a file
  // of the package directory.
  let sourcePath = paths[0]
  if (Fs.isDir(paths[0])) {
    sourcePath = Path.join(trimTrailingSlashes(paths[0]), diagnostic.file)
  }
  const read = Fs.readText(sourcePath)
  if (read is Err(message)) {
    printError(message)
    return 1
  }
  writeStandardOutput(applyFix(read.value, diagnostic.fixes[fixIndex]))
  return 0
}

function usageApplyFix(): string {
  return "usage: narrac apply-fix [--diagnostic N] [--fix M] file.nra|dir"
}

function runExplain(arguments: Array<string>): int uses io, alloc {
  if (Arrays.length(arguments) == 4 && arguments[2] == "--list" && arguments[3] == "--json") {
    writeStandardOutput(writeCodeListJson())
    return 0
  }
  if (Arrays.length(arguments) != 3) {
    printError("usage: narrac explain E0000 | narrac explain --list --json")
    return 2
  }
  const explained = explainCode(arguments[2])
  if (explained is Err(message)) {
    printError(message)
    return 1
  }
  writeStandardOutput(explained.value)
  return 0
}

function findMissingEntries(package: Package, checker: Checker): Array<Diagnostic> uses alloc {
  let diagnostics: Array<Diagnostic> = []
  for (const binary of Arrays.values(package.binaries)) {
    let found = false
    for (const entry of Arrays.values(checker.entries)) {
      if (entry.binary == binary.name && entry.funcIndex >= 0) {
        found = true
      }
    }
    if (found) {
      continue
    }
    if (package.single) {
      Arrays.push(mutable diagnostics, Diagnostic {
        code: "E0419",
        file: package.modules[Arrays.length(package.modules) - 1].file,
        line: 0,
        column: 0,
        message: "no entry function; declare `export function run(args: Array<string>): int`",
      })
    } else {
      const #[modulePath, functionName] = Modules.entryModule(package, binary.entry)
      Arrays.push(mutable diagnostics, Diagnostic {
        code: "E0420",
        file: "narra.toml",
        line: 0,
        column: 0,
        message: `binary ${quoteGo(binary.name)}: no entry function ${quoteGo(binary.entry)}; declare \`export function ${functionName}(args: Array<string>): int\` in module ${quoteGo(modulePath)}`,
      })
    }
  }
  return diagnostics
}
