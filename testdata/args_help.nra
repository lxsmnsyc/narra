// std/args: the help of a command and of a subcommand, from -h and --help.
// A flag value styled with escape codes keeps the columns aligned.
import * as Args from "std/args"
import { Command, Flag, Rest, ArgsError } from "std/args"
import * as Terminal from "std/terminal"

const TOOL = Command {
  name: "narrac",
  summary: "The Narra compiler.",
  flags: [Flag { name: "verbose", short: "v", help: "print each step" }],
  commands: [
    Command {
      name: "build",
      summary: "Build a program.",
      flags: [
        Flag { name: "release", help: "build with optimizations" },
        Flag { name: "output", short: "o", value: "path", help: "where to write the binary" },
        Flag { name: "filter", value: "name", repeated: true, help: "keep matching tests" },
        Flag { name: "quiet", short: "q" },
      ],
      positionals: ["file"],
    },
    Command {
      name: "run",
      summary: "Build and run a program.",
      positionals: ["file"],
      rest: Rest.Raw,
    },
    Command { name: "version" },
  ],
}

function showHelp(arguments: Array<string>) uses io, alloc {
  const parsed = Args.parse(TOOL, arguments)
  if (parsed is Err(ArgsError.Help(path))) {
    print(Args.help(TOOL, path))
    return
  }
  print("no help")
}

function showStyledHelp() uses io, alloc {
  const styled = Command {
    name: "fmt",
    summary: "Format files.",
    flags: [
      Flag { name: "config", short: "c", value: Terminal.bold("path"), help: "read this config" },
      Flag { name: "check", help: "only report" },
    ],
    rest: Rest.Positionals,
  }
  if (Args.parse(styled, ["fmt", "--help"]) is Err(ArgsError.Help(path))) {
    print(Terminal.stripStyles(Args.help(styled, path)))
  }
}

export function run(_args: Array<string>): int uses io, alloc {
  showHelp(["narrac", "--help"])
  showHelp(["narrac", "build", "-h"])
  showHelp(["narrac", "run", "--help"])
  showStyledHelp()
  return 0
}
