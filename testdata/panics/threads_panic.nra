// A panic on a started thread prints its message and ends the process with
// code 101 while the main thread still waits in join.
import * as Thread from "std/thread"
import * as Int from "std/int"

function fail(code: int): int {
  if (code > 0) {
    panic(`thread failed with ${Int.toString(code)}`)
  }
  return code
}

export function run(_args: Array<string>): int {
  const result = Thread.scope((scope) => {
    const worker = Thread.start(scope, () => fail(3))
    return Thread.join(worker)
  })
  print(`not reached ${Int.toString(result)}`)
  return 0
}
