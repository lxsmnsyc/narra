// error: Dynamic.of needs an expected Dynamic<Trait> type
trait Drawable {
  function draw(value: Self): string
}

struct Circle implements Drawable {
  radius: int
}

implement Drawable for Circle {
  function draw(_value: Circle): string {
    return "circle"
  }
}

export function run(_args: Array<string>): int {
  const circle = Circle { radius: 1 }
  const item = Dynamic.of(circle)
  const wrong: Dynamic<Drawable> = Dynamic.of(3)
  const two: Dynamic<Drawable> = Dynamic.of(circle, circle)
  const other: Dynamic<Drawable> = Dynamic.from(circle)
  const shown: Dynamic<Show> = Dynamic.of(circle)
  print(Show.show(Drawable.draw(Dynamic.of(circle))))
  return 0
}
