import * as Int from "std/int"

export opaque struct Range {
  start: int
  finish: int
}

export opaque struct Label {
  text: string
  tags: Array<string>
}

export distinct type UserId = int
export distinct type Title = string
export opaque distinct type Handle = int

export function create(start: int, finish: int): Result<Range, string> uses alloc {
  if (start > finish) {
    return Err("start is after finish")
  }
  return Ok(Range { start: start, finish: finish })
}

export function length(r: Range): int {
  return r.finish - r.start
}

export function widen(r: Range, by: int): Range {
  return Range { ...r, finish: r.finish + by }
}

export function label(text: string): Label uses alloc {
  return Label { text: text, tags: [text, text] }
}

export function describe(l: Label): string uses alloc {
  return `${l.text}/${Int.toString(Array.length(l.tags))}`
}

export function open(n: int): Handle {
  return Handle.from(n * 2)
}

export function slot(h: Handle): int {
  return Handle.toInt(h)
}
