// The narra.toml reader, ported from compiler/internal/narra/modules_toml.go.
// It reads the same subset of TOML: tables, arrays of tables, `key = value`
// with basic or literal strings and arrays of strings, and comments. Bytes
// are compared as in Go; whitespace is ASCII only (Str.trim).
import { splitString, substring } from "narrac/driver/textops"
import * as Str from "std/string"
import { quoteGo } from "narrac/syntax/parser"
import { Fix } from "narrac/driver/fixes"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export struct Binary {
  name: string
  entry: string // "cli.run": module path inside the package, then the function
}

export struct Dependency {
  name: string // the key in [dependencies], also the import path prefix
  git: string // a URL or a local path
  version: string // "1.2.0": the minimum version, tag "v1.2.0"
  line: int // narra.toml line, for diagnostics
}

export struct ExportEntry {
  key: string // the import path other packages write: the package name or `<name>/...`
  file: string // "src/streaming/reader.nra": the module file the key stands for
  line: int // narra.toml line, for diagnostics
}

export struct Manifest {
  name: string
  version: string
  binaries: Array<Binary>
  search: Array<string>
  dependencies: Array<Dependency>
  overrides: Array<Dependency> // [overrides]: read for every manifest, allowed in the root of a build only
  exports: Array<ExportEntry> // [exports]: empty when the package exposes every module
}

// An error of the loader. An empty file and line 0 print as a bare message
// (the Go error was not a diagnostic).
export struct LoadError {
  code: string // "" for an error that is not a diagnostic
  file: string
  line: int
  column: int
  message: string
  fixes: Array<Fix> = []
}

enum Value {
  VStr(text: string)
  VList(items: Array<string>)
  VTable(keys: Array<string>, values: Array<string>)
}

const QUOTE = 34
const APOSTROPHE = 39
const BACKSLASH = 92
const HASH = 35
const OPEN = 91
const CLOSE = 93
const COMMA = 44

function createError(line: int, code: string, message: string): LoadError {
  return LoadError { code, file: "narra.toml", line, column: 1, message }
}

export function parseManifest(text: string): Result<Manifest, LoadError> uses alloc {
  let name = ""
  let version = ""
  let dependencies: Array<Dependency> = []
  let overrides: Array<Dependency> = []
  let exports: Array<ExportEntry> = []
  let binaries: Array<Binary> = []
  let search: Array<string> = []
  let table = ""
  let inBinary = false
  let binaryName = ""
  let binaryEntry = ""
  const lines = splitString(text, "\n")
  let index = 0
  while (index < Arrays.length(lines)) {
    const lineNumber = index + 1
    const line = Str.trim(stripComment(lines[index]))
    index++
    if (line == "") {
      continue
    }
    if (Str.startsWith(line, "[[")) {
      if (!Str.endsWith(line, "]]")) {
        return Err(createError(lineNumber, "E0405", "expected `]]`"))
      }
      if (inBinary) {
        Arrays.push(mutable binaries, Binary { name: binaryName, entry: binaryEntry })
      }
      table = `[[${Str.trim(substring(line, 2, Str.length(line) - 2))}]]`
      inBinary = table == "[[binary]]"
      binaryName = ""
      binaryEntry = ""
      continue
    }
    if (Str.startsWith(line, "[")) {
      if (!Str.endsWith(line, "]")) {
        return Err(createError(lineNumber, "E0406", "expected `]`"))
      }
      if (inBinary) {
        Arrays.push(mutable binaries, Binary { name: binaryName, entry: binaryEntry })
        inBinary = false
      }
      table = Str.trim(substring(line, 1, Str.length(line) - 1))
      continue
    }
    const known =
      table == "package" ||
        table == "link" ||
        table == "dependencies" ||
        table == "overrides" ||
        table == "exports" ||
        table == "[[binary]]"
    const equalsIndex = Str.indexOf(line, "=")
    if (equalsIndex is None) {
      if (!known) {
        continue
      }
      return Err(createError(lineNumber, "E0408", "expected `key = value`"))
    }
    const equalsAt = equalsIndex.value
    const key = Str.trim(substring(line, 0, equalsAt))
    let raw = Str.trim(Str.sliceFrom(line, equalsAt + 1))
    // An array may continue over several lines.
    while (Str.startsWith(raw, "[") && !isClosedArray(raw) && index < Arrays.length(lines)) {
      raw = `${raw} ${Str.trim(stripComment(lines[index]))}`
      index++
    }
    if (!known) {
      continue
    }
    const parsed = parseValue(raw)
    if (parsed is Err(error)) {
      if (table == "dependencies" || table == "overrides") {
        return Err(
          createError(
            lineNumber,
            "E0435",
            `dependency ${key} is not a valid inline table: ${error}`,
          ),
        )
      }
      return Err(createError(lineNumber, "E0409", `${key}: ${error}`))
    }
    const value = parsed.value
    const qualifiedKey = `${table}.${key}`
    if (table == "exports") {
      const entry = readExport(key, value, lineNumber)
      if (entry is Err(error)) {
        return Err(error)
      }
      Arrays.push(mutable exports, entry.value)
      continue
    }
    if (table == "dependencies" || table == "overrides") {
      const dependency = readDependency(key, value, lineNumber)
      if (dependency is Err(error)) {
        return Err(error)
      }
      if (table == "overrides") {
        Arrays.push(mutable overrides, dependency.value)
      } else {
        Arrays.push(mutable dependencies, dependency.value)
      }
      continue
    }
    if (qualifiedKey == "package.version") {
      if (value is Value.VStr(versionText)) {
        if (!isVersion(versionText)) {
          return Err(
            createError(
              lineNumber,
              "E0431",
              `version ${quoteGo(versionText)} is not MAJOR.MINOR.PATCH`,
            ),
          )
        }
        version = versionText
        continue
      }
      return Err(createError(lineNumber, "E0412", `${key} must be a string`))
    }
    if (qualifiedKey == "package.name") {
      if (value is Value.VStr(packageName)) {
        if (isValidPackageName(packageName)) {
          if (packageName == "std") {
            return Err(
              createError(
                lineNumber,
                "E0411",
                "package name \"std\" is reserved for the standard library",
              ),
            )
          }
          name = packageName
          continue
        }
      }
      return Err(
        createError(
          lineNumber,
          "E0410",
          "package name must be a string of letters, digits and `_`, starting with a letter",
        ),
      )
    }
    if (qualifiedKey == "[[binary]].name" || qualifiedKey == "[[binary]].entry") {
      if (value is Value.VStr(stringValue)) {
        if (key == "name") {
          binaryName = stringValue
        } else {
          binaryEntry = stringValue
        }
        continue
      }
      return Err(createError(lineNumber, "E0412", `${key} must be a string`))
    }
    if (qualifiedKey == "link.search") {
      if (value is Value.VList(items)) {
        search = items
        continue
      }
      return Err(createError(lineNumber, "E0413", `${key} must be an array of strings`))
    }
    // The libraries come from the `from` of extern blocks, so [link] holds only search.
    if (table == "link") {
      return Err(
        createError(lineNumber, "E1000", `unknown key ${key} in [link]; [link] takes search`),
      )
    }
  }
  if (inBinary) {
    Arrays.push(mutable binaries, Binary { name: binaryName, entry: binaryEntry })
  }
  if (name == "") {
    return Err(createError(0, "E0414", "[package] needs a name"))
  }
  let seen: Map<string, bool> = Map {}
  for (const binary of Arrays.values(binaries)) {
    if (binary.name == "" || binary.entry == "") {
      return Err(
        createError(0, "E0415", "each [[binary]] needs a name and an entry such as \"cli.run\""),
      )
    }
    if (seen[binary.name] is Some(_)) {
      return Err(
        createError(0, "E0416", `two [[binary]] entries are named ${quoteGo(binary.name)}`),
      )
    }
    seen[binary.name] = true
  }
  for (const group of Arrays.values([dependencies, overrides])) {
    const checked = checkDependencyNames(group, name)
    if (checked is Err(error)) {
      return Err(error)
    }
  }
  const checkedExports = checkExportKeys(exports, name)
  if (checkedExports is Err(error)) {
    return Err(error)
  }
  return Ok(Manifest {
    name,
    version,
    binaries,
    search,
    dependencies,
    overrides,
    exports,
  })
}

function readExport(
  key: string,
  value: Value,
  line: int,
): Result<ExportEntry, LoadError> uses alloc {
  let exportKey = key
  if (Str.startsWith(key, "\"") || Str.startsWith(key, "'")) {
    const parsedKey = parseString(key)
    if (parsedKey is Err(error)) {
      return Err(createError(line, "E0471", `export key ${key}: ${error}`))
    }
    exportKey = parsedKey.value[0]
  }
  if (value is Value.VStr(file)) {
    if (!Str.startsWith(file, "src/") || !Str.endsWith(file, ".nra") || Str.length(file) <= 8) {
      return Err(
        createError(
          line,
          "E0471",
          `export ${quoteGo(exportKey)} names ${quoteGo(file)}, which is not a module file; write a path such as "src/index.nra"`,
        ),
      )
    }
    return Ok(ExportEntry { key: exportKey, file, line })
  }
  return Err(
    createError(
      line,
      "E0471",
      `export ${quoteGo(exportKey)} must be a string, the module file such as "src/index.nra"`,
    ),
  )
}

function isExportKey(key: string, packageName: string): bool uses alloc {
  if (key == packageName) {
    return true
  }
  const prefix = `${packageName}/`
  return Str.startsWith(key, prefix) && Str.length(key) > Str.length(prefix)
}

function checkExportKeys(
  entries: Array<ExportEntry>,
  packageName: string,
): Result<bool, LoadError> uses alloc {
  let keys: Map<string, bool> = Map {}
  for (const entry of Arrays.values(entries)) {
    if (!isExportKey(entry.key, packageName)) {
      return Err(
        createError(
          entry.line,
          "E0470",
          `export key ${quoteGo(entry.key)} must be the package name ${quoteGo(packageName)} or start with ${quoteGo(`${packageName}/`)}`,
        ),
      )
    }
    if (keys[entry.key] is Some(_)) {
      return Err(createError(entry.line, "E0472", `two exports are named ${quoteGo(entry.key)}`))
    }
    keys[entry.key] = true
  }
  return Ok(true)
}

function checkDependencyNames(
  group: Array<Dependency>,
  packageName: string,
): Result<bool, LoadError> uses alloc {
  let names: Map<string, bool> = Map {}
  for (const dependency of Arrays.values(group)) {
    if (dependency.name == "std" || dependency.name == packageName) {
      return Err(
        createError(
          dependency.line,
          "E0433",
          `a dependency cannot be named ${quoteGo(dependency.name)}: it is the standard library or this package`,
        ),
      )
    }
    if (names[dependency.name] is Some(_)) {
      return Err(
        createError(
          dependency.line,
          "E0434",
          `two dependencies are named ${quoteGo(dependency.name)}`,
        ),
      )
    }
    names[dependency.name] = true
  }
  return Ok(true)
}

function readDependency(
  key: string,
  value: Value,
  line: int,
): Result<Dependency, LoadError> uses alloc {
  if (!isValidPackageName(key)) {
    return Err(
      createError(
        line,
        "E0436",
        `dependency name ${quoteGo(key)} must be letters, digits and \`_\`, starting with a letter`,
      ),
    )
  }
  if (value is Value.VTable(keys, values)) {
    let git = ""
    let version = ""
    let seenGit = false
    let seenVersion = false
    for (const index of Ranges.between(0, Arrays.length(keys))) {
      const field = keys[index]
      if (field == "git" && !seenGit) {
        git = values[index]
        seenGit = true
      } else if (field == "version" && !seenVersion) {
        version = values[index]
        seenVersion = true
      } else {
        return Err(
          createError(
            line,
            "E0432",
            `dependency ${key} has an unknown or repeated key ${quoteGo(field)}; it takes git and version`,
          ),
        )
      }
    }
    if (git == "" || version == "") {
      return Err(createError(line, "E0430", `dependency ${key} needs a git and a version`))
    }
    if (!isVersion(version)) {
      return Err(createError(line, "E0431", `version ${quoteGo(version)} is not MAJOR.MINOR.PATCH`))
    }
    return Ok(Dependency { name: key, git, version, line })
  }
  return Err(
    createError(
      line,
      "E0435",
      `dependency ${key} is not a valid inline table: expected { git = "...", version = "1.2.0" }`,
    ),
  )
}

export function isVersion(text: string): bool {
  const length = Str.length(text)
  let parts = 0
  let digits = 0
  for (const index of Ranges.between(0, length)) {
    const code = Str.byteAt(text, index)
    if (code >= 48 && code <= 57) {
      digits++
    } else if (code == 46 && digits > 0) {
      parts++
      digits = 0
    } else {
      return false
    }
  }
  return parts == 2 && digits > 0
}

function isValidPackageName(name: string): bool {
  const length = Str.length(name)
  if (length == 0 || !isLetter(Str.byteAt(name, 0))) {
    return false
  }
  for (const index of Ranges.between(0, length)) {
    const code = Str.byteAt(name, index)
    if (!(code == 95 || isLetter(code) || (code >= 48 && code <= 57))) {
      return false
    }
  }
  return true
}

function isLetter(code: int): bool {
  return (code >= 97 && code <= 122) || (code >= 65 && code <= 90)
}

export function stripComment(line: string): string uses alloc {
  let quote = 0
  let index = 0
  const length = Str.length(line)
  while (index < length) {
    const code = Str.byteAt(line, index)
    if (quote != 0) {
      if (code == BACKSLASH && quote == QUOTE) {
        index++
      } else if (code == quote) {
        quote = 0
      }
    } else if (code == QUOTE || code == APOSTROPHE) {
      quote = code
    } else if (code == HASH) {
      return substring(line, 0, index)
    }
    index++
  }
  return line
}

function isClosedArray(text: string): bool {
  let depth = 0
  let quote = 0
  let index = 0
  const length = Str.length(text)
  while (index < length) {
    const code = Str.byteAt(text, index)
    if (quote != 0) {
      if (code == BACKSLASH && quote == QUOTE) {
        index++
      } else if (code == quote) {
        quote = 0
      }
    } else if (code == QUOTE || code == APOSTROPHE) {
      quote = code
    } else if (code == OPEN) {
      depth++
    } else if (code == CLOSE) {
      depth--
    }
    index++
  }
  return depth == 0
}

function parseValue(text: string): Result<Value, string> uses alloc {
  if (Str.startsWith(text, "{")) {
    return parseInlineTable(text)
  }
  if (Str.startsWith(text, "[")) {
    let items: Array<string> = []
    let rest = Str.trim(Str.sliceFrom(text, 1))
    while (true) {
      if (Str.startsWith(rest, "]")) {
        if (Str.trim(Str.sliceFrom(rest, 1)) != "") {
          return Err("unexpected text after the array")
        }
        return Ok(Value.VList(items))
      }
      const parsed = parseString(rest)
      if (parsed is Err(error)) {
        return Err(error)
      }
      const #[item, consumed] = parsed.value
      Arrays.push(mutable items, item)
      rest = Str.trim(Str.sliceFrom(rest, consumed))
      if (Str.startsWith(rest, ",")) {
        rest = Str.trim(Str.sliceFrom(rest, 1))
      } else if (!Str.startsWith(rest, "]")) {
        return Err("expected `,` or `]` in the array")
      }
    }
  }
  const parsed = parseString(text)
  if (parsed is Err(error)) {
    return Err(error)
  }
  const #[item, consumed] = parsed.value
  if (Str.trim(Str.sliceFrom(text, consumed)) != "") {
    return Err("unexpected text after the string")
  }
  return Ok(Value.VStr(item))
}

export function parseString(text: string): Result<#[string, int], string> uses alloc {
  const length = Str.length(text)
  if (length == 0 || (Str.byteAt(text, 0) != QUOTE && Str.byteAt(text, 0) != APOSTROPHE)) {
    return Err("expected a string")
  }
  const quote = Str.byteAt(text, 0)
  let builder = Str.builder()
  let index = 1
  while (index < length) {
    const code = Str.byteAt(text, index)
    if (code == quote) {
      return Ok(#[Str.build(builder), index + 1])
    }
    if (code == BACKSLASH && quote == QUOTE && index + 1 < length) {
      index++
      const escaped = Str.byteAt(text, index)
      if (escaped == 110) {
        Str.append(mutable builder, "\n")
      } else if (escaped == 116) {
        Str.append(mutable builder, "\t")
      } else if (escaped == QUOTE || escaped == BACKSLASH) {
        Str.append(mutable builder, substring(text, index, index + 1))
      } else {
        // Go prints %code of the byte; for a non-ASCII lead byte this is its
        // Latin-1 character, which the dump tests do not exercise.
        return Err(`unsupported escape \\${substring(text, index, index + 1)}`)
      }
      index++
      continue
    }
    // Copy a whole character so multi-byte text stays valid.
    const next = Str.nextChar(text, index)
    Str.append(mutable builder, substring(text, index, next))
    index = next
  }
  return Err("unterminated string")
}

function parseInlineTable(text: string): Result<Value, string> uses alloc {
  let keys: Array<string> = []
  let values: Array<string> = []
  let rest = Str.trim(Str.sliceFrom(text, 1))
  let afterComma = false
  while (true) {
    if (Str.startsWith(rest, "}")) {
      if (afterComma) {
        return Err("a trailing comma is not allowed in an inline table")
      }
      if (Str.trim(Str.sliceFrom(rest, 1)) != "") {
        return Err("unexpected text after the table")
      }
      return Ok(Value.VTable(keys, values))
    }
    const equalsIndex = Str.indexOf(rest, "=")
    if (equalsIndex is None) {
      return Err("expected `key = value` in the table")
    }
    const key = Str.trim(substring(rest, 0, equalsIndex.value))
    if (key == "") {
      return Err("expected a key in the table")
    }
    const parsed = parseString(Str.trim(Str.sliceFrom(rest, equalsIndex.value + 1)))
    if (parsed is Err(error)) {
      return Err(error)
    }
    const #[item, consumed] = parsed.value
    Arrays.push(mutable keys, key)
    Arrays.push(mutable values, item)
    rest = Str.trim(Str.sliceFrom(Str.trim(Str.sliceFrom(rest, equalsIndex.value + 1)), consumed))
    afterComma = false
    if (Str.startsWith(rest, ",")) {
      rest = Str.trim(Str.sliceFrom(rest, 1))
      afterComma = true
    } else if (!Str.startsWith(rest, "}")) {
      return Err("expected `,` or `}` in the table")
    }
  }
}
