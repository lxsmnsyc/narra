// A stream whose values need no wait gives them without a loop turn: a then
// callback registered on a finished task before the reads runs only after
// them, on the next turn of the loop.
import * as Async from "std/async"
import * as Int from "std/int"

async function* ready(): AsyncGenerator<int> {
  yield 1
  yield 2
  yield 3
}

export async function run(_args: Array<string>): int {
  const finished = async {
    return 0
  }
  Async.then(finished, (_value) => print("then callback runs"))
  const stream = ready()
  let total = 0
  while (true) {
    const next = await Async.next(stream)
    if (next is Some(value)) {
      print(`value ${Int.toString(value)}`)
      total += value
    } else {
      break
    }
  }
  print(`total ${Int.toString(total)} before the loop turns`)
  await Async.idle()
  print("after idle")
  return 0
}
