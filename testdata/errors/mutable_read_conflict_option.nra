// error: mutable_read_conflict_option.nra:16:14: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function clear(mutable v: Option<int>): int {
  v = None
  return 0
}

function add(a: int, b: int): int {
  return a + b
}

export function run(args: Array<string>): int {
  let x: Option<int> = Some(1)
  if (x is None) {
    return 0
  }
  return add(x.value, clear(mutable x))
}
