import * as Arrays from "std/array"
import * as Int from "std/int"

struct Point {
  x: int
  y: int
}

function first(value: int, _ignored: int): int {
  return value
}

function sum(points: Array<Point>): int {
  let total = 0
  for (const { x, y: _y } of Arrays.values(points)) {
    total = total + x
  }
  return total
}

export function run(args: Array<string>): int {
  const _unused = 1
  const #[kept, _dropped] = #[2, 3]
  const callback = (_event: int) => 5
  print(
    `${Int.toString(first(kept, 9))} ${Int.toString(sum([Point { x: 1, y: 2 }, Point { x: 4, y: 8 }]))} ${Int.toString(callback(0))}`,
  )
  return 0
}
