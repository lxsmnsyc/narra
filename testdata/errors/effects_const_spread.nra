// error: expected (int) => int, found (int) => int uses io
function quiet(v: int): int {
  return v + 1
}

function loud(v: int): int uses io {
  print("loud")
  return v
}

struct Table {
  quiet: (v: int) => int
  loud: (v: int) => int uses io
}

const table = Table { quiet: quiet, loud: loud }
const noisy = Table { ...table, quiet: loud }

export function pure(): int {
  return noisy.quiet(2)
}

export function run(args: Array<string>): int uses io {
  return pure()
}
