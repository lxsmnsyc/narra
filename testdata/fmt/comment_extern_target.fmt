import { Os, Arch } from "std/build"

// lead: above the attribute
@target(os = Os.Windows, arch = Arch.X86_64) // after the attribute
extern {
  function GetTickCount64(): u64 // trail: after a member

  @extern("GetTickCount")
  function tickCount(): u32
} from "kernel32" // after the library

@target(os = Os.MacOS)
extern {
  function sqrt(value: f64): f64
} from "m"
