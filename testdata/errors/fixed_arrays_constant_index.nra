// error: index 3 is out of range for FixedArray<int, 3>
const LAST = 2

export function run(_args: Array<string>): int {
  const values: FixedArray<int, 3> = [1, 2, 3]
  const empty: FixedArray<int, 0> = []
  const inside = values[0] + values[LAST] + values[LAST - 1]
  const past = values[3]
  const negative = values[-1]
  const computed = values[LAST + 1]
  const none = empty[0]
  return inside + past + negative + computed + none
}
