// A thread function that returns nothing gives a Thread<void>: join waits for
// it and returns nothing, and a second join does not wait again.
import * as Thread from "std/thread"
import * as Arrays from "std/array"
import * as Int from "std/int"

export function run(_args: Array<string>): int {
  const words = ["one", "two", "three"]
  return Thread.scope((scope) => {
    const worker = Thread.start(scope, () => {
      print(`worker saw ${Int.toString(Arrays.length(words))} words`)
    })
    Thread.join(worker)
    print("joined")
    Thread.join(worker)
    print("joined again")
    Thread.start(scope, () => print("expression body"))
    return 0
  })
}
