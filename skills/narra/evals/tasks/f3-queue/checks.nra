import { addAll, firstOr } from "task/queue"
import * as Test from "std/test"

test "addAll writes to the caller's array" {
  const items = [1]
  addAll(mutable items, [2, 3])
  Test.eq(items, [1, 2, 3])
}

test "firstOr of a filled array" {
  Test.eq(firstOr([7, 8], 0), 7)
}

test "firstOr of an empty array" {
  Test.eq(firstOr([], 5), 5)
}
