// The bench suite: every bench/<name>/<name>.nra must pass `narrac check`, so a
// language change that breaks a benchmark program fails the run, not the
// benchmark run at the end of a batch.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"
import * as Files from "testrunner/files"

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  const folder = Path.join(context.repository, "bench")
  for (const name of Arrays.values(Files.listNames(folder))) {
    const path = Path.join(Path.join(folder, name), `${name}.nra`)
    if (Fs.exists(path)) {
      Arrays.push(mutable cases, TestCase {
        suite: "bench",
        name: name,
        path: path,
        variant: "check",
      })
    }
  }
  return cases
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  const result = Common.runNarrac(context, ["check", testCase.path])
  if (result.code != 0) {
    return Err(`want a clean check, got ${Common.describeRun(result)}`)
  }
  return Ok(true)
}
