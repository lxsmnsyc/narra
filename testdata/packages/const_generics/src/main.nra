// Constant type arguments on a function and a struct of another module.
import * as Int from "std/int"
import * as Text from "p/text"
import { Grid, repeat } from "p/text"

export function run(_args: Array<string>): int {
  print(repeat<3>("ab"))
  print(Text.repeat<2>("cd"))
  const grid: Grid<4> = Grid { cells: [] }
  const other: Text.Grid<5> = Grid<5> { cells: [] }
  print(Int.toString(Text.size(grid) + Text.size(other)))
  return 0
}
