import * as Int from "std/int"

struct Counter {
  n: int
}

function bump(mutable counter: Counter): int {
  counter.n = counter.n + 10
  return 1
}

function pair(a: int, b: int): int {
  return a * 100 + b
}

function describe(mutable counter: Counter, flag: bool): string {
  counter.n = counter.n + 1
  if (flag) {
    return "yes"
  }
  return "no"
}

export function run(args: Array<string>): int {
  // Two mutable calls on different variables in one expression.
  const a = Counter { n: 1 }
  const b = Counter { n: 2 }
  const first = pair(bump(mutable a), bump(mutable b))
  print(Int.toString(first))
  print(Int.toString(a.n))
  print(Int.toString(b.n))

  // The left side of && finishes before the right side starts.
  const c = Counter { n: 0 }
  if (c.n == 0 && bump(mutable c) == 1) {
    print(Int.toString(c.n))
  }

  // Different arms of a match never run together.
  const d = Counter { n: 5 }
  const label = match (a.n) { 11 => describe(mutable d, true), _ => describe(mutable d, false) }
  print(label)
  print(Int.toString(d.n))

  // A mutable call in its own statement, then the read.
  const e = Counter { n: 1 }
  const result = bump(mutable e)
  print(Int.toString(e.n + result))

  // Sibling arms with blocks, and statements one after the other in a block.
  const g = Counter { n: 1 }
  const flag: Option<int> = Some(1)
  match (flag) {
    Some(v) => {
      bump(mutable g)
      print(Int.toString(g.n + v))
    }
    None => {
      bump(mutable g)
    }
  }
  return 0
}
