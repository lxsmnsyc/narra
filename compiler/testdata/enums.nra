import * as Int from "std/int"
import * as Float from "std/float"
import * as Arrays from "std/array"

enum Shape {
  Circle(radius: f64)
  Rect(width: f64, height: f64)
  Dot
}

enum Token {
  Word(text: string)
  Number(value: int)
  Space
}

function area(s: Shape): f64 {
  return match (s) {
    Circle(r) => 3.0 * r * r
    Rect(w, h) => w * h
    Dot => 0.0
  }
}

function show(t: Token): string {
  return match (t) {
    Word(text) => `word ${text}`
    Number(n) if (n < 0) => "negative"
    Number(n) => `number ${Int.toString(n)}`
    Space => "space"
  }
}

export function run(args: Array<string>): int {
  print(Float.toString(area(Circle(2.0))))
  print(Float.toString(area(Shape.Rect(2.0, 3.0))))
  print(Float.toString(area(Dot)))
  const tokens: Array<Token> = [Word("hi"), Number(-3), Number(42), Space]
  for (const t of Arrays.values(tokens)) {
    print(show(t))
  }
  match (tokens[0]) {
    Word(text) => {
      print(`first is ${text}`)
    }
    _ => print("other")
  }
  return 0
}
