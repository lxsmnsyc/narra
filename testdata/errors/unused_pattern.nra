// error: unused_pattern.nra:9:18: "height" is never read; remove it, or name it "_height" to mark it as unused on purpose
struct Size {
  width: int
  height: int
}

export function run(args: Array<string>): int {
  const size = Size { width: 3, height: 4 }
  const { width, height } = size
  return width
}
