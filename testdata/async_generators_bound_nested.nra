// A stream that names the callee's effect variable inside the result type is
// charged the effects of the argument that binds the variable.
import * as Async from "std/async"
import * as Int from "std/int"

async function* lines(): AsyncGenerator<int> uses (io, alloc) {
  print("read")
  yield 1
  yield 2
}

async function* relay<effect E>(
  source: AsyncGenerator<int> uses E,
): AsyncGenerator<int> uses (E, alloc) {
  yield* source
}

export function wrap<effect E>(
  source: AsyncGenerator<int> uses E,
): Option<AsyncGenerator<int> uses E> uses alloc {
  return Some(relay(source))
}

export async function loud(): int uses io, alloc {
  let total = 0
  if (wrap(lines()) is Some(stream)) {
    while (true) {
      const next = await Async.next(stream)
      if (next is Some(value)) {
        total = total + value
      } else {
        break
      }
    }
  }
  return total
}

export async function run(_args: Array<string>): int {
  print(Int.toString(await loud()))
  return 0
}
