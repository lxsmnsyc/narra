import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Maps from "std/map"
import * as Ranges from "std/range"

struct Tagged<T: Equatable & Hashable & Show> implements Equatable, Hashable, Ordered, Show {
  tag: int
  value: T
}

implement Equatable for Tagged<T> {
  function equals(a: Tagged<T>, b: Tagged<T>): bool {
    return a.tag == b.tag
  }
}

implement Hashable for Tagged<T> {
  function hash(value: Tagged<T>): int {
    return value.tag
  }
}

implement Ordered for Tagged<T> {
  function compare(a: Self, b: Self): Ordering {
    return Int.compare(b.tag, a.tag)
  }
}

implement Show for Tagged<T> {
  function show(value: Tagged<T>): string {
    const copied: Self = Tagged { tag: value.tag, value: value.value }
    return `#${Int.toString(copied.tag)} ${Show.show(copied.value)}`
  }
}

struct Holder derives Ordered {
  item: Tagged<int>
}

function findFirst<T: Equatable>(items: Array<T>, wanted: T): int {
  for (const i of Ranges.between(0, Arrays.length(items))) {
    if (items[i] == wanted) {
      return i
    }
  }
  return -1
}

export function run(_args: Array<string>): int {
  const first = Tagged { tag: 1, value: "one" }
  const other = Tagged { tag: 1, value: "uno" }
  print(Show.show(first == other))
  print(Show.show([first, other]))
  let counts: Map<Tagged<string>, int> = Map {}
  counts[first] = 1
  counts[other] = 2
  print(Int.toString(Maps.size(counts)))
  const low = Holder { item: Tagged { tag: 2, value: 20 } }
  const high = Holder { item: Tagged { tag: 9, value: 90 } }
  print(Show.show(Ordered.compare(low, high)))
  print(Int.toString(findFirst([low.item, high.item], high.item)))
  return 0
}
