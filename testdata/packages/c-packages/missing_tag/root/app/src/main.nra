// Binds the C package c_mini with `from "c_mini/<path>"` and a C file of this package that includes
// the header of c_mini.
import * as I32 from "std/i32"
import { VERSION } from "c_mini/mini"

extern {
  function mini_add(first: i32, second: i32): i32
  function mini_scale(): i32
  function mini_twice(value: i32): i32
  function mini_secret(): i32
} from "c_mini/include/mini.h"

extern {
  function app_glue_sum(first: i32, second: i32): i32
  function app_glue_has_secret(): i32
} from "../glue/glue.c"

@trusted
export function run(_args: Array<string>): int uses alloc {
  unsafe {
    print(`add ${I32.toString(mini_add(2, 3))}`)
    print(`scale ${I32.toString(mini_scale())}`)
    print(`twice ${I32.toString(mini_twice(7))}`)
    print(`own secret ${I32.toString(mini_secret())}`)
    print(`glue ${I32.toString(app_glue_sum(2, 2))}`)
    print(`app secret ${I32.toString(app_glue_has_secret())}`)
  }
  print(`version ${VERSION}`)
  return 0
}
