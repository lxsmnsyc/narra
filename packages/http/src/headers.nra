// http/headers: the header fields of a message.

import * as Arrays from "std/array"
import * as Unicode from "std/unicode"

/// One header field. The name keeps the case it was written in.
export struct Header {
  name: string
  value: string
}

/// The header fields of a message in the order they were added. Names match without regard to
/// case.
export struct Headers {
  entries: Array<Header>
}

/// Headers with no fields.
export function empty(): Headers uses alloc {
  return Headers { entries: [] }
}

/// The value of the first field with the name, or None.
export function get(headers: Headers, name: string): Option<string> uses alloc {
  const wanted = Unicode.toLowerCase(name)
  for (const header of Arrays.values(headers.entries)) {
    if (Unicode.toLowerCase(header.name) == wanted) {
      return Some(header.value)
    }
  }
  return None
}

/// The values of every field with the name, in order.
export function getAll(headers: Headers, name: string): Array<string> uses alloc {
  const wanted = Unicode.toLowerCase(name)
  let values: Array<string> = []
  for (const header of Arrays.values(headers.entries)) {
    if (Unicode.toLowerCase(header.name) == wanted) {
      Arrays.push(mutable values, header.value)
    }
  }
  return values
}

/// Gives the name one field with the value. The first field of the name keeps its place and the
/// others are removed.
export function set(mutable headers: Headers, name: string, value: string) uses alloc {
  const wanted = Unicode.toLowerCase(name)
  let kept: Array<Header> = []
  let replaced = false
  for (const header of Arrays.values(headers.entries)) {
    if (Unicode.toLowerCase(header.name) != wanted) {
      Arrays.push(mutable kept, header)
    } else if (!replaced) {
      Arrays.push(mutable kept, Header { name, value })
      replaced = true
    }
  }
  if (!replaced) {
    Arrays.push(mutable kept, Header { name, value })
  }
  headers.entries = kept
}

/// Removes every field with the name.
export function remove(mutable headers: Headers, name: string) uses alloc {
  const unwanted = Unicode.toLowerCase(name)
  let kept: Array<Header> = []
  for (const header of Arrays.values(headers.entries)) {
    if (Unicode.toLowerCase(header.name) != unwanted) {
      Arrays.push(mutable kept, header)
    }
  }
  headers.entries = kept
}

/// Adds a field at the end, next to any field of the same name.
export function add(mutable headers: Headers, name: string, value: string) uses alloc {
  Arrays.push(mutable headers.entries, Header { name, value })
}
