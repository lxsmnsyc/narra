// std/coroutine: Co.resume runs a generator or a coroutine to its next yield.
//
// The compiler turns `Co.resume(mutable g)` into resumeGenerator and
// `Co.resume(mutable g, input)` into resumeCoroutine, by argument count.

import * as Internal from "std/internal/coroutine"

export enum Step<Out> derives Show, Equatable {
  Yielded(value: Out)
  Done
  Panicked(message: string)
}

export function resumeGenerator<T, effect E>(mutable g: Generator<T> uses E): Step<T> uses E, alloc {
  return readStep(Internal.next(mutable g))
}

export function resumeCoroutine<In, Out, effect E>(mutable g: Coroutine<In, Out> uses E, input: In): Step<Out> uses E, alloc {
  return readStep(Internal.resume(mutable g, input))
}

// readStep reads the outcome of one resume: a value, the end, or a panic.
function readStep<T>(next: Option<T>): Step<T> uses alloc {
  if (next is Some(value)) {
    return Step.Yielded(value)
  }
  if (Internal.panicked()) {
    return Step.Panicked(Internal.panicMessage())
  }
  return Step.Done
}
