// Nested closures, generic functions as values, captured structs and
// enums, and arrow functions inside generic bodies and loops.
import * as Int from "std/int"

struct Point {
  x: int
  name: string
}

function id<T>(v: T): T {
  return v
}

function apply<T>(f: (x: T) => T, x: T): T {
  return f(x)
}

function each(n: int, f: (i: int) => void) {
  for (const i of Range.upTo(n)) {
    f(i)
  }
}

// An arrow function inside a generic body: one C function per instance.
function constant<T>(v: T): () => T {
  return () => v
}

function counterFrom(start: int): (step: int) => (n: int) => int {
  return (step) => (n) => start + step * n
}

export function run(args: Array<string>): int {
  print(Int.toString(apply(id, 7)))
  const name = apply((s: string): string => `<${s}>`, "x")
  print(name)

  const p = Point { x: 4, name: "p" }
  const opt: Option<string> = Some("found")
  const show = (): string => {
    const inner = (k: int): string => `${p.name}${Int.toString(p.x + k)}`
    if (opt is Some(v)) {
      return `${inner(1)} ${v}`
    }
    return inner(0)
  }
  print(show())

  const words = ["a", "b", "c"]
  for (const w of Array.values(words)) {
    each(2, (i) => print(`${w}${Int.toString(i)}`))
  }

  const c = constant("kept")
  const n = constant(3)
  print(`${c()} ${Int.toString(n())}`)

  const from10 = counterFrom(10)
  const by3 = from10(3)
  print(Int.toString(by3(2)))
  print(Int.toString(counterFrom(1)(2)(3)))

  // An arrow with a block body and an inferred result.
  const sign = (x: int) => {
    if (x < 0) {
      return "neg"
    }
    return "pos"
  }
  print(sign(-1))
  return 0
}
