function f(x: int, xs: Array<int>, pairs: Array<#[int, int]>) {
  outer: /* lbl */ for (const item of xs) {
    print(item)
  }
  inner: // line
  while (x > 0) {
    x = x - 1
  }
  both: /* a */ /* b */ for (const #[first, second] of pairs) {
    print(first)
  }
  third: // after the label
  for (let item of xs) {
    print(item)
  }
}
