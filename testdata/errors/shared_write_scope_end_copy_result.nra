// error: Arrays.push(mutable list, ...) may change list, which snapshot still holds until its block ends
// A `const` taken from copy(...) holds its value until its block ends like
// any other: the copy gives no credit to a value nothing else shares, so the
// push would copy the array without a copy(...) to explain it.
import * as Arrays from "std/array"
import * as Int from "std/int"

function makeRows(): Array<Array<int>> uses alloc {
  return [[1], [2]]
}

export function run(_args: Array<string>): int uses io, alloc {
  const snapshot = copy(makeRows())
  let list = snapshot
  Arrays.push(mutable list, [3])
  print(Int.toString(Arrays.length(list)))
  return 0
}
