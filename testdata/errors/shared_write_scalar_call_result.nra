// error: node.pos.line = ... may change node, which start still uses at line 21
struct Pos {
  line: int
  column: int
}

struct Node {
  name: string
  pos: Pos
}

function startOf(node: Node): Pos from node {
  return node.pos
}

export function run(_args: Array<string>): int {
  let node = Node { name: "a", pos: Pos { line: 1, column: 2 } }
  // The result of startOf shares its `from` argument.
  const start = startOf(node)
  node.pos.line = 9
  return start.line + node.pos.line
}
