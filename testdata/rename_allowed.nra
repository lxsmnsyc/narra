import * as Arrays from "std/array"
import * as Int from "std/int"

enum Light {
  Red
  Green
}

function double(value: int): int {
  return value * 2
}

function total(items: Array<int>, point: #[int, int]): int uses alloc {
  const first = items[0]
  const pair = #[1, 2]
  const names = pair
  const again = point
  return first + Arrays.length(items) + names[0] + again[1]
}

export function run(_args: Array<string>): int uses alloc {
  const count = 3
  const amount = count
  const name = "hero"
  const label = name
  const light = Light.Red
  let current = light
  current = Light.Green
  const shown = current == Light.Green
  const pair = #[1, "a"]
  const same = pair
  const handler = double
  const call = handler
  const items = [1, 2, 3]
  const copied = copy(items)
  print(
    `${Int.toString(amount)} ${label} ${Int.toString(same[0])} ${Int.toString(call(2))} ${Int.toString(Arrays.length(copied))}`,
  )
  print(shown ? "green" : "red")
  print(Int.toString(total(items, #[4, 5])))
  return 0
}
