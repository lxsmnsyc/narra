import * as Ranges from "std/range"
import * as Int from "std/int"
import * as Options from "std/option"

function collect(range: Range): string uses alloc {
  let text = ""
  for (const value of range) {
    text = `${text}${Int.toString(value)} `
  }
  return text
}

export function run(args: Array<string>): int uses io, alloc {
  for (const value of Options.withDefault(Ranges.stepped(0, 10, 3), Ranges.upTo(0))) {
    print(Int.toString(value))
  }
  print(collect(Options.withDefault(Ranges.stepped(10, 0, -4), Ranges.upTo(0))))
  print(collect(Options.withDefault(Ranges.stepped(5, 5, 1), Ranges.upTo(0))))
  print(collect(Options.withDefault(Ranges.stepped(5, 0, 1), Ranges.upTo(0))))
  print(collect(Options.withDefault(Ranges.stepped(0, 5, -1), Ranges.upTo(0))))
  print(collect(Ranges.upTo(4)))
  print(collect(Ranges.between(2, 5)))
  let range = Options.withDefault(Ranges.stepped(1, 20, 7), Ranges.upTo(0))
  print(collect(range))
  for (const value of Options.withDefault(
    Ranges.stepped(9223372036854775800, 9223372036854775807, 5),
    Ranges.upTo(0),
  )) {
    print(Int.toString(value))
  }
  for (const value of Options.withDefault(Ranges.stepped(0, 100, 2), Ranges.upTo(0))) {
    if (value == 4) {
      continue
    }
    if (value > 8) {
      break
    }
    print(Int.toString(value))
  }
  return 0
}
