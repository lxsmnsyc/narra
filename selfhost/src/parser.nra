// The parser, ported from compiler/internal/narra/parser.go (and the parse
// half of check_opaque.go). Each function ports the Go function of the same
// name without the parse, create or is prefix (Go's binary is parseBinary,
// Go's tok is currentToken, Go's posOf is getPos). `narrac parse` prints the same AST
// dump as `narra parse`.
//
// Error flow: Go's p.fail panics and file() recovers. Narra has no recover,
// so the first error is kept in Parser.failed. Once it is set, failAt keeps
// the first error, parse functions return dummy nodes, and every loop stops
// (each loop condition starts with isOk(parser)). The caller reads failed and
// throws the tree away.
//
// Node ids: every expression, pattern, parameter, VarStmt and ForStmt gets
// `id` from Parser.nextId when it is built, so a child usually has a smaller
// id than its parent. Ids are unique within one parse call and start at the
// firstId passed to parse; Parsed.nextId is the next free id, so a package
// can number all its files in one sequence. Ids can have gaps (an Ident that
// turns out to be the type name of a struct literal keeps its id unused).
import { substring } from "narrac/textops"
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import {
  LexError,
  Token,
  TokenKind,
  decodeEscape,
  formatLexError,
  lex,
  lexWithComments,
  lexFrom,
  hex,
  SYMBOLS_BY_TEXT,
  SYMBOL_AMPERSAND,
  SYMBOL_AND,
  SYMBOL_ARROW,
  SYMBOL_AT,
  SYMBOL_BANG,
  SYMBOL_CARET,
  SYMBOL_COLON,
  SYMBOL_COMMA,
  SYMBOL_DOT,
  SYMBOL_ELLIPSIS,
  SYMBOL_EQUALS,
  SYMBOL_EQUAL_EQUAL,
  SYMBOL_GREATER,
  SYMBOL_GREATER_EQUAL,
  SYMBOL_HASH_BRACKET,
  SYMBOL_KEYWORD_AS,
  SYMBOL_KEYWORD_ASYNC,
  SYMBOL_KEYWORD_AWAIT,
  SYMBOL_KEYWORD_BREAK,
  SYMBOL_KEYWORD_CONST,
  SYMBOL_KEYWORD_CONTINUE,
  SYMBOL_KEYWORD_DERIVES,
  SYMBOL_KEYWORD_ELSE,
  SYMBOL_KEYWORD_ENUM,
  SYMBOL_KEYWORD_EXPORT,
  SYMBOL_KEYWORD_FALSE,
  SYMBOL_KEYWORD_FOR,
  SYMBOL_KEYWORD_FROM,
  SYMBOL_KEYWORD_FUNCTION,
  SYMBOL_KEYWORD_IF,
  SYMBOL_KEYWORD_IMPLEMENT,
  SYMBOL_KEYWORD_IMPLEMENTS,
  SYMBOL_KEYWORD_IMPORT,
  SYMBOL_KEYWORD_IS,
  SYMBOL_KEYWORD_LET,
  SYMBOL_KEYWORD_MATCH,
  SYMBOL_KEYWORD_MUTABLE,
  SYMBOL_KEYWORD_OF,
  SYMBOL_KEYWORD_RETURN,
  SYMBOL_KEYWORD_STRUCT,
  SYMBOL_KEYWORD_TEST,
  SYMBOL_KEYWORD_TRAIT,
  SYMBOL_KEYWORD_TRUE,
  SYMBOL_KEYWORD_USES,
  SYMBOL_KEYWORD_WHILE,
  SYMBOL_KEYWORD_YIELD,
  SYMBOL_LEFT_BRACE,
  SYMBOL_LEFT_BRACKET,
  SYMBOL_LEFT_PAREN,
  SYMBOL_LESS,
  SYMBOL_LESS_EQUAL,
  SYMBOL_MINUS,
  SYMBOL_NOT_DOUBLE_EQUAL,
  SYMBOL_NOT_EQUAL,
  SYMBOL_OR,
  SYMBOL_PERCENT,
  SYMBOL_PIPE,
  SYMBOL_PLUS,
  SYMBOL_QUESTION,
  SYMBOL_RIGHT_BRACE,
  SYMBOL_RIGHT_BRACKET,
  SYMBOL_RIGHT_PAREN,
  SYMBOL_SEMICOLON,
  SYMBOL_SHIFT_LEFT,
  SYMBOL_SHIFT_RIGHT,
  SYMBOL_SLASH,
  SYMBOL_STAR,
  SYMBOL_TILDE,
  SYMBOL_TRIPLE_EQUAL,
} from "narrac/lexer"
import {
  Trivia,
  Collector,
  createCollector,
  noteNode,
  buildTrivia,
  getPosKey,
  getIdKey,
  getDeclPos,
  getStmtPos,
  getExprId,
  getPatternId,
} from "narrac/trivia"
import {
  Pos,
  File,
  ImportDecl,
  ImportName,
  TypeExpr,
  Param,
  FuncDecl,
  ConstDecl,
  FieldDecl,
  StructDecl,
  DistinctDecl,
  AliasDecl,
  VariantDecl,
  EnumDecl,
  TestDecl,
  Attribute,
  AttributeArgument,
  ExternBlock,
  TraitDecl,
  ImplDecl,
  Decl,
  Block,
  Arg,
  FieldInit,
  FieldPattern,
  MatchArm,
  Stmt,
  Expr,
  Pattern,
  YieldBinding,
  LoopReference,
  SourceFacts,
  DotUse,
  TemplatePart,
  TemplatePartError,
  createEmptyFacts,
} from "narrac/ast"
import {
  Fix,
  createFix,
  createEdit,
  insertAt,
  moveColumn,
  buildRemoveSemicolonFix,
} from "narrac/fixes"
import * as Arrays from "std/array"
import * as Boxes from "std/box"
import * as Ranges from "std/range"
import * as Maps from "std/map"

// A syntax error: `error <line>:<col>: <message>` in the dump.
export struct Diagnostic {
  code: string
  pos: Pos
  message: string
  fixes: Array<Fix> = []
}

export struct Parsed {
  file: File
  nextId: int // the first id not used by file
}

struct Parser {
  tokens: Array<Token>
  index: int
  nextId: int
  failed: Option<Diagnostic>
  // ternaryIds holds the ids of the block expressions that `c ? a : b` produced.
  ternaryIds: Array<int>
  // collector keeps the node ranges for parseWithTrivia; it does nothing
  // unless it is enabled.
  collector: Collector
  // typeNames are the type parameters of the declaration being parsed. A
  // lowercase one still counts as a type in `id<t>(x)`.
  typeNames: Array<string>
  // facts are the side tables for fixes; parse completes them with the source
  // facts (finishFacts). resultFunction is set inside a function declared to
  // return Result, where `throw x` can become `return Err(x)`.
  facts: SourceFacts
  resultFunction: bool
  // The token index where the expression statement being parsed begins;
  // only an expression that starts there can end in `+=` or `++`.
  statementStart: int
  // Set between the parentheses of a C-style for, the one place a `;` belongs.
  forHead: bool = false
  // Set while an `ensures` pattern is parsed, the one place a comparison pattern belongs.
  contractPattern: bool = false
}

// The type parameters of `<A, B: Show & Ordered, effect E, const N: int>`.
// constants names the `const` ones, which names holds too.
struct TypeParams {
  names: Array<string>
  bounds: Array<Array<TypeExpr>>
  effects: Array<string>
  constants: Array<string>
}

struct TraitLists {
  implementations: Array<TypeExpr>
  derived: Array<TypeExpr>
}

// Operator precedence, lowest first.
const BINARY_LEVELS = [
  [SYMBOL_OR],
  [SYMBOL_AND],
  [SYMBOL_EQUAL_EQUAL, SYMBOL_NOT_EQUAL],
  [SYMBOL_LESS, SYMBOL_LESS_EQUAL, SYMBOL_GREATER, SYMBOL_GREATER_EQUAL],
  [SYMBOL_PIPE],
  [SYMBOL_CARET],
  [SYMBOL_AMPERSAND],
  [SYMBOL_SHIFT_LEFT, SYMBOL_SHIFT_RIGHT],
  [SYMBOL_PLUS, SYMBOL_MINUS],
  [SYMBOL_STAR, SYMBOL_SLASH, SYMBOL_PERCENT],
]

const COMPOUND_OPERATORS = ["+", "-", "*", "/", "%", "&", "|", "^", "<<", ">>"]

// `x is Pattern` binds tighter than == and looser than < and +.
const IS_LEVEL = 2

export function parse(source: string, firstId: int): Result<Parsed, Diagnostic> uses alloc {
  let parser = Parser {
    tokens: [],
    index: 0,
    nextId: firstId,
    failed: None,
    ternaryIds: [],
    collector: createCollector(false),
    typeNames: [],
    facts: createEmptyFacts(),
    resultFunction: false,
    statementStart: 0 - 1,
  }
  if (readTokens(mutable parser, source) is Some(error)) {
    return Err(error)
  }
  const file = parseFile(mutable parser)
  if (parser.failed is Some(diagnostic)) {
    return Err(diagnostic)
  }
  const facts = finishFacts(parser, source)
  return Ok(Parsed { file: File { ...file, facts: facts }, nextId: parser.nextId })
}

function readTokens(mutable parser: Parser, source: string): Option<Diagnostic> {
  // The lexer's result is released on return, so the parser's tokens have
  // one owner and splitting a `>>` writes them in place.
  const lexed = lex(source)
  if (lexed is Err(error)) {
    return Some(splitLexError(error))
  }
  parser.tokens = lexed.value
  return None
}

export function parseWithTrivia(source: string, firstId: int): Result<#[
  Parsed,
  Trivia,
], Diagnostic> uses alloc {
  const lexed = lexWithComments(source)
  if (lexed is Err(error)) {
    return Err(splitLexError(error))
  }
  const #[tokens, comments] = lexed.value
  let parser = Parser {
    tokens: copy(tokens),
    index: 0,
    nextId: firstId,
    failed: None,
    ternaryIds: [],
    collector: createCollector(true),
    typeNames: [],
    facts: createEmptyFacts(),
    resultFunction: false,
    statementStart: 0 - 1,
  }
  const file = parseFile(mutable parser)
  if (parser.failed is Some(diagnostic)) {
    return Err(diagnostic)
  }
  const trivia = buildTrivia(parser.collector, comments, source)
  const facts = finishFacts(parser, source)
  return Ok(#[Parsed { file: File { ...file, facts: facts }, nextId: parser.nextId }, trivia])
}

// ---- Source facts for fixes

function isNameStart(character: char): bool {
  return (character >= 'a' && character <= 'z') ||
    (character >= 'A' && character <= 'Z') ||
    character == '_'
}

function isNameCharacter(character: char): bool {
  return isNameStart(character) || (character >= '0' && character <= '9')
}

function markTemplateDots(mutable names: Map<string, bool>, text: string) uses alloc {
  // The parser keeps no positions inside ${...}, so a fix cannot rename a name used there.
  const characters = Str.chars(text)
  const count = Arrays.length(characters)
  let index = 0
  while (index < count) {
    if (!isNameStart(characters[index])) {
      index++
      continue
    }
    let end = index
    while (end < count && isNameCharacter(characters[end])) {
      end++
    }
    if (end < count && characters[end] == '.') {
      names[sliceText(characters, index, end)] = true
      index = end + 1
    } else {
      index = end
    }
  }
}

function sliceText(characters: Array<char>, first: int, last: int): string uses alloc {
  let builder = Str.builder()
  for (const index of Ranges.between(first, last)) {
    Str.appendChar(mutable builder, characters[index])
  }
  return Str.build(builder)
}

function isBlankRange(source: string, first: int, end: int): bool {
  for (const index of Ranges.between(first, end)) {
    const byte = Str.byteAt(source, index)
    if (byte != 32 && byte != 9 && byte != 13 && byte != 11 && byte != 12) {
      return false
    }
  }
  return true
}

function findLineEnd(source: string, first: int): int {
  const size = Str.length(source)
  let end = first
  while (end < size && Str.byteAt(source, end) != 10) {
    end++
  }
  return end
}

function findHeaderLine(source: string): int {
  let header = 1
  const size = Str.length(source)
  let lineStart = 0
  let lineNumber = 1
  // A blank line after the leading comment block ends the header; a comment right above a declaration is its doc comment.
  while (
    lineStart + 1 < size &&
      Str.byteAt(source, lineStart) == 47 &&
      Str.byteAt(source, lineStart + 1) == 47
  ) {
    const lineEnd = findLineEnd(source, lineStart)
    if (lineEnd >= size) {
      break
    }
    const nextStart = lineEnd + 1
    if (isBlankRange(source, nextStart, findLineEnd(source, nextStart))) {
      header = lineNumber + 1
    }
    lineStart = nextStart
    lineNumber++
  }
  return header
}

function finishFacts(parser: Parser, source: string): SourceFacts from parser uses alloc {
  let inTemplate: Map<string, bool> = Map {}
  let dotUses: Map<string, Array<DotUse>> = Map {}
  const count = Arrays.length(parser.tokens)
  for (const index of Ranges.upTo(count)) {
    const token = parser.tokens[index]
    if (token.kind == TokenKind.TokTemplate) {
      markTemplateDots(mutable inTemplate, token.text)
    }
    if (token.kind != TokenKind.TokIdent || index + 1 >= count) {
      continue
    }
    const next = parser.tokens[index + 1]
    if (next.kind != TokenKind.TokPunct || next.text != ".") {
      continue
    }
    if (index > 0) {
      const before = parser.tokens[index - 1]
      if (before.kind == TokenKind.TokPunct && before.text == ".") {
        continue
      }
    }
    let member = ""
    if (index + 2 < count && parser.tokens[index + 2].kind == TokenKind.TokIdent) {
      member = parser.tokens[index + 2].text
    }
    let known: Array<DotUse> = []
    if (dotUses[token.text] is Some(found)) {
      known = copy(found)
    }
    Arrays.push(mutable known, DotUse { pos: getPos(token), member: member })
    dotUses[token.text] = known
  }
  // The `${}` parts of templates added their names while the parser read them.
  let referenced: Map<string, bool> = copy(parser.facts.referenced)
  collectReferencedNames(mutable referenced, parser.tokens)
  return SourceFacts {
    source: source,
    header: findHeaderLine(source),
    inTemplate: inTemplate,
    dotUses: dotUses,
    namePositions: parser.facts.namePositions,
    shorthandIds: parser.facts.shorthandIds,
    callEnds: parser.facts.callEnds,
    templateTokenEnds: parser.facts.templateTokenEnds,
    taggedCalls: parser.facts.taggedCalls,
    referenced: referenced,
    resultEnds: parser.facts.resultEnds,
    fromNames: parser.facts.fromNames,
    valueEnds: parser.facts.valueEnds,
    hasTypeof: parser.facts.hasTypeof,
  }
}

function collectReferencedNames(mutable names: Map<string, bool>, tokens: Array<Token>) uses alloc {
  // An import declaration ends at its path string; its names are not recorded.
  let inImport = false
  for (const index of Ranges.upTo(Arrays.length(tokens))) {
    const token = tokens[index]
    if (token.kind == TokenKind.TokKeyword && token.text == "import") {
      inImport = true
      continue
    }
    if (inImport) {
      inImport = token.kind != TokenKind.TokString
      continue
    }
    if (token.kind != TokenKind.TokIdent) {
      continue
    }
    if (index > 0) {
      const before = tokens[index - 1]
      if (before.kind == TokenKind.TokPunct && before.text == ".") {
        continue
      }
    }
    names[token.text] = true
  }
}

function getCallEnd(parser: Parser): Pos {
  return moveColumn(getPos(parser.tokens[parser.index - 1]), 1)
}

// ---- Trivia notes. Each does nothing unless the collector is enabled.

function getEndPos(parser: Parser): Pos {
  // Line breaks do not count.
  let index = parser.index - 1
  while (index >= 0 && parser.tokens[index].kind == TokenKind.TokNewline) {
    index--
  }
  if (index < 0) {
    return createEmptyPos()
  }
  const token = parser.tokens[index]
  return Pos { line: token.endLine, column: token.endColumn }
}

function noteKey(mutable parser: Parser, key: string, startIndex: int) {
  if (parser.collector.enabled && isOk(parser)) {
    const start = getPos(parser.tokens[startIndex])
    const end = getEndPos(parser)
    noteNode(mutable parser.collector, key, start, end)
  }
}

function noteExpr(mutable parser: Parser, startIndex: int, expression: Expr) {
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getIdKey(getExprId(expression)), startIndex)
  }
}

function noteType(mutable parser: Parser, startIndex: int, type: TypeExpr) {
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getPosKey("t", type.pos), startIndex)
  }
}

export function formatDiagnostic(diagnostic: Diagnostic): string uses alloc {
  return `${Int.toString(diagnostic.pos.line)}:${Int.toString(diagnostic.pos.column)}: ${diagnostic.message}`
}

function splitLexError(error: LexError): Diagnostic from error {
  return Diagnostic {
    code: error.code,
    pos: Pos { line: error.line, column: error.column },
    message: error.message,
    fixes: error.fixes,
  }
}

// ---- Tokens and errors

function isOk(parser: Parser): bool {
  return parser.failed is None
}

function failAt(mutable parser: Parser, pos: Pos, code: string, message: string) {
  failAtFix(mutable parser, pos, code, [], message)
}

function failAtFix(
  mutable parser: Parser,
  pos: Pos,
  code: string,
  fixes: Array<Fix>,
  message: string,
) {
  // Only the first error is kept; later errors are ignored.
  if (parser.failed is Some(_)) {
    return
  }
  // The lexer lets a `;` inside brackets through for the C-style for, so any other
  // error at one is the semicolon itself.
  const token = currentToken(parser)
  if (token.kind == TokenKind.TokPunct && token.text == ";" && !parser.forHead) {
    const semicolonPos = getPos(token)
    if (semicolonPos.line == pos.line && semicolonPos.column == pos.column) {
      parser.failed = Some(Diagnostic {
        code: "E0003",
        pos: pos,
        message: "semicolons are not used; end the statement with a line break",
        fixes: buildRemoveSemicolonFix(pos),
      })
      return
    }
  }
  parser.failed = Some(Diagnostic { code: code, pos: pos, message: message, fixes: fixes })
}

function failHere(mutable parser: Parser, code: string, message: string) {
  const token = currentToken(parser)
  failAt(mutable parser, getPos(token), code, message)
}

function failFound(mutable parser: Parser, code: string, message: string) {
  const token = currentToken(parser)
  failAt(mutable parser, getPos(token), code, `${message}, found ${describeToken(token)}`)
}

function newId(mutable parser: Parser): int {
  const nodeId = parser.nextId
  parser.nextId++
  return nodeId
}

function getPos(token: Token): Pos {
  return Pos { line: token.line, column: token.column }
}

function currentToken(parser: Parser): Token {
  return copy(parser.tokens[parser.index])
}

function reportHabitWord(mutable parser: Parser, token: Token) {
  const pos = getPos(token)
  const next = currentToken(parser)
  if (token.text == "this") {
    failAt(mutable parser, pos, "E0928", "there is no `this`; pass the value as a parameter")
  }
  if (token.text == "new" && next.kind == TokenKind.TokIdent) {
    failAt(
      mutable parser,
      pos,
      "E0925",
      "there is no `new`; write a struct literal such as `Name { field: value }`, or call a function",
    )
  }
  if (token.text == "try" && next.kind == TokenKind.TokPunct && next.text == "{") {
    failAt(
      mutable parser,
      pos,
      "E0926",
      "there is no `try` or `catch`; return a `Result` and check it with `is Err` or `match`",
    )
  }
  if (token.text == "throw" && isThrowOperand(next)) {
    // Inside a function that returns a Result, a `throw` that starts its
    // statement becomes `return Err(value)`.
    let fixes: Array<Fix> = []
    if (parser.resultFunction && isStatementStart(parser)) {
      if (speculateExpression(mutable parser) is Some(end)) {
        fixes = [
          createFix("return an Err", [
            createEdit(pos, getPos(next), "return Err("),
            insertAt(end, ")"),
          ]),
        ]
      }
    }
    failAtFix(
      mutable parser,
      pos,
      "E0927",
      fixes,
      "there is no `throw`; return `Err(value)`, or call `panic` for a bug",
    )
  }
}

function isStatementStart(parser: Parser): bool {
  if (parser.index < 2) {
    return false
  }
  // The token just consumed is at index - 1, so the one before it is at index - 2.
  const before = parser.tokens[parser.index - 2]
  return before.kind == TokenKind.TokNewline ||
    (before.kind == TokenKind.TokPunct && (before.text == "{" || before.text == "}"))
}

function speculateExpression(mutable parser: Parser): Option<Pos> uses alloc {
  const savedIndex = parser.index
  const savedId = parser.nextId
  parseExpr(mutable parser)
  let end: Option<Pos> = None
  if (isOk(parser)) {
    const last = parser.tokens[parser.index - 1]
    // The expression must end at the end of the line or at a `}`.
    const after = currentToken(parser)
    if (
      after.kind == TokenKind.TokNewline || (after.kind == TokenKind.TokPunct && after.text == "}")
    ) {
      end = Some(Pos { line: last.endLine, column: last.endColumn })
    }
  }
  parser.index = savedIndex
  parser.nextId = savedId
  parser.failed = None
  return end
}

function isThrowOperand(token: Token): bool {
  const kind = token.kind
  return kind == TokenKind.TokIdent ||
    kind == TokenKind.TokString ||
    kind == TokenKind.TokTemplate ||
    kind == TokenKind.TokInt ||
    kind == TokenKind.TokFloat ||
    kind == TokenKind.TokChar
}

function peekToken(parser: Parser, offset: int): Token {
  const count = Arrays.length(parser.tokens)
  if (parser.index + offset < count) {
    return copy(parser.tokens[parser.index + offset])
  }
  // Past the end, the last token (EOF).
  return copy(parser.tokens[count - 1])
}

function advance(mutable parser: Parser): Token {
  const token = parser.tokens[parser.index]
  if (parser.index < Arrays.length(parser.tokens) - 1) {
    parser.index++
  }
  return copy(token)
}

function isAt(parser: Parser, symbol: int): bool {
  return parser.tokens[parser.index].symbol == symbol
}

function getSymbolText(symbol: int): string {
  for (const entry of Maps.entries(SYMBOLS_BY_TEXT)) {
    const #[text, candidate] = entry
    if (candidate == symbol) {
      return text
    }
  }
  return ""
}

function accept(mutable parser: Parser, symbol: int): bool {
  if (isAt(parser, symbol)) {
    advance(mutable parser)
    return true
  }
  return false
}

function expect(mutable parser: Parser, symbol: int): Token {
  if (!isAt(parser, symbol)) {
    const token = currentToken(parser)
    failAt(
      mutable parser,
      getPos(token),
      "E0011",
      `expected "${getSymbolText(symbol)}", found ${describeToken(token)}`,
    )
    return token
  }
  return advance(mutable parser)
}

function expectIdent(mutable parser: Parser): Token {
  const token = currentToken(parser)
  if (token.kind != TokenKind.TokIdent) {
    failAt(mutable parser, getPos(token), "E0012", `expected a name, found ${describeToken(token)}`)
    return token
  }
  if (token.text == "this") {
    failAt(
      mutable parser,
      getPos(token),
      "E0928",
      "there is no `this`; pass the value as a parameter",
    )
  }
  return advance(mutable parser)
}

function isWord(parser: Parser, word: string): bool {
  const token = parser.tokens[parser.index]
  return token.kind == TokenKind.TokIdent && token.text == word
}

function startsLazyValue(parser: Parser): bool {
  if (!isWord(parser, "lazy")) {
    return false
  }
  // `lazy` is a name unless an expression follows it on the same line.
  const word = peekToken(parser, 0)
  const next = peekToken(parser, 1)
  if (next.kind == TokenKind.TokNewline || next.kind == TokenKind.TokEof) {
    return false
  }
  if (next.kind != TokenKind.TokPunct) {
    return true
  }
  // After a space, `(`, `[` and `!` start the expression (`lazy(` calls and `lazy[` indexes a name),
  // and so does a `-` that touches its operand (`lazy - 1` subtracts).
  if (next.line != word.line || next.column <= word.column + 4) {
    return false
  }
  if (next.text == "(" || next.text == "[" || next.text == "!") {
    return true
  }
  const operand = peekToken(parser, 2)
  return next.text == "-" && operand.line == next.line && operand.column == next.column + 1
}

function skipNewlines(mutable parser: Parser) {
  while (currentToken(parser).kind == TokenKind.TokNewline) {
    advance(mutable parser)
  }
}

function endStatement(mutable parser: Parser) {
  const token = currentToken(parser)
  if (token.kind == TokenKind.TokNewline) {
    skipNewlines(mutable parser)
  } else if (isAt(parser, SYMBOL_RIGHT_BRACE) || token.kind == TokenKind.TokEof) {
    return
  } else {
    failAt(
      mutable parser,
      getPos(token),
      "E0013",
      `expected the end of the statement, found ${describeToken(token)}`,
    )
  }
}

function endTypeDecl(mutable parser: Parser) {
  // The lexer emits no line break after a `>`, so the next token on a later line ends the declaration.
  if (parser.index > 0) {
    const previous = parser.tokens[parser.index - 1]
    const current = currentToken(parser)
    if (
      previous.kind == TokenKind.TokPunct && previous.text == ">" && current.line > previous.line
    ) {
      return
    }
  }
  endStatement(mutable parser)
}

function describeToken(token: Token): string {
  if (token.kind == TokenKind.TokEof) {
    return "end of file"
  }
  if (token.kind == TokenKind.TokNewline) {
    return "line break"
  }
  return quoteGo(token.text)
}

export function quoteGo(text: string): string uses alloc {
  // Of the non-ASCII characters, only the C1 controls and the common spaces and format characters that Go does not count as printable are escaped; the rest are written as they are.
  let builder = Str.builder()
  Str.append(mutable builder, "\"")
  for (const character of Arrays.values(Str.chars(text))) {
    const code = Char.code(character)
    if (character == '"') {
      Str.append(mutable builder, "\\\"")
    } else if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (code == 7) {
      Str.append(mutable builder, "\\a")
    } else if (code == 8) {
      Str.append(mutable builder, "\\b")
    } else if (code == 12) {
      Str.append(mutable builder, "\\f")
    } else if (code == 10) {
      Str.append(mutable builder, "\\n")
    } else if (code == 13) {
      Str.append(mutable builder, "\\r")
    } else if (code == 9) {
      Str.append(mutable builder, "\\t")
    } else if (code == 11) {
      Str.append(mutable builder, "\\v")
    } else if (code < 0x20 || code == 0x7f) {
      Str.append(mutable builder, `\\x${hex(code, 2)}`)
    } else if (notPrintable(code)) {
      Str.append(mutable builder, `\\u${hex(code, 4)}`)
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  Str.append(mutable builder, "\"")
  return Str.build(builder)
}

function notPrintable(code: int): bool {
  return (code >= 0x80 && code <= 0xa0) ||
    code == 0xad ||
    code == 0x1680 ||
    (code >= 0x2000 && code <= 0x200f) ||
    (code >= 0x2028 && code <= 0x202f) ||
    (code >= 0x205f && code <= 0x2064) ||
    code == 0x3000 ||
    code == 0xfeff
}

// ---- Dummy nodes, returned once parsing has failed

function createEmptyPos(): Pos {
  return Pos { line: 0, column: 0 }
}

function createDummyExpr(): Expr {
  return Expr.Ident(-1, createEmptyPos(), "")
}

function createDummyType(): TypeExpr {
  return TypeExpr {
    pos: createEmptyPos(),
    name: "",
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
  }
}

function createDummyBlock(): Block {
  return Block { pos: createEmptyPos(), end: createEmptyPos(), statements: [] }
}

function createDummyPattern(): Pattern {
  return Pattern.PatWildcard(-1, createEmptyPos())
}

// ---- Declarations

function parseFile(mutable parser: Parser): File {
  let imports: Array<ImportDecl> = []
  let declarations: Array<Decl> = []
  skipNewlines(mutable parser)
  while (isOk(parser) && isAt(parser, SYMBOL_KEYWORD_IMPORT)) {
    Arrays.push(mutable imports, parseImport(mutable parser))
    skipNewlines(mutable parser)
  }
  while (isOk(parser) && currentToken(parser).kind != TokenKind.TokEof) {
    parser.typeNames = []
    // Attributes stand before a function or an extern block.
    const startIndex = parser.index
    const attributes = parseAttributeList(mutable parser)
    if (isExternBlockStart(parser)) {
      // The members of an extern block are top-level functions of their own.
      for (const member of Arrays.values(
        parseExternBlock(mutable parser, attributes, startIndex),
      )) {
        Arrays.push(mutable declarations, Decl.Func(member))
      }
    } else {
      Arrays.push(
        mutable declarations,
        parseDeclWithAttributes(mutable parser, attributes, startIndex),
      )
    }
    skipNewlines(mutable parser)
  }
  return File { imports: imports, declarations: declarations, facts: createEmptyFacts() }
}

function parseImport(mutable parser: Parser): ImportDecl {
  const startIndex = parser.index
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_IMPORT))
  let alias = ""
  let aliasPos = createEmptyPos()
  let names: Array<ImportName> = []
  if (accept(mutable parser, SYMBOL_STAR)) {
    expect(mutable parser, SYMBOL_KEYWORD_AS)
    const aliasToken = expectIdent(mutable parser)
    alias = aliasToken.text
    aliasPos = getPos(aliasToken)
  } else if (accept(mutable parser, SYMBOL_LEFT_BRACE)) {
    skipNewlines(mutable parser)
    while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
      const nameToken = expectIdent(mutable parser)
      const name = nameToken.text
      let local = name
      let end = moveColumn(getPos(nameToken), Str.charCount(name))
      if (accept(mutable parser, SYMBOL_KEYWORD_AS)) {
        const localToken = expectIdent(mutable parser)
        local = localToken.text
        end = moveColumn(getPos(localToken), Str.charCount(local))
      }
      Arrays.push(mutable names, ImportName {
        pos: getPos(nameToken),
        name: name,
        local: local,
        end: end,
      })
      skipNewlines(mutable parser)
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
      skipNewlines(mutable parser)
    }
    skipNewlines(mutable parser)
    expect(mutable parser, SYMBOL_RIGHT_BRACE)
  } else {
    const at = getPos(currentToken(parser))
    let fixes: Array<Fix> = []
    if (currentToken(parser).kind == TokenKind.TokIdent) {
      fixes = [createFix("import the module as a namespace", [insertAt(at, "* as ")])]
    }
    failAtFix(
      mutable parser,
      at,
      "E0014",
      fixes,
      "use `import * as Name from \"path\"` or `import { a, b } from \"path\"`; there are no default imports",
    )
  }
  expect(mutable parser, SYMBOL_KEYWORD_FROM)
  let path = ""
  if (currentToken(parser).kind != TokenKind.TokString) {
    failHere(mutable parser, "E0015", "expected a module path string")
  } else {
    path = advance(mutable parser).text
  }
  endStatement(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("i", pos), startIndex)
  }
  return ImportDecl { pos: pos, alias: alias, aliasPos: aliasPos, names: names, path: path }
}

function isFieldsOnlyBody(parser: Parser): bool {
  // The tokens after the current `class` or `interface` must be `Name {` and then lines of `field: type`, with no method, modifier, separator or generic parameter.
  const name = peekToken(parser, 1)
  const open = peekToken(parser, 2)
  if (name.kind != TokenKind.TokIdent || open.kind != TokenKind.TokPunct || open.text != "{") {
    return false
  }
  let offset = 3
  while (true) {
    while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
      offset++
    }
    const field = peekToken(parser, offset)
    if (field.kind == TokenKind.TokPunct && field.text == "}") {
      return true
    }
    const colon = peekToken(parser, offset + 1)
    if (field.kind != TokenKind.TokIdent || colon.kind != TokenKind.TokPunct || colon.text != ":") {
      return false
    }
    offset += 2
    // The type runs to the end of the line.
    while (peekToken(parser, offset).kind != TokenKind.TokNewline) {
      const part = peekToken(parser, offset)
      if (part.kind == TokenKind.TokEof) {
        return false
      }
      if (part.kind == TokenKind.TokPunct && isTypeBreaker(part.text)) {
        return false
      }
      offset++
    }
  }
  return false
}

function isTypeBreaker(text: string): bool {
  return text == ";" ||
    text == "," ||
    text == "{" ||
    text == "}" ||
    text == "?" ||
    text == "(" ||
    text == "="
}

function parseDeclWithAttributes(
  mutable parser: Parser,
  attributes: Array<Attribute>,
  startIndex: int,
): Decl {
  // Attributes stand on their own lines before a function. The trivia record of
  // the declaration starts at the first `@` and each attribute has its own
  // record that runs up to the next token, so the comments after an attribute,
  // on its line or on lines of their own, are that attribute's.
  const body = parseDeclBody(mutable parser)
  const declaration = addAttributes(mutable parser, body, attributes)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("d", getDeclPos(declaration)), startIndex)
  }
  return declaration
}

function parseAttributeList(mutable parser: Parser): Array<Attribute> uses alloc {
  let attributes: Array<Attribute> = []
  while (isOk(parser) && isAt(parser, SYMBOL_AT)) {
    const written = parseAttribute(mutable parser)
    skipNewlines(mutable parser)
    if (parser.collector.enabled && isOk(parser)) {
      const key = getPosKey("@", written.pos)
      const end = getPos(currentToken(parser))
      noteNode(mutable parser.collector, key, written.pos, end)
    }
    if (isOk(parser) && hasAttribute(attributes, written.name)) {
      failAt(
        mutable parser,
        written.pos,
        "E0990",
        `\`@${written.name}\` is written once, before a function declaration`,
      )
    }
    Arrays.push(mutable attributes, written)
  }
  return attributes
}

function hasAttribute(attributes: Array<Attribute>, name: string): bool {
  for (const attribute of Arrays.values(attributes)) {
    if (attribute.name == name) {
      return true
    }
  }
  return false
}

function addAttributes(
  mutable parser: Parser,
  declaration: Decl,
  attributes: Array<Attribute>,
): Decl from declaration uses alloc {
  if (Arrays.length(attributes) == 0) {
    return declaration
  }
  if (declaration is Decl.Func(funcDecl)) {
    rejectExternAttribute(mutable parser, attributes)
    return Decl.Func(FuncDecl { ...funcDecl, attributes: copy(attributes) })
  }
  const first = attributes[0]
  failAt(
    mutable parser,
    first.pos,
    "E0990",
    `\`@${first.name}\` is written once, before a function declaration`,
  )
  return declaration
}

function rejectExternAttribute(mutable parser: Parser, attributes: Array<Attribute>) {
  // `@extern` names a C function, so it belongs on a member of an extern block.
  for (const attribute of Arrays.values(attributes)) {
    if (attribute.name == "extern") {
      failAt(
        mutable parser,
        attribute.pos,
        "E1000",
        "@extern is written on a function inside an `extern { } from` block",
      )
    }
  }
}

function isExternBlockStart(parser: Parser): bool {
  // `extern` is a keyword only before `{` at the start of a declaration.
  const next = peekToken(parser, 1)
  return isWord(parser, "extern") && next.kind == TokenKind.TokPunct && next.text == "{"
}

function parseExternBlock(
  mutable parser: Parser,
  attributes: Array<Attribute>,
  startIndex: int,
): Array<FuncDecl> {
  // Only @target is written before a block; it applies to every member.
  let targets: Array<Attribute> = []
  for (const attribute of Arrays.values(attributes)) {
    if (isOk(parser) && attribute.name != "target") {
      failAt(
        mutable parser,
        attribute.pos,
        "E1000",
        `@${attribute.name} is not written before an extern block; only @target is`,
      )
    }
    Arrays.push(mutable targets, copy(attribute))
  }
  const pos = getPos(advance(mutable parser))
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let members: Array<FuncDecl> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    Arrays.push(mutable members, parseExternMember(mutable parser))
    skipNewlines(mutable parser)
  }
  if (isOk(parser) && Arrays.length(members) == 0) {
    failAt(mutable parser, pos, "E1000", "an extern block declares at least one C function")
  }
  const closeIndex = parser.index
  const end = getPos(expect(mutable parser, SYMBOL_RIGHT_BRACE))
  if (parser.collector.enabled) {
    // Comments between the closing brace and `from` attach to the brace.
    noteKey(mutable parser, getPosKey("r", end), closeIndex)
  }
  // The library comes after the block, like the path of an import.
  const fromIndex = parser.index
  if (isOk(parser) && !accept(mutable parser, SYMBOL_KEYWORD_FROM)) {
    failFound(mutable parser, "E1000", "an extern block ends with `from \"library\"`")
  }
  const libraryToken = currentToken(parser)
  if (parser.collector.enabled) {
    // The keyword is a node too, so a comment before it stays before it.
    noteKey(mutable parser, getPosKey("k", getPos(libraryToken)), fromIndex)
  }
  if (isOk(parser) && libraryToken.kind != TokenKind.TokString) {
    failFound(mutable parser, "E1000", "an extern block ends with `from \"library\"`")
  }
  if (isOk(parser)) {
    const libraryIndex = parser.index
    advance(mutable parser)
    if (parser.collector.enabled) {
      // Comments between `from` and the name attach to the name.
      noteKey(mutable parser, getPosKey("l", getPos(libraryToken)), libraryIndex)
    }
    if (!isLibraryName(libraryToken.text)) {
      failAt(
        mutable parser,
        getPos(libraryToken),
        "E1000",
        `${quoteGo(libraryToken.text)} is not a library name; write the name cc takes after -l, such as "m"`,
      )
    }
  }
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("x", pos), startIndex)
  }
  const block = ExternBlock {
    pos: pos,
    end: end,
    library: libraryToken.text,
    libraryPos: getPos(libraryToken),
    attributes: targets,
  }
  let linked: Array<FuncDecl> = []
  for (const member of Arrays.values(members)) {
    // The member carries the block's @target, so the checks of a @target function apply to it.
    let memberAttributes: Array<Attribute> = copy(targets)
    for (const written of Arrays.values(member.attributes)) {
      Arrays.push(mutable memberAttributes, copy(written))
    }
    Arrays.push(mutable linked, FuncDecl {
      ...member,
      attributes: memberAttributes,
      externBlock: Some(copy(block)),
    })
  }
  return linked
}

function isLibraryName(name: string): bool {
  // Letters, digits, `_`, `.`, `+` and `-`, not starting with `-`.
  if (name == "" || Str.startsWith(name, "-")) {
    return false
  }
  for (const character of Arrays.values(Str.chars(name))) {
    const isLetter =
      (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
    const isDigit = character >= '0' && character <= '9'
    const isMark = character == '_' || character == '.' || character == '+' || character == '-'
    if (!isLetter && !isDigit && !isMark) {
      return false
    }
  }
  return true
}

function parseExternMember(mutable parser: Parser): FuncDecl {
  const startIndex = parser.index
  const attributes = parseAttributeList(mutable parser)
  for (const attribute of Arrays.values(attributes)) {
    if (isOk(parser) && attribute.name == "inline") {
      // A C function has no body to copy into the caller.
      failAt(
        mutable parser,
        attribute.pos,
        "E1031",
        "@inline needs a body to copy; a function of an extern block has none",
      )
    }
    if (isOk(parser) && attribute.name != "extern") {
      failAt(
        mutable parser,
        attribute.pos,
        "E1000",
        `@${attribute.name} is not written on a function of an extern block; only @extern is`,
      )
    }
  }
  const exported = accept(mutable parser, SYMBOL_KEYWORD_EXPORT)
  if (isOk(parser) && !isAt(parser, SYMBOL_KEYWORD_FUNCTION)) {
    failFound(mutable parser, "E1000", "an extern block holds only function signatures")
  }
  const header = parseFuncHeader(mutable parser, exported)
  // A C function has no type parameters, no effects to write and no body.
  if (isOk(parser) && (header.generator || Arrays.length(header.typeParameters) > 0)) {
    failAt(
      mutable parser,
      header.pos,
      "E1000",
      `${header.name} in an extern block cannot be generic or a generator`,
    )
  }
  if (isOk(parser) && Arrays.length(header.effects) > 0) {
    failAt(
      mutable parser,
      header.pos,
      "E1000",
      `${header.name} in an extern block has the unsafe effect already; remove \`uses\``,
    )
  }
  if (isOk(parser) && isAt(parser, SYMBOL_LEFT_BRACE)) {
    failHere(
      mutable parser,
      "E1000",
      `${header.name} in an extern block has no body; the C library provides it`,
    )
  }
  // The next member starts on a line of its own.
  const next = currentToken(parser)
  const atEnd =
    isAt(parser, SYMBOL_RIGHT_BRACE) ||
      next.kind == TokenKind.TokNewline ||
      (parser.index > 0 && next.line > parser.tokens[parser.index - 1].endLine)
  if (isOk(parser) && !atEnd) {
    failFound(mutable parser, "E0013", "expected the end of the statement")
  }
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("d", header.pos), startIndex)
  }
  return FuncDecl { ...header, effects: ["unsafe"], attributes: attributes }
}

function parseDeclBody(mutable parser: Parser): Decl {
  const exported = accept(mutable parser, SYMBOL_KEYWORD_EXPORT)
  const special = parseOpaqueOrDistinct(mutable parser, exported)
  if (special is Some(declaration)) {
    return declaration
  }
  if (isWord(parser, "type") && peekToken(parser, 1).kind == TokenKind.TokIdent) {
    return Decl.Alias(parseAliasDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_FUNCTION)) {
    return Decl.Func(parseFuncDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_ASYNC)) {
    return Decl.Func(parseAsyncFuncDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_CONST)) {
    return Decl.Const(parseConstDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_STRUCT)) {
    return Decl.Struct(parseStructDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_ENUM)) {
    return Decl.Enum(parseEnumDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_TRAIT)) {
    return Decl.Trait(parseTraitDecl(mutable parser, exported))
  }
  if (isAt(parser, SYMBOL_KEYWORD_IMPLEMENT)) {
    if (exported) {
      failHere(
        mutable parser,
        "E0016",
        "implement blocks cannot be exported; export the trait and the type",
      )
    }
    return Decl.Impl(parseImplDecl(mutable parser))
  }
  if (isAt(parser, SYMBOL_KEYWORD_TEST)) {
    if (exported) {
      failHere(mutable parser, "E0017", "tests cannot be exported")
    }
    const pos = getPos(advance(mutable parser))
    let name = ""
    if (currentToken(parser).kind != TokenKind.TokString) {
      failHere(mutable parser, "E0018", "expected the test name as a string")
    } else {
      name = advance(mutable parser).text
    }
    return Decl.Test(TestDecl { pos: pos, name: name, body: parseBlock(mutable parser) })
  }
  const token = currentToken(parser)
  if (token.kind == TokenKind.TokIdent && (token.text == "class" || token.text == "interface")) {
    // The fix renames the keyword to `struct` only when the body holds fields
    // and nothing else, because only then the result is a valid struct.
    let fixes: Array<Fix> = []
    if (isFieldsOnlyBody(parser)) {
      const end = Pos { line: token.endLine, column: token.endColumn }
      fixes = [createFix("use struct", [createEdit(getPos(token), end, "struct")])]
    }
    if (token.text == "class") {
      failAtFix(
        mutable parser,
        getPos(token),
        "E0923",
        fixes,
        "there is no `class`; use a `struct` and functions in a module",
      )
    } else {
      failAtFix(
        mutable parser,
        getPos(token),
        "E0924",
        fixes,
        "there is no `interface`; use a `struct` for data or a `trait` for behavior",
      )
    }
  }
  failAt(
    mutable parser,
    getPos(token),
    "E0019",
    `expected a declaration, found ${describeToken(token)}`,
  )
  return Decl.Test(TestDecl { pos: createEmptyPos(), name: "", body: createDummyBlock() })
}

struct AttributeRow {
  name: string
  takesArguments: bool
  // The argument is one string, as in `@extern("deflateInit_")`.
  takesText: bool = false
}

const KNOWN_ATTRIBUTES: Array<AttributeRow> = [
  AttributeRow { name: "target", takesArguments: true },
  AttributeRow { name: "trusted", takesArguments: false },
  AttributeRow { name: "inline", takesArguments: false },
  AttributeRow { name: "extern", takesArguments: true, takesText: true },
  AttributeRow { name: "const", takesArguments: false },
]

function findAttributeRow(name: string): Option<AttributeRow> {
  for (const row of Arrays.values(KNOWN_ATTRIBUTES)) {
    if (row.name == name) {
      return Some(row)
    }
  }
  return None
}

function describeKnownAttributes(): string uses alloc {
  let names: Array<string> = []
  for (const row of Arrays.values(KNOWN_ATTRIBUTES)) {
    Arrays.push(mutable names, `@${row.name}`)
  }
  return Str.join(names, ", ")
}

function parseAttribute(mutable parser: Parser): Attribute uses alloc {
  const pos = getPos(expect(mutable parser, SYMBOL_AT))
  // `const` is a keyword, so `@const` takes its token as the name.
  let nameToken = currentToken(parser)
  if (isAt(parser, SYMBOL_KEYWORD_CONST)) {
    nameToken = advance(mutable parser)
  } else {
    nameToken = expectIdent(mutable parser)
  }
  let takesArguments = false
  let takesText = false
  if (isOk(parser)) {
    if (findAttributeRow(nameToken.text) is Some(row)) {
      takesArguments = row.takesArguments
      takesText = row.takesText
    } else {
      failAt(
        mutable parser,
        getPos(nameToken),
        "E0990",
        `unknown attribute @${nameToken.text}; the known attributes are ${describeKnownAttributes()}`,
      )
    }
  }
  let arguments: Array<AttributeArgument> = []
  if (!takesArguments) {
    return Attribute { pos: pos, name: nameToken.text, hasParentheses: false, arguments: arguments }
  }
  expect(mutable parser, SYMBOL_LEFT_PAREN)
  if (takesText) {
    // One string between the parentheses.
    const textToken = currentToken(parser)
    if (isOk(parser) && textToken.kind != TokenKind.TokString) {
      failFound(
        mutable parser,
        "E0990",
        `@${nameToken.text} takes one string, as in @${nameToken.text}("name")`,
      )
    }
    if (isOk(parser)) {
      advance(mutable parser)
      Arrays.push(mutable arguments, AttributeArgument {
        pos: getPos(textToken),
        name: "",
        typeName: "",
        typePos: getPos(textToken),
        variant: "",
        text: Some(textToken.text),
      })
    }
    expect(mutable parser, SYMBOL_RIGHT_PAREN)
    return Attribute { pos: pos, name: nameToken.text, hasParentheses: true, arguments: arguments }
  }
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_PAREN)) {
    const argumentToken = expectIdent(mutable parser)
    expect(mutable parser, SYMBOL_EQUALS)
    // The value is a dotted name: the enum, then the variant after the last dot.
    const typePos = getPos(currentToken(parser))
    let typeName = ""
    let variant = expectIdent(mutable parser).text
    while (isOk(parser) && accept(mutable parser, SYMBOL_DOT)) {
      if (typeName == "") {
        typeName = variant
      } else {
        typeName = `${typeName}.${variant}`
      }
      variant = expectIdent(mutable parser).text
    }
    if (isOk(parser) && typeName == "") {
      failAt(
        mutable parser,
        typePos,
        "E0990",
        `@${nameToken.text} ${argumentToken.text} takes a variant such as Os.Windows`,
      )
    }
    if (isOk(parser)) {
      Arrays.push(mutable arguments, AttributeArgument {
        pos: getPos(argumentToken),
        name: argumentToken.text,
        typeName: typeName,
        typePos: typePos,
        variant: variant,
      })
    }
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  return Attribute { pos: pos, name: nameToken.text, hasParentheses: true, arguments: arguments }
}

function parseOpaqueOrDistinct(mutable parser: Parser, exported: bool): Option<Decl> {
  let opaque = false
  if (isWord(parser, "opaque")) {
    if (!exported) {
      failHere(
        mutable parser,
        "E0043",
        "only an exported type can be opaque; write `export opaque`",
      )
    }
    advance(mutable parser)
    opaque = true
  }
  if (isAt(parser, SYMBOL_KEYWORD_STRUCT) && opaque) {
    const structDeclaration = parseStructDecl(mutable parser, exported)
    return Some(Decl.Struct(StructDecl { ...structDeclaration, opaque: true }))
  }
  if (isWord(parser, "distinct")) {
    const pos = getPos(advance(mutable parser))
    if (!isWord(parser, "type")) {
      failFound(mutable parser, "E0044", `expected \`type\` after \`distinct\``)
    }
    advance(mutable parser)
    const name = expectIdent(mutable parser).text
    expect(mutable parser, SYMBOL_EQUALS)
    const base = parseType(mutable parser)
    const traitLists = parseTraitLists(mutable parser)
    const refinement = parseRefinement(mutable parser)
    endTypeDecl(mutable parser)
    return Some(
      Decl.Distinct(DistinctDecl {
        pos: pos,
        name: name,
        exported: exported,
        opaque: opaque,
        base: base,
        implementations: traitLists.implementations,
        derived: traitLists.derived,
        refinement: refinement,
      }),
    )
  }
  if (opaque) {
    failFound(mutable parser, "E0045", `expected \`struct\` or \`distinct type\` after \`opaque\``)
  }
  return None
}

function parseRefinement(mutable parser: Parser): Array<Pattern> {
  // `requires a && b` after the trait lists of a distinct type, on its line or the next (D116).
  let items: Array<Pattern> = []
  let offset = 0
  while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
    offset++
  }
  if (!isRequiresWord(peekToken(parser, offset))) {
    return items
  }
  skipNewlines(mutable parser)
  const requiresIndex = parser.index
  let previous = advance(mutable parser)
  while (isOk(parser)) {
    // The line may break after `&&` only before a comparison or a literal.
    const token = currentToken(parser)
    const isLaterLine = token.line > previous.endLine && !isRefinementStart(token)
    if (
      token.kind == TokenKind.TokNewline ||
        token.kind == TokenKind.TokEof ||
        isAt(parser, SYMBOL_AND) ||
        isLaterLine
    ) {
      failAt(
        mutable parser,
        getPos(token),
        "E1220",
        `a distinct type's \`requires\` needs a pattern here, found ${describeToken(token)}`,
      )
      break
    }
    parser.contractPattern = true
    Arrays.push(mutable items, parsePattern(mutable parser))
    parser.contractPattern = false
    if (!isAt(parser, SYMBOL_AND)) {
      break
    }
    previous = advance(mutable parser)
  }
  // The list is a node of its own, so a comment beside `requires` stays there.
  if (parser.collector.enabled && Arrays.length(items) > 0) {
    noteKey(mutable parser, `n${Int.toString(getPatternId(items[0]))}`, requiresIndex)
  }
  offset = 0
  while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
    offset++
  }
  if (isOk(parser) && isRequiresWord(peekToken(parser, offset))) {
    skipNewlines(mutable parser)
    failHere(
      mutable parser,
      "E1220",
      "a distinct type takes one `requires` list; join its patterns with `&&`",
    )
  }
  if (
    isOk(parser) &&
      (isAt(parser, SYMBOL_KEYWORD_IMPLEMENTS) || isAt(parser, SYMBOL_KEYWORD_DERIVES))
  ) {
    failHere(
      mutable parser,
      "E1220",
      "`implements` and `derives` come before `requires` on a distinct type",
    )
  }
  return items
}

function isRefinementStart(token: Token): bool {
  return isComparisonToken(token) ||
    token.kind == TokenKind.TokInt ||
    token.kind == TokenKind.TokString ||
    (token.kind == TokenKind.TokPunct && token.text == "-")
}

function isRequiresWord(token: Token): bool {
  return token.kind == TokenKind.TokIdent && token.text == "requires"
}

function parseType(mutable parser: Parser): TypeExpr {
  const startIndex = parser.index
  const type = parseTypeBody(mutable parser)
  noteType(mutable parser, startIndex, type)
  return type
}

function parseTypeBody(mutable parser: Parser): TypeExpr {
  if (isAt(parser, SYMBOL_LEFT_PAREN)) {
    return parseFuncType(mutable parser)
  }
  if (isAt(parser, SYMBOL_HASH_BRACKET)) {
    // A tuple type, written like the literal: #[int, string].
    const pos = getPos(advance(mutable parser))
    let arguments: Array<TypeExpr> = []
    while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACKET)) {
      Arrays.push(mutable arguments, parseType(mutable parser))
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
    }
    expect(mutable parser, SYMBOL_RIGHT_BRACKET)
    return TypeExpr {
      pos: pos,
      name: "",
      arguments: arguments,
      isFunc: false,
      result: None,
      effects: [],
      isTuple: true,
    }
  }
  if (isWord(parser, "typeof") && peekToken(parser, 1).kind == TokenKind.TokIdent) {
    // `typeof name` stands for the type of a value in scope. A field path or an
    // expression after the name ends the type and fails in the caller.
    const pos = getPos(advance(mutable parser))
    const valueName = expectIdent(mutable parser).text
    parser.facts.hasTypeof = true
    return TypeExpr {
      pos: pos,
      name: "",
      arguments: [],
      isFunc: false,
      result: None,
      effects: [],
      isTuple: false,
      typeofName: valueName,
    }
  }
  if (isConstantTypeAhead(parser)) {
    return parseConstantType(mutable parser)
  }
  const token = expectIdent(mutable parser)
  if (!isOk(parser)) {
    return createDummyType()
  }
  let name = token.text
  if (accept(mutable parser, SYMBOL_DOT)) {
    // a type from a namespace import, such as Text.Token
    name = `${name}.${expectIdent(mutable parser).text}`
  }
  let arguments: Array<TypeExpr> = []
  const named = TypeExpr {
    pos: getPos(token),
    name: name,
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
  }
  if (accept(mutable parser, SYMBOL_LESS)) {
    while (isOk(parser)) {
      Arrays.push(mutable arguments, parseType(mutable parser))
      rejectTypeArithmetic(mutable parser)
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
    }
    // In `Array<Array<int>>` the lexer reads `>>` as one token. Split it.
    if (isAt(parser, SYMBOL_SHIFT_RIGHT)) {
      const shift = currentToken(parser)
      parser.tokens[parser.index] = Token {
        ...shift,
        text: ">",
        column: shift.column + 1,
        symbol: SYMBOL_GREATER,
      }
      return TypeExpr { ...named, arguments: arguments }
    }
    expect(mutable parser, SYMBOL_GREATER)
  }
  if (name == "Generator" || name == "Coroutine" || name == "AsyncGenerator") {
    // A generator type carries the effects its body has when it runs:
    // `Generator<string> uses io`.
    const effects = parseTypeUses(mutable parser)
    if (Arrays.length(effects) > 0) {
      return TypeExpr { ...named, arguments: arguments, effects: effects }
    }
  }
  const after = peekToken(parser, 1)
  if (isAt(parser, SYMBOL_LEFT_BRACKET) && after.kind == TokenKind.TokPunct && after.text == "]") {
    const open = getPos(currentToken(parser))
    const shut = moveColumn(getPos(after), 1)
    failAtFix(
      mutable parser,
      open,
      "E0020",
      [createFix("write Array<...>", [insertAt(named.pos, "Array<"), createEdit(open, shut, ">")])],
      "there is no `T[]` array type; write `Array<T>`",
    )
  }
  return TypeExpr { ...named, arguments: arguments }
}

function parseTypeParams(mutable parser: Parser, allowBounds: bool): TypeParams {
  // Effect variables are kept apart from the type parameters. Without allowBounds a `:` after a name is left for the closing `>` to reject.
  let names: Array<string> = []
  let bounds: Array<Array<TypeExpr>> = []
  let effects: Array<string> = []
  let constants: Array<string> = []
  if (!accept(mutable parser, SYMBOL_LESS)) {
    return TypeParams { names: names, bounds: bounds, effects: effects, constants: constants }
  }
  while (isOk(parser) && !isAt(parser, SYMBOL_GREATER)) {
    const token = currentToken(parser)
    if (accept(mutable parser, SYMBOL_KEYWORD_CONST)) {
      // `const N: int` is a constant parameter; it also counts as a type name for the lookaheads.
      const constantName = expectIdent(mutable parser).text
      expect(mutable parser, SYMBOL_COLON)
      const kind = expectIdent(mutable parser)
      if (isOk(parser) && kind.text != "int") {
        failAt(
          mutable parser,
          getPos(kind),
          "E0992",
          `a constant type parameter must have type int, found ${kind.text}`,
        )
      }
      Arrays.push(mutable names, constantName)
      Arrays.push(mutable constants, constantName)
      Arrays.push(mutable parser.typeNames, constantName)
      Arrays.push(mutable bounds, [])
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
      continue
    }
    if (
      token.kind == TokenKind.TokIdent &&
        token.text == "effect" &&
        peekToken(parser, 1).kind == TokenKind.TokIdent
    ) {
      advance(mutable parser)
      Arrays.push(mutable effects, expectIdent(mutable parser).text)
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
      continue
    }
    const parameterName = expectIdent(mutable parser).text
    Arrays.push(mutable names, parameterName)
    Arrays.push(mutable parser.typeNames, parameterName)
    let traitBounds: Array<TypeExpr> = []
    if (allowBounds && accept(mutable parser, SYMBOL_COLON)) {
      while (isOk(parser)) {
        const boundName = expectIdent(mutable parser)
        Arrays.push(mutable traitBounds, createNamedType(boundName))
        if (!accept(mutable parser, SYMBOL_AMPERSAND)) {
          break
        }
      }
    }
    Arrays.push(mutable bounds, traitBounds)
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_GREATER)
  return TypeParams { names: names, bounds: bounds, effects: effects, constants: constants }
}

function isConstantTypeAhead(parser: Parser): bool {
  // `3` or `-3` where a type is written: a constant type argument.
  if (currentToken(parser).kind == TokenKind.TokInt) {
    return true
  }
  return isAt(parser, SYMBOL_MINUS) && peekToken(parser, 1).kind == TokenKind.TokInt
}

function parseConstantType(mutable parser: Parser): TypeExpr {
  const pos = getPos(currentToken(parser))
  let sign = ""
  if (accept(mutable parser, SYMBOL_MINUS)) {
    sign = "-"
  }
  const literal = advance(mutable parser)
  return TypeExpr {
    pos: pos,
    name: `${sign}${literal.text}`,
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
    isConstant: true,
  }
}

function rejectTypeArithmetic(mutable parser: Parser) {
  // A type argument is a type, a literal or a constant parameter; it never computes.
  if (
    isOk(parser) &&
      (isAt(parser, SYMBOL_PLUS) ||
        isAt(parser, SYMBOL_MINUS) ||
        isAt(parser, SYMBOL_STAR) ||
        isAt(parser, SYMBOL_SLASH) ||
        isAt(parser, SYMBOL_PERCENT))
  ) {
    const operator = currentToken(parser)
    failAt(
      mutable parser,
      getPos(operator),
      "E0992",
      `a type argument cannot compute with \`${operator.text}\`; write an integer literal or a constant parameter`,
    )
  }
}

function createNamedType(token: Token): TypeExpr {
  return TypeExpr {
    pos: getPos(token),
    name: token.text,
    arguments: [],
    isFunc: false,
    result: None,
    effects: [],
    isTuple: false,
  }
}

function parseTypeDeclParams(
  mutable parser: Parser,
  allowConstants: bool,
  allowBounds: bool,
): TypeParams {
  const pos = getPos(currentToken(parser))
  const typeParameters = parseTypeParams(mutable parser, allowBounds)
  if (!allowConstants && Arrays.length(typeParameters.constants) > 0) {
    failAt(
      mutable parser,
      pos,
      "E0992",
      "constant type parameters are allowed only on functions and structs",
    )
  }
  return typeParameters
}

function parseConstDecl(mutable parser: Parser, exported: bool): ConstDecl {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_CONST))
  const name = expectIdent(mutable parser).text
  let declaredType: Option<TypeExpr> = None
  if (accept(mutable parser, SYMBOL_COLON)) {
    declaredType = Some(parseType(mutable parser))
  }
  expect(mutable parser, SYMBOL_EQUALS)
  // The contextual word `lazy` before the value.
  let lazyPos: Option<Pos> = None
  if (startsLazyValue(parser)) {
    const lazyIndex = parser.index
    const lazyKey = getPosKey("k", getPos(currentToken(parser)))
    lazyPos = Some(getPos(advance(mutable parser)))
    noteKey(mutable parser, lazyKey, lazyIndex)
  }
  const value = parseExpr(mutable parser)
  endStatement(mutable parser)
  return ConstDecl {
    pos: pos,
    name: name,
    exported: exported,
    type: declaredType,
    value: value,
    lazyPos: lazyPos,
  }
}

function parseFuncDecl(mutable parser: Parser, exported: bool): FuncDecl {
  const header = parseFuncHeader(mutable parser, exported)
  const conditions = parseRequiresLines(mutable parser)
  const results = parseEnsuresLines(mutable parser)
  // The body starts on the line after the last condition or pattern.
  if (Arrays.length(conditions) > 0 || Arrays.length(results) > 0) {
    skipNewlines(mutable parser)
  }
  const savedResult = parser.resultFunction
  parser.resultFunction = false
  if (header.result is Some(resultType)) {
    parser.resultFunction = resultType.name == "Result"
  }
  const body = parseBlock(mutable parser)
  parser.resultFunction = savedResult
  return FuncDecl { ...header, requires: conditions, ensures: results, body: Some(body) }
}

function parseAsyncFuncDecl(mutable parser: Parser, exported: bool): FuncDecl {
  // `async function name(...)`, or `async function* name(...)`, an async generator (D110).
  const asyncToken = advance(mutable parser)
  if (!isAt(parser, SYMBOL_KEYWORD_FUNCTION)) {
    const found = describeToken(currentToken(parser))
    failAt(
      mutable parser,
      getPos(asyncToken),
      "E1108",
      `async must be followed by function, an arrow function or a block, found ${found}`,
    )
    return parseFuncDecl(mutable parser, exported)
  }
  const declaration = parseFuncDecl(mutable parser, exported)
  return FuncDecl { ...declaration, isAsync: true }
}

function parseRequiresLines(mutable parser: Parser): Array<Expr> {
  let conditions: Array<Expr> = []
  while (isOk(parser) && isContractLine(parser, "requires")) {
    skipNewlines(mutable parser)
    const lineStart = parser.index
    advance(mutable parser)
    const condition = parseExpr(mutable parser)
    // The line is a node of its own, so the comments above it stay above it.
    if (parser.collector.enabled) {
      noteKey(mutable parser, `q${Int.toString(getExprId(condition))}`, lineStart)
    }
    Arrays.push(mutable conditions, condition)
  }
  return conditions
}

function parseEnsuresLines(mutable parser: Parser): Array<Pattern> {
  let patterns: Array<Pattern> = []
  while (isOk(parser) && isContractLine(parser, "ensures")) {
    skipNewlines(mutable parser)
    const lineStart = parser.index
    advance(mutable parser)
    parser.contractPattern = true
    const pattern = parsePattern(mutable parser)
    parser.contractPattern = false
    // The line is a node of its own, so the comments above it stay above it.
    if (parser.collector.enabled) {
      noteKey(mutable parser, `n${Int.toString(getPatternId(pattern))}`, lineStart)
    }
    Arrays.push(mutable patterns, pattern)
  }
  return patterns
}

function isContractLine(parser: Parser, word: string): bool {
  // `requires` and `ensures` are not keywords; they count only at the start of a line
  // after the signature. A signature that ends in `>` is followed by no line break token.
  let offset = 0
  while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
    offset++
  }
  const token = peekToken(parser, offset)
  if (token.kind != TokenKind.TokIdent || token.text != word || parser.index < 1) {
    return false
  }
  return offset > 0 || token.line > parser.tokens[parser.index - 1].endLine
}

function parseFuncHeader(mutable parser: Parser, exported: bool): FuncDecl {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_FUNCTION))
  const generator = accept(mutable parser, SYMBOL_STAR)
  // A function may be named `of` or `from` (Hash.of, CStrings.from), though they are keywords.
  let nameToken = currentToken(parser)
  if (isAt(parser, SYMBOL_KEYWORD_OF) || isAt(parser, SYMBOL_KEYWORD_FROM)) {
    nameToken = advance(mutable parser)
  } else {
    nameToken = expectIdent(mutable parser)
  }
  const name = nameToken.text
  const typeParameters = parseTypeParams(mutable parser, true)
  expect(mutable parser, SYMBOL_LEFT_PAREN)
  let parameters: Array<Param> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_PAREN)) {
    const paramPos = getPos(currentToken(parser))
    const paramStart = parser.index
    const isMutable = accept(mutable parser, SYMBOL_KEYWORD_MUTABLE)
    let escaping = false
    if (!isMutable) {
      escaping = acceptEscaping(mutable parser)
    }
    const paramNameToken = expectIdent(mutable parser)
    const paramName = paramNameToken.text
    if (isAt(parser, SYMBOL_QUESTION)) {
      reportOptionalParameter(mutable parser, paramName, false)
      break
    }
    // `f: () => int uses io, alloc,`: the type's list ended at its one effect.
    if (!isAt(parser, SYMBOL_COLON) && paramStart > 0) {
      reportTypeUsesComma(mutable parser, paramStart - 1)
    }
    expect(mutable parser, SYMBOL_COLON)
    const paramType = parseType(mutable parser)
    // `depth: int = 0`: the checker holds the value to the constant rule (D115).
    let defaultValue: Option<Expr> = None
    if (accept(mutable parser, SYMBOL_EQUALS)) {
      defaultValue = Some(parseExpr(mutable parser))
    }
    const paramId = newId(mutable parser)
    parser.facts.namePositions[paramId] = getPos(paramNameToken)
    Arrays.push(mutable parameters, Param {
      id: paramId,
      pos: paramPos,
      name: paramName,
      isMutable: isMutable,
      type: Some(paramType),
      escaping: escaping,
      default: defaultValue,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getIdKey(paramId), paramStart)
    }
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  let result: Option<TypeExpr> = None
  if (accept(mutable parser, SYMBOL_COLON)) {
    result = Some(parseResultType(mutable parser))
    // `Generator<string> uses io, alloc {`: the type's list ended at its one effect.
    if (isAt(parser, SYMBOL_COMMA)) {
      const commaIndex = parser.index
      reportTypeUsesComma(mutable parser, commaIndex)
    }
  }
  const effects = parseUsesList(mutable parser)
  return FuncDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters.names,
    bounds: typeParameters.bounds,
    exported: exported,
    generator: generator,
    parameters: parameters,
    result: result,
    effects: effects,
    effectParameters: typeParameters.effects,
    constantParameters: typeParameters.constants,
    body: None,
  }
}

function reportOptionalParameter(mutable parser: Parser, name: string, isArrow: bool) {
  // `name?: T` becomes `name: Option<T> = None`; the fix keeps the written type.
  const question = getPos(advance(mutable parser))
  expect(mutable parser, SYMBOL_COLON)
  const typeStart = parser.index
  const typePos = getPos(currentToken(parser))
  parseType(mutable parser)
  if (!isOk(parser)) {
    return
  }
  let typeText = ""
  for (const index of Ranges.between(typeStart, parser.index)) {
    typeText = `${typeText}${parser.tokens[index].text}`
    if (parser.tokens[index].text == ",") {
      typeText = `${typeText} `
    }
  }
  // An arrow function parameter takes no default, so it becomes `name: Option<T>`.
  if (isArrow) {
    failAt(
      mutable parser,
      question,
      "E1216",
      `an arrow function parameter cannot be optional; write ${quoteGo(`${name}: Option<${typeText}>`)}`,
    )
    return
  }
  const written = `${name}: Option<${typeText}> = None`
  // With a default written after the type, `name?: T = value`, no edit fits, so there is no fix.
  let fixes: Array<Fix> = []
  if (!isAt(parser, SYMBOL_EQUALS)) {
    const edits = [
      createEdit(question, moveColumn(question, 1), ""),
      insertAt(typePos, "Option<"),
      insertAt(getEndPos(parser), "> = None"),
    ]
    fixes = [createFix(`write ${written}`, edits)]
  }
  failAtFix(
    mutable parser,
    question,
    "E1216",
    fixes,
    `optional parameters are written with a default; write ${quoteGo(written)}`,
  )
}

function parseFieldList(mutable parser: Parser): Array<FieldDecl> {
  let fields: Array<FieldDecl> = []
  skipNewlines(mutable parser)
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    const pos = getPos(currentToken(parser))
    const fieldStart = parser.index
    const name = expectIdent(mutable parser).text
    expect(mutable parser, SYMBOL_COLON)
    const fieldType = parseType(mutable parser)
    let defaultValue: Option<Expr> = None
    if (accept(mutable parser, SYMBOL_EQUALS)) {
      defaultValue = Some(parseExpr(mutable parser))
    }
    Arrays.push(mutable fields, FieldDecl {
      pos: pos,
      name: name,
      type: fieldType,
      default: defaultValue,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("f", pos), fieldStart)
    }
    accept(mutable parser, SYMBOL_COMMA)
    skipNewlines(mutable parser)
  }
  return fields
}

function parseAliasDecl(mutable parser: Parser, exported: bool): AliasDecl {
  const pos = getPos(advance(mutable parser))
  const name = expectIdent(mutable parser).text
  const typeParameters = parseTypeDeclParams(mutable parser, false, false).names
  expect(mutable parser, SYMBOL_EQUALS)
  const body = parseType(mutable parser)
  endTypeDecl(mutable parser)
  return AliasDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters,
    exported: exported,
    body: body,
  }
}

function parseStructDecl(mutable parser: Parser, exported: bool): StructDecl {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_STRUCT))
  const name = expectIdent(mutable parser).text
  const typeParameters = parseTypeDeclParams(mutable parser, true, true)
  const traitLists = parseTraitLists(mutable parser)
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  const fields = parseFieldList(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return StructDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters.names,
    bounds: typeParameters.bounds,
    constantParameters: typeParameters.constants,
    exported: exported,
    implementations: traitLists.implementations,
    derived: traitLists.derived,
    fields: fields,
    opaque: false,
  }
}

function parseEnumDecl(mutable parser: Parser, exported: bool): EnumDecl {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_ENUM))
  const name = expectIdent(mutable parser).text
  const typeParameters = parseTypeDeclParams(mutable parser, false, true)
  const traitLists = parseTraitLists(mutable parser)
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let variants: Array<VariantDecl> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    const variantPos = getPos(currentToken(parser))
    const variantStart = parser.index
    const variantName = expectIdent(mutable parser).text
    let fields: Array<FieldDecl> = []
    if (accept(mutable parser, SYMBOL_LEFT_PAREN)) {
      while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_PAREN)) {
        const fieldPos = getPos(currentToken(parser))
        const fieldStart = parser.index
        const fieldName = expectIdent(mutable parser).text
        expect(mutable parser, SYMBOL_COLON)
        const fieldType = parseType(mutable parser)
        Arrays.push(mutable fields, FieldDecl {
          pos: fieldPos,
          name: fieldName,
          type: fieldType,
          default: None,
        })
        if (parser.collector.enabled) {
          noteKey(mutable parser, getPosKey("f", fieldPos), fieldStart)
        }
        if (!accept(mutable parser, SYMBOL_COMMA)) {
          break
        }
      }
      expect(mutable parser, SYMBOL_RIGHT_PAREN)
    }
    Arrays.push(mutable variants, VariantDecl {
      pos: variantPos,
      name: variantName,
      fields: fields,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("v", variantPos), variantStart)
    }
    accept(mutable parser, SYMBOL_COMMA)
    skipNewlines(mutable parser)
  }
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return EnumDecl {
    pos: pos,
    name: name,
    typeParameters: typeParameters.names,
    bounds: typeParameters.bounds,
    exported: exported,
    implementations: traitLists.implementations,
    derived: traitLists.derived,
    variants: variants,
  }
}

function parseTraitLists(mutable parser: Parser): TraitLists {
  let implementations: Array<TypeExpr> = []
  let derived: Array<TypeExpr> = []
  if (accept(mutable parser, SYMBOL_KEYWORD_IMPLEMENTS)) {
    implementations = parseTraitNames(mutable parser)
  }
  if (accept(mutable parser, SYMBOL_KEYWORD_DERIVES)) {
    derived = parseTraitNames(mutable parser)
  }
  return TraitLists { implementations: implementations, derived: derived }
}

function parseTraitNames(mutable parser: Parser): Array<TypeExpr> {
  let traits: Array<TypeExpr> = []
  while (isOk(parser)) {
    const traitStart = parser.index
    const token = expectIdent(mutable parser)
    const traitType = createNamedType(token)
    Arrays.push(mutable traits, traitType)
    noteType(mutable parser, traitStart, traitType)
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  return traits
}

function parseTraitDecl(mutable parser: Parser, exported: bool): TraitDecl {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_TRAIT))
  const name = expectIdent(mutable parser).text
  if (isAt(parser, SYMBOL_LESS)) {
    failHere(
      mutable parser,
      "E0023",
      "a trait has no type parameters; use Self for the implementing type",
    )
  }
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let functions: Array<FuncDecl> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    if (!isAt(parser, SYMBOL_KEYWORD_FUNCTION)) {
      failFound(mutable parser, "E0024", `a trait has functions only`)
      break
    }
    const functionStart = parser.index
    rejectNestedGenerator(mutable parser)
    const header = parseFuncHeader(mutable parser, false)
    if (isContractLine(parser, "requires")) {
      skipNewlines(mutable parser)
      failHere(
        mutable parser,
        "E0984",
        "requires needs a function body; a trait function has none, so state it on the implementations",
      )
    }
    if (isContractLine(parser, "ensures")) {
      skipNewlines(mutable parser)
      failHere(
        mutable parser,
        "E0987",
        "ensures needs a function body; a trait function has none, so state it on the implementations",
      )
    }
    if (isAt(parser, SYMBOL_LEFT_BRACE)) {
      failHere(
        mutable parser,
        "E0025",
        "trait functions have no default implementation; remove the body",
      )
    }
    Arrays.push(mutable functions, header)
    endTypeDecl(mutable parser)
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("d", header.pos), functionStart)
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return TraitDecl { pos: pos, name: name, exported: exported, functions: functions }
}

function rejectNestedGenerator(mutable parser: Parser) {
  // A generator is a top-level function, so `function*` in a trait or an implement block is rejected.
  const next = peekToken(parser, 1)
  if (next.kind == TokenKind.TokPunct && next.text == "*") {
    failAt(
      mutable parser,
      getPos(next),
      "E0046",
      "a generator must be a top-level function; declare `function*` at module level",
    )
  }
}

function parseImplDecl(mutable parser: Parser): ImplDecl {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_IMPLEMENT))
  const traitStart = parser.index
  const token = expectIdent(mutable parser)
  const traitType = createNamedType(token)
  noteType(mutable parser, traitStart, traitType)
  expect(mutable parser, SYMBOL_KEYWORD_FOR)
  const declaredType = parseType(mutable parser)
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let functions: Array<FuncDecl> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    // A member may be @trusted, to wrap unsafe code.
    const functionStart = parser.index
    const attributes = parseAttributeList(mutable parser)
    for (const attribute of Arrays.values(attributes)) {
      if (isOk(parser) && attribute.name != "trusted") {
        failAt(
          mutable parser,
          attribute.pos,
          "E0990",
          `\`@${attribute.name}\` is not allowed in an implement block; only @trusted is`,
        )
      }
    }
    if (isAt(parser, SYMBOL_KEYWORD_EXPORT)) {
      failHere(mutable parser, "E0026", "functions in an implement block cannot be exported")
      break
    }
    if (!isAt(parser, SYMBOL_KEYWORD_FUNCTION)) {
      failFound(mutable parser, "E0027", `an implement block has functions only`)
      break
    }
    rejectNestedGenerator(mutable parser)
    const parsedFunction = parseFuncDecl(mutable parser, false)
    const implFunction = FuncDecl { ...parsedFunction, attributes: attributes }
    Arrays.push(mutable functions, implFunction)
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("d", implFunction.pos), functionStart)
    }
    skipNewlines(mutable parser)
  }
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return ImplDecl { pos: pos, traitType: traitType, type: declaredType, functions: functions }
}

function parseFuncType(mutable parser: Parser): TypeExpr {
  // Parameter names are optional and ignored.
  const pos = getPos(expect(mutable parser, SYMBOL_LEFT_PAREN))
  let arguments: Array<TypeExpr> = []
  let names: Array<string> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_PAREN)) {
    const colon = peekToken(parser, 1)
    let name = ""
    if (
      currentToken(parser).kind == TokenKind.TokIdent &&
        colon.kind == TokenKind.TokPunct &&
        colon.text == ":"
    ) {
      name = advance(mutable parser).text
      advance(mutable parser)
    }
    Arrays.push(mutable names, name)
    Arrays.push(mutable arguments, parseType(mutable parser))
    if (isAt(parser, SYMBOL_EQUALS)) {
      failHere(mutable parser, "E1213", "a function type cannot have parameter defaults")
    }
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  expect(mutable parser, SYMBOL_ARROW)
  const result = parseResultType(mutable parser)
  const effects = parseTypeUses(mutable parser)
  return TypeExpr {
    pos: pos,
    name: "",
    arguments: arguments,
    isFunc: true,
    result: Some(Boxes.new(result)),
    effects: effects,
    isTuple: false,
    parameterNames: names,
  }
}

function parseResultType(mutable parser: Parser): TypeExpr {
  // A result type may name the parameter it shares: `: Array<T> from items`.
  const result = parseType(mutable parser)
  parser.facts.resultEnds[getPosKey("r", result.pos)] = getEndPos(parser)
  if (!accept(mutable parser, SYMBOL_KEYWORD_FROM)) {
    return result
  }
  if (currentToken(parser).kind != TokenKind.TokIdent) {
    failFound(mutable parser, "E0047", "`from` needs the name of a parameter")
    return result
  }
  const name = advance(mutable parser)
  parser.facts.fromNames[getPosKey("r", result.pos)] = getPos(name)
  return TypeExpr { ...result, resultFrom: name.text }
}

function parseUsesList(mutable parser: Parser): Array<string> {
  // A declaration's own list is a bare comma list: `uses io, alloc`.
  let names: Array<string> = []
  if (accept(mutable parser, SYMBOL_KEYWORD_USES)) {
    while (isOk(parser)) {
      const effect = expectIdent(mutable parser)
      reportRepeatedEffect(mutable parser, names, effect)
      Arrays.push(mutable names, effect.text)
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
    }
  }
  return names
}

function parseTypeUses(mutable parser: Parser): Array<string> {
  // A type's list is one effect or a list in parentheses, so a `,` after it ends the type.
  let names: Array<string> = []
  if (!accept(mutable parser, SYMBOL_KEYWORD_USES)) {
    return names
  }
  if (!accept(mutable parser, SYMBOL_LEFT_PAREN)) {
    Arrays.push(mutable names, expectIdent(mutable parser).text)
    return names
  }
  while (isOk(parser)) {
    const effect = expectIdent(mutable parser)
    reportRepeatedEffect(mutable parser, names, effect)
    Arrays.push(mutable names, effect.text)
    // A trailing comma may come before the `)`.
    if (!accept(mutable parser, SYMBOL_COMMA) || isAt(parser, SYMBOL_RIGHT_PAREN)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  return names
}

function reportRepeatedEffect(mutable parser: Parser, names: Array<string>, effect: Token) {
  // Each effect is named once in a list, so a repeated one is a typo.
  for (const name of Arrays.values(names)) {
    if (name == effect.text) {
      failAt(
        mutable parser,
        getPos(effect),
        "E1242",
        `\`${effect.text}\` is listed twice in this \`uses\` list`,
      )
    }
  }
}

function reportTypeUsesComma(mutable parser: Parser, commaIndex: int) {
  // Only a `,` right after `uses name` reads as a list the type cannot hold.
  if (commaIndex < 2 || commaIndex + 1 >= Arrays.length(parser.tokens)) {
    return
  }
  const comma = parser.tokens[commaIndex]
  const effect = parser.tokens[commaIndex - 1]
  const next = parser.tokens[commaIndex + 1]
  if (
    comma.symbol != SYMBOL_COMMA ||
      effect.kind != TokenKind.TokIdent ||
      parser.tokens[commaIndex - 2].symbol != SYMBOL_KEYWORD_USES ||
      next.kind != TokenKind.TokIdent
  ) {
    return
  }
  failAt(
    mutable parser,
    getPos(comma),
    "E1240",
    `a type's \`uses\` list takes one effect, or several in parentheses: \`uses (${effect.text}, ${next.text})\``,
  )
}

function acceptEscaping(mutable parser: Parser): bool {
  // `escaping` is not a keyword, so a parameter can still be named escaping.
  const token = currentToken(parser)
  if (
    token.kind == TokenKind.TokIdent &&
      token.text == "escaping" &&
      peekToken(parser, 1).kind == TokenKind.TokIdent
  ) {
    advance(mutable parser)
    return true
  }
  return false
}

// ---- Statements

function isArrowAhead(parser: Parser): bool {
  let depth = 0
  let index = parser.index
  const count = Arrays.length(parser.tokens)
  while (index < count) {
    const token = parser.tokens[index]
    if (token.kind == TokenKind.TokEof) {
      return false
    }
    if (token.kind == TokenKind.TokPunct) {
      if (token.text == "(") {
        depth++
      } else if (token.text == ")") {
        depth--
        if (depth == 0) {
          if (index + 1 >= count || parser.tokens[index + 1].kind != TokenKind.TokPunct) {
            return false
          }
          const after = parser.tokens[index + 1].text
          if (after == ":") {
            return isResultTypeThenArrow(parser, index + 2)
          }
          return after == "=>"
        }
      }
    }
    index++
  }
  return false
}

function isResultTypeThenArrow(parser: Parser, start: int): bool {
  // This tells an arrow's `: R =>` from the `:` of a conditional expression such as `c ? (a) : b`: from the token after the `:`, look for a `=>` outside brackets before anything that ends an expression.
  let depth = 0
  let index = start
  const count = Arrays.length(parser.tokens)
  while (index < count) {
    const token = parser.tokens[index]
    if (token.kind == TokenKind.TokNewline || token.kind == TokenKind.TokEof) {
      return false
    }
    if (token.kind == TokenKind.TokPunct) {
      if (token.text == "(" || token.text == "[" || token.text == "<") {
        depth++
      } else if (token.text == ")" || token.text == "]" || token.text == ">") {
        depth--
      } else if (token.text == ">>") {
        depth -= 2
      } else if (token.text == "=>" && depth == 0) {
        return true
      } else if (
        depth == 0 &&
          (token.text == "?" ||
            token.text == ":" ||
            token.text == "," ||
            token.text == "{" ||
            token.text == "}" ||
            token.text == ";")
      ) {
        return false
      }
      if (depth < 0) {
        return false
      }
    }
    index++
  }
  return false
}

function parseArrow(mutable parser: Parser): Expr {
  const pos = getPos(expect(mutable parser, SYMBOL_LEFT_PAREN))
  let parameters: Array<Param> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_PAREN)) {
    if (isAt(parser, SYMBOL_KEYWORD_MUTABLE)) {
      failHere(mutable parser, "E0028", "arrow function parameters cannot be mutable")
      return createDummyExpr()
    }
    const paramPos = getPos(currentToken(parser))
    const paramStart = parser.index
    const paramName = expectIdent(mutable parser).text
    if (isAt(parser, SYMBOL_QUESTION)) {
      reportOptionalParameter(mutable parser, paramName, true)
      return createDummyExpr()
    }
    // Parameter types may be left out.
    let paramType: Option<TypeExpr> = None
    if (accept(mutable parser, SYMBOL_COLON)) {
      paramType = Some(parseType(mutable parser))
    }
    if (isAt(parser, SYMBOL_EQUALS)) {
      failHere(mutable parser, "E1213", "an arrow function parameter cannot have a default")
      return createDummyExpr()
    }
    const paramId = newId(mutable parser)
    Arrays.push(mutable parameters, Param {
      id: paramId,
      pos: paramPos,
      name: paramName,
      isMutable: false,
      type: paramType,
      escaping: false,
    })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getIdKey(paramId), paramStart)
    }
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  let result: Option<TypeExpr> = None
  if (accept(mutable parser, SYMBOL_COLON)) {
    result = Some(parseResultType(mutable parser))
  }
  expect(mutable parser, SYMBOL_ARROW)
  const savedResult = parser.resultFunction
  parser.resultFunction = false
  if (isAt(parser, SYMBOL_LEFT_BRACE)) {
    const block = parseBlock(mutable parser)
    parser.resultFunction = savedResult
    return Expr.ArrowExpr(newId(mutable parser), pos, parameters, result, None, Some(block))
  }
  const body = parseExpr(mutable parser)
  parser.facts.valueEnds[getExprId(body)] = getEndPos(parser)
  parser.resultFunction = savedResult
  return Expr.ArrowExpr(newId(mutable parser), pos, parameters, result, Some(body), None)
}

function parseBlock(mutable parser: Parser): Block {
  const startIndex = parser.index
  const pos = getPos(expect(mutable parser, SYMBOL_LEFT_BRACE))
  skipNewlines(mutable parser)
  let statements: Array<Stmt> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    if (currentToken(parser).kind == TokenKind.TokEof) {
      failHere(mutable parser, "E0029", "unexpected end of file inside a block")
      break
    }
    Arrays.push(mutable statements, parseStmt(mutable parser))
  }
  const end = getPos(currentToken(parser))
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("b", pos), startIndex)
  }
  return Block { pos: pos, end: end, statements: statements }
}

function parseLoopExitLabel(mutable parser: Parser): string {
  if (currentToken(parser).kind == TokenKind.TokIdent) {
    return advance(mutable parser).text
  }
  return ""
}

function isMarkedEntries(parser: Parser): bool {
  // The marker form over Arrays.entries: `for (const #[index, mutable item] of ...)`.
  const pattern = peekToken(parser, 1)
  const index = peekToken(parser, 2)
  const comma = peekToken(parser, 3)
  const marker = peekToken(parser, 4)
  return isAt(parser, SYMBOL_KEYWORD_CONST) &&
    pattern.kind == TokenKind.TokPunct &&
    pattern.text == "#[" &&
    index.kind == TokenKind.TokIdent &&
    comma.kind == TokenKind.TokPunct &&
    comma.text == "," &&
    marker.kind == TokenKind.TokKeyword &&
    marker.text == "mutable"
}

function parseReferenceFor(
  mutable parser: Parser,
  pos: Pos,
  awaitPos: Option<Pos>,
): Stmt from pos uses alloc {
  // The head is not desugared into a declaration, which would copy the element.
  let indexName = ""
  let indexPos = pos
  if (accept(mutable parser, SYMBOL_KEYWORD_CONST)) {
    expect(mutable parser, SYMBOL_HASH_BRACKET)
    const indexToken = expectIdent(mutable parser)
    indexName = indexToken.text
    indexPos = getPos(indexToken)
    expect(mutable parser, SYMBOL_COMMA)
  }
  expect(mutable parser, SYMBOL_KEYWORD_MUTABLE)
  const nameToken = expectIdent(mutable parser)
  if (indexName != "") {
    expect(mutable parser, SYMBOL_RIGHT_BRACKET)
  }
  expect(mutable parser, SYMBOL_KEYWORD_OF)
  const iterable = parseExpr(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  const body = parseBlock(mutable parser)
  skipNewlines(mutable parser)

  // The index local and the loop's own local get node ids after the body,
  // as for the other `for` forms.
  let indexId = -1
  if (indexName != "") {
    indexId = newId(mutable parser)
    parser.facts.namePositions[indexId] = copy(indexPos)
  }
  const forId = newId(mutable parser)
  parser.facts.namePositions[forId] = getPos(nameToken)
  const reference = LoopReference { indexId: indexId, indexName: indexName }
  return Stmt.ForStmt(
    forId,
    pos,
    "",
    nameToken.text,
    iterable,
    body,
    Some(reference),
    copy(awaitPos),
  )
}

function parseForAwait(mutable parser: Parser): Option<Pos> uses alloc {
  // `for await`: the keyword gets a trivia node of its own, so a comment on
  // either side of it stays there.
  if (!isAt(parser, SYMBOL_KEYWORD_AWAIT)) {
    return None
  }
  const awaitIndex = parser.index
  const awaitPos = getPos(advance(mutable parser))
  noteKey(mutable parser, getPosKey("k", awaitPos), awaitIndex)
  return Some(awaitPos)
}

function parseLabeledStmt(mutable parser: Parser): Stmt uses alloc {
  const labelToken = advance(mutable parser)
  const labelPos = getPos(labelToken)
  advance(mutable parser)
  if (!isAt(parser, SYMBOL_KEYWORD_FOR) && !isAt(parser, SYMBOL_KEYWORD_WHILE)) {
    failAt(
      mutable parser,
      labelPos,
      "E0918",
      `label "${labelToken.text}" must be on a for or while loop`,
    )
    return Stmt.BreakStmt(labelPos, "")
  }
  const loop = parseStmtBody(mutable parser)
  if (loop is Stmt.WhileStmt(_, _, condition, body)) {
    return Stmt.WhileStmt(labelPos, labelToken.text, condition, body)
  }
  if (loop is Stmt.CForStmt(_, _, init, condition, step, body)) {
    return Stmt.CForStmt(labelPos, labelToken.text, init, condition, step, body)
  }
  if (loop is Stmt.ForStmt(nodeId, _, _, name, iterable, body, reference, awaitPos)) {
    return Stmt.ForStmt(
      nodeId,
      labelPos,
      labelToken.text,
      name,
      iterable,
      body,
      reference,
      awaitPos,
    )
  }
  return loop
}

function parseCStyleForHead(
  mutable parser: Parser,
  pos: Pos,
  keywordPos: Pos,
  isMutable: bool,
): Stmt from pos uses alloc {
  parser.forHead = true
  const nameToken = expectIdent(mutable parser)
  const namePos = getPos(nameToken)
  if (!isMutable) {
    failAt(
      mutable parser,
      namePos,
      "E0960",
      "the first part of a for loop must be `let`, because the step changes it",
    )
    return Stmt.BreakStmt(pos, "")
  }
  let declaredType: Option<TypeExpr> = None
  if (accept(mutable parser, SYMBOL_COLON)) {
    declaredType = Some(parseType(mutable parser))
  }
  expect(mutable parser, SYMBOL_EQUALS)
  const value = parseExpr(mutable parser)
  const varId = newId(mutable parser)
  parser.facts.namePositions[varId] = namePos
  const declaration = Stmt.VarStmt(
    varId,
    keywordPos,
    true,
    nameToken.text,
    None,
    declaredType,
    value,
  )
  return parseCStyleFor(mutable parser, pos, Some(declaration))
}

function parseStatementExpr(mutable parser: Parser): Expr uses alloc {
  // A closure body inside the expression parses statements of its own, so put
  // back the start of the enclosing statement afterwards.
  const enclosingStart = parser.statementStart
  parser.statementStart = parser.index
  const expression = parseExpr(mutable parser)
  parser.statementStart = enclosingStart
  return expression
}

function parseCStyleFor(
  mutable parser: Parser,
  pos: Pos,
  init: Option<Stmt>,
): Stmt from pos uses alloc {
  parser.forHead = true
  expect(mutable parser, SYMBOL_SEMICOLON)
  // An empty condition loops forever.
  let condition: Option<Expr> = None
  if (!isAt(parser, SYMBOL_SEMICOLON)) {
    condition = Some(parseExpr(mutable parser))
  }
  expect(mutable parser, SYMBOL_SEMICOLON)
  // The step is an assignment or a call.
  let step: Option<Stmt> = None
  if (!isAt(parser, SYMBOL_RIGHT_PAREN)) {
    const stepToken = currentToken(parser)
    const stepPos = getPos(stepToken)
    const target = parseStatementExpr(mutable parser)
    if (accept(mutable parser, SYMBOL_EQUALS)) {
      step = Some(Stmt.AssignStmt(stepPos, target, parseExpr(mutable parser)))
    } else if (parseCompoundTail(mutable parser, stepPos, target) is Some(compound)) {
      step = Some(compound)
    } else if (target is Expr.CallExpr(_, _, _, _, _)) {
      step = Some(Stmt.ExprStmt(stepPos, target))
    } else {
      failAt(
        mutable parser,
        stepPos,
        "E0961",
        "the last part of a for loop must be an assignment or a call",
      )
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  parser.forHead = false
  const body = parseBlock(mutable parser)
  skipNewlines(mutable parser)
  return copy(Stmt.CForStmt(pos, "", init, condition, step, body))
}

function parseStmt(mutable parser: Parser): Stmt {
  const startIndex = parser.index
  const statement = parseStmtBody(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("s", getStmtPos(statement)), startIndex)
  }
  return statement
}

function parseStmtBody(mutable parser: Parser): Stmt {
  const token = currentToken(parser)
  const pos = getPos(token)
  const following = peekToken(parser, 1)
  if (
    token.kind == TokenKind.TokIdent &&
      following.kind == TokenKind.TokPunct &&
      following.text == ":"
  ) {
    return parseLabeledStmt(mutable parser)
  }
  // a nested function declaration, also async function
  if (
    isAt(parser, SYMBOL_KEYWORD_ASYNC) &&
      following.kind == TokenKind.TokKeyword &&
      following.text == "function"
  ) {
    failAt(
      mutable parser,
      getPos(following),
      "E0930",
      "a function inside a function is not supported; declare it at module level as a private function and pass the enclosing values as arguments",
    )
  }
  if (
    token.kind == TokenKind.TokIdent &&
      token.text == "unsafe" &&
      following.kind == TokenKind.TokPunct &&
      following.text == "{"
  ) {
    // `unsafe` is a keyword only before a block, so it stays an effect name.
    advance(mutable parser)
    const block = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    return Stmt.BlockStmt(Block { ...block, isUnsafe: true, keywordPos: Some(pos) })
  }
  if (isAt(parser, SYMBOL_KEYWORD_FUNCTION)) {
    failAt(
      mutable parser,
      pos,
      "E0930",
      "a function inside a function is not supported; declare it at module level as a private function and pass the enclosing values as arguments",
    )
  }
  if (isAt(parser, SYMBOL_KEYWORD_CONST) || isAt(parser, SYMBOL_KEYWORD_LET)) {
    const isMutable = advance(mutable parser).text == "let"
    const after = peekToken(parser, 1)
    const isConstructor =
      currentToken(parser).kind == TokenKind.TokIdent &&
        after.kind == TokenKind.TokPunct &&
        (after.text == "(" || after.text == ".")
    const namePos = getPos(currentToken(parser))
    let name = ""
    let pattern: Option<Pattern> = None
    if (
      isAt(parser, SYMBOL_LEFT_BRACE) ||
        isAt(parser, SYMBOL_HASH_BRACKET) ||
        isAt(parser, SYMBOL_LEFT_BRACKET) ||
        isConstructor
    ) {
      pattern = Some(parsePattern(mutable parser))
    } else {
      name = expectIdent(mutable parser).text
    }
    let declaredType: Option<TypeExpr> = None
    if (accept(mutable parser, SYMBOL_COLON)) {
      declaredType = Some(parseType(mutable parser))
    }
    expect(mutable parser, SYMBOL_EQUALS)
    if (startsLazyValue(parser)) {
      failHere(
        mutable parser,
        "E1032",
        "`lazy` is written only on the value of a top-level `const`",
      )
      return Stmt.BreakStmt(pos, "")
    }
    if (
      isAt(parser, SYMBOL_KEYWORD_YIELD) &&
        name != "" &&
        declaredType is None &&
        !(peekToken(parser, 1).kind == TokenKind.TokPunct && peekToken(parser, 1).text == "*")
    ) {
      // `const input = yield value` in a coroutine.
      const yieldPos = getPos(currentToken(parser))
      advance(mutable parser)
      const next = currentToken(parser)
      if (
        next.kind == TokenKind.TokNewline ||
          next.kind == TokenKind.TokEof ||
          isAt(parser, SYMBOL_RIGHT_BRACE)
      ) {
        failHere(
          mutable parser,
          "E0046",
          "`yield` needs a value: write `yield value`, or `yield* generator`",
        )
        return Stmt.BreakStmt(pos, "")
      }
      const yielded = parseExpr(mutable parser)
      endStatement(mutable parser)
      const binding = YieldBinding {
        id: newId(mutable parser),
        isMutable: isMutable,
        name: name,
        pos: pos,
      }
      return Stmt.YieldStmt(yieldPos, yielded, false, Some(binding))
    }
    const value = parseExpr(mutable parser)
    parser.facts.valueEnds[getExprId(value)] = getEndPos(parser)
    endStatement(mutable parser)
    const varId = newId(mutable parser)
    parser.facts.namePositions[varId] = namePos
    return Stmt.VarStmt(varId, pos, isMutable, name, pattern, declaredType, value)
  }
  if (isAt(parser, SYMBOL_KEYWORD_RETURN)) {
    advance(mutable parser)
    let value: Option<Expr> = None
    if (currentToken(parser).kind != TokenKind.TokNewline && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
      const returned = parseExpr(mutable parser)
      parser.facts.valueEnds[getExprId(returned)] = getEndPos(parser)
      if (isTernary(parser, returned)) {
        endStatement(mutable parser)
        return convertReturnedTernary(mutable parser, returned)
      }
      value = Some(returned)
    }
    endStatement(mutable parser)
    return Stmt.ReturnStmt(pos, value)
  }
  if (isAt(parser, SYMBOL_KEYWORD_IF)) {
    return parseIf(mutable parser)
  }
  if (isAt(parser, SYMBOL_KEYWORD_WHILE)) {
    advance(mutable parser)
    expect(mutable parser, SYMBOL_LEFT_PAREN)
    const condition = parseExpr(mutable parser)
    expect(mutable parser, SYMBOL_RIGHT_PAREN)
    const body = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    return Stmt.WhileStmt(pos, "", condition, body)
  }
  if (isAt(parser, SYMBOL_KEYWORD_FOR)) {
    advance(mutable parser)
    const awaitPos = parseForAwait(mutable parser)
    expect(mutable parser, SYMBOL_LEFT_PAREN)
    if (isAt(parser, SYMBOL_KEYWORD_MUTABLE) || isMarkedEntries(parser)) {
      return parseReferenceFor(mutable parser, pos, awaitPos)
    }
    if (awaitPos is Some(written)) {
      if (!isAt(parser, SYMBOL_KEYWORD_CONST)) {
        failHere(mutable parser, "E0030", "write `for await (const item of stream)`")
        return Stmt.BreakStmt(written, "")
      }
    }
    if (isAt(parser, SYMBOL_SEMICOLON)) {
      return parseCStyleFor(mutable parser, pos, None)
    }
    if (!isAt(parser, SYMBOL_KEYWORD_CONST) && !isAt(parser, SYMBOL_KEYWORD_LET)) {
      failHere(mutable parser, "E0030", "write `for (const item of items)`")
      return Stmt.BreakStmt(pos, "")
    }
    const keywordPos = getPos(currentToken(parser))
    const isMutable = advance(mutable parser).text == "let"
    const headPos = getPos(currentToken(parser))
    const after = peekToken(parser, 1)
    if (
      currentToken(parser).kind == TokenKind.TokIdent &&
        after.kind == TokenKind.TokPunct &&
        (after.text == "=" || after.text == ":")
    ) {
      return parseCStyleForHead(mutable parser, pos, keywordPos, isMutable)
    }
    const isConstructor =
      currentToken(parser).kind == TokenKind.TokIdent &&
        after.kind == TokenKind.TokPunct &&
        (after.text == "(" || after.text == ".")
    let name = ""
    let pattern: Option<Pattern> = None
    if (
      isAt(parser, SYMBOL_LEFT_BRACE) ||
        isAt(parser, SYMBOL_HASH_BRACKET) ||
        isAt(parser, SYMBOL_LEFT_BRACKET) ||
        isConstructor
    ) {
      pattern = Some(parsePattern(mutable parser))
    } else {
      name = expectIdent(mutable parser).text
    }
    if (isWord(parser, "in")) {
      failHere(mutable parser, "E0031", "use `of`; `for ... in` is not part of the language")
      return Stmt.BreakStmt(pos, "")
    }
    expect(mutable parser, SYMBOL_KEYWORD_OF)
    const iterable = parseExpr(mutable parser)
    expect(mutable parser, SYMBOL_RIGHT_PAREN)
    let body = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    if (isMutable || pattern is Some(_)) {
      // for (const <pattern> of xs) body becomes
      // for (const __for_L_C of xs) { const <pattern> = __for_L_C; body }
      // where L and C are the line and column of the pattern. A user name
      // cannot clash with it because each loop has its own position.
      const hidden = `__for_${Int.toString(headPos.line)}_${Int.toString(headPos.column)}`
      const declarationId = newId(mutable parser)
      const hiddenId = newId(mutable parser)
      const declaration = Stmt.VarStmt(
        declarationId,
        headPos,
        isMutable,
        name,
        pattern,
        None,
        Expr.Ident(hiddenId, headPos, hidden),
      )
      let statements: Array<Stmt> = [declaration]
      for (const statement of Arrays.values(body.statements)) {
        Arrays.push(mutable statements, statement)
      }
      body = Block { pos: body.pos, end: body.end, statements: statements }
      name = hidden
    }
    const forId = newId(mutable parser)
    parser.facts.namePositions[forId] = headPos
    return Stmt.ForStmt(forId, pos, "", name, iterable, body, None, awaitPos)
  }
  if (isAt(parser, SYMBOL_KEYWORD_YIELD)) {
    advance(mutable parser)
    const delegate = accept(mutable parser, SYMBOL_STAR)
    const next = currentToken(parser)
    if (
      next.kind == TokenKind.TokNewline ||
        next.kind == TokenKind.TokEof ||
        isAt(parser, SYMBOL_RIGHT_BRACE)
    ) {
      failHere(
        mutable parser,
        "E0046",
        "`yield` needs a value: write `yield value`, or `yield* generator`",
      )
      return Stmt.BreakStmt(pos, "")
    }
    const value = parseExpr(mutable parser)
    endStatement(mutable parser)
    return Stmt.YieldStmt(pos, value, delegate, None)
  }
  if (isAt(parser, SYMBOL_KEYWORD_BREAK)) {
    advance(mutable parser)
    const label = parseLoopExitLabel(mutable parser)
    endStatement(mutable parser)
    return Stmt.BreakStmt(pos, label)
  }
  if (isAt(parser, SYMBOL_KEYWORD_CONTINUE)) {
    advance(mutable parser)
    const label = parseLoopExitLabel(mutable parser)
    endStatement(mutable parser)
    return Stmt.ContinueStmt(pos, label)
  }
  if (isAt(parser, SYMBOL_LEFT_BRACE)) {
    failAt(mutable parser, pos, "E0032", "a block must belong to a statement such as if or while")
    return Stmt.BreakStmt(pos, "")
  }
  const expression = parseStatementExpr(mutable parser)
  if (accept(mutable parser, SYMBOL_EQUALS)) {
    const value = parseExpr(mutable parser)
    parser.facts.valueEnds[getExprId(value)] = getEndPos(parser)
    endStatement(mutable parser)
    return Stmt.AssignStmt(pos, expression, value)
  }
  if (parseCompoundTail(mutable parser, pos, expression) is Some(compound)) {
    endStatement(mutable parser)
    return compound
  }
  if (expression is Expr.MatchExpr(_, _, _, _)) {
    skipNewlines(mutable parser)
    return Stmt.ExprStmt(pos, expression)
  }
  endStatement(mutable parser)
  return Stmt.ExprStmt(pos, expression)
}

function parseIf(mutable parser: Parser): Stmt {
  const startIndex = parser.index
  const statement = parseIfBody(mutable parser)
  if (parser.collector.enabled) {
    noteKey(mutable parser, getPosKey("s", getStmtPos(statement)), startIndex)
  }
  return statement
}

function parseIfBody(mutable parser: Parser): Stmt {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_IF))
  expect(mutable parser, SYMBOL_LEFT_PAREN)
  const condition = parseExpr(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  const thenBlock = parseBlock(mutable parser)
  const savedIndex = parser.index
  skipNewlines(mutable parser)
  if (isOk(parser) && accept(mutable parser, SYMBOL_KEYWORD_ELSE)) {
    if (isAt(parser, SYMBOL_KEYWORD_IF)) {
      const rest = parseIf(mutable parser)
      return Stmt.IfStmt(pos, condition, thenBlock, Some(rest))
    }
    const block = parseBlock(mutable parser)
    skipNewlines(mutable parser)
    return Stmt.IfStmt(pos, condition, thenBlock, Some(Stmt.BlockStmt(block)))
  }
  parser.index = savedIndex
  skipNewlines(mutable parser)
  return Stmt.IfStmt(pos, condition, thenBlock, None)
}

// ---- Expressions

function parseExpr(mutable parser: Parser): Expr {
  const startIndex = parser.index
  const expression = parseExprBody(mutable parser)
  noteExpr(mutable parser, startIndex, expression)
  return expression
}

function parseExprBody(mutable parser: Parser): Expr {
  const start = getPos(currentToken(parser))
  const condition = parseBinary(mutable parser, 0)
  // A ternary is looser than `||` and right-associative. It becomes a block expression holding one if statement whose branches each return one value, so only the chosen branch runs.
  if (!isAt(parser, SYMBOL_QUESTION)) {
    return condition
  }
  const pos = getPos(advance(mutable parser))
  const thenValue = parseExpr(mutable parser)
  // Each branch is returned on its own once a returned ternary becomes an if statement.
  parser.facts.valueEnds[getExprId(thenValue)] = getEndPos(parser)
  if (!isAt(parser, SYMBOL_COLON)) {
    // A `:` on the next line is a ternary that spans lines.
    const savedIndex = parser.index
    skipNewlines(mutable parser)
    const spans = isAt(parser, SYMBOL_COLON)
    parser.index = savedIndex
    if (spans) {
      failHere(
        mutable parser,
        "E0934",
        "a conditional expression that spans lines must be wrapped in parentheses, as in `(cond ? a : b)`",
      )
    } else {
      failHere(
        mutable parser,
        "E0934",
        "a conditional expression needs `:` and a second value, as in `cond ? a : b`",
      )
    }
    return createDummyExpr()
  }
  advance(mutable parser)
  const elseValue = parseExpr(mutable parser)
  parser.facts.valueEnds[getExprId(elseValue)] = getEndPos(parser)
  const ifStatement = Stmt.IfStmt(
    pos,
    condition,
    createReturnBlock(thenValue),
    Some(Stmt.BlockStmt(createReturnBlock(elseValue))),
  )
  const ternaryId = newId(mutable parser)
  Arrays.push(mutable parser.ternaryIds, ternaryId)
  // The expression starts at the condition and its block at the `?`, which is
  // how isConditional tells it from a plain block and an `if` value.
  return Expr.BlockExpr(ternaryId, start, Block { pos: pos, end: pos, statements: [ifStatement] })
}

function isTernary(parser: Parser, expression: Expr): bool {
  if (expression is Expr.BlockExpr(expressionId, _, _)) {
    for (const ternaryId of Arrays.values(parser.ternaryIds)) {
      if (ternaryId == expressionId) {
        return true
      }
    }
  }
  return false
}

function getReturnedValue(block: Block): Expr from block {
  if (block.statements[0] is Stmt.ReturnStmt(_, Some(value))) {
    return value
  }
  return createDummyExpr()
}

function convertReturnedTernary(mutable parser: Parser, value: Expr): Stmt from value {
  // `return c ? a : b` becomes `if (c) { return a } else { return b }`, so a self call in a branch is a tail call. A branch that is itself a ternary is turned the same way.
  if (!isTernary(parser, value)) {
    return Stmt.ReturnStmt(getExpressionPos(value), Some(value))
  }
  if (value is Expr.BlockExpr(ternaryId, _, block)) {
    if (parser.collector.enabled) {
      parser.collector.convertedKeys[getIdKey(ternaryId)] = true
    }
    if (
      block.statements[0] is Stmt.IfStmt(pos, condition, thenBlock, Some(Stmt.BlockStmt(elseBlock)))
    ) {
      const thenStatement = convertReturnedTernary(mutable parser, getReturnedValue(thenBlock))
      const elseStatement = convertReturnedTernary(mutable parser, getReturnedValue(elseBlock))
      const newThen = Block { pos: thenBlock.pos, end: thenBlock.end, statements: [thenStatement] }
      const newElse = Block { pos: elseBlock.pos, end: elseBlock.end, statements: [elseStatement] }
      return Stmt.IfStmt(pos, condition, newThen, Some(Stmt.BlockStmt(newElse)))
    }
  }
  return Stmt.ReturnStmt(getExpressionPos(value), Some(value))
}

function parseBinary(mutable parser: Parser, level: int): Expr {
  if (level == Arrays.length(BINARY_LEVELS)) {
    return parseUnary(mutable parser)
  }
  const startIndex = parser.index
  let left = parseBinary(mutable parser, level + 1)
  while (isOk(parser)) {
    const token = currentToken(parser)
    if (level == IS_LEVEL && isAt(parser, SYMBOL_KEYWORD_IS)) {
      advance(mutable parser)
      const pattern = parsePattern(mutable parser)
      left = Expr.IsExpr(newId(mutable parser), getPos(token), left, pattern)
      noteExpr(mutable parser, startIndex, left)
      continue
    }
    if (token.kind != TokenKind.TokPunct) {
      return left
    }
    let matched = false
    for (const operator of Arrays.values(BINARY_LEVELS[level])) {
      if (token.symbol == operator) {
        matched = true
      }
    }
    if (token.symbol == SYMBOL_TRIPLE_EQUAL || token.symbol == SYMBOL_NOT_DOUBLE_EQUAL) {
      const replacement = substring(token.text, 0, 2)
      failAtFix(
        mutable parser,
        getPos(token),
        "E0033",
        [
          createFix(`use ${replacement}`, [
            createEdit(getPos(token), moveColumn(getPos(token), 3), replacement),
          ]),
        ],
        `use \`${substring(token.text, 0, 2)}\`; there is no strict equality operator`,
      )
      return left
    }
    if (!matched) {
      return left
    }
    if (isCompoundOperatorAhead(parser) || isIncrementAhead(parser)) {
      // The statement parser reads the operator; anywhere else it is an error.
      if (startIndex != parser.statementStart) {
        failAt(
          mutable parser,
          getPos(token),
          "E0964",
          "`+=`, `++` and the other compound assignments are statements; they have no value",
        )
      }
      return left
    }
    advance(mutable parser)
    const right = parseBinary(mutable parser, level + 1)
    left = Expr.BinaryExpr(newId(mutable parser), getPos(token), token.text, left, right)
    noteExpr(mutable parser, startIndex, left)
  }
  return left
}

function parseCompoundTail(mutable parser: Parser, pos: Pos, target: Expr): Option<Stmt> from pos {
  if (!isOk(parser)) {
    return None
  }
  if (isCompoundOperatorAhead(parser)) {
    // `target += value`: the operator and the `=` are two tokens.
    const operatorToken = advance(mutable parser)
    advance(mutable parser)
    const value = parseExpr(mutable parser)
    return copy(Some(Stmt.CompoundAssignStmt(pos, target, `${operatorToken.text}=`, value)))
  }
  if (isIncrementAhead(parser)) {
    // `target++`: the value is the implied 1.
    const operatorToken = advance(mutable parser)
    advance(mutable parser)
    const one = Expr.IntLit(newId(mutable parser), getPos(operatorToken), "1")
    const operator = `${operatorToken.text}${operatorToken.text}`
    return copy(Some(Stmt.CompoundAssignStmt(pos, target, operator, one)))
  }
  return None
}

function isCompoundOperatorAhead(parser: Parser): bool {
  const token = currentToken(parser)
  if (token.kind != TokenKind.TokPunct) {
    return false
  }
  const next = peekToken(parser, 1)
  if (next.kind != TokenKind.TokPunct || next.text != "=") {
    return false
  }
  if (next.line != token.line || next.column != token.column + Str.length(token.text)) {
    return false
  }
  for (const operator of Arrays.values(COMPOUND_OPERATORS)) {
    if (token.text == operator) {
      return true
    }
  }
  return false
}

function isIncrementAhead(parser: Parser): bool {
  const token = currentToken(parser)
  if (token.kind != TokenKind.TokPunct || (token.text != "+" && token.text != "-")) {
    return false
  }
  const next = peekToken(parser, 1)
  if (next.kind != TokenKind.TokPunct || next.text != token.text) {
    return false
  }
  if (next.line != token.line || next.column != token.column + 1) {
    return false
  }
  const after = peekToken(parser, 2)
  if (after.kind == TokenKind.TokNewline || after.kind == TokenKind.TokEof) {
    return true
  }
  return after.kind == TokenKind.TokPunct && (after.text == "}" || after.text == ")")
}

function isPrefixIncrementAhead(parser: Parser): bool {
  const token = currentToken(parser)
  if (token.kind != TokenKind.TokPunct || (token.text != "+" && token.text != "-")) {
    return false
  }
  const next = peekToken(parser, 1)
  return next.kind == TokenKind.TokPunct &&
    next.text == token.text &&
    next.line == token.line &&
    next.column == token.column + 1
}

function parseUnary(mutable parser: Parser): Expr {
  const startIndex = parser.index
  const token = currentToken(parser)
  if (isPrefixIncrementAhead(parser)) {
    failAt(
      mutable parser,
      getPos(token),
      "E0964",
      `there is no prefix \`${token.text}${token.text}\`; write \`x${token.text}${token.text}\` as a statement`,
    )
    return Expr.IntLit(newId(mutable parser), getPos(token), "0")
  }
  if (isAt(parser, SYMBOL_KEYWORD_AWAIT)) {
    advance(mutable parser)
    const operand = parseUnary(mutable parser)
    const awaited = Expr.AwaitExpr(newId(mutable parser), getPos(token), operand)
    noteExpr(mutable parser, startIndex, awaited)
    return awaited
  }
  if (isAt(parser, SYMBOL_MINUS) || isAt(parser, SYMBOL_BANG) || isAt(parser, SYMBOL_TILDE)) {
    advance(mutable parser)
    const operand = parseUnary(mutable parser)
    const unary = Expr.UnaryExpr(newId(mutable parser), getPos(token), token.text, operand)
    noteExpr(mutable parser, startIndex, unary)
    return unary
  }
  const expression = parsePrimary(mutable parser)
  return parsePostfix(mutable parser, expression, startIndex)
}

function parsePostfix(mutable parser: Parser, first: Expr, startIndex: int): Expr from first {
  let expression = first
  while (isOk(parser)) {
    const token = currentToken(parser)
    if (isAt(parser, SYMBOL_DOT)) {
      advance(mutable parser)
      const name = parseMemberName(mutable parser)
      expression = Expr.FieldExpr(newId(mutable parser), getPos(name), expression, name.text)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, SYMBOL_LESS) && isTaggedTypeArgsAhead(parser, expression)) {
      failAt(
        mutable parser,
        getPos(token),
        "E1200",
        "a tag takes no type arguments; the tag's parameters give its type",
      )
      return createDummyExpr()
    } else if (isAt(parser, SYMBOL_LESS) && isCallTypeArgsAhead(parser, expression)) {
      // `f<int>(x)`: type arguments of a call.
      const typeArguments = parseLiteralTypeArgs(mutable parser)
      const openParen = expect(mutable parser, SYMBOL_LEFT_PAREN)
      const arguments = parseCallArguments(mutable parser)
      const callId = newId(mutable parser)
      parser.facts.callEnds[callId] = getCallEnd(parser)
      expression = Expr.CallExpr(callId, getPos(openParen), expression, typeArguments, arguments)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, SYMBOL_LEFT_PAREN)) {
      advance(mutable parser)
      const arguments = parseCallArguments(mutable parser)
      const callId = newId(mutable parser)
      parser.facts.callEnds[callId] = getCallEnd(parser)
      expression = Expr.CallExpr(callId, getPos(token), expression, [], arguments)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, SYMBOL_LEFT_BRACKET)) {
      advance(mutable parser)
      const index = parseExpr(mutable parser)
      expect(mutable parser, SYMBOL_RIGHT_BRACKET)
      expression = Expr.IndexExpr(newId(mutable parser), getPos(token), expression, index)
      noteExpr(mutable parser, startIndex, expression)
    } else if (token.kind == TokenKind.TokTemplate && isTemplateOnSameLine(parser)) {
      // `tag`...``: only a name or a dotted name is a tag (D114).
      if (!isTagName(parser, expression)) {
        failAt(
          mutable parser,
          getPos(token),
          "E1200",
          "a template after an expression is a tagged template, and only a name or a dotted name can be its tag",
        )
        return createDummyExpr()
      }
      advance(mutable parser)
      expression = parseTaggedTemplate(mutable parser, expression, token)
      noteExpr(mutable parser, startIndex, expression)
    } else if (isAt(parser, SYMBOL_LESS) || isAt(parser, SYMBOL_LEFT_BRACE)) {
      // `Name { field: value }` is a struct literal, and
      // `Name<A, B> { ... }` is one with type arguments.
      if (expression is Expr.Ident(_, identPos, identName)) {
        if (!startsUpper(identName)) {
          return expression
        }
        let typeArguments: Array<TypeExpr> = []
        if (isAt(parser, SYMBOL_LESS)) {
          if (!isLiteralTypeArgsAhead(parser)) {
            return expression
          }
          typeArguments = parseLiteralTypeArgs(mutable parser)
        }
        if (identName == "Map") {
          expression = parseMapLit(mutable parser, identPos, typeArguments)
        } else {
          expression = parseStructLit(mutable parser, identName, typeArguments, identPos)
        }
        noteExpr(mutable parser, startIndex, expression)
      } else {
        return expression
      }
    } else {
      return expression
    }
  }
  return expression
}

function isTemplateOnSameLine(parser: Parser): bool {
  if (parser.index == 0) {
    return false
  }
  const previous = parser.tokens[parser.index - 1]
  return previous.kind != TokenKind.TokNewline && previous.endLine == currentToken(parser).line
}

function isTemplateAfterNameLine(parser: Parser): bool {
  // TypeScript reads `tag` and a template on the next line as one tagged template.
  if (parser.index < 2) {
    return false
  }
  return parser.tokens[parser.index - 1].kind == TokenKind.TokNewline &&
    parser.tokens[parser.index - 2].kind == TokenKind.TokIdent
}

function isTagName(parser: Parser, expression: Expr): bool {
  // A name or a dotted name, written right before the template.
  if (parser.tokens[parser.index - 1].kind != TokenKind.TokIdent) {
    return false
  }
  return isNameChain(expression)
}

function isNameChain(expression: Expr): bool {
  return match (expression) {
    Expr.Ident(_, _, _) => true
    Expr.FieldExpr(_, _, target, _) => isNameChain(target)
    _ => false
  }
}

function parseCallArguments(mutable parser: Parser): Array<Arg> {
  let arguments: Array<Arg> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_PAREN)) {
    const start = getPos(currentToken(parser))
    // A name followed by `:` starts a named argument; no expression does.
    let name: Option<string> = None()
    if (
      currentToken(parser).kind == TokenKind.TokIdent &&
        peekToken(parser, 1).text == ":" &&
        peekToken(parser, 1).kind == TokenKind.TokPunct
    ) {
      name = Some(advance(mutable parser).text)
      advance(mutable parser)
    }
    const isMutable = accept(mutable parser, SYMBOL_KEYWORD_MUTABLE)
    const value = parseExpr(mutable parser)
    Arrays.push(mutable arguments, Arg {
      pos: start,
      name: name,
      isMutable: isMutable,
      value: value,
    })
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  return arguments
}

function isCallTypeArgsAhead(parser: Parser, callee: Expr): bool {
  const after = findTypeArgsEnd(parser, callee)
  if (after < 0) {
    return false
  }
  const token = peekToken(parser, after)
  return token.kind == TokenKind.TokPunct && token.text == "("
}

function isTaggedTypeArgsAhead(parser: Parser, callee: Expr): bool {
  // `tag<int>`...``: a tag takes no type arguments (D114).
  const after = findTypeArgsEnd(parser, callee)
  if (after < 0) {
    return false
  }
  const token = peekToken(parser, after)
  return token.kind == TokenKind.TokTemplate && token.line == peekToken(parser, after - 1).endLine
}

function findTypeArgsEnd(parser: Parser, callee: Expr): int {
  // The offset of the token after a balanced `<...>` of type arguments, or -1.
  if (callee is Expr.FieldExpr(_, _, target, _)) {
    if (!(target is Expr.Ident(_, _, _))) {
      return -1
    }
  } else if (!(callee is Expr.Ident(_, _, _))) {
    return -1
  }
  // A name not followed by `.` must be a type: a type parameter in scope, a primitive type name, or a capitalized name that is not SCREAMING_CASE. So `a < b > (c)` and `x < MAX, MIN > (y)` stay comparisons.
  let depth = 0
  let offset = 0
  const count = Arrays.length(parser.tokens)
  while (parser.index + offset < count) {
    const token = peekToken(parser, offset)
    if (token.kind == TokenKind.TokIdent) {
      if (depth == 0) {
        return -1
      }
      const next = peekToken(parser, offset + 1)
      const isQualifier = next.kind == TokenKind.TokPunct && next.text == "."
      if (!isTypeNameAhead(parser, token.text) && !isQualifier) {
        return -1
      }
    } else if (isConstantArgumentToken(parser, offset)) {
      if (depth == 0) {
        return -1
      }
    } else if (token.kind != TokenKind.TokPunct) {
      return -1
    } else if (token.text == "<") {
      depth++
    } else if (token.text == ">" || token.text == ">>") {
      if (token.text == ">") {
        depth--
      } else {
        depth -= 2
      }
      if (depth < 0) {
        return -1
      }
      if (depth == 0) {
        return offset + 1
      }
    } else if (token.text != "," && token.text != "." && token.text != "#[" && token.text != "]") {
      return -1
    }
    offset++
  }
  return -1
}

function isConstantArgumentToken(parser: Parser, offset: int): bool {
  // An integer, or `-` before one, may stand between type argument brackets: `f<3>(x)`.
  const token = peekToken(parser, offset)
  if (token.kind == TokenKind.TokInt) {
    return true
  }
  return token.kind == TokenKind.TokPunct &&
    token.text == "-" &&
    peekToken(parser, offset + 1).kind == TokenKind.TokInt
}

function isTypeNameAhead(parser: Parser, name: string): bool {
  for (const typeName of Arrays.values(parser.typeNames)) {
    if (typeName == name) {
      return true
    }
  }
  if (isPrimitiveTypeName(name)) {
    return true
  }
  // A capitalized name is a type unless it looks like a constant.
  return startsUpper(name) && !isConstantName(name)
}

function isConstantName(name: string): bool {
  if (Str.length(name) < 2) {
    return false
  }
  for (const index of Ranges.between(0, Str.length(name))) {
    const byte = Str.byteAt(name, index)
    if (byte >= 97 && byte <= 122) {
      return false
    }
  }
  return true
}

function isPrimitiveTypeName(text: string): bool {
  return text == "int" ||
    text == "f64" ||
    text == "bool" ||
    text == "char" ||
    text == "string" ||
    text == "void"
}

function parseMemberName(mutable parser: Parser): Token {
  // `from` and `of` are keywords, but `UserId.from(x)` and `Hash.of(x)` need them as member names.
  if (isAt(parser, SYMBOL_KEYWORD_FROM) || isAt(parser, SYMBOL_KEYWORD_OF)) {
    return advance(mutable parser)
  }
  return expectIdent(mutable parser)
}

function isLiteralTypeArgsAhead(parser: Parser): bool {
  // Only names, `.`, `,`, `#[`, `]` and nested `<>` may sit between the brackets, followed by `{`. Anything else is a comparison, so `a < B` never changes meaning. `>>` closes two levels.
  let depth = 0
  let offset = 0
  const count = Arrays.length(parser.tokens)
  while (parser.index + offset < count) {
    const token = peekToken(parser, offset)
    if (token.kind == TokenKind.TokIdent) {
      if (depth == 0) {
        return false
      }
    } else if (isConstantArgumentToken(parser, offset)) {
      if (depth == 0) {
        return false
      }
    } else if (token.kind != TokenKind.TokPunct) {
      return false
    } else if (token.text == "<") {
      depth++
    } else if (token.text == ">" || token.text == ">>") {
      if (token.text == ">") {
        depth--
      } else {
        depth -= 2
      }
      if (depth < 0) {
        return false
      }
      if (depth == 0) {
        const after = peekToken(parser, offset + 1)
        return after.kind == TokenKind.TokPunct && after.text == "{"
      }
    } else if (token.text != "," && token.text != "." && token.text != "#[" && token.text != "]") {
      return false
    }
    offset++
  }
  return false
}

function parseLiteralTypeArgs(mutable parser: Parser): Array<TypeExpr> {
  expect(mutable parser, SYMBOL_LESS)
  let arguments: Array<TypeExpr> = []
  while (isOk(parser)) {
    // A trailing `>>` is split by parseType, as in a type.
    Arrays.push(mutable arguments, parseType(mutable parser))
    rejectTypeArithmetic(mutable parser)
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
  }
  expect(mutable parser, SYMBOL_GREATER)
  return arguments
}

function startsUpper(text: string): bool {
  if (text == "") {
    return false
  }
  const firstByte = Str.byteAt(text, 0)
  return firstByte >= 65 && firstByte <= 90
}

function parseMapLit(
  mutable parser: Parser,
  pos: Pos,
  typeArguments: Array<TypeExpr>,
): Expr from pos {
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let keys: Array<Expr> = []
  let values: Array<Expr> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    let key = createDummyExpr()
    // A key that is not a literal is written in brackets.
    if (accept(mutable parser, SYMBOL_LEFT_BRACKET)) {
      key = parseExpr(mutable parser)
      expect(mutable parser, SYMBOL_RIGHT_BRACKET)
    } else {
      key = parseExpr(mutable parser)
      if (isOk(parser) && !isLiteralKey(key)) {
        failAt(
          mutable parser,
          getExpressionPos(key),
          "E0035",
          "a map key that is not a literal is written [key]: value",
        )
        break
      }
    }
    expect(mutable parser, SYMBOL_COLON)
    Arrays.push(mutable keys, key)
    Arrays.push(mutable values, parseExpr(mutable parser))
    skipNewlines(mutable parser)
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
    skipNewlines(mutable parser)
  }
  skipNewlines(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return copy(Expr.MapLit(newId(mutable parser), pos, typeArguments, keys, values))
}

function isLiteralKey(expression: Expr): bool {
  return match (expression) {
    Expr.IntLit(_, _, _)
      | Expr.FloatLit(_, _, _)
      | Expr.StringLit(_, _, _, _)
      | Expr.CharLit(_, _, _)
      | Expr.BoolLit(_, _, _) => true
    Expr.UnaryExpr(_, _, operator, operand) => operator == "-" && isLiteralKey(operand)
    _ => false
  }
}

function getExpressionPos(expression: Expr): Pos {
  return match (expression) {
    Expr.IntLit(_, pos, _)
      | Expr.FloatLit(_, pos, _)
      | Expr.StringLit(_, pos, _, _)
      | Expr.CharLit(_, pos, _)
      | Expr.BoolLit(_, pos, _)
      | Expr.TemplateLit(_, pos, _)
      | Expr.TemplateParts(_, pos, _)
      | Expr.Ident(_, pos, _)
      | Expr.FieldExpr(_, pos, _, _)
      | Expr.IsExpr(_, pos, _, _)
      | Expr.IndexExpr(_, pos, _, _)
      | Expr.MapLit(_, pos, _, _, _)
      | Expr.CallExpr(_, pos, _, _, _)
      | Expr.UnaryExpr(_, pos, _, _)
      | Expr.BinaryExpr(_, pos, _, _, _)
      | Expr.StructLit(_, pos, _, _, _, _)
      | Expr.ArrayLit(_, pos, _, _)
      | Expr.MatchExpr(_, pos, _, _)
      | Expr.BlockExpr(_, pos, _)
      | Expr.ArrowExpr(_, pos, _, _, _, _)
      | Expr.AwaitExpr(_, pos, _)
      | Expr.AsyncExpr(_, pos, _) => copy(pos)
  }
}

function isStructLitAhead(parser: Parser): bool {
  // A `{` in value position is a struct literal when it holds `{}`, `{ ...spread }` or `{ name: value }`; any other `{` is a block expression. A label (`name: for`, `name: while`) starts a block.
  let offset = 1
  while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
    offset++
  }
  if (parser.index + offset + 1 >= Arrays.length(parser.tokens)) {
    return false
  }
  const first = peekToken(parser, offset)
  if (first.kind == TokenKind.TokPunct && (first.text == "}" || first.text == "...")) {
    return true
  }
  const second = peekToken(parser, offset + 1)
  if (
    first.kind == TokenKind.TokString && second.kind == TokenKind.TokPunct && second.text == ":"
  ) {
    // A TypeScript object literal: parseStructLit reports it.
    return true
  }
  if (
    first.kind != TokenKind.TokIdent ||
      second.kind != TokenKind.TokPunct ||
      second.text != ":" ||
      parser.index + offset + 2 >= Arrays.length(parser.tokens)
  ) {
    return false
  }
  const third = peekToken(parser, offset + 2)
  return !(third.kind == TokenKind.TokKeyword && (third.text == "for" || third.text == "while"))
}

function parseBlockExpr(mutable parser: Parser): Expr {
  const pos = getPos(currentToken(parser))
  const block = parseBlock(mutable parser)
  return Expr.BlockExpr(newId(mutable parser), pos, block)
}

function createReturnBlock(value: Expr): Block from value {
  const pos = getExpressionPos(value)
  return Block { pos: pos, end: pos, statements: [Stmt.ReturnStmt(pos, Some(value))] }
}

function parseIfExpr(mutable parser: Parser): Expr {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_IF))
  expect(mutable parser, SYMBOL_LEFT_PAREN)
  const condition = parseExpr(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  const thenBranch = parseBlockExpr(mutable parser)
  // The else branch is required; `else if` chains are allowed.
  const savedIndex = parser.index
  skipNewlines(mutable parser)
  if (isOk(parser) && !accept(mutable parser, SYMBOL_KEYWORD_ELSE)) {
    parser.index = savedIndex
    expect(mutable parser, SYMBOL_KEYWORD_ELSE)
  }
  let elseBranch = createDummyExpr()
  if (isAt(parser, SYMBOL_KEYWORD_IF)) {
    elseBranch = parseIfExpr(mutable parser)
  } else {
    elseBranch = parseBlockExpr(mutable parser)
  }
  // An if expression becomes a block expression holding one if statement whose branches each return a block expression.
  const ifStatement = Stmt.IfStmt(
    pos,
    condition,
    createReturnBlock(thenBranch),
    Some(Stmt.BlockStmt(createReturnBlock(elseBranch))),
  )
  return Expr.BlockExpr(newId(mutable parser), pos, Block {
    pos: pos,
    end: pos,
    statements: [ifStatement],
  })
}

function parseStructLit(
  mutable parser: Parser,
  typeName: string,
  typeArguments: Array<TypeExpr>,
  pos: Pos,
): Expr from pos {
  // Without a type name, pos is the `{`; with one, it is the name's.
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let fields: Array<FieldInit> = []
  let spread: Option<Expr> = None
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    if (isAt(parser, SYMBOL_ELLIPSIS)) {
      if (spread is Some(_) || Arrays.length(fields) > 0) {
        failHere(
          mutable parser,
          "E0036",
          "a struct literal has at most one spread, and it comes first",
        )
        break
      }
      advance(mutable parser)
      spread = Some(parseExpr(mutable parser))
      skipNewlines(mutable parser)
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
      skipNewlines(mutable parser)
      continue
    }
    const fieldStart = parser.index
    const name = expectIdent(mutable parser)
    if (isOk(parser) && !isAt(parser, SYMBOL_COLON)) {
      failAt(
        mutable parser,
        getPos(name),
        "E0037",
        `write \`${name.text}: ${name.text}\`; field shorthand is not allowed`,
      )
      break
    }
    expect(mutable parser, SYMBOL_COLON)
    const value = parseExpr(mutable parser)
    Arrays.push(mutable fields, FieldInit { pos: getPos(name), name: name.text, value: value })
    if (parser.collector.enabled) {
      noteKey(mutable parser, getPosKey("f", getPos(name)), fieldStart)
    }
    skipNewlines(mutable parser)
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
    skipNewlines(mutable parser)
  }
  skipNewlines(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return copy(Expr.StructLit(newId(mutable parser), pos, typeName, typeArguments, fields, spread))
}

function parsePrimary(mutable parser: Parser): Expr {
  const startIndex = parser.index
  const expression = parsePrimaryBody(mutable parser)
  noteExpr(mutable parser, startIndex, expression)
  return expression
}

function parsePrimaryBody(mutable parser: Parser): Expr {
  const token = currentToken(parser)
  const pos = getPos(token)
  if (token.kind == TokenKind.TokInt) {
    advance(mutable parser)
    return Expr.IntLit(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokFloat) {
    advance(mutable parser)
    return Expr.FloatLit(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokString) {
    advance(mutable parser)
    return Expr.StringLit(
      newId(mutable parser),
      pos,
      token.text,
      Pos { line: token.endLine, column: token.endColumn },
    )
  }
  if (token.kind == TokenKind.TokChar) {
    advance(mutable parser)
    return Expr.CharLit(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokTemplate) {
    if (isTemplateAfterNameLine(parser)) {
      failAt(
        mutable parser,
        pos,
        "E1203",
        "a template at the start of a line is not tagged by the name that ends the line before; join the lines to tag it",
      )
      return createDummyExpr()
    }
    advance(mutable parser)
    return parseTemplate(mutable parser, token)
  }
  if (token.kind == TokenKind.TokIdent) {
    advance(mutable parser)
    reportHabitWord(mutable parser, token)
    if (token.text == "null" || token.text == "undefined") {
      failAtFix(
        mutable parser,
        pos,
        "E0038",
        [
          createFix("use None", [
            createEdit(pos, moveColumn(pos, Str.charCount(token.text)), "None"),
          ]),
        ],
        `there is no ${token.text}; use \`None\` with an \`Option\` type`,
      )
      return createDummyExpr()
    }
    return Expr.Ident(newId(mutable parser), pos, token.text)
  }
  if (token.kind == TokenKind.TokKeyword) {
    if (token.text == "true" || token.text == "false") {
      advance(mutable parser)
      return Expr.BoolLit(newId(mutable parser), pos, token.text == "true")
    }
    if (token.text == "match") {
      return parseMatch(mutable parser)
    }
    if (token.text == "if") {
      return parseIfExpr(mutable parser)
    }
    if (token.text == "async") {
      return parseAsyncExpr(mutable parser)
    }
    if (token.text == "yield") {
      failAt(
        mutable parser,
        pos,
        "E0046",
        "`yield` is a statement, so it cannot be part of an expression",
      )
      return createDummyExpr()
    }
  }
  if (token.kind == TokenKind.TokPunct) {
    if (token.text == "(") {
      if (isArrowAhead(parser)) {
        return parseArrow(mutable parser)
      }
      advance(mutable parser)
      const inner = parseExpr(mutable parser)
      expect(mutable parser, SYMBOL_RIGHT_PAREN)
      if (parser.collector.enabled && isOk(parser)) {
        parser.collector.parenthesized[getExprId(inner)] = true
      }
      return inner
    }
    if (token.text == "[" || token.text == "#[") {
      advance(mutable parser)
      let elements: Array<Expr> = []
      while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACKET)) {
        Arrays.push(mutable elements, parseExpr(mutable parser))
        if (!accept(mutable parser, SYMBOL_COMMA)) {
          break
        }
      }
      expect(mutable parser, SYMBOL_RIGHT_BRACKET)
      return Expr.ArrayLit(newId(mutable parser), pos, elements, token.text == "#[")
    }
    if (token.text == "{") {
      if (isStructLitAhead(parser)) {
        return parseStructLit(mutable parser, "", [], pos)
      }
      return parseBlockExpr(mutable parser)
    }
  }
  if (isAt(parser, SYMBOL_QUESTION)) {
    failAt(
      mutable parser,
      pos,
      "E0934",
      "a conditional expression that spans lines must be wrapped in parentheses, as in `(cond ? a : b)`",
    )
    return createDummyExpr()
  }
  failAt(mutable parser, pos, "E0039", `expected an expression, found ${describeToken(token)}`)
  return createDummyExpr()
}

function parseAsyncExpr(mutable parser: Parser): Expr {
  // `async { ... }` or `async (x) => ...` in value position.
  const startIndex = parser.index
  const pos = getPos(advance(mutable parser))
  if (isAt(parser, SYMBOL_LEFT_BRACE)) {
    const block = parseBlockExpr(mutable parser)
    noteExpr(mutable parser, startIndex + 1, block)
    return Expr.AsyncExpr(newId(mutable parser), pos, block)
  }
  if (isAt(parser, SYMBOL_LEFT_PAREN) && isArrowAhead(parser)) {
    const arrow = parseArrow(mutable parser)
    noteExpr(mutable parser, startIndex + 1, arrow)
    return Expr.AsyncExpr(newId(mutable parser), pos, arrow)
  }
  const found = describeToken(currentToken(parser))
  failAt(
    mutable parser,
    pos,
    "E1108",
    `async must be followed by function, an arrow function or a block, found ${found}`,
  )
  return createDummyExpr()
}

function findInterpolationEnd(raw: Array<char>, start: int): int {
  // Strings, character literals and nested templates inside the part are skipped whole.
  const count = Arrays.length(raw)
  let depth = 1
  let index = start
  while (index < count && depth > 0) {
    const character = raw[index]
    index++
    if (character == '{') {
      depth++
    } else if (character == '}') {
      depth--
    } else if (character == '"' || character == '\'') {
      index = findQuoteEnd(raw, index, character)
    } else if (character == '`') {
      index = findTemplateEnd(raw, index)
    }
    if (index < 0) {
      return -1
    }
  }
  if (depth != 0) {
    return -1
  }
  return index
}

function findQuoteEnd(raw: Array<char>, start: int, quote: char): int {
  const count = Arrays.length(raw)
  let index = start
  while (index < count) {
    const character = raw[index]
    index++
    if (character == quote) {
      return index
    }
    if (character == '\\') {
      index++
    }
  }
  return -1
}

function findTemplateEnd(raw: Array<char>, start: int): int {
  const count = Arrays.length(raw)
  let index = start
  while (index < count) {
    const character = raw[index]
    index++
    if (character == '`') {
      return index
    }
    if (character == '\\') {
      index++
    } else if (character == '$' && index < count && raw[index] == '{') {
      index = findInterpolationEnd(raw, index + 1)
      if (index < 0) {
        return -1
      }
    }
  }
  return -1
}

function advancePosition(raw: Array<char>, fromIndex: int, toIndex: int, start: Pos): Pos {
  let line = start.line
  let column = start.column
  for (const rawIndex of Ranges.between(fromIndex, toIndex)) {
    if (raw[rawIndex] == '\n') {
      line++
      column = 1
    } else {
      column++
    }
  }
  return Pos { line: line, column: column }
}

// The text parts and the `${}` expressions of a template, in source order;
// there is always one more part than expressions. An untagged template takes
// the id of each part's StringLit when the part ends, -1 for an empty part.
struct TemplatePieces {
  parts: Array<TemplatePart>
  holes: Array<Expr>
  literalIds: Array<int>
}

function parseTemplate(mutable parser: Parser, token: Token): Expr {
  // Empty parts are dropped; each other part is a StringLit at the template's position.
  const pos = getPos(token)
  const end = Pos { line: token.endLine, column: token.endColumn }
  const pieces = splitTemplate(mutable parser, token, false)
  if (!isOk(parser)) {
    return createDummyExpr()
  }
  let parts: Array<Expr> = []
  for (const index of Ranges.upTo(Arrays.length(pieces.parts))) {
    if (pieces.parts[index].decoded is Ok(text)) {
      const literalId = pieces.literalIds[index]
      if (literalId >= 0) {
        Arrays.push(mutable parts, Expr.StringLit(literalId, pos, text, end))
      }
    }
    if (index < Arrays.length(pieces.holes)) {
      Arrays.push(mutable parts, pieces.holes[index])
    }
  }
  return Expr.TemplateLit(newId(mutable parser), pos, parts)
}

function parseTaggedTemplate(mutable parser: Parser, tag: Expr, token: Token): Expr from tag {
  // `tag`a${x}b`` is the call `tag(["a", "b"], [x])` (D114). Escape errors stay in the parts.
  const pos = getPos(token)
  const pieces = splitTemplate(mutable parser, token, true)
  if (!isOk(parser)) {
    return createDummyExpr()
  }
  const partsExpression = Expr.TemplateParts(newId(mutable parser), pos, pieces.parts)
  const valuesExpression = Expr.ArrayLit(newId(mutable parser), pos, pieces.holes, false)
  const callId = newId(mutable parser)
  parser.facts.callEnds[callId] = Pos { line: token.endLine, column: token.endColumn }
  parser.facts.taggedCalls[callId] = true
  return Expr.CallExpr(callId, pos, tag, [], [
    Arg { pos: pos, name: None, isMutable: false, value: partsExpression },
    Arg { pos: pos, name: None, isMutable: false, value: valuesExpression },
  ])
}

function splitTemplate(mutable parser: Parser, token: Token, tagged: bool): TemplatePieces {
  // Each expression is lexed and parsed on its own, with its tokens placed where they are written.
  // An untagged template fails at its first bad escape; a tagged one keeps the error in its part.
  const pos = getPos(token)
  const raw = Str.chars(token.text)
  const count = Arrays.length(raw)
  let parts: Array<TemplatePart> = []
  let holes: Array<Expr> = []
  let literalIds: Array<int> = []
  let text = Str.builder()
  let partError: Option<TemplatePartError> = None
  let partStart = 0
  let partPos = Pos { line: token.line, column: token.column + 1 }
  let index = 0
  // The source position of raw[scanned]; raw starts after the backtick.
  let scanned = 0
  let cursor = Pos { line: token.line, column: token.column + 1 }
  while (isOk(parser) && index < count) {
    const character = raw[index]
    if (character == '\\') {
      // Find the backslash's own position, since templates span lines.
      cursor = advancePosition(raw, scanned, index, cursor)
      scanned = index
      // Decode the escape as a string literal would.
      const escaped = decodeEscape(raw, index, cursor.line, cursor.column)
      if (escaped is Err(error)) {
        const errorPos = Pos { line: error.line, column: error.column }
        if (!tagged) {
          failAt(mutable parser, errorPos, error.code, error.message)
          return TemplatePieces { parts: [], holes: [], literalIds: [] }
        }
        if (partError is None) {
          partError = Some(TemplatePartError {
            code: error.code,
            message: error.message,
            pos: errorPos,
          })
        }
        // The backslash keeps the next character in the part.
        index = index + 2
        continue
      }
      Str.append(mutable text, escaped.value.text)
      index = escaped.value.end
      continue
    }
    if (character == '$' && index + 1 < count && raw[index + 1] == '{') {
      const closeIndex = findInterpolationEnd(raw, index + 2)
      if (closeIndex < 0) {
        failAt(mutable parser, pos, "E0040", "unterminated ${ in template string")
        return TemplatePieces { parts: [], holes: [], literalIds: [] }
      }
      const partText = Str.build(text)
      Arrays.push(mutable literalIds, takeLiteralId(mutable parser, tagged, partText))
      Arrays.push(
        mutable parts,
        createTemplatePart(raw, partStart, index, partText, partError, partPos),
      )
      text = Str.builder()
      partError = None
      let source = Str.builder()
      for (const sourceIndex of Ranges.between(index + 2, closeIndex - 1)) {
        Str.appendChar(mutable source, raw[sourceIndex])
      }
      // The expression starts after the `${`.
      cursor = advancePosition(raw, scanned, index + 2, cursor)
      scanned = index + 2
      const lexed = lexFrom(Str.build(source), cursor.line, cursor.column)
      if (lexed is Err(error)) {
        failAt(mutable parser, pos, "E0041", `in template string: ${formatLexError(error)}`)
        return TemplatePieces { parts: [], holes: [], literalIds: [] }
      }
      let innerParser = Parser {
        tokens: copy(lexed.value),
        index: 0,
        nextId: parser.nextId,
        failed: None,
        ternaryIds: [],
        collector: createCollector(false),
        facts: createEmptyFacts(),
        resultFunction: false,
        statementStart: 0 - 1,
        typeNames: [],
      }
      const expression = parseExpr(mutable innerParser)
      parser.nextId = innerParser.nextId
      // Keep where each token ends, for narrac query.
      for (const innerToken of Arrays.values(lexed.value)) {
        parser.facts.templateTokenEnds[getPosKey("t", getPos(innerToken))] = Pos {
          line: innerToken.endLine,
          column: innerToken.endColumn,
        }
      }
      for (const entry of Maps.entries(innerParser.facts.templateTokenEnds)) {
        const #[tokenKey, tokenEnd] = entry
        parser.facts.templateTokenEnds[tokenKey] = tokenEnd
      }
      collectReferencedNames(mutable parser.facts.referenced, lexed.value)
      for (const entry of Maps.entries(innerParser.facts.referenced)) {
        const #[referencedName, referencedFlag] = entry
        parser.facts.referenced[referencedName] = referencedFlag
      }
      for (const entry of Maps.entries(innerParser.facts.callEnds)) {
        const #[callId, callEnd] = entry
        parser.facts.callEnds[callId] = callEnd
      }
      for (const entry of Maps.entries(innerParser.facts.taggedCalls)) {
        const #[taggedId, isTagged] = entry
        parser.facts.taggedCalls[taggedId] = isTagged
      }
      if (innerParser.failed is Some(diagnostic)) {
        failAt(mutable parser, diagnostic.pos, diagnostic.code, diagnostic.message)
        return TemplatePieces { parts: [], holes: [], literalIds: [] }
      }
      Arrays.push(mutable holes, expression)
      index = closeIndex
      // The next part starts after the `}`.
      cursor = advancePosition(raw, scanned, index, cursor)
      scanned = index
      partStart = index
      partPos = cursor
      continue
    }
    Str.appendChar(mutable text, character)
    index++
  }
  const lastText = Str.build(text)
  Arrays.push(mutable literalIds, takeLiteralId(mutable parser, tagged, lastText))
  Arrays.push(
    mutable parts,
    createTemplatePart(raw, partStart, count, lastText, partError, partPos),
  )
  return TemplatePieces { parts: parts, holes: holes, literalIds: literalIds }
}

function takeLiteralId(mutable parser: Parser, tagged: bool, text: string): int {
  if (tagged || Str.length(text) == 0) {
    return -1
  }
  return newId(mutable parser)
}

function createTemplatePart(
  raw: Array<char>,
  start: int,
  end: int,
  text: string,
  failure: Option<TemplatePartError>,
  pos: Pos,
): TemplatePart {
  let source = Str.builder()
  for (const rawIndex of Ranges.between(start, end)) {
    Str.appendChar(mutable source, raw[rawIndex])
  }
  let decoded: Result<string, TemplatePartError> = Ok(text)
  if (failure is Some(error)) {
    decoded = Err(copy(error))
  }
  return TemplatePart { raw: Str.build(source), decoded: decoded, pos: copy(pos) }
}

function parseMatch(mutable parser: Parser): Expr {
  const pos = getPos(expect(mutable parser, SYMBOL_KEYWORD_MATCH))
  expect(mutable parser, SYMBOL_LEFT_PAREN)
  const subject = parseExpr(mutable parser)
  expect(mutable parser, SYMBOL_RIGHT_PAREN)
  expect(mutable parser, SYMBOL_LEFT_BRACE)
  skipNewlines(mutable parser)
  let arms: Array<MatchArm> = []
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
    const armPos = getPos(currentToken(parser))
    const armStart = parser.index
    const pattern = parsePattern(mutable parser)
    let guard: Option<Expr> = None
    if (accept(mutable parser, SYMBOL_KEYWORD_IF)) {
      expect(mutable parser, SYMBOL_LEFT_PAREN)
      guard = Some(parseExpr(mutable parser))
      expect(mutable parser, SYMBOL_RIGHT_PAREN)
    }
    expect(mutable parser, SYMBOL_ARROW)
    if (isAt(parser, SYMBOL_LEFT_BRACE)) {
      const block = parseBlock(mutable parser)
      Arrays.push(mutable arms, MatchArm {
        pos: armPos,
        pattern: pattern,
        guard: guard,
        body: None,
        block: Some(block),
        next: armPos,
      })
      if (parser.collector.enabled) {
        noteKey(mutable parser, getPosKey("a", armPos), armStart)
      }
    } else {
      const body = parseExpr(mutable parser)
      Arrays.push(mutable arms, MatchArm {
        pos: armPos,
        pattern: pattern,
        guard: guard,
        body: Some(body),
        block: None,
        next: armPos,
      })
      if (parser.collector.enabled) {
        noteKey(mutable parser, getPosKey("a", armPos), armStart)
      }
    }
    accept(mutable parser, SYMBOL_COMMA)
    skipNewlines(mutable parser)
    // The arm ends where the next token starts.
    arms[Arrays.length(arms) - 1].next = getPos(currentToken(parser))
  }
  expect(mutable parser, SYMBOL_RIGHT_BRACE)
  return Expr.MatchExpr(newId(mutable parser), pos, subject, arms)
}

// ---- Patterns

function parsePattern(mutable parser: Parser): Pattern {
  const startIndex = parser.index
  const pos = getPos(currentToken(parser))
  const first = parseSinglePattern(mutable parser)
  if (!isOk(parser) || !isAlternativeAhead(parser)) {
    return first
  }
  let alternatives: Array<Pattern> = [first]
  while (isOk(parser) && isAlternativeAhead(parser)) {
    // A bar may start the next line, for a long list of alternatives.
    skipNewlines(mutable parser)
    advance(mutable parser)
    skipNewlines(mutable parser)
    Arrays.push(mutable alternatives, parseSinglePattern(mutable parser))
  }
  const pattern = Pattern.PatOr(newId(mutable parser), pos, alternatives)
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getIdKey(getPatternId(pattern)), startIndex)
  }
  return pattern
}

function isAlternativeAhead(parser: Parser): bool {
  let offset = 0
  while (peekToken(parser, offset).kind == TokenKind.TokNewline) {
    offset++
  }
  const token = peekToken(parser, offset)
  return token.kind == TokenKind.TokPunct && token.text == "|"
}

function parseSinglePattern(mutable parser: Parser): Pattern {
  const startIndex = parser.index
  const pattern = parsePatternBody(mutable parser)
  if (parser.collector.enabled && isOk(parser)) {
    noteKey(mutable parser, getIdKey(getPatternId(pattern)), startIndex)
  }
  return pattern
}

function parsePatternBody(mutable parser: Parser): Pattern {
  const token = currentToken(parser)
  const pos = getPos(token)
  if (parser.contractPattern && isComparisonToken(token)) {
    // `>= 0`: the bound is a constant, which the checker folds.
    advance(mutable parser)
    const savedContract = parser.contractPattern
    parser.contractPattern = false
    const bound = parseUnary(mutable parser)
    parser.contractPattern = savedContract
    return Pattern.PatCompare(newId(mutable parser), pos, token.text, bound)
  }
  if (isAt(parser, SYMBOL_LEFT_BRACE)) {
    advance(mutable parser)
    skipNewlines(mutable parser)
    let fields: Array<FieldPattern> = []
    while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACE)) {
      const fieldStart = parser.index
      const name = expectIdent(mutable parser)
      if (accept(mutable parser, SYMBOL_COLON)) {
        const subpattern = parsePattern(mutable parser)
        Arrays.push(mutable fields, FieldPattern {
          pos: getPos(name),
          name: name.text,
          pattern: subpattern,
        })
      } else {
        const shorthandId = newId(mutable parser)
        parser.facts.shorthandIds[shorthandId] = true
        const shorthand = Pattern.PatName(shorthandId, getPos(name), name.text)
        Arrays.push(mutable fields, FieldPattern {
          pos: getPos(name),
          name: name.text,
          pattern: shorthand,
        })
      }
      if (parser.collector.enabled) {
        noteKey(mutable parser, getPosKey("f", getPos(name)), fieldStart)
      }
      skipNewlines(mutable parser)
      if (!accept(mutable parser, SYMBOL_COMMA)) {
        break
      }
      skipNewlines(mutable parser)
    }
    skipNewlines(mutable parser)
    expect(mutable parser, SYMBOL_RIGHT_BRACE)
    return Pattern.PatStruct(newId(mutable parser), pos, fields)
  }
  if (isAt(parser, SYMBOL_HASH_BRACKET)) {
    advance(mutable parser)
    const arguments = parsePatternList(mutable parser, SYMBOL_RIGHT_BRACKET)
    return Pattern.PatTuple(newId(mutable parser), pos, arguments)
  }
  if (isAt(parser, SYMBOL_LEFT_BRACKET)) {
    return parseArrayPattern(mutable parser)
  }
  if (isAt(parser, SYMBOL_MINUS)) {
    advance(mutable parser)
    const number = currentToken(parser)
    if (number.kind != TokenKind.TokInt && number.kind != TokenKind.TokFloat) {
      failAt(
        mutable parser,
        getPos(number),
        "E0042",
        `expected a number after - in a pattern, found ${describeToken(number)}`,
      )
      return createDummyPattern()
    }
    const operand = parsePrimary(mutable parser)
    const literal = Expr.UnaryExpr(newId(mutable parser), pos, "-", operand)
    return Pattern.PatLit(newId(mutable parser), pos, literal)
  }
  if (
    token.kind == TokenKind.TokInt ||
      token.kind == TokenKind.TokFloat ||
      token.kind == TokenKind.TokString ||
      token.kind == TokenKind.TokChar ||
      isAt(parser, SYMBOL_KEYWORD_TRUE) ||
      isAt(parser, SYMBOL_KEYWORD_FALSE)
  ) {
    const literal = parsePrimary(mutable parser)
    return Pattern.PatLit(newId(mutable parser), pos, literal)
  }
  const first = expectIdent(mutable parser)
  if (!isOk(parser)) {
    return createDummyPattern()
  }
  if (first.text == "_") {
    return Pattern.PatWildcard(newId(mutable parser), pos)
  }
  let isConstructor = false
  let enumName = ""
  let name = first.text
  // Enum.Name, or Alias.Enum.Name through a namespace import.
  while (isOk(parser) && accept(mutable parser, SYMBOL_DOT)) {
    isConstructor = true
    if (enumName != "") {
      enumName = `${enumName}.`
    }
    enumName = `${enumName}${name}`
    name = expectIdent(mutable parser).text
  }
  if (accept(mutable parser, SYMBOL_LEFT_PAREN)) {
    const arguments = parsePatternList(mutable parser, SYMBOL_RIGHT_PAREN)
    return Pattern.PatCtor(newId(mutable parser), pos, enumName, name, arguments, false)
  }
  if (isConstructor) {
    return Pattern.PatCtor(newId(mutable parser), pos, enumName, name, [], true)
  }
  return Pattern.PatName(newId(mutable parser), pos, name)
}

function parseArrayPattern(mutable parser: Parser): Pattern {
  const pos = getPos(currentToken(parser))
  advance(mutable parser)
  skipNewlines(mutable parser)
  let elements: Array<Pattern> = []
  let rest: Option<Pattern> = None
  while (isOk(parser) && !isAt(parser, SYMBOL_RIGHT_BRACKET)) {
    if (isAt(parser, SYMBOL_ELLIPSIS)) {
      advance(mutable parser)
      const startIndex = parser.index
      const name = expectIdent(mutable parser)
      if (!isOk(parser)) {
        return createDummyPattern()
      }
      let restPattern = Pattern.PatName(newId(mutable parser), getPos(name), name.text)
      if (name.text == "_") {
        restPattern = Pattern.PatWildcard(newId(mutable parser), getPos(name))
      }
      noteKey(mutable parser, getIdKey(getPatternId(restPattern)), startIndex)
      rest = Some(restPattern)
    } else {
      Arrays.push(mutable elements, parsePattern(mutable parser))
    }
    skipNewlines(mutable parser)
    if (!isAt(parser, SYMBOL_COMMA)) {
      break
    }
    // Only the closing bracket may follow the rest.
    if (rest is Some(_)) {
      failHere(
        mutable parser,
        "E0722",
        "`...` must be the last element of an array pattern, and appear once",
      )
      return createDummyPattern()
    }
    advance(mutable parser)
    skipNewlines(mutable parser)
  }
  expect(mutable parser, SYMBOL_RIGHT_BRACKET)
  return Pattern.PatArray(newId(mutable parser), pos, elements, rest)
}

function isComparisonToken(token: Token): bool {
  return (token.kind == TokenKind.TokPunct &&
    (token.text == "<" ||
      token.text == "<=" ||
      token.text == ">" ||
      token.text == ">=" ||
      token.text == "!="))
}

function parsePatternList(mutable parser: Parser, close: int): Array<Pattern> {
  let list: Array<Pattern> = []
  skipNewlines(mutable parser)
  while (isOk(parser) && !isAt(parser, close)) {
    Arrays.push(mutable list, parsePattern(mutable parser))
    skipNewlines(mutable parser)
    if (!accept(mutable parser, SYMBOL_COMMA)) {
      break
    }
    skipNewlines(mutable parser)
  }
  expect(mutable parser, close)
  return list
}
