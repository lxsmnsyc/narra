import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

function isDigit(c: char): bool {
  return c >= '0' && c <= '9'
}

function isLetter(c: char): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c > '~'
}

// Splits src into words and numbers; anything else is skipped.
function tokenize(src: string): Array<string> {
  let tokens: Array<string> = []
  let i = 0
  while (i < Str.length(src)) {
    const c = Str.charAt(src, i)
    if (isDigit(c)) {
      let j = i
      while (j < Str.length(src) && isDigit(Str.charAt(src, j))) {
        j = Str.nextChar(src, j)
      }
      Arrays.push(mutable tokens, `num:${Str.slice(src, i, j)}`)
      i = j
    } else if (isLetter(c)) {
      let j = i
      while (j < Str.length(src) && isLetter(Str.charAt(src, j))) {
        j = Str.nextChar(src, j)
      }
      Arrays.push(mutable tokens, `word:${Str.slice(src, i, j)}`)
      i = j
    } else {
      i = Str.nextChar(src, i)
    }
  }
  return tokens
}

export function run(args: Array<string>): int {
  for (const t of Arrays.values(tokenize("let x1 = 42 + café*7;"))) {
    print(t)
  }

  const line = "  key = value  "
  const found = Str.indexOf(line, "=")
  if (found is Some(i)) {
    print(`[${Str.trim(Str.slice(line, 0, i))}]`)
    print(`[${Str.trim(Str.sliceFrom(line, Str.nextChar(line, i)))}]`)
  }
  if (Str.indexOf("abc", "z") is None) {
    print("no z")
  }
  print(Int.toString(Str.byteAt("A", 0)))
  print(Int.toString(Str.charCount("aλb")))
  print(Int.toString(Str.length("aλb")))
  if (Str.startsWith("narra", "na") && !Str.startsWith("na", "narra")) {
    print("prefix")
  }

  for (const part of Arrays.values(Str.split("a,b,,c", ","))) {
    print(`<${part}>`)
  }
  let n = 0
  for (const ch of Arrays.values(Str.chars("aλ😀"))) {
    n = n + 1
    print(Str.fromChar(ch))
  }
  print(Int.toString(n))

  let sb = Str.builder()
  Str.append(mutable sb, "x=")
  Str.appendChar(mutable sb, 'λ')
  const copy = sb
  Str.append(mutable sb, "!")
  print(Str.build(sb))
  print(Str.build(copy))
  return 0
}
