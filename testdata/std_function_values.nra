// Standard functions with a fixed signature are function values, with the effects
// of their registry row.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Str from "std/string"
import { toString } from "std/int"

function apply(f: (value: int) => string uses alloc, value: int): string uses alloc {
  return f(value)
}

function mapAll<T, U, effect E>(items: Array<T>, f: (item: T) => U uses E): Array<U> uses E, alloc {
  let out: Array<U> = []
  for (const item of Arrays.values(items)) {
    Arrays.push(mutable out, f(item))
  }
  return out
}

function readWith(
  read: (path: string) => Result<string, string> uses io, alloc,
  path: string,
): Result<string, string> uses io, alloc {
  return read(path)
}

struct Formatter {
  format: (value: int) => string uses alloc
}

export function run(_args: Array<string>): int uses io, alloc {
  // Passed to a user function, and stored in a const with a written type.
  print(apply(Int.toString, 12))
  const show: (value: int) => string uses alloc = Int.toString
  print(show(7))

  // Through a generic function with an effect variable.
  const lengths = mapAll(["a", "bcd", ""], Str.length)
  print(Int.toString(lengths[1]))
  const trimmed = mapAll(["  x ", " y"], Str.trim)
  print(`[${trimmed[0]}][${trimmed[1]}]`)

  // A named import is a value, and an effect travels with the function.
  print(apply(toString, 99))
  print(readWith(Fs.readText, "testdata/std_function_values.nra") is Ok(_) ? "read" : "missing")

  // In a struct field and in an array, and the same function twice.
  const formatter = Formatter { format: Int.toString }
  print(formatter.format(5))
  const table: Array<(value: int) => string uses alloc> = [Int.toString, toString]
  print(`${table[0](1)}${table[1](2)}`)
  return 0
}
