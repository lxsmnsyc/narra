// Type declarations, definitions, reference counting functions and enum
// allocation, ported from emit_types.go and emit_box.go by
// selfhost-emit-decls.
//
// The section functions return the C text of one block of Go's Emit. The
// types come from Checker.order and the arrays and boxes from
// Checker.composites, sorted as Go sorts Program.Arrays and Program.Boxes.
import { substring } from "narrac/textops"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import { Type, Variant, isBoxedEnum } from "narrac/types"
import { Checker, isHeapEnum, isPassedByPointer } from "narrac/check"
import {
  typeId,
  cachedTypeId,
  cachedCType,
  payloadName,
  opFuncName,
  parameterCType,
} from "narrac/cnames"
import * as Fixed from "narrac/emitfixed"
import {
  Emitter,
  Code,
  reportUnsupported,
  writeLine,
  needsRc,
  underlyingType,
  retainCode,
  releaseCode,
  shareCode,
  noteHelper,
  useHelper,
} from "narrac/emitstate"

function fieldName(name: string): string uses alloc {
  return `f_${name}`
}

function variantName(variant: Variant): string uses alloc {
  return `v_${variant.name}`
}

function findEnumIndex(type: Type): int {
  return match (type) { Type.TEnum(index) => index, _ => 0 - 1 }
}

function isHeapEnumType(checker: Checker, type: Type): bool {
  const index = findEnumIndex(type)
  return index >= 0 && isHeapEnum(checker, index)
}

// An array or box type with the key Go sorts it by.
struct SortItem {
  key: string
  type: Type
}

function mergeSort(items: Array<SortItem>): Array<SortItem> from items uses alloc {
  const count = Arrays.length(items)
  if (count < 2) {
    return items
  }
  const middle = count / 2
  let left: Array<SortItem> = []
  let right: Array<SortItem> = []
  for (const index of Ranges.between(0, count)) {
    if (index < middle) {
      Arrays.push(mutable left, items[index])
    } else {
      Arrays.push(mutable right, items[index])
    }
  }
  const sortedLeft = mergeSort(left)
  const sortedRight = mergeSort(right)
  let merged: Array<SortItem> = []
  let leftIndex = 0
  let rightIndex = 0
  while (leftIndex < Arrays.length(sortedLeft) || rightIndex < Arrays.length(sortedRight)) {
    if (
      rightIndex >= Arrays.length(sortedRight) ||
        (leftIndex < Arrays.length(sortedLeft) &&
          sortedLeft[leftIndex].key <= sortedRight[rightIndex].key)
    ) {
      Arrays.push(mutable merged, sortedLeft[leftIndex])
      leftIndex++
    } else {
      Arrays.push(mutable merged, sortedRight[rightIndex])
      rightIndex++
    }
  }
  return merged
}

function compositeTypes(emitter: Emitter, boxes: bool): Array<Type> uses alloc {
  let items: Array<SortItem> = []
  for (const entry of Maps.entries(emitter.checker.composites)) {
    const #[_, composite] = entry
    if (!boxes) {
      if (composite is Type.TArray(element)) {
        Arrays.push(mutable items, SortItem {
          key: cachedTypeId(emitter.checker, emitter.typeNames, element),
          type: composite,
        })
      }
    } else {
      if (composite is Type.TBox(boxElement)) {
        Arrays.push(mutable items, SortItem {
          key: cachedTypeId(emitter.checker, emitter.typeNames, boxElement),
          type: composite,
        })
      }
    }
  }
  let sorted: Array<Type> = []
  for (const item of Arrays.values(mergeSort(items))) {
    Arrays.push(mutable sorted, item.type)
  }
  return sorted
}

function containerName(emitter: Emitter, type: Type): string uses alloc {
  const name = cachedCType(emitter.checker, emitter.typeNames, type)
  return substring(name, 0, Str.length(name) - 1)
}

function getElementType(type: Type): Type from type {
  return match (type) { Type.TArray(element) => element, Type.TBox(element) => element, _ => type }
}

function isUsed(emitter: Emitter, used: Map<string, bool>, type: Type): bool uses alloc {
  return used[cachedTypeId(emitter.checker, emitter.typeNames, type)] is Some(_)
}

export function emitHeapTypedefs(emitter: Emitter, used: Map<string, bool>): string uses alloc {
  let builder = Str.builder()
  // Boxes first, then the payload of each boxed enum.
  for (const box of Arrays.values(compositeTypes(emitter, true))) {
    if (isUsed(emitter, used, box)) {
      const name = containerName(emitter, box)
      Str.append(mutable builder, `typedef struct ${name} ${name};\n`)
    }
  }
  for (const type of Arrays.values(emitter.checker.order)) {
    if (isHeapEnumType(emitter.checker, type) && isUsed(emitter, used, type)) {
      const payload = payloadName(emitter.checker, type)
      Str.append(mutable builder, `typedef struct ${payload} ${payload};\n`)
    }
  }
  return Str.build(builder)
}

export function emitTypeDefinitions(emitter: Emitter, used: Map<string, bool>): string uses alloc {
  let builder = Str.builder()
  for (const type of Arrays.values(emitter.checker.order)) {
    if (isUsed(emitter, used, type)) {
      Str.append(mutable builder, typeDefinition(emitter, type))
    }
  }
  return Str.build(builder)
}

function typeDefinition(emitter: Emitter, type: Type): string uses alloc {
  const name = cachedCType(emitter.checker, emitter.typeNames, type)
  if (type is Type.TStruct(structIndex)) {
    let text = `struct ${name} {`
    const fields = emitter.checker.structs[structIndex].fields
    if (Arrays.length(fields) == 0) {
      text = `${text} char unused;`
    }
    for (const field of Arrays.values(fields)) {
      text = `${text} ${cachedCType(emitter.checker, emitter.typeNames, field.fieldType)} ${fieldName(field.name)};`
    }
    return `${text} };\n`
  }
  if (type is Type.TEnum(enumIndex)) {
    if (isHeapEnum(emitter.checker, enumIndex)) {
      return `struct ${name} { int32_t tag; NARRA_COPY_ONLY(int32_t copy_held;) ${payloadName(emitter.checker, type)}* u; };\n`
    }
    if (isBoxedEnum(emitter.checker.enums[enumIndex])) {
      return `struct ${name} { int32_t tag; union {${buildVariantMembers(emitter, enumIndex)} } u; };\n`
    }
    return `struct ${name} { int32_t tag; };\n`
  }
  return Fixed.buildFixedDefinition(emitter, type)
}

function buildVariantMembers(emitter: Emitter, enumIndex: int): string uses alloc {
  let builder = Str.builder()
  for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
    // A field of type void (Option<void> in a Thread<void>) has no member.
    if (hasValueFields(variant)) {
      Str.append(mutable builder, " struct {")
      for (const field of Arrays.values(variant.fields)) {
        if (field.fieldType != Type.TVoid) {
          Str.append(
            mutable builder,
            ` ${cachedCType(emitter.checker, emitter.typeNames, field.fieldType)} ${fieldName(field.name)};`,
          )
        }
      }
      Str.append(mutable builder, ` } ${variantName(variant)};`)
    }
  }
  return Str.build(builder)
}

function hasValueFields(variant: Variant): bool {
  for (const field of Arrays.values(variant.fields)) {
    if (field.fieldType != Type.TVoid) {
      return true
    }
  }
  return false
}

export function emitHeapDefinitions(emitter: Emitter, used: Map<string, bool>): string uses alloc {
  let builder = Str.builder()
  for (const type of Arrays.values(emitter.checker.order)) {
    if (isHeapEnumType(emitter.checker, type) && isUsed(emitter, used, type)) {
      const members = buildVariantMembers(emitter, findEnumIndex(type))
      Str.append(
        mutable builder,
        `struct ${payloadName(emitter.checker, type)} { int64_t rc; int32_t tag; union {${members} }; };\n`,
      )
    }
  }
  for (const box of Arrays.values(compositeTypes(emitter, true))) {
    if (!isUsed(emitter, used, box)) {
      continue
    }
    Str.append(
      mutable builder,
      `struct ${containerName(emitter, box)} { int64_t rc; ${cachedCType(emitter.checker, emitter.typeNames, getElementType(box))} ${fieldName("value")}; };\n`,
    )
  }
  return Str.build(builder)
}

// A reference counting function the emitter can write: its operation and the
// type it serves. The emitter writes one only when emitted code names it.
export struct HelperSlot {
  operation: string
  type: Type
}

// "share" exists only in thread mode (D111 item 2): nothing names it otherwise.
const TYPE_OPERATIONS = ["drop", "credit", "uncredit", "retain", "release", "share"]
const ARRAY_OPERATIONS = [
  "new",
  "retain",
  "release",
  "unique",
  "copy",
  "push",
  "get",
  "at",
  "filled",
  "share",
]
const BOX_OPERATIONS = ["new", "retain", "unique", "at", "drop", "release", "share"]

export function indexHelpers(emitter: Emitter): Map<string, HelperSlot> uses alloc {
  // The names come from typeId, not the cache: the cache records the types
  // that emitted code names.
  let slots: Map<string, HelperSlot> = Map {}
  for (const type of Arrays.values(emitter.checker.order)) {
    if (needsRc(emitter, type)) {
      const id = typeId(emitter.checker, type)
      slots[opFuncName("retain", id)] = HelperSlot { operation: "retain", type: copy(type) }
      slots[opFuncName("release", id)] = HelperSlot { operation: "release", type: copy(type) }
      slots[opFuncName("share", id)] = HelperSlot { operation: "share", type: copy(type) }
      if (isHeapEnumType(emitter.checker, type)) {
        for (const operation of Arrays.values(["drop", "credit", "uncredit"])) {
          slots[opFuncName(operation, id)] = HelperSlot { operation: operation, type: copy(type) }
        }
      }
    }
  }
  for (const entry of Maps.entries(emitter.checker.composites)) {
    const #[_, composite] = entry
    let operations: Array<string> = []
    if (composite is Type.TArray(_)) {
      operations = ARRAY_OPERATIONS
    } else if (composite is Type.TBox(_)) {
      operations = BOX_OPERATIONS
    } else if (composite is Type.TMap(_, _)) {
      operations = ["share"]
    }
    if (Arrays.length(operations) > 0) {
      const id = typeId(emitter.checker, composite)
      for (const operation of Arrays.values(operations)) {
        slots[`${id}_${operation}`] = HelperSlot { operation: operation, type: copy(composite) }
      }
    }
  }
  return slots
}

export function emitHelper(emitter: Emitter, slot: HelperSlot): string uses alloc {
  return match (slot.type) {
    Type.TArray(_) => arrayFunction(emitter, slot.type, slot.operation)
    Type.TBox(_) => boxFunction(emitter, slot.type, slot.operation)
    Type.TMap(_, _) => mapShareFunction(emitter, slot.type)
    _ => typeRcFunction(emitter, slot.type, slot.operation)
  }
}

function findHelper(helpers: Map<string, string>, name: string): string {
  if (helpers[name] is Some(text)) {
    return text
  }
  return ""
}

function hasHelper(helpers: Map<string, string>, name: string): bool {
  return helpers[name] is Some(_)
}

export function emitBoxPrototypes(
  emitter: Emitter,
  helpers: Map<string, string>,
): string uses alloc {
  let builder = Str.builder()
  for (const box of Arrays.values(compositeTypes(emitter, true))) {
    const name = containerName(emitter, box)
    appendContainerPrototypes(mutable builder, name, helpers)
  }
  return Str.build(builder)
}

function appendContainerPrototypes(
  mutable builder: StringBuilder,
  name: string,
  helpers: Map<string, string>,
) uses alloc {
  if (hasHelper(helpers, `${name}_retain`)) {
    Str.append(mutable builder, `static void ${name}_retain(${name}* a);\n`)
  }
  if (hasHelper(helpers, `${name}_release`)) {
    Str.append(mutable builder, `static void ${name}_release(${name}* a);\n`)
  }
  if (hasHelper(helpers, `${name}_share`)) {
    Str.append(mutable builder, `static void ${name}_share(${name}* a);\n`)
  }
}

export function emitRcFunctions(emitter: Emitter, helpers: Map<string, string>): string uses alloc {
  let builder = Str.builder()
  const arrays = compositeTypes(emitter, false)
  // Prototypes: types that need counting, then arrays.
  for (const type of Arrays.values(emitter.checker.order)) {
    if (needsRc(emitter, type)) {
      const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
      const parameterType = parameterCType(emitter.checker, emitter.typeNames, type, false)
      for (const operation of Arrays.values(["retain", "release", "share"])) {
        if (hasHelper(helpers, opFuncName(operation, id))) {
          Str.append(
            mutable builder,
            `static void ${opFuncName(operation, id)}(${parameterType} v);\n`,
          )
        }
      }
    }
  }
  for (const array of Arrays.values(arrays)) {
    appendContainerPrototypes(mutable builder, containerName(emitter, array), helpers)
  }
  for (const map of Arrays.values(listMapTypes(emitter))) {
    const mapName = containerName(emitter, map)
    if (hasHelper(helpers, `${mapName}_share`)) {
      Str.append(mutable builder, `static void ${mapName}_share(${mapName}* a);\n`)
    }
  }
  // The credit functions exist only where the debug copy check does.
  for (const type of Arrays.values(emitter.checker.order)) {
    if (isHeapEnumType(emitter.checker, type) && needsRc(emitter, type)) {
      const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
      const parameterType = parameterCType(emitter.checker, emitter.typeNames, type, false)
      let prototypes: Array<string> = []
      for (const operation of Arrays.values(["credit", "uncredit"])) {
        if (hasHelper(helpers, opFuncName(operation, id))) {
          Arrays.push(
            mutable prototypes,
            `static void ${opFuncName(operation, id)}(${parameterType} v);`,
          )
        }
      }
      if (Arrays.length(prototypes) > 0) {
        Str.append(mutable builder, `NARRA_COPY_ONLY(${Str.join(prototypes, " ")})\n`)
      }
    }
  }
  // Functions: types, then arrays, then boxes.
  for (const type of Arrays.values(emitter.checker.order)) {
    if (needsRc(emitter, type)) {
      const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
      for (const operation of Arrays.values(TYPE_OPERATIONS)) {
        Str.append(mutable builder, findHelper(helpers, opFuncName(operation, id)))
      }
    }
  }
  for (const array of Arrays.values(arrays)) {
    appendContainerFunctions(
      mutable builder,
      containerName(emitter, array),
      ARRAY_OPERATIONS,
      helpers,
    )
  }
  for (const box of Arrays.values(compositeTypes(emitter, true))) {
    appendContainerFunctions(mutable builder, containerName(emitter, box), BOX_OPERATIONS, helpers)
  }
  for (const map of Arrays.values(listMapTypes(emitter))) {
    appendContainerFunctions(mutable builder, containerName(emitter, map), ["share"], helpers)
  }
  return Str.build(builder)
}

function appendContainerFunctions(
  mutable builder: StringBuilder,
  name: string,
  operations: Array<string>,
  helpers: Map<string, string>,
) uses alloc {
  // The functions of one container start after a blank line.
  let started = false
  for (const operation of Arrays.values(operations)) {
    const text = findHelper(helpers, `${name}_${operation}`)
    if (text != "") {
      if (!started) {
        Str.append(mutable builder, "\n")
        started = true
      }
      Str.append(mutable builder, text)
    }
  }
}

function listMapTypes(emitter: Emitter): Array<Type> uses alloc {
  // The map types in the order of their C names, for the share functions.
  let items: Array<SortItem> = []
  for (const entry of Maps.entries(emitter.checker.composites)) {
    const #[_, composite] = entry
    if (composite is Type.TMap(_, _)) {
      Arrays.push(mutable items, SortItem {
        key: typeId(emitter.checker, composite),
        type: composite,
      })
    }
  }
  let sorted: Array<Type> = []
  for (const item of Arrays.values(mergeSort(items))) {
    Arrays.push(mutable sorted, item.type)
  }
  return sorted
}

function buildCountCode(
  emitter: Emitter,
  operation: string,
  type: Type,
  value: string,
): string uses alloc {
  if (operation == "retain") {
    return retainCode(emitter, type, value)
  }
  if (operation == "share") {
    return shareCode(emitter, type, value)
  }
  return releaseCode(emitter, type, value)
}

function typeRcFunction(emitter: Emitter, type: Type, operation: string): string uses alloc {
  if (type is Type.TEnum(enumIndex)) {
    if (!isHeapEnum(emitter.checker, enumIndex)) {
      return inlineEnumRcFunction(emitter, type, enumIndex, operation)
    }
    if (operation == "drop") {
      return buildDropFunction(emitter, type, enumIndex)
    }
    if (operation == "credit" || operation == "uncredit") {
      return buildCreditFunction(emitter, type, enumIndex, operation)
    }
    if (operation == "share") {
      return buildShareFunction(emitter, type, enumIndex)
    }
  }
  let builder = Str.builder()
  const parameterType = parameterCType(emitter.checker, emitter.typeNames, type, false)
  const value = formatRcValue(emitter, type)
  const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
  Str.append(mutable builder, `static void ${opFuncName(operation, id)}(${parameterType} v) {\n`)
  if (type is Type.TStruct(structIndex)) {
    for (const field of Arrays.values(emitter.checker.structs[structIndex].fields)) {
      const statement = buildCountCode(
        emitter,
        operation,
        field.fieldType,
        `${value}.${fieldName(field.name)}`,
      )
      if (statement != "") {
        Str.append(mutable builder, `  ${statement}\n`)
      }
    }
  }
  if (type is Type.TFixedArray(element, _)) {
    const item = buildCountCode(emitter, operation, element, `${value}.items[i]`)
    const loop = Fixed.wrapItemsLoop(type, "i", item)
    if (loop != "") {
      Str.append(mutable builder, `  ${loop}\n`)
    }
  }
  if (type is Type.TEnum(_)) {
    if (operation == "retain" && emitter.threads) {
      Str.append(mutable builder, "  NARRA_COPY_HELD(v);\n  if (v.u) NARRA_RC_RETAIN(v.u->rc);\n")
    } else if (operation == "retain") {
      Str.append(mutable builder, "  NARRA_COPY_HELD(v);\n  if (v.u) v.u->rc++;\n")
    } else {
      // In debug builds, the mark counts the copies that retained the box.
      // The last release of the holders that one copy(...) made ends its
      // credit; when the box is freed, they all end.
      const uncreditName = opFuncName("uncredit", id)
      const dropName = opFuncName("drop", id)
      noteHelper(emitter, uncreditName)
      noteHelper(emitter, dropName)
      Str.append(mutable builder, `  NARRA_COPY_ENDED(v, ${uncreditName});\n`)
      if (emitter.threads) {
        Str.append(
          mutable builder,
          `  if (v.u && NARRA_RC_RELEASE(v.u->rc)) narra_drop(v.u, ${dropName});\n`,
        )
      } else {
        Str.append(mutable builder, `  if (v.u && --v.u->rc == 0) narra_drop(v.u, ${dropName});\n`)
      }
    }
  }
  Str.append(mutable builder, "}\n")
  return Str.build(builder)
}

function buildDropFunction(emitter: Emitter, type: Type, enumIndex: int): string uses alloc {
  // The drop function runs when the count reaches zero. Releasing a child
  // there queues it (narra_drop) instead of recursing, so the depth of a
  // structure does not use the C stack.
  let builder = Str.builder()
  const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
  const payload = payloadName(emitter.checker, type)
  Str.append(
    mutable builder,
    `static void ${opFuncName("drop", id)}(void* p) {\n  ${payload}* q = p;\n  switch (q->tag) {\n`,
  )
  for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
    let statements: Array<string> = []
    for (const field of Arrays.values(variant.fields)) {
      const statement = releaseCode(
        emitter,
        field.fieldType,
        `q->${variantName(variant)}.${fieldName(field.name)}`,
      )
      if (statement != "") {
        Arrays.push(mutable statements, statement)
      }
    }
    if (Arrays.length(statements) > 0) {
      Str.append(
        mutable builder,
        `  case ${Int.toString(variant.index)}: ${Str.join(statements, " ")} break;\n`,
      )
    }
  }
  Str.append(mutable builder, "  default: break;\n  }\n  narra_free(q);\n}\n")
  return Str.build(builder)
}

function buildShareFunction(emitter: Emitter, type: Type, enumIndex: int): string uses alloc {
  // Marks the payload shared and queues the fields of its variant
  // (narra_share), so a long list does not use the C stack. A payload that is
  // shared already was walked before, so the walk stops there.
  let builder = Str.builder()
  const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
  const shareName = opFuncName("share", id)
  const parameterType = parameterCType(emitter.checker, emitter.typeNames, type, false)
  const enumValue = formatRcValue(emitter, type)
  const payload = payloadName(emitter.checker, type)
  Str.append(
    mutable builder,
    `static void ${shareName}_parts(void* p) {\n  ${payload}* q = p;\n  switch (q->tag) {\n`,
  )
  for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
    let statements: Array<string> = []
    for (const field of Arrays.values(variant.fields)) {
      const statement = shareCode(
        emitter,
        field.fieldType,
        `q->${variantName(variant)}.${fieldName(field.name)}`,
      )
      if (statement != "") {
        Arrays.push(mutable statements, statement)
      }
    }
    if (Arrays.length(statements) > 0) {
      Str.append(
        mutable builder,
        `  case ${Int.toString(variant.index)}: ${Str.join(statements, " ")} break;\n`,
      )
    }
  }
  Str.append(mutable builder, "  default: break;\n  }\n}\n")
  Str.append(
    mutable builder,
    `static void ${shareName}(${parameterType} v) {\n  if (${enumValue}.u && narra_rc_share(&${enumValue}.u->rc)) narra_share(${enumValue}.u, ${shareName}_parts);\n}\n`,
  )
  return Str.build(builder)
}

function buildContainerShare(name: string, parts: string): string uses alloc {
  // A container marks itself and queues its parts (narra_share), as drop does.
  if (parts == "") {
    return `static void ${name}_share(${name}* a) { narra_rc_share(&a->rc); }\n`
  }
  return `static void ${name}_share_parts(void* p) {\n  ${name}* a = p;\n${parts}}\nstatic void ${name}_share(${name}* a) {\n  if (narra_rc_share(&a->rc)) narra_share(a, ${name}_share_parts);\n}\n`
}

function mapShareFunction(emitter: Emitter, map: Type): string uses alloc {
  // Marks the map shared, then its live keys and values.
  const name = containerName(emitter, map)
  let parts: Array<string> = []
  if (map is Type.TMap(keyType, valueType)) {
    const keyText = shareCode(emitter, keyType, "a->keys[i]")
    if (keyText != "") {
      Arrays.push(mutable parts, keyText)
    }
    const valueText = shareCode(emitter, valueType, "a->vals[i]")
    if (valueText != "") {
      Arrays.push(mutable parts, valueText)
    }
  }
  let loop = ""
  if (Arrays.length(parts) > 0) {
    loop = `  for (int64_t i = 0; i < a->used; i++) {\n    if (a->alive[i]) { ${Str.join(parts, " ")} }\n  }\n`
  }
  return buildContainerShare(name, loop)
}

function buildCreditFunction(
  emitter: Emitter,
  type: Type,
  enumIndex: int,
  operation: string,
): string uses alloc {
  // A copy(...) of a heap enum retains only its payload box, and a payload is
  // never written. The debug copy check gives a credit to each counted value
  // inside the payload instead, so a copy on write of a part taken out of the
  // copy is explained. The parts keep a count of one, so their credits never
  // end on their own: the copy marks the box it retained (buildCreditCode),
  // and when the last holder of that copy is released the "uncredit" function takes
  // one credit back from each part. Nested payload boxes are walked, not
  // marked, because the copy did not retain them.
  let builder = Str.builder()
  const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
  const parameterType = parameterCType(emitter.checker, emitter.typeNames, type, false)
  const enumValue = formatRcValue(emitter, type)
  const payload = payloadName(emitter.checker, type)
  Str.append(
    mutable builder,
    `NARRA_COPY_ONLY(\nstatic void ${opFuncName(operation, id)}(${parameterType} v) {\n  if (!${enumValue}.u) return;\n  ${payload}* q = ${enumValue}.u;\n  switch (q->tag) {\n`,
  )
  for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
    let statements: Array<string> = []
    for (const field of Arrays.values(variant.fields)) {
      const statement = buildPartCreditCode(
        emitter,
        field.fieldType,
        `q->${variantName(variant)}.${fieldName(field.name)}`,
        operation,
      )
      if (statement != "") {
        Arrays.push(mutable statements, statement)
      }
    }
    if (Arrays.length(statements) > 0) {
      Str.append(
        mutable builder,
        `  case ${Int.toString(variant.index)}: ${Str.join(statements, " ")} break;\n`,
      )
    }
  }
  Str.append(mutable builder, "  default: break;\n  }\n}\n)\n")
  return Str.build(builder)
}

export function buildCreditCode(emitter: Emitter, type: Type, value: string): string uses alloc {
  // The statements that give a credit to each counted value that a retain of
  // value does not reach: the parts of a heap enum payload. Each payload box
  // the retain reached is marked, so its release can take the credits back.
  // Empty when a retain reaches every part.
  const base = underlyingType(emitter, type)
  if (!holdsHeapEnum(emitter, base)) {
    return ""
  }
  return match (base) {
    Type.TEnum(enumIndex) => {
      if (isHeapEnum(emitter.checker, enumIndex)) {
        const call = buildPayloadCall(emitter, base, value, "credit")
        return `if ((${value}).u) { narra_copy_credit((${value}).u); NARRA_COPY_BRAND(${value}); } ${call}`
      }
      let cases: Array<string> = []
      for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
        let statements: Array<string> = []
        for (const field of Arrays.values(variant.fields)) {
          const statement = buildCreditCode(
            emitter,
            field.fieldType,
            `(${value}).u.${variantName(variant)}.${fieldName(field.name)}`,
          )
          if (statement != "") {
            Arrays.push(mutable statements, statement)
          }
        }
        if (Arrays.length(statements) > 0) {
          Arrays.push(
            mutable cases,
            `case ${Int.toString(variant.index)}: ${Str.join(statements, " ")} break;`,
          )
        }
      }
      return `switch ((${value}).tag) { ${Str.join(cases, " ")} default: break; }`
    }
    Type.TStruct(structIndex) => {
      let statements: Array<string> = []
      for (const field of Arrays.values(emitter.checker.structs[structIndex].fields)) {
        const statement = buildCreditCode(
          emitter,
          field.fieldType,
          `(${value}).${fieldName(field.name)}`,
        )
        if (statement != "") {
          Arrays.push(mutable statements, statement)
        }
      }
      return Str.join(statements, " ")
    }
    Type.TFixedArray(element, _) => {
      const indexName = Fixed.buildItemIndexName(value)
      const item = buildCreditCode(emitter, element, `(${value}).items[${indexName}]`)
      return Fixed.wrapItemsLoop(base, indexName, item)
    }
    _ => ""
  }
}

function buildPayloadCall(
  emitter: Emitter,
  type: Type,
  value: string,
  operation: string,
): string uses alloc {
  const name = opFuncName(operation, cachedTypeId(emitter.checker, emitter.typeNames, type))
  noteHelper(emitter, name)
  if (isPassedByPointer(emitter.checker, type)) {
    return `${name}(&(${value}));`
  }
  return `${name}(${value});`
}

function buildPartCreditCode(
  emitter: Emitter,
  type: Type,
  value: string,
  operation: string,
): string uses alloc {
  // The statements that give a credit to every counted value in a part of a
  // heap enum payload, which no retain of the copy reaches, or with operation
  // "uncredit" take one of its credits back.
  const base = underlyingType(emitter, type)
  let partText = `if (${value}) NARRA_COPY_SHARED(${value});`
  if (operation == "uncredit") {
    partText = `if (${value}) { narra_copy_slot* slot = narra_copy_find(${value}); if (slot && slot->credits > 1) slot->credits--; else if (slot) narra_copy_forget(${value}); }`
  }
  return match (base) {
    Type.TArray(_)
      | Type.TBox(_)
      | Type.TMap(_, _)
      | Type.TStringBuilder
      | Type.TGenerator(_, _, _, _, _) => partText
    Type.TEnum(enumIndex) => {
      if (!needsRc(emitter, base)) {
        return ""
      }
      if (isHeapEnum(emitter.checker, enumIndex)) {
        return buildPayloadCall(emitter, base, value, operation)
      }
      let cases: Array<string> = []
      for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
        let statements: Array<string> = []
        for (const field of Arrays.values(variant.fields)) {
          const statement = buildPartCreditCode(
            emitter,
            field.fieldType,
            `(${value}).u.${variantName(variant)}.${fieldName(field.name)}`,
            operation,
          )
          if (statement != "") {
            Arrays.push(mutable statements, statement)
          }
        }
        if (Arrays.length(statements) > 0) {
          Arrays.push(
            mutable cases,
            `case ${Int.toString(variant.index)}: ${Str.join(statements, " ")} break;`,
          )
        }
      }
      if (Arrays.length(cases) == 0) {
        return ""
      }
      return `switch ((${value}).tag) { ${Str.join(cases, " ")} default: break; }`
    }
    Type.TStruct(structIndex) => {
      let statements: Array<string> = []
      for (const field of Arrays.values(emitter.checker.structs[structIndex].fields)) {
        const statement = buildPartCreditCode(
          emitter,
          field.fieldType,
          `(${value}).${fieldName(field.name)}`,
          operation,
        )
        if (statement != "") {
          Arrays.push(mutable statements, statement)
        }
      }
      return Str.join(statements, " ")
    }
    Type.TFixedArray(element, _) => {
      const indexName = Fixed.buildItemIndexName(value)
      const item = buildPartCreditCode(
        emitter,
        element,
        `(${value}).items[${indexName}]`,
        operation,
      )
      return Fixed.wrapItemsLoop(base, indexName, item)
    }
    _ => ""
  }
}

function holdsHeapEnum(emitter: Emitter, type: Type): bool {
  // Whether a value of type has a heap enum in a part that a retain reaches
  // directly: a field of a struct or a payload field of an inline enum.
  return match (type) {
    Type.TEnum(enumIndex) => {
      if (isHeapEnum(emitter.checker, enumIndex)) {
        return needsRc(emitter, type)
      }
      for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
        for (const field of Arrays.values(variant.fields)) {
          if (holdsHeapEnum(emitter, underlyingType(emitter, field.fieldType))) {
            return true
          }
        }
      }
      return false
    }
    Type.TStruct(structIndex) => {
      for (const field of Arrays.values(emitter.checker.structs[structIndex].fields)) {
        if (holdsHeapEnum(emitter, underlyingType(emitter, field.fieldType))) {
          return true
        }
      }
      return false
    }
    Type.TFixedArray(element, _) => holdsHeapEnum(emitter, underlyingType(emitter, element))
    _ => false
  }
}

function inlineEnumRcFunction(
  emitter: Emitter,
  type: Type,
  enumIndex: int,
  operation: string,
): string uses alloc {
  let builder = Str.builder()
  const parameterType = parameterCType(emitter.checker, emitter.typeNames, type, false)
  const enumValue = formatRcValue(emitter, type)
  const id = cachedTypeId(emitter.checker, emitter.typeNames, type)
  Str.append(
    mutable builder,
    `static void ${opFuncName(operation, id)}(${parameterType} v) {\n  switch (${enumValue}.tag) {\n`,
  )
  // Each case counts the fields of one variant, as a struct counts its fields.
  for (const variant of Arrays.values(emitter.checker.enums[enumIndex].variants)) {
    let statements: Array<string> = []
    for (const field of Arrays.values(variant.fields)) {
      const value = `${enumValue}.u.${variantName(variant)}.${fieldName(field.name)}`
      const statement = buildCountCode(emitter, operation, field.fieldType, value)
      if (statement != "") {
        Arrays.push(mutable statements, statement)
      }
    }
    if (Arrays.length(statements) > 0) {
      Str.append(
        mutable builder,
        `  case ${Int.toString(variant.index)}: ${Str.join(statements, " ")} break;\n`,
      )
    }
  }
  Str.append(mutable builder, "  default: break;\n  }\n}\n")
  return Str.build(builder)
}

function formatRcValue(emitter: Emitter, type: Type): string uses alloc {
  // A large value reaches its retain and release functions by pointer.
  if (isPassedByPointer(emitter.checker, type)) {
    return "(*v)"
  }
  return "v"
}

function arrayFunction(emitter: Emitter, array: Type, operation: string): string uses alloc {
  const name = containerName(emitter, array)
  const element = getElementType(array)
  if (emitter.threads) {
    const threaded = arrayThreadFunction(emitter, array, operation)
    if (threaded != "") {
      return threaded
    }
  }
  const elementType = cachedCType(emitter.checker, emitter.typeNames, element)
  return match (operation) {
    "new" => `static ${name}* ${name}_new(int64_t cap) {
  ${name}* a = narra_alloc(sizeof(${name}));
  a->rc = 1; a->len = 0; a->cap = cap;
  a->items = narra_alloc(sizeof(${elementType}) * (size_t)(cap > 0 ? cap : 1));
  return a;
}
`
    "retain" => `static void ${name}_retain(${name}* a) { a->rc++; NARRA_COPY_SHARED(a); }
`
    "release" => `static void ${name}_release(${name}* a) {
  NARRA_COPY_DROP(a);
  if (--a->rc == 0) {
    for (int64_t i = 0; i < a->len; i++) { ${releaseCode(emitter, element, "a->items[i]")} }
    narra_free(a->items);
    narra_free(a);
  }
}
`
    "unique" => `// Returns an array the caller owns alone, copying it when it is shared.
static ${name}* ${useHelper(emitter, name, "copy")}(${name}* a);
static inline ${name}* ${name}_unique(${name}* a) {
  if (NARRA_LIKELY(a->rc == 1)) return a;
  return ${name}_copy(a);
}
`
    "copy" => `NARRA_NOINLINE static ${name}* ${name}_copy(${name}* a) {
  NARRA_COPY_WRITE(a, 0);
  ${name}* c = ${useHelper(emitter, name, "new")}(a->cap);
  memcpy(c->items, a->items, sizeof(${elementType}) * (size_t)a->len);
  c->len = a->len;
  for (int64_t i = 0; i < c->len; i++) { ${retainCode(emitter, element, "c->items[i]")} }
  NARRA_COPY_WRITTEN(); NARRA_COPY_DROP(a);
  a->rc--;
  return c;
}
`
    "push" => `static void ${name}_push(${name}** p, ${elementType} v) {
  ${name}* a = ${useHelper(emitter, name, "unique")}(*p);
  if (a->len == a->cap) {
    a->cap = a->cap ? a->cap * 2 : 4;
    a->items = narra_realloc(a->items, sizeof(${elementType}) * (size_t)a->cap);
  }
  a->items[a->len++] = v;
  *p = a;
}
`
    "get" => `static ${elementType} ${name}_get(${name}* a, int64_t i, const char* where) {
  narra_bounds(i, a->len, where);
  return a->items[i];
}
`
    "at" => `static ${elementType}* ${name}_at(${name}** p, int64_t i, const char* where) {
  *p = ${useHelper(emitter, name, "unique")}(*p);
  narra_bounds(i, (*p)->len, where);
  return &(*p)->items[i];
}
`
    _ => `static ${name}* ${name}_filled(${elementType} v, int64_t n) {
  ${name}* a = ${useHelper(emitter, name, "new")}(n);
  for (int64_t i = 0; i < n; i++) { a->items[i] = v; ${retainCode(emitter, element, "a->items[i]")} }
  a->len = n;
  return a;
}
`
  }
}

function arrayThreadFunction(emitter: Emitter, array: Type, operation: string): string uses alloc {
  // The functions whose counts differ in thread mode, or "" for the others.
  const name = containerName(emitter, array)
  const element = getElementType(array)
  const elementType = cachedCType(emitter.checker, emitter.typeNames, element)
  return match (operation) {
    "retain" => `static void ${name}_retain(${name}* a) { NARRA_RC_RETAIN(a->rc); NARRA_COPY_SHARED(a); }
`
    "release" => `static void ${name}_release(${name}* a) {
  NARRA_COPY_DROP(a);
  if (NARRA_RC_RELEASE(a->rc)) {
    for (int64_t i = 0; i < a->len; i++) { ${releaseCode(emitter, element, "a->items[i]")} }
    narra_free(a->items);
    narra_free(a);
  }
}
`
    "unique" => `// Returns an array the caller owns alone, copying it when it is shared.
static ${name}* ${useHelper(emitter, name, "copy")}(${name}* a);
static inline ${name}* ${name}_unique(${name}* a) {
  if (NARRA_LIKELY(!NARRA_RC_UNSHARE(a->rc))) return a;
  return ${name}_copy(a);
}
`
    "copy" => `NARRA_NOINLINE static ${name}* ${name}_copy(${name}* a) {
  NARRA_COPY_WRITE(a, 0);
  ${name}* c = ${useHelper(emitter, name, "new")}(a->cap);
  memcpy(c->items, a->items, sizeof(${elementType}) * (size_t)a->len);
  c->len = a->len;
  for (int64_t i = 0; i < c->len; i++) { ${retainCode(emitter, element, "c->items[i]")} }
  NARRA_COPY_WRITTEN();
  ${useHelper(emitter, name, "release")}(a);
  return c;
}
`
    "share" => buildArrayShare(emitter, name, element)
    _ => ""
  }
}

function buildArrayShare(emitter: Emitter, name: string, element: Type): string uses alloc {
  const item = shareCode(emitter, element, "a->items[i]")
  if (item == "") {
    return buildContainerShare(name, "")
  }
  return buildContainerShare(name, `  for (int64_t i = 0; i < a->len; i++) { ${item} }\n`)
}

function buildBoxShare(emitter: Emitter, name: string, element: Type): string uses alloc {
  const value = shareCode(emitter, element, "a->f_value")
  if (value == "") {
    return buildContainerShare(name, "")
  }
  return buildContainerShare(name, `  ${value}\n`)
}

function boxThreadFunction(emitter: Emitter, box: Type, operation: string): string uses alloc {
  // The functions whose counts differ in thread mode, or "" for the others.
  const name = containerName(emitter, box)
  const element = getElementType(box)
  return match (operation) {
    "retain" => `static void ${name}_retain(${name}* a) { NARRA_RC_RETAIN(a->rc); NARRA_COPY_SHARED(a); }
`
    "unique" => `// Returns a box the caller owns alone, copying it when it is shared.
static ${name}* ${name}_unique(${name}* a) {
  if (!NARRA_RC_UNSHARE(a->rc)) return a;
  NARRA_COPY_WRITE(a, 1);
  ${name}* c = ${useHelper(emitter, name, "new")}(a->f_value);
  ${retainCode(emitter, element, "c->f_value")}
  NARRA_COPY_WRITTEN();
  ${useHelper(emitter, name, "release")}(a);
  return c;
}
`
    "release" => `static void ${name}_release(${name}* a) {
  NARRA_COPY_DROP(a);
  if (NARRA_RC_RELEASE(a->rc)) narra_drop(a, ${useHelper(emitter, name, "drop")});
}
`
    "share" => buildBoxShare(emitter, name, element)
    _ => ""
  }
}

function boxFunction(emitter: Emitter, box: Type, operation: string): string uses alloc {
  const name = containerName(emitter, box)
  const element = getElementType(box)
  if (emitter.threads) {
    const threaded = boxThreadFunction(emitter, box, operation)
    if (threaded != "") {
      return threaded
    }
  }
  const elementType = cachedCType(emitter.checker, emitter.typeNames, element)
  return match (operation) {
    "new" => `static ${name}* ${name}_new(${elementType} v) {
  ${name}* a = narra_alloc(sizeof(${name}));
  a->rc = 1; a->f_value = v;
  return a;
}
`
    "retain" => `static void ${name}_retain(${name}* a) { a->rc++; NARRA_COPY_SHARED(a); }
`
    "unique" => `// Returns a box the caller owns alone, copying it when it is shared.
static ${name}* ${name}_unique(${name}* a) {
  if (a->rc == 1) return a;
  NARRA_COPY_WRITE(a, 1);
  ${name}* c = ${useHelper(emitter, name, "new")}(a->f_value);
  ${retainCode(emitter, element, "c->f_value")}
  NARRA_COPY_WRITTEN(); NARRA_COPY_DROP(a);
  a->rc--;
  return c;
}
`
    "at" => `static ${elementType}* ${name}_at(${name}** p) {
  *p = ${useHelper(emitter, name, "unique")}(*p);
  return &(*p)->f_value;
}
`
    "drop" => `static void ${name}_drop(void* p) {
  ${name}* a = p;
  ${releaseCode(emitter, element, "a->f_value")}
  narra_free(a);
}
`
    _ => `static void ${name}_release(${name}* a) {
  NARRA_COPY_DROP(a);
  if (--a->rc == 0) narra_drop(a, ${useHelper(emitter, name, "drop")});
}
`
  }
}

export function enumAllocation(
  mutable emitter: Emitter,
  enumType: Type,
  variant: int,
  fields: Array<string>,
): Code uses alloc {
  // fields are the already consumed field values, in order. The result is not
  // owned: the caller wraps it in an owned temporary when it needs one.
  const baseType = underlyingType(emitter, enumType)
  const enumIndex = match (baseType) { Type.TEnum(index) => index, _ => 0 - 1 }
  if (enumIndex < 0) {
    return Code {
      text: reportUnsupported(mutable emitter, "enum allocation", "selfhost-emit-decls"),
      owned: false,
    }
  }
  const info = copy(emitter.checker.enums[enumIndex].variants[variant])
  const name = cachedCType(emitter.checker, emitter.typeNames, baseType)
  const tag = Int.toString(info.index)
  // A void field has no member; its value is a call that runs for its effect.
  for (const index of Ranges.between(0, Arrays.length(fields))) {
    if (index < Arrays.length(info.fields) && info.fields[index].fieldType == Type.TVoid) {
      writeLine(mutable emitter, `${fields[index]};`)
    }
  }
  if (Arrays.length(fields) == 0 || !hasValueFields(info)) {
    return Code { text: `((${name}){.tag = ${tag}})`, owned: false }
  }
  if (!isHeapEnum(emitter.checker, enumIndex)) {
    // An inline payload is a compound literal; the value owns the fields.
    let members: Array<string> = []
    for (const index of Ranges.between(0, Arrays.length(info.fields))) {
      if (info.fields[index].fieldType != Type.TVoid) {
        Arrays.push(mutable members, `.${fieldName(info.fields[index].name)} = ${fields[index]}`)
      }
    }
    return Code {
      text: `((${name}){.tag = ${tag}, .u.${variantName(info)} = {${Str.join(members, ", ")}}})`,
      owned: false,
    }
  }
  // A variant with fields lives in a heap payload.
  emitter.tempCount++
  const pointer = `q${Int.toString(emitter.tempCount)}`
  const payload = payloadName(emitter.checker, baseType)
  writeLine(mutable emitter, `${payload}* ${pointer} = narra_alloc(sizeof(${payload}));`)
  writeLine(mutable emitter, `${pointer}->rc = 1; ${pointer}->tag = ${tag};`)
  for (const index of Ranges.between(0, Arrays.length(info.fields))) {
    if (info.fields[index].fieldType != Type.TVoid) {
      writeLine(
        mutable emitter,
        `${pointer}->${variantName(info)}.${fieldName(info.fields[index].name)} = ${fields[index]};`,
      )
    }
  }
  return Code { text: `((${name}){.tag = ${tag}, .u = ${pointer}})`, owned: false }
}
