// error: closure_borrow_escaping_in_stack.nra:9:30: a closure cannot capture "count" because it is declared with let
function apply(f: () => int): int {
  return f()
}

export function run(args: Array<string>): int {
  let count = 1
  return apply(() => {
    const inner = (): int => count
    return inner()
  })
}
