// error: step.line = ... may change path, which saved still uses at line 14
struct Pos {
  line: int
  column: int
}

export function run(_args: Array<string>): int {
  let path = [Pos { line: 1, column: 2 }]
  const saved = path
  // `for (mutable step of path)` writes the elements of path in place.
  for (mutable step of path) {
    step.line = 3
  }
  return saved[0].line + path[0].line
}
