// error: "a" is a int, not a function; if `<` is a comparison, wrap it in parentheses, as in `(a < 3)`
function both(first: bool, second: bool): bool {
  return first && second
}

export function run(_args: Array<string>): int {
  const a = 1
  const c = 2
  if (both(a<3, 4>(c))) {
    print("yes")
  }
  return 0
}
