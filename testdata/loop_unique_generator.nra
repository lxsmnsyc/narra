// A generator that writes an array by index in a loop and yields after each
// write. Copying the generator keeps a second owner of the array across the
// yield, so the copies must not share element storage.
import * as Co from "std/coroutine"
import { Step } from "std/coroutine"
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

function* fillAndSum(): Generator<int> {
  let cells = Arrays.filled(0, 3)
  for (const i of Ranges.upTo(3)) {
    cells[i] = 1
    let sum = 0
    for (const cell of Arrays.values(cells)) {
      sum = sum + cell
    }
    yield sum
  }
}

function show(step: Step<int>): string {
  return match (step) {
    Step.Yielded(value) => Int.toString(value)
    Step.Done => "done"
    Step.Panicked(message) => message
  }
}

export function run(args: Array<string>): int {
  let original = fillAndSum()
  const first = show(Co.resume(mutable original))
  let copy = original
  const second = show(Co.resume(mutable original))
  const third = show(Co.resume(mutable original))
  const copySecond = show(Co.resume(mutable copy))
  const copyThird = show(Co.resume(mutable copy))
  print(`${first} ${second} ${third} ${copySecond} ${copyThird}`)
  return 0
}
