// error: loop element "player" cannot be assigned whole; `mutable` reaches its fields and elements, so assign those, or write an index loop to replace the element
struct Player {
  hp: int
}

export function run(args: Array<string>): int {
  const players = [Player { hp: 3 }]
  for (mutable player of players) {
    player = Player { hp: 0 }
  }
  return 0
}
