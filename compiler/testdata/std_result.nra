// std/result: map, mapErr, andThen, withDefault, ok, err.
import * as Results from "std/result"
import * as Options from "std/option"
import * as Int from "std/int"

function parse(s: string): Result<int, string> {
  return Results.mapErr(Int.parse(s, 10), (e) => `bad ${s}`)
}

function positive(n: int): Result<int, string> {
  if (n > 0) {
    return Ok(n)
  }
  return Err("not positive")
}

function noisy(n: int): int uses io {
  print(`noisy ${Int.toString(n)}`)
  return n * 2
}

function show(r: Result<int, string>): string {
  return match (r) {
    Ok(v) => `Ok(${Int.toString(v)})`
    Err(e) => `Err(${e})`
  }
}

function showOpt(o: Option<int>): string {
  return match (o) {
    Some(v) => `Some(${Int.toString(v)})`
    None => "None"
  }
}

export function run(args: Array<string>): int {
  const k = 100
  const good = parse("5")
  const bad = parse("x")
  print(show(good))
  print(show(bad))
  // map
  print(show(Results.map(good, (x) => x + k)))
  print(show(Results.map(bad, (x) => x + k)))
  print(show(Results.map(good, noisy)))
  const text = Results.map(good, (x) => `v${Int.toString(x)}`)
  print(Results.withDefault(text, "none"))
  // mapErr
  print(show(Results.mapErr(bad, (e) => `${e}!`)))
  print(show(Results.mapErr(good, (e) => `${e}!`)))
  print(show(Results.mapErr(bad, (e) => `${e} ${Int.toString(k)}`)))
  // andThen
  print(show(Results.andThen(good, positive)))
  print(show(Results.andThen(parse("-3"), positive)))
  print(show(Results.andThen(bad, positive)))
  print(show(Results.andThen(good, (x): Result<int, string> => positive(x - k))))
  // The expected type lets the callback write Err without an annotation.
  const forced: Result<int, string> = Results.andThen(good, (x) => Err("forced"))
  print(show(forced))
  // withDefault
  print(Int.toString(Results.withDefault(good, 0)))
  print(Int.toString(Results.withDefault(bad, 9)))
  // ok, err
  print(showOpt(Results.ok(good)))
  print(showOpt(Results.ok(bad)))
  print(Options.withDefault(Results.err(bad), "no error"))
  print(Options.withDefault(Results.err(good), "no error"))
  return 0
}
