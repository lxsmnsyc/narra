// The source details the syntax tree drops, kept in side tables for
// `narrac fmt` (contract fmt-trivia): comments, blank lines, written
// parentheses and the end of each node.
//
// How it works. The lexer keeps the comments (lexWithComments). While
// parseWithTrivia runs, the parser notes every node it finishes as a
// record: an anchor key, the node's first token and the end of its last
// token. Records come in post order, so one pass with a stack turns them
// into a tree. buildTrivia then attaches each comment to that tree the way
// Prettier does (enclosing, preceding and following node), and finds blank
// lines. The tree is not the syntax tree: it holds only the nodes that have
// an anchor key.
//
// Anchor keys: `e<id>` for an expression, pattern or parameter, and a kind
// letter with the start position for the nodes that have no id: `s`
// statement, `d` declaration, `t` type, `f` field (struct field, field
// initializer, field pattern), `v` variant, `a` match arm, `i` import,
// `b` block, `x` extern block (its members are `d` declarations), `r`
// the closing brace of an extern block, `l` its library name and `k` its `from`
// keyword (keyed at the library's position). The position is the node's `pos`
// field, not its first token (a declaration's `pos` is its keyword, after
// `export`). The root, the file, has the key `file`.
//
// Comment keys: `c<index>` in blankBefore (see buildTrivia).
import { filledArray, splitString, substring } from "narrac/textops"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Maps from "std/map"
import { Pos, Decl, Stmt, Expr, Pattern } from "narrac/ast"

export enum CommentKind {
  Line
  Block
  Doc
}

export enum Placement {
  Leading
  Trailing
  Dangling
}

// A comment as written. text has the markers; pos is its first character
// and end the position after its last. ownLine is true when only whitespace
// comes before it on its line.
export struct Comment {
  kind: CommentKind
  text: string
  pos: Pos
  end: Pos
  ownLine: bool
}

export struct Attached {
  comment: int // index into Trivia.comments
  placement: Placement
}

export struct Trivia {
  comments: Array<Comment> // source order
  attached: Map<string, Array<Attached>> // by anchor key, in source order
  blankBefore: Map<string, bool> // anchors with a blank line before them
  parenthesized: Map<int, bool> // expression ids written inside ( )
  ends: Map<string, Pos> // anchor key to the position after the node's last token
}

// One finished node. start is its first token (including `export` and
// parentheses), end the position after its last token.
export struct NodeRecord {
  key: string
  start: Pos
  end: Pos
}

// What the parser collects. With enabled false nothing is added, so a plain
// parse costs the same as before.
export struct Collector {
  enabled: bool
  records: Array<NodeRecord> // in the order the nodes finish: children first
  recordIndex: Map<string, int> // key to index in records
  parenthesized: Map<int, bool>
  // the range a node had before its parentheses were added, by key
  insideParens: Map<string, NodeRecord>
  // keys of the conditionals that `return c ? a : b` turns into an if: they
  // have no printer of their own, so their parentheses stay in their range
  convertedKeys: Map<string, bool>
}

export function createCollector(enabled: bool): Collector uses alloc {
  return Collector {
    enabled: enabled,
    records: [],
    recordIndex: Map {},
    parenthesized: Map {},
    insideParens: Map {},
    convertedKeys: Map {},
  }
}

// ---- Keys

export function getPosKey(letter: string, pos: Pos): string uses alloc {
  return `${letter}${Int.toString(pos.line)}:${Int.toString(pos.column)}`
}

export function getIdKey(id: int): string uses alloc {
  return `e${Int.toString(id)}`
}

export function getDeclPos(declaration: Decl): Pos {
  return match (declaration) {
    Decl.Func(inner) => copy(inner.pos)
    Decl.Const(inner) => copy(inner.pos)
    Decl.Struct(inner) => copy(inner.pos)
    Decl.Enum(inner) => copy(inner.pos)
    Decl.Distinct(inner) => copy(inner.pos)
    Decl.Alias(inner) => copy(inner.pos)
    Decl.Test(inner) => copy(inner.pos)
    Decl.Trait(inner) => copy(inner.pos)
    Decl.Impl(inner) => copy(inner.pos)
  }
}

export function getStmtPos(statement: Stmt): Pos {
  return match (statement) {
    Stmt.BlockStmt(block) => copy(block.pos)
    Stmt.VarStmt(_, pos, _, _, _, _, _)
      | Stmt.AssignStmt(pos, _, _)
      | Stmt.CompoundAssignStmt(pos, _, _, _)
      | Stmt.ExprStmt(pos, _)
      | Stmt.ReturnStmt(pos, _)
      | Stmt.IfStmt(pos, _, _, _)
      | Stmt.WhileStmt(pos, _, _, _)
      | Stmt.CForStmt(pos, _, _, _, _, _)
      | Stmt.ForStmt(_, pos, _, _, _, _, _) => copy(pos)
    Stmt.YieldStmt(pos, _, _, binding) => match (binding) {
      Some(bound) => copy(bound.pos)
      None => copy(pos)
    }
    Stmt.BreakStmt(pos, _) | Stmt.ContinueStmt(pos, _) => copy(pos)
  }
}

export function getExprId(expression: Expr): int {
  return match (expression) {
    Expr.IntLit(id, _, _)
      | Expr.FloatLit(id, _, _)
      | Expr.StringLit(id, _, _, _)
      | Expr.CharLit(id, _, _)
      | Expr.BoolLit(id, _, _)
      | Expr.TemplateLit(id, _, _)
      | Expr.Ident(id, _, _)
      | Expr.FieldExpr(id, _, _, _)
      | Expr.IsExpr(id, _, _, _)
      | Expr.IndexExpr(id, _, _, _)
      | Expr.MapLit(id, _, _, _, _)
      | Expr.CallExpr(id, _, _, _, _)
      | Expr.UnaryExpr(id, _, _, _)
      | Expr.BinaryExpr(id, _, _, _, _)
      | Expr.StructLit(id, _, _, _, _, _)
      | Expr.ArrayLit(id, _, _, _)
      | Expr.MatchExpr(id, _, _, _)
      | Expr.BlockExpr(id, _, _)
      | Expr.ArrowExpr(id, _, _, _, _, _)
      | Expr.AwaitExpr(id, _, _)
      | Expr.AsyncExpr(id, _, _) => id
  }
}

export function getPatternId(pattern: Pattern): int {
  return match (pattern) {
    Pattern.PatWildcard(id, _)
      | Pattern.PatName(id, _, _)
      | Pattern.PatCtor(id, _, _, _, _, _)
      | Pattern.PatStruct(id, _, _)
      | Pattern.PatTuple(id, _, _)
      | Pattern.PatArray(id, _, _, _)
      | Pattern.PatLit(id, _, _)
      | Pattern.PatOr(id, _, _)
      | Pattern.PatCompare(id, _, _, _) => id
  }
}

// ---- Positions

function isBefore(left: Pos, right: Pos): bool {
  return left.line < right.line || (left.line == right.line && left.column < right.column)
}

function isSamePos(left: Pos, right: Pos): bool {
  return left.line == right.line && left.column == right.column
}

// ---- Collecting

export function noteNode(
  mutable collector: Collector,
  key: string,
  start: Pos,
  end: Pos,
) uses alloc {
  // A node noted again (the same expression returned by each parse level) keeps its first range, unless the new range is larger: a parenthesized expression grows to include its parentheses.
  if (collector.recordIndex[key] is Some(index)) {
    const old = collector.records[index]
    const grows = !isBefore(old.start, start) && !isBefore(end, old.end)
    const changes = !isSamePos(old.start, start) || !isSamePos(old.end, end)
    if (grows && changes) {
      if (collector.insideParens[key] is None) {
        collector.insideParens[key] = old
      }
      collector.records[index] = NodeRecord { key: key, start: start, end: end }
    }
    return
  }
  collector.recordIndex[key] = Arrays.length(collector.records)
  Arrays.push(mutable collector.records, NodeRecord { key: key, start: start, end: end })
}

// ---- Building

// The tree of records: childLists[i] are the records inside record i, and
// rootChildren the ones inside no other.
struct RecordTree {
  childLists: Array<Array<int>>
  rootChildren: Array<int>
}

function buildTree(records: Array<NodeRecord>): RecordTree uses alloc {
  let childLists: Array<Array<int>> = []
  let stack: Array<int> = []
  let stackSize = 0
  for (const index of Ranges.upTo(Arrays.length(records))) {
    const record = records[index]
    // Records come in post order, so when a record arrives, every pending record that starts at or after its start is inside it.
    // pop the records inside this one (last first)
    let reversed: Array<int> = []
    while (stackSize > 0 && !isBefore(records[stack[stackSize - 1]].start, record.start)) {
      Arrays.push(mutable reversed, stack[stackSize - 1])
      stackSize--
    }
    let children: Array<int> = []
    let position = Arrays.length(reversed)
    while (position > 0) {
      position--
      Arrays.push(mutable children, reversed[position])
    }
    Arrays.push(mutable childLists, children)
    if (stackSize < Arrays.length(stack)) {
      stack[stackSize] = index
    } else {
      Arrays.push(mutable stack, index)
    }
    stackSize++
  }
  let rootChildren: Array<int> = []
  for (const index of Ranges.upTo(stackSize)) {
    Arrays.push(mutable rootChildren, stack[index])
  }
  return RecordTree { childLists: childLists, rootChildren: rootChildren }
}

function isSpace(character: char): bool {
  return character == ' ' || character == '\t' || character == '\r'
}

function isBlankLine(lines: Array<string>, line: int): bool uses alloc {
  // Line numbers start at 1.
  if (line < 1 || line > Arrays.length(lines)) {
    return false
  }
  for (const character of Arrays.values(Str.chars(lines[line - 1]))) {
    if (!isSpace(character)) {
      return false
    }
  }
  return true
}

function hasBlankLineBetween(lines: Array<string>, fromLine: int, toLine: int): bool uses alloc {
  for (let line = fromLine + 1; line < toLine; line++) {
    if (isBlankLine(lines, line)) {
      return true
    }
  }
  return false
}

function endsLine(lines: Array<string>, comment: Comment): bool uses alloc {
  const isLine = match (comment.kind) {
    CommentKind.Line | CommentKind.Doc => true
    CommentKind.Block => false
  }
  if (isLine) {
    return true
  }
  if (comment.end.line < 1 || comment.end.line > Arrays.length(lines)) {
    return true
  }
  const characters = Str.chars(lines[comment.end.line - 1])
  for (const index of Ranges.between(comment.end.column - 1, Arrays.length(characters))) {
    if (!isSpace(characters[index])) {
      return false
    }
  }
  return true
}

function isFollowedByCloser(lines: Array<string>, comment: Comment): bool uses alloc {
  if (comment.end.line < 1 || comment.end.line > Arrays.length(lines)) {
    return false
  }
  const characters = Str.chars(lines[comment.end.line - 1])
  for (const index of Ranges.between(comment.end.column - 1, Arrays.length(characters))) {
    const character = characters[index]
    if (!isSpace(character)) {
      // A comma, closing bracket or semicolon ends the node the comment sits behind.
      return character == ',' ||
        character == ')' ||
        character == ']' ||
        character == '}' ||
        character == ';'
    }
  }
  return false
}

function isOnlySpaceBetween(
  lines: Array<string>,
  comment: Comment,
  next: Comment,
): bool uses alloc {
  if (comment.end.line < 1 || comment.end.line > Arrays.length(lines)) {
    return true
  }
  const characters = Str.chars(lines[comment.end.line - 1])
  // Code between two comments on a line does not count as a run of comments.
  for (const index of Ranges.between(comment.end.column - 1, next.pos.column - 1)) {
    if (!isSpace(characters[index])) {
      return false
    }
  }
  return true
}

function endsLineAfterComments(
  lines: Array<string>,
  comments: Array<Comment>,
  index: int,
): bool uses alloc {
  const comment = comments[index]
  // A comment before a comma stays with the node on its left.
  if (endsLine(lines, comment) || isFollowedByCloser(lines, comment)) {
    return true
  }
  // A run of comments after one node attaches the same way and keeps its order.
  if (index + 1 < Arrays.length(comments)) {
    const next = comments[index + 1]
    if (
      next.pos.line == comment.end.line &&
        !isBefore(next.pos, comment.end) &&
        isOnlySpaceBetween(lines, comment, next)
    ) {
      return endsLineAfterComments(lines, comments, index + 1)
    }
  }
  return false
}

function isBeforeCloser(
  lines: Array<string>,
  comments: Array<Comment>,
  index: int,
): bool uses alloc {
  let line = comments[index].end.line
  let column = comments[index].end.column
  let next = index + 1
  // Look past blanks, line ends and further comments to the next code. A closing bracket there means the comment sits at the end of its brackets, so no node after the bracket may take it as a leading comment: in `function f(a: int, // c` followed by `)` and `: int`, the result type is outside the parameter list, and in `if (x // c` followed by `)` and `{`, the block is outside the condition.
  while (line >= 1 && line <= Arrays.length(lines)) {
    const characters = Str.chars(lines[line - 1])
    if (column > Arrays.length(characters)) {
      line++
      column = 1
      continue
    }
    if (
      next < Arrays.length(comments) &&
        comments[next].pos.line == line &&
        comments[next].pos.column == column
    ) {
      line = comments[next].end.line
      column = comments[next].end.column
      next++
      continue
    }
    const character = characters[column - 1]
    if (isSpace(character)) {
      column++
      continue
    }
    return character == ')' || character == ']' || character == '}'
  }
  return false
}

function getInnerRanges(
  records: Array<NodeRecord>,
  tree: RecordTree,
  insideParens: Map<string, NodeRecord>,
  convertedKeys: Map<string, bool>,
): Array<NodeRecord> from records uses alloc {
  // Prettier's tree has no node for parentheses, so a comment between them and the expression belongs to the parent: it leads or trails the expression instead of sitting inside it.
  let inner: Array<NodeRecord> = []
  for (const index of Ranges.upTo(Arrays.length(records))) {
    const record = records[index]
    // only expressions lose their parentheses; a statement's text ends at its last token, even a `)`
    if (convertedKeys[record.key] is Some(_) || substring(record.key, 0, 1) != "e") {
      Arrays.push(mutable inner, record)
      continue
    }
    let start = record.start
    let end = record.end
    if (insideParens[record.key] is Some(old)) {
      start = old.start
      end = old.end
    }
    // an operand that starts or ends the node brings its own inner range
    const children = tree.childLists[index]
    const count = Arrays.length(children)
    if (count > 0) {
      if (isSamePos(records[children[0]].start, start)) {
        start = inner[children[0]].start
      }
      if (isSamePos(records[children[count - 1]].end, end)) {
        end = inner[children[count - 1]].end
      }
    }
    Arrays.push(mutable inner, NodeRecord { key: record.key, start: start, end: end })
  }
  return copy(inner)
}

function addAttached(
  mutable attached: Map<string, Array<Attached>>,
  key: string,
  commentIndex: int,
  placement: Placement,
) uses alloc {
  let list: Array<Attached> = []
  if (attached[key] is Some(existing)) {
    list = copy(existing)
  }
  Arrays.push(mutable list, Attached { comment: commentIndex, placement: placement })
  attached[key] = list
}

function attachComments(
  records: Array<NodeRecord>,
  tree: RecordTree,
  comments: Array<Comment>,
  lines: Array<string>,
  inner: Array<NodeRecord>,
): Map<string, Array<Attached>> uses alloc {
  let attached: Map<string, Array<Attached>> = Map {}
  for (const commentIndex of Ranges.upTo(Arrays.length(comments))) {
    const comment = comments[commentIndex]
    // descend to the deepest node that contains the comment
    let scopeKey = "file"
    let children = tree.rootChildren
    let descending = true
    while (descending) {
      descending = false
      for (const child of Arrays.values(children)) {
        const record = inner[child]
        if (!isBefore(comment.pos, record.start) && !isBefore(record.end, comment.end)) {
          scopeKey = record.key
          children = tree.childLists[child]
          descending = true
          break
        }
      }
    }
    // the last child before the comment and the first one after it
    let preceding = ""
    let following = ""
    let isInPrecedingParens = false
    for (const child of Arrays.values(children)) {
      const record = inner[child]
      if (!isBefore(comment.pos, record.end)) {
        preceding = record.key
        // the closer is the one of parentheses written around the preceding node
        isInPrecedingParens =
          !isBefore(records[child].end, comment.end) && !isSamePos(records[child].end, record.end)
      } else if (following == "" && !isBefore(record.start, comment.end)) {
        following = record.key
      }
    }
    if (following != "" && !isInPrecedingParens && isBeforeCloser(lines, comments, commentIndex)) {
      following = ""
    }
    // Placement follows Prettier.
    //   own line: leading of the following node, else trailing of the preceding one, else dangling on the enclosing node.
    //   end of line: trailing of the preceding node, else leading of the following one, else dangling.
    //   code follows on the line: leading of the following node, else trailing of the preceding one, else dangling.
    if (comment.ownLine) {
      if (following != "") {
        addAttached(mutable attached, following, commentIndex, Placement.Leading)
      } else if (preceding != "") {
        addAttached(mutable attached, preceding, commentIndex, Placement.Trailing)
      } else {
        addAttached(mutable attached, scopeKey, commentIndex, Placement.Dangling)
      }
    } else if (endsLineAfterComments(lines, comments, commentIndex)) {
      if (preceding != "") {
        addAttached(mutable attached, preceding, commentIndex, Placement.Trailing)
      } else if (following != "") {
        addAttached(mutable attached, following, commentIndex, Placement.Leading)
      } else {
        addAttached(mutable attached, scopeKey, commentIndex, Placement.Dangling)
      }
    } else {
      if (following != "") {
        addAttached(mutable attached, following, commentIndex, Placement.Leading)
      } else if (preceding != "") {
        addAttached(mutable attached, preceding, commentIndex, Placement.Trailing)
      } else {
        addAttached(mutable attached, scopeKey, commentIndex, Placement.Dangling)
      }
    }
  }
  return attached
}

function isListKey(key: string): bool {
  // The printer keeps blank lines in lists of statements, declarations (extern blocks too), fields, variants, arms and imports.
  const letter = substring(key, 0, 1)
  return letter == "s" ||
    letter == "d" ||
    letter == "x" ||
    letter == "f" ||
    letter == "v" ||
    letter == "a" ||
    letter == "i"
}

function getTrailingEndLine(
  record: NodeRecord,
  attached: Map<string, Array<Attached>>,
  comments: Array<Comment>,
): int {
  let endLine = record.end.line
  if (attached[record.key] is Some(list)) {
    for (const item of Arrays.values(list)) {
      if (item.placement is Placement.Trailing) {
        const commentEnd = comments[item.comment].end.line
        if (commentEnd > endLine) {
          endLine = commentEnd
        }
      }
    }
  }
  return endLine
}

function findBlankLines(
  records: Array<NodeRecord>,
  tree: RecordTree,
  attached: Map<string, Array<Attached>>,
  comments: Array<Comment>,
  lines: Array<string>,
): Map<string, bool> uses alloc {
  let blank: Map<string, bool> = Map {}
  // In each list of siblings, what comes before a node is its leading comments and, before those, the previous sibling (with its trailing comments). Nothing comes before the first item unless it has leading comments, so the first item never has a blank line before it, nor its first comment.
  markBlankLines(mutable blank, records, tree.rootChildren, attached, comments, lines)
  for (const children of Arrays.values(tree.childLists)) {
    markBlankLines(mutable blank, records, children, attached, comments, lines)
  }
  return blank
}

function markBlankLines(
  mutable blank: Map<string, bool>,
  records: Array<NodeRecord>,
  siblings: Array<int>,
  attached: Map<string, Array<Attached>>,
  comments: Array<Comment>,
  lines: Array<string>,
) uses alloc {
  let previousLine = 0 // 0: nothing before
  for (const sibling of Arrays.values(siblings)) {
    const record = records[sibling]
    if (attached[record.key] is Some(list)) {
      for (const item of Arrays.values(list)) {
        if (item.placement is Placement.Leading) {
          const comment = comments[item.comment]
          if (previousLine > 0 && hasBlankLineBetween(lines, previousLine, comment.pos.line)) {
            blank[`c${Int.toString(item.comment)}`] = true
          }
          previousLine = comment.end.line
        }
      }
    }
    if (
      previousLine > 0 &&
        isListKey(record.key) &&
        hasBlankLineBetween(lines, previousLine, record.start.line)
    ) {
      blank[record.key] = true
    }
    previousLine = getTrailingEndLine(record, attached, comments)
  }
}

export function buildTrivia(
  collector: Collector,
  comments: Array<Comment>,
  source: string,
): Trivia from comments uses alloc {
  const lines = splitString(source, "\n")
  const tree = buildTree(collector.records)
  const inner = getInnerRanges(
    collector.records,
    tree,
    collector.insideParens,
    collector.convertedKeys,
  )
  const attached = attachComments(collector.records, tree, comments, lines, inner)
  const blank = findBlankLines(collector.records, tree, attached, comments, lines)
  let ends: Map<string, Pos> = Map {}
  for (const record of Arrays.values(collector.records)) {
    ends[record.key] = record.end
  }
  return copy(Trivia {
    comments: comments,
    attached: attached,
    blankBefore: blank,
    parenthesized: collector.parenthesized,
    ends: ends,
  })
}

export function checkAttached(trivia: Trivia): Option<string> uses alloc {
  let counts: Array<int> = filledArray(0, Arrays.length(trivia.comments))
  for (const key of Arrays.values(Maps.keys(trivia.attached))) {
    if (trivia.attached[key] is Some(list)) {
      for (const item of Arrays.values(list)) {
        counts[item.comment]++
      }
    }
  }
  for (const index of Ranges.upTo(Arrays.length(counts))) {
    if (counts[index] != 1) {
      const comment = trivia.comments[index]
      return Some(
        `comment ${Int.toString(index)} at ${Int.toString(comment.pos.line)}:${Int.toString(comment.pos.column)} is attached ${Int.toString(counts[index])} times`,
      )
    }
  }
  return None
}
