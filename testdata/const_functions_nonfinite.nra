// Floats that are not finite: the C names them NAN, INFINITY and -INFINITY.
import * as Arrays from "std/array"
import * as Float from "std/float"
import * as Str from "std/string"

@const
function specials(one: f64): Array<f64> uses alloc {
  return [Float.sqrt(-one), one / 0.0, -one / 0.0, one]
}

@const
function infinity(): f64 {
  return 1.0 / 0.0
}

const SPECIALS = specials(1.0)
const INFINITE = infinity()

function describe(table: Array<f64>): string uses alloc {
  let parts: Array<string> = []
  for (const value of table) {
    // NaN prints differently by C library, so it is named here.
    if (value != value) {
      Arrays.push(mutable parts, "nan")
    } else {
      Arrays.push(mutable parts, Float.toString(value))
    }
  }
  return Str.join(parts, " ")
}

export function run(args: Array<string>): int uses io, alloc {
  const one = 1.0
  print(describe(SPECIALS))
  print(describe(specials(one)))
  print(`${Float.toString(INFINITE)} ${Float.toString(infinity())}`)
  return 0
}
