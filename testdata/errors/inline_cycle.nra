// error: @inline function isEven calls itself (isEven -> isOdd -> isEven); an @inline function cannot be recursive
@inline
function isEven(value: int): bool {
  if (value == 0) {
    return true
  }
  return isOdd(value - 1)
}

@inline
function isOdd(value: int): bool {
  if (value == 0) {
    return false
  }
  return isEven(value - 1)
}

export function run(_args: Array<string>): int {
  return isEven(4) ? 0 : 1
}
