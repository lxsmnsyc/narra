// error: distinct type Ratio cannot have a requires list: its base f64 is not an integer type or string
// Only integer types and string can be refined.
distinct type Ratio = f64 requires > 0
distinct type Letter = char requires 'a'

struct Point {
  x: int
}

distinct type Place = Point requires >= 1
distinct type UserId = int
distinct type Admin = UserId requires >= 1

export function run(_args: Array<string>): int {
  return 0
}
