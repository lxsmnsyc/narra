import * as Int from "std/int"
import { first, wrap } from "app/generic"

struct Point {
  x: int
  y: int
}

function sum(point: Point): int {
  const total = point.x + point.y
  return total
}

export function run(arguments: Array<string>): int uses io, alloc {
  const point = Point { x: 1, y: 2 }
  const label = "é"
  print(`${label} ${Int.toString(sum(point))}`)
  const head = first([point.x, point.y])
  const _both = [wrap("é"), wrap(label)]
  return head
}
