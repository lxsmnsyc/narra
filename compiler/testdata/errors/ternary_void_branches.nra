// error: ternary_void_branches.nra:7:36: both branches of a conditional expression must have a value
import * as Arrays from "std/array"

export function run(args: Array<string>): int {
  let xs: Array<int> = []
  const flag = true
  const unused = flag ? Arrays.push(mutable xs, 1) : Arrays.push(mutable xs, 2)
  return 0
}
