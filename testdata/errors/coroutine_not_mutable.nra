import * as Co from "std/coroutine"

function* echo(): Coroutine<int, int> {
  while (true) {
    const input = yield 0
  }
}

export function other(args: Array<string>): int {
  let echoes = echo()
  Co.send(echoes, 1)
  return 0
}

export function run(args: Array<string>): int {
  return 0
}
