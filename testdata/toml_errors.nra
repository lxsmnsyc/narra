// std/toml: invalid documents, each printed with Toml.formatError. Most cases
// are picked by hand from the invalid tests of toml-test
// (https://github.com/toml-lang/toml-test, tests/invalid); the file is named after each.
import * as Toml from "std/toml"
import * as Str from "std/string"
import * as Arrays from "std/array"

function check(name: string, text: string) uses io, alloc {
  const parsed = Toml.parse(text)
  if (parsed is Err(error)) {
    print(`${name}: ${Toml.formatError(error)}`)
    return
  }
  print(`${name}: parsed, but it should not`)
}

export function run(_args: Array<string>): int {
  // key/duplicate-keys-1
  check("duplicate key", "dupe = false\ndupe = true\n")
  // table/duplicate
  check("table defined twice", "[a]\nb = 1\n\n[a]\nc = 2\n")
  // table/append-with-dotted-keys-1
  check("dotted keys into a header table", "[a.b.c]\n  z = 9\n[a]\n  b.c.t = 1\n")
  // table/redefine-2
  check("header over dotted keys", "[t1]\nt2.t3.v = 0\n[t1.t2]\n")
  // inline-table/add
  check("inline table extended", "a = {}\n[a.b]\n")
  // inline-table/overwrite-02
  check("inline table extended by a key", "a = { b = 1 }\na.c = 2\n")
  // array/extending-table
  check("static array appended", "a = []\n[[a]]\n")
  // table/array-implicit-and-explicit-after
  check("table over an array of tables", "[[a.b]]\nx = 1\n[a.b]\n")
  // string/bad-escape-1
  check("bad escape", "invalid-escape = \"This string has a bad \\a escape character.\"\n")
  // string/bad-uni-esc-1
  check("bad unicode escape", "a = \"\\uD800\"\n")
  // integer/positive-int-overflow
  check("integer out of range", "a = 9223372036854775808\n")
  // integer/negative-int-overflow
  check("negative integer out of range", "a = -9223372036854775809\n")
  // integer/leading-zero-1
  check("leading zero", "a = 012\n")
  // integer/double-sign-plus
  check("bad underscore", "a = 1__2\n")
  // integer/negative-hex
  check("signed hex", "a = -0xff\n")
  // float/trailing-point
  check("float without fraction digits", "a = 1.\n")
  // datetime/feb-30
  check("bad date", "a = 2021-02-30\n")
  // datetime/hour-over
  check("bad time", "a = 2006-01-01T24:00:00Z\n")
  // datetime/no-secs
  check("time without seconds", "a = 1987-07-05T17:45Z\n")
  // string/basic-unclosed-1
  check("unterminated string", "a = \"no end\n")
  // string/multiline-quotes-1
  check("six quotes at the end", "a = \"\"\"six quotes \"\"\"\"\"\"\n")
  // string/multiline-no-close-1
  check("unterminated multi-line string", "invalid = \"\"\"\n    this will fail\n")
  // string/literal-multiline-quotes-1
  check("unterminated literal string", "a = 'no end\n")
  // inline-table/trailing-comma
  check("trailing comma in an inline table", "a = { b = 1, }\n")
  // inline-table/linebreak-1
  check("newline in an inline table", "a = { b = 1\n}\n")
  // control/comment-del
  check("control character in a comment", "a = 1 # \u{7f}\n")
  // key/after-value
  check("two values on a line", "first = \"x\" second = \"y\"\n")
  // key/no-eol
  check("missing value", "a =\n")
  // table/equals-sign
  check("bad header", "[name=bad]\n")
  // array/missing-separator-1
  check("array without a comma", "a = [1 2]\n")
  // array/no-close-1
  check("unterminated array", "a = [1, 2")
  // A bare carriage return is not a newline.
  check("bare carriage return", "a = 1\rb = 2\n")
  // Nesting deeper than 512.
  let deep = Str.builder()
  Str.append(mutable deep, "a = ")
  let index = 0
  while (index < 600) {
    Str.append(mutable deep, "[")
    index += 1
  }
  check("deep nesting", Str.build(deep))
  // A header with more than 512 parts.
  let parts: Array<string> = []
  let count = 0
  while (count < 520) {
    Arrays.push(mutable parts, "k")
    count += 1
  }
  check("deep header", `[${Str.join(parts, ".")}]\n`)
  return 0
}
