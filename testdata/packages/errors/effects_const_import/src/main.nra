import * as Steps from "eci/steps"
import { step } from "eci/steps"

export function pure(): int {
  return step(2)
}

export function qualified(): int {
  return Steps.step(2)
}

export function element(): int {
  return Steps.table[0](2)
}

export function run(args: Array<string>): int {
  return pure() + qualified() + element()
}
