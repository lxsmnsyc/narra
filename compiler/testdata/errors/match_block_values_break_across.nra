// error: match_block_values_break_across.nra:9:9: break cannot leave a block expression; it can only leave a loop inside the block
import * as Ranges from "std/range"
import * as Int from "std/int"

export function run(args: Array<string>): int {
  for (const i of Ranges.upTo(3)) {
    const value = match (i) {
      0 => {
        break
        return 1
      }
      _ => 2
    }
    print(Int.toString(value))
  }
  return 0
}
