import * as Int from "std/int"
import * as Geo from "p/geo"
import { Shape } from "p/geo"

function area(s: Shape): int {
  return match (s) {
    Shape.Circle(r) => 3 * r * r
    Shape.Square(a) => a * a
    Shape.Dot => 0
  }
}

function name(s: Geo.Shape): string {
  return match (s) {
    Geo.Shape.Circle(_) => "circle"
    Geo.Shape.Square(_) => "square"
    Geo.Shape.Dot => "dot"
  }
}

export function run(args: Array<string>): int {
  const a = Shape.Circle(2)
  const b = Geo.Shape.Square(3)
  const c = Geo.Shape.Dot
  print(`${name(a)} ${Int.toString(area(a))}`)
  print(`${name(b)} ${Int.toString(area(b))}`)
  print(`${name(c)} ${Int.toString(area(c))}`)
  const w: Geo.Wrap<int> = Geo.Wrap.Full(7)
  if (w is Geo.Wrap.Full(v)) {
    print(`full ${Int.toString(v)}`)
  }
  return 0
}
