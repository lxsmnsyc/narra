// error: cannot implement Equatable for UserId: `==` on a distinct type compares the base value (D62)
distinct type UserId = int implements Equatable

implement Equatable for UserId {
  function equals(left: UserId, right: UserId): bool {
    return UserId.toInt(left) % 10 == UserId.toInt(right) % 10
  }
}

export function run(args: Array<string>): int {
  return 0
}
