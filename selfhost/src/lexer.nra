// The lexer, ported line by line from compiler/internal/narra/lexer.go.
// It works on an array of characters, like the Go lexer works on []rune, so
// columns count characters, not bytes.
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import { Pos } from "narrac/ast"
import { Fix, buildQuoteFix, buildRemoveSemicolonFix } from "narrac/fixes"
import { Comment, CommentKind } from "narrac/trivia"

// The kinds carry a Tok prefix, as in Go, so they do not clash with the
// expression variants of narrac/ast (IntLit, Ident, ...).
export enum TokenKind {
  TokEof
  TokNewline
  TokIdent
  TokInt
  TokFloat
  TokString
  TokChar
  TokTemplate
  TokKeyword
  TokPunct
}

// A token. endLine:endColumn is the position after its last character (Go:
// Token.End); the parser reads it for StringLit.end.
export struct Token {
  kind: TokenKind
  text: string
  line: int
  column: int
  endLine: int
  endColumn: int
}

struct Lexer {
  source: Array<char>
  index: int
  line: int
  column: int
  depth: int // nesting of ( and [, where line breaks never end a statement
  savedDepths: Array<int> // depth outside each open {, where line breaks end statements again
  savedCount: int // how many entries of savedDepths are in use
  tokens: Array<Token>
  punctuationChars: Array<Array<char>>
  keepComments: bool // lexWithComments: collect the comments the tokens skip
  comments: Array<Comment>
}

const KEYWORDS = Map {
  "function": true,
  "export": true,
  "import": true,
  "from": true,
  "as": true,
  "const": true,
  "let": true,
  "if": true,
  "else": true,
  "while": true,
  "for": true,
  "of": true,
  "return": true,
  "break": true,
  "continue": true,
  "struct": true,
  "enum": true,
  "match": true,
  "true": true,
  "false": true,
  "mutable": true,
  "uses": true,
  "test": true,
  "is": true,
  "trait": true,
  "implement": true,
  "implements": true,
  "derives": true,
  "yield": true,
}

// Longest punctuation first, so "==" is matched before "=".
const PUNCTS = [
  "===",
  "!==",
  "...",
  "#[",
  "=>",
  "==",
  "!=",
  "<=",
  ">=",
  "&&",
  "||",
  "+%",
  "-%",
  "*%",
  "<<",
  ">>",
  "+",
  "-",
  "*",
  "/",
  "%",
  "<",
  ">",
  "=",
  "!",
  "&",
  "|",
  "^",
  "~",
  "(",
  ")",
  "{",
  "}",
  "[",
  "]",
  ",",
  ":",
  ".",
  ";",
  "?",
]

function createLexer(source: string, keepComments: bool): Lexer {
  let punctuationChars: Array<Array<char>> = []
  for (const punctuation of Arrays.values(PUNCTS)) {
    Arrays.push(mutable punctuationChars, Str.chars(punctuation))
  }
  return Lexer {
    source: Str.chars(source),
    index: 0,
    line: 1,
    column: 1,
    depth: 0,
    savedDepths: [],
    savedCount: 0,
    tokens: [],
    punctuationChars: punctuationChars,
    keepComments: keepComments,
    comments: [],
  }
}

// A lexical error. code is the diagnostic code (see diagnostics.nra).
export struct LexError {
  code: string
  line: int
  column: int
  message: string
  fixes: Array<Fix> = []
}

export function formatLexError(error: LexError): string uses alloc {
  return `${Int.toString(error.line)}:${Int.toString(error.column)}: ${error.message}`
}

export function lex(source: string): Result<Array<Token>, LexError> uses alloc {
  let lexer = createLexer(source, false)
  const failed = runLexer(mutable lexer)
  if (failed is Some(message)) {
    return Err(message)
  }
  return Ok(lexer.tokens)
}

export function lexWithComments(source: string): Result<#[
  Array<Token>,
  Array<Comment>,
], LexError> uses alloc {
  let lexer = createLexer(source, true)
  const failed = runLexer(mutable lexer)
  if (failed is Some(message)) {
    return Err(message)
  }
  return Ok(#[lexer.tokens, lexer.comments])
}

function recordComment(mutable lexer: Lexer, first: int, line: int, column: int) {
  const text = readText(lexer, first, lexer.index)
  let kind = CommentKind.Block
  if (Str.startsWith(text, "///")) {
    kind = CommentKind.Doc
  } else if (Str.startsWith(text, "//")) {
    kind = CommentKind.Line
  }
  // only whitespace before it on its line?
  let ownLine = true
  let back = first
  while (back > 0 && lexer.source[back - 1] != '\n') {
    back = back - 1
    const before = lexer.source[back]
    if (before != ' ' && before != '\t' && before != '\r') {
      ownLine = false
    }
  }
  const comment = Comment {
    kind: kind,
    text: text,
    pos: Pos { line: line, column: column },
    end: Pos { line: lexer.line, column: lexer.column },
    ownLine: ownLine,
  }
  Arrays.push(mutable lexer.comments, comment)
}

function errorAt(line: int, column: int, code: string, message: string): Option<LexError> {
  return Some(LexError { code: code, line: line, column: column, message: message })
}

function errorWithFixesAt(
  line: int,
  column: int,
  code: string,
  fixes: Array<Fix>,
  message: string,
): Option<LexError> {
  return Some(LexError { code: code, line: line, column: column, message: message, fixes: fixes })
}

function getSize(lexer: Lexer): int {
  return Arrays.length(lexer.source)
}

function peek(lexer: Lexer, offset: int): char {
  if (lexer.index + offset < Arrays.length(lexer.source)) {
    return lexer.source[lexer.index + offset]
  }
  return '\0'
}

function advance(mutable lexer: Lexer): char {
  const character = lexer.source[lexer.index]
  lexer.index = lexer.index + 1
  if (character == '\n') {
    lexer.line = lexer.line + 1
    lexer.column = 1
  } else {
    lexer.column = lexer.column + 1
  }
  return character
}

function emit(mutable lexer: Lexer, kind: TokenKind, text: string, line: int, column: int) {
  // The token's characters are consumed, so the current position is its end.
  const token = Token {
    kind: kind,
    text: text,
    line: line,
    column: column,
    endLine: lexer.line,
    endColumn: lexer.column,
  }
  Arrays.push(mutable lexer.tokens, token)
}

function lastEndsStatement(lexer: Lexer): bool {
  // A line break ends a statement only after a token that can end one.
  const count = Arrays.length(lexer.tokens)
  if (count == 0) {
    return false
  }
  const last = lexer.tokens[count - 1]
  return match (last.kind) {
    TokenKind.TokIdent => true
    TokenKind.TokInt => true
    TokenKind.TokFloat => true
    TokenKind.TokString => true
    TokenKind.TokChar => true
    TokenKind.TokTemplate => true
    TokenKind.TokKeyword =>
      last.text == "return" ||
      last.text == "break" ||
      last.text == "continue" ||
      last.text == "true" ||
      last.text == "false"
    TokenKind.TokPunct =>
      last.text == ")" || last.text == "]" || last.text == "}" || endsIncrement(lexer)
    _ => false
  }
}

function endsIncrement(lexer: Lexer): bool {
  const count = Arrays.length(lexer.tokens)
  if (count < 3) {
    return false
  }
  const last = lexer.tokens[count - 1]
  const before = lexer.tokens[count - 2]
  const operand = lexer.tokens[count - 3]
  if (last.kind != TokenKind.TokPunct || (last.text != "+" && last.text != "-")) {
    return false
  }
  if (before.kind != TokenKind.TokPunct || before.text != last.text) {
    return false
  }
  if (before.line != last.line || before.column + 1 != last.column) {
    return false
  }
  // `x++` and `x--` end a statement; `a - -b` does not, since it is not adjacent.
  return operand.kind == TokenKind.TokIdent || operand.text == ")" || operand.text == "]"
}

function readText(lexer: Lexer, first: int, end: int): string {
  let builder = Str.builder()
  for (const index of Ranges.between(first, end)) {
    Str.appendChar(mutable builder, lexer.source[index])
  }
  return Str.build(builder)
}

function runLexer(mutable lexer: Lexer): Option<LexError> {
  while (lexer.index < getSize(lexer)) {
    const character = peek(lexer, 0)
    const line = lexer.line
    const column = lexer.column
    if (character == '\n') {
      advance(mutable lexer)
      if (lexer.depth == 0 && lastEndsStatement(lexer)) {
        emit(mutable lexer, TokenKind.TokNewline, "\n", line, column)
      }
    } else if (character == ' ' || character == '\t' || character == '\r') {
      advance(mutable lexer)
    } else if (character == '/' && peek(lexer, 1) == '/') {
      const commentStart = lexer.index
      while (lexer.index < getSize(lexer) && peek(lexer, 0) != '\n') {
        advance(mutable lexer)
      }
      if (lexer.keepComments) {
        recordComment(mutable lexer, commentStart, line, column)
      }
    } else if (character == '/' && peek(lexer, 1) == '*') {
      const commentStart = lexer.index
      advance(mutable lexer)
      advance(mutable lexer)
      while (lexer.index < getSize(lexer) && !(peek(lexer, 0) == '*' && peek(lexer, 1) == '/')) {
        advance(mutable lexer)
      }
      if (lexer.index >= getSize(lexer)) {
        return errorAt(line, column, "E0001", "unterminated block comment")
      }
      advance(mutable lexer)
      advance(mutable lexer)
      if (lexer.keepComments) {
        recordComment(mutable lexer, commentStart, line, column)
      }
    } else if (isLetter(character)) {
      const start = lexer.index
      while (
        lexer.index < getSize(lexer) && (isLetter(peek(lexer, 0)) || isDigit(peek(lexer, 0)))
      ) {
        advance(mutable lexer)
      }
      const word = readText(lexer, start, lexer.index)
      if (KEYWORDS[word] is Some(_)) {
        emit(mutable lexer, TokenKind.TokKeyword, word, line, column)
      } else {
        emit(mutable lexer, TokenKind.TokIdent, word, line, column)
      }
    } else if (isDigit(character)) {
      lexNumber(mutable lexer, line, column)
    } else if (character == '"') {
      const literal = lexQuoted(mutable lexer, '"', line, column)
      if (literal is Err(error)) {
        return Some(error)
      }
      emit(mutable lexer, TokenKind.TokString, literal.value, line, column)
    } else if (character == '\'') {
      const quoteStart = lexer.index
      const literal = lexQuoted(mutable lexer, '\'', line, column)
      if (literal is Err(error)) {
        return Some(error)
      }
      if (Str.charCount(literal.value) != 1) {
        const closeQuote = Pos { line: lexer.line, column: lexer.column - 1 }
        return errorWithFixesAt(
          line,
          column,
          "E0002",
          buildQuoteFix(
            Pos { line: line, column: column },
            closeQuote,
            readText(lexer, quoteStart, lexer.index),
          ),
          "a character literal holds exactly one character; use double quotes for strings",
        )
      }
      emit(mutable lexer, TokenKind.TokChar, literal.value, line, column)
    } else if (character == '`') {
      const literal = lexTemplate(mutable lexer, line, column)
      if (literal is Err(error)) {
        return Some(error)
      }
      emit(mutable lexer, TokenKind.TokTemplate, literal.value, line, column)
    } else {
      const failed = lexPunctuation(mutable lexer, character, line, column)
      if (failed is Some(_)) {
        return failed
      }
    }
  }
  const line = lexer.line
  const column = lexer.column
  if (lastEndsStatement(lexer)) {
    emit(mutable lexer, TokenKind.TokNewline, "\n", line, column)
  }
  emit(mutable lexer, TokenKind.TokEof, "", line, column)
  return None
}

function lexPunctuation(
  mutable lexer: Lexer,
  character: char,
  line: int,
  column: int,
): Option<LexError> {
  for (const index of Ranges.upTo(Arrays.length(PUNCTS))) {
    if (hasPrefix(lexer, lexer.punctuationChars[index])) {
      const punctuation = PUNCTS[index]
      for (const _character of Arrays.values(lexer.punctuationChars[index])) {
        advance(mutable lexer)
      }
      if (punctuation == ";" && lexer.depth == 0) {
        return errorWithFixesAt(
          line,
          column,
          "E0003",
          buildRemoveSemicolonFix(Pos { line: line, column: column }),
          "semicolons are not used; end the statement with a line break",
        )
      }
      if (punctuation == "(" || punctuation == "[" || punctuation == "#[") {
        lexer.depth = lexer.depth + 1
      } else if (punctuation == "{") {
        const outerDepth = lexer.depth
        if (lexer.savedCount < Arrays.length(lexer.savedDepths)) {
          lexer.savedDepths[lexer.savedCount] = outerDepth
        } else {
          Arrays.push(mutable lexer.savedDepths, outerDepth)
        }
        lexer.savedCount = lexer.savedCount + 1
        lexer.depth = 0
      } else if (punctuation == "}") {
        if (lexer.savedCount > 0) {
          lexer.savedCount = lexer.savedCount - 1
          lexer.depth = lexer.savedDepths[lexer.savedCount]
        }
      } else if (punctuation == ")" || punctuation == "]") {
        if (lexer.depth > 0) {
          lexer.depth = lexer.depth - 1
        }
      }
      emit(mutable lexer, TokenKind.TokPunct, punctuation, line, column)
      return None
    }
  }
  return errorAt(line, column, "E0004", `unexpected character ${quoteChar(character)}`)
}

function hasPrefix(lexer: Lexer, prefix: Array<char>): bool {
  for (const index of Ranges.upTo(Arrays.length(prefix))) {
    if (peek(lexer, index) != prefix[index]) {
      return false
    }
  }
  return true
}

function lexNumber(mutable lexer: Lexer, line: int, column: int) {
  // A 0x, 0b or 0o prefix takes hex digits; otherwise read a decimal with an
  // optional fraction and exponent.
  const start = lexer.index
  let isFloat = false
  if (
    peek(lexer, 0) == '0' &&
      (peek(lexer, 1) == 'x' || peek(lexer, 1) == 'b' || peek(lexer, 1) == 'o')
  ) {
    advance(mutable lexer)
    advance(mutable lexer)
    while (isHexDigit(peek(lexer, 0)) || peek(lexer, 0) == '_') {
      advance(mutable lexer)
    }
  } else {
    while (isDigit(peek(lexer, 0)) || peek(lexer, 0) == '_') {
      advance(mutable lexer)
    }
    if (peek(lexer, 0) == '.' && isDigit(peek(lexer, 1))) {
      isFloat = true
      advance(mutable lexer)
      while (isDigit(peek(lexer, 0)) || peek(lexer, 0) == '_') {
        advance(mutable lexer)
      }
    }
    if (peek(lexer, 0) == 'e' || peek(lexer, 0) == 'E') {
      isFloat = true
      advance(mutable lexer)
      if (peek(lexer, 0) == '+' || peek(lexer, 0) == '-') {
        advance(mutable lexer)
      }
      while (isDigit(peek(lexer, 0))) {
        advance(mutable lexer)
      }
    }
  }

  // The text without the `_` separators.
  let builder = Str.builder()
  for (const index of Ranges.between(start, lexer.index)) {
    if (lexer.source[index] != '_') {
      Str.appendChar(mutable builder, lexer.source[index])
    }
  }
  if (isFloat) {
    emit(mutable lexer, TokenKind.TokFloat, Str.build(builder), line, column)
  } else {
    emit(mutable lexer, TokenKind.TokInt, Str.build(builder), line, column)
  }
}

function fail(line: int, column: int, code: string, message: string): Result<string, LexError> {
  return Err(LexError { code: code, line: line, column: column, message: message })
}

function lexEscape(mutable lexer: Lexer, line: int, column: int): Result<string, LexError> {
  advance(mutable lexer) // the backslash
  if (lexer.index >= getSize(lexer)) {
    return fail(line, column, "E0005", "unterminated escape")
  }
  const character = advance(mutable lexer)
  return match (character) {
    'n' => Ok("\n")
    't' => Ok("\t")
    'r' => Ok("\r")
    '0' => Ok("\0")
    '\\' => Ok("\\")
    '"' => Ok("\"")
    '\'' => Ok("'")
    '`' => Ok("`")
    '$' => Ok("$")
    'u' => lexUnicodeEscape(mutable lexer, line, column)
    _ => fail(line, column, "E0008", `unknown escape \\${Str.fromChar(character)}`)
  }
}

// A decoded escape from decodeEscape: its text and the index after it.
export struct Escape {
  text: string
  end: int
}

export function decodeEscape(
  source: Array<char>,
  index: int,
  line: int,
  column: int,
): Result<Escape, LexError> uses alloc {
  // Decodes like a string literal, so template strings take the same escapes and report the same errors, at line:column.
  let lexer = Lexer {
    source: source,
    index: index,
    line: line,
    column: column,
    depth: 0,
    savedDepths: [],
    savedCount: 0,
    tokens: [],
    punctuationChars: [],
    keepComments: false,
    comments: [],
  }
  const escaped = lexEscape(mutable lexer, line, column)
  if (escaped is Err(error)) {
    return Err(error)
  }
  return Ok(Escape { text: escaped.value, end: lexer.index })
}

function lexUnicodeEscape(mutable lexer: Lexer, line: int, column: int): Result<string, LexError> {
  if (peek(lexer, 0) != '{') {
    return fail(line, column, "E0006", "expected { after \\u")
  }
  advance(mutable lexer)
  let value = 0
  while (peek(lexer, 0) != '}') {
    if (lexer.index >= getSize(lexer) || !isHexDigit(peek(lexer, 0))) {
      return fail(line, column, "E0007", "invalid \\u escape")
    }
    value = (value * 16) + hexValue(advance(mutable lexer))
  }
  advance(mutable lexer)
  return Ok(Str.fromChar(convertRune(value)))
}

function convertRune(value: int): char {
  // The value is cut to 32 bits; a negative value, a surrogate or a value above 0x10FFFF becomes U+FFFD.
  const code = value & 0xFFFFFFFF
  if (code < 0x80000000) {
    if (Char.fromCode(code) is Some(character)) {
      return character
    }
  }
  return '\u{FFFD}'
}

function lexQuoted(
  mutable lexer: Lexer,
  quote: char,
  line: int,
  column: int,
): Result<string, LexError> {
  advance(mutable lexer)
  let builder = Str.builder()
  while (true) {
    if (lexer.index >= getSize(lexer) || peek(lexer, 0) == '\n') {
      return fail(line, column, "E0009", "unterminated literal")
    }
    const character = peek(lexer, 0)
    if (character == quote) {
      advance(mutable lexer)
      return Ok(Str.build(builder))
    }
    if (character == '\\') {
      const escaped = lexEscape(mutable lexer, line, column)
      if (escaped is Err(error)) {
        return Err(error)
      }
      Str.append(mutable builder, escaped.value)
    } else {
      Str.appendChar(mutable builder, advance(mutable lexer))
    }
  }
  return fail(line, column, "E0009", "unreachable")
}

function lexTemplate(mutable lexer: Lexer, line: int, column: int): Result<string, LexError> {
  advance(mutable lexer)
  const start = lexer.index
  const failure = skipTemplateBody(mutable lexer, line, column)
  if (failure is Some(error)) {
    return Err(error)
  }
  // Templates keep their raw source. The parser splits out each ${...} part and parses it on its own.
  return Ok(readText(lexer, start, lexer.index - 1))
}

function skipTemplateBody(mutable lexer: Lexer, line: int, column: int): Option<LexError> {
  while (true) {
    if (lexer.index >= getSize(lexer)) {
      return errorAt(line, column, "E0010", "unterminated template string")
    }
    const character = peek(lexer, 0)
    if (character == '\\') {
      advance(mutable lexer)
      if (lexer.index < getSize(lexer)) {
        advance(mutable lexer)
      }
    } else if (character == '`') {
      advance(mutable lexer)
      return None
    } else if (character == '$' && peek(lexer, 1) == '{') {
      advance(mutable lexer)
      advance(mutable lexer)
      const failure = skipInterpolation(mutable lexer, line, column)
      if (failure is Some(_)) {
        return failure
      }
    } else {
      advance(mutable lexer)
    }
  }
  return errorAt(line, column, "E0010", "unreachable")
}

function skipInterpolation(mutable lexer: Lexer, line: int, column: int): Option<LexError> {
  let depth = 1
  while (depth > 0) {
    if (lexer.index >= getSize(lexer)) {
      return errorAt(line, column, "E0010", "unterminated template string")
    }
    const character = peek(lexer, 0)
    const innerLine = lexer.line
    const innerColumn = lexer.column
    advance(mutable lexer)
    if (character == '{') {
      depth = depth + 1
    } else if (character == '}') {
      depth = depth - 1
    } else if (character == '"' || character == '\'') {
      const failure = skipQuoted(mutable lexer, character, innerLine, innerColumn)
      if (failure is Some(_)) {
        return failure
      }
    } else if (character == '`') {
      const failure = skipTemplateBody(mutable lexer, innerLine, innerColumn)
      if (failure is Some(_)) {
        return failure
      }
    }
  }
  return None
}

function skipQuoted(mutable lexer: Lexer, quote: char, line: int, column: int): Option<LexError> {
  while (true) {
    if (lexer.index >= getSize(lexer) || peek(lexer, 0) == '\n') {
      return errorAt(line, column, "E0009", "unterminated literal")
    }
    const character = advance(mutable lexer)
    if (character == quote) {
      return None
    }
    if (character == '\\' && lexer.index < getSize(lexer) && peek(lexer, 0) != '\n') {
      advance(mutable lexer)
    }
  }
  return errorAt(line, column, "E0009", "unreachable")
}

export function hex(value: int, width: int): string uses alloc {
  // value must not be negative.
  const digits = Int.toHex(value)
  const padding = width - Str.length(digits)
  if (padding > 0) {
    return `${Str.repeat("0", padding)}${digits}`
  }
  return digits
}

function quoteChar(character: char): string {
  // Non-ASCII characters are written as they are (Go escapes the ones that are not printable; that needs Unicode tables).
  return match (character) {
    '\'' => "'\\''"
    '\\' => "'\\\\'"
    '\u{7}' => "'\\a'"
    '\u{8}' => "'\\b'"
    '\u{c}' => "'\\f'"
    '\n' => "'\\n'"
    '\r' => "'\\r'"
    '\t' => "'\\t'"
    '\u{b}' => "'\\v'"
    _ => quoteOther(character)
  }
}

function quoteOther(character: char): string {
  if (character < ' ' || character == '\u{7f}') {
    return `'\\x${hex(Char.code(character), 2)}'`
  }
  return `'${Str.fromChar(character)}'`
}

function isLetter(character: char): bool {
  return character == '_' ||
    (character >= 'a' && character <= 'z') ||
    (character >= 'A' && character <= 'Z')
}

function isDigit(character: char): bool {
  return character >= '0' && character <= '9'
}

function isHexDigit(character: char): bool {
  return isDigit(character) ||
    (character >= 'a' && character <= 'f') ||
    (character >= 'A' && character <= 'F')
}

function hexValue(character: char): int {
  if (isDigit(character)) {
    return Char.code(character) - Char.code('0')
  }
  if (character >= 'a' && character <= 'f') {
    return Char.code(character) - Char.code('a') + 10
  }
  return Char.code(character) - Char.code('A') + 10
}

export function getKindName(kind: TokenKind): string {
  return match (kind) {
    TokenKind.TokEof => "eof"
    TokenKind.TokNewline => "newline"
    TokenKind.TokIdent => "ident"
    TokenKind.TokInt => "int"
    TokenKind.TokFloat => "float"
    TokenKind.TokString => "string"
    TokenKind.TokChar => "char"
    TokenKind.TokTemplate => "template"
    TokenKind.TokKeyword => "keyword"
    TokenKind.TokPunct => "punct"
  }
}

export function escapeText(text: string): string uses alloc {
  let builder = Str.builder()
  for (const character of Arrays.values(Str.chars(text))) {
    if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (character == '\n') {
      Str.append(mutable builder, "\\n")
    } else if (character == '\t') {
      Str.append(mutable builder, "\\t")
    } else if (character == '\r') {
      Str.append(mutable builder, "\\r")
    } else if (character < ' ' || character == '\u{7f}') {
      Str.append(mutable builder, `\\u{${Int.toHex(Char.code(character))}}`)
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  return Str.build(builder)
}
