distinct type UserId = int
export opaque distinct type Token = string
distinct type Pairs = #[UserId, Token]
struct User {
  id: UserId
  tokens: Array<Token>
  ids: Ids
}
function find(ids: Ids, id: UserId): Option<UserId> {
  return None
}
// A distinct type with a generic base must come last: the parser drops the
// line break after `>` and fails on the next declaration.
distinct type Ids = Array<UserId>
