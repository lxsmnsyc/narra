// Values held across a yield that come from an expression with its own
// result variable: a map index, a match expression and a block expression.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Options from "std/option"
import * as Ranges from "std/range"

function* count(limit: int): Generator<int> {
  for (const i of Ranges.upTo(limit)) {
    yield i
  }
}

// A map index result is the loop source.
function* words(table: Map<string, string>, key: string): Generator<string> {
  for (const word of splitString(Options.withDefault(table[key], ""), " ")) {
    yield word
  }
}

// A match statement on a map index holds the Option.
function* lookup(table: Map<string, string>, key: string): Generator<string> {
  match (table[key]) {
    Some(value) => {
      yield value
      yield `${value} again`
    }
    None => {
      yield "missing"
    }
  }
}

// A match expression and a block expression as loop sources.
function* pick(n: int): Generator<string> {
  for (const text of match (n) { 0 => ["zero", "none"], _ => ["many"] }) {
    yield text
  }
  for (const text of {
    const label = Int.toString(n)
    return [label, `${label}!`]
  }) {
    yield text
  }
}

// yield* of a match expression, and a match statement on a match expression.
function* nested(n: int): Generator<int> {
  yield* match (n) { 0 => count(2), _ => count(3) }
  match (match (n) { 0 => Some("a"), _ => None }) {
    Some(text) => {
      yield Str.length(text)
      yield 10
    }
    None => {
      yield 20
    }
  }
}

export function run(args: Array<string>): int {
  let table: Map<string, string> = Map {}
  table["greeting"] = "hello there world"
  for (const word of words(table, "greeting")) {
    print(word)
  }
  for (const text of lookup(table, "greeting")) {
    print(text)
  }
  for (const text of lookup(table, "other")) {
    print(text)
  }
  for (const text of pick(0)) {
    print(text)
  }
  for (const text of pick(7)) {
    print(text)
  }
  for (const n of nested(0)) {
    print(Int.toString(n))
  }
  for (const n of nested(1)) {
    print(Int.toString(n))
  }
  // Dropped half way, while each held value is live.
  for (const text of lookup(table, "greeting")) {
    print(text)
    break
  }
  for (const text of pick(0)) {
    print(text)
    break
  }
  for (const n of nested(0)) {
    print(Int.toString(n))
    break
  }
  return 0
}

function splitString(text: string, separator: string): Array<string> uses alloc {
  return match (Str.split(text, separator)) { Some(pieces) => pieces, None => [] }
}
