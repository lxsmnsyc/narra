import * as Arrays from "std/array"
import * as Sets from "std/set"
import { Set } from "std/set"
import * as Str from "std/string"
import * as Int from "std/int"

struct Point derives Hashable, Equatable {
  x: int
  y: int
}

function joinInts(items: Array<int>): string uses alloc {
  let parts: Array<string> = []
  for (const item of items) {
    Arrays.push(mutable parts, Int.toString(item))
  }
  return Str.join(parts, ",")
}

function fromInts(items: Array<int>): Set<int> uses alloc {
  let result: Set<int> = Sets.create()
  for (const item of items) {
    Sets.add(mutable result, item)
  }
  return result
}

export function run(args: Array<string>): int uses io, alloc {
  // An empty set.
  const empty: Set<int> = Sets.create()
  print(
    `empty: ${Show.show(Sets.size(empty))} [${joinInts(Sets.values(empty))}] ${Show.show(Sets.has(empty, 1))}`,
  )

  // Adding twice keeps one item and reports the change; values keep insertion order.
  let numbers = fromInts([3, 1, 2])
  print(`add new: ${Show.show(Sets.add(mutable numbers, 9))}`)
  print(`add again: ${Show.show(Sets.add(mutable numbers, 3))}`)
  print(`size: ${Show.show(Sets.size(numbers))} values: ${joinInts(Sets.values(numbers))}`)

  // Removing reports whether the item was there.
  print(`remove: ${Show.show(Sets.remove(mutable numbers, 1))}`)
  print(`remove missing: ${Show.show(Sets.remove(mutable numbers, 1))}`)
  print(`after remove: ${joinInts(Sets.values(numbers))} has 1: ${Show.show(Sets.has(numbers, 1))}`)

  // A copy is independent.
  let copied = copy(numbers)
  Sets.add(mutable copied, 100)
  print(`original: ${Show.show(Sets.size(numbers))} copy: ${Show.show(Sets.size(copied))}`)

  // Union, intersection and difference return new sets.
  const left = fromInts([1, 2, 3, 4])
  const right = fromInts([3, 4, 5])
  print(`union: ${joinInts(Sets.values(Sets.union(left, right)))}`)
  print(`intersection: ${joinInts(Sets.values(Sets.intersection(left, right)))}`)
  print(`difference: ${joinInts(Sets.values(Sets.difference(left, right)))}`)
  print(`reverse difference: ${joinInts(Sets.values(Sets.difference(right, left)))}`)
  print(`left after: ${joinInts(Sets.values(left))}`)

  // The operations with an empty set.
  print(`union empty: ${joinInts(Sets.values(Sets.union(left, empty)))}`)
  print(`intersection empty: ${Show.show(Sets.size(Sets.intersection(left, empty)))}`)
  print(`difference empty: ${joinInts(Sets.values(Sets.difference(left, empty)))}`)
  print(`empty difference: ${Show.show(Sets.size(Sets.difference(empty, left)))}`)

  // Strings and structs are items too.
  let words: Set<string> = Sets.create()
  Sets.add(mutable words, "ada")
  Sets.add(mutable words, "grace")
  Sets.add(mutable words, "ada")
  print(`words: ${Str.join(Sets.values(words), ",")}`)

  let points: Set<Point> = Sets.create()
  Sets.add(mutable points, Point { x: 1, y: 2 })
  Sets.add(mutable points, Point { x: 1, y: 2 })
  Sets.add(mutable points, Point { x: 2, y: 1 })
  print(
    `points: ${Show.show(Sets.size(points))} has: ${Show.show(Sets.has(points, Point { x: 2, y: 1 }))}`,
  )
  return 0
}
