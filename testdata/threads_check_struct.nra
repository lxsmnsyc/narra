// A struct of arrays, maps, options and a Box is Sendable, so a thread
// function may capture it and give it back.
import * as Boxes from "std/box"
import * as Int from "std/int"
import * as Thread from "std/thread"

struct Inventory {
  names: Array<string>
  counts: Map<string, int>
  owner: Option<string>
  total: Box<int>
}

function countAll(inventory: Inventory): int {
  let sum = 0
  for (const name of inventory.names) {
    if (inventory.counts[name] is Some(count)) {
      sum = sum + count
    }
  }
  return sum
}

export function run(_args: Array<string>): int {
  const inventory = Inventory {
    names: ["apple", "pear", "plum"],
    counts: Map { "apple": 3, "pear": 5, "plum": 7 },
    owner: Some("shop"),
    total: Boxes.new(15),
  }
  const result = Thread.scope((scope) => {
    const counter = Thread.start(scope, () => countAll(inventory))
    const copier = Thread.start(scope, () => Inventory {
      names: ["fig"],
      counts: Map { "fig": 1 },
      owner: None,
      total: Boxes.new(inventory.total.value + 1),
    })
    const counted = Thread.join(counter)
    const made = Thread.join(copier)
    return counted + countAll(made) + made.total.value
  })
  print(Int.toString(result))
  if (inventory.owner is Some(owner)) {
    print(owner)
  }
  return 0
}
