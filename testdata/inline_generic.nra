// A generic @inline function is copied with the call's type arguments.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

@inline
function mapAll<T, U>(items: Array<T>, transform: (item: T) => U): Array<U> uses alloc {
  let out: Array<U> = []
  for (const item of Arrays.values(items)) {
    Arrays.push(mutable out, transform(item))
  }
  return out
}

@inline
function pick<T>(condition: bool, whenTrue: T, whenFalse: T): T uses alloc {
  if (condition) {
    return copy(whenTrue)
  }
  return copy(whenFalse)
}

export function run(_args: Array<string>): int uses io, alloc {
  const offset = 10
  const numbers = mapAll([1, 2, 3], (item) => item + offset)
  print(Str.join(mapAll(numbers, (item) => Int.toString(item)), " "))
  const tag = "#"
  print(Str.join(mapAll(["a", "b"], (item) => `${tag}${item}`), " "))
  print(pick(Arrays.length(numbers) > 2, "many", "few"))
  print(Int.toString(pick(false, 1, 2)))
  return 0
}
