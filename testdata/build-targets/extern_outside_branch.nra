// A function of a `@target` extern block follows the rules of a `@target`
// function: an ordinary if guarantees no target, so the use fails on both macOS
// targets, reported once
// (checked with --all-targets, so the output is the same on every host).
import * as Arrays from "std/array"
import * as U64 from "std/u64"
import { Os } from "std/build"

@target(os = Os.Windows)
extern {
  function GetTickCount64(): u64
} from "kernel32"

export function run(args: Array<string>): int uses unsafe {
  if (Arrays.length(args) > 0) {
    print("has a program name")
  }
  unsafe {
    print(U64.toString(GetTickCount64()))
  }
  return 0
}
