// error: `for (mutable ...)` is not allowed in an async body; change the elements through an index, as in `items[index].field = value`
struct Counter {
  count: int
}

async function* counts(): AsyncGenerator<int> {
  let counters = [Counter { count: 1 }]
  for (mutable counter of counters) {
    counter.count += 1
  }
  yield counters[0].count
}

export function main() {
  const _stream = counts()
}
