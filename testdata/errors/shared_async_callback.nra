// error: the callback of Shared.update cannot be async
import * as Shared from "std/shared"

async function double(value: int): int {
  return value * 2
}

export function run(_args: Array<string>): int {
  const hits = Shared.create(0)
  Shared.update(hits, async (count) => count + 1)
  const _later = Shared.read(hits, double)
  return 0
}
