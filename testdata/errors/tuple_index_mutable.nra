// error: a mutable argument must be a variable, a field or an element
import * as Arrays from "std/array"

function update(mutable items: Array<int>) uses alloc {
  Arrays.push(mutable items, 3)
}

export function run(_args: Array<string>): int uses alloc {
  let pair = #[[1], 2]
  update(mutable pair[0])
  return pair[1]
}
