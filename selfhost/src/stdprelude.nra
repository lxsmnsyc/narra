// The registry rows of the prelude (assert, copy, panic, print). copy is checked
// and emitted by narrac/stdcopy.
import { StdFunc } from "narrac/builtins"

export const PRELUDE_FUNCS: Array<StdFunc> = [
  StdFunc { name: "assert", module: "", key: "assert", parameters: ["bool"], result: "void" },
  StdFunc { name: "copy", module: "", key: "copy", check: "checkCopy" },
  StdFunc { name: "panic", module: "", key: "panic", parameters: ["string"], result: "void" },
  StdFunc {
    name: "print",
    module: "",
    key: "print",
    parameters: ["string"],
    result: "void",
    effects: ["io"],
  },
]
