import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Shapes from "app/shapes"
import { Point, Shape as S, area as measure } from "app/shapes"

function describe(shape: S): int {
  if (shape is Shapes.Shape.Circle(radius)) {
    return radius
  }
  return 0
}

export function run(arguments: Array<string>): int uses io, alloc {
  const count = Arrays.length(arguments)
  print(`n ${Int.toString(count)}`)
  const point = Point { x: 1, y: 2 }
  const shape = S.Circle(1)
  return describe(shape) + measure(shape) + point.x
}
