// A std function WASI cannot back is E0991 on Wasi-Wasm32 unless the use sits in a branch that drops that
// target (checked with --all-targets, so the output is the same on every host).
import * as Build from "std/build"
import { Os } from "std/build"
import * as Process from "std/process"
import * as Terminal from "std/terminal"
import { Stream } from "std/terminal"

export function run(_args: Array<string>): int uses io, alloc {
  if (Build.os != Os.Wasi) {
    const _guarded = Process.run("echo", ["guarded"])
    const _guardedWidth = Terminal.columns(Stream.Stdout)
  }
  const _unguarded = Process.run("echo", ["unguarded"])
  const _unguardedWidth = Terminal.columns(Stream.Stdout)
  return 0
}
