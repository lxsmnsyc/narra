import * as Json from "std/json"
import * as Geo from "derive_shape_modules/geo"
import { Point, Labeled } from "derive_shape_modules/geo"

export function run(args: Array<string>): int {
  const point = Point { x: 1, y: -2 }
  print(Json.encode(point))
  print(Json.encode([Labeled.Plain(point), Labeled.Named("origin", Point { x: 0, y: 0 })]))
  const decoded = Json.decode<Array<Labeled<Point>>>(
    "[{\"type\":\"Named\",\"name\":\"a\",\"value\":{\"x\":3,\"y\":4}}]",
  )
  if (decoded is Ok(items)) {
    print(Json.encode(items))
  }
  const bad = Json.decode<Labeled<int>>("{\"type\":\"Plain\",\"value\":\"7\"}")
  if (bad is Err(message)) {
    print(message)
  }
  print(Geo.saveSpan(Geo.span(2, 5)))
  const loaded = Geo.loadSpan("{\"start\":5,\"finish\":2}")
  if (loaded is Err(message)) {
    print(message)
  }
  return 0
}
