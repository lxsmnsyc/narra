import * as Arrays from "std/array"

const LIMIT = 100

struct Rect {
  width: int
  height: int
}

function atLeastOne(value: int): int
  ensures > 0
{
  if (value > 0) {
    return value
  }
  return 1
}

function clampPercent(value: int): int
  ensures >= 0
  ensures <= LIMIT
{
  if (value < 0) {
    return 0
  }
  if (value > LIMIT) {
    return LIMIT
  }
  return value
}

function findIndex(items: Array<int>, wanted: int): Option<int>
  ensures Some(>= 0) | None
{
  let index = 0
  while (index < Arrays.length(items)) {
    if (items[index] == wanted && index >= 0) {
      return Some(index)
    }
    index++
  }
  return None
}

function parsePositive(value: int): Result<int, string>
  ensures Ok(> 0) | Err(_)
{
  if (value > 0) {
    return Ok(value)
  }
  return Err("not positive")
}

function splitCount(total: int): #[int, int]
  ensures #[>= 0, _]
{
  if (total >= 0) {
    return #[total, 0]
  }
  return #[0, total]
}

function makeRect(width: int, height: int): Rect
  requires width > 0
  ensures { width: > 0 }
{
  return Rect { width: width, height: height }
}

function methodName(write: bool): string
  ensures "GET" | "POST"
{
  if (write) {
    return "POST"
  }
  return "GET"
}

function* countDown(start: int): Generator<int>
  ensures >= 1
{
  let current = start
  while (current >= 1) {
    yield current
    current = current - 1
  }
}

function share(divisor: int): int
  requires divisor != 0
  ensures != 0
{
  return divisor
}

function nonzero(value: int): int
  ensures != 0
{
  if (value != 0) {
    return value
  }
  return -1
}

function notFive(value: int): int
  ensures != 5
{
  if (value < 5) {
    return value
  }
  return 6
}

function nonzeroOrFive(value: int): int
  ensures != 0 | 5
{
  if (value > 0) {
    return value
  }
  return 5
}

function pickSlot(index: int): int
  requires index >= 0
{
  return index + 1
}

function scale(percent: int): int
  requires percent >= 0 && percent <= LIMIT
{
  return percent * 2
}

function wrapped(value: int): Option<int>
  ensures Some(> 0) | None
{
  // A pattern binding of a result learns the callee's pattern.
  if (parsePositive(value) is Ok(positive)) {
    return Some(positive)
  }
  return None
}

export function run(_args: Array<string>): int {
  const items = [4, 8, 15]
  // `const n = f()` knows the pattern of the result.
  const divisor = atLeastOne(-3)
  print(Show.show(100 / divisor))
  const percent = clampPercent(250)
  print(Show.show(scale(percent)))
  if (findIndex(items, 15) is Some(index)) {
    print(Show.show(pickSlot(index)))
  }
  const found = findIndex(items, 8)
  if (found is Some(index)) {
    print(Show.show(pickSlot(index)))
  }
  const quotient = match (parsePositive(7)) { Ok(value) => 70 / value, Err(_) => 0 }
  print(Show.show(quotient))
  const #[count, rest] = splitCount(5)
  print(Show.show(pickSlot(count) + rest))
  const { width } = makeRect(3, 4)
  print(Show.show(12 / width))
  print(methodName(true))
  let total = 0
  for (const step of countDown(3)) {
    total = total + 12 / step
  }
  print(Show.show(total))
  // `!= 0` makes the result a divisor; `!= 0 | 5` too, since neither alternative is 0.
  const first = nonzero(0)
  const second = share(4)
  const third = nonzeroOrFive(-2)
  print(Show.show(60 / first + 60 / second + 60 / third + notFive(9)))
  if (wrapped(5) is Some(positive)) {
    print(Show.show(10 / positive))
  }
  return 0
}
