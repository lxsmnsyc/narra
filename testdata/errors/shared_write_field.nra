// warning: bag.items[0] = ... may change bag.items, which items still uses at line 12
struct Bag {
  items: Array<int>
  count: int
}

export function run(_args: Array<string>): int uses alloc {
  let bag = Bag { items: [1, 2], count: 0 }
  const items = bag.items
  // The write copies bag.items, because items still shares it.
  bag.items[0] = 9
  return items[0] + bag.items[0]
}
