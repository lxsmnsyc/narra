// The builtin registry: the signature data of the standard library, ported
// from compiler/internal/narra/builtins.go (Builtin, Module, the registries,
// registerModule, registerByName, moduleList). The table itself is in
// stdlib.nra. Check and Emit closures are not ported: a builtin names the
// Go Check function it needs in `check`, and the body checker dispatches on
// that name (selfhost-check-bodies); the emitter brings its own code
// (selfhost-emit).
//
// Types are kept as their text (`Array<string>`, `Result<int, string>`),
// because Option, Result and tuple types are instances that only a checker
// can make. stdType in scopes.nra resolves the text.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"

// One std function. check is "" for a builtin with a fixed signature in
// params and result; "fixed" for one whose Go Check is an inline closure
// that calls checkFixed with params and result; otherwise the name of the
// Go Check function (checkArrayPush), and params and result are empty.
export struct StdFunc {
  name: string // Builtin.Name: "Str.slice", unique
  module: string // "std/string", or "" for print, assert and panic
  key: string // the name an import uses: "slice" (Go's Module.Funcs key)
  params: Array<string> = [] // type text
  mutables: Array<bool> = [] // Builtin.Mutable; empty means none are mutable
  result: string = "" // type text; "" when the check computes it
  effects: Array<string> = [] // "alloc", "io"
  callbacks: Array<int> = [] // arguments that are function values the builtin calls
  check: string = ""
}

// A std module: its functions by export name (StdFunc indexes).
export struct StdModule {
  path: string
  funcs: Map<string, int>
}

export struct Registry {
  funcs: Array<StdFunc>
  prelude: Map<string, int> // print, assert, panic: the only global functions
  modules: Map<string, StdModule>
  order: Array<string> // module paths in registration order
  byName: Map<string, int> // every builtin by StdFunc.name
}

export function newRegistry(): Registry uses alloc {
  return Registry { funcs: [], prelude: Map {}, modules: Map {}, order: [], byName: Map {} }
}

// register adds a builtin. A duplicate name is a bug in the table, as in Go.
export function register(mutable registry: Registry, builtin: StdFunc) uses alloc {
  if (registry.byName[builtin.name] is Some(_)) {
    panic(`duplicate builtin ${builtin.name}`)
  }
  const index = Arrays.length(registry.funcs)
  registry.byName[builtin.name] = index
  Arrays.push(mutable registry.funcs, builtin)
  if (builtin.module == "") {
    registry.prelude[builtin.key] = index
    return
  }
  if (registry.modules[builtin.module] is Some(module)) {
    let funcs = module.funcs
    funcs[builtin.key] = index
    registry.modules[builtin.module] = StdModule { path: builtin.module, funcs: funcs }
    return
  }
  let funcs: Map<string, int> = Map {}
  funcs[builtin.key] = index
  registry.modules[builtin.module] = StdModule { path: builtin.module, funcs: funcs }
  Arrays.push(mutable registry.order, builtin.module)
}

// moduleOrder lists the module paths as Go's moduleList names them: std/int,
// std/float and std/string first, then the rest in registration order.
export function moduleOrder(registry: Registry): Array<string> uses alloc {
  let paths: Array<string> = []
  const first = ["std/int", "std/float", "std/string"]
  for (const path of Arrays.values(first)) {
    if (registry.modules[path] is Some(_)) {
      Arrays.push(mutable paths, path)
    }
  }
  for (const path of Arrays.values(registry.order)) {
    if (path != "std/int" && path != "std/float" && path != "std/string") {
      Arrays.push(mutable paths, path)
    }
  }
  return paths
}

// moduleList names the registered modules for error messages:
// "std/int, std/float and std/test".
export function moduleList(registry: Registry): string uses alloc {
  const paths = moduleOrder(registry)
  const count = Arrays.length(paths)
  if (count < 2) {
    return Str.join(paths, "")
  }
  let head: Array<string> = []
  for (const path of Arrays.values(paths)) {
    if (Arrays.length(head) < count - 1) {
      Arrays.push(mutable head, path)
    }
  }
  return `${Str.join(head, ", ")} and ${paths[count - 1]}`
}

// dump prints the registry in the `builtin` format of decldump.go: the
// prelude functions, then each module in moduleOrder, functions by export
// name. A "fixed" builtin also prints its signature as `fixed param` and
// `fixed result` lines, which Go cannot print (TestSelfhostBuiltins checks
// them by compiling a call and removes them before comparing).
export function dump(registry: Registry): string uses alloc {
  let builder = Str.builder()
  dumpModule(mutable builder, registry, "", registry.prelude)
  for (const path of Arrays.values(moduleOrder(registry))) {
    if (registry.modules[path] is Some(module)) {
      dumpModule(mutable builder, registry, path, module.funcs)
    }
  }
  return Str.build(builder)
}

function dumpModule(mutable builder: StringBuilder, registry: Registry, path: string, funcs: Map<string, int>) uses alloc {
  let names: Array<string> = []
  for (const name of Maps.keys(funcs)) {
    Arrays.push(mutable names, name)
  }
  sortStrings(mutable names)
  for (const name of Arrays.values(names)) {
    if (funcs[name] is Some(index)) {
      dumpFunc(mutable builder, registry.funcs[index])
    }
  }
}

function dumpFunc(mutable builder: StringBuilder, builtin: StdFunc) uses alloc {
  Str.append(mutable builder, `builtin module="${builtin.module}" export=${builtin.key} ${builtin.name}\n`)
  const fixed = builtin.check == "fixed"
  let prefix = "  "
  if (fixed) {
    prefix = "  fixed "
  }
  for (const index of Ranges.between(0, Arrays.length(builtin.params))) {
    let flag = ""
    if (index < Arrays.length(builtin.mutables) && builtin.mutables[index]) {
      flag = "mutable "
    }
    Str.append(mutable builder, `${prefix}param ${flag}${builtin.params[index]}\n`)
  }
  if (Arrays.length(builtin.params) == 0 && !fixed && Arrays.length(builtin.mutables) > 0) {
    let flags: Array<string> = []
    for (const isMutable of Arrays.values(builtin.mutables)) {
      if (isMutable) {
        Arrays.push(mutable flags, "true")
      } else {
        Arrays.push(mutable flags, "false")
      }
    }
    Str.append(mutable builder, `  mutable ${Str.join(flags, ",")}\n`)
  }
  if (builtin.result != "") {
    Str.append(mutable builder, `${prefix}result ${builtin.result}\n`)
  }
  if (Arrays.length(builtin.effects) > 0) {
    Str.append(mutable builder, `  effects ${Str.join(builtin.effects, ",")}\n`)
  }
  if (Arrays.length(builtin.callbacks) > 0) {
    let indexes: Array<string> = []
    for (const callback of Arrays.values(builtin.callbacks)) {
      Arrays.push(mutable indexes, Int.toString(callback))
    }
    Str.append(mutable builder, `  callbacks ${Str.join(indexes, ",")}\n`)
  }
  if (builtin.check != "") {
    Str.append(mutable builder, `  check ${builtin.check}\n`)
  }
}

// sortStrings sorts in byte order (insertion sort; a module has few
// functions).
function sortStrings(mutable items: Array<string>) {
  const count = Arrays.length(items)
  for (const i of Ranges.between(1, count)) {
    const item = items[i]
    let j = i
    while (j > 0 && items[j - 1] > item) {
      items[j] = items[j - 1]
      j = j - 1
    }
    items[j] = item
  }
}
