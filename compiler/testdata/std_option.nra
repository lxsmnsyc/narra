// std/option: map, andThen, withDefault, orElse, isSome, isNone, okOr.
import * as Option from "std/option"
import * as Int from "std/int"

struct Tag {
  name: string
  n: int
}

function half(n: int): Option<int> {
  if (n % 2 == 0) {
    return Some(n / 2)
  }
  return None
}

function noisy(n: int): int uses io {
  print(`noisy ${Int.toString(n)}`)
  return n + 1
}

function show(o: Option<int>): string {
  return match (o) {
    Some(v) => `Some(${Int.toString(v)})`
    None => "None"
  }
}

export function run(args: Array<string>): int {
  const k = 10
  const some: Option<int> = Some(4)
  const none: Option<int> = None
  // Non-capturing and capturing callbacks.
  print(show(Option.map(some, (x) => x * 2)))
  print(show(Option.map(some, (x) => x + k)))
  print(show(Option.map(none, (x) => x + k)))
  // A callback that changes the type, with a heap value.
  const label = Option.map(some, (x) => `n=${Int.toString(x + k)}`)
  print(Option.withDefault(label, "none"))
  print(Option.withDefault(Option.map(none, (x) => `n=${Int.toString(x)}`), "fallback"))
  // An io callback.
  print(show(Option.map(some, noisy)))
  print(show(Option.map(some, (x) => noisy(x + k))))
  // andThen
  print(show(Option.andThen(some, half)))
  print(show(Option.andThen(Some(3), half)))
  print(show(Option.andThen(none, half)))
  print(show(Option.andThen(some, (x) => half(x + k))))
  // withDefault
  print(Int.toString(Option.withDefault(some, 0)))
  print(Int.toString(Option.withDefault(none, 7)))
  // orElse
  print(show(Option.orElse(none, () => Some(k))))
  print(show(Option.orElse(some, () => Some(k))))
  // isSome, isNone
  if (Option.isSome(some) && Option.isNone(none)) {
    print("tests ok")
  }
  // okOr
  const r = Option.okOr(some, "missing")
  const q = Option.okOr(none, "missing")
  print(match (r) {
    Ok(v) => `ok ${Int.toString(v)}`
    Err(e) => e
  })
  print(match (q) {
    Ok(v) => `ok ${Int.toString(v)}`
    Err(e) => e
  })
  // A struct payload.
  const t: Option<Tag> = Some(Tag { name: "a", n: 1 })
  const names = Option.map(t, (x) => x.name)
  print(Option.withDefault(names, "?"))
  return 0
}
