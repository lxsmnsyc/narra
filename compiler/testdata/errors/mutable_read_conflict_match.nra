// error: mutable_read_conflict_match.nra:9:17: "x" is passed as mutable in one call, so the rest of the expression cannot use it
function bump(mutable n: int): int {
  n = 10
  return 0
}

export function run(args: Array<string>): int {
  let x = 1
  return match (x + bump(mutable x)) {
    0 => 1
    _ => 2
  }
}
