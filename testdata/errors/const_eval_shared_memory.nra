// error: E1055, storing a shared array counts as the copy its first write makes
import * as Arrays from "std/array"
import * as Int from "std/int"

@const
function table(count: int): int uses alloc {
  let rows: Array<Array<int>> = []
  if (Arrays.filled(0, 1000000) is Some(row)) {
    for (let index = 0; index < count; index++) {
      Arrays.push(mutable rows, row)
    }
  }
  for (let index = 0; index < count; index++) {
    rows[index][0] = index
  }
  return Arrays.length(rows)
}

const ROWS = table(400)

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(ROWS))
  return 0
}
