<script>
  import { $signal } from 'brumate/signals';

  // What each command prints, copied from runs of narrac on the samples of the guide.
  const TOOLS = [
    {
      id: 'run',
      label: 'run',
      command: 'narrac run shapes.nra',
      lines: ['area 27', 'area 12'],
      note: 'Builds a native binary through C and runs it.',
    },
    {
      id: 'test',
      label: 'test',
      command: 'narrac test temperature.nra',
      lines: [
        'ok - water freezes at 32 F',
        'ok - parse reads a reading',
        'ok - parse rejects a missing unit',
        'ok - average of no readings panics',
        'FAIL - water boils at 211 F: expected 211, got 212 (temperature.nra:42:10)',
        '4 passed, 1 failed',
      ],
      note: 'Tests sit next to the code. Each runs in its own process.',
    },
    {
      id: 'explain',
      label: 'explain',
      command: 'narrac explain E0003',
      lines: [
        'E0003: semicolons are not used; end the statement with a line break',
        '',
        'Narra has no semicolons. A line break ends a statement.',
        'Fix: delete the `;`.',
        'Example: `return 0;` becomes `return 0`.',
      ],
      note: 'Every error has a code, and every code an explanation.',
    },
    {
      id: 'query',
      label: 'query',
      command: 'narrac query type-of src/main.nra:5:17',
      lines: ['string', 'effects: alloc'],
      note: 'Ask the compiler about your code: types, callers, references.',
    },
  ];

  let current = $signal('run');
</script>

<div class="tools">
  <div class="tools-list" role="tablist" aria-label="narrac commands">
    #for (tool of TOOLS by tool.id) {
      <button
        type="button"
        role="tab"
        class="tools-tab"
        aria-selected=(current === tool.id ? 'true' : 'false')
        aria-controls="tools-terminal"
        onClick=(() => (current = tool.id))
      >
        <span class="tools-name">narrac {tool.label}</span>
        <span class="tools-note">{tool.note}</span>
      </button>
    }
  </div>
  <div class="terminal" id="tools-terminal" role="tabpanel">
    <div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="terminal-stack">
      #for (tool of TOOLS by tool.id) {
        <pre class="terminal-screen" aria-hidden=(current === tool.id ? 'false' : 'true')><span class="terminal-line terminal-command" style="--line: 0"><span class="terminal-prompt">$</span> {tool.command}</span>
          #for (line, index of tool.lines by index) {
            <span class={ 'terminal-line': true, fail: line.startsWith('FAIL') } style=(`--line: ${index + 1}`)>{line}</span>
          }
        </pre>
      }
    </div>
  </div>
</div>
