// error: an async arrow or block cannot capture "count", which is declared with let: the task copies its captures when it starts; keep state that changes in a Cell from std/cell
import * as Arrays from "std/array"

export async function run(_args: Array<string>): int {
  const items = [1]
  const grow = async {
    Arrays.push(mutable items, 2)
    return 0
  }
  await grow
  let count = 0
  count += 1
  const task = async {
    return count + 1
  }
  const later = async () => count * 2
  return await task + await later()
}
