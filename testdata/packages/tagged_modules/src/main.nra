// A dotted tag from another module of the package, and one imported by name.
import * as Html from "tagged/html"
import { escape } from "tagged/html"

export function run(_args: Array<string>): int {
  const user = "<b>"
  print(Html.escape`<p>${user}</p>`)
  print(escape`<i>${user}\n</i>`)
  print(Html.source`a\n${1}b`)
  return 0
}
