// A function with an effect variable used as a value: a call through the
// value takes the effects of the function passed in.
import * as Int from "std/int"

function loud(value: int): int uses io {
  print("loud")
  return value + 1
}

function quiet(value: int): int {
  return value + 2
}

function twice<effect E>(callback: (value: int) => int uses E, value: int): int uses E {
  return callback(callback(value))
}

const apply = twice

export function pure(): int {
  const local = twice
  return apply(quiet, 1) + local(quiet, 2)
}

export function run(args: Array<string>): int uses io {
  const viaLocal = twice
  print(Int.toString(pure()))
  print(Int.toString(apply(loud, 1)))
  print(Int.toString(viaLocal(loud, 5)))
  return 0
}
