// typeof names a function or a constant declared further down the file.
import * as Int from "std/int"

export type Scorer = typeof score

struct Board {
  cells: Array<int>
}

function pick(scorer: Scorer, board: Board): int {
  return scorer(board)
}

function score(board: Board): int {
  return board.cells[0] * factor
}

const factor: int = 4

function widen(value: typeof factor): int {
  return value + 1
}

export function run(_args: Array<string>): int {
  print(Int.toString(pick(score, Board { cells: [3] })))
  print(Int.toString(widen(factor)))
  return 0
}
