// Loops that write a shared array by index but run zero times make no copy:
// the uniqueness test waits for the first pass through the body. The copy
// check reports nothing.
import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

export function run(args: Array<string>): int {
  const missing = Arrays.length(args) - 1
  let ranged = filledArray(0, 4)
  const rangedOriginal = ranged
  for (const i of Ranges.upTo(missing)) {
    ranged[i] = i + 1
  }
  let counted = filledArray(0, 4)
  const countedOriginal = counted
  let position = 0
  while (position < missing) {
    counted[position] = position + 1
    position++
  }
  let stepped = filledArray(0, 4)
  const steppedOriginal = stepped
  for (let index = 0; index < missing; index++) {
    stepped[index] = index + 1
  }
  print(
    `${Int.toString(ranged[0])} ${Int.toString(rangedOriginal[0])} ${Int.toString(counted[0])} ${Int.toString(countedOriginal[0])} ${Int.toString(stepped[0])} ${Int.toString(steppedOriginal[0])}`,
  )
  return 0
}

function filledArray<T>(value: T, count: int): Array<T> uses alloc {
  return match (Arrays.filled(value, count)) { Some(items) => items, None => [] }
}
