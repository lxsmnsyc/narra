// A block-bodied arrow argument runs nothing while the arguments are
// evaluated, so an earlier argument is read in place and needs no temporary.
import * as Int from "std/int"

function addLater(base: int, later: () => int): int {
  const first = later()
  const second = later()
  return base * 100 + first * 10 + second
}

export function run(args: Array<string>): int {
  const base = 4
  let counter = 1
  print(
    Int.toString(
      addLater(base + 1, () => {
        counter = counter + 1
        return counter
      }),
    ),
  )
  print(Int.toString(counter))
  return 0
}
