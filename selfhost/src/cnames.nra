// C names, ported from cnames.go. The functions take the Checker, not the
// Emitter: emitstate.nra defines the Emitter and imports this module (see
// contracts/emitter.md).
//
// Go registers each name lazily in a process-wide table. Here the names are
// pure functions of the Checker, and checkNameCollisions checks the table once
// over everything that has a name.
//
// - A declaration is <kind>_<module hash>_<name>: f_3fa9c1e7_show. The prelude
//   (module "") has no hash: f_show, E_Ordering.
// - A composite type (generic instance, tuple, function type, array) is
//   interned: its name is <kind>_<head>_<hash>, where the hash folds the head,
//   the arity and the names of the arguments in order.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Maps from "std/map"
import * as Ranges from "std/range"
import * as Cells from "std/cell"
import { Type, plainTypeKey, typeKey } from "narrac/types"
import { Checker, ProgramFunc, findBody, containsTypeParameter } from "narrac/check"
import { xxh32, hex8, relativeModule, moduleHash } from "narrac/hash"

function declHead(module: string, name: string): string uses alloc {
  // The head is <module hash>_<name>, or the name alone in the prelude.
  if (module == "") {
    return name
  }
  return `${moduleHash(module)}_${name}`
}

function joinIds(typeIds: Array<string>): string uses alloc {
  return Str.join(typeIds, "|")
}

function typeIds(checker: Checker, types: Array<Type>): Array<string> uses alloc {
  let ids: Array<string> = []
  for (const type of Arrays.values(types)) {
    Arrays.push(mutable ids, typeId(checker, type))
  }
  return ids
}

export function declName(kind: string, module: string, name: string): string uses alloc {
  // The kind is "f", "S", "E", "D", "G" or "g".
  return `${kind}_${declHead(module, name)}`
}

export function internedName(
  kind: string,
  head: string,
  arguments: Array<string>,
): string uses alloc {
  const fold = `${head}|${Int.toString(Arrays.length(arguments))}|${joinIds(arguments)}`
  return `${kind}_${head}_${hex8(xxh32(fold, 0))}`
}

function structName(checker: Checker, index: int): string uses alloc {
  const info = checker.structs[index]
  if (info.tuple) {
    return internedName(
      "S",
      `Tuple${Int.toString(Arrays.length(info.arguments))}`,
      typeIds(checker, info.arguments),
    )
  }
  if (Arrays.length(info.arguments) == 0) {
    return declName("S", info.module, info.name)
  }
  return internedName("S", declHead(info.module, info.name), typeIds(checker, info.arguments))
}

function enumName(checker: Checker, index: int): string uses alloc {
  const info = checker.enums[index]
  if (Arrays.length(info.arguments) == 0) {
    return declName("E", info.module, info.name)
  }
  return internedName("E", declHead(info.module, info.name), typeIds(checker, info.arguments))
}

function functionTypeName(
  checker: Checker,
  parameters: Array<Type>,
  result: Type,
): string uses alloc {
  // The parameters, then the result, are the arguments of the head Fn<n>.
  let ids = typeIds(checker, parameters)
  Arrays.push(mutable ids, typeId(checker, result))
  return internedName("F", `Fn${Int.toString(Arrays.length(parameters))}`, ids)
}

export function typeId(checker: Checker, type: Type): string uses alloc {
  return match (type) {
    Type.TInt => "int"
    Type.TI8 => "i8"
    Type.TI16 => "i16"
    Type.TI32 => "i32"
    Type.TU8 => "u8"
    Type.TU16 => "u16"
    Type.TU32 => "u32"
    Type.TU64 => "u64"
    Type.TF64 => "f64"
    Type.TF32 => "f32"
    Type.TBool => "bool"
    Type.TChar => "char"
    Type.TStr => "string"
    Type.TBytes => "bytes"
    Type.TVoid => "void"
    Type.TStringBuilder => "StringBuilder"
    Type.TStruct(index) => structName(checker, index)
    Type.TEnum(index) => enumName(checker, index)
    Type.TDistinct(index) => declName(
      "D",
      checker.distincts[index].module,
      checker.distincts[index].name,
    )
    Type.TParam(index) => `P_${checker.parameters[index].name}_${Int.toString(index)}`
    Type.TArray(element) => internedName("A", "Array", [typeId(checker, element)])
    Type.TBox(element) => internedName("B", "Box", [typeId(checker, element)])
    Type.TMap(key, valueType) => internedName("M", "Map", [
      typeId(checker, key),
      typeId(checker, valueType),
    ])
    Type.TFunc(parameters, result, _, _) => functionTypeName(checker, parameters, result)
    Type.TRange => "Range"
    Type.TGenerator(element, _, _, _, input) => generatorId(checker, element, input)
    _ => "x"
  }
}

function generatorId(checker: Checker, element: Type, input: Type): string uses alloc {
  // Effects and origin leave the C representation alone, so a function* and an
  // annotated function type naming it share one C type.
  if (input != Type.TVoid) {
    return `C_${typeId(checker, input)}_${typeId(checker, element)}`
  }
  return `G_${typeId(checker, element)}`
}

export function generatorPart(kind: string, owner: string): string uses alloc {
  // The kind is "Y", "y", "j" or "z", and the owner is the C name of the
  // generator function.
  return `${kind}${Str.sliceFrom(owner, 1)}`
}

export function cType(checker: Checker, type: Type): string uses alloc {
  return match (type) {
    Type.TInt => "int64_t"
    Type.TI8 => "int8_t"
    Type.TI16 => "int16_t"
    Type.TI32 => "int32_t"
    Type.TU8 => "uint8_t"
    Type.TU16 => "uint16_t"
    Type.TU32 => "uint32_t"
    Type.TU64 => "uint64_t"
    Type.TF64 => "double"
    Type.TF32 => "float"
    Type.TBool => "bool"
    Type.TChar => "uint32_t"
    Type.TStr | Type.TBytes => "lstr*"
    Type.TStringBuilder => "narra_sb*"
    Type.TVoid => "void"
    Type.TRange => "narra_range"
    Type.TParam(_) => "void*"
    Type.TArray(_) | Type.TBox(_) | Type.TMap(_, _) => `${typeId(checker, type)}*`
    Type.TDistinct(index) => cDistinctType(checker, index)
    Type.TStruct(_) | Type.TEnum(_) | Type.TFunc(_, _, _, _) => typeId(checker, type)
    Type.TGenerator(_, _, _, _, _) => "narra_gen*"
    _ => "void"
  }
}

function isCachedType(type: Type): bool {
  return match (type) {
    Type.TStruct(_)
      | Type.TEnum(_)
      | Type.TDistinct(_)
      | Type.TArray(_)
      | Type.TBox(_)
      | Type.TMap(_, _)
      | Type.TFunc(_, _, _, _)
      | Type.TGenerator(_, _, _, _, _) => true
    _ => false
  }
}

export function cachedTypeId(
  checker: Checker,
  cache: Cells.Cell<Map<string, string>>,
  type: Type,
): string uses alloc {
  if (!isCachedType(type)) {
    return typeId(checker, type)
  }
  const key = typeKey(type)
  if (Cells.get(cache)[key] is Some(name)) {
    return name
  }
  const name = typeId(checker, type)
  // Take the map out of the cell, so the write does not copy it.
  let names = Cells.get(cache)
  const empty: Map<string, string> = Map {}
  Cells.set(cache, empty)
  names[key] = name
  Cells.set(cache, names)
  return name
}

export function cachedCType(
  checker: Checker,
  cache: Cells.Cell<Map<string, string>>,
  type: Type,
): string uses alloc {
  return match (type) {
    Type.TArray(_) | Type.TBox(_) | Type.TMap(_, _) => `${cachedTypeId(checker, cache, type)}*`
    Type.TStruct(_) | Type.TEnum(_) | Type.TFunc(_, _, _, _) => cachedTypeId(checker, cache, type)
    _ => cType(checker, type)
  }
}

function cDistinctType(checker: Checker, index: int): string uses alloc {
  if (checker.distincts[index].base is Some(base)) {
    return cType(checker, base)
  }
  return "void"
}

export function payloadName(checker: Checker, enumType: Type): string uses alloc {
  // Its kind letter is its own, so no declaration name can equal it.
  return `Q${Str.sliceFrom(typeId(checker, enumType), 1)}`
}

export function instanceName(
  module: string,
  name: string,
  typeIds: Array<string>,
): string uses alloc {
  const fold = `${declHead(module, name)}|${Int.toString(Arrays.length(typeIds))}|${joinIds(typeIds)}`
  return `${name}_${hex8(xxh32(fold, 0))}`
}

export function implName(
  typeName: string,
  traitModule: string,
  traitName: string,
  member: string,
): string uses alloc {
  // The hash folds the type, the trait with its module, and the function, so no
  // separator rule is needed.
  const fold = `${typeName}|${relativeModule(traitModule)}|${traitName}|${member}`
  return `${typeName}_${traitName}_${member}_${hex8(xxh32(fold, 0))}`
}

function declaredTypeName(checker: Checker, type: Type): string {
  return match (type) {
    Type.TStruct(index) => checker.structs[index].name
    Type.TEnum(index) => checker.enums[index].name
    _ => ""
  }
}

export function opFuncName(operation: string, typeIdText: string): string uses alloc {
  // The operation comes first, so no declaration name can equal it.
  return `${operation}_${typeIdText}`
}

export function closureName(kind: string, owner: string, count: int): string uses alloc {
  // The kind is "k", "K" or "D". The owner is the C name of the enclosing
  // function (f_<hash>_<name>), and count counts its arrows from 1.
  return `${kind}${Str.sliceFrom(owner, 1)}_${Int.toString(count)}`
}

export function thunkName(owner: string): string uses alloc {
  return `w${Str.sliceFrom(owner, 1)}`
}

export function constName(module: string, name: string): string uses alloc {
  return declName("G", module, name)
}

export function constGetterName(module: string, name: string): string uses alloc {
  return declName("g", module, name)
}

// The module and the function name Go gives a function of the program (its
// FuncDecl.Module and FuncDecl.Name).
struct FuncNames {
  module: string
  name: string
}

function funcNames(checker: Checker, program: ProgramFunc): FuncNames uses alloc {
  return match (program) {
    ProgramFunc.PlainFunc(funcIndex) => FuncNames {
      module: checker.functions[funcIndex].module,
      name: checker.functions[funcIndex].name,
    }
    ProgramFunc.InstanceFunc(instance) => instanceFuncNames(checker, instance)
    ProgramFunc.ImplFunc(block, index) => implFuncNames(checker, block, index)
  }
}

function instanceFuncNames(checker: Checker, instance: int): FuncNames uses alloc {
  const info = checker.functions[checker.instanceList[instance].funcIndex]
  const ids = typeIds(checker, checker.instanceList[instance].typeArguments)
  return FuncNames { module: info.module, name: instanceName(info.module, info.name, ids) }
}

function implFuncNames(checker: Checker, block: int, index: int): FuncNames uses alloc {
  // The function's module is the module of the implement block.
  const impl = checker.implementations[block]
  const traitInfo = checker.traits[impl.traitIndex]
  const member = impl.functions[index].name
  const name = implName(
    declaredTypeName(checker, impl.forType),
    traitInfo.module,
    traitInfo.name,
    member,
  )
  return FuncNames { module: checker.scopes[impl.scope].path, name: name }
}

export function functionName(checker: Checker, program: ProgramFunc): string uses alloc {
  const names = funcNames(checker, program)
  return declName("f", names.module, names.name)
}

export function functionSignature(checker: Checker, program: ProgramFunc): string uses alloc {
  // The parameter names are the C names of the body's locals, which the checker
  // declares first, in order.
  let parameterTypes: Array<Type> = []
  let declared = checker.functions[0].declaration
  let result = Type.TVoid
  let key = ""
  match (program) {
    ProgramFunc.PlainFunc(funcIndex) => {
      declared = checker.functions[funcIndex].declaration
      result = checker.functions[funcIndex].result
      for (const param of Arrays.values(declared.parameters)) {
        Arrays.push(mutable parameterTypes, checker.paramTypes[param.id])
      }
      key = `func|${Int.toString(funcIndex)}`
    }
    ProgramFunc.InstanceFunc(instance) => {
      declared = checker.functions[checker.instanceList[instance].funcIndex].declaration
      result = checker.instanceList[instance].result
      parameterTypes = checker.instanceList[instance].parameters
      key = `inst|${Int.toString(instance)}`
    }
    ProgramFunc.ImplFunc(block, index) => {
      declared = checker.implementations[block].functions[index].declaration
      result = checker.implementations[block].functions[index].result
      for (const param of Arrays.values(declared.parameters)) {
        Arrays.push(mutable parameterTypes, checker.paramTypes[param.id])
      }
      key = `impl|${Int.toString(block)}|${Int.toString(index)}`
    }
  }
  const bodyIndex = findBody(checker, key)
  let parts: Array<string> = []
  for (const index of Ranges.between(0, Arrays.length(declared.parameters))) {
    let name = "v"
    if (bodyIndex >= 0) {
      const local = checker.bodies[bodyIndex].locals[index]
      name = `v_${local.name}_${Int.toString(local.number)}`
    }
    let star = ""
    if (declared.parameters[index].isMutable) {
      star = "*"
    }
    Arrays.push(mutable parts, `${cType(checker, parameterTypes[index])}${star} ${name}`)
  }
  if (Arrays.length(parts) == 0) {
    parts = ["void"]
  }
  return `static ${cType(checker, result)} ${functionName(checker, program)}(${Str.join(parts, ", ")})`
}

export function dropDuplicateTypes(checker: Checker): Checker uses alloc {
  // Types that differ only in a generator's effects or origin share one C name, and
  // so do the generic instances over them. Keep the first function and type of each name.
  let seen: Map<string, bool> = Map {}
  let functions: Array<ProgramFunc> = []
  for (const program of Arrays.values(checker.programFunctions)) {
    const name = functionName(checker, program)
    if (seen[name] is None) {
      seen[name] = true
      Arrays.push(mutable functions, program)
    }
  }
  let order: Array<Type> = []
  for (const type of Arrays.values(checker.order)) {
    const name = typeId(checker, type)
    if (seen[name] is None) {
      seen[name] = true
      Arrays.push(mutable order, type)
    }
  }
  let composites: Map<string, Type> = Map {}
  let dropped =
    Arrays.length(functions) != Arrays.length(checker.programFunctions) ||
      Arrays.length(order) != Arrays.length(checker.order)
  for (const entry of Maps.entries(checker.composites)) {
    const #[key, type] = entry
    const name = typeId(checker, type)
    if (seen[name] is None) {
      seen[name] = true
      composites[key] = type
    } else {
      dropped = true
    }
  }
  if (!dropped) {
    return checker
  }
  return { ...checker, programFunctions: functions, order: order, composites: composites }
}

export function checkNameCollisions(checker: Checker): Option<string> uses alloc {
  // This runs once after naming. Some(message) is an internal error.
  let seen: Map<string, string> = Map {}
  for (const program of Arrays.values(checker.programFunctions)) {
    const names = funcNames(checker, program)
    const key = `f|${relativeModule(names.module)}|${names.name}`
    const clash = noteName(mutable seen, functionName(checker, program), key)
    if (clash is Some(_)) {
      return clash
    }
  }
  for (const type of Arrays.values(checker.order)) {
    const clash = noteName(mutable seen, typeId(checker, type), `type|${plainTypeKey(type)}`)
    if (clash is Some(_)) {
      return clash
    }
  }
  for (const entry of Maps.entries(checker.composites)) {
    const #[_, type] = entry
    if (!containsTypeParameter(checker, type)) {
      const clash = noteName(mutable seen, typeId(checker, type), `type|${plainTypeKey(type)}`)
      if (clash is Some(_)) {
        return clash
      }
    }
  }
  return None
}

function noteName(
  mutable seen: Map<string, string>,
  name: string,
  key: string,
): Option<string> uses alloc {
  if (seen[name] is Some(have)) {
    if (have != key) {
      return Some(`internal error: C name ${name} is used for both "${have}" and "${key}"`)
    }
  }
  seen[name] = key
  return None
}
