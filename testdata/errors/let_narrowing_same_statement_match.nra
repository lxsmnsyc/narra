// error: let_narrowing_same_statement_match.nra:13:7: this Option<int> may hold any of its variants; check it with `is` or `match` before reading "value"
function clear(change: () => void): int {
  change()
  return 0
}

export function run(args: Array<string>): int {
  let x: Option<int> = Some(1)
  if (x is None) {
    return 0
  }
  match (
    x.value +
      clear(() => {
        x = None
      })
  ) {
    0 => print("zero")
    _ => print("other")
  }
  return 0
}
