// error: let_narrowing_loop.nra:10:23: this Option<int> may hold any of its variants
export function run(args: Array<string>): int {
  let x: Option<int> = Some(1)
  let total = 0
  let count = 0
  if (x is None) {
    return 0
  }
  while (count < 3) {
    total = total + x.value
    x = None
    count = count + 1
  }
  return total
}
