import * as Int from "std/int"

struct Point {
  x: int
  y: int
}

struct Pair<A, B> {
  first: A
  second: B
}

struct Line {
  start: Point
  finish: Point
}

enum Shape {
  Dot(at: Point)
  Segment(line: Line)
}

struct Limits {
  limit: int
  name: string
}

const limit = 100

function describe(point: Point): string {
  return `${Int.toString(point.x)},${Int.toString(point.y)}`
}

function fromParameters(x: int, y: int): Point {
  return Point { x, y }
}

function fromGlobal(name: string): Limits {
  return Limits { limit, name }
}

function shapeText(shape: Shape): string {
  return match (shape) {
    Shape.Dot(at) => `dot ${describe(at)}`
    Shape.Segment(line) => `segment ${describe(line.start)} to ${describe(line.finish)}`
  }
}

export function run(args: Array<string>): int {
  const x = 3
  const y = 4
  const plain = Point { x, y }
  print(describe(plain))
  const mixed = Point { x, y: 9 }
  print(describe(mixed))
  print(describe(fromParameters(5, 6)))
  const limits = fromGlobal("top")
  print(`${limits.name} ${Int.toString(limits.limit)}`)
  const first = "one"
  const second = 2
  const pair = Pair<string, int> { first, second }
  print(`${pair.first} ${Int.toString(pair.second)}`)
  const inferred = Pair { first, second: y }
  print(`${inferred.first} ${Int.toString(inferred.second)}`)
  const start = Point { x, y }
  const finish = Point { x: 10, y: 20 }
  const line = Line { start, finish }
  print(describe(line.finish))
  print(shapeText(Shape.Dot(Point { x, y })))
  print(shapeText(Shape.Segment(Line { start, finish })))
  const moved = Point { ...plain, y }
  print(describe(moved))
  const base = Point { x: 1, y: 1 }
  const updated = Point { ...base, x }
  print(describe(updated))
  return 0
}
