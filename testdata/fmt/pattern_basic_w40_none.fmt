const all = match (value) {
  _ => 0
  name => 1
  Some(inner) => 2
  None => 3
  Shape.Circle(radius) => 4
  Shape.Unit => 5
  Mod.Shape.Square(side) => 6
  #[first, second] => 7
  { x, y } => 8
  { x: 1, y: Some(inner) } => 9
  0 => 10
  -1 => 11
  1.5 => 12
  -2.5 => 13
  "text" => 14
  'c' => 15
  true => 16
  Pair(#[a, b], { c, d: _ }) => 17
}
const long = match (value) {
  Shape.Circle(
    firstRadiusName,
    secondRadiusName,
    thirdRadiusName,
    fourth
  ) => 1
  #[
    firstElementName,
    secondElementName,
    thirdElementName,
    fourthElement
  ] => 2
  {
    firstFieldName,
    secondFieldName: Some(inner),
    thirdFieldName,
    fourthField
  } => 3
  Outer(
    Inner(
      firstDeepValue,
      secondDeepValue
    ),
    Other(thirdDeepValue, fourthValue)
  ) => 4
}
const empty = match (value) {
  Unit() => 1
  #[] => 2
  {} => 3
}
const isPattern =
  value is Some(#[a, b]) &&
    other is { x }
