// error: a vector has no Value form, so a struct with a vector field does not derive Shape
import * as Simd from "std/simd"

struct Particle derives Shape {
  position: F32x4
}

export function run(_args: Array<string>): int {
  const particle = Particle { position: Simd.splat(1.0) }
  print(Show.show(particle.position))
  return 0
}
