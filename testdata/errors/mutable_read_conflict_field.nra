// error: mutable_read_conflict_field.nra:14:10: "p" is passed as mutable in one call, so the rest of the expression cannot use it
struct Point {
  x: int
  y: int
}

function reset(mutable p: Point): int {
  p.x = 0
  return 0
}

export function run(args: Array<string>): int {
  let p = Point { x: 3, y: 4 }
  return p.x + reset(mutable p)
}
