// error: the unsafe effect
import * as Ptr from "std/ptr"

export function viewBytes(words: Ptr<u32>, buffer: Ptr<FixedArray<u8, 4>>): Ptr<u8> {
  const bytes: Ptr<u8> = Ptr.cast(words)
  const first = Ptr.element(buffer, 0)
  if (Ptr.isNull(first)) {
    return first
  }
  return bytes
}

