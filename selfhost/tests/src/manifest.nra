// The manifest suite: each folder in testdata/manifest holds a narra.toml; a folder in
// testdata/lockfile runs `narrac pkg --deps .` (the dependencies and the narra.lock round trip).
// `narrac pkg --codes .` run inside the folder must fail with exit code 1 and print
// expected.err on stderr, or, when the folder has expected.dump instead,
// succeed and print that on stdout. The goldens were made by the Go compiler
// before it was removed. With --update they are rewritten from narrac.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Str from "std/string"
import * as Common from "testrunner/context"
import { Context, TestCase } from "testrunner/context"
import * as Files from "testrunner/files"

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  const folder = Path.join(context.testdata, "manifest")
  for (const path of Arrays.values(Files.listPaths(folder, ""))) {
    if (Fs.isDir(path)) {
      Arrays.push(mutable cases, TestCase {
        suite: "manifest",
        name: Path.basename(path),
        path: path,
        variant: "",
      })
    }
  }
  const lockFolder = Path.join(context.testdata, "lockfile")
  for (const path of Arrays.values(Files.listPaths(lockFolder, ""))) {
    if (Fs.isDir(path)) {
      Arrays.push(mutable cases, TestCase {
        suite: "manifest",
        name: `lockfile/${Path.basename(path)}`,
        path: path,
        variant: "deps",
      })
    }
  }
  const workspaceFolder = Path.join(context.testdata, "workspaces")
  for (const path of Arrays.values(Files.listPaths(workspaceFolder, ""))) {
    if (Fs.isDir(path) && Str.startsWith(Path.basename(path), "manifest_")) {
      Arrays.push(mutable cases, TestCase {
        suite: "manifest",
        name: `workspaces/${Path.basename(path)}`,
        path: path,
        variant: "workspace",
      })
    }
  }
  return cases
}

function readStartDirectory(folder: string): string uses io, alloc {
  // `start` names the directory to start from, relative to the folder; "." without it.
  const read = Fs.readText(Path.join(folder, "start"))
  if (read is Ok(text)) {
    return Str.trim(text)
  }
  return "."
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  let command = ["pkg", "--codes", "."]
  if (testCase.variant == "deps") {
    command = ["pkg", "--codes", "--deps", "."]
  }
  if (testCase.variant == "workspace") {
    command = ["pkg", "--codes", "--workspace", readStartDirectory(testCase.path)]
  }
  let runFolder = testCase.path
  if (testCase.variant == "workspace") {
    // `cwd` names a folder to run in, so the start can be a relative path that climbs.
    const working = Fs.readText(Path.join(testCase.path, "cwd"))
    if (working is Ok(text)) {
      runFolder = Path.join(testCase.path, Str.trim(text))
    }
  }
  const result = Common.runNarracWith(context, runFolder, [], command)
  let goldenName = "expected.dump"
  let got = result.output
  let wantCode = 0
  if (result.code == 1) {
    goldenName = "expected.err"
    got = result.errorOutput
    wantCode = 1
  }
  if (result.code != wantCode || (wantCode == 1 && result.output != "")) {
    return Err(`want exit code 0 or 1, got ${Common.describeRun(result)}`)
  }
  const golden = Path.join(testCase.path, goldenName)
  if (context.update) {
    const written = Fs.writeText(golden, got)
    if (written is Err(message)) {
      return Err(message)
    }
    return Ok(true)
  }
  const want = Common.readExpected(golden)
  if (want is Err(message)) {
    return Err(`${goldenName}: ${message}`)
  }
  return Common.compareText("pkg", want.value, got)
}
