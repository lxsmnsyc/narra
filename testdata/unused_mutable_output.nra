// A mutable parameter that is only written through counts as used.
import * as Int from "std/int"

struct Output {
  total: int
}

function setTotal(mutable out: Output, value: int) {
  out.total = value
}

export function run(args: Array<string>): int {
  const result = Output { total: 0 }
  setTotal(mutable result, 7)
  print(Int.toString(result.total))
  return 0
}
