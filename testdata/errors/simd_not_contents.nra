// error: a vector is not a contents type, so it is no mutable parameter and no copy argument
import * as Simd from "std/simd"

function scale(mutable values: F32x4) {
  print(Show.show(values))
}

export function run(_args: Array<string>): int {
  let v: F32x4 = Simd.splat(1.0)
  scale(mutable v)
  const w = copy(v)
  print(Show.show(w))
  return 0
}
