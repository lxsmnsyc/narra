// error: the index of FixedArray<int, 3> must be proven to be 0 to 2
function apply(action: () => int): int {
  return action()
}

function captured(values: FixedArray<int, 3>, start: int): int {
  let index = start
  if (index >= 0 && index < 3) {
    return apply(() => values[index])
  }
  return 0
}

function parameter(values: FixedArray<int, 3>): int {
  const read = (index: int): int => values[index]
  return read(1)
}

function* produce(values: FixedArray<int, 3>, start: int): Generator<int> {
  let index = start
  while (index < 3) {
    yield values[index]
    index++
  }
}

export function run(_args: Array<string>): int {
  const values: FixedArray<int, 3> = [1, 2, 3]
  let total = captured(values, 1) + parameter(values)
  for (const value of produce(values, 0)) {
    total += value
  }
  return total
}
