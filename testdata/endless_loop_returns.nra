import * as Int from "std/int"

function spin(limit: int): int {
  let count = 0
  while (true) {
    count++
    if (count > limit) {
      return count
    }
  }
}

function spinFor(limit: int): int {
  for (let count = 0; true; count++) {
    if (count > limit) {
      return count
    }
  }
}

function nestedBreak(limit: int): int {
  while (true) {
    for (let count = 0; count < limit; count++) {
      if (count == 3) {
        break
      }
    }
    return limit
  }
}

export function run(args: Array<string>): int {
  const find = (limit: int): int => {
    while (true) {
      return limit + 1
    }
  }
  print(Int.toString(spin(2) + spinFor(3) + nestedBreak(4) + find(5)))
  return 0
}
