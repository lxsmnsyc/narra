import { Label, OrderId, makeSecret } from "distinct_traits_modules/ids"

function describe<T: Label>(value: T): string {
  return Label.label(value)
}

export function run(args: Array<string>): int {
  const order = OrderId.from(12)
  print(describe(order))
  print(Show.show(order))
  print(Show.show(Ordered.compare(order, OrderId.from(20))))
  print(Show.show(makeSecret("hidden")))
  return 0
}
