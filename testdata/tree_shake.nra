// Tree shaking: only the declarations the entry reaches are emitted. The emit
// suite (tree-shake/unreached) checks that the C has no unreachedHelper, one
// instance of pick, no Hidden show and no unreached constant.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Shown implements Show {
  count: int
}

implement Show for Shown {
  function show(value: Shown): string {
    return `shown ${Int.toString(value.count)}`
  }
}

struct Hidden implements Show {
  count: int
}

implement Show for Hidden {
  function show(value: Hidden): string {
    return `hidden ${Int.toString(value.count)}`
  }
}

const usedNames = ["first", "second"]
const unreachedNames = ["third", "fourth"]

function pick<T>(first: T, _second: T): T from first {
  return first
}

function reachedHelper(value: int): int {
  return pick(value, 0) + Arrays.length(usedNames)
}

export function unreachedHelper(value: string): string uses alloc {
  const hidden = Hidden { count: Arrays.length(unreachedNames) }
  return `${pick(value, "")} ${Show.show(hidden)}`
}

export function run(args: Array<string>): int {
  const shown = Shown { count: reachedHelper(Arrays.length(args)) }
  print(Show.show(shown))
  return 0
}
