const STD_BUILD = "// std/build: the target a program is built for. The compiler sets os, arch and\n// debug for each build; the values written here are replaced. An `if` that\n// tests only these constants keeps one branch in the output.\n\nimport * as Host from \"std/internal/host\"\n\nexport enum Os derives Show, Equatable {\n  MacOS\n  Linux\n  Windows\n}\n\nexport enum Arch derives Show, Equatable {\n  Arm64\n  X86_64\n}\n\nexport const os: Os = Os.Linux\nexport const arch: Arch = Arch.X86_64\nexport const debug: bool = true\n\nexport struct Target {\n  os: Os\n  arch: Arch\n}\n\nexport function hostTarget(): Option<Target> {\n  const hostOs = Host.os()\n  const hostArch = Host.arch()\n  // The C compiler's predefined macros give the codes; 0 is a machine with no variant here.\n  if (hostOs == 0 || hostArch == 0) {\n    return None\n  }\n  if (hostOs == 1 && hostArch == 1) {\n    return Some(Target { os: Os.MacOS, arch: Arch.Arm64 })\n  }\n  if (hostOs == 1) {\n    return Some(Target { os: Os.MacOS, arch: Arch.X86_64 })\n  }\n  if (hostArch == 1) {\n    return Some(Target { os: Os.Linux, arch: Arch.Arm64 })\n  }\n  return Some(Target { os: Os.Linux, arch: Arch.X86_64 })\n}\n"

const STD_CELL = "// std/cell: Cell<T>, one mutable slot that every copy of the handle shares.\n//\n// A Cell is an identity type: copying it, capturing it in a closure or storing it in a\n// struct copies the handle, and Cell.set through any copy changes what all of them read.\n\nimport * as Boxes from \"std/box\"\nimport * as Slot from \"std/internal/cell\"\n\nexport opaque struct Cell<T> {\n  slot: Box<T>\n}\n\nexport function create<T>(value: T): Cell<T> uses alloc {\n  return Cell { slot: Boxes.new(value) }\n}\n\nexport function get<T>(cell: Cell<T>): T from cell {\n  return cell.slot.value\n}\n\nexport function set<T>(cell: Cell<T>, value: T) {\n  Slot.store(cell.slot, value)\n}\n\nexport function update<T, effect E>(cell: Cell<T>, change: (value: T) => T uses E) uses E {\n  // Hold the old value, so a set inside change cannot free it.\n  const old = get(cell)\n  Slot.store(cell.slot, change(old))\n}\n"

const STD_COROUTINE = "// std/coroutine: Co.resume runs a generator or a coroutine to its next yield.\n//\n// The compiler turns `Co.resume(mutable g)` into resumeGenerator and\n// `Co.resume(mutable g, input)` into resumeCoroutine, by argument count.\n\nimport * as Internal from \"std/internal/coroutine\"\n\nexport enum Step<Out> derives Show, Equatable {\n  Yielded(value: Out)\n  Done\n  Panicked(message: string)\n}\n\nexport function resumeGenerator<T, effect E>(\n  mutable g: Generator<T> uses E\n): Step<T> uses E, alloc {\n  return readStep(Internal.next(mutable g))\n}\n\nexport function resumeCoroutine<In, Out, effect E>(\n  mutable g: Coroutine<In, Out> uses E,\n  input: In,\n): Step<Out> uses E, alloc {\n  return readStep(Internal.resume(mutable g, input))\n}\n\n// readStep reads the outcome of one resume: a value, the end, or a panic.\nfunction readStep<T>(next: Option<T>): Step<T> from next uses alloc {\n  if (next is Some(value)) {\n    return Step.Yielded(value)\n  }\n  if (Internal.panicked()) {\n    return Step.Panicked(Internal.panicMessage())\n  }\n  return Step.Done\n}\n"

const STD_CSTRING = "// std/cstring: CString, a string with no zero byte, which C reads as a zero-terminated string.\n//\n// Pass `CStrings.pointer(text)` to a C function that takes `char*`; the pointer is valid while\n// the CString is. `CStrings.read` copies a zero-terminated string that C returns.\n\nimport * as Bytes from \"std/bytes\"\nimport * as Str from \"std/string\"\nimport * as Ptr from \"std/ptr\"\nimport * as Text from \"std/internal/cstring\"\n\nexport opaque struct CString {\n  text: string\n}\n\nexport function from(text: string): Option<CString> {\n  // C would stop at a zero byte, so a string that holds one has no CString.\n  const length = Str.length(text)\n  for (let index = 0; index < length; index++) {\n    if (Str.byteAt(text, index) == 0) {\n      return None\n    }\n  }\n  return Some(CString { text: text })\n}\n\nexport function toString(value: CString): string from value {\n  return value.text\n}\n\nexport function pointer(value: CString): Ptr<u8> {\n  return Text.pointer(value.text)\n}\n\nexport function read(address: Ptr<u8>): Result<string, string> uses alloc, unsafe {\n  let copied: Result<string, string> = Err(\"\")\n  unsafe {\n    copied = Bytes.toString(Text.read(address))\n  }\n  return copied\n}\n"

const STD_EXT__ARRAY = "// std/array: helpers over Array. The functions that need the compiler are built in.\n\nimport * as Arrays from \"std/array\"\n\nexport function map<T, U, effect E>(\n  items: Array<T>,\n  change: (value: T) => U uses E\n): Array<U> uses alloc, E {\n  let result: Array<U> = Arrays.withCapacity(Arrays.length(items))\n  for (const item of items) {\n    Arrays.push(mutable result, change(item))\n  }\n  return result\n}\n\nexport function slice<T>(items: Array<T>, start: int, finish: int): Option<Array<T>> uses alloc {\n  // A range outside the array has no slice.\n  if (start < 0 || finish > Arrays.length(items) || start > finish) {\n    return None\n  }\n  let result: Array<T> = Arrays.withCapacity(finish - start)\n  for (let index = start; index < finish; index++) {\n    Arrays.push(mutable result, copy(items[index]))\n  }\n  return Some(result)\n}\n"

const STD_EXT__FLOAT = "// std/float: constants of f64. The functions are built into the compiler.\n\nexport const PI: f64 = 3.141592653589793\n"

const STD_EXT__INT = "// std/int: ordering and division of int. The rest of the functions are built into the compiler.\n\nexport function compare(first: int, second: int): Ordering {\n  if (first < second) {\n    return Ordering.Less\n  }\n  if (first > second) {\n    return Ordering.Greater\n  }\n  return Ordering.Equal\n}\n\nexport function divmod(dividend: int, divisor: int): Option<#[int, int]> {\n  // A zero divisor has no quotient.\n  if (divisor == 0) {\n    return None\n  }\n  return Some(#[dividend / divisor, dividend % divisor])\n}\n\nexport function floorDiv(dividend: int, divisor: int): Option<int> {\n  if (divisor == 0) {\n    return None\n  }\n  const quotient = dividend / divisor\n  const remainder = dividend % divisor\n  // Division truncates toward zero; step down when the signs differ and the division is inexact.\n  if (remainder != 0 && (remainder < 0) != (divisor < 0)) {\n    return Some(quotient - 1)\n  }\n  return Some(quotient)\n}\n"

const STD_EXT__STRING = "// std/string: searching. The rest of the functions are built into the compiler.\n\nimport * as Str from \"std/string\"\n\nexport function find(text: string, needle: string): Option<int> uses alloc {\n  return Str.indexOf(text, needle)\n}\n"

const STD_FIXEDARRAY = "// std/fixedarray: helpers over FixedArray. An index written as values[i] must be\n// proven in range; get checks the index and returns None outside it.\n\nexport function get<T, const N: int>(values: FixedArray<T, N>, index: int): Option<T> from values {\n  if (index >= 0 && index < N) {\n    return Some(values[index])\n  }\n  return None\n}\n\nexport function length<T, const N: int>(_values: FixedArray<T, N>): int {\n  return N\n}\n"

const STD_HASH = "// std/hash: hashing. `of` is the hash of a Hashable value and may change between builds.\n// `fnv1a` is FNV-1a 64 over the UTF-8 bytes of a string and never changes.\n\nimport * as Str from \"std/string\"\nimport * as U64 from \"std/u64\"\nimport * as Ranges from \"std/range\"\n\nconst FNV_OFFSET: u64 = 14695981039346656037\nconst FNV_PRIME: u64 = 1099511628211\n\nexport function of<T: Hashable>(value: T): int {\n  return Hashable.hash(value)\n}\n\nexport function fnv1a(text: string): u64 {\n  let state = FNV_OFFSET\n  const length = Str.length(text)\n  for (const index of Ranges.upTo(length)) {\n    state = (state ^ U64.wrap(Str.byteAt(text, index))) * FNV_PRIME\n  }\n  return state\n}\n"

const STD_JSON = "// std/json: parse and stringify JSON text (RFC 8259) as a Value of std/shape.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Char from \"std/char\"\nimport * as Float from \"std/float\"\nimport * as Arrays from \"std/array\"\nimport * as Maps from \"std/map\"\nimport * as FloatText from \"std/internal/float\"\nimport { Value, Shape } from \"std/shape\"\n\n// Containers nested deeper than this are an error, so the recursion is bounded.\nconst MAX_DEPTH = 512\n\nstruct Parser {\n  text: string\n  length: int\n  position: int\n}\n\n// parse reads one JSON value. Errors read `<line>:<column>: <reason>`.\nexport function parse(text: string): Result<Value, string> uses alloc {\n  let parser = Parser { text: text, length: Str.length(text), position: 0 }\n  skipSpace(mutable parser)\n  const value = parseValue(mutable parser, 0)\n  if (value is Err(message)) {\n    return Err(message)\n  }\n  skipSpace(mutable parser)\n  if (parser.position < parser.length) {\n    return fail(parser, parser.position, \"unexpected character after the value\")\n  }\n  return Ok(value.value)\n}\n\n// stringify writes a value as compact JSON text. A non-finite Float is null.\nexport function stringify(value: Value): string uses alloc {\n  let builder = Str.builder()\n  writeValue(mutable builder, value)\n  return Str.build(builder)\n}\n\n// fail builds the error for the byte at position, as line:column: reason.\nfunction fail<T>(parser: Parser, position: int, reason: string): Result<T, string> uses alloc {\n  let line = 1\n  let column = 1\n  let index = 0\n  while (index < position && index < parser.length) {\n    const byte = Str.byteAt(parser.text, index)\n    if (byte == 10) {\n      line += 1\n      column = 1\n    } else if (byte < 128 || byte >= 192) {\n      column += 1\n    }\n    index += 1\n  }\n  if (position >= parser.length) {\n    return Err(`\${Int.toString(line)}:\${Int.toString(column)}: unexpected end of input`)\n  }\n  return Err(`\${Int.toString(line)}:\${Int.toString(column)}: \${reason}`)\n}\n\nfunction cutText(text: string, start: int, end: int): string uses alloc {\n  if (Str.slice(text, start, end) is Some(piece)) {\n    return piece\n  }\n  panic(\"cutText: the range is outside the text\")\n}\n\nfunction skipSpace(mutable parser: Parser) {\n  while (parser.position < parser.length) {\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte != 32 && byte != 9 && byte != 10 && byte != 13) {\n      return\n    }\n    parser.position += 1\n  }\n}\n\nfunction parseValue(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (parser.position >= parser.length) {\n    return fail(parser, parser.position, \"expected a value\")\n  }\n  const byte = Str.byteAt(parser.text, parser.position)\n  if (byte == 123) {\n    return parseRecord(mutable parser, depth + 1)\n  }\n  if (byte == 91) {\n    return parseList(mutable parser, depth + 1)\n  }\n  if (byte == 34) {\n    const text = parseString(mutable parser)\n    if (text is Err(message)) {\n      return Err(message)\n    }\n    return Ok(Value.Text(text.value))\n  }\n  if (byte == 45 || (byte >= 48 && byte <= 57)) {\n    return parseNumber(mutable parser)\n  }\n  if (readWord(mutable parser, \"true\")) {\n    return Ok(Value.Bool(true))\n  }\n  if (readWord(mutable parser, \"false\")) {\n    return Ok(Value.Bool(false))\n  }\n  if (readWord(mutable parser, \"null\")) {\n    return Ok(Value.Null)\n  }\n  return fail(parser, parser.position, \"expected a value\")\n}\n\n// readWord consumes word when the text continues with it. It compares bytes,\n// because a slice of the text could end inside a multibyte character.\nfunction readWord(mutable parser: Parser, word: string): bool {\n  const count = Str.length(word)\n  if (parser.position + count > parser.length) {\n    return false\n  }\n  let index = 0\n  while (index < count) {\n    if (Str.byteAt(parser.text, parser.position + index) != Str.byteAt(word, index)) {\n      return false\n    }\n    index += 1\n  }\n  parser.position += count\n  return true\n}\n\nfunction parseList(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return fail(parser, parser.position, \"nesting is deeper than 512\")\n  }\n  // Skip the [.\n  parser.position += 1\n  let items: Array<Value> = []\n  skipSpace(mutable parser)\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 93) {\n    parser.position += 1\n    return Ok(Value.List(items))\n  }\n  while (true) {\n    skipSpace(mutable parser)\n    const item = parseValue(mutable parser, depth)\n    if (item is Err(message)) {\n      return Err(message)\n    }\n    Arrays.push(mutable items, item.value)\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"expected , or ]\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    parser.position += 1\n    if (byte == 93) {\n      return Ok(Value.List(items))\n    }\n    if (byte != 44) {\n      return fail(parser, parser.position - 1, \"expected , or ]\")\n    }\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\nfunction parseRecord(mutable parser: Parser, depth: int): Result<Value, string> uses alloc {\n  if (depth > MAX_DEPTH) {\n    return fail(parser, parser.position, \"nesting is deeper than 512\")\n  }\n  // Skip the {.\n  parser.position += 1\n  let fields: Map<string, Value> = Map {}\n  skipSpace(mutable parser)\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 125) {\n    parser.position += 1\n    return Ok(Value.Record(fields))\n  }\n  while (true) {\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length || Str.byteAt(parser.text, parser.position) != 34) {\n      return fail(parser, parser.position, \"expected a string key\")\n    }\n    const key = parseString(mutable parser)\n    if (key is Err(message)) {\n      return Err(message)\n    }\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length || Str.byteAt(parser.text, parser.position) != 58) {\n      return fail(parser, parser.position, \"expected :\")\n    }\n    parser.position += 1\n    skipSpace(mutable parser)\n    const field = parseValue(mutable parser, depth)\n    if (field is Err(message)) {\n      return Err(message)\n    }\n    // The last duplicate wins; an existing key keeps its place.\n    fields[key.value] = field.value\n    skipSpace(mutable parser)\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"expected , or }\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    parser.position += 1\n    if (byte == 125) {\n      return Ok(Value.Record(fields))\n    }\n    if (byte != 44) {\n      return fail(parser, parser.position - 1, \"expected , or }\")\n    }\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\nfunction isDigit(byte: int): bool {\n  return byte >= 48 && byte <= 57\n}\n\n// skipDigits moves past a run of digits and says how many there were.\nfunction skipDigits(mutable parser: Parser): int {\n  let count = 0\n  while (parser.position < parser.length && isDigit(Str.byteAt(parser.text, parser.position))) {\n    parser.position += 1\n    count += 1\n  }\n  return count\n}\n\nfunction parseNumber(mutable parser: Parser): Result<Value, string> uses alloc {\n  const start = parser.position\n  let isFloat = false\n  if (Str.byteAt(parser.text, parser.position) == 45) {\n    parser.position += 1\n  }\n  // Integer part: 0, or a nonzero digit and more digits.\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 48) {\n    parser.position += 1\n  } else if (skipDigits(mutable parser) == 0) {\n    return fail(parser, parser.position, \"invalid number\")\n  }\n  if (parser.position < parser.length && Str.byteAt(parser.text, parser.position) == 46) {\n    isFloat = true\n    parser.position += 1\n    if (skipDigits(mutable parser) == 0) {\n      return fail(parser, parser.position, \"invalid number\")\n    }\n  }\n  if (parser.position < parser.length) {\n    const marker = Str.byteAt(parser.text, parser.position)\n    if (marker == 101 || marker == 69) {\n      isFloat = true\n      parser.position += 1\n      if (parser.position < parser.length) {\n        const sign = Str.byteAt(parser.text, parser.position)\n        if (sign == 43 || sign == 45) {\n          parser.position += 1\n        }\n      }\n      if (skipDigits(mutable parser) == 0) {\n        return fail(parser, parser.position, \"invalid number\")\n      }\n    }\n  }\n  const digits = cutText(parser.text, start, parser.position)\n  if (!isFloat) {\n    // An integer outside int becomes a Float.\n    const whole = Int.parse(digits, 10)\n    if (whole is Ok(number)) {\n      return Ok(Value.Int(number))\n    }\n  }\n  return Ok(Value.Float(FloatText.parse(digits)))\n}\n\n// The value of a hexadecimal digit, or -1.\nfunction hexValue(byte: int): int {\n  if (byte >= 48 && byte <= 57) {\n    return byte - 48\n  }\n  if (byte >= 97 && byte <= 102) {\n    return byte - 87\n  }\n  if (byte >= 65 && byte <= 70) {\n    return byte - 55\n  }\n  return -1\n}\n\n// readHex4 reads the four hex digits at parser.position.\nfunction readHex4(mutable parser: Parser): Result<int, string> uses alloc {\n  let code = 0\n  let count = 0\n  while (count < 4) {\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const digit = hexValue(Str.byteAt(parser.text, parser.position))\n    if (digit < 0) {\n      return fail(parser, parser.position, \"invalid \\\\u escape\")\n    }\n    code = code * 16 + digit\n    parser.position += 1\n    count += 1\n  }\n  return Ok(code)\n}\n\n// parseString reads a string whose opening quote is at parser.position.\nfunction parseString(mutable parser: Parser): Result<string, string> uses alloc {\n  parser.position += 1\n  let builder = Str.builder()\n  // The start of the plain bytes not yet copied.\n  let runStart = parser.position\n  while (true) {\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const byte = Str.byteAt(parser.text, parser.position)\n    if (byte == 34) {\n      Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n      parser.position += 1\n      return Ok(Str.build(builder))\n    }\n    if (byte < 32) {\n      return fail(parser, parser.position, \"control character in string\")\n    }\n    if (byte != 92) {\n      parser.position += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(parser.text, runStart, parser.position))\n    parser.position += 1\n    if (parser.position >= parser.length) {\n      return fail(parser, parser.position, \"\")\n    }\n    const escape = Str.byteAt(parser.text, parser.position)\n    const escapeAt = parser.position - 1\n    parser.position += 1\n    if (escape == 117) {\n      const unit = readHex4(mutable parser)\n      if (unit is Err(message)) {\n        return Err(message)\n      }\n      const code = readCodePoint(mutable parser, unit.value, escapeAt)\n      if (code is Err(message)) {\n        return Err(message)\n      }\n      if (Char.fromCode(code.value) is Some(character)) {\n        Str.appendChar(mutable builder, character)\n      }\n    } else {\n      const simple = simpleEscape(escape)\n      if (simple == \"\") {\n        return fail(parser, escapeAt, \"invalid escape\")\n      }\n      Str.append(mutable builder, simple)\n    }\n    runStart = parser.position\n  }\n  return fail(parser, parser.position, \"unreachable\")\n}\n\n// The text for the escape letter after a backslash, or \"\".\nfunction simpleEscape(letter: int): string uses alloc {\n  if (letter == 34) {\n    return \"\\\"\"\n  }\n  if (letter == 92) {\n    return \"\\\\\"\n  }\n  if (letter == 47) {\n    return \"/\"\n  }\n  if (letter == 98) {\n    return controlText(8)\n  }\n  if (letter == 102) {\n    return controlText(12)\n  }\n  if (letter == 110) {\n    return \"\\n\"\n  }\n  if (letter == 114) {\n    return \"\\r\"\n  }\n  if (letter == 116) {\n    return \"\\t\"\n  }\n  return \"\"\n}\n\nfunction controlText(code: int): string uses alloc {\n  if (Char.fromCode(code) is Some(character)) {\n    return Str.fromChar(character)\n  }\n  return \"\"\n}\n\n// readCodePoint joins a surrogate pair; a lone surrogate is an error at escapeAt.\nfunction readCodePoint(\n  mutable parser: Parser,\n  unit: int,\n  escapeAt: int,\n): Result<int, string> uses alloc {\n  if (unit >= 56320 && unit <= 57343) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  if (unit < 55296 || unit > 56319) {\n    return Ok(unit)\n  }\n  // A high surrogate needs \\u and a low surrogate right after it.\n  if (!readWord(mutable parser, \"\\\\u\")) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  const low = readHex4(mutable parser)\n  if (low is Err(message)) {\n    return Err(message)\n  }\n  if (low.value < 56320 || low.value > 57343) {\n    return fail(parser, escapeAt, \"lone surrogate\")\n  }\n  return Ok(65536 + (unit - 55296) * 1024 + (low.value - 56320))\n}\n\nfunction writeValue(mutable builder: StringBuilder, value: Value) uses alloc {\n  match (value) {\n    Value.Null => Str.append(mutable builder, \"null\")\n    Value.Bool(flag) => {\n      if (flag) {\n        Str.append(mutable builder, \"true\")\n      } else {\n        Str.append(mutable builder, \"false\")\n      }\n    }\n    Value.Int(number) => Str.append(mutable builder, Int.toString(number))\n    Value.Float(number) => {\n      // NaN and infinities have no JSON form; JSON.stringify writes null.\n      if (number - number != 0.0) {\n        Str.append(mutable builder, \"null\")\n      } else {\n        Str.append(mutable builder, floatText(number))\n      }\n    }\n    Value.Text(text) => writeString(mutable builder, text)\n    Value.List(items) => {\n      Str.append(mutable builder, \"[\")\n      let first = true\n      for (const item of Arrays.values(items)) {\n        if (!first) {\n          Str.append(mutable builder, \",\")\n        }\n        first = false\n        writeValue(mutable builder, item)\n      }\n      Str.append(mutable builder, \"]\")\n    }\n    Value.Record(fields) => {\n      Str.append(mutable builder, \"{\")\n      let first = true\n      for (const entry of Maps.entries(fields)) {\n        const #[key, field] = entry\n        if (!first) {\n          Str.append(mutable builder, \",\")\n        }\n        first = false\n        writeString(mutable builder, key)\n        Str.append(mutable builder, \":\")\n        writeValue(mutable builder, field)\n      }\n      Str.append(mutable builder, \"}\")\n    }\n  }\n}\n\n// floatText writes a finite Float. A whole number below 1e15 reads as digits and\n// \".0\" (Float.toString would write 1e+02 for 100.0); the rest keeps its shortest text.\nfunction floatText(number: f64): string uses alloc {\n  if (number > -1000000000000000.0 && number < 1000000000000000.0) {\n    if (Float.truncate(number) is Some(whole)) {\n      if (Float.fromInt(whole) == number) {\n        return `\${Int.toString(whole)}.0`\n      }\n    }\n  }\n  return Float.toString(number)\n}\n\nfunction writeString(mutable builder: StringBuilder, text: string) uses alloc {\n  Str.append(mutable builder, \"\\\"\")\n  const length = Str.length(text)\n  // The start of the bytes that need no escape and are not yet copied.\n  let runStart = 0\n  let index = 0\n  while (index < length) {\n    const byte = Str.byteAt(text, index)\n    if (byte >= 32 && byte != 34 && byte != 92) {\n      index += 1\n      continue\n    }\n    Str.append(mutable builder, cutText(text, runStart, index))\n    Str.append(mutable builder, escapeByte(byte))\n    index += 1\n    runStart = index\n  }\n  Str.append(mutable builder, cutText(text, runStart, length))\n  Str.append(mutable builder, \"\\\"\")\n}\n\n// The JSON escape for a quote, a backslash or a control character.\nfunction escapeByte(byte: int): string uses alloc {\n  if (byte == 34) {\n    return \"\\\\\\\"\"\n  }\n  if (byte == 92) {\n    return \"\\\\\\\\\"\n  }\n  if (byte == 10) {\n    return \"\\\\n\"\n  }\n  if (byte == 13) {\n    return \"\\\\r\"\n  }\n  if (byte == 9) {\n    return \"\\\\t\"\n  }\n  if (byte == 8) {\n    return \"\\\\b\"\n  }\n  if (byte == 12) {\n    return \"\\\\f\"\n  }\n  const hex = Int.toHex(byte)\n  if (Str.repeat(\"0\", 4 - Str.length(hex)) is Some(padding)) {\n    return `\\\\u\${padding}\${hex}`\n  }\n  return `\\\\u\${hex}`\n}\n\n// encode writes any value that implements Shape as compact JSON text.\nexport function encode<T: Shape>(value: T): string uses alloc {\n  return stringify(Shape.toValue(value))\n}\n\n// decode reads JSON text as a T: `Json.decode<User>(text)`. A parse error is\n// passed through; a shape error reads `<path>: <reason>` (see std/shape).\nexport function decode<T: Shape>(text: string): Result<T, string> uses alloc {\n  const value = parse(text)\n  if (value is Err(message)) {\n    return Err(message)\n  }\n  return Shape.fromValue<T>(value.value)\n}\n"

const STD_MATH = "// std/math: the usual number functions. The float functions are the ones of C's math.h.\n\nimport * as Float from \"std/float\"\nimport * as Libm from \"std/internal/math\"\n\nexport const PI: f64 = 3.141592653589793\nexport const E: f64 = 2.718281828459045\n\nexport function abs(value: int): int {\n  if (value < 0) {\n    return 0 - value\n  }\n  return value\n}\n\nexport function absFloat(value: f64): f64 {\n  if (value < 0.0) {\n    return 0.0 - value\n  }\n  return value\n}\n\nexport function min<T: Ordered>(first: T, second: T): T from first {\n  return match (Ordered.compare(second, first)) { Ordering.Less => copy(second), _ => first }\n}\n\nexport function max<T: Ordered>(first: T, second: T): T from first {\n  return match (Ordered.compare(second, first)) { Ordering.Greater => copy(second), _ => first }\n}\n\nexport function clamp<T: Ordered>(value: T, low: T, high: T): Option<T> from value {\n  if (Ordered.compare(low, high) is Ordering.Greater) {\n    return None\n  }\n  return Some(min(max(value, low), high))\n}\n\nexport function pow(base: f64, exponent: f64): f64 {\n  return Libm.pow(base, exponent)\n}\n\nexport function powInt(base: int, exponent: int): Option<int> {\n  if (exponent < 0) {\n    return None\n  }\n  let result = 1\n  let factor = base\n  let remaining = exponent\n  while (remaining > 0) {\n    if (remaining % 2 == 1) {\n      result *= factor\n    }\n    remaining /= 2\n    if (remaining > 0) {\n      factor *= factor\n    }\n  }\n  return Some(result)\n}\n\nexport function sqrt(value: f64): f64 {\n  return Float.sqrt(value)\n}\n\nexport function floor(value: f64): f64 {\n  return Libm.floor(value)\n}\n\nexport function ceil(value: f64): f64 {\n  return Libm.ceil(value)\n}\n\nexport function round(value: f64): f64 {\n  return Libm.round(value)\n}\n\nexport function trunc(value: f64): f64 {\n  return Libm.trunc(value)\n}\n\nexport function sin(value: f64): f64 {\n  return Libm.sin(value)\n}\n\nexport function cos(value: f64): f64 {\n  return Libm.cos(value)\n}\n\nexport function tan(value: f64): f64 {\n  return Libm.tan(value)\n}\n\nexport function atan2(y: f64, x: f64): f64 {\n  return Libm.atan2(y, x)\n}\n\nexport function exp(value: f64): f64 {\n  return Libm.exp(value)\n}\n\nexport function log(value: f64): f64 {\n  return Libm.log(value)\n}\n"

const STD_OPTION = "// std/option: helpers over the prelude Option.\n\n@inline\nexport function map<T, U, effect E>(\n  option: Option<T>,\n  f: (value: T) => U uses E\n): Option<U> uses alloc, E {\n  return match (option) { Some(value) => Some(f(value)), None => None }\n}\n\n@inline\nexport function andThen<T, U, effect E>(\n  option: Option<T>,\n  f: (value: T) => Option<U> uses E\n): Option<U> uses E {\n  return match (option) { Some(value) => f(value), None => None }\n}\n\nexport function withDefault<T>(option: Option<T>, fallback: T): T from option {\n  return match (option) { Some(value) => value, None => copy(fallback) }\n}\n\n@inline\nexport function orElse<T, effect E>(\n  option: Option<T>,\n  f: () => Option<T> uses E\n): Option<T> from option uses E {\n  return match (option) { Some(_) => option, None => f() }\n}\n\nexport function isSome<T>(option: Option<T>): bool {\n  return option is Some(_)\n}\n\nexport function isNone<T>(option: Option<T>): bool {\n  return option is None\n}\n\nexport function okOr<T, F>(option: Option<T>, error: F): Result<T, F> from option uses alloc {\n  return match (option) { Some(value) => Ok(value), None => Err(copy(error)) }\n}\n"

const STD_RANDOM = "// std/random: a seeded generator, SplitMix64. The same seed gives the same numbers on every\n// run and every platform. It is fast and small and it is not for cryptography.\n\nimport * as Arrays from \"std/array\"\nimport * as Int from \"std/int\"\nimport * as Ranges from \"std/range\"\nimport * as U64 from \"std/u64\"\nimport * as Float from \"std/float\"\nimport * as Entropy from \"std/internal/entropy\"\n\nexport struct Random {\n  state: u64\n}\n\nexport function seeded(seed: int): Random {\n  return Random { state: U64.wrap(seed) }\n}\n\nexport function fromSystem(): Random uses io {\n  return seeded(Entropy.seed())\n}\n\nexport function nextBits(mutable random: Random): u64 {\n  random.state += 0x9E3779B97F4A7C15\n  let mixed = random.state\n  mixed = (mixed ^ (mixed >> 30)) * 0xBF58476D1CE4E5B9\n  mixed = (mixed ^ (mixed >> 27)) * 0x94D049BB133111EB\n  return mixed ^ (mixed >> 31)\n}\n\nexport function nextInt(mutable random: Random, low: int, high: int): Option<int> {\n  if (low >= high) {\n    return None\n  }\n  const span = U64.wrap(high) - U64.wrap(low)\n  if (span == 0) {\n    return Some(low)\n  }\n  const limit = (0 - span) % span\n  let bits = nextBits(mutable random)\n  while (bits < limit) {\n    bits = nextBits(mutable random)\n  }\n  return Some(Int.wrap(U64.wrap(low) + bits % span))\n}\n\nexport function nextFloat(mutable random: Random): f64 {\n  const bits = nextBits(mutable random) >> 11\n  return Float.from(bits) / 9007199254740992.0\n}\n\nexport function shuffle<T>(mutable random: Random, mutable items: Array<T>) {\n  const length = Arrays.length(items)\n  for (const step of Ranges.upTo(length - 1)) {\n    const position = length - 1 - step\n    if (nextInt(mutable random, 0, position + 1) is Some(other)) {\n      const held = items[position]\n      items[position] = items[other]\n      items[other] = held\n    }\n  }\n}\n"

const STD_SHAPE = "// std/shape: Value, a dynamic tree for structured data, and the Shape trait.\n//\n// Formats such as std/json read and write Value. Int and Float are separate\n// because a 64-bit integer must survive a round trip, which an f64 cannot hold.\n// Record keeps its fields in insertion order.\n//\n// Shape converts a type to and from Value. The compiler provides it for bool,\n// int, f64, char, string, Array<T>, Map<string, V>, Option<T> and tuples of two\n// to four items, when their contents implement it: a call of Shape.toValue or\n// Shape.fromValue on such a type runs the matching private function\n// below. Value, a struct and an enum implement it with an `implement` block.\n//\n// A decode error reads `<path>: <reason>` with the path from the root\n// (`.users[2].age: expected int, found Text`); at the root it is the reason alone.\n\nimport * as Str from \"std/string\"\nimport * as Int from \"std/int\"\nimport * as Float from \"std/float\"\nimport * as Arrays from \"std/array\"\nimport * as Maps from \"std/map\"\n\nexport enum Value implements Shape {\n  Null\n  Bool(value: bool)\n  Int(value: int)\n  Float(value: f64)\n  Text(value: string)\n  List(items: Array<Value>)\n  Record(fields: Map<string, Value>)\n}\n\nexport trait Shape {\n  function toValue(value: Self): Value from value uses alloc\n  function fromValue(value: Value): Result<Self, string> from value uses alloc\n}\n\nimplement Shape for Value {\n  function toValue(value: Value): Value from value uses alloc {\n    return value\n  }\n\n  function fromValue(value: Value): Result<Value, string> from value uses alloc {\n    return Ok(value)\n  }\n}\n\n// The name of a Value variant, for error messages.\nfunction kindName(value: Value): string {\n  return match (value) {\n    Value.Null => \"Null\"\n    Value.Bool(_) => \"Bool\"\n    Value.Int(_) => \"Int\"\n    Value.Float(_) => \"Float\"\n    Value.Text(_) => \"Text\"\n    Value.List(_) => \"List\"\n    Value.Record(_) => \"Record\"\n  }\n}\n\nfunction mismatch(expected: string, value: Value): string uses alloc {\n  return `expected \${expected}, found \${kindName(value)}`\n}\n\n// prefixPath puts a path segment (`.name` or `[2]`) in front of a child error.\n// A child error that already starts with a path keeps it after the segment.\nfunction prefixPath(segment: string, message: string): string uses alloc {\n  if (Str.startsWith(message, \".\") || Str.startsWith(message, \"[\")) {\n    return `\${segment}\${message}`\n  }\n  return `\${segment}: \${message}`\n}\n\nfunction boolToValue(value: bool): Value {\n  return Value.Bool(value)\n}\n\nfunction boolFromValue(value: Value): Result<bool, string> uses alloc {\n  if (value is Value.Bool(flag)) {\n    return Ok(flag)\n  }\n  return Err(mismatch(\"bool\", value))\n}\n\nfunction intToValue(value: int): Value {\n  return Value.Int(value)\n}\n\nfunction intFromValue(value: Value): Result<int, string> uses alloc {\n  if (value is Value.Int(number)) {\n    return Ok(number)\n  }\n  return Err(mismatch(\"int\", value))\n}\n\nfunction floatToValue(value: f64): Value {\n  return Value.Float(value)\n}\n\nfunction floatFromValue(value: Value): Result<f64, string> uses alloc {\n  if (value is Value.Float(number)) {\n    return Ok(number)\n  }\n  if (value is Value.Int(whole)) {\n    return Ok(Float.fromInt(whole))\n  }\n  return Err(mismatch(\"f64\", value))\n}\n\nfunction charToValue(value: char): Value uses alloc {\n  return Value.Text(Str.fromChar(value))\n}\n\nfunction charFromValue(value: Value): Result<char, string> uses alloc {\n  if (value is Value.Text(text)) {\n    if (Str.charCount(text) == 1) {\n      return Ok(Str.charAt(text, 0))\n    }\n    return Err(\"expected one character, found Text of a different length\")\n  }\n  return Err(mismatch(\"char\", value))\n}\n\nfunction stringToValue(value: string): Value {\n  return Value.Text(value)\n}\n\nfunction stringFromValue(value: Value): Result<string, string> uses alloc {\n  if (value is Value.Text(text)) {\n    return Ok(text)\n  }\n  return Err(mismatch(\"string\", value))\n}\n\nfunction arrayToValue<T: Shape>(value: Array<T>): Value from value uses alloc {\n  let items: Array<Value> = []\n  for (const item of Arrays.values(value)) {\n    Arrays.push(mutable items, Shape.toValue(item))\n  }\n  return Value.List(items)\n}\n\nfunction arrayFromValue<T: Shape>(value: Value): Result<Array<T>, string> uses alloc {\n  if (value is Value.List(items)) {\n    let out: Array<T> = []\n    for (const #[index, item] of Arrays.entries(items)) {\n      const decoded = Shape.fromValue<T>(item)\n      if (decoded is Err(message)) {\n        return Err(prefixPath(`[\${Int.toString(index)}]`, message))\n      }\n      Arrays.push(mutable out, decoded.value)\n    }\n    return Ok(out)\n  }\n  return Err(mismatch(\"List\", value))\n}\n\nfunction mapToValue<V: Shape>(value: Map<string, V>): Value from value uses alloc {\n  let fields: Map<string, Value> = Map {}\n  for (const entry of Maps.entries(value)) {\n    const #[key, field] = entry\n    fields[key] = Shape.toValue(field)\n  }\n  return Value.Record(fields)\n}\n\nfunction mapFromValue<V: Shape>(value: Value): Result<Map<string, V>, string> uses alloc {\n  if (value is Value.Record(fields)) {\n    let out: Map<string, V> = Map {}\n    for (const entry of Maps.entries(fields)) {\n      const #[key, field] = entry\n      const decoded = Shape.fromValue<V>(field)\n      if (decoded is Err(message)) {\n        return Err(prefixPath(`.\${key}`, message))\n      }\n      out[key] = decoded.value\n    }\n    return Ok(out)\n  }\n  return Err(mismatch(\"Record\", value))\n}\n\nfunction optionToValue<T: Shape>(value: Option<T>): Value from value uses alloc {\n  if (value is Some(inner)) {\n    return Shape.toValue(inner)\n  }\n  return Value.Null\n}\n\nfunction optionFromValue<T: Shape>(value: Value): Result<Option<T>, string> from value uses alloc {\n  if (value is Value.Null) {\n    return Ok(None)\n  }\n  const decoded = Shape.fromValue<T>(value)\n  if (decoded is Err(message)) {\n    return Err(message)\n  }\n  return Ok(Some(decoded.value))\n}\n\n// A tuple is a List of exactly count items.\nfunction tupleItems(value: Value, count: int): Result<Array<Value>, string> from value uses alloc {\n  if (value is Value.List(items)) {\n    if (Arrays.length(items) != count) {\n      const found = Int.toString(Arrays.length(items))\n      return Err(`expected a List of \${Int.toString(count)} items, found \${found}`)\n    }\n    return Ok(items)\n  }\n  return Err(mismatch(\"List\", value))\n}\n\nfunction tuple2ToValue<A: Shape, B: Shape>(value: #[A, B]): Value from value uses alloc {\n  const #[first, second] = value\n  return Value.List([Shape.toValue(first), Shape.toValue(second)])\n}\n\nfunction tuple2FromValue<A: Shape, B: Shape>(value: Value): Result<#[\n  A,\n  B,\n], string> from value uses alloc {\n  const items = tupleItems(value, 2)\n  if (items is Err(problem)) {\n    return Err(problem)\n  }\n  const first = Shape.fromValue<A>(items.value[0])\n  if (first is Err(message)) {\n    return Err(prefixPath(\"[0]\", message))\n  }\n  const second = Shape.fromValue<B>(items.value[1])\n  if (second is Err(message)) {\n    return Err(prefixPath(\"[1]\", message))\n  }\n  return Ok(#[first.value, second.value])\n}\n\nfunction tuple3ToValue<A: Shape, B: Shape, C: Shape>(\n  value: #[A, B, C],\n): Value from value uses alloc {\n  const #[first, second, third] = value\n  return Value.List([Shape.toValue(first), Shape.toValue(second), Shape.toValue(third)])\n}\n\nfunction tuple3FromValue<A: Shape, B: Shape, C: Shape>(value: Value): Result<#[\n  A,\n  B,\n  C,\n], string> from value uses alloc {\n  const items = tupleItems(value, 3)\n  if (items is Err(problem)) {\n    return Err(problem)\n  }\n  const first = Shape.fromValue<A>(items.value[0])\n  if (first is Err(message)) {\n    return Err(prefixPath(\"[0]\", message))\n  }\n  const second = Shape.fromValue<B>(items.value[1])\n  if (second is Err(message)) {\n    return Err(prefixPath(\"[1]\", message))\n  }\n  const third = Shape.fromValue<C>(items.value[2])\n  if (third is Err(message)) {\n    return Err(prefixPath(\"[2]\", message))\n  }\n  return Ok(#[first.value, second.value, third.value])\n}\n\nfunction tuple4ToValue<A: Shape, B: Shape, C: Shape, D: Shape>(\n  value: #[A, B, C, D],\n): Value from value uses alloc {\n  const #[first, second, third, fourth] = value\n  return Value.List([\n    Shape.toValue(first),\n    Shape.toValue(second),\n    Shape.toValue(third),\n    Shape.toValue(fourth),\n  ])\n}\n\nfunction tuple4FromValue<A: Shape, B: Shape, C: Shape, D: Shape>(value: Value): Result<#[\n  A,\n  B,\n  C,\n  D,\n], string> from value uses alloc {\n  const items = tupleItems(value, 4)\n  if (items is Err(problem)) {\n    return Err(problem)\n  }\n  const first = Shape.fromValue<A>(items.value[0])\n  if (first is Err(message)) {\n    return Err(prefixPath(\"[0]\", message))\n  }\n  const second = Shape.fromValue<B>(items.value[1])\n  if (second is Err(message)) {\n    return Err(prefixPath(\"[1]\", message))\n  }\n  const third = Shape.fromValue<C>(items.value[2])\n  if (third is Err(message)) {\n    return Err(prefixPath(\"[2]\", message))\n  }\n  const fourth = Shape.fromValue<D>(items.value[3])\n  if (fourth is Err(message)) {\n    return Err(prefixPath(\"[3]\", message))\n  }\n  return Ok(#[first.value, second.value, third.value, fourth.value])\n}\n"

const STD_TIME = "// std/time: a monotonic clock for measuring, the wall clock, and sleep. Reading a clock or sleeping is `io`.\n\nimport * as Clock from \"std/internal/clock\"\n\nexport struct Instant {\n  nanos: int\n}\n\nexport struct Duration {\n  nanos: int\n}\n\nexport function now(): Instant uses io {\n  return Instant { nanos: Clock.monotonicNanos() }\n}\n\nexport function elapsed(since: Instant): Duration uses io {\n  return Duration { nanos: Clock.monotonicNanos() - since.nanos }\n}\n\nexport function between(earlier: Instant, later: Instant): Duration {\n  return Duration { nanos: later.nanos - earlier.nanos }\n}\n\nexport function unixMillis(): int uses io {\n  return Clock.wallMillis()\n}\n\nexport function sleep(duration: Duration) uses io {\n  Clock.sleepNanos(duration.nanos)\n}\n\nexport function nanoseconds(count: int): Duration {\n  return Duration { nanos: count }\n}\n\nexport function milliseconds(count: int): Duration {\n  return Duration { nanos: count * 1000000 }\n}\n\nexport function seconds(count: int): Duration {\n  return Duration { nanos: count * 1000000000 }\n}\n\nexport function asNanoseconds(duration: Duration): int {\n  return duration.nanos\n}\n\nexport function asMilliseconds(duration: Duration): int {\n  return duration.nanos / 1000000\n}\n"

export function stdSourceFor(path: string): string {
  if (path == "std/build") {
    return STD_BUILD
  }
  if (path == "std/cell") {
    return STD_CELL
  }
  if (path == "std/coroutine") {
    return STD_COROUTINE
  }
  if (path == "std/cstring") {
    return STD_CSTRING
  }
  if (path == "std/ext/array") {
    return STD_EXT__ARRAY
  }
  if (path == "std/ext/float") {
    return STD_EXT__FLOAT
  }
  if (path == "std/ext/int") {
    return STD_EXT__INT
  }
  if (path == "std/ext/string") {
    return STD_EXT__STRING
  }
  if (path == "std/fixedarray") {
    return STD_FIXEDARRAY
  }
  if (path == "std/hash") {
    return STD_HASH
  }
  if (path == "std/json") {
    return STD_JSON
  }
  if (path == "std/math") {
    return STD_MATH
  }
  if (path == "std/option") {
    return STD_OPTION
  }
  if (path == "std/random") {
    return STD_RANDOM
  }
  if (path == "std/shape") {
    return STD_SHAPE
  }
  if (path == "std/time") {
    return STD_TIME
  }
  return ""
}
