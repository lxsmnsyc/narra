// The registry rows and emitters of std/path.
import { StdFunc } from "narrac/std/builtins"
import { Pos, Arg } from "narrac/syntax/ast"
import { Emitter, Code, EmitWalker, reportUnsupported } from "narrac/emit/emitstate"
import { NODE, FixedCall, plain, owned, emitFixedCall } from "narrac/std/stdemithelp"
import * as Arrays from "std/array"

export const PATH_FUNCS: Array<StdFunc> = [
  StdFunc {
    name: "Path.basename",
    module: "std/path",
    key: "basename",
    parameters: ["string"],
    parameterNames: ["path"],
    result: "string",
    effects: ["alloc"],
    doc: "Gives the last part of the path, ignoring trailing separators. The root `/` gives `\"\"`.",
  },
  StdFunc {
    name: "Path.dirname",
    module: "std/path",
    key: "dirname",
    parameters: ["string"],
    parameterNames: ["path"],
    result: "string",
    effects: ["alloc"],
    doc: "Gives the path without its last part, or `.` when it has only one part.",
  },
  StdFunc {
    name: "Path.extname",
    module: "std/path",
    key: "extname",
    parameters: ["string"],
    parameterNames: ["path"],
    result: "string",
    effects: ["alloc"],
    doc: "Gives the last part's extension from its last dot, such as `.txt`, or `\"\"` when it has none. A name whose only dot is its first character, such as `.profile`, has none.",
  },
  StdFunc {
    name: "Path.join",
    module: "std/path",
    key: "join",
    parameters: ["string", "string"],
    parameterNames: ["first", "second"],
    result: "string",
    effects: ["alloc"],
    doc: "Joins two paths with `/` and normalizes the result, removing `.` parts and resolving `..`. An absolute `second` is still added after `first`, not used alone.",
  },
]

const PATH_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Path.join",
    call: "narra_path_join",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Path.dirname",
    call: "narra_path_dirname",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Path.basename",
    call: "narra_path_basename",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Path.extname",
    call: "narra_path_extname",
    withPos: false,
    owned: true,
    temporary: false,
  },
]

export function emitPathCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  for (const fixed of Arrays.values(PATH_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }

  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
