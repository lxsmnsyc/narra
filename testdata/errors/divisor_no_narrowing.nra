// error: divisor_no_narrowing.nra:4:20: the divisor must be a non-zero constant or a name checked against zero first; check the name first, as in `if (d != 0) { ... }`
function share(total: int, count: int): int {
  if (count >= 0) {
    return total % count
  }
  return 0
}

export function run(args: Array<string>): int {
  return share(10, 2)
}
