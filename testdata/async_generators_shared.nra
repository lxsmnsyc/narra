// Copies of a stream share one body and one position: reading through one
// copy moves the other too. Two steps asked at once are served in the order
// they were asked for, whichever is awaited first.
import * as Async from "std/async"
import * as Time from "std/time"
import { sleep } from "std/async/time"

async function* letters(): AsyncGenerator<string> uses io, alloc {
  for (const letter of ["a", "b", "c", "d"]) {
    const slept = await sleep(Time.milliseconds(1))
    if (slept is Err(_)) {
      return
    }
    yield letter
  }
}

function show(value: Option<string>): string uses alloc {
  if (value is Some(text)) {
    return text
  }
  return "None"
}

export async function run(_args: Array<string>): int {
  const stream = letters()
  const other = stream
  print(`stream: ${show(await Async.next(stream))}`)
  print(`other: ${show(await Async.next(other))}`)
  const first = Async.next(stream)
  const second = Async.next(other)
  print(`second asked: ${show(await second)}`)
  print(`first asked: ${show(await first)}`)
  print(`after the end: ${show(await Async.next(stream))}`)
  return 0
}
