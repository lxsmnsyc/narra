function f(x: int, y: int) {
  if (x) {
    print("a")
  } // after then
  else {
    print("b")
  }
  if (y) /* c */ {
    print("c")
  }
  if (x) {
    print("d")
  }
  // before else
  else {
    print("e")
  }
  if (x) {
    print("f")
  }
  // before else if
  else if (y) {
    print("g")
  }
  // before the last else
  else {
    print("h")
  }
}
