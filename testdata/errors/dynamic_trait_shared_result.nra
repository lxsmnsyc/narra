// error: write `from item` after the result type
import * as Arrays from "std/array"

trait Items {
  function items(value: Self): Array<int> from value
}

struct Bag implements Items {
  values: Array<int>
}

implement Items for Bag {
  function items(value: Bag): Array<int> from value {
    return value.values
  }
}

function leak(item: Dynamic<Items>): Array<int> {
  return Items.items(item)
}

export function run(_args: Array<string>): int {
  const item: Dynamic<Items> = Dynamic.of(Bag { values: [1, 2] })
  return Arrays.length(leak(item))
}
