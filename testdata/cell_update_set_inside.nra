// Cells.set on the same cell inside the change of Cells.update. The update holds the old
// value, so change still reads it after the set, and the result of change wins.
import * as Cells from "std/cell"

function make(number: int): string uses alloc {
  return `value-${Show.show(number)}`
}

export function run(args: Array<string>): int uses io, alloc {
  const cell = Cells.create(make(1))
  Cells.update(cell, (value: string): string => {
    Cells.set(cell, make(2))
    return `${value}+`
  })
  print(Cells.get(cell))
  return 0
}
