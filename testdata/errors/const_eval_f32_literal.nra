// error: E1052, an f32 literal that rounds differently through f64
import * as Float from "std/float"

@const
function single(): f32 {
  const value: f32 = 2186507398728909.0e1
  return value
}

function singleAtRunTime(): f32 {
  const value: f32 = 2186507398728909.0e1
  return value
}

const SINGLE = single()

export function run(args: Array<string>): int uses io, alloc {
  print(Float.toString(Float.from(SINGLE)))
  print(Float.toString(Float.from(single())))
  print(Float.toString(Float.from(singleAtRunTime())))
  return 0
}
