<script>
  import Meta from '../components/Meta.brm';
  import Icon from '../components/Icon.brm';
  import InstallCommand from '../components/InstallCommand.brm';
  import addError from '../home/add-error.md';
  import addFixed from '../home/add-fixed.md';
  import valuesTypescript from '../home/values-typescript.md';
  import valuesNarra from '../home/values-narra.md';
  import effects from '../home/effects.md';
  import ToolDemo from '../components/ToolDemo.brm';
  import BenchChart from '../components/BenchChart.brm';
  import { markHeroCode, startHeroDemo } from '../home/hero-demo.ts';
  import { startBenchReveal } from '../home/bench-reveal.ts';
  import { chapters } from '../pages.ts';
  import { $client } from 'brumate/signals';
  import { raw, rawHTML } from 'brumate/html';
  import type { Raw } from 'brumate/html';
  import { startTwoslash } from '../twoslash/client.ts';

  // The hero shows the program of the aliasing section, with its changed line marked for the demo.
  const heroCode = raw(markHeroCode(rawHTML(valuesNarra.html as Raw)));

  $client(() => {
    startTwoslash();
    startHeroDemo();
    startBenchReveal();
  }, 'idle');
</script>

<Meta
  title="Narra"
  description="Easy to read, hard to break. Narra is a compiled language built so you, your team and your tools can understand any piece of code at a glance."
  path=""
/>
<main class="home">
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-title">Easy to read, <em>hard</em> to break.</h1>
      <p class="lead">
        Narra is a compiled language built so you, your team and your tools can understand any piece of code at a glance.
      </p>
      <InstallCommand />
      <p class="hero-note">Needs a C compiler: <code>cc</code>, <code>clang</code> or <code>gcc</code>.</p>
      <div class="actions">
        <a class="button primary" href="/guide/01-getting-started">
          Start the guide
          <span class="button-icon"><Icon name="arrow-right" size=(16) /></span>
        </a>
        <a class="button quiet" href="/spec">Read the spec</a>
      </div>
    </div>
    <figure class="hero-code">
      <div class="window hero-demo" data-step="run">
        <div class="window-bar">
          <span class="window-title">alias.nra</span>
          <span class="hd-fix" aria-hidden="true"><Icon name="wrench" size=(14) />narrac apply-fix</span>
        </div>
        <div class="hd-code">
          {heroCode}
          <span class="hd-squiggle" aria-hidden="true">hero</span>
          <span class="tw-diag hd-diag" aria-hidden="true">saved would be a second name for the struct in hero; use hero, or copy(hero) for a struct of its own</span>
        </div>
        <pre class="hd-run"><span class="hd-run-line hd-run-command"><span class="terminal-prompt">$</span> narrac run alias.nra</span><span class="hd-run-line">70 100</span></pre>
      </div>
    </figure>
  </section>

  <section class="section" aria-labelledby="read">
    <header class="section-head">
      <p class="section-index">01</p>
      <h2 id="read">Every line does what it says.</h2>
      <p>A <code>+</code> adds numbers and never calls a function you wrote. Adding two prices is a call you can see and follow.</p>
    </header>
    <div class="compare">
      <figure class="compare-pane">
        <figcaption><span class="compare-lang">Narra stops this</span><span class="compare-file">money.nra</span></figcaption>
        {addError.html}
      </figure>
      <figure class="compare-pane">
        <figcaption><span class="compare-lang">You write this</span><span class="compare-file">money.nra</span></figcaption>
        {addFixed.html}
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="values">
    <header class="section-head">
      <p class="section-index">02</p>
      <h2 id="values">Change one thing without breaking another.</h2>
      <p>In TypeScript both names change. In Narra, <code>saved</code> keeps its value.</p>
    </header>
    <div class="compare">
      <figure class="compare-pane">
        <figcaption><span class="compare-lang">TypeScript</span><span class="compare-file">alias.ts</span></figcaption>
        {valuesTypescript.html}
        <div class="compare-output"><span class="compare-label">prints</span><code>70 <mark class="bad">70</mark></code></div>
      </figure>
      <figure class="compare-pane">
        <figcaption><span class="compare-lang">Narra</span><span class="compare-file">alias.nra</span></figcaption>
        {valuesNarra.html}
        <div class="compare-output"><span class="compare-label">prints</span><code>70 <mark class="good">100</mark></code></div>
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="speed">
    <header class="section-head">
      <p class="section-index">03</p>
      <h2 id="speed">Close to C speed, without freeing memory by hand.</h2>
      <p>Narra runs within 3% of C on three of seven programs, faster on two and slower on two. Rust and Zig win some too.</p>
    </header>
    <BenchChart />
  </section>

  <section class="section" aria-labelledby="effects">
    <header class="section-head">
      <p class="section-index">04</p>
      <h2 id="effects">See what a function touches before you call it.</h2>
      <p>Every public function says whether it reads files, talks to the network or uses extra memory. You can tell which parts of a library only compute without opening them.</p>
    </header>
    <div class="effects">
      <figure class="window">
        <div class="window-bar">
          <span class="window-dots" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="window-title">shop.nra</span>
        </div>
        {effects.html}
      </figure>
      <ul class="effects-list">
        <li><code>total</code><span>only computes: same input, same result</span></li>
        <li><code>receipt</code><span><b>alloc</b>: builds a new string</span></li>
        <li><code>save</code><span><b>io</b>, <b>alloc</b>: writes a file</span></li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="tools">
    <header class="section-head">
      <p class="section-index">05</p>
      <h2 id="tools">Errors that tell you how to fix them.</h2>
      <p>When something's wrong, Narra says what and where, and for many mistakes it shows the exact fix. Your editor and your AI assistant get the same help, so they can fix it too.</p>
    </header>
    <ToolDemo />
  </section>

  <section class="section" aria-labelledby="ship">
    <header class="section-head">
      <p class="section-index">06</p>
      <h2 id="ship">One small file you can hand to anyone.</h2>
      <p>Narra builds your code into a single native file. A hello world is 34 KB. Copy it to another machine and run it, with no runtime to set up first.</p>
    </header>
    <div class="terminal ship-terminal">
      <div class="terminal-bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <pre class="terminal-screen"><span class="terminal-line terminal-command"><span class="terminal-prompt">$</span> narrac build -release -o hello hello.nra</span><span class="terminal-line terminal-command"><span class="terminal-prompt">$</span> ./hello</span><span class="terminal-line">hello</span><span class="terminal-line terminal-command"><span class="terminal-prompt">$</span> wc -c &lt; hello</span><span class="terminal-line">   34048</span></pre>
    </div>
  </section>

  <section class="section" aria-labelledby="learn">
    <header class="section-head">
      <p class="section-index">07</p>
      <h2 id="learn">Learn it one step at a time.</h2>
      <p>The guide starts with your first program and adds one idea per chapter.</p>
    </header>
    <ol class="chapters">
      #for (chapter, index of chapters by chapter.slug) {
        <li style=(`--item: ${index}`)>
          <a href=(`/guide/${chapter.slug}`)>
            <span class="chapter-number">{String(index + 1).padStart(2, '0')}</span>
            <span class="chapter-title">{chapter.title.replace(/^\d+\.\s*/, '')}</span>
            <span class="chapter-arrow"><Icon name="arrow-right" size=(18) /></span>
          </a>
        </li>
      }
    </ol>
  </section>
</main>
