// error: Function `report` uses `alloc` but its signature does not declare it; write `uses alloc`
import * as Int from "std/int"

function describe(count: int): string uses alloc {
  return `n=${Int.toString(count)}`
}

const shown = describe

export function report(): int uses io {
  print(shown(3))
  return 0
}

export function run(args: Array<string>): int uses io, alloc {
  return report()
}
