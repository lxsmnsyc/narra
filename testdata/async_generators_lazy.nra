// A call of an async generator runs nothing of its body: a stream nobody
// reads prints nothing. Async.next runs the body inline up to its first yield,
// and the next step runs it from there to the second.
import * as Async from "std/async"
import * as Int from "std/int"

async function* noisy(label: string): AsyncGenerator<int> {
  print(`${label} starts`)
  yield 1
  print(`${label} goes on`)
  yield 2
  print(`${label} ends`)
}

function show(value: Option<int>): string uses alloc {
  if (value is Some(number)) {
    return `Some(${Int.toString(number)})`
  }
  return "None"
}

export async function run(_args: Array<string>): int {
  const unread = noisy("unread")
  const read = noisy("read")
  print("made both")
  const first = Async.next(read)
  if (Async.peek(first) is Some(value)) {
    print(`first step has finished: ${show(value)}`)
  }
  const second = Async.next(read)
  print(`second step: ${show(await second)}`)
  const third = Async.next(read)
  print(`third step: ${show(await third)}`)
  // A stream may be read at last, long after it was made.
  print(`unread at last: ${show(await Async.next(unread))}`)
  return 0
}
