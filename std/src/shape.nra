// std/shape: Value, a dynamic tree for structured data.
//
// Formats such as std/json read and write it. Int and Float are separate
// because a 64-bit integer must survive a round trip, which an f64 cannot hold.
// Record keeps its fields in insertion order (D64).

export enum Value {
  Null
  Bool(value: bool)
  Int(value: int)
  Float(value: f64)
  Text(value: string)
  List(items: Array<Value>)
  Record(fields: Map<string, Value>)
}
