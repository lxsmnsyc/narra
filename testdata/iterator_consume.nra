// An operator takes its source by value: take(lines, 2) runs on its own copy,
// so a loop over lines starts from the first line again and redoes its work.
// Co.resume(mutable lines) moves lines itself, and the next resume goes on
// from where the last one stopped.
import * as Iterators from "std/iterator"
import * as Co from "std/coroutine"
import { Step } from "std/coroutine"

function* readLines(): Generator<string> uses io, alloc {
  for (const line of ["alpha", "beta", "gamma", "delta"]) {
    print(`  (read ${line})`)
    yield line
  }
}

function resumeOnce(label: string, mutable lines: Generator<string> uses io, alloc) uses io, alloc {
  if (Co.resume(mutable lines) is Step.Yielded(line)) {
    print(`${label}: ${line}`)
  } else {
    print(`${label}: done`)
  }
}

export function run(args: Array<string>): int uses io, alloc {
  let lines = readLines()
  print("take 2:")
  for (const line of Iterators.take(lines, 2)) {
    print(`head ${line}`)
  }
  print("all lines again:")
  for (const line of lines) {
    print(`line ${line}`)
  }

  print("by hand:")
  resumeOnce("first", mutable lines)
  resumeOnce("second", mutable lines)
  print("take 1 of the rest:")
  for (const line of Iterators.take(lines, 1)) {
    print(`head ${line}`)
  }
  resumeOnce("third", mutable lines)
  resumeOnce("fourth", mutable lines)
  resumeOnce("fifth", mutable lines)
  return 0
}
