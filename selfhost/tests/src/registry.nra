// The suite registry. A suite is a module with two exported functions:
//   collectCases(context): the TestCase list, in a fixed order
//   runCase(context, testCase): Ok(true) for a pass, Err(text) for a failure
// To add a suite, write the module, import it here and add one Suite to
// listSuites. The list order is the run order and the order of the cases, so
// --shard i/N gives every shard the same split.
import * as Bootstrap from "testrunner/bootstrap"
import * as Dumps from "testrunner/dumps"
import * as Fmt from "testrunner/fmtsuite"
import * as FmtStable from "testrunner/fmtstable"
import * as FmtDoc from "testrunner/fmtdoc"
import * as Trivia from "testrunner/trivia"
import * as Query from "testrunner/query"
import * as Lsp from "testrunner/lsp"
import * as Sources from "testrunner/sources"
import * as NodeIds from "testrunner/nodeids"
import * as Errors from "testrunner/errors"
import * as Packages from "testrunner/packages"
import * as Panics from "testrunner/panics"
import * as Programs from "testrunner/programs"
import * as RunnerTests from "testrunner/runnertests"
import * as Edge from "testrunner/edge"
import * as Habits from "testrunner/habits"
import * as Manifest from "testrunner/manifest"
import * as StdTests from "testrunner/stdtests"
import * as RunnerOptions from "testrunner/runneropts"
import * as Emit from "testrunner/emitchecks"
import * as Guide from "testrunner/guide"
import * as Generated from "testrunner/generated"
import * as Codes from "testrunner/codes"
import { Context, TestCase } from "testrunner/context"

export struct Suite {
  name: string
  description: string
  collectCases: (Context) => Array<TestCase> uses io, alloc
  runCase: (Context, TestCase) => Result<bool, string> uses io, alloc
}

export function listSuites(): Array<Suite> uses alloc {
  return [
    Suite {
      name: "programs",
      description: "sample programs: stdout equals .out, debug with sanitizers and release",
      collectCases: Programs.collectCases,
      runCase: Programs.runCase,
    },
    Suite {
      name: "panics",
      description: "programs that must panic with exit code 101 and a message",
      collectCases: Panics.collectCases,
      runCase: Panics.runCase,
    },
    Suite {
      name: "errors",
      description: "samples that must not compile: narrac check stderr equals the .err golden",
      collectCases: Errors.collectCases,
      runCase: Errors.runCase,
    },
    Suite {
      name: "packages",
      description: "sample packages: run.out in debug and release, and their test blocks",
      collectCases: Packages.collectCases,
      runCase: Packages.runCase,
    },
    Suite {
      name: "runner",
      description: "the test blocks runner of narrac test (testdata/runner)",
      collectCases: RunnerTests.collectCases,
      runCase: RunnerTests.runCase,
    },
    Suite {
      name: "dumps",
      description: "the parse, decls, types and pkg dumps compared with their goldens",
      collectCases: Dumps.collectCases,
      runCase: Dumps.runCase,
    },
    Suite {
      name: "fmt",
      description: "narrac fmt on the samples in testdata/fmt: goldens, configs, --check, in place",
      collectCases: Fmt.collectCases,
      runCase: Fmt.runCase,
    },
    Suite {
      name: "fmt-stable",
      description: "every sample formats to a stable text that keeps tokens, comments and tree",
      collectCases: FmtStable.collectCases,
      runCase: FmtStable.runCase,
    },
    Suite {
      name: "fmt-doc",
      description: "narrac fmt-doc goldens, errors and very deep documents",
      collectCases: FmtDoc.collectCases,
      runCase: FmtDoc.runCase,
    },
    Suite {
      name: "trivia",
      description: "narrac trivia goldens and --check over every sample",
      collectCases: Trivia.collectCases,
      runCase: Trivia.runCase,
    },
    Suite {
      name: "query",
      description: "narrac query commands of testdata/query/*/queries.txt",
      collectCases: Query.collectCases,
      runCase: Query.runCase,
    },
    Suite {
      name: "lsp",
      description: "scripted narrac lsp sessions of testdata/lsp: framed output compared with expected.txt",
      collectCases: Lsp.collectCases,
      runCase: Lsp.runCase,
    },
    Suite {
      name: "sources",
      description: "narrac fmt --check over the repository sources",
      collectCases: Sources.collectCases,
      runCase: Sources.runCase,
    },
    Suite {
      name: "node-ids",
      description: "narrac pkg --ids over every package and sample",
      collectCases: NodeIds.collectCases,
      runCase: NodeIds.runCase,
    },
    Suite {
      name: "edge",
      description: "lexer and parser edge cases: lex and parse dumps of testdata/lex and testdata/parse",
      collectCases: Edge.collectCases,
      runCase: Edge.runCase,
    },
    Suite {
      name: "habits",
      description: "TypeScript habit diagnostics: codes, JSON, fixes that leave a clean file, explain",
      collectCases: Habits.collectCases,
      runCase: Habits.runCase,
    },
    Suite {
      name: "manifest",
      description: "narra.toml manifests: pkg dump or error of testdata/manifest",
      collectCases: Manifest.collectCases,
      runCase: Manifest.runCase,
    },
    Suite {
      name: "std-tests",
      description: "failing std/test assertions: message, next test still runs",
      collectCases: StdTests.collectCases,
      runCase: StdTests.runCase,
    },
    Suite {
      name: "runner-options",
      description: "narrac test options: filter, time, golden files, timeout, leak, arguments",
      collectCases: RunnerOptions.collectCases,
      runCase: RunnerOptions.runCase,
    },
    Suite {
      name: "emit",
      description: "narrac emit errors and C name properties",
      collectCases: Emit.collectCases,
      runCase: Emit.runCase,
    },
    Suite {
      name: "guide",
      description: "the narra code blocks of docs/guide",
      collectCases: Guide.collectCases,
      runCase: Guide.runCase,
    },
    Suite {
      name: "generated",
      description: "the runtime*.nra files and stdtext.nra are current with selfhost/runtime and std/src",
      collectCases: Generated.collectCases,
      runCase: Generated.runCase,
    },
    Suite {
      name: "codes",
      description: "every diagnostic report site in selfhost/src passes a code that exists and fits",
      collectCases: Codes.collectCases,
      runCase: Codes.runCase,
    },
    Suite {
      name: "bootstrap",
      description: "a sanitized self-build of narrac and the fixed point",
      collectCases: Bootstrap.collectCases,
      runCase: Bootstrap.runCase,
    },
  ]
}
