// Array patterns in match, is and const: lengths, rests, nesting and literals.
import * as Arrays from "std/array"
import * as Int from "std/int"
import * as Str from "std/string"

function describe(items: Array<int>): string {
  return match (items) {
    [] => "empty"
    [only] => `one ${Int.toString(only)}`
    [first, second] => `two ${Int.toString(first)} ${Int.toString(second)}`
    [first, ..._] => `many from ${Int.toString(first)}`
  }
}

function sum(items: Array<int>): int {
  // The rest is a new Array each time, so this walk is quadratic.
  return match (items) { [] => 0, [first, ...rest] => first + sum(rest) }
}

function joinWords(words: Array<string>): string {
  return match (words) {
    [] => ""
    [word] => word
    [word, ...others] => `${word}, ${joinWords(others)}`
  }
}

function command(arguments: Array<string>): string {
  // Literal elements, as in an argv dispatch.
  return match (arguments) {
    [_, "hash", text] => `hash of ${text}`
    [_, "copy", source, target] => `copy ${source} to ${target}`
    [_, "help" | "--help"] => "help"
    [_, name, ..._] if (Str.startsWith(name, "-")) => `unknown flag ${name}`
    _ => "usage"
  }
}

function pairs(items: Array<int>): string {
  // An or-pattern of two array patterns that bind the same names.
  return match (items) {
    [x, 0] | [0, x] => `zero beside ${Int.toString(x)}`
    [x, y] if (x == y) => "same"
    _ => "other"
  }
}

function skipZero(items: Array<int>): string {
  // Each alternative binds its own rest; one whose guard fails releases it.
  return match (items) {
    [0, x, ...rest] | [x, ...rest] if (
      x > 1
    ) => `${Int.toString(x)} then ${Int.toString(Arrays.length(rest))}`
    [_, ...rest] => `small, ${Int.toString(Arrays.length(rest))} more`
    [] => "empty"
  }
}

function describeTail(items: Array<string>): string {
  if (items is [_, ...tail]) {
    return Str.join(tail, "+")
  }
  return "no tail"
}

function describeFirst(value: Option<Array<string>>): string {
  return match (value) {
    Some([head, ...tail]) => `${head} then ${Int.toString(Arrays.length(tail))}`
    Some([]) => "none inside"
    None => "nothing"
  }
}

function nested(value: #[Array<int>, int]): string {
  return match (value) {
    #[[x], y] => `one ${Int.toString(x)} and ${Int.toString(y)}`
    #[[], _] => "empty"
    #[[_, _, ..._], y] => `long and ${Int.toString(y)}`
  }
}

function grid(rows: Array<Array<int>>): string {
  return match (rows) {
    [[a, b], [c, d]] => Int.toString(a * d - b * c)
    [[..._], ..._] => "not two by two"
    [] => "no rows"
  }
}

function testIs(items: Array<string>) uses io {
  if (items is [single]) {
    print(`is one: ${single}`)
  } else {
    print("is not one")
  }
  print(Str.join(["has two:", Show.show(items is [_, _])], " "))
}

export function run(args: Array<string>): int {
  print(describe([]))
  print(describe([4]))
  print(describe([4, 5]))
  print(describe([4, 5, 6]))
  print(Int.toString(sum([1, 2, 3, 4])))
  print(joinWords(["red", "green", "blue"]))
  print(command(["narrac", "hash", "abc"]))
  print(command(["narrac", "copy", "a", "b"]))
  print(command(["narrac", "--help"]))
  print(command(["narrac", "-x", "y"]))
  print(command(["narrac"]))
  print(pairs([3, 0]))
  print(pairs([0, 7]))
  print(pairs([2, 2]))
  print(pairs([1, 2, 3]))
  print(skipZero([0, 5, 6, 7]))
  print(skipZero([0, 1, 2]))
  print(skipZero([4, 2]))
  print(skipZero([1]))
  print(skipZero([]))
  print(describeTail(["a", "b", "c"]))
  print(describeTail([]))
  print(describeFirst(Some(["a", "b", "c"])))
  print(describeFirst(Some([])))
  print(describeFirst(None))
  print(nested(#[[1], 2]))
  print(nested(#[[], 2]))
  print(nested(#[[1, 2, 3], 9]))
  print(grid([[1, 2], [3, 4]]))
  print(grid([[1], [2]]))
  print(grid([]))
  testIs(["solo"])
  testIs(["a", "b"])

  // A rest alone matches every Array, so it can destructure; it copies.
  const items = ["x", "y", "z"]
  const [...copied] = items
  print(Str.join(copied, ""))
  return 0
}
