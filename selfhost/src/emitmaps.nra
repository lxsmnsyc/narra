// Map types, functions, literals, reads, writes and loops (std_map.go).
// Stub from selfhost-emit-core; the owner is selfhost-emit-maps. The section
// stubs report only when the program has a Map type.
import { Expr, Stmt } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported, hasWork } from "narrac/emitstate"

const NODE = "selfhost-emit-maps"

function sectionMarker(mutable emitter: Emitter, construct: string): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `${reportUnsupported(mutable emitter, construct, NODE)}\n`
  }
  return ""
}

export function emitMapTypedefs(mutable emitter: Emitter): string uses alloc {
  return sectionMarker(mutable emitter, "map types")
}

export function emitMapStructs(mutable emitter: Emitter): string uses alloc {
  return sectionMarker(mutable emitter, "map structs")
}

export function emitMapPrototypes(mutable emitter: Emitter): string uses alloc {
  return sectionMarker(mutable emitter, "map prototypes")
}

// emitMapFunctions runs before the constants, because it registers trait
// needs; its text goes after the trait functions.
export function emitMapFunctions(mutable emitter: Emitter): string uses alloc {
  return sectionMarker(mutable emitter, "map functions")
}

export function emitMapLiteral<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "map literal", NODE), owned: false }
}

export function emitMapGet<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "map index", NODE), owned: false }
}

export function emitMapBuiltin<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "map builtin", NODE), owned: false }
}

export function emitMapSet<W: EmitWalker>(walker: W, mutable emitter: Emitter, statement: Stmt) uses alloc {
  const _ = reportUnsupported(mutable emitter, "map assignment", NODE)
}

export function emitMapFor<W: EmitWalker>(walker: W, mutable emitter: Emitter, statement: Stmt) uses alloc {
  const _ = reportUnsupported(mutable emitter, "map loop", NODE)
}
