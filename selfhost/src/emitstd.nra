// Calls of the std modules other than array, range, box, map, option, result
// and test (std_*.go). Stub from selfhost-emit-core; the owner is
// selfhost-emit-std.
import { Expr } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported, hasWork } from "narrac/emitstate"

const NODE = "selfhost-emit-std"

// reportStdWork is called by the driver while the program facts are missing,
// so an input that needs this node is listed. selfhost-emit-std removes it.
export function reportStdWork(mutable emitter: Emitter): string uses alloc {
  if (hasWork(emitter, NODE)) {
    return `${reportUnsupported(mutable emitter, "std calls", NODE)}\n`
  }
  return ""
}

export function emitStdCall<W: EmitWalker>(walker: W, mutable emitter: Emitter, expression: Expr): Code uses alloc {
  return Code { text: reportUnsupported(mutable emitter, "std call", NODE), owned: false }
}
