// error: values runs unsafe code; iterate it inside an `unsafe { }` block
import * as Ptr from "std/ptr"

// Running the generator runs its unsafe block, so iterating it needs one too.
function* values(items: Ptr<int>): Generator<int> {
  unsafe {
    yield Ptr.read(items)
  }
}

export function run(_args: Array<string>): int uses alloc, unsafe {
  const none: Ptr<int> = Ptr.null()
  let total = 0
  for (const value of values(none)) {
    total += value
  }
  const later = values(none)
  for (const value of later) {
    total += value
  }
  return total
}
