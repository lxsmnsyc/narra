// error: 70000 does not satisfy Port (<= 65535)
// from is proven at compile time; each message names the items that failed.
distinct type Port = int requires >= 1 && <= 65535
distinct type Method = string requires "GET" | "POST"
distinct type Quote = string requires "a\"b"
distinct type Wide = int

struct Holder {
  raw: int
}

struct Config {
  port: Port = Port.from(70000)
}

function unchecked(raw: int): Port {
  return Port.from(raw)
}

function constant(): Port {
  return Port.from(70000)
}

function lowOnly(raw: int): Port {
  if (raw >= 1) {
    return Port.from(raw)
  }
  return Port.from(1)
}

function method(text: string): Method {
  return Method.from(text)
}

function literal(): Method {
  return Method.from("PUT")
}

function field(holder: Holder): Port {
  return Port.from(holder.raw)
}

function unwrapped(wide: Wide): Port {
  return Port.from(Wide.toInt(wide))
}

function quoted(): Quote {
  return Quote.from("x")
}

export function run(_args: Array<string>): int {
  const _ports = [unchecked(1), constant(), lowOnly(2)]
  const _methods = [method("GET"), literal()]
  const _more = [field(Holder { raw: 1 }), unwrapped(Wide.from(2))]
  const _quote = quoted()
  const _config = Config {}
  return 0
}
