import * as Int from "std/int"
import { Range, Label, UserId, Title, Handle, create, length, widen, label, describe, open, slot } from "opaque_range/range"

function yn(b: bool): string {
  if (b) {
    return "yes"
  }
  return "no"
}

function lookup(id: UserId): int {
  return UserId.toInt(id) + 1
}

export function run(args: Array<string>): int {
  const made = create(3, 10)
  if (made is Ok(r)) {
    print(Int.toString(length(r)))
    const w = widen(r, 5)
    print(Int.toString(length(w)))
    print(yn(r == w))
    print(yn(r == r))
  }
  if (create(5, 1) is Err(msg)) {
    print(msg)
  }
  print(describe(label("a")))
  const a = UserId.from(42)
  const b = UserId.from(42)
  print(yn(a == b))
  print(Int.toString(lookup(a)))
  const ids = [a, UserId.from(7)]
  print(Int.toString(UserId.toInt(ids[1])))
  const t = Title.from("hello")
  print(Title.toString(t))
  print(yn(t == Title.from("hello")))
  print(Int.toString(slot(open(21))))
  return 0
}
