import * as Arenas from "std/arena"
import { Arena } from "std/arena"

export function run(args: Array<string>): int uses io, alloc {
  let words: Arena<string> = Arenas.create()
  let numbers: Arena<int> = Arenas.create()
  const number = Arenas.insert(mutable numbers, 1)
  print(`${Show.show(Arenas.get(words, number))}`)
  return 0
}
