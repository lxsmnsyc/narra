// std/int: ordering and division of int. The rest of the functions are built into the compiler.

// Gives `Ordering.Less`, `Ordering.Equal` or `Ordering.Greater` as `first` is below, equal to or above `second`.
export function compare(first: int, second: int): Ordering {
  if (first < second) {
    return Ordering.Less
  }
  if (first > second) {
    return Ordering.Greater
  }
  return Ordering.Equal
}

// Gives the quotient and the remainder, or `None` when `divisor` is 0. The quotient rounds toward zero, so the remainder has the sign of `dividend`.
export function divmod(dividend: int, divisor: int): Option<#[int, int]> {
  // A zero divisor has no quotient.
  if (divisor == 0) {
    return None
  }
  return Some(#[dividend / divisor, dividend % divisor])
}

// Divides and rounds down toward negative infinity, so `floorDiv(-7, 2)` is -4. Gives `None` when `divisor` is 0.
export function floorDiv(dividend: int, divisor: int): Option<int> {
  if (divisor == 0) {
    return None
  }
  const quotient = dividend / divisor
  const remainder = dividend % divisor
  // Division truncates toward zero; step down when the signs differ and the division is inexact.
  if (remainder != 0 && (remainder < 0) != (divisor < 0)) {
    return Some(quotient - 1)
  }
  return Some(quotient)
}
