// A counter shared by two escaping closures, Cell.update, a Cell of string and a Cell of Option.
import * as Cells from "std/cell"
import { Cell } from "std/cell"
import * as Int from "std/int"

function makeCounter(count: Cell<int>): () => int uses alloc {
  return (): int => {
    Cells.update(count, (value) => value + 1)
    return Cells.get(count)
  }
}

function makeResetter(count: Cell<int>): () => int uses alloc {
  return (): int => {
    Cells.set(count, 0)
    return Cells.get(count)
  }
}

struct Holder {
  name: Cell<string>
}

export function run(args: Array<string>): int uses io, alloc {
  const count = Cells.create(0)
  const next = makeCounter(count)
  const reset = makeResetter(count)
  print(Int.toString(next()))
  print(Int.toString(next()))
  print(Int.toString(Cells.get(count)))
  print(Int.toString(reset()))
  print(Int.toString(next()))

  const name = Cells.create("a")
  const holder = Holder { name: name }
  Cells.update(name, (text) => `${text}b`)
  Cells.set(holder.name, `${Cells.get(name)}c`)
  print(Cells.get(name))

  const slot: Cell<Option<string>> = Cells.create(None)
  const fill = (): bool => {
    Cells.set(slot, Some("filled"))
    return true
  }
  print(Cells.get(slot) is None ? "empty" : "full")
  fill()
  if (Cells.get(slot) is Some(text)) {
    print(text)
  }
  Cells.set(slot, None)
  print(Cells.get(slot) is None ? "empty" : "full")
  return 0
}
