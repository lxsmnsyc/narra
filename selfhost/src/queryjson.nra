// JSON text for narrac query (contracts/query-output.md). std/json does not
// exist yet, so this module writes the few shapes the queries need: strings,
// string lists, locations and diagnostics. Objects are written with `": "` and
// `", "` between parts, on one line.
import * as Char from "std/char"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import { Pos } from "narrac/ast"
import { hex } from "narrac/lexer"

// A source range in a file of the package. end is the position after the
// last character.
export struct Location {
  file: string
  start: Pos
  end: Pos
}

export function quoteJson(text: string): string uses alloc {
  let builder = Str.builder()
  Str.append(mutable builder, "\"")
  for (const character of Arrays.values(Str.chars(text))) {
    const code = Char.code(character)
    if (character == '"') {
      Str.append(mutable builder, "\\\"")
    } else if (character == '\\') {
      Str.append(mutable builder, "\\\\")
    } else if (character == '\n') {
      Str.append(mutable builder, "\\n")
    } else if (character == '\t') {
      Str.append(mutable builder, "\\t")
    } else if (character == '\r') {
      Str.append(mutable builder, "\\r")
    } else if (code < 32) {
      Str.append(mutable builder, `\\u${hex(code, 4)}`)
    } else {
      Str.appendChar(mutable builder, character)
    }
  }
  Str.append(mutable builder, "\"")
  return Str.build(builder)
}

export function writeStringList(items: Array<string>): string uses alloc {
  let parts: Array<string> = []
  for (const item of Arrays.values(items)) {
    Arrays.push(mutable parts, quoteJson(item))
  }
  return `[${Str.join(parts, ", ")}]`
}

function writePair(pos: Pos): string uses alloc {
  return `[${Int.toString(pos.line)}, ${Int.toString(pos.column)}]`
}

export function writeLocation(location: Location): string uses alloc {
  return `{"file": ${quoteJson(location.file)}, "range": {"start": ${writePair(location.start)}, "end": ${writePair(location.end)}}}`
}

export function writeLocationText(location: Location): string uses alloc {
  return `${location.file}:${Int.toString(location.start.line)}:${Int.toString(location.start.column)}`
}

export function writeDiagnostic(
  file: string,
  pos: Pos,
  code: string,
  message: string,
): string uses alloc {
  // An error with no file (an unreadable path) has no file, no range and no code: it prints
  // the placeholder E0000.
  let shownCode = code
  if (code == "") {
    shownCode = "E0000"
  }
  const head = `{"code": ${quoteJson(shownCode)}, "severity": "error", "message": ${quoteJson(message)}`
  if (file == "" && pos.line == 0) {
    return `${head}, "fixes": []}`
  }
  const pair = writePair(pos)
  return `${head}, "file": ${quoteJson(file)}, "range": {"start": ${pair}, "end": ${pair}}, "fixes": []}`
}
