import * as Int from "std/int"
import * as Arrays from "std/array"
import * as T from "cfm/tables"

// A constant of this module that calls an @const function of another one.
const SQUARES_OF_POWERS = T.powers(4)

export function run(args: Array<string>): int uses io, alloc {
  const four = 4
  print(`${Int.toString(Arrays.length(T.POWERS))} ${Int.toString(T.POWERS[5])}`)
  print(`${Int.toString(SQUARES_OF_POWERS[3])} ${Int.toString(T.powers(four)[3])}`)
  return 0
}
