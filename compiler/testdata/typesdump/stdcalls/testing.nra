import * as Tests from "std/test"
import * as Arrays from "std/array"

struct Point {
  x: int
  y: int
}

test "compares values" {
  Tests.eq(1 + 1, 2)
  Tests.ne("a", "b")
  Tests.eq([1, 2], [1, 2])
  const offset = 3
  Tests.panics(() => panic("boom"))
  Tests.panicsWith(() => panic("boom"), "boo")
  Tests.golden("name", "text")
  Tests.eq(Arrays.length([offset]), 1)
}
