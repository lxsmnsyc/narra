// A safe function over a C wrapper of snprintf.
import * as CStrings from "std/cstring"
import * as Ptr from "std/ptr"

extern {
  function wrap_describe(value: i32, scale: i32): Ptr<u8>
} from "../wrap.c"

@trusted
export function describe(value: i32, scale: i32): string uses alloc {
  let text = ""
  unsafe {
    if (CStrings.read(wrap_describe(value, scale)) is Ok(copied)) {
      text = copied
    }
  }
  return text
}
