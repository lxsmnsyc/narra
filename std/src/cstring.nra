// std/cstring: CString, a string with no zero byte, which C reads as a zero-terminated string.
//
// Pass `CStrings.pointer(text)` to a C function that takes `char*`; the pointer is valid while
// the CString is. `CStrings.read` copies a zero-terminated string that C returns.

import * as Bytes from "std/bytes"
import * as Str from "std/string"
import * as Ptr from "std/ptr"
import * as Text from "std/internal/cstring"

export opaque struct CString {
  text: string
}

export function from(text: string): Option<CString> {
  // C would stop at a zero byte, so a string that holds one has no CString.
  const length = Str.length(text)
  for (let index = 0; index < length; index++) {
    if (Str.byteAt(text, index) == 0) {
      return None
    }
  }
  return Some(CString { text })
}

export function toString(value: CString): string from value {
  return value.text
}

export function pointer(value: CString): Ptr<u8> {
  return Text.pointer(value.text)
}

export function read(address: Ptr<u8>): Result<string, string> uses alloc, unsafe {
  let copied: Result<string, string> = Err("")
  unsafe {
    copied = Bytes.toString(Text.read(address))
  }
  return copied
}
