// The registry rows and emitters of std/int.
import { StdFunc } from "narrac/builtins"
import { Type } from "narrac/types"
import { Pos, Arg } from "narrac/ast"
import { Emitter, Code, EmitWalker, reportUnsupported, temp, readNodeType } from "narrac/emitstate"
import {
  NODE,
  FixedCall,
  plain,
  owned,
  emitFixedCall,
  argumentText,
  stringOut,
  ioResult,
} from "narrac/stdemithelp"
import { emitSizedCall } from "narrac/stdsized"
import * as Arrays from "std/array"

export const INT_FUNCS: Array<StdFunc> = [
  StdFunc { name: "Int.abs", module: "std/int", key: "abs", parameters: ["int"], result: "int" },
  StdFunc {
    name: "Int.parse",
    module: "std/int",
    key: "parse",
    parameters: ["string", "int"],
    result: "Result<int, string>",
    effects: ["alloc"],
    check: "fixed",
  },
  StdFunc {
    name: "Int.toHex",
    module: "std/int",
    key: "toHex",
    parameters: ["int"],
    result: "string",
    effects: ["alloc"],
  },
  StdFunc {
    name: "Int.toString",
    module: "std/int",
    key: "toString",
    parameters: ["int"],
    result: "string",
    effects: ["alloc"],
  },
]

const INT_FIXED_CALLS: Array<FixedCall> = [
  FixedCall {
    name: "Int.toString",
    call: "lstr_from_int",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall {
    name: "Int.toHex",
    call: "narra_int_to_hex",
    withPos: false,
    owned: true,
    temporary: false,
  },
  FixedCall { name: "Int.abs", call: "narra_abs", withPos: true, owned: false, temporary: true },
]

// Int.parse(text, base): Ok(number) or Err(message).
function emitParse<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  nodeId: int,
  arguments: Array<Arg>,
): Code uses alloc {
  const resultType = readNodeType(emitter, nodeId)
  const text = argumentText(walker, mutable emitter, arguments, 0)
  const base = argumentText(walker, mutable emitter, arguments, 1)
  const number = temp(mutable emitter, Type.TInt, "0")
  const bad = stringOut(mutable emitter)
  const success = temp(
    mutable emitter,
    Type.TBool,
    `narra_int_parse(${text}, ${base}, &${number}, &${bad})`,
  )
  return ioResult(mutable emitter, resultType, success, number, bad)
}

// emitIntCall emits the calls of std/int.
export function emitIntCall<W: EmitWalker>(
  walker: W,
  mutable emitter: Emitter,
  name: string,
  nodeId: int,
  pos: Pos,
  arguments: Array<Arg>,
): Code uses alloc {
  if (name == "Int.from" || name == "Int.tryFrom" || name == "Int.wrap") {
    return emitSizedCall(walker, mutable emitter, name, nodeId, pos, arguments)
  }
  for (const fixed of Arrays.values(INT_FIXED_CALLS)) {
    if (fixed.name == name) {
      return emitFixedCall(walker, mutable emitter, fixed, nodeId, pos, arguments)
    }
  }
  if (name == "Int.parse") {
    return emitParse(walker, mutable emitter, nodeId, arguments)
  }
  // An unknown name is a compiler bug, not a missing feature.
  return plain(reportUnsupported(mutable emitter, `internal error: no emit case for ${name}`, NODE))
}
