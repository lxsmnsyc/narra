// Async.all gives every value in the order of the handles, though the tasks
// finish in another order. An empty array gives an empty array, and a
// cancelled input still gives its value: all does not cancel and is not
// stopped by a cancel.
import * as Int from "std/int"
import * as Async from "std/async"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Str from "std/string"

async function after(label: string, rounds: int): string uses io, alloc {
  for (const _ of Ranges.between(0, rounds)) {
    await Async.idle()
  }
  print(`${label} finishes`)
  return label
}

async function square(value: int): int {
  return value * value
}

export async function run(_args: Array<string>): int {
  const labels = await Async.all([after("slow", 3), after("quick", 1), after("middle", 2)])
  print(Str.join(labels, ", "))

  const none: Array<Async<string>> = []
  print(`empty gives ${Int.toString(Arrays.length(await Async.all(none)))} values`)

  const squares = await Async.all(Arrays.map([1, 2, 3], async (value) => await square(value)))
  let total = 0
  for (const value of Arrays.values(squares)) {
    total += value
  }
  print(`sum of squares ${Int.toString(total)}`)

  const cancelled = after("cancelled", 1)
  const both = Async.all([cancelled, after("kept", 2)])
  Async.cancel(cancelled)
  print(Str.join(await both, ", "))
  return 0
}
