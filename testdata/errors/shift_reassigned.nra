// error: shift_reassigned.nra:6:21: the shift count must be a constant from 0 to 63 or a name checked against both ends first; check the name first, as in `if (n >= 0 && n < 64) { ... }`
function shift(value: int, count: int): int {
  let amount = count
  if (amount >= 0 && amount < 64) {
    amount = amount + 1
    return value << amount
  }
  return 0
}

export function run(args: Array<string>): int {
  return shift(1, 3)
}
