<script>
  import { $signal } from 'brumate/signals';
  import Icon from './Icon.brm';
  import effectsBefore from '../home/demos/effects-before.md';
  import effectsAfter from '../home/demos/effects-after.md';
  import matchBefore from '../home/demos/match-before.md';
  import matchAfter from '../home/demos/match-after.md';
  import nullBefore from '../home/demos/null-before.md';
  import nullAfter from '../home/demos/null-after.md';
  import sharedBefore from '../home/demos/shared-before.md';
  import sharedAfter from '../home/demos/shared-after.md';

  // Each case is a sample the compiler rejects, the message it prints, and the fixed sample.
  // `mark` is the line of the message, and `changed` the lines the fix touches.
  const CASES = [
    {
      id: 'effects',
      label: 'Effects',
      before: effectsBefore.html,
      after: effectsAfter.html,
      mark: 4,
      changed: [3],
      location: '4:25',
      message: 'Function `describe` uses `alloc` (through `Int.toString`) but its signature does not declare it; write `uses alloc`',
    },
    {
      id: 'match',
      label: 'Every case',
      before: matchBefore.html,
      after: matchAfter.html,
      mark: 8,
      changed: [11],
      location: '8:10',
      message: 'match does not cover Triangle(_, _); add the cases or a `_` arm',
    },
    {
      id: 'null',
      label: 'No null',
      before: nullBefore.html,
      after: nullAfter.html,
      mark: 3,
      changed: [3, 4, 5],
      location: '3:27',
      message: 'expected int, found Option<int>',
    },
    {
      id: 'shared',
      label: 'Shared values',
      before: sharedBefore.html,
      after: sharedAfter.html,
      mark: 6,
      changed: [5],
      location: '6:15',
      message: 'Arrays.push(mutable prices, ...) may change prices, which snapshot still uses at line 7; take a copy where it is shared, with copy(...)',
    },
  ];

  let current = $signal('effects');
  let fixed = $signal(false);

  function select(id: string) {
    current = id;
    fixed = false;
  }

  function toggleFix() {
    fixed = !fixed;
  }

  function moveFocus(event: KeyboardEvent) {
    // Arrow keys move between the tabs, as a tab list does.
    const ids: string[] = [];
    for (const item of CASES) {
      ids.push(item.id);
    }
    const at = ids.indexOf(current);
    let next = at;
    if (event.key === 'ArrowRight') {
      next = (at + 1) % ids.length;
    } else if (event.key === 'ArrowLeft') {
      next = (at - 1 + ids.length) % ids.length;
    } else {
      return;
    }
    select(ids[next]!);
    const button = document.getElementById(`demo-tab-${ids[next]}`);
    button?.focus();
  }
</script>

<div class="demo" data-fixed=(fixed ? 'true' : 'false')>
  <div class="demo-tabs" role="tablist" aria-label="What the compiler catches" onKeyDown=moveFocus>
    #for (item of CASES by item.id) {
      <button
        type="button"
        role="tab"
        id=(`demo-tab-${item.id}`)
        class="demo-tab"
        aria-selected=(current === item.id ? 'true' : 'false')
        aria-controls="demo-panel"
        tabindex=(current === item.id ? 0 : -1)
        onClick=(() => select(item.id))
      >{item.label}</button>
    }
  </div>
  <div class="demo-panel" id="demo-panel" role="tabpanel" aria-live="polite">
    <div class="demo-stack">
      #for (item of CASES by item.id) {
        <div
          class="demo-code before"
          data-case=item.id
          data-mark=item.mark
          style=(`--from: ${item.mark}; --count: 1; --message: ${JSON.stringify(item.message)}`)
          aria-hidden=(current === item.id && !fixed ? 'false' : 'true')
        >{item.before}</div>
        <div
          class="demo-code after"
          data-case=item.id
          style=(`--from: ${item.changed[0]}; --count: ${item.changed.length}`)
          aria-hidden=(current === item.id && fixed ? 'false' : 'true')
        >{item.after}</div>
      }
    </div>
    <div class="demo-status">
      <div class="demo-messages">
        #for (item of CASES by item.id) {
          <p class="demo-message error" aria-hidden=(current === item.id && !fixed ? 'false' : 'true')>
            <span class="demo-icon"><Icon name="alert" size=(16) /></span>
            <span>1 error <span class="demo-location">at {item.location}</span><span class="visually-hidden">: {item.message}</span></span>
          </p>
        }
        <p class="demo-message ok" aria-hidden=(fixed ? 'false' : 'true')>
          <span class="demo-icon"><Icon name="check" size=(16) /></span>
          <span>Compiles</span>
        </p>
      </div>
      <button type="button" class="button demo-fix" onClick=toggleFix aria-pressed=(fixed ? 'true' : 'false')>
        <span class="swap">
          <span class="swap-item" aria-hidden=(fixed ? 'true' : 'false')><Icon name="wrench" size=(16) /> Apply the fix</span>
          <span class="swap-item" aria-hidden=(fixed ? 'false' : 'true')><Icon name="undo" size=(16) /> Undo</span>
        </span>
      </button>
    </div>
  </div>
</div>
