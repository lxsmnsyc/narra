// error: the values of Channel.create: Cell<int> is not Sendable
import * as Channel from "std/channel"
import * as Cells from "std/cell"
import { Cell } from "std/cell"

export function run(_args: Array<string>): int {
  const #[sender, _receiver] = Channel.create<Cell<int>>(4)
  Channel.send(sender, Cells.create(1))
  return 0
}
