// The declaration dump (`narrac decls <path>`). The format is defined in the
// doc comment at the top of compiler/internal/narra/decldump.go; this file
// prints the same text from the Narra checker's tables. selfhost-check-traits
// added trait, impl and bound; selfhost-check-imports added module, import,
// scope and entry, and writes types with their module (dumpTypeString). The
// builtin lines are printed by builtins.nra (`narrac builtins`).
import * as Str from "std/string"
import { Decl, File, FuncDecl, Param, ImplDecl } from "narrac/ast"
import { quoteDump } from "narrac/modules"
import { Type, Field, Variant } from "narrac/types"
import { Checker, typeString, typeModule, containsTypeParam, stdTrait } from "narrac/check"
import { typeImplements } from "narrac/traits"
import * as Array from "std/array"
import * as Map from "std/map"
import * as Range from "std/range"

// dump returns the dump of a checker that ran declarePackage without errors.
export function dump(mutable c: Checker): string uses alloc {
  let sb = Str.builder()
  // The implement blocks are in c.impls in the order dumpModule meets them.
  let nextImpl = 0
  for (const s of Range.between(0, Array.length(c.scopes))) {
    dumpModule(mutable sb, c, s, mutable nextImpl)
    if (c.scopes[s].isSource) {
      dumpScope(mutable sb, c, s)
    }
  }
  if (nextImpl != Array.length(c.impls)) {
    panic("declsdump: an implement block was not printed")
  }
  for (const e of Array.values(c.entries)) {
    let target = "none"
    if (e.func >= 0) {
      target = `${c.funcs[e.func].module}.${c.funcs[e.func].name}`
    }
    Str.append(mutable sb, `entry ${quoteDump(e.binary)} ${target}\n`)
  }
  let blocks: Array<string> = []
  let heads: Array<string> = []
  for (const t of Array.values(c.instTypes)) {
    if (!containsTypeParam(c, t)) {
      let ib = Str.builder()
      dumpType(mutable ib, c, t)
      const text = Str.build(ib)
      const head = Str.split(text, "\n")[0]
      Array.push(mutable blocks, text)
      Array.push(mutable heads, head)
    }
  }
  // Stable order by the first line, as Go's sort.SliceStable.
  for (const k of Array.values(sortedByHead(heads))) {
    Str.append(mutable sb, blocks[k])
  }
  for (const t of Array.values(c.order)) {
    Str.append(mutable sb, `order module=${quoteDump(typeModule(c, t))} ${dumpTypeString(c, t)}\n`)
  }
  for (const t of Array.values(c.order)) {
    dumpHolds(mutable sb, mutable c, t)
  }
  return Str.build(sb)
}

// sortedByHead returns the indexes of heads in byte order, equal heads in
// their original order (a bottom-up merge sort).
function sortedByHead(heads: Array<string>): Array<int> uses alloc {
  const n = Array.length(heads)
  let src: Array<int> = []
  for (const k of Range.between(0, n)) {
    Array.push(mutable src, k)
  }
  let width = 1
  while (width < n) {
    let dst: Array<int> = []
    let lo = 0
    while (lo < n) {
      let mid = lo + width
      if (mid > n) {
        mid = n
      }
      let hi = lo + 2 * width
      if (hi > n) {
        hi = n
      }
      let i = lo
      let j = mid
      while (i < mid || j < hi) {
        if (j >= hi || (i < mid && heads[src[i]] <= heads[src[j]])) {
          Array.push(mutable dst, src[i])
          i = i + 1
        } else {
          Array.push(mutable dst, src[j])
          j = j + 1
        }
      }
      lo = lo + 2 * width
    }
    src = dst
    width = width * 2
  }
  return src
}

function dumpModule(mutable sb: StringBuilder, c: Checker, s: int, mutable nextImpl: int) uses alloc {
  const scope = c.scopes[s]
  const mod = ` module=${quoteDump(scope.path)} `
  for (const d of Array.values(scope.decls)) {
    match (d) {
      Struct(sd) => {
        dumpNamed(mutable sb, c, s, sd.name)
        dumpListed(mutable sb, c, mod, scope.path, sd.name)
      }
      Enum(ed) => {
        dumpNamed(mutable sb, c, s, ed.name)
        dumpListed(mutable sb, c, mod, scope.path, ed.name)
      }
      Trait(td) => {
        if (scope.traits[td.name] is Some(ti)) {
          dumpTrait(mutable sb, c, mod, ti)
        }
      }
      Impl(id) => dumpImpl(mutable sb, c, mod, s, id, mutable nextImpl)
      Distinct(dd) => dumpNamed(mutable sb, c, s, dd.name)
      Func(fd) => dumpFunc(mutable sb, c, s, mod, fd)
      Const(cd) => {
        let t = "?"
        if (scope.consts[cd.name] is Some(k)) {
          if (c.consts[k].t is Some(ct)) {
            t = dumpTypeString(c, ct)
          }
        }
        Str.append(mutable sb, `const${mod}${cd.name} ${t}\n`)
      }
      _ => {}
    }
  }
}

// dumpNamed prints a struct, enum or distinct declaration of scope s: its
// generic template, or its type.
function dumpNamed(mutable sb: StringBuilder, c: Checker, s: int, name: string) uses alloc {
  if (c.scopes[s].generics[name] is Some(g)) {
    dumpGeneric(mutable sb, c, g)
  } else if (c.scopes[s].types[name] is Some(t)) {
    dumpType(mutable sb, c, t)
  }
}

function dumpFunc(mutable sb: StringBuilder, c: Checker, s: int, mod: string, fd: FuncDecl) uses alloc {
  Str.append(mutable sb, `func${mod}`)
  if (Array.length(fd.typeParams) > 0) {
    Str.append(mutable sb, `typeParams=${Str.join(fd.typeParams, ",")} `)
  }
  Str.append(mutable sb, `${fd.name}\n`)
  for (const p of Array.values(fd.params)) {
    let flag = ""
    if (p.isMutable) {
      flag = "mutable "
    }
    Str.append(mutable sb, `  param ${p.name} ${flag}${dumpTypeString(c, c.paramTypes[p.id])}\n`)
  }
  let result = "void"
  if (c.scopes[s].funcs[fd.name] is Some(k)) {
    result = dumpTypeString(c, c.funcs[k].result)
  }
  Str.append(mutable sb, `  result ${result}\n`)
  if (c.scopes[s].funcs[fd.name] is Some(k)) {
    for (const i of Range.between(0, Array.length(c.funcs[k].typeParams))) {
      if (c.bounds[c.funcs[k].typeParams[i]] is Some(bs)) {
        for (const tr of Array.values(bs)) {
          Str.append(mutable sb, `  bound ${fd.typeParams[i]} ${c.traits[tr].name}\n`)
        }
      }
    }
  }
}

// dumpListed prints the `implements` and `derives` lists of a struct or enum.
function dumpListed(mutable sb: StringBuilder, c: Checker, mod: string, path: string, name: string) uses alloc {
  if (c.typeTraitIndex[`${path}|${name}`] is Some(ix)) {
    for (const te of Array.values(c.typeTraits[ix].implExprs)) {
      Str.append(mutable sb, `impl${mod}listed ${te.name} ${name}\n`)
    }
    for (const te of Array.values(c.typeTraits[ix].derivExprs)) {
      Str.append(mutable sb, `impl${mod}derived ${te.name} ${name}\n`)
    }
  }
}

function dumpTrait(mutable sb: StringBuilder, c: Checker, mod: string, ti: int) uses alloc {
  const tr = c.traits[ti]
  let std = ""
  if (tr.std) {
    std = "std "
  }
  Str.append(mutable sb, `trait${mod}${std}${tr.name}\n`)
  for (const tf of Array.values(tr.funcs)) {
    dumpSignature(mutable sb, c, tf.name, tf.decl, tf.result)
  }
}

// dumpImpl prints an `implement` block. Checker.impls holds the checked
// blocks in declaration order, so the next one is this block. The dump runs
// only without errors, when every block was recorded; a mismatch is a bug
// and stops the dump.
function dumpImpl(mutable sb: StringBuilder, c: Checker, mod: string, s: int, d: ImplDecl, mutable nextImpl: int) uses alloc {
  if (nextImpl >= Array.length(c.impls)) {
    panic("declsdump: an implement block is missing from Checker.impls")
  }
  const b = c.impls[nextImpl]
  if (b.scope != s || b.decl.pos != d.pos) {
    panic("declsdump: Checker.impls is out of declaration order")
  }
  nextImpl = nextImpl + 1
  Str.append(mutable sb, `impl${mod}block ${c.traits[b.traitIdx].name} ${implTypeName(c, b.t)}\n`)
  for (const f of Array.values(b.funcs)) {
    dumpSignature(mutable sb, c, f.name, f.decl, f.result)
  }
}

function implTypeName(c: Checker, t: Type): string {
  return match (t) {
    TStruct(i) => c.structs[i].name
    TEnum(i) => c.enums[i].name
    _ => ""
  }
}

function dumpSignature(mutable sb: StringBuilder, c: Checker, name: string, fd: FuncDecl, result: Type) uses alloc {
  Str.append(mutable sb, `  function ${name}\n`)
  for (const p of Array.values(fd.params)) {
    let flags = ""
    if (p.isMutable) {
      flags = "mutable "
    }
    if (p.escaping) {
      flags = `${flags}escaping `
    }
    Str.append(mutable sb, `    param ${p.name} ${flags}${dumpTypeString(c, c.paramTypes[p.id])}\n`)
  }
  Str.append(mutable sb, `    result ${dumpTypeString(c, result)}\n`)
}

// dumpHolds prints typeImplements(t, trait) for the four standard traits.
function dumpHolds(mutable sb: StringBuilder, mutable c: Checker, t: Type) uses alloc {
  const names = ["Equatable", "Hashable", "Ordered", "Show"]
  for (const n of Array.values(names)) {
    const tr = stdTrait(c, n)
    let holds = "false"
    if (typeImplements(mutable c, t, tr)) {
      holds = "true"
    }
    Str.append(mutable sb, `impl module=${quoteDump(typeModule(c, t))} holds=${holds} ${n} ${dumpTypeString(c, t)}\n`)
  }
}

function dumpType(mutable sb: StringBuilder, c: Checker, t: Type) uses alloc {
  match (t) {
    TStruct(i) => {
      const s = c.structs[i]
      if (s.tuple) {
        Str.append(mutable sb, `type tuple module="" ${dumpTypeString(c, t)}\n`)
      } else {
        Str.append(mutable sb, `type struct module=${quoteDump(s.module)} ${opaqueFlag(s.opaque)}${dumpTypeString(c, t)}\n`)
      }
      dumpFields(mutable sb, c, "  ", s.fields)
    }
    TEnum(i) => {
      Str.append(mutable sb, `type enum module=${quoteDump(c.enums[i].module)} ${dumpTypeString(c, t)}\n`)
      dumpVariants(mutable sb, c, c.enums[i].variants)
    }
    TDistinct(i) => {
      const d = c.distincts[i]
      Str.append(mutable sb, `type distinct module=${quoteDump(d.module)} ${opaqueFlag(d.opaque)}${d.name}\n`)
      let base = "void"
      if (d.base is Some(b)) {
        base = dumpTypeString(c, b)
      }
      Str.append(mutable sb, `  base ${base}\n`)
    }
    _ => {}
  }
}

function dumpGeneric(mutable sb: StringBuilder, c: Checker, g: int) uses alloc {
  const info = c.generics[g]
  let names: Array<string> = []
  for (const p of Array.values(info.params)) {
    Array.push(mutable names, c.params[p].name)
  }
  let kind = "enum"
  if (info.isStruct) {
    kind = "struct"
  }
  Str.append(mutable sb, `generic ${kind} module=${quoteDump(info.module)} params=${Str.join(names, ",")} ${opaqueFlag(info.opaque)}${info.name}\n`)
  dumpFields(mutable sb, c, "  ", info.fields)
  dumpVariants(mutable sb, c, info.variants)
}

function dumpVariants(mutable sb: StringBuilder, c: Checker, vs: Array<Variant>) uses alloc {
  for (const v of Array.values(vs)) {
    Str.append(mutable sb, `  variant ${v.name}\n`)
    dumpFields(mutable sb, c, "    ", v.fields)
  }
}

function dumpFields(mutable sb: StringBuilder, c: Checker, indent: string, fields: Array<Field>) uses alloc {
  for (const f of Array.values(fields)) {
    let flag = ""
    if (f.default is Some(_)) {
      flag = "default "
    }
    Str.append(mutable sb, `${indent}field ${f.name} ${flag}${dumpTypeString(c, f.t)}\n`)
  }
}

function opaqueFlag(on: bool): string {
  if (on) {
    return "opaque "
  }
  return ""
}

// dumpTypeString prints a type as typeString does, except that a struct,
// enum or distinct type declared in a package module is written
// <module>.<Name> (decldump.go's dumpTypeString).
function dumpTypeString(c: Checker, t: Type): string uses alloc {
  return match (t) {
    TStruct(i) => structText(c, i)
    TEnum(i) => `${qualified(c.enums[i].module, c.enums[i].name)}${argsText(c, c.enums[i].args)}`
    TDistinct(i) => qualified(c.distincts[i].module, c.distincts[i].name)
    TArray(e) => `Array<${dumpTypeString(c, e)}>`
    TBox(e) => `Box<${dumpTypeString(c, e)}>`
    TMap(k, v) => `Map<${dumpTypeString(c, k)}, ${dumpTypeString(c, v)}>`
    TFunc(ps, r) => `(${listText(c, ps)}) => ${dumpTypeString(c, r)}`
    _ => typeString(c, t)
  }
}

function structText(c: Checker, i: int): string uses alloc {
  const s = c.structs[i]
  if (s.tuple) {
    return `#[${listText(c, s.args)}]`
  }
  return `${qualified(s.module, s.name)}${argsText(c, s.args)}`
}

function qualified(module: string, name: string): string uses alloc {
  if (module == "") {
    return name
  }
  return `${module}.${name}`
}

function argsText(c: Checker, args: Array<Type>): string uses alloc {
  if (Array.length(args) == 0) {
    return ""
  }
  return `<${listText(c, args)}>`
}

function listText(c: Checker, ts: Array<Type>): string uses alloc {
  let parts: Array<string> = []
  for (const t of Array.values(ts)) {
    Array.push(mutable parts, dumpTypeString(c, t))
  }
  return Str.join(parts, ", ")
}

// dumpScope prints the `module` block of package module s: its imports in
// source order, then the names of its scope that the prelude does not give
// every module, by kind and then by name (byte order).
function dumpScope(mutable sb: StringBuilder, c: Checker, s: int) uses alloc {
  const scope = c.scopes[s]
  Str.append(mutable sb, `module ${quoteDump(scope.path)}\n`)
  for (const imp of Array.values(scope.imports)) {
    let kind = "std"
    if (c.scopeIndex[imp.path] is Some(k)) {
      if (c.scopes[k].isSource) {
        kind = "package"
      }
    }
    Str.append(mutable sb, `  import ${quoteDump(imp.path)} ${kind}`)
    if (imp.alias != "") {
      Str.append(mutable sb, ` alias=${imp.alias}`)
    }
    if (Array.length(imp.names) > 0) {
      Str.append(mutable sb, ` names=${Str.join(imp.names, ",")}`)
    }
    Str.append(mutable sb, "\n")
  }
  let lines: Array<string> = []
  for (const e of Map.entries(scope.types)) {
    const #[n, t] = e
    let inherited = false
    if (c.scopes[0].types[n] is Some(pt)) {
      inherited = pt == t
    }
    if (!inherited) {
      Array.push(mutable lines, `type ${n} ${dumpTypeString(c, t)}`)
    }
  }
  writeScopeLines(mutable sb, lines)
  lines = []
  for (const e of Map.entries(scope.generics)) {
    const #[n, g] = e
    let inherited = false
    if (c.scopes[0].generics[n] is Some(pg)) {
      inherited = pg == g
    }
    if (!inherited) {
      Array.push(mutable lines, `generic ${n} ${qualified(c.generics[g].module, c.generics[g].name)}`)
    }
  }
  writeScopeLines(mutable sb, lines)
  lines = []
  for (const e of Map.entries(scope.funcs)) {
    const #[n, k] = e
    Array.push(mutable lines, `func ${n} ${qualified(c.funcs[k].module, c.funcs[k].name)}`)
  }
  writeScopeLines(mutable sb, lines)
  lines = []
  for (const e of Map.entries(scope.consts)) {
    const #[n, k] = e
    Array.push(mutable lines, `const ${n} ${qualified(c.consts[k].module, c.consts[k].name)}`)
  }
  writeScopeLines(mutable sb, lines)
  lines = []
  for (const e of Map.entries(scope.traits)) {
    const #[n, k] = e
    Array.push(mutable lines, `trait ${n} ${qualified(c.traits[k].module, c.traits[k].name)}`)
  }
  writeScopeLines(mutable sb, lines)
  lines = []
  for (const e of Map.entries(scope.imported)) {
    const #[n, k] = e
    Array.push(mutable lines, `builtin ${n} ${c.registry.funcs[k].name}`)
  }
  writeScopeLines(mutable sb, lines)
  lines = []
  for (const e of Map.entries(scope.modules)) {
    const #[a, p] = e
    Array.push(mutable lines, `alias ${a} ${quoteDump(p)}`)
  }
  writeScopeLines(mutable sb, lines)
}

function writeScopeLines(mutable sb: StringBuilder, lines: Array<string>) uses alloc {
  for (const k of Array.values(sortedByHead(lines))) {
    Str.append(mutable sb, `  scope ${lines[k]}\n`)
  }
}
