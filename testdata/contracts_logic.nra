// `||` clauses in requires: a caller proves one side of each clause, and the body
// knows the hull of a clause over one parameter.
const LIMIT = 10

function outside(count: int): int
  requires count < 0 || count > LIMIT
{
  return count
}

function divideBy(total: int, divisor: int): int
  requires divisor < 0 || divisor > 0
{
  // The hull of the two sides is every int but zero.
  return total / divisor
}

function either(first: int, second: int): int
  requires first != 0 || second != 0
{
  return first + second
}

function locate(index: int, count: int): int
  requires (index >= 0 || index == -1) && count != 0
{
  return index / count
}

function odd(value: int): int
  requires value == 1 || value == 3
{
  // The hull is 1 to 3, a valid shift count.
  return 1 << value
}

function checkedOutside(count: int): int {
  if (count > 20) {
    return outside(count)
  }
  if (count < -5) {
    return outside(count)
  }
  return 0
}

export function run(_args: Array<string>): int uses io, alloc {
  print(Show.show(outside(-1)))
  print(Show.show(outside(11)))
  print(Show.show(checkedOutside(30)))
  print(Show.show(checkedOutside(-9)))
  print(Show.show(checkedOutside(3)))
  print(Show.show(divideBy(12, -4)))
  print(Show.show(either(0, 5)))
  print(Show.show(either(2, 0)))
  print(Show.show(locate(-1, 1)))
  print(Show.show(locate(8, 2)))
  print(Show.show(odd(3)))
  return 0
}
