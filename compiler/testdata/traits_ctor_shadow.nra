// A user enum's constructors hide the prelude's: `Less` here is Rank.Less,
// never Ordering.Less, even with no expected type.
enum Rank derives Show {
  Less
  Equal
  Greater
  Top(score: int)
}

function label(r: Rank): string {
  return match (r) {
    Less => "rank less"
    Equal => "rank equal"
    Greater => "rank greater"
    Top(s) => "rank top"
  }
}

export function run(args: Array<string>): int {
  const a = Less
  const b = Greater
  print(label(a))
  print(label(b))
  print(Show.show(Equal))
  print(Show.show(Top(3)))
  if (a == Less && a != Greater) {
    print("rank compare")
  }
  // Ordering's constructors are still reachable through the expected type
  // or the enum name.
  const o: Ordering = Less
  print(Show.show(o))
  print(Show.show(Ordering.Greater))
  print(Show.show(Ordered.compare(1, 2)))
  return 0
}
