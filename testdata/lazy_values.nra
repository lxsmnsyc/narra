// A lazy top-level value: built by the first Lazies.force and kept for the later ones.
import * as Lazies from "std/lazy"
import * as Int from "std/int"

function buildTable(): Array<int> uses alloc {
  return [1, 2, 3]
}

const table = lazy buildTable()

export function run(args: Array<string>): int uses io, alloc {
  print(Int.toString(Lazies.force(table)[0]))
  print(Int.toString(Lazies.force(table)[2]))
  return Lazies.force(table)[0] - 1
}
