// A store into a slot shares the value with the holder. Writing after a
// copy(...) at the store leaves the holder's value unchanged, and the debug
// copy check finds no hidden copy.
import * as Arenas from "std/arena"
import * as Arrays from "std/array"
import * as Cells from "std/cell"
import * as Channel from "std/channel"
import * as Int from "std/int"

export function run(_args: Array<string>): int uses io, alloc {
  const cell = Cells.create<Array<int>>([])
  let items = [1, 2, 3]
  Cells.set(cell, copy(items))
  Arrays.push(mutable items, 4)
  print(`${Int.toString(Arrays.length(Cells.get(cell)))} ${Int.toString(Arrays.length(items))}`)

  const #[sender, receiver] = Channel.create<Array<int>>(2)
  Channel.send(sender, copy(items))
  Arrays.push(mutable items, 5)
  if (Channel.receive(receiver) is Some(received)) {
    print(`${Int.toString(Arrays.length(received))} ${Int.toString(Arrays.length(items))}`)
  }

  let arena = Arenas.create<Array<int>>()
  const handle = Arenas.insert(mutable arena, copy(items))
  Arrays.push(mutable items, 6)
  if (Arenas.get(arena, handle) is Some(stored)) {
    print(`${Int.toString(Arrays.length(stored))} ${Int.toString(Arrays.length(items))}`)
  }

  // A value that is not written after the store needs no copy.
  const lone = Cells.create([7, 8])
  print(Int.toString(Arrays.length(Cells.get(lone))))
  return 0
}
