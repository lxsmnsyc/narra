// Directory listings and file reads for the suites.
import * as Arrays from "std/array"
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Ranges from "std/range"
import * as Str from "std/string"
import * as Shell from "testrunner/shell"

// sortNames puts names in byte order (Fs.listDir has no order).
function sortNames(mutable names: Array<string>) {
  for (const position of Ranges.between(1, Arrays.length(names))) {
    const name = names[position]
    let slot = position
    while (slot > 0 && names[slot - 1] > name) {
      names[slot] = names[slot - 1]
      slot = slot - 1
    }
    names[slot] = name
  }
}

// listNames is the sorted entry names of a directory, empty when it cannot be
// read.
export function listNames(directory: string): Array<string> uses io, alloc {
  const listed = Fs.listDir(directory)
  if (listed is Err(_)) {
    return []
  }
  let names = listed.value
  sortNames(mutable names)
  return names
}

// listPaths is the sorted paths of the entries of a directory whose name ends
// with suffix. An empty suffix takes every entry.
export function listPaths(directory: string, suffix: string): Array<string> uses io, alloc {
  let paths: Array<string> = []
  for (const name of Arrays.values(listNames(directory))) {
    if (Str.endsWith(name, suffix)) {
      Arrays.push(mutable paths, Path.join(directory, name))
    }
  }
  return paths
}

// relativePath is path below root, without the leading slash. A path outside
// root stays as it is.
export function relativePath(root: string, path: string): string uses alloc {
  const prefix = `${root}/`
  if (Str.startsWith(path, prefix)) {
    return Str.sliceFrom(path, Str.length(prefix))
  }
  return path
}

// replaceSuffix replaces the ending of a path: ("a/b.nra", ".nra", ".out") is
// "a/b.out".
export function replaceSuffix(
  path: string,
  suffix: string,
  replacement: string,
): string uses alloc {
  return `${Str.slice(path, 0, Str.length(path) - Str.length(suffix))}${replacement}`
}

// findSources is the sorted paths of every .nra file below a folder, at any
// depth (`find`, so the order is the byte order of the full paths).
export function findSources(folder: string): Array<string> uses io, alloc {
  const found = Shell.runScript("find \"$1\" -type f -name '*.nra' | LC_ALL=C sort", [folder])
  let paths: Array<string> = []
  for (const line of Arrays.values(Str.split(found.output, "\n"))) {
    if (line != "") {
      Arrays.push(mutable paths, line)
    }
  }
  return paths
}

// listCorpus is every sample the corpus checks run on: the .nra files below
// the testdata folder, then those below selfhost/src.
export function listCorpus(testdata: string, repository: string): Array<string> uses io, alloc {
  let paths = findSources(testdata)
  const sources = findSources(`${repository}/selfhost/src`)
  for (const path of Arrays.values(sources)) {
    Arrays.push(mutable paths, path)
  }
  return paths
}
