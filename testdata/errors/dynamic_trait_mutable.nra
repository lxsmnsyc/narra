// error: Grow.grow takes a mutable Self, and a Dynamic<Grow> cannot be passed to it
trait Grow {
  function grow(mutable value: Self)
  function size(value: Self): int
}

struct Bag implements Grow {
  count: int
}

implement Grow for Bag {
  function grow(mutable value: Bag) {
    value.count += 1
  }

  function size(value: Bag): int {
    return value.count
  }
}

export function run(_args: Array<string>): int {
  const item: Dynamic<Grow> = Dynamic.of(Bag { count: 0 })
  Grow.grow(mutable item)
  return Grow.size(item)
}
