// A callback of Shared.read that reaches the same Shared: its thread holds
// the lock already, so the program stops with "Shared.get: this thread
// already holds the lock of this Shared; ..." and exit code 101 instead of
// waiting forever.
import * as Shared from "std/shared"
import * as Int from "std/int"

export function run(_args: Array<string>): int {
  const cell = Shared.create(1)
  print("before")
  const both = Shared.read(cell, (value) => value + Shared.get(cell))
  print(Int.toString(both))
  return 0
}
