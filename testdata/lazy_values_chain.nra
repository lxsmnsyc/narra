// A lazy value that forces another, and one forced inside a closure.
import * as Lazies from "std/lazy"
import * as Int from "std/int"
import * as Arrays from "std/array"

function buildBase(): Array<int> uses alloc {
  return [4, 5, 6]
}

function buildDoubled(): Array<int> uses alloc {
  let result: Array<int> = []
  for (const value of Lazies.force(base)) {
    Arrays.push(mutable result, value * 2)
  }
  return result
}

const base = lazy buildBase()
const doubled = lazy buildDoubled()

function makeReader(position: int): () => int uses alloc {
  return (): int => Lazies.force(doubled)[position]
}

export function run(args: Array<string>): int uses io, alloc {
  const reader = makeReader(2)
  print(Int.toString(reader()))
  print(Int.toString(Lazies.force(base)[0]))
  return 0
}
