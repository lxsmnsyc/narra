enum Token {
  Plus
  Minus
  Star
  Slash
  Number(value: int)
}

function describe(token: Token): string {
  return match (token) {
    Token.Plus | Token.Minus => "additive"
    Token.Star | Token.Slash => "multiplicative"
    Token.Number(1 | 2) => "small"
    Token.Number(_) => "number"
  }
}

function describeLong(token: Token): string {
  return match (token) {
    Token.Plus
      | Token.Minus
      | Token.Star
      | Token.Slash
      | Token.Number(1)
      | Token.Number(2)
      | Token.Number(3) => "anything at all"
  }
}
