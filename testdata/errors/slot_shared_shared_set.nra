// error: Arrays.push(mutable items, ...) may change items, which the cell box[] still holds; no fix is offered here: copy the value by hand where the sharing starts, or end the sharing before the write
import * as Arrays from "std/array"
import * as Shared from "std/shared"

export function run(_args: Array<string>): int uses alloc {
  const box = Shared.create<Array<int>>([])
  let items = [1, 2, 3]
  Shared.set(box, items)
  Arrays.push(mutable items, 4)
  return Arrays.length(items)
}
