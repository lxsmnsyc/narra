function pick(a: int): int {
  return a > 1 ? 1 : 2
}
function chain(a: int): string {
  return a > 2 ? "big" : a > 1 ? "mid" : "small"
}
function real(a: int): int {
  if (a > 1) {
    return 1
  } else {
    return 2
  }
}
function inner(a: int): int {
  const value = a > 1 ? 1 : 2
  return value
}
function longer(a: int): string {
  return aVeryLongConditionNumberOne(
    a,
  ) ? "the first long result of this function" : "the second long result of this function"
}
