// error: a generator, coroutine, stream or task cannot hold a Scope
import * as Int from "std/int"
import * as Thread from "std/thread"

function* later(scope: Thread.Scope): Generator<int> uses alloc {
  yield 0
  Thread.start(scope, () => 41)
}

function* relay<T>(_value: T): Generator<int> {
  yield 1
}

export function run(_args: Array<string>): int {
  const steps = Thread.scope((scope) => later(scope))
  const relayed = Thread.scope((scope) => relay(scope))
  for (const step of steps) {
    print(Int.toString(step))
  }
  for (const step of relayed) {
    print(Int.toString(step))
  }
  return 0
}
