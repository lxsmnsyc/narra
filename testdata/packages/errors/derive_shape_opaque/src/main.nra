import * as Json from "std/json"
import { Shape } from "std/shape"
import * as Spans from "dso/span"
import { Span } from "dso/span"

export function run(args: Array<string>): int {
  const span = Spans.create(1, 2)
  print(Spans.save(span))
  print(Json.encode(span))
  print(Json.encode([span]))
  const _ = Shape.toValue(span)
  const decoded = Json.decode<Span>("{\"start\":3,\"finish\":1}")
  if (decoded is Ok(_)) {
    return 1
  }
  return 0
}
