// typeof reads the parameters written before it in a signature, and locals.
import * as Int from "std/int"

function helper(value: int): int {
  return value
}

function twin(_first: int, second: typeof _first): int {
  const copied: typeof second = 0
  return copied + 1
}

export function run(_args: Array<string>): int {
  const probe: int = 2
  const mirror: typeof probe = 3
  const handler: typeof helper = helper
  print(Int.toString(twin(mirror, mirror) + handler(1)))
  return 0
}
