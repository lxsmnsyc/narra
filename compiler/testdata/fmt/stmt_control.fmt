function f(a: int) {
  if (a > 1) {
    print("big")
  }
  if (a > 1) {
    print("big")
  } else {
    print("small")
  }
  if (a == 1) {
    print("one")
  } else if (a == 2) {
    print("two")
  } else if (a == 3) {
    print("three")
  } else {
    print("many")
  }
  while (a > 0) {
    a = a - 1
    if (a == 5) {
      break
    }
    continue
  }
  outer: while (true) {
    inner: for (const item of items) {
      if (item == 1) {
        continue outer
      }
      break inner
    }
  }
  for (const item of items) {
    print(item)
  }
  for (let counter of items) {
    print(counter)
  }
  for (const #[first, second] of pairs) {
    print(first)
  }
  for (const Some(inside) of options) {
    print(inside)
  }
}
