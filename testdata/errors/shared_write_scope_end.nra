// error: Arrays.push(mutable items, ...) may change items, which load.items still holds until its block ends at line 21
// load is never used after items takes its array, but it holds the array
// until its block ends, so the push would copy it.
import * as Arrays from "std/array"
import * as Int from "std/int"

struct Load {
  items: Array<int>
}

function build(): Load uses alloc {
  return Load { items: [1] }
}

export function run(_args: Array<string>): int uses io, alloc {
  const load = build()
  let items = load.items
  Arrays.push(mutable items, 2)
  print(Int.toString(Arrays.length(items)))
  return 0
}
