// A match in value position: an arm written as a block is a block
// expression, so `return` ends the arm and gives its value.
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"

enum Shape {
  Circle(radius: int)
  Rect(width: int, height: int)
  Name(text: string)
  Empty
}

function twice(text: string): string {
  return `${text}${text}`
}

function describe(shape: Shape): string {
  // initializer: expression arms, block arms, a guard, payload bindings
  const text = match (shape) {
    Shape.Circle(radius) if (radius > 10) => "big circle"
    Shape.Circle(radius) => {
      if (radius == 0) {
        return "point"
      }
      return `circle ${Int.toString(radius)}`
    }
    Shape.Rect(width, height) => {
      const area = width * height
      return `rect ${Int.toString(area)}`
    }
    Shape.Name(name) => {
      // heap locals released on each path
      const copy = twice(name)
      if (Str.length(copy) > 6) {
        const longer = twice(copy)
        return longer
      }
      return copy
    }
    Shape.Empty => "empty"
  }
  return text
}

function add(a: int, b: int): int {
  return a + b
}

function total(items: Array<int>, mode: int): int {
  // argument position, with a loop inside an arm
  return add(
    10,
    match (mode) {
      0 => 0
      1 => {
        let sum = 0
        for (const item of Arrays.values(items)) {
          if (item < 0) {
            return -1
          }
          sum = sum + item
        }
        return sum
      }
      _ => 100
    },
  )
}

function nested(a: int, b: int): int {
  // a value match inside a block expression inside an arm
  const value = match (a) {
    0 => {
      const inner = match (b) {
        0 => 1
        _ => {
          return b * 2
        }
      }
      return inner + 100
    }
    _ => a
  }
  return value
}

// a statement match keeps its meaning: return leaves the function
function early(shape: Shape): int {
  match (shape) {
    Shape.Circle(radius) => {
      return radius
    }
    Shape.Rect(width, _) => {
      return width
    }
    _ => {}
  }
  return -1
}

// a returned match with a tail call and a block arm
function countdown(n: int, acc: int): int {
  return match (n) {
    0 => acc
    1 => {
      return acc + 1000
    }
    _ => countdown(n - 1, acc + n)
  }
}

export function run(args: Array<string>): int {
  print(describe(Shape.Circle(50)))
  print(describe(Shape.Circle(0)))
  print(describe(Shape.Circle(3)))
  print(describe(Shape.Rect(3, 4)))
  print(describe(Shape.Name("ab")))
  print(describe(Shape.Name("abcd")))
  print(describe(Shape.Empty))
  print(Int.toString(total([1, 2, 3], 0)))
  print(Int.toString(total([1, 2, 3], 1)))
  print(Int.toString(total([1, -2, 3], 1)))
  print(Int.toString(total([1], 5)))
  print(Int.toString(nested(0, 0)))
  print(Int.toString(nested(0, 4)))
  print(Int.toString(nested(7, 0)))
  print(Int.toString(early(Shape.Circle(9))))
  print(Int.toString(early(Shape.Rect(5, 1))))
  print(Int.toString(early(Shape.Empty)))
  print(Int.toString(countdown(4, 0)))
  return 0
}
