// Type resolution, ported from check_types.go (resolveType, resolveFields,
// resolveVariants, buildGeneric, instantiate, substitute), check_patterns.go
// (tupleType, tupleOf), check_closure.go (funcResult) and std_map.go
// (userMap). Go interns arrays, boxes, maps and function types in tables
// for the emitter; here they are plain values and the emitter collects them.
//
// qualifiedType resolves `Alias.Name` through the module scopes
// (selfhost-check-imports, scopes.nra).
import * as Int from "std/int"
import * as Str from "std/string"
import { TypeExpr, FieldDecl, VariantDecl, Pos, Decl } from "narrac/ast"
import { quoteGo } from "narrac/parser"
import { Type, Field, Variant, StructInfo, EnumInfo, typeKeys } from "narrac/types"
import { Checker, checkMapKey, errorf, enter, lookupType, lookupGeneric, containsTypeParam } from "narrac/check"
import { makeEnv, checkPolyRecursion } from "narrac/generics"
import { sourceScope, exported } from "narrac/scopes"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

// resolveOpt resolves an optional type; a missing one is void.
export function resolveOpt(mutable checker: Checker, typeExpr: Option<TypeExpr>): Type uses alloc {
  if (typeExpr is Some(present)) {
    return resolveType(mutable checker, present)
  }
  return Type.TVoid
}

// funcResult resolves the result of a function type, where `void` means the
// function returns nothing.
export function funcResult(mutable checker: Checker, typeExpr: Option<Box<TypeExpr>>): Type uses alloc {
  if (typeExpr is Some(boxed)) {
    const resultExpr = boxed.value
    if (resultExpr.name == "void" && Arrays.length(resultExpr.args) == 0 && !resultExpr.isFunc) {
      return Type.TVoid
    }
    return resolveType(mutable checker, resultExpr)
  }
  return Type.TVoid
}

export function resolveType(mutable checker: Checker, typeExpr: TypeExpr): Type uses alloc {
  if (typeExpr.isFunc) {
    let params: Array<Type> = []
    for (const argument of Arrays.values(typeExpr.args)) {
      Arrays.push(mutable params, resolveType(mutable checker, argument))
    }
    return Type.TFunc(params, funcResult(mutable checker, typeExpr.result))
  }
  if (typeExpr.isTuple) {
    return tupleType(mutable checker, typeExpr)
  }
  const argCount = Arrays.length(typeExpr.args)
  if (checker.env[typeExpr.name] is Some(paramType)) {
    if (argCount == 0) {
      return paramType
    }
  }
  if (Str.contains(typeExpr.name, ".")) {
    return qualifiedType(mutable checker, typeExpr)
  }
  if (typeExpr.name == "Box" && !userType(checker, "Box")) {
    if (argCount != 1) {
      errorf(mutable checker, typeExpr.pos, "Box takes one type argument")
      return Type.TVoid
    }
    return Type.TBox(resolveType(mutable checker, typeExpr.args[0]))
  }
  if (typeExpr.name == "Map" && !userType(checker, "Map")) {
    if (argCount != 2) {
      errorf(mutable checker, typeExpr.pos, "Map takes two type arguments")
      return Type.TVoid
    }
    const keyType = resolveType(mutable checker, typeExpr.args[0])
    const valueType = resolveType(mutable checker, typeExpr.args[1])
    checkMapKey(mutable checker, typeExpr.pos, keyType)
    return Type.TMap(keyType, valueType)
  }
  if (typeExpr.name == "Array") {
    if (argCount != 1) {
      errorf(mutable checker, typeExpr.pos, "Array takes one type argument")
      return Type.TVoid
    }
    return Type.TArray(resolveType(mutable checker, typeExpr.args[0]))
  }
  if (typeExpr.name == "number") {
    errorf(mutable checker, typeExpr.pos, "there is no `number`; use `int` or `f64`")
    return Type.TInt
  }
  if (typeExpr.name == "boolean") {
    errorf(mutable checker, typeExpr.pos, "use `bool`")
    return Type.TBool
  }
  if (lookupGeneric(checker, typeExpr.name) is Some(generic)) {
    const want = Arrays.length(checker.generics[generic].params)
    if (argCount != want) {
      errorf(mutable checker, typeExpr.pos, `${typeExpr.name} takes ${Int.toString(want)} type arguments`)
      return Type.TVoid
    }
    let args: Array<Type> = []
    for (const argument of Arrays.values(typeExpr.args)) {
      Arrays.push(mutable args, resolveType(mutable checker, argument))
    }
    return instantiate(mutable checker, generic, args)
  }
  const named = lookupType(checker, typeExpr.name)
  if (named is None && typeExpr.name == "Tuple") {
    errorf(mutable checker, typeExpr.pos, "there is no Tuple type; write a tuple type as #[A, B]")
    return Type.TVoid
  }
  if (argCount > 0) {
    errorf(mutable checker, typeExpr.pos, `type ${typeExpr.name} is not generic`)
    return Type.TVoid
  }
  if (named is Some(namedType)) {
    return namedType
  }
  errorf(mutable checker, typeExpr.pos, `unknown type ${quoteGo(typeExpr.name)}`)
  return Type.TVoid
}

// qualifiedType resolves `Alias.Name`, where Alias is a namespace import of
// a package module and Name a type it exports (Go's qualifiedType).
function qualifiedType(mutable checker: Checker, typeExpr: TypeExpr): Type uses alloc {
  const alias = Str.split(typeExpr.name, ".")[0]
  const name = Str.sliceFrom(typeExpr.name, Str.length(alias) + 1)
  let scope = -1
  if (checker.scopes[checker.cur].modules[alias] is Some(path)) {
    scope = sourceScope(checker, path)
  }
  if (scope < 0) {
    errorf(mutable checker, typeExpr.pos, `unknown module ${quoteGo(alias)} in type ${typeExpr.name}; import it with \`import * as ${alias} from "..."\``)
    return Type.TVoid
  }
  const found = exported(mutable checker, typeExpr.pos, scope, name)
  if (found is None) {
    return Type.TVoid
  }
  let isType = false
  match (found) {
    Some(decl) => {
      isType = match (decl) {
        Decl.Struct(_) => true
        Decl.Enum(_) => true
        Decl.Distinct(_) => true
        _ => false
      }
    }
    None => {}
  }
  if (!isType) {
    errorf(mutable checker, typeExpr.pos, `${typeExpr.name} is not a type`)
    return Type.TVoid
  }
  const argCount = Arrays.length(typeExpr.args)
  if (checker.scopes[scope].generics[name] is Some(generic)) {
    if (checker.scopes[scope].types[name] is None) {
      const want = Arrays.length(checker.generics[generic].params)
      if (argCount != want) {
        errorf(mutable checker, typeExpr.pos, `${typeExpr.name} takes ${Int.toString(want)} type arguments`)
        return Type.TVoid
      }
      let args: Array<Type> = []
      for (const argument of Arrays.values(typeExpr.args)) {
        Arrays.push(mutable args, resolveType(mutable checker, argument))
      }
      return instantiate(mutable checker, generic, args)
    }
  }
  if (argCount > 0) {
    errorf(mutable checker, typeExpr.pos, `type ${typeExpr.name} is not generic`)
    return Type.TVoid
  }
  if (checker.scopes[scope].types[name] is Some(namedType)) {
    return namedType
  }
  return Type.TVoid
}

// userType reports whether the module declares its own type with this name
// (Box or Map), which hides the builtin.
function userType(checker: Checker, name: string): bool {
  return lookupGeneric(checker, name) is Some(_) || lookupType(checker, name) is Some(_)
}

// tupleType resolves #[A, B, ...].
function tupleType(mutable checker: Checker, typeExpr: TypeExpr): Type uses alloc {
  const count = Arrays.length(typeExpr.args)
  if (count < 2) {
    errorf(mutable checker, typeExpr.pos, `a tuple type needs at least two element types, found ${Int.toString(count)}`)
    return Type.TVoid
  }
  let elements: Array<Type> = []
  for (const argument of Arrays.values(typeExpr.args)) {
    Arrays.push(mutable elements, resolveType(mutable checker, argument))
  }
  return findTupleType(mutable checker, elements)
}

// findTupleType returns the one tuple type with these element types: a prelude
// struct named Tuple whose fields are "0", "1", ...
export function findTupleType(mutable checker: Checker, elements: Array<Type>): Type uses alloc {
  const key = `T|${typeKeys(elements)}`
  if (checker.instances[key] is Some(type)) {
    return type
  }
  let fields: Array<Field> = []
  for (const index of Ranges.between(0, Arrays.length(elements))) {
    Arrays.push(mutable fields, Field { name: Int.toString(index), fieldType: elements[index], default: None, pos: zeroPos() })
  }
  const type = Type.TStruct(Arrays.length(checker.structs))
  Arrays.push(mutable checker.structs, StructInfo { name: "Tuple", module: "", scope: 0, pos: zeroPos(), opaque: false, tuple: true, args: elements, generic: -1, fields: fields })
  checker.instances[key] = type
  Arrays.push(mutable checker.instTypes, type)
  // Tuples derive Show and Ordered: findTypeTraits (traits.nra) makes that
  // entry on first use.
  return type
}

function zeroPos(): Pos {
  return Pos { line: 0, col: 0 }
}

export function resolveFields(mutable checker: Checker, decls: Array<FieldDecl>): Array<Field> uses alloc {
  let fields: Array<Field> = []
  let seen: Map<string, bool> = Map {}
  for (const fieldDecl of Arrays.values(decls)) {
    if (seen[fieldDecl.name] is Some(_)) {
      errorf(mutable checker, fieldDecl.pos, `field ${quoteGo(fieldDecl.name)} is declared twice`)
    }
    seen[fieldDecl.name] = true
    const fieldType = resolveType(mutable checker, fieldDecl.type)
    Arrays.push(mutable fields, Field { name: fieldDecl.name, fieldType: fieldType, default: fieldDecl.default, pos: fieldDecl.pos })
  }
  return fields
}

export function resolveVariants(mutable checker: Checker, decls: Array<VariantDecl>): Array<Variant> uses alloc {
  let variants: Array<Variant> = []
  for (const index of Ranges.between(0, Arrays.length(decls))) {
    const fields = resolveFields(mutable checker, decls[index].fields)
    Arrays.push(mutable variants, Variant { name: decls[index].name, index: index, fields: fields })
  }
  return variants
}

// buildGeneric resolves a generic declaration's fields with its parameters
// left open, in the declaring module. Instances substitute into this
// template. It runs once; an instance made while the template is being
// built (a self-reference) is filled when the build ends, as in Go.
export function buildGeneric(mutable checker: Checker, generic: int) uses alloc {
  if (checker.generics[generic].built) {
    return
  }
  checker.generics[generic].built = true
  checker.generics[generic].building = true
  const info = checker.generics[generic]
  const savedScope = enter(mutable checker, info.scope)
  const savedEnv = checker.env
  checker.env = makeEnv(checker, info.params)
  if (info.isStruct) {
    let fields = resolveFields(mutable checker, info.fieldDecls)
    for (const index of Ranges.between(0, Arrays.length(fields))) {
      if (fields[index].default is Some(_) && containsTypeParam(checker, fields[index].fieldType)) {
        errorf(mutable checker, info.fieldDecls[index].pos, "a default for a field whose type uses a type parameter is not supported by this compiler yet")
        fields[index].default = None
      }
    }
    // Go checks the defaults here; the body checker (body.nra) checks the
    // queued ones after the module's declarations.
    if (checker.checkingBodies) {
      Arrays.push(mutable checker.pendingDefaults, generic)
    }
    checker.generics[generic].fields = fields
  } else {
    const variants = resolveVariants(mutable checker, info.variantDecls)
    checker.generics[generic].variants = variants
  }
  checker.env = savedEnv
  checkPolyRecursion(mutable checker, generic)
  checker.generics[generic].building = false
  const pending = checker.generics[generic].pending
  checker.generics[generic].pending = []
  for (const instance of Arrays.values(pending)) {
    fillInstance(mutable checker, generic, instance)
  }
  enter(mutable checker, savedScope)
}

// instantiate returns the instance of a generic for its type arguments, creating it on
// first use. The instance is cached before its fields are substituted, so a
// template that holds itself (List<T> in Array<List<T>>) finds it; it joins
// instTypes after its fields, as in Go.
export function instantiate(mutable checker: Checker, generic: int, args: Array<Type>): Type uses alloc {
  buildGeneric(mutable checker, generic)
  const key = `${Int.toString(generic)}|${typeKeys(args)}`
  if (checker.instances[key] is Some(type)) {
    return type
  }
  const info = checker.generics[generic]
  let pos = info.pos
  if (info.module == "") {
    pos = zeroPos()
  }
  let type = Type.TEnum(Arrays.length(checker.enums))
  if (info.isStruct) {
    type = Type.TStruct(Arrays.length(checker.structs))
    Arrays.push(mutable checker.structs, StructInfo { name: info.name, module: info.module, scope: info.scope, pos: pos, opaque: info.opaque, tuple: false, args: args, generic: generic, fields: [] })
  } else {
    Arrays.push(mutable checker.enums, EnumInfo { name: info.name, module: info.module, scope: info.scope, pos: pos, args: args, generic: generic, variants: [] })
  }
  checker.instances[key] = type
  if (info.building) {
    Arrays.push(mutable checker.generics[generic].pending, type)
    return type
  }
  fillInstance(mutable checker, generic, type)
  return type
}

// fillInstance copies the template's fields into the instance, substituting
// its type arguments, and adds it to instTypes.
function fillInstance(mutable checker: Checker, generic: int, instance: Type) uses alloc {
  const info = checker.generics[generic]
  let bindings: Map<int, Type> = Map {}
  if (instance is Type.TStruct(index)) {
    const args = checker.structs[index].args
    for (const i of Ranges.between(0, Arrays.length(info.params))) {
      bindings[info.params[i]] = args[i]
    }
    let fields: Array<Field> = []
    for (const field of Arrays.values(info.fields)) {
      const fieldType = substitute(mutable checker, field.fieldType, bindings)
      Arrays.push(mutable fields, Field { name: field.name, fieldType: fieldType, default: field.default, pos: field.pos })
    }
    checker.structs[index].fields = fields
  } else if (instance is Type.TEnum(index)) {
    const args = checker.enums[index].args
    for (const i of Ranges.between(0, Arrays.length(info.params))) {
      bindings[info.params[i]] = args[i]
    }
    let variants: Array<Variant> = []
    for (const variant of Arrays.values(info.variants)) {
      let fields: Array<Field> = []
      for (const field of Arrays.values(variant.fields)) {
        const fieldType = substitute(mutable checker, field.fieldType, bindings)
        Arrays.push(mutable fields, Field { name: field.name, fieldType: fieldType, default: None, pos: field.pos })
      }
      Arrays.push(mutable variants, Variant { name: variant.name, index: variant.index, fields: fields })
    }
    checker.enums[index].variants = variants
  }
  Arrays.push(mutable checker.instTypes, instance)
}

// substitute replaces the parameters in a type by their bindings, creating the
// instances it names.
export function substitute(mutable checker: Checker, type: Type, bindings: Map<int, Type>): Type uses alloc {
  match (type) {
    Type.TParam(param) => {
      if (bindings[param] is Some(bound)) {
        return bound
      }
      return type
    }
    Type.TArray(element) => {
      return Type.TArray(substitute(mutable checker, element, bindings))
    }
    Type.TBox(element) => {
      return Type.TBox(substitute(mutable checker, element, bindings))
    }
    Type.TMap(key, value) => {
      const newKey = substitute(mutable checker, key, bindings)
      return Type.TMap(newKey, substitute(mutable checker, value, bindings))
    }
    Type.TFunc(parameters, result) => {
      if (!containsTypeParam(checker, type)) {
        return type
      }
      const newParams = substituteAll(mutable checker, parameters, bindings)
      return Type.TFunc(newParams, substitute(mutable checker, result, bindings))
    }
    Type.TStruct(index) => {
      const info = checker.structs[index]
      if (Arrays.length(info.args) == 0) {
        return type
      }
      const args = substituteAll(mutable checker, info.args, bindings)
      if (info.tuple) {
        return findTupleType(mutable checker, args)
      }
      return instantiate(mutable checker, info.generic, args)
    }
    Type.TEnum(index) => {
      const info = checker.enums[index]
      if (Arrays.length(info.args) == 0) {
        return type
      }
      const args = substituteAll(mutable checker, info.args, bindings)
      return instantiate(mutable checker, info.generic, args)
    }
    _ => {
      return type
    }
  }
}

export function substituteAll(mutable checker: Checker, types: Array<Type>, bindings: Map<int, Type>): Array<Type> uses alloc {
  let out: Array<Type> = []
  for (const type of Arrays.values(types)) {
    Arrays.push(mutable out, substitute(mutable checker, type, bindings))
  }
  return out
}
