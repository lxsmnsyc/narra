// error: Function `pure` uses `io` (through `print`) but its signature does not declare it
function inner(v: int): int uses io {
  print("side effect")
  return v + 1
}

const first = inner
const step: (v: int) => int = first

export function pure(): int {
  return step(2)
}

export function run(args: Array<string>): int {
  return pure()
}
