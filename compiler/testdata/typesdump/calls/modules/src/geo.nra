export enum Shape {
  Circle(radius: int)
  Dot
}

export enum Wrapped<T> {
  One(value: T)
  Zero
}

export opaque distinct type Meters = int

export function meters(value: int): Meters {
  return Meters.from(value)
}

export function area(shape: Shape): int {
  return 3
}

export function same<T>(value: T): T {
  return keep(value)
}

function keep<T>(value: T): T {
  return value
}
