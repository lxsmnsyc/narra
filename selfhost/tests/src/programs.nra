// The programs suite: every testdata/*.nra, testdata/simd/*.nra and testdata/stage2/*.nra is built
// and run, and its stdout must equal the .out file next to it. Debug runs
// build with the sanitizers (narrac -sanitize) and the leak check; release
// runs build with -release. Samples that run their test blocks (tests.nra,
// std_test*, coroutine_tests*) go through `narrac test`. A .in file is the
// program's stdin. The stage2 folder holds samples for std modules written in
// Narra, and runs in debug mode only. Every sample runs with the debug copy
// check on (testrunner/copies). A sample whose output depends on the build has
// <name>.release.out for the release run, and one whose output depends on the
// host has <name>.<system>.out instead of <name>.out (darwin or linux, from
// `uname -s`).
import * as Fs from "std/fs"
import * as Path from "std/path"
import * as Process from "std/process"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Common from "testrunner/context"
import * as Copies from "testrunner/copies"
import { Context, TestCase } from "testrunner/context"
import * as Files from "testrunner/files"

export function collectCases(context: Context): Array<TestCase> uses io, alloc {
  let cases: Array<TestCase> = []
  for (const path of Arrays.values(Files.listPaths(context.testdata, ".nra"))) {
    addCases(mutable cases, path, Path.basename(path), ["debug", "release"])
  }
  // The std/simd samples (D112) have a folder of their own.
  const simd = Path.join(context.testdata, "simd")
  for (const path of Arrays.values(Files.listPaths(simd, ".nra"))) {
    addCases(mutable cases, path, `simd/${Path.basename(path)}`, ["debug", "release"])
  }
  const stage2 = Path.join(context.testdata, "stage2")
  for (const path of Arrays.values(Files.listPaths(stage2, ".nra"))) {
    addCases(mutable cases, path, `stage2/${Path.basename(path)}`, ["debug"])
  }
  return cases
}

function addCases(
  mutable cases: Array<TestCase>,
  path: string,
  name: string,
  variants: Array<string>,
) uses alloc {
  for (const variant of Arrays.values(variants)) {
    Arrays.push(mutable cases, TestCase {
      suite: "programs",
      name: `${name}/${variant}`,
      path: path,
      variant: variant,
    })
  }
}

export function runCase(context: Context, testCase: TestCase): Result<bool, string> uses io, alloc {
  const want = Common.readExpected(findExpectedPath(testCase))
  if (want is Err(message)) {
    return Err(message)
  }
  const base = Path.basename(testCase.path)
  const runsTests =
    base == "tests.nra" ||
      Str.startsWith(base, "std_test") ||
      Str.startsWith(base, "coroutine_tests")
  let arguments = ["run"]
  if (runsTests) {
    arguments = ["test"]
  }
  if (testCase.variant == "release") {
    Arrays.push(mutable arguments, "-release")
  } else {
    Arrays.push(mutable arguments, "-sanitize")
  }
  // <name>.in is the program's stdin; other programs read /dev/null.
  const input = Files.replaceSuffix(testCase.path, ".nra", ".in")
  if (!runsTests && Fs.exists(input)) {
    Arrays.push(mutable arguments, "-stdin")
    Arrays.push(mutable arguments, input)
  }
  Arrays.push(mutable arguments, testCase.path)
  const result = Common.runNarrac(context, arguments)
  return Copies.checkCopyRun(context, testCase, result, want.value)
}

function findExpectedPath(testCase: TestCase): string uses io, alloc {
  const stem = Files.replaceSuffix(testCase.path, ".nra", "")
  const release = `${stem}.release.out`
  if (testCase.variant == "release" && Fs.exists(release)) {
    return release
  }
  const plain = `${stem}.out`
  if (Fs.exists(plain)) {
    return plain
  }
  return `${stem}.${readHostSystem()}.out`
}

export function readHostSystem(): string uses io, alloc {
  const ran = Process.run("uname", ["-s"])
  if (ran is Ok(#[code, output, _])) {
    // The golden names are in lower case.
    const system = Str.trim(output)
    if (code == 0 && system == "Darwin") {
      return "darwin"
    }
    if (code == 0 && system == "Linux") {
      return "linux"
    }
  }
  return "unknown"
}
