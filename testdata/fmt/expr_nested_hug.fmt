// Thirty nested last-argument callbacks: the hug layout must not print a
// part of the document twice (it once took exponential time).
const nested = call(argument, (value) => {
  return call(argument, (value) => {
    return call(argument, (value) => {
      return call(argument, (value) => {
        return call(argument, (value) => {
          return call(argument, (value) => {
            return call(argument, (value) => {
              return call(argument, (value) => {
                return call(argument, (value) => {
                  return call(argument, (value) => {
                    return call(argument, (value) => {
                      return call(argument, (value) => {
                        return call(argument, (value) => {
                          return call(argument, (value) => {
                            return call(argument, (value) => {
                              return call(argument, (value) => {
                                return call(argument, (value) => {
                                  return call(argument, (value) => {
                                    return call(argument, (value) => {
                                      return call(argument, (value) => {
                                        return call(argument, (value) => {
                                          return call(argument, (value) => {
                                            return call(argument, (value) => {
                                              return call(argument, (value) => {
                                                return call(argument, (value) => {
                                                  return call(argument, (value) => {
                                                    return call(argument, (value) => {
                                                      return call(argument, (value) => {
                                                        return call(argument, (value) => {
                                                          return call(argument, (value) => {
                                                            return 1
                                                          })
                                                        })
                                                      })
                                                    })
                                                  })
                                                })
                                              })
                                            })
                                          })
                                        })
                                      })
                                    })
                                  })
                                })
                              })
                            })
                          })
                        })
                      })
                    })
                  })
                })
              })
            })
          })
        })
      })
    })
  })
})
