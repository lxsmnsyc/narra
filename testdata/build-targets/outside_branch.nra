// error: outside_branch.nra:17:23: linuxSeparator exists only on @target(os = Os.Linux), but this use is compiled for MacOS-Arm64, MacOS-X86_64; ...
// An ordinary if guarantees no target, so the use fails on both macOS targets,
// reported once
// (checked with --all-targets, so the output is the same on every host).
import * as Arrays from "std/array"
import { Os } from "std/build"

@target(os = Os.Linux)
function linuxSeparator(): string {
  return "/"
}

export function run(args: Array<string>): int {
  if (Arrays.length(args) > 0) {
    print("has a program name")
  }
  print(linuxSeparator())
  return 0
}
