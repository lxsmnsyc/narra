// error: let_narrowing_mutable_arg.nra:12:12: this Option<int> may hold any of its variants
function clear(mutable x: Option<int>) {
  x = None
}

export function run(args: Array<string>): int {
  let x: Option<int> = Some(1)
  if (x is None) {
    return 0
  }
  clear(mutable x)
  return x.value
}
