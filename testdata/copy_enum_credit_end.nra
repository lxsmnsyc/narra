// A copy(...) of a recursive enum gives credits to the arrays in its payload.
// Those credits end with the copy: a later hidden copy of one of the
// original's arrays is still reported (copy_enum_credit_end.copies).
import * as Int from "std/int"
import * as Arrays from "std/array"

enum Tree {
  Leaf(cells: Array<int>)
  Node(left: Tree, right: Tree)
}

function readCopy(tree: Tree): int {
  const other = copy(tree)
  return match (other) { Tree.Leaf(cells) => cells[0], Tree.Node(_, _) => 0 }
}

// The static rule does not follow a mutable argument of a user function, so
// it does not see that lists now shares cells.
function keep(mutable lists: Array<Array<int>>, cells: Array<int>) {
  Arrays.push(mutable lists, cells)
}

export function run(args: Array<string>): int {
  const tree = Tree.Node(Tree.Leaf([1, 2]), Tree.Leaf([3]))
  // A copy that ends before the write below.
  print(`copy ${Int.toString(readCopy(tree))}`)
  // A hidden copy on write: no live copy(...) explains it.
  let lists: Array<Array<int>> = []
  if (tree is Tree.Node(Tree.Leaf(cells), _)) {
    keep(mutable lists, cells)
  }
  lists[0][0] = 9
  print(`list ${Int.toString(lists[0][0])}`)
  print(`tree ${Int.toString(match (tree) { Tree.Node(Tree.Leaf(cells), _) => cells[0], _ => 0 })}`)
  return 0
}
