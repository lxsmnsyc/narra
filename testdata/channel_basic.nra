// The SPEC sample of section 8 "Channels": a thread sends 100 numbers through
// a channel of 16 slots and closes it; the main thread prints them in order.
// The thread function returns nothing, so Thread.start gives a Thread<void>.
import * as Channel from "std/channel"
import * as Thread from "std/thread"
import * as Int from "std/int"
import * as Ranges from "std/range"

export function run(_args: Array<string>): int {
  return Thread.scope((scope) => {
    const #[sender, receiver] = Channel.create<int>(16) // holds up to 16 values

    Thread.start(scope, () => {
      for (const i of Ranges.upTo(100)) {
        Channel.send(sender, i) // blocks while the channel is full
      }
      Channel.close(sender)
    })

    for (const value of Channel.values(receiver)) {
      // ends when the channel is closed and empty
      print(Int.toString(value))
    }
    return 0
  })
}
