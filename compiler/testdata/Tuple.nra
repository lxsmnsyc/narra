import * as Int from "std/int"

// This file is module "Tuple". Its types are named S_Tuple__..., so tuple
// types must use a C name no module can produce: #[Array<int>, Foo] and
// A_int<Foo> would otherwise both be S_Tuple__A_int__S_Tuple__Foo.

struct Foo {
  n: int
}

struct A_int<T> {
  item: T
}

export function run(args: Array<string>): int {
  const t: #[Array<int>, Foo] = #[[1, 2], Foo { n: 3 }]
  const a = A_int { item: Foo { n: 4 } }
  const #[xs, foo] = t
  print(`${Int.toString(xs[1])} ${Int.toString(foo.n)} ${Int.toString(a.item.n)}`)
  return 0
}
