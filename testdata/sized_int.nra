import * as Arrays from "std/array"
import * as Maps from "std/map"

struct Pixel derives Equatable, Hashable, Ordered, Show {
  red: u8
  green: u8
  alpha: u16
  depth: i8
}

function widen(value: u32): u32 {
  return value * 2
}

function show<T: Show>(value: T) uses alloc {
  print(Show.show(value))
}

export function run(args: Array<string>): int uses io, alloc {
  // Minimum and maximum of each type, written as literals.
  const minI8: i8 = -128
  const maxI8: i8 = 127
  const minI16: i16 = -32768
  const maxI16: i16 = 32767
  const minI32: i32 = -2147483648
  const maxI32: i32 = 2147483647
  const maxU8: u8 = 255
  const maxU16: u16 = 65535
  const maxU32: u32 = 4294967295
  const maxU64: u64 = 18446744073709551615
  const hexU64: u64 = 0xFFFF_FFFF_FFFF_FFFF
  const minI64: i64 = -9223372036854775807
  show(minI8)
  show(maxI8)
  show(minI16)
  show(maxI16)
  show(minI32)
  show(maxI32)
  show(maxU8)
  show(maxU16)
  show(maxU32)
  show(maxU64)
  show(hexU64 == maxU64)
  show(minI64)

  // Arithmetic in each type, literals typed from the other operand.
  const a: i8 = 100
  show(a - 50)
  show(-a)
  const b: i16 = 1000
  show(b * 30)
  const c: i32 = 100000
  show(c / 7)
  show(c % 7)
  const d: u8 = 200
  show(d + 55)
  show(d / 3)
  show(d & 15)
  show(d | 1)
  show(d ^ 255)
  show(~d)
  show(d >> 3)
  show(d << 1 >> 1)
  const e: u16 = 40000
  show(e - 1)
  const f: u32 = 4000000000
  show(widen(1000))
  show(f - 1)
  const g: u64 = 10000000000000000000
  show(g + 1)
  show(g / 3)
  show(1 + d)

  // Wrapping operators at the width.
  show(maxI8 +% 1)
  show(minI8 -% 1)
  show(maxI8 *% 2)
  show(maxU8 +% 1)
  show(maxU16 *% 2)
  show(maxU32 +% 1)
  show(maxU64 +% 2)
  show(maxI32 +% 1)

  // Fields, arrays, maps, equality, ordering and Show.
  const pixel = Pixel { red: 255, green: 128, alpha: 65535, depth: -5 }
  const other = Pixel { red: 255, green: 128, alpha: 65535, depth: -4 }
  show(pixel)
  show(pixel == other)
  show(Ordered.compare(pixel, other))
  show(pixel.alpha)
  let bytes: Array<u8> = [1, 2, 255]
  Arrays.push(mutable bytes, 7)
  show(bytes)
  let names: Map<u16, string> = Map { 80: "http", 443: "https" }
  names[8080] = "alt"
  show(names[443])
  show(names[8080])
  show(names[1])
  match (maxU8) { 255 => print("match 255"), _ => print("other") }
  if (maxU64 > 5 && minI8 < 0) {
    print("ordered")
  }
  return 0
}
