// Sibling arms of a value match are exclusive: one arm passes x as mutable,
// another reads it.
import * as Int from "std/int"

function bump(mutable n: int): int {
  n = n + 1
  return 1
}

function pick(mode: int): int {
  let x = 5
  const result = match (mode) {
    0 => {
      return bump(mutable x)
    }
    1 => {
      return x + 100
    }
    _ => x
  }
  return result + x
}

export function run(args: Array<string>): int {
  print(Int.toString(pick(0)))
  print(Int.toString(pick(1)))
  print(Int.toString(pick(2)))
  return 0
}
