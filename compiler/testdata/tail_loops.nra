// Self calls in tail position run as loops: 10 million of them do not
// grow the stack. Heap parameters keep correct counts, and calls that do
// more work after the call stay plain calls.
import * as Int from "std/int"
import * as Arrays from "std/array"

function count(n: int, acc: int): int {
  if (n == 0) {
    return acc
  }
  return count(n - 1, acc + 1)
}

// A string and an array parameter, replaced on every jump.
function fold(n: int, label: string, items: Array<int>): string {
  if (n == 0) {
    return `${label}:${Int.toString(Arrays.length(items))}`
  }
  const next = Arrays.filled(n, 2)
  return fold(n - 1, `x${Int.toString(n % 3)}`, next)
}

// Swapped parameters.
function swap(n: int, a: string, b: string): string {
  if (n == 0) {
    return `${a}${b}`
  }
  return swap(n - 1, b, a)
}

// A parameter passed on as it is.
function search(items: Array<int>, begin: int, target: int): int {
  if (begin >= Arrays.length(items)) {
    return -1
  }
  if (items[begin] == target) {
    return begin
  }
  return search(items, begin + 1, target)
}

// A mutable parameter passed on as it is.
function fillTail(mutable out: Array<int>, n: int): int {
  if (n == 0) {
    return Arrays.length(out)
  }
  Arrays.push(mutable out, n)
  return fillTail(mutable out, n - 1)
}

// A tail call inside a loop body.
function find(items: Array<int>, target: int, tries: int): int {
  for (const x of Arrays.values(items)) {
    if (x == target) {
      if (tries < 3) {
        return find(items, target, tries + 1)
      }
      return tries
    }
  }
  return -1
}

// Not tail calls: more work follows the call.
function depth(n: int): int {
  if (n == 0) {
    return 0
  }
  return 1 + depth(n - 1)
}

export function run(args: Array<string>): int {
  print(Int.toString(count(10000000, 0)))
  print(fold(10000000, "begin", [1, 2, 3]))
  print(swap(10000001, "a", "b"))
  print(Int.toString(search([4, 5, 6, 7], 0, 6)))
  print(Int.toString(search([4, 5, 6, 7], 0, 9)))
  let out: Array<int> = []
  print(Int.toString(fillTail(mutable out, 1000)))
  print(Int.toString(find([4, 5], 5, 0)))
  print(Int.toString(depth(1000)))
  return 0
}
