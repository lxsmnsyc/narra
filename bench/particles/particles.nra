import * as Int from "std/int"
import * as Arrays from "std/array"
import * as Ranges from "std/range"

struct Particle {
  x: int
  y: int
  vx: int
  vy: int
}

function move(p: Particle): Particle {
  let nx = p.x + p.vx
  let ny = p.y + p.vy
  let nvx = p.vx
  let nvy = p.vy
  if (nx < 0 || nx > 10000) {
    nvx = 0 - nvx
  }
  if (ny < 0 || ny > 10000) {
    nvy = 0 - nvy
  }
  return Particle { x: nx, y: ny, vx: nvx, vy: nvy }
}

export function run(args: Array<string>): int {
  let particles: Array<Particle> = []
  for (const i of Ranges.upTo(1000)) {
    Arrays.push(mutable particles, Particle { x: i * 7 % 10000, y: i * 13 % 10000, vx: i % 11 + 1, vy: i % 7 + 1 })
  }
  for (const round of Ranges.upTo(100000)) {
    for (const i of Ranges.upTo(1000)) {
      particles[i] = move(particles[i])
    }
  }
  let total = 0
  for (const p of Arrays.values(particles)) {
    total = total + p.x + p.y
  }
  print(Int.toString(total))
  return 0
}
