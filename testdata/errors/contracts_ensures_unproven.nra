// error: this value is not proven to match `ensures >= 0`; write a constant, a constructor, or a name checked first with an `if`
import * as Arrays from "std/array"

struct Rect {
  width: int
  height: int
}

function unchecked(value: int): int
  ensures >= 0
{
  return value
}

function findIndex(items: Array<int>, wanted: int): Option<int>
  ensures Some(>= 0) | None
{
  for (const #[index, item] of Arrays.entries(items)) {
    if (item == wanted) {
      return Some(index)
    }
  }
  return None
}

function parsePositive(value: int): Result<int, string>
  ensures Ok(> 0) | Err(_)
{
  if (value >= 0) {
    return Ok(value)
  }
  return Ok(0)
}

function splitCount(total: int): #[int, int]
  ensures #[>= 0, _]
{
  return #[total, 0]
}

function grow(rect: Rect): Rect
  ensures { width: > 0 }
{
  return Rect { ...rect, height: 1 }
}

function methodName(write: bool): string
  ensures "GET" | "POST"
{
  if (write) {
    return "PUT"
  }
  return "GET"
}

function* countUp(limit: int): Generator<int>
  ensures >= 1
{
  let current = 0
  while (current < limit) {
    yield current
    current = current + 1
  }
}

function* delegated(limit: int): Generator<int>
  ensures >= 1
{
  yield* countUp(limit)
}

function reassigned(value: int): int
  ensures > 0
{
  let result = 1
  if (value > 0) {
    result = value - 1
  }
  return result
}

function positive(value: int): int
  ensures > 0
{
  if (value > 0) {
    return value
  }
  return 1
}

function findSome(value: int): Option<int>
  ensures Some(> 0) | None
{
  if (value > 0) {
    return Some(value)
  }
  return None
}

function nonzero(value: int): int
  ensures != 0
{
  if (value >= 0) {
    return value
  }
  return 1
}

function notFive(value: int): int
  ensures != 5
{
  // A check against 5 is no fact: the prover keeps ranges and non-zero only.
  if (value != 5) {
    return value
  }
  return 4
}

function useNotFive(value: int): int {
  // `!= 5` says nothing a divisor needs.
  const result = notFive(value)
  return 10 / result
}

function useFacts(value: int): int {
  // A `let` loses the fact when it is assigned, and only a `const` keeps the result.
  let divisor = positive(value)
  divisor = value
  let found = findSome(value)
  found = Some(value)
  if (found is Some(inner)) {
    return 10 / inner + 10 / divisor
  }
  return 0
}

export function run(_args: Array<string>): int {
  return unchecked(1) + useFacts(2) + reassigned(3) + nonzero(4) + useNotFive(5)
}
