// error: Function `load` uses `io` (through `print`) but its signature does not declare it
import * as Result from "std/result"
export function load(r: Result<int, string>): Result<int, string> uses alloc {
  const noisy = (x: int): int => {
    print("hi")
    return x
  }
  return Result.map(r, noisy)
}
