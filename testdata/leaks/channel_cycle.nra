// A Sender sent through its own channel keeps the channel alive (D80): the
// queued value holds the queue that holds it, so nothing frees it and the leak
// check reports it at exit.
import * as Channel from "std/channel"
import { Sender } from "std/channel"

struct Carrier {
  sender: Sender<Carrier>
}

export function run(_args: Array<string>): int {
  const #[sender, _receiver] = Channel.create<Carrier>(1)
  if (Channel.send(sender, Carrier { sender: sender })) {
    print("sent")
  }
  return 0
}
