// `narrac fmt`: the formatter's driver, and the printing of files, imports,
// declarations and statements. Expressions, types and patterns come from the
// function fields of the Printer (contract fmt-printer).
//
//   narrac fmt [paths]      rewrite the files in place; a directory means every
//                           .nra file under it; no path means the current directory
//   narrac fmt --check ...  print each file that would change; exit 1 if any does
//   narrac fmt --stdin      (or `-`) read one file from stdin, write the result
//                           to stdout
//
// A file that does not parse prints `error <path>:<line>:<col>: <message>`, is
// left unchanged, and makes the exit code 1. The [fmt] table of the nearest
// narra.toml above each file sets the options (fmtconfig.nra).
import { splitString, substring } from "narrac/textops"
import * as Fs from "std/fs"
import * as Int from "std/int"
import * as Str from "std/string"
import * as Arrays from "std/array"
import * as Ranges from "std/range"
import * as Docs from "narrac/fmtdoc"
import * as Exprs from "narrac/fmtexprs"
import { Doc, Options } from "narrac/fmtdoc"
import * as Lexer from "narrac/lexer"
import * as Parser from "narrac/parser"
import {
  Trivia,
  CommentKind,
  Placement,
  getPosKey,
  getIdKey,
  getDeclPos,
  getStmtPos,
  getExprId,
  getPatternId,
  getPatternStart,
} from "narrac/trivia"
import {
  Pos,
  File,
  ImportDecl,
  TypeExpr,
  Param,
  FuncDecl,
  ExternBlock,
  Attribute,
  ConstDecl,
  FieldDecl,
  StructDecl,
  DistinctDecl,
  AliasDecl,
  VariantDecl,
  EnumDecl,
  TraitDecl,
  ImplDecl,
  Decl,
  Block,
  Stmt,
  Expr,
  Pattern,
  YieldBinding,
  LoopReference,
} from "narrac/ast"
import { FmtConfig, getDirectory, findConfig } from "narrac/fmtconfig"
import {
  Settings,
  Printer,
  withComments,
  moveLineCommentsToTrailing,
  printDangling,
  trailingComma,
  getOffset,
  getLineStarts,
  getCommentOffsets,
  hasBlankBefore,
  hasDangling,
  hasTrailing,
  hasLeading,
  hoistTrailingComments,
  printBracketed,
  hasCommentInParens,
  getStartOffset,
  getCommentStartBefore,
  getLeadingBefore,
  removeComments,
} from "narrac/fmtprinter"

// ---- Driver

function printError(text: string) {
  const _ = Fs.writeText("/dev/stderr", `${text}\n`)
}

function writeStdout(text: string): int uses io, alloc {
  const written = Fs.writeText("/dev/stdout", text)
  if (written is Err(message)) {
    printError(message)
    return 1
  }
  return 0
}

const USAGE = "usage: narrac fmt [--check] [paths] | narrac fmt --stdin"

export function runFmt(arguments: Array<string>): int uses io, alloc {
  let check = false
  let useStdin = false
  let paths: Array<string> = []
  for (const index of Ranges.between(2, Arrays.length(arguments))) {
    const argument = arguments[index]
    if (argument == "--check") {
      check = true
    } else if (argument == "--stdin" || argument == "-") {
      useStdin = true
    } else if (Str.startsWith(argument, "-")) {
      printError(USAGE)
      return 2
    } else {
      Arrays.push(mutable paths, argument)
    }
  }
  if (useStdin && Arrays.length(paths) > 0) {
    printError(USAGE)
    return 2
  }
  let configs: Map<string, FmtConfig> = Map {}
  if (useStdin) {
    return formatStdin(check, mutable configs)
  }
  if (Arrays.length(paths) == 0) {
    Arrays.push(mutable paths, ".")
  }
  let status = 0
  let files: Array<string> = []
  for (const path of Arrays.values(paths)) {
    if (Fs.listDir(path) is Ok(_)) {
      collectFiles(path, mutable files)
    } else if (Fs.exists(path)) {
      Arrays.push(mutable files, path)
    } else {
      printError(`error ${path}: no such file or directory`)
      status = 1
    }
  }
  for (const file of Arrays.values(files)) {
    if (formatFile(file, check, mutable configs) != 0) {
      status = 1
    }
  }
  return status
}

function collectFiles(directory: string, mutable files: Array<string>) uses io, alloc {
  const listed = Fs.listDir(directory)
  if (listed is Err(_)) {
    return
  }
  let names: Array<string> = []
  for (const name of Arrays.values(listed.value)) {
    Arrays.push(mutable names, name)
    for (
      let index = Arrays.length(names) - 1;
      index > 0 && names[index] < names[index - 1];
      index--
    ) {
      const swap = names[index]
      names[index] = names[index - 1]
      names[index - 1] = swap
    }
  }
  for (const name of Arrays.values(names)) {
    if (Str.startsWith(name, ".")) {
      continue
    }
    let child = name
    if (directory != "/") {
      child = `${directory}/${name}`
    }
    if (directory == ".") {
      child = name
    }
    if (Fs.listDir(child) is Ok(_)) {
      collectFiles(child, mutable files)
    } else if (Str.endsWith(name, ".nra")) {
      Arrays.push(mutable files, child)
    }
  }
}

function loadConfig(
  directory: string,
  mutable configs: Map<string, FmtConfig>,
): Result<FmtConfig, string> from configs uses io, alloc {
  if (configs[directory] is Some(known)) {
    return Ok(known)
  }
  const found = findConfig(directory)
  if (found is Ok(config)) {
    configs[directory] = config
  }
  return found
}

function formatStdin(check: bool, mutable configs: Map<string, FmtConfig>): int uses io, alloc {
  const read = Fs.readText("/dev/stdin")
  if (read is Err(message)) {
    printError(message)
    return 1
  }
  const config = loadConfig(getDirectory(".", true), mutable configs)
  if (config is Err(message)) {
    printError(`error ${message}`)
    return 1
  }
  const formatted = formatSource(read.value, config.value)
  if (formatted is Err(message)) {
    printError(`error <stdin>:${message}`)
    return 1
  }
  if (check) {
    if (formatted.value != read.value) {
      return writeStdout("<stdin>\n") + 1
    }
    return 0
  }
  return writeStdout(formatted.value)
}

function formatFile(
  path: string,
  check: bool,
  mutable configs: Map<string, FmtConfig>,
): int uses io, alloc {
  const read = Fs.readText(path)
  if (read is Err(message)) {
    printError(`error ${message}`)
    return 1
  }
  const config = loadConfig(getDirectory(path, false), mutable configs)
  if (config is Err(message)) {
    printError(`error ${message}`)
    return 1
  }
  const formatted = formatSource(read.value, config.value)
  if (formatted is Err(message)) {
    printError(`error ${path}:${message}`)
    return 1
  }
  if (formatted.value == read.value) {
    return 0
  }
  if (check) {
    const _ = writeStdout(`${path}\n`)
    return 1
  }
  const written = Fs.writeText(path, formatted.value)
  if (written is Err(message)) {
    printError(`error ${message}`)
    return 1
  }
  return 0
}

export function formatSource(text: string, config: FmtConfig): Result<string, string> uses alloc {
  const source = Str.replace(text, "\r\n", "\n")
  const traced = Parser.parseWithTrivia(source, 0)
  if (traced is Err(diagnostic)) {
    return Err(Parser.formatDiagnostic(diagnostic))
  }
  const #[parsed, trivia] = traced.value
  const printer = createPrinter(source, trivia, config)
  const document = printFile(printer, parsed.file)
  const formatted = Docs.print(document, printer.settings.options)
  // Every comment must come out again, as Prettier checks.
  const problem = findLostComment(trivia, formatted)
  if (problem is Some(message)) {
    return Err(message)
  }
  return Ok(formatted)
}

function findLostComment(trivia: Trivia, formatted: string): Option<string> uses alloc {
  const traced = Parser.parseWithTrivia(formatted, 0)
  if (traced is Err(diagnostic)) {
    return Some(`1:1: the formatted text does not parse: ${Parser.formatDiagnostic(diagnostic)}`)
  }
  const #[_parsed, after] = traced.value
  for (const index of Ranges.upTo(Arrays.length(trivia.comments))) {
    const comment = trivia.comments[index]
    if (
      index >= Arrays.length(after.comments) ||
        !isSameComment(comment.text, after.comments[index].text)
    ) {
      return Some(
        `${Int.toString(comment.pos.line)}:${Int.toString(comment.pos.column)}: comment not printed: ${comment.text}`,
      )
    }
  }
  if (Arrays.length(after.comments) > Arrays.length(trivia.comments)) {
    return Some("1:1: a comment was printed twice")
  }
  return None
}

function isSameComment(before: string, after: string): bool uses alloc {
  return Str.trim(before) == Str.trim(after)
}

function createPrinter(
  source: string,
  trivia: Trivia,
  config: FmtConfig,
): Printer from trivia uses alloc {
  const lineStarts = getLineStarts(source)
  const options = Options {
    printWidth: config.printWidth,
    tabWidth: config.tabWidth,
    useTabs: config.useTabs,
  }
  return Printer {
    source: source,
    trivia: trivia,
    settings: Settings { options: options, trailingComma: config.trailingComma },
    printExpression: Exprs.printExpression,
    printPattern: Exprs.printPattern,
    printType: Exprs.printType,
    printBlock: printBlock,
    lineStarts: lineStarts,
    commentStarts: getCommentOffsets(source, lineStarts, trivia.comments, false),
    commentEnds: getCommentOffsets(source, lineStarts, trivia.comments, true),
  }
}

// ---- Source offsets

function getByteAt(source: string, offset: int): int {
  if (offset < 0 || offset >= Str.length(source)) {
    return -1
  }
  return Str.byteAt(source, offset)
}

// ---- Helpers

function quoteString(value: string): string uses alloc {
  const parts = splitString(Lexer.escapeText(value), "\"")
  return `"${Str.join(parts, "\\\"")}"`
}

function printAssigned(
  printer: Printer,
  assignOperator: string,
  value: Expr,
): Doc from printer uses alloc {
  // Line comments at the end of the value (in parentheses that go away) wait
  // for the end of the line instead of forcing the value to break.
  let active = printer
  let inlines: Array<Doc> = []
  let suffixes: Array<Doc> = []
  let current = value
  let walking = true
  while (walking) {
    walking = false
    const hoisted = hoistTrailingComments(active, getIdKey(getExprId(current)))
    active = hoisted.printer
    if (hoisted.count > 0) {
      // the comments of an inner operand come first in the source
      Arrays.push(mutable inlines, hoisted.inline)
      Arrays.push(mutable suffixes, hoisted.suffix)
    }
    if (current is Expr.BinaryExpr(_, _, _, _, right)) {
      current = right
      walking = true
    }
  }
  let ending: Array<Doc> = []
  let index = Arrays.length(inlines)
  while (index > 0) {
    index--
    Arrays.push(mutable ending, inlines[index])
  }
  index = Arrays.length(suffixes)
  while (index > 0) {
    index--
    Arrays.push(mutable ending, suffixes[index])
  }
  const document = active.printExpression(active, value)
  // A binary or `is` value may move to the next line after the `=` (an operator at the end of a
  // line continues the statement); any other value, including a block or `if` value, which breaks
  // inside its own braces or parentheses, stays on the `=` line.
  // A comment on the lines before the value moves it to the line after `=`.
  const canBreak = match (value) {
    Expr.BinaryExpr(_, _, _, _, _) | Expr.IsExpr(_, _, _, _) => true
    _ => hasLeading(printer, getIdKey(getExprId(value)))
  }
  if (canBreak) {
    // A chain that ends in a block keeps its operands level after the `=`, as oxfmt prints it.
    let chain = document
    if (Exprs.endsWithBlock(active, value)) {
      chain = Exprs.printLevelChain(active, value)
    }
    return Docs.concat([
      Docs.group(
        Docs.concat([text(` ${assignOperator}`), Docs.indent(Docs.concat([Doc.Line, chain]))]),
      ),
      Docs.concat(ending),
    ])
  }
  return Docs.concat([text(` ${assignOperator} `), document, Docs.concat(ending)])
}

function text(value: string): Doc uses alloc {
  return Docs.text(value)
}

function empty(): Doc uses alloc {
  return Docs.concat([])
}

function commaLine(): Doc uses alloc {
  return Docs.concat([text(","), Doc.Line])
}

function printList(
  printer: Printer,
  open: string,
  close: string,
  items: Array<Doc>,
  hasTrailingComma: bool,
): Doc uses alloc {
  if (Arrays.length(items) == 0) {
    return text(`${open}${close}`)
  }
  let lastComma = empty()
  if (hasTrailingComma) {
    lastComma = trailingComma(printer)
  }
  return Docs.group(
    Docs.concat([
      text(open),
      Docs.indent(Docs.concat([Doc.SoftLine, Docs.join(commaLine(), items)])),
      lastComma,
      Doc.SoftLine,
      text(close),
    ]),
  )
}

function joinItems(
  printer: Printer,
  keys: Array<string>,
  documents: Array<Doc>,
): Doc from documents uses alloc {
  let parts: Array<Doc> = []
  for (const index of Ranges.upTo(Arrays.length(documents))) {
    // A blank line of the source stays, as one blank line, but never before the first item.
    if (index > 0) {
      Arrays.push(mutable parts, Doc.HardLine)
      if (hasBlankBefore(printer, keys[index])) {
        Arrays.push(mutable parts, Doc.HardLine)
      }
    }
    Arrays.push(mutable parts, documents[index])
  }
  return Docs.concat(parts)
}

function printBraces(
  printer: Printer,
  anchor: string,
  keys: Array<string>,
  documents: Array<Doc>,
): Doc from documents uses alloc {
  if (Arrays.length(documents) == 0) {
    if (hasDangling(printer, anchor)) {
      return Docs.concat([
        text("{"),
        Docs.indent(Docs.concat([Doc.HardLine, printDangling(printer, anchor)])),
        Doc.HardLine,
        text("}"),
      ])
    }
    return text("{}")
  }
  return Docs.concat([
    text("{"),
    Docs.indent(Docs.concat([Doc.HardLine, joinItems(printer, keys, documents)])),
    Doc.HardLine,
    text("}"),
  ])
}

// ---- Files and imports

function printFile(printer: Printer, file: File): Doc from printer uses alloc {
  let keys: Array<string> = []
  let documents: Array<Doc> = []
  for (const importDecl of Arrays.values(file.imports)) {
    const key = getPosKey("i", importDecl.pos)
    Arrays.push(mutable keys, key)
    Arrays.push(mutable documents, withComments(printer, key, printImport(printer, importDecl)))
  }
  let index = 0
  const count = Arrays.length(file.declarations)
  while (index < count) {
    const declaration = file.declarations[index]
    // The members of an extern block follow each other and print as one block.
    if (declaration is Decl.Func(funcDecl)) {
      if (funcDecl.externBlock is Some(block)) {
        let members: Array<FuncDecl> = []
        while (index < count && isMemberOf(file.declarations[index], block)) {
          if (file.declarations[index] is Decl.Func(member)) {
            Arrays.push(mutable members, member)
          }
          index++
        }
        const blockKey = getPosKey("x", block.pos)
        Arrays.push(mutable keys, blockKey)
        Arrays.push(
          mutable documents,
          withComments(printer, blockKey, printExternBlock(printer, block, members)),
        )
        continue
      }
    }
    const key = getPosKey("d", getDeclPos(declaration))
    Arrays.push(mutable keys, key)
    Arrays.push(
      mutable documents,
      withComments(printer, key, printDeclaration(printer, declaration)),
    )
    index++
  }
  if (Arrays.length(documents) == 0) {
    if (hasDangling(printer, "file")) {
      return Docs.concat([printDangling(printer, "file"), Doc.HardLine])
    }
    return empty()
  }
  return Docs.concat([joinItems(printer, keys, documents), Doc.HardLine])
}

function isMemberOf(declaration: Decl, block: ExternBlock): bool {
  if (declaration is Decl.Func(funcDecl)) {
    if (funcDecl.externBlock is Some(found)) {
      return found.pos == block.pos
    }
  }
  return false
}

function printExternBlock(
  printer: Printer,
  block: ExternBlock,
  members: Array<FuncDecl>,
): Doc from printer uses alloc {
  // A member's unsafe effect and the block's attributes are implied, so a member does not write them.
  let written: Array<FuncDecl> = []
  for (const member of Arrays.values(members)) {
    let ownAttributes: Array<Attribute> = []
    for (const attribute of Arrays.values(member.attributes)) {
      if (!hasBlockAttribute(block, attribute)) {
        Arrays.push(mutable ownAttributes, copy(attribute))
      }
    }
    Arrays.push(mutable written, FuncDecl { ...member, effects: [], attributes: ownAttributes })
  }
  let lines: Array<Doc> = []
  for (const attribute of Arrays.values(block.attributes)) {
    Arrays.push(mutable lines, printAttribute(printer, attribute))
  }
  return Docs.concat([
    Docs.concat(lines),
    text("extern "),
    withComments(
      printer,
      getPosKey("r", block.end),
      printMembers(printer, getPosKey("x", block.pos), written),
    ),
    text(" "),
    withComments(printer, getPosKey("k", block.libraryPos), text("from ")),
    withComments(
      moveLineCommentsToTrailing(printer, getPosKey("l", block.libraryPos)),
      getPosKey("l", block.libraryPos),
      text(quoteString(block.library)),
    ),
  ])
}

function hasBlockAttribute(block: ExternBlock, attribute: Attribute): bool {
  for (const blockAttribute of Arrays.values(block.attributes)) {
    if (blockAttribute.pos == attribute.pos) {
      return true
    }
  }
  return false
}

function printImport(printer: Printer, importDecl: ImportDecl): Doc uses alloc {
  const path = quoteString(importDecl.path)
  if (importDecl.alias != "") {
    return text(`import * as ${importDecl.alias} from ${path}`)
  }
  // Names have no anchors: the comments inside the braces are dangling on the import.
  const importKey = getPosKey("i", importDecl.pos)
  if (Arrays.length(importDecl.names) == 0 && !hasDangling(printer, importKey)) {
    return text(`import {} from ${path}`)
  }
  let names: Array<Doc> = []
  for (const importName of Arrays.values(importDecl.names)) {
    if (importName.local == importName.name) {
      Arrays.push(mutable names, text(importName.name))
    } else {
      Arrays.push(mutable names, text(`${importName.name} as ${importName.local}`))
    }
  }
  let inside: Array<Doc> = [Doc.Line]
  if (hasDangling(printer, importKey)) {
    Arrays.push(mutable inside, printDangling(printer, importKey))
    if (Arrays.length(names) > 0) {
      Arrays.push(mutable inside, Doc.HardLine)
    }
  }
  Arrays.push(mutable inside, Docs.join(commaLine(), names))
  let lastComma = empty()
  if (Arrays.length(names) > 0) {
    lastComma = trailingComma(printer)
  }
  return Docs.group(
    Docs.concat([
      text("import {"),
      Docs.indent(Docs.concat(inside)),
      lastComma,
      Doc.Line,
      text(`} from ${path}`),
    ]),
  )
}

// ---- Declarations

function printDeclaration(printer: Printer, declaration: Decl): Doc from printer uses alloc {
  return match (declaration) {
    Decl.Func(inner) => Docs.concat([
      printAttributes(printer, inner),
      printFunction(printer, inner),
    ])
    Decl.Const(inner) => printConst(printer, inner)
    Decl.Struct(inner) => printStruct(printer, inner)
    Decl.Enum(inner) => printEnum(printer, inner)
    Decl.Distinct(inner) => printDistinct(printer, inner)
    Decl.Alias(inner) => printAlias(printer, inner)
    Decl.Test(inner) => Docs.concat([
      text(`test ${quoteString(inner.name)} `),
      printBlock(printer, inner.body),
    ])
    Decl.Trait(inner) => printTrait(printer, inner)
    Decl.Impl(inner) => printImpl(printer, inner)
  }
}

function printAttributes(printer: Printer, declaration: FuncDecl): Doc uses alloc {
  // Each attribute takes a line of its own above the function.
  let lines: Array<Doc> = []
  for (const attribute of Arrays.values(declaration.attributes)) {
    Arrays.push(mutable lines, printAttribute(printer, attribute))
  }
  return Docs.concat(lines)
}

function printAttribute(printer: Printer, attribute: Attribute): Doc uses alloc {
  let written = `@${attribute.name}`
  if (attribute.hasParentheses) {
    let names: Array<string> = []
    for (const argument of Arrays.values(attribute.arguments)) {
      if (argument.text is Some(argumentText)) {
        Arrays.push(mutable names, quoteString(argumentText))
      } else {
        Arrays.push(mutable names, `${argument.name} = ${argument.typeName}.${argument.variant}`)
      }
    }
    written = `${written}(${Str.join(names, ", ")})`
  }
  let parts: Array<Doc> = [text(written)]
  // Its comments follow it: the first stays on its line unless it was written on a line of its own.
  const anchor = getPosKey("@", attribute.pos)
  if (hasDangling(printer, anchor)) {
    if (isFirstDanglingOnOwnLine(printer, anchor)) {
      Arrays.push(mutable parts, Doc.HardLine)
    } else {
      Arrays.push(mutable parts, text(" "))
    }
    Arrays.push(mutable parts, printDangling(printer, anchor))
  }
  Arrays.push(mutable parts, Doc.HardLine)
  return Docs.concat(parts)
}

function isFirstDanglingOnOwnLine(printer: Printer, anchor: string): bool {
  if (printer.trivia.attached[anchor] is Some(attachedList)) {
    for (const attached of Arrays.values(attachedList)) {
      if (attached.placement is Placement.Dangling) {
        return printer.trivia.comments[attached.comment].ownLine
      }
    }
  }
  return false
}

function getExportPrefix(exported: bool): string {
  if (exported) {
    return "export "
  }
  return ""
}

function printTypeList(printer: Printer, types: Array<TypeExpr>): Doc uses alloc {
  let documents: Array<Doc> = []
  for (const type of Arrays.values(types)) {
    Arrays.push(mutable documents, printer.printType(printer, type))
  }
  return Docs.join(text(", "), documents)
}

function printTraitLists(
  printer: Printer,
  implementations: Array<TypeExpr>,
  derived: Array<TypeExpr>,
): Doc uses alloc {
  let parts: Array<Doc> = []
  if (Arrays.length(implementations) > 0) {
    Arrays.push(mutable parts, text(" implements "))
    Arrays.push(mutable parts, printTypeList(printer, implementations))
  }
  if (Arrays.length(derived) > 0) {
    Arrays.push(mutable parts, text(" derives "))
    Arrays.push(mutable parts, printTypeList(printer, derived))
  }
  return Docs.concat(parts)
}

function printTypeParameters(
  _printer: Printer,
  names: Array<string>,
  bounds: Array<Array<TypeExpr>>,
  effects: Array<string>,
  constants: Array<string>,
): Doc uses alloc {
  let items: Array<Doc> = []
  for (const index of Ranges.upTo(Arrays.length(names))) {
    let item = names[index]
    for (const constant of Arrays.values(constants)) {
      if (constant == item) {
        item = `const ${item}: int`
      }
    }
    if (index < Arrays.length(bounds) && Arrays.length(bounds[index]) > 0) {
      let boundNames: Array<string> = []
      for (const bound of Arrays.values(bounds[index])) {
        Arrays.push(mutable boundNames, bound.name)
      }
      item = `${item}: ${Str.join(boundNames, " & ")}`
    }
    Arrays.push(mutable items, text(item))
  }
  for (const effect of Arrays.values(effects)) {
    Arrays.push(mutable items, text(`effect ${effect}`))
  }
  if (Arrays.length(items) == 0) {
    return empty()
  }
  // A type parameter list never breaks: Narra reads a line break only inside ( and [.
  return Docs.concat([text("<"), Docs.join(text(", "), items), text(">")])
}

function printParameter(printer: Printer, parameter: Param): Doc uses alloc {
  let parts: Array<Doc> = []
  if (parameter.isMutable) {
    Arrays.push(mutable parts, text("mutable "))
  }
  if (parameter.escaping) {
    Arrays.push(mutable parts, text("escaping "))
  }
  Arrays.push(mutable parts, text(parameter.name))
  if (parameter.type is Some(type)) {
    Arrays.push(mutable parts, text(": "))
    Arrays.push(mutable parts, printer.printType(printer, type))
  }
  return withComments(printer, getIdKey(parameter.id), Docs.concat(parts))
}

function canEndWithComma(declaration: FuncDecl): bool {
  if (Arrays.length(declaration.parameters) == 0) {
    return true
  }
  const last = declaration.parameters[Arrays.length(declaration.parameters) - 1]
  if (last.type is Some(lastType)) {
    // After a function type with `uses`, the comma would read as part of the effect list.
    return !Exprs.endsWithUses(lastType)
  }
  return true
}

function printParameterList(
  printer: Printer,
  anchor: string,
  parameters: Array<Doc>,
  hasTrailingComma: bool,
): Doc uses alloc {
  // A comment in an empty list is dangling on the function and goes inside the parentheses.
  if (Arrays.length(parameters) == 0 && hasDangling(printer, anchor)) {
    return Docs.concat([
      text("("),
      Docs.indent(Docs.concat([Doc.HardLine, printDangling(printer, anchor)])),
      Doc.HardLine,
      text(")"),
    ])
  }
  return printList(printer, "(", ")", parameters, hasTrailingComma)
}

function printFunction(printer: Printer, declaration: FuncDecl): Doc from printer uses alloc {
  let parameters: Array<Doc> = []
  for (const parameter of Arrays.values(declaration.parameters)) {
    Arrays.push(mutable parameters, printParameter(printer, parameter))
  }
  let parts: Array<Doc> = [
    text(
      `${getExportPrefix(declaration.exported)}${getAsyncPrefix(declaration.isAsync)}function${getGeneratorMark(declaration.generator)} ${declaration.name}`,
    ),
    printTypeParameters(
      printer,
      declaration.typeParameters,
      declaration.bounds,
      declaration.effectParameters,
      declaration.constantParameters,
    ),
    printParameterList(
      printer,
      getPosKey("d", declaration.pos),
      parameters,
      canEndWithComma(declaration),
    ),
  ]
  if (declaration.result is Some(result)) {
    Arrays.push(mutable parts, text(": "))
    Arrays.push(mutable parts, printer.printType(printer, result))
  }
  if (Arrays.length(declaration.effects) > 0) {
    Arrays.push(mutable parts, text(` uses ${Str.join(declaration.effects, ", ")}`))
  }
  // Each `requires` line is indented under the signature, and the body opens on its own line.
  for (const condition of Arrays.values(declaration.requires)) {
    Arrays.push(
      mutable parts,
      Docs.indent(
        Docs.concat([
          Doc.HardLine,
          withComments(
            printer,
            `q${Int.toString(getExprId(condition))}`,
            Docs.concat([text("requires "), printer.printExpression(printer, condition)]),
          ),
        ]),
      ),
    )
  }
  for (const pattern of Arrays.values(declaration.ensures)) {
    Arrays.push(
      mutable parts,
      Docs.indent(
        Docs.concat([
          Doc.HardLine,
          withComments(
            printer,
            `n${Int.toString(getPatternId(pattern))}`,
            Docs.concat([text("ensures "), printer.printPattern(printer, pattern)]),
          ),
        ]),
      ),
    )
  }
  if (declaration.body is Some(body)) {
    if (Arrays.length(declaration.requires) > 0 || Arrays.length(declaration.ensures) > 0) {
      Arrays.push(mutable parts, Doc.HardLine)
    } else {
      Arrays.push(mutable parts, text(" "))
    }
    Arrays.push(mutable parts, printer.printBlock(printer, body))
  }
  return Docs.concat(parts)
}

function getAsyncPrefix(isAsync: bool): string {
  if (isAsync) {
    return "async "
  }
  return ""
}

function getGeneratorMark(generator: bool): string {
  if (generator) {
    return "*"
  }
  return ""
}

function printConst(printer: Printer, declaration: ConstDecl): Doc from printer uses alloc {
  let parts: Array<Doc> = [
    text(`${getExportPrefix(declaration.exported)}const ${declaration.name}`),
  ]
  if (declaration.type is Some(type)) {
    Arrays.push(mutable parts, text(": "))
    Arrays.push(mutable parts, printer.printType(printer, type))
  }
  if (declaration.lazyPos is Some(lazyPos)) {
    const lazyKey = getPosKey("k", lazyPos)
    const lazyValue = Docs.concat([
      withComments(printer, lazyKey, text("lazy ")),
      printer.printExpression(printer, declaration.value),
    ])
    // A comment on the lines before `lazy` moves it to the line after `=`.
    if (hasLeading(printer, lazyKey)) {
      Arrays.push(
        mutable parts,
        Docs.group(Docs.concat([text(" ="), Docs.indent(Docs.concat([Doc.Line, lazyValue]))])),
      )
    } else {
      Arrays.push(mutable parts, Docs.concat([text(" = "), lazyValue]))
    }
    return Docs.concat(parts)
  }
  Arrays.push(mutable parts, printAssigned(printer, "=", declaration.value))
  return Docs.concat(parts)
}

function printField(printer: Printer, field: FieldDecl): Doc from printer uses alloc {
  let parts: Array<Doc> = [text(`${field.name}: `), printer.printType(printer, field.type)]
  if (field.default is Some(value)) {
    Arrays.push(mutable parts, text(" = "))
    Arrays.push(mutable parts, printer.printExpression(printer, value))
  }
  return withComments(printer, getPosKey("f", field.pos), Docs.concat(parts))
}

function printStruct(printer: Printer, declaration: StructDecl): Doc from printer uses alloc {
  let prefix = getExportPrefix(declaration.exported)
  if (declaration.opaque) {
    prefix = `${prefix}opaque `
  }
  let keys: Array<string> = []
  let fields: Array<Doc> = []
  for (const field of Arrays.values(declaration.fields)) {
    Arrays.push(mutable keys, getPosKey("f", field.pos))
    Arrays.push(mutable fields, printField(printer, field))
  }
  return Docs.concat([
    text(`${prefix}struct ${declaration.name}`),
    printTypeParameters(
      printer,
      declaration.typeParameters,
      declaration.bounds,
      [],
      declaration.constantParameters,
    ),
    printTraitLists(printer, declaration.implementations, declaration.derived),
    text(" "),
    printBraces(printer, getPosKey("d", declaration.pos), keys, fields),
  ])
}

function printVariant(printer: Printer, variant: VariantDecl): Doc uses alloc {
  let fields: Array<Doc> = []
  for (const field of Arrays.values(variant.fields)) {
    Arrays.push(mutable fields, printField(printer, field))
  }
  let parts: Array<Doc> = [text(variant.name)]
  if (Arrays.length(fields) > 0) {
    Arrays.push(mutable parts, printList(printer, "(", ")", fields, true))
  }
  return withComments(printer, getPosKey("v", variant.pos), Docs.concat(parts))
}

function printEnum(printer: Printer, declaration: EnumDecl): Doc uses alloc {
  let keys: Array<string> = []
  let variants: Array<Doc> = []
  for (const variant of Arrays.values(declaration.variants)) {
    Arrays.push(mutable keys, getPosKey("v", variant.pos))
    Arrays.push(mutable variants, printVariant(printer, variant))
  }
  return Docs.concat([
    text(`${getExportPrefix(declaration.exported)}enum ${declaration.name}`),
    printTypeParameters(printer, declaration.typeParameters, declaration.bounds, [], []),
    printTraitLists(printer, declaration.implementations, declaration.derived),
    text(" "),
    printBraces(printer, getPosKey("d", declaration.pos), keys, variants),
  ])
}

function printDistinct(printer: Printer, declaration: DistinctDecl): Doc uses alloc {
  let prefix = getExportPrefix(declaration.exported)
  if (declaration.opaque) {
    prefix = `${prefix}opaque `
  }
  return Docs.concat([
    text(`${prefix}distinct type ${declaration.name} = `),
    printer.printType(printer, declaration.base),
    printTraitLists(printer, declaration.implementations, declaration.derived),
    copy(printRefinement(printer, declaration)),
  ])
}

function printRefinement(printer: Printer, declaration: DistinctDecl): Doc from printer uses alloc {
  // ` requires a && b`, kept on the next line when it was written there.
  if (Arrays.length(declaration.refinement) == 0) {
    return text("")
  }
  let items: Array<Doc> = []
  for (const index of Ranges.between(0, Arrays.length(declaration.refinement))) {
    if (index > 0) {
      Arrays.push(mutable items, text(" && "))
    }
    Arrays.push(mutable items, printer.printPattern(printer, declaration.refinement[index]))
  }
  const first = declaration.refinement[0]
  const list = withComments(
    printer,
    `n${Int.toString(getPatternId(first))}`,
    Docs.concat([text("requires "), Docs.concat(items)]),
  )
  if (getPatternStart(first).line > declaration.pos.line) {
    return Docs.indent(Docs.concat([Doc.HardLine, list]))
  }
  return Docs.concat([text(" "), list])
}

function printAlias(printer: Printer, declaration: AliasDecl): Doc uses alloc {
  return Docs.concat([
    text(`${getExportPrefix(declaration.exported)}type ${declaration.name}`),
    printTypeParameters(printer, declaration.typeParameters, [], [], []),
    text(" = "),
    printer.printType(printer, declaration.body),
  ])
}

function printMembers(
  printer: Printer,
  anchor: string,
  functions: Array<FuncDecl>,
): Doc from printer uses alloc {
  let keys: Array<string> = []
  let documents: Array<Doc> = []
  for (const member of Arrays.values(functions)) {
    const key = getPosKey("d", member.pos)
    Arrays.push(mutable keys, key)
    const printed = Docs.concat([printAttributes(printer, member), printFunction(printer, member)])
    Arrays.push(mutable documents, withComments(printer, key, printed))
  }
  return printBraces(printer, anchor, keys, documents)
}

function printTrait(printer: Printer, declaration: TraitDecl): Doc from printer uses alloc {
  return Docs.concat([
    text(`${getExportPrefix(declaration.exported)}trait ${declaration.name} `),
    printMembers(printer, getPosKey("d", declaration.pos), declaration.functions),
  ])
}

function printImpl(printer: Printer, declaration: ImplDecl): Doc from printer uses alloc {
  return Docs.concat([
    text("implement "),
    printer.printType(printer, declaration.traitType),
    text(" for "),
    printer.printType(printer, declaration.type),
    text(" "),
    printMembers(printer, getPosKey("d", declaration.pos), declaration.functions),
  ])
}

// ---- Blocks and statements

export function printBlock(printer: Printer, block: Block): Doc from printer uses alloc {
  return withComments(printer, getPosKey("b", block.pos), printBlockBody(printer, block))
}

function printBlockStatement(printer: Printer, block: Block): Doc from printer uses alloc {
  if (block.isUnsafe) {
    return Docs.concat([text("unsafe "), printBlock(printer, block)])
  }
  return printBlock(printer, block)
}

function printBlockBody(printer: Printer, block: Block): Doc from printer uses alloc {
  let keys: Array<string> = []
  let documents: Array<Doc> = []
  for (const statement of Arrays.values(block.statements)) {
    Arrays.push(mutable keys, getPosKey("s", getStmtPos(statement)))
    Arrays.push(mutable documents, printStatement(printer, statement))
  }
  return printBraces(printer, getPosKey("b", block.pos), keys, documents)
}

function printCondition(printer: Printer, condition: Expr): Doc from printer uses alloc {
  return Docs.concat([
    text("("),
    Docs.group(
      Docs.concat([
        Docs.indent(Docs.concat([Doc.SoftLine, printer.printExpression(printer, condition)])),
        Doc.SoftLine,
      ]),
    ),
    text(")"),
  ])
}

function printStatement(printer: Printer, statement: Stmt): Doc from printer uses alloc {
  const key = getPosKey("s", getStmtPos(statement))
  return withComments(printer, key, printStatementBody(printer, statement))
}

function printStatementBody(printer: Printer, statement: Stmt): Doc from printer uses alloc {
  if (isTernaryReturn(printer, statement)) {
    // One line: the parser rejects a conditional that spans lines without parentheses.
    // Parentheses written around the whole conditional stay.
    if (statement is Stmt.IfStmt(_, condition, _, _)) {
      if (isAfterOpenParenthesis(printer, getStartOffset(printer, condition))) {
        return Docs.concat([
          text("return "),
          printBracketed("(", printTernaryChain(printer, statement), ")"),
        ])
      }
    }
    return Docs.concat([text("return "), printTernaryChain(printer, statement)])
  }
  return match (statement) {
    Stmt.BlockStmt(block) => printBlockStatement(printer, block)
    Stmt.VarStmt(_, _, isMutable, name, pattern, type, value) => printVariable(
      printer,
      isMutable,
      name,
      pattern,
      type,
      value,
    )
    Stmt.AssignStmt(_, target, value) => Docs.concat([
      printer.printExpression(printer, target),
      printAssigned(printer, "=", value),
    ])
    Stmt.CompoundAssignStmt(_, target, operator, value) => printCompoundAssign(
      printer,
      target,
      operator,
      value,
    )
    Stmt.ExprStmt(_, expression) => printer.printExpression(printer, expression)
    Stmt.ReturnStmt(_, value) => printReturn(printer, value)
    Stmt.IfStmt(_, condition, thenBlock, orElse) => printIf(printer, condition, thenBlock, orElse)
    Stmt.WhileStmt(pos, label, condition, body) => printWhile(printer, pos, label, condition, body)
    Stmt.CForStmt(pos, label, init, condition, step, body) => printCFor(
      printer,
      pos,
      label,
      init,
      condition,
      step,
      body,
    )
    Stmt.ForStmt(_, pos, label, name, iterable, body, reference) => printFor(
      printer,
      pos,
      label,
      name,
      iterable,
      body,
      reference,
    )
    Stmt.YieldStmt(_, value, delegate, binding) => printYield(printer, value, delegate, binding)
    Stmt.BreakStmt(_, label) => text(getJump("break", label))
    Stmt.ContinueStmt(_, label) => text(getJump("continue", label))
  }
}

function getLabelPrefix(label: string): string uses alloc {
  if (label == "") {
    return ""
  }
  return `${label}: `
}

function getJump(keyword: string, label: string): string uses alloc {
  if (label == "") {
    return keyword
  }
  return `${keyword} ${label}`
}

function printVariable(
  printer: Printer,
  isMutable: bool,
  name: string,
  pattern: Option<Pattern>,
  type: Option<TypeExpr>,
  value: Expr,
): Doc from printer uses alloc {
  let keyword = "const "
  if (isMutable) {
    keyword = "let "
  }
  let parts: Array<Doc> = [text(keyword)]
  if (pattern is Some(inner)) {
    Arrays.push(mutable parts, printer.printPattern(printer, inner))
  } else {
    Arrays.push(mutable parts, text(name))
  }
  if (type is Some(declared)) {
    Arrays.push(mutable parts, text(": "))
    Arrays.push(mutable parts, printer.printType(printer, declared))
  }
  Arrays.push(mutable parts, printAssigned(printer, "=", value))
  return Docs.concat(parts)
}

function printYield(
  printer: Printer,
  value: Expr,
  delegate: bool,
  binding: Option<YieldBinding>,
): Doc from printer uses alloc {
  let keyword = "yield "
  if (binding is Some(bound)) {
    // `const input = yield value`
    let declaration = "const "
    if (bound.isMutable) {
      declaration = "let "
    }
    return Docs.concat([
      text(`${declaration}${bound.name} = yield `),
      printReturned(printer, value),
    ])
  }
  if (delegate) {
    keyword = "yield* "
  }
  return Docs.concat([text(keyword), printReturned(printer, value)])
}

function printCompoundAssign(
  printer: Printer,
  target: Expr,
  operator: string,
  value: Expr,
): Doc from printer uses alloc {
  const targetDoc = printer.printExpression(printer, target)
  // `x++` and `x--` keep their spelling; the value is the implied 1.
  if (operator == "++" || operator == "--") {
    return Docs.concat([targetDoc, text(operator)])
  }
  return Docs.concat([targetDoc, printAssigned(printer, operator, value)])
}

function printReturned(printer: Printer, value: Expr): Doc from printer uses alloc {
  const document = printer.printExpression(printer, value)
  // Parentheses that hold a comment stay and break, so the comment stays inside.
  if (hasCommentInParens(printer, value)) {
    return printBracketed("(", document, ")")
  }
  return document
}

function printReturn(printer: Printer, value: Option<Expr>): Doc from printer uses alloc {
  if (value is Some(returned)) {
    return Docs.concat([text("return "), printReturned(printer, returned)])
  }
  return text("return")
}

function printIf(
  printer: Printer,
  condition: Expr,
  thenBlock: Block,
  orElse: Option<Stmt>,
): Doc from printer uses alloc {
  let parts: Array<Doc> = [
    text("if "),
    printCondition(printer, condition),
    text(" "),
    printBlock(printer, thenBlock),
  ]
  if (orElse is Some(branch)) {
    // The comments of the else branch go before `else`, on their own lines.
    let branchKey = ""
    let branchBody = empty()
    if (branch is Stmt.IfStmt(branchPos, _, _, _)) {
      branchKey = getPosKey("s", branchPos)
      branchBody = printStatementBody(printer, branch)
    } else if (branch is Stmt.BlockStmt(elseBlock)) {
      branchKey = getPosKey("b", elseBlock.pos)
      branchBody = printBlockBody(printer, elseBlock)
    }
    const elseDocument = withComments(printer, branchKey, Docs.concat([text("else "), branchBody]))
    if (hasTrailing(printer, getPosKey("b", thenBlock.pos)) || hasLeading(printer, branchKey)) {
      // A trailing comment of the block ends the line: `else` starts the next one.
      Arrays.push(mutable parts, Doc.HardLine)
    } else {
      // `else if` stays on the line of the closing brace.
      Arrays.push(mutable parts, text(" "))
    }
    Arrays.push(mutable parts, elseDocument)
  }
  return Docs.concat(parts)
}

function findKeywordOffset(source: string, start: int): int {
  const length = Str.length(source)
  let index = start
  while (index < length) {
    const byte = Str.byteAt(source, index)
    if (byte == 47 && getByteAt(source, index + 1) == 47) {
      while (index < length && Str.byteAt(source, index) != 10) {
        index++
      }
    } else if (byte == 47 && getByteAt(source, index + 1) == 42) {
      index += 2
      while (
        index < length && !(Str.byteAt(source, index) == 42 && getByteAt(source, index + 1) == 47)
      ) {
        index++
      }
      index += 2
    } else if (isWordAt(source, index, "for") || isWordAt(source, index, "while")) {
      return index
    } else {
      index++
    }
  }
  return length
}

function isWordAt(source: string, index: int, word: string): bool uses alloc {
  const end = index + Str.length(word)
  if (end > Str.length(source) || substring(source, index, end) != word) {
    return false
  }
  return !isWordByte(getByteAt(source, index - 1)) && !isWordByte(getByteAt(source, end))
}

function isWordByte(byte: int): bool {
  return (byte >= 97 && byte <= 122) ||
    (byte >= 65 && byte <= 90) ||
    (byte >= 48 && byte <= 57) ||
    byte == 95
}

// LabelComments are the comments between a loop's label and its keyword. The
// trivia attaches them to the first node of the loop head, so they are taken
// from there and printed after the label.
struct LabelComments {
  prefix: Doc
  printer: Printer
}

function takeLabelComments(
  printer: Printer,
  pos: Pos,
  label: string,
  anchors: Array<string>,
): LabelComments from printer uses alloc {
  let prefix = text(getLabelPrefix(label))
  let active = printer
  if (label == "") {
    return LabelComments { prefix: prefix, printer: active }
  }
  const keywordOffset = findKeywordOffset(
    printer.source,
    getOffset(printer.source, pos) + Str.length(label),
  )
  let parts: Array<Doc> = [prefix]
  for (const anchor of Arrays.values(anchors)) {
    const indexes = getLeadingBefore(printer, anchor, keywordOffset)
    if (Arrays.length(indexes) == 0) {
      continue
    }
    active = removeComments(active, anchor, indexes)
    for (const index of Arrays.values(indexes)) {
      const comment = printer.trivia.comments[index]
      Arrays.push(mutable parts, text(Str.trim(comment.text)))
      if (comment.kind is CommentKind.Block) {
        Arrays.push(mutable parts, text(" "))
      } else {
        Arrays.push(mutable parts, Doc.HardLine)
      }
    }
  }
  return LabelComments { prefix: Docs.concat(parts), printer: active }
}

function printWhile(
  printer: Printer,
  pos: Pos,
  label: string,
  condition: Expr,
  body: Block,
): Doc from printer uses alloc {
  const taken = takeLabelComments(printer, pos, label, [getIdKey(getExprId(condition))])
  return Docs.concat([
    taken.prefix,
    text("while "),
    printCondition(taken.printer, condition),
    text(" "),
    printBlock(taken.printer, body),
  ])
}

function printCFor(
  printer: Printer,
  pos: Pos,
  label: string,
  init: Option<Stmt>,
  condition: Option<Expr>,
  step: Option<Stmt>,
  body: Block,
): Doc from printer uses alloc {
  const taken = takeLabelComments(printer, pos, label, [])
  const active = taken.printer
  if (init is None && condition is None && step is None) {
    return Docs.concat([taken.prefix, text("for (;;) "), printBlock(active, body)])
  }
  // Each part of the head may be empty.
  let initDocument = empty()
  if (init is Some(declaration)) {
    initDocument = printStatementBody(active, declaration)
  }
  let conditionDocument = empty()
  if (condition is Some(loopCondition)) {
    conditionDocument = active.printExpression(active, loopCondition)
  }
  let stepDocument = empty()
  if (step is Some(stepStatement)) {
    stepDocument = printStatementBody(active, stepStatement)
  }
  const header = Docs.group(
    Docs.concat([
      text("for ("),
      Docs.indent(
        Docs.concat([
          Doc.SoftLine,
          initDocument,
          text(";"),
          Doc.Line,
          conditionDocument,
          text(";"),
          Doc.Line,
          stepDocument,
        ]),
      ),
      Doc.SoftLine,
      text(") "),
    ]),
  )
  return Docs.concat([taken.prefix, header, printBlock(active, body)])
}

function printFor(
  printer: Printer,
  pos: Pos,
  label: string,
  name: string,
  iterable: Expr,
  body: Block,
  reference: Option<LoopReference>,
): Doc from printer uses alloc {
  let keyword = "const "
  let declaredName = name
  // The `mutable` marker is written in place of `const`, or inside
  // the entries tuple.
  if (reference is Some(marker)) {
    keyword = "mutable "
    if (marker.indexName != "") {
      keyword = `const #[${marker.indexName}, mutable `
      declaredName = `${name}]`
    }
  }
  // The parser turns `for (const pattern of xs)` and `for (let x of xs)` into a loop over a hidden
  // name whose body starts with a declaration; put it back.
  let declaredPattern: Option<Pattern> = None
  let loopBody = body
  if (Str.startsWith(name, "__for_") && Arrays.length(body.statements) > 0) {
    if (
      body.statements[0] is Stmt.VarStmt(
        _,
        _,
        isMutable,
        hiddenDeclaration,
        pattern,
        _,
        Expr.Ident(_, _, hiddenName),
      )
    ) {
      if (hiddenName == name) {
        if (isMutable) {
          keyword = "let "
        }
        declaredName = hiddenDeclaration
        declaredPattern = pattern
        let rest: Array<Stmt> = []
        for (const index of Ranges.between(1, Arrays.length(body.statements))) {
          Arrays.push(mutable rest, body.statements[index])
        }
        loopBody = Block { pos: body.pos, end: body.end, statements: rest }
      }
    }
  }
  // The loop head: the pattern (if any) comes before the iterable.
  let anchors: Array<string> = []
  if (declaredPattern is Some(headPattern)) {
    Arrays.push(mutable anchors, getIdKey(getPatternId(headPattern)))
  }
  Arrays.push(mutable anchors, getIdKey(getExprId(iterable)))
  const taken = takeLabelComments(printer, pos, label, anchors)
  const active = taken.printer
  let head = text(`${keyword}${declaredName}`)
  if (declaredPattern is Some(headPattern)) {
    head = Docs.concat([text(keyword), active.printPattern(active, headPattern)])
  }
  // A comment before the `)` stays inside the header, on a line of its own.
  const iterableDocument = active.printExpression(active, iterable)
  if (!hasTrailing(active, getIdKey(getExprId(iterable)))) {
    return Docs.concat([
      taken.prefix,
      text("for ("),
      head,
      text(" of "),
      iterableDocument,
      text(") "),
      printBlock(active, loopBody),
    ])
  }
  const header = Docs.group(
    Docs.concat([
      text("for ("),
      head,
      text(" of "),
      Docs.indent(iterableDocument),
      Doc.SoftLine,
      text(") "),
    ]),
  )
  return Docs.concat([taken.prefix, header, printBlock(active, loopBody)])
}

function isTernaryReturn(printer: Printer, statement: Stmt): bool {
  if (statement is Stmt.IfStmt(pos, _, thenBlock, Some(Stmt.BlockStmt(elseBlock)))) {
    if (Arrays.length(thenBlock.statements) != 1 || Arrays.length(elseBlock.statements) != 1) {
      return false
    }
    // The parser makes this if from `return c ? a : b`, with the position of the `?` (63), where a
    // real if has `if`.
    return getByteAt(printer.source, getOffset(printer.source, pos)) == 63
  }
  return false
}

function printTernaryChain(printer: Printer, statement: Stmt): Doc from printer uses alloc {
  if (statement is Stmt.IfStmt(_, condition, thenBlock, Some(Stmt.BlockStmt(elseBlock)))) {
    return Docs.concat([
      printer.printExpression(printer, condition),
      text(" ? "),
      printTernaryBranch(printer, thenBlock),
      text(" : "),
      printTernaryBranch(printer, elseBlock),
    ])
  }
  return empty()
}

function printTernaryBranch(printer: Printer, block: Block): Doc from printer uses alloc {
  const statement = block.statements[0]
  if (statement is Stmt.ReturnStmt(_, Some(value))) {
    return printer.printExpression(printer, value)
  }
  const chain = printTernaryChain(printer, statement)
  // A conditional of its own keeps the parentheses it was written in.
  if (isAfterOpenParenthesis(printer, getOffset(printer.source, block.pos))) {
    return Docs.concat([text("("), chain, text(")")])
  }
  return chain
}

function isAfterOpenParenthesis(printer: Printer, offset: int): bool uses alloc {
  const source = printer.source
  let index = offset
  while (index > 0) {
    const commentStart = getCommentStartBefore(printer, index)
    const byte = Str.byteAt(source, index - 1)
    if (commentStart >= 0) {
      index = commentStart
    } else if (byte == 32 || byte == 9 || byte == 10 || byte == 13) {
      index--
    } else {
      return byte == 40
    }
  }
  return false
}
