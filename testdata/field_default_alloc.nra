import * as Arrays from "std/array"

struct Bag {
  items: Array<int> = [1, 2]
  label: string = "bag"
}

// Leaving out the array default builds the array at the literal, so it allocates.
export function make(): Bag uses alloc {
  return {}
}

export function makeWith(): Bag uses alloc {
  return { items: [], label: "x" }
}

export function run(_args: Array<string>): int uses io, alloc {
  const bag = make()
  print(Show.show(Arrays.length(bag.items)))
  print(bag.label)
  print(Show.show(Arrays.length(makeWith().items)))
  return 0
}
