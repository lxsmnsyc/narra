import * as Int from "std/int"
import * as Array from "std/array"

// Tuple is a plain name, not a prelude type.
struct Tuple {
  span: #[int, int]
  names: Array<#[string, bool]>
}

function width(t: Tuple): int {
  const { span: #[lo, hi] } = t
  return hi - lo
}

function divmod(a: int, b: int): #[int, int] {
  return #[a / b, a % b]
}

function swap<A, B>(t: #[A, B]): #[B, A] {
  const #[a, b] = t
  return #[b, a]
}

function first<A, B>(t: #[A, B]): A {
  const #[a, _] = t
  return a
}

function label(t: #[string, Option<int>]): string {
  return match (t) {
    #[name, None] => `${name}: none`
    #[name, Some(0)] => `${name}: zero`
    #[name, Some(n)] => `${name}: ${Int.toString(n)}`
  }
}

function both(t: #[bool, bool]): string {
  return match (t) {
    #[true, true] => "both"
    #[false, false] => "neither"
    #[true, false] => "left"
    #[false, true] => "right"
  }
}

export function run(args: Array<string>): int {
  const #[quotient, remainder] = divmod(17, 5)
  print(`${Int.toString(quotient)} ${Int.toString(remainder)}`)

  const named = #["list", ["a", "b"]]
  const #[name, items] = named
  print(`${name} ${items[1]}`)

  // A tuple literal needs no expected type, so it goes straight to a generic call.
  const #[n, w] = swap(#["word", 3])
  print(`${Int.toString(n)} ${w}`)
  print(first(named))
  if (first(#[#[1, 'c'], "x"]) == #[1, 'c']) {
    print("first of a nested tuple")
  }

  print(label(#["a", None]))
  print(label(#["b", Some(0)]))
  print(label(#["c", Some(7)]))
  print(both(#[true, false]))
  print(both(#[false, false]))

  const nested: #[#[int, string], string] = #[#[1, "inner"], "outer"]
  const #[#[one, inner], outer] = nested
  print(`${Int.toString(one)} ${inner} ${outer}`)

  print(Show.show(nested))
  if (#[1, "x"] == #[1, "x"]) {
    print("equal")
  }
  if (divmod(7, 2) != divmod(9, 2)) {
    print("different")
  }
  const ord = Ordered.compare(#[1, "b"], #[1, "a"])
  print(Show.show(ord))
  let pairs: Array<#[string, int]> = []
  Array.push(mutable pairs, #["x", 1])
  Array.push(mutable pairs, #["y", 2])
  for (const p of Array.values(pairs)) {
    let #[k, v] = p
    v = v * 10
    print(`${k}=${Int.toString(v)}`)
  }
  const t = Tuple { span: #[3, 10], names: [#["a", true]] }
  print(Int.toString(width(t)))
  print(Show.show(t.names))
  const plain = [1, 2]
  print(Show.show(plain))
  return 0
}
